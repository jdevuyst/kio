pkg dyn_load_prime_driver;

build {
  cache "out/.kio-cache/";

  target js {
    out "out/js/";
    baseline es2020
  }
}

bridge {
  testapi;
  testapi/**;
  prime;
  host_descriptor;
  value;
  result;
  marshal;
  eval;
  hostrec;
  token;
  chars;
  lex;
  parse;
  loader;
  defaults;
  loader/scan;
  macros/macro_util;
  macros/match;
  macros/spine_macros;
  list/core;
  driver
}
