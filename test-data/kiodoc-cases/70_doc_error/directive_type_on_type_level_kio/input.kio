/// `@type` against a type-level name is a Kiodoc contract error.
///
/// A type alias binds no value: [`@type Count`].
/// A compact type alias binds no value: [`@type Color`].
/// A nominal type binds no value: [`@type Wrapped`].
module typelevel/main;

/// A type alias.
pub type Count = .;

/// Color nominal entries.
pub type Color = { Red: .; Green: .; };

/// A nominal wrapper.
pub type { Wrapped: . { pub mk; pub get; }; };

/// A value binding — `@type` resolves against this fine.
pub fn compute() { () }
