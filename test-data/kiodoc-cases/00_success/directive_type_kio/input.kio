/// `@type` against value bindings resolves.
///
/// A `fn`'s bound-value type: [`@type compute`].
/// A nominal type's constructor is a value-level fn: [`@type Wrapped.mk`].
/// A nominal type's projector is too: [`@type Wrapped.get`].
mod dtype/main;

/// Computes a result.
pub fn compute(n: .) { n }

/// A nominal wrapper — `Wrapped` is the type-level name (rejected by
/// `@type`), but its constructor / projector are value-level fns.
pub type { Wrapped: . { pub mk; pub get; }; };
