/// Module demonstrating that nominal entries and op functions are valid intra-doc targets.
///
/// Nominals like [`Some`] and [`None`] are collected from the compact type entries.
/// The underlying function for the `+` operator is [`add`], which is also in scope.
mod docref/labelsops;

/// Option type — nominal entries become valid intra-doc ref targets.
///
/// Variants are [`Some`] (a value is present) and [`None`] (absent).
type Option = { Some: .; None: .; };

/// Adds two units together.
///
/// Used by the [`+`] operator below.
pub fn add(x: ., y: .) { () }

/// The plus operator. Spell the operator token as [`+`] in doc refs.
/// Its underlying function [`add`] is also directly reachable.
op _ + _ { impl add; };
