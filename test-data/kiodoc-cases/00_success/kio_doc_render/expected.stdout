<pre class="sig"><code><span class="kio-keyword-declaration">host</span> <span class="kio-keyword-declaration">fn</span> <span class="kio-entity-name-function">emit</span><span class="kio-punctuation-bracket">(</span><span class="kio-variable-parameter">value</span><span class="kio-operator-builtin">:</span> <span class="kio-entity-name-type">S</span><span class="kio-punctuation-bracket">)</span> <span class="kio-operator-builtin">-&gt;</span> <span class="kio-punctuation-separator">.</span><span class="kio-punctuation-separator">;</span></code></pre>

