/// Left public function uses its private [`helper`].
pub fn make() { helper() }

fn helper() { () }

fn foo() { () }

pub(api) fn scoped() { () }

pub type Alias = .;

pub lit text = "example";

pub type { Box: . { pub mk; get }; }

pub type Row = { Field: .; };

pub type { Other: .; };

pub type { Foo: .; };

pub fn add(left: ., right: .) { () }

