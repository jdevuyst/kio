mod api/main;

import api { fn print }
import api { type I32 }
import api { type String }
import api/labels { type Choice }
import api/labels { type Count }
import api/labels { type Name }
import api/labels { type Pair }

pub fn make(n: String, c: I32) -> Pair { (Name.mk(n), Count.mk(c)) }

pub fn echo_pair(p: Pair) -> Pair { p }

pub fn echo_choice(choice: Choice) -> Choice { choice }

pub fn greet(msg: String) { print(msg) }

pub fn return() { () }
