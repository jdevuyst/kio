module api;

host type String role(str);

host type Crate[T];

pub fn abstract_crate[*F][T](value: F(T)) -> F(T) { value }

fn product_roundtrip[*F][A][T](pack: (A & T) -> F(A & T), read: F(A & T) -> (A & T), value: A & T) ->
  A & T
   { read(pack(value)) }

fn sum_roundtrip[*F][A][T](pack: (A | T) -> F(A | T), read: F(A | T) -> (A | T), value: A | T) ->
  A | T
   { read(pack(value)) }

pub fn concrete_product_roundtrip(
  , pack: (String & String & String) -> Crate(String & String & String)
  , read: Crate(String & String & String) -> (String & String & String)
  , value: String & String & String
  ) -> String & String & String {
  product_roundtrip(Crate, String, String & String, pack, read, value)
}

pub fn concrete_sum_roundtrip(
  , pack: (String | String | String) -> Crate(String | String | String)
  , read: Crate(String | String | String) -> (String | String | String)
  , value: String | String | String
  ) -> String | String | String { sum_roundtrip(Crate, String, String | String, pack, read, value) }

pub fn whole_crate[T](value: Crate(T)) -> Crate(T) { value }

pub fn product_crate[A][T](value: Crate(A & T)) -> Crate(A & T) { value }

pub fn sum_crate[A][T](value: Crate(A | T)) -> Crate(A | T) { value }

pub fn concrete_product_crate(value: Crate(String & String & String)) -> Crate(& String
& String
& String) {
  product_crate(String, String & String, abstract_crate(Crate, String & String & String, value))
}

pub fn concrete_sum_crate(value: Crate(String | String | String)) -> Crate(String | String | String) {
  sum_crate(String, String | String, value)
}

pub newtype Box[A] : A { pub constructor make_box; pub projector read_box }

pub newtype Functor[*F] : F(String) { pub constructor make_functor; pub projector read_functor }

pub newtype Shadow[T] : T & ([T] T -> T) { pub constructor make_shadow; pub projector read_shadow }

pub newtype Pack <T> : T { pub constructor make_pack; pub projector open_pack }

pub rec newtype Recursive : . | Recursive {
  pub constructor make_recursive;
  pub projector read_recursive
  }

host fn apply_poly(f: [T] T -> T) -> String;

host fn round_shadow(value: Shadow(Box(String))) -> Shadow(Box(String));

host fn round_hkt[*F](value: F(String)) -> F(String);

host fn round_functor(value: Functor(Box)) -> Functor(Box);

pub fn poly() -> String { apply_poly(.[T](value: T) { value }) }

pub fn shadow(value: Shadow(Box(String))) -> Shadow(Box(String)) { round_shadow(value) }

pub fn hkt(value: Box(String)) -> Box(String) { round_hkt(Box, value) }

pub fn box_functor(value: Box(String)) -> Functor(Box) { Functor.make_functor(Box, value) }

pub fn functor(value: Functor(Box)) -> Functor(Box) { round_functor(value) }

pub fn pack[T](value: T) -> Pack { Pack.make_pack(T, value) }
