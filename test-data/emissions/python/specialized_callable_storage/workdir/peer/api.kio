module api;

host type Number role(i32);

host fn invoked();

pub newtype Hidden : Number { constructor hide; projector reveal }

pub fn relay_callback[A](value: A -> Hidden) -> A -> Hidden { value }

pub fn relay_factory[A](value: . -> A -> Hidden) -> . -> A -> Hidden { value }

pub newtype Packed <U> : U & (U -> Number) { constructor pack; projector open_pack }

pub fn make_hidden(value: Number) -> Hidden { Hidden.hide(value) }

pub fn read_hidden(value: Hidden) -> Number { invoked(); Hidden.reveal(value) }

fn read_payload[U](value: U, reader: U -> Number) -> Number { reader(value) }

pub fn make_packed(value: Number) -> Packed {
  Packed.pack(Number, value, .(n: Number) { n })
}

pub fn read_packed(value: Packed) -> Number {
  invoked();
  Packed.open_pack(value, Number, read_payload)
}
