module api;

host type Number role(i32);

host type Box[T];

host fn pack[T](value: T) -> Box[T];

host fn invoked();

pub type { N: Number { pub mk; pub get } }

fn identity[T](value: T) -> T { invoked(); value }

pub fn boxed() -> Box[N -> N] { pack(identity[N]) }

fn same(value: N) -> N { invoked(); value }

pub fn boxed_named() -> Box[N -> N] { pack(same) }

pub fn boxed_literal() -> Box[N -> N] {
  pack(.(value: N) { invoked(); value })
}

pub fn relay_callback[A](value: N -> A) -> N -> A { value }

pub fn relay_factory[A](value: . -> N -> A) -> . -> N -> A { value }

pub type { Hidden: Number { mk; get } }

pub type { Packed <U>: U & (U -> Number) { mk; get } }

pub fn make_hidden(value: Number) -> Hidden { Hidden.mk(value) }

pub fn read_hidden(value: Hidden) -> Number { invoked(); Hidden.get(value) }

fn read_payload[U](value: U, reader: U -> Number) -> Number { reader(value) }

pub fn make_packed(value: Number) -> Packed {
  Packed.mk[Number](value, .(n: Number) { n })
}

pub fn read_packed(value: Packed) -> Number { invoked(); Packed.get(value)[Number](read_payload) }
