host fn relay(value: Token) -> Token;

pub fn round(value: Token) -> Token { relay(value) }

pub fn nested_round(value: nested.Token) -> nested.Token { value }

pub fn repeat_round(value: repeated.Token) -> repeated.Token { value }

pub fn reserved_round(value: reserved.Token) -> reserved.Token { value }

pub fn deep_round(value: deep.Token) -> deep.Token { value }

pub fn chain_round(value: Chain) -> Chain { value }

