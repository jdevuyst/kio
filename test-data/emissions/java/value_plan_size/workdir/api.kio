module api;

host type N;

pub newtype Box[A] : A & N { pub constructor make_box; pub projector read_box }

pub fn pipeline_n1[A](value: Box(A), callback: Box(A) -> Box(A)) ->
  Box(A) & Box(A) & Box(A) & Box(A)
   { (callback(value), callback(value), callback(value), callback(value)) }

pub fn pipeline_n2[A](value: Box(A), callback: Box(A) -> Box(A)) ->
  Box(A) & Box(A) & Box(A) & Box(A)
   { (callback(value), callback(value), callback(value), callback(value)) }

pub fn pipeline_n3[A](value: Box(A), callback: Box(A) -> Box(A)) ->
  Box(A) & Box(A) & Box(A) & Box(A)
   { (callback(value), callback(value), callback(value), callback(value)) }

pub fn pipeline_n4[A](value: Box(A), callback: Box(A) -> Box(A)) ->
  Box(A) & Box(A) & Box(A) & Box(A)
   { (callback(value), callback(value), callback(value), callback(value)) }
