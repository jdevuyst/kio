mod api/main;

import api { type I32 }
import api { type String }
import api/labels { type Choice }
import api/labels { type Counter }
import api/labels { type Name }
import api/labels { type Pair }

pub fn make(n: String, c: I32) -> Pair { (Name.mk(n), Counter.mk(c)) }

pub fn echo_pair(x: Pair) -> Pair { x }

pub fn echo_choice(x: Choice) -> Choice { x }
