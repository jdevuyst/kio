sig app v(3);

v(1) {
  nonbreaking {
    add {
      mod api {
        host type Box[A];
        host type Str role(str);
        pub type { Token[A]: A { pub mk; pub get } };
        host type Unused[A];
        pub fn echo(value: Str) -> Str;
        host fn old(head: Str, value: Str & Box[Token[.]]) -> Box[Token[.]];
        host fn open() -> Str
      };
      mod legacy {
        host type Gone;
        host fn retired(value: Gone) -> Gone
      }
    }
  }
}

v(2) {
  nonbreaking {
    remove {
      api.Box;
      api.Token;
      api.Unused;
      api.old;
      legacy.Gone;
      legacy.retired
    }
  }
}
