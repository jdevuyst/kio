mod main;

host type I32 role(i32);

host type Box[T];

host fn echo_box[T](value: Box[T]) -> Box[T];

pub fn whole_box[T](value: Box[T]) -> Box[T] { echo_box(value) }

pub fn product_box[A][T](value: Box[A & T]) -> Box[A & T] { echo_box(value) }

pub fn sum_box[A][T](value: Box[A | T]) -> Box[A | T] { echo_box(value) }

pub fn concrete_product_box(value: Box[I32 & I32 & I32]) -> Box[I32 & I32 & I32] {
  product_box[I32][I32 & I32](value)
}

pub fn concrete_sum_box(value: Box[I32 | I32 | I32]) -> Box[I32 | I32 | I32] {
  sum_box[I32][I32 | I32](value)
}

pub type { Identity[A]: A { pub mk; pub get } }

pub rec type { List[A]: . | (A & List[A]) { pub mk; pub get } }

pub type { Packed_triple: (I32 & I32 & I32) -> I32 { pub mk; pub get } }

pub type { Higher_order_parameter: (I32 -> I32) -> I32 { pub mk; pub get } }

pub type { Higher_order_return: I32 -> I32 -> I32 { pub mk; pub get } }

pub type { Polymorphic[*F]: [A][B] ((A -> B) & F[A]) -> F[B] { pub mk; pub get } }

pub rec type { Recursive_poly: [A] A -> Recursive_poly { pub mk; pub get } }

pub rec type {
  Recursive_existential_function <U>: U -> Recursive_existential_function { pub mk; pub get }
}
