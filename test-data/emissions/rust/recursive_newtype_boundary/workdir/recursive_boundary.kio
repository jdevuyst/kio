module recursive_boundary;

import __intrinsics__;

host type I32 role(i32);

rec {
  pub newtype Tree : I32 | Forest { pub constructor mk_tree; pub projector un_tree };
  pub newtype Forest : . | (Tree & Forest) { pub constructor mk_forest; pub projector un_forest }
}

pub fn leaf(value: I32) -> Tree { Tree.mk_tree(__left__(I32, Forest, value)) }

pub fn node(value: Forest) -> Tree { Tree.mk_tree(__right__(I32, Forest, value)) }

pub fn empty() -> Forest { Forest.mk_forest(__left__(., Tree & Forest, ())) }

pub fn graft(tree: Tree, forest: Forest) -> Forest {
  Forest.mk_forest(__right__(., Tree & Forest, (tree, forest)))
}
