mod recursive_boundary;

import __intrinsics__;

host type I32 role(i32);

rec {
  pub type { Tree: I32 | Forest { pub mk; pub get } };
  pub type { Forest: . | (Tree & Forest) { pub mk; pub get } }
}

pub fn leaf(value: I32) -> Tree { Tree.mk(__left__[I32][Forest](value)) }

pub fn node(value: Forest) -> Tree { Tree.mk(__right__[I32][Forest](value)) }

pub fn empty() -> Forest { Forest.mk(__left__[.][Tree & Forest](())) }

pub fn graft(tree: Tree, forest: Forest) -> Forest {
  Forest.mk(__right__[.][Tree & Forest]((tree, forest)))
}
