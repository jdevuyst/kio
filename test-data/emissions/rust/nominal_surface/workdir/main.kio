mod main;

host type I32 role(i32);

host type Str role(str);

host type Scalar;

pub type { Wrap: I32 { pub mk; pub get } }

pub type { Boxed: Scalar { pub mk; pub get } }

pub type { Pair: Boxed & Boxed { pub mk; pub get } }

pub type { Name: Str; Value: I32 }

pub fn wrap(value: I32) -> Wrap { Wrap.mk(value) }

pub fn unwrap(value: Wrap) -> I32 { Wrap.get(value) }

pub fn box_scalar(value: Scalar) -> Boxed { Boxed.mk(value) }

pub fn unbox_scalar(value: Boxed) -> Scalar { Boxed.get(value) }

pub fn pair_boxed(left: Boxed, right: Boxed) -> Pair { Pair.mk((left, right)) }

pub fn make_name(value: Str) -> Name { Name.mk(value) }

pub fn read_name(value: Name) -> Str { Name.get(value) }

pub fn make_value(value: I32) -> Value { Value.mk(value) }

pub fn read_value(value: Value) -> I32 { Value.get(value) }
