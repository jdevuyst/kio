module shape;

import slot0 as s;

pub type { Y: s.Value { mk; get } }

pub fn make_y(value: s.Value) -> Y { Y.mk(value) }

pub fn read_y(value: Y) -> s.Value { value.>Y.get }

pub fn selector_collision(value: (. & . & Y) & . & s.Y) -> (. & . & Y) & . & s.Y { value }

pub fn pattern_collision(value: s.P | .) -> s.P | . { value }
