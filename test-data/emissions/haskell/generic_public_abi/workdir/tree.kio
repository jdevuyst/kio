module tree;

import __intrinsics__;

pub rec type { Tree: . | Tree { pub mk; pub get } }

pub rec type { Branch: . | Branch { mk; get } }

pub rec type { Leaf: . | Leaf { mk; get } }

pub rec type { Node: . | Node { pub mk; pub get } }

rec {
  pub type { Alpha: . | Beta { pub mk; pub get } };
  pub type { Beta: . | Alpha { pub mk; pub get } }
}

pub fn empty() -> Tree { Tree.mk(__left__[.][Tree](())) }

pub fn keep(value: Tree) -> Tree { value }

pub fn branch_wrapped() -> Branch & . {
  __pair__[Branch][.](Branch.mk(__left__[.][Branch](())), ())
}

pub fn leaf_wrapped() -> . | Leaf { __left__[.][Leaf](()) }
