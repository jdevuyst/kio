module api;

import __intrinsics__;

host type Atom;

host type Payload;

fn first(pair: Atom & Payload) -> Atom { let .(selected, _discarded) = pair; selected }

fn duplicate(value: Atom) -> Atom & Atom { (value, value) }

// Core sum elimination is the demand subject; elaboration is not involved.
fn select(input: (Atom & Payload) | Atom) -> Atom {
  __either__(Atom & Payload, Atom, Atom, input, .(pair) { first(pair) }, .(value) { value })
}

pub fn choice(input: (Atom & Payload) | Atom) -> Atom & Atom { duplicate(select(input)) }

pub fn nested(input: Atom & Payload) -> Atom & Atom { duplicate(first(input)) }
