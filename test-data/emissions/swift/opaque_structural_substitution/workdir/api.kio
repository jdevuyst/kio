module api;

import elab/spine_elaborators(widen_sum);

host type Box[T];

host type Number role(i32);

host type Flag role(bool);

host fn unbox[T](boxed: Box(T)) -> T;

host fn pack[T](value: T) -> Box(T);

host fn consume(number: Number, flag: Flag) -> Number;

host fn type_stage() -> .;

host fn value_stage() -> .;

fn relay[T](boxed: Box(T)) -> T { unbox(boxed) }

pub fn direct(boxed: Box(Number & Flag)) -> Number { consume(unbox(boxed)) }

pub fn through_relay(boxed: Box(Number & Flag)) -> Number { consume(relay(boxed)) }

fn product_box[A][B](first: A, second: B) -> Box(A & B) { pack((first, second)) }

pub fn product_output(number: Number, flag: Flag) -> Box(Number & Flag) {
  product_box(number, flag)
}

pub fn left_box[A][B](value: A) -> Box(A | B) { pack(value.>widen_sum!(A | B)) }

fn boxed_reader[T](value: T) -> Box([B] B -> T) {
  pack(.[B] { type_stage(); .(input: B) { value_stage(); value } })
}

pub fn captured_reader(value: Number & Flag) -> Box([B] B -> Number & Flag) { boxed_reader(value) }

pub fn unpack_reader(boxed: Box([B] B -> Number & Flag)) -> [B] B -> Number & Flag { unbox(boxed) }
