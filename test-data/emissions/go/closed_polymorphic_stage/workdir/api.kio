module api;

host type Number role(i32);

host type Unused;

host fn selection();

host fn invocation();

pub type { Box[A]: A { pub mk; get } }

pub fn read(value: Box[Number]) -> Number { value.>Box.get }

pub type { Poly: [B] B -> Box[B] { pub mk; pub get } }

pub fn outer[A](unused: A) -> Poly {
  Poly.mk(.[B] {
    selection();
    .(value: B) { invocation(); Box.mk(value) }
  })
}
