mod api;

host type Number role(i32);

host type Count role(i32);

host type Text;

host type Vault[A];

host type Crate[A];

host type Bi[A][B];

pub type { Box[A]: A { pub mk; get } }

pub fn number(value: Number) -> Box[Number] { Box.mk(value) }

pub fn count(value: Count) -> Box[Count] { Box.mk(value) }

pub fn read_number(value: Box[Number]) -> Number { value.>Box.get }

pub fn read_count(value: Box[Count]) -> Count { value.>Box.get }

pub fn read_text(value: Box[Text]) -> Text { value.>Box.get }

pub fn relay[A](value: A) -> A { value }

pub type { Applied[*F][A]: F[A] { pub mk; get } }

pub fn vault(value: Vault[Number]) -> Applied[Vault][Number] { Applied.mk[Vault](value) }

pub fn crate(value: Crate[Number]) -> Applied[Crate][Number] { Applied.mk[Crate](value) }

pub fn partial(value: Bi[Text][Number]) -> Applied[Bi[Text]][Number] { Applied.mk[Bi[Text]](value) }

pub fn read_vault(value: Applied[Vault][Number]) -> Vault[Number] { value.>Applied.get }

pub fn read_crate(value: Applied[Crate][Number]) -> Crate[Number] { value.>Applied.get }

pub fn read_partial(value: Applied[Bi[Text]][Number]) -> Bi[Text][Number] { value.>Applied.get }

pub fn read_other_partial(value: Applied[Bi[Count]][Number]) -> Bi[Count][Number] {
  value.>Applied.get
}

pub rec type { List[A]: . | (A & List[A]) { pub mk; pub get } }

pub rec type { Tree[A]: . | (A & Tree[A]) { pub mk; pub get } }

pub fn list(value: . | (Number & List[Number])) -> List[Number] { List.mk(value) }

pub fn read_list(value: List[Number]) -> . | (Number & List[Number]) { value.>List.get }

pub fn tree(value: . | (Number & Tree[Number])) -> Tree[Number] { Tree.mk(value) }

pub fn read_tree(value: Tree[Number]) -> . | (Number & Tree[Number]) { value.>Tree.get }

rec {
  pub type { Branch[A]: A | Grove[A] { pub mk; pub get } };
  pub type { Grove[A]: . | Branch[A] { pub mk; pub get } }
}

pub fn branch(value: Number | Grove[Number]) -> Branch[Number] { Branch.mk(value) }

pub fn grove(value: . | Branch[Number]) -> Grove[Number] { Grove.mk(value) }

pub fn read_branch(value: Branch[Number]) -> Number | Grove[Number] { value.>Branch.get }

pub fn read_grove(value: Grove[Number]) -> . | Branch[Number] { value.>Grove.get }

pub rec type { Nest[A]: . | (A & Nest[A & A]) { pub mk; pub get } }

pub fn nest(value: . | (Number & Nest[Number & Number])) -> Nest[Number] { Nest.mk(value) }

pub fn nest_pair(value: . | ((Number & Number) & Nest[(Number & Number) & Number & Number])) -> Nest[& Number
& Number] { Nest.mk(value) }

pub fn nest_quad(value: | .
| (& ((Number & Number) & Number & Number)
& Nest[((Number & Number) & Number & Number) & (Number & Number) & Number & Number])) -> Nest[& (& Number
& Number)
& Number
& Number] { Nest.mk(value) }

pub fn read_nest(value: Nest[Number]) -> . | (Number & Nest[Number & Number]) { value.>Nest.get }

pub fn read_nest_pair(value: Nest[Number & Number]) ->
  . | ((Number & Number) & Nest[(Number & Number) & Number & Number])
   { value.>Nest.get }

pub type { Const[A]: Number { pub mk; pub get } }

pub rec type { Wrap: Const[Wrap] { pub mk; pub get } }

pub fn wrap(value: Number) -> Wrap { Wrap.mk(Const.mk[Wrap](value)) }

pub fn read_wrap(value: Wrap) -> Number { value.>Wrap.get.>Const.get }

pub type { Hidden[A] <U>: A & U { mk; pub get } }

pub fn hide(value: Number) -> Hidden[Number] { Hidden.mk((value, ())) }

pub fn reveal(value: Hidden[Number]) -> Number {
  (value.>Hidden.get)(.[U](known: Number, hidden: U) { known })
}
