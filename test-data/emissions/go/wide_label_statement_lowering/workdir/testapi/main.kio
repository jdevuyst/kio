module testapi/main;

import macros/row_macros(macro select, macro with);
import testapi(I32);

pub type {
  A: I32;
  B: I32;
  C: I32;
  D: I32;
  E: I32;
  F: I32;
  G: I32;
  H: I32;
  I: I32;
  J: I32;
  K: I32;
  L: I32
}

pub type Wide = A & B & C & D & E & F & G & H & I & J & K & L;

fn last(row: Wide) -> I32 {
  row.>select { L.get }
}

fn revise(row: Wide) -> Wide {
  row.>with { K.mk(120[I32]) }
}

pub fn entry(row: Wide) -> I32 { last(revise(row)) }
