/// The Kio' lexical token model: the closed token sum the lexer produces and the parser consumes.
module token;

import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(I32, String);

// `token.kio` — the token alphabet for the Kio' term-subset grammar.
//
// The lexer (`lex.kio`) turns Kio' source text into a cons-list of these
// tokens; the parser (`parse.kio`) consumes that list. Kio' lexes a
// fixed, small alphabet (`specs/prime.md` § Lexical structure): word
// tokens (identifiers, including the `__name__` intrinsic spellings and
// keyword-shaped words), numeric and string literals, and a closed set of
// punctuation characters.
//
// A **numeric literal token carries its raw source text** (`"42"`,
// `"-5"`, `"562.406"`), not a parsed number: the interpreter never parses
// a scalar — it hands a literal's text + its host-type annotation to the
// host, which constructs the scalar (`testapi/scalar.kio`'s `make_scalar`).
// So the same numeric token serves every numeric host type (i32 / f64 /
// wider numerics); a float lexes exactly like an integer, as a digit run
// that may carry a single `.`-separated fractional part.
//
// Punctuation is carried as one arm holding the character's code, rather
// than one arm per mark: dispatch on a punctuation token is then a host
// i32 equality against the named character codes (`chars.kio`), keeping
// the token sum small and the parser's punctuation checks uniform.
/// Defines the word-token arm (an identifier, intrinsic name, or keyword-shaped word).
pub labels { tk_word: String };

/// Defines the numeric-literal-token arm (the raw source text, sign and any fractional part kept).
pub labels { tk_num: String };

/// Defines the string-literal-token arm (the decoded content, quotes stripped).
pub labels { tk_str: String };

/// Defines the punctuation-token arm, carrying the mark's character code.
pub labels { tk_punct: I32 };

/// A Kio' lexical token — a newtype over the closed sum of token shapes.
///
/// `Token` is a `newtype` (generated by this `labels` entry), not a bare
/// `type` alias, so a `Token & Toks` product stays a two-factor product
/// of nominal types: a `type`-alias `Token` would unfold its four-arm
/// sum and distribute over the `&` in the cons-list payload, exploding
/// the cons cell's DNF and confusing `match!`. The same reason `prime.kio`
/// makes `Term` a newtype.
pub labels { token: Tk_word | Tk_num | Tk_str | Tk_punct };

/// The bare token sum inside a `Token` — the widen target the token constructors inject into.
pub type Token_shape = Tk_word | Tk_num | Tk_str | Tk_punct;

/// Builds a word token from its spelling.
pub fn tk_word(s: String) -> Token { {token = widen_sum!({tk_word = s}, Token_shape)} }

/// Builds a numeric-literal token from its raw source text.
pub fn tk_num(s: String) -> Token { {token = widen_sum!({tk_num = s}, Token_shape)} }

/// Builds a string-literal token from its decoded content.
pub fn tk_str(s: String) -> Token { {token = widen_sum!({tk_str = s}, Token_shape)} }

/// Builds a punctuation token from its character code.
pub fn tk_punct(c: I32) -> Token { {token = widen_sum!({tk_punct = c}, Token_shape)} }

/// One-step destructor on a `Token`: projects out the token sum for dispatch.
pub fn un_token(t: Token) -> Token_shape { Token.get(t) }

// =====================================================================
// Toks — a cons-list of positioned tokens, the lexer's output and the
// parser's input
// =====================================================================
//
// Each cons cell carries the token plus its **byte offset** into the source
// text it was lexed from (the lexeme's start position). Diagnostics thread
// the offset so a malformed image is reported at its source position; the
// token itself stays position-free, so every dispatch on a `Token`'s shape
// is untouched by the position plumbing.
/// A cons-list of `(token, source-byte-offset)` cells.
pub rec labels { toks: . | (Token & I32 & Toks) };

/// The empty token list.
pub fn toks_nil() -> Toks { {toks = widen_sum!((), . | (Token & I32 & Toks))} }

/// Prepends one token with its source byte offset.
pub fn toks_cons(head: Token, pos: I32, tail: Toks) -> Toks {
  {toks = widen_sum!((head, (pos, tail)), . | (Token & I32 & Toks))}
}

/// One-step destructor on a token list.
pub fn un_toks(ts: Toks) -> . | (Token & I32 & Toks) { Toks.get(ts) }

// =====================================================================
// Round-trip laws (`equiv`)
// =====================================================================
//
// `kio test` discharges these by partial evaluation. They pin the token
// algebra: each constructor followed by the destructor recovers the
// payload in the expected arm, and the list constructors round-trip.
equiv un_word(s: String) {
  un_token(tk_word(s));
  widen_sum!({tk_word = s}, Token_shape)
}

equiv un_num_tok(s: String) {
  un_token(tk_num(s));
  widen_sum!({tk_num = s}, Token_shape)
}

equiv un_str_tok(s: String) {
  un_token(tk_str(s));
  widen_sum!({tk_str = s}, Token_shape)
}

equiv un_punct_tok(c: I32) {
  un_token(tk_punct(c));
  widen_sum!({tk_punct = c}, Token_shape)
}

equiv un_toks_cons(h: Token, p: I32, t: Toks) {
  un_toks(toks_cons(h, p, t));
  widen_sum!((h, (p, t)), . | (Token & I32 & Toks))
}

equiv un_toks_nil() {
  un_toks(toks_nil());
  widen_sum!((), . | (Token & I32 & Toks))
}
