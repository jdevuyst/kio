// `loader.kio` — the resolved-image and instantiation core of
// `dyn_load_prime`.
//
// A host enters through `loader/scan.load_package`, which scans a
// **whole-package Kio' image** and passes its module records and manifest
// bridge to this module's resolver. The resolver is scoped to the
// `loader` subtree: hosts receive a resolved `Image`, never the scanner's
// or resolver's intermediate records.
//
// From those records, the flow is four composed steps over the package's
// term parser (`parse.kio`) and evaluator (`eval.kio`):
//
//   1. **resolve** — turn each scanned declaration body into a resolved erased
//      `Term`. Each function body is parsed (`parse.kio`) against permitted
//      host functions and the preceding guest functions visible from its
//      owning module, in dependency order, so a cross-`fn` reference resolves
//      to its de Bruijn index in the assembled `let`-chain. The parser reads
//      each call's written Kio'
//      packet directly: every leading type argument applies one erased Unit
//      stage, independently of which spelling resolved to the callee.
//   2. **contract-match** — for `instantiate_checked`, structurally compare the
//      image's declared surface against the supplied `Contract`, rejecting a
//      mismatch with a `Diag`. The loader otherwise trusts the image's bodies
//      (the same trust any compiled artifact gets); it does not
//      re-typecheck. "Type errors caught at compile time" still holds: the
//      image's internal errors were caught at its own `kio build`.
//   3. **host-preflight** — compare every exact host type and host-function
//      binding retained by the image with the adapter inventory before any
//      guest binding is evaluated.
//   4. **instantiate** — evaluate every top-level binding exactly once to a
//      universal `Value` (`prime_eval`) in the assembled `let`-chain, then
//      package the operations as `Surface(P)` behind `Loaded`, which hides
//      the internal `Value` representation as the existential witness `P`.
//
// **The host capabilities are threaded through `instantiate`.** A guest's
// host fns are `V_hostfn` values the loader seeds into the guest's
// environment; when one fires, the evaluator hands the `call` capability — a
// host-supplied `(Host_fn & Value) -> Call_result` — the host fn's
// exact descriptor plus the call's domain value, and feeds back the result
// (`eval.kio` § the host capabilities). The evaluator also threads `make_lit`
// (literal construction) and `test_bool` (the conditional decision), so it
// never introspects an opaque scalar. The evaluator hardcodes no host
// vocabulary, so the host decides which capabilities a loaded guest may call.
// `instantiate` takes the three and threads them into every top-level binding
// evaluation and `apply`. The standard ones over `dyn_load_prime`'s own
// `testapi/*` host fns are `hostrec.kio`'s `serve_default` / `make_lit_default` /
// `test_bool_default` (via `defaults.kio`); a host with a different vocabulary
// builds and threads its own.

// =====================================================================
// Diag — a loader diagnostic
// =====================================================================
/// A loader diagnostic: a message, and the image byte offset it points at
/// (`()` when the failure has no source position).
pub labels { diag: String & (. | I32) };

/// Builds a position-free diagnostic from its message.
pub fn mk_diag(message: String) -> Diag { {diag = (message, widen_sum!((), . | I32))} }

/// Builds a diagnostic carrying a source byte offset.
pub fn mk_diag_at(message: String, pos: . | I32) -> Diag { {diag = (message, pos)} }

// =====================================================================
// Decl — one top-level fn declaration extracted from the image
// =====================================================================
//
// A `Decl` is the loader's view of one top-level `fn`: its name, its erased
// runtime stages (one empty stage per unary `forall`, plus each value group),
// its retained header and body token-runs, its complete `Visibility`, and the
// declaration-name byte offset. Named value parameters are kept
// innermost-first so they seed the body scope and the parsed body is wrapped
// in the same closure chain. The scanner builds each module's `Decl` list
// from that module's emitted source text.
/// A binder-name list for a fn's value parameters, innermost first.
pub labels { pnames: List(String) };

/// The empty parameter-name list.
pub fn pnames_nil() -> Pnames { {pnames = nil(String, ())} }

/// Prepends one parameter name.
pub fn pnames_cons(name: String, rest: Pnames) -> Pnames { {pnames = cons(name, Pnames.get(rest))} }

/// One-step destructor on a parameter-name list.
pub fn un_pnames(ps: Pnames) -> . | (String & Pnames) {
  match! uncons(Pnames.get(ps)) {
    (
      , .(h: String, t: List(String)) { widen_sum!((h, {pnames = t}), . | (String & Pnames)) }
      , .(_e: .) { widen_sum!((), . | (String & Pnames)) }
      )
  }
}

/// Whether the name list contains `name`.
pub fn pnames_has(ps: Pnames, name: String) -> Bool {
  elem(.(a: String, b: String) { string_eq(a, b) }, name, Pnames.get(ps))
}

/// Private declaration visibility.
pub labels { visibility_private: . };

/// Unrestricted public declaration visibility.
pub labels { visibility_public: . };

/// Public visibility restricted to one module-path subtree.
pub labels { visibility_scoped: String };

/// The complete visibility carried by a declaration in a loaded artifact.
pub labels { visibility: Visibility_private | Visibility_public | Visibility_scoped };

/// Builds private visibility.
pub fn private_visibility() -> Visibility {
  {visibility = widen_sum!(
    , {visibility_private=}
    , Visibility_private | Visibility_public | Visibility_scoped
    )}
}

/// Builds unrestricted public visibility.
pub fn public_visibility() -> Visibility {
  {visibility = widen_sum!(
    , {visibility_public=}
    , Visibility_private | Visibility_public | Visibility_scoped
    )}
}

/// Builds visibility restricted to the module subtree rooted at `root`.
pub fn scoped_visibility(root: String) -> Visibility {
  {visibility = widen_sum!(
    , {visibility_scoped = root}
    , Visibility_private | Visibility_public | Visibility_scoped
    )}
}

/// Whether this visibility reaches the host-facing public surface.
pub fn visibility_is_public(visibility: Visibility) -> Bool {
  match! Visibility.get(visibility) {
    (
      , .(_private: Visibility_private) { .f(Bool) }
      , .(_public: Visibility_public) { .t(Bool) }
      , .(_scoped: Visibility_scoped) { .f(Bool) }
      )
  }
}

/// Whether this visibility carries a module-subtree restriction.
pub fn visibility_is_scoped(visibility: Visibility) -> Bool {
  match! Visibility.get(visibility) {
    (
      , .(_private: Visibility_private) { .f(Bool) }
      , .(_public: Visibility_public) { .f(Bool) }
      , .(_scoped: Visibility_scoped) { .t(Bool) }
      )
  }
}

// Whether `prefix` is a whole-segment prefix of `path`.
fn module_path_has_prefix(prefix: String, path: String) -> Bool {
  let prefix_len = string_len(prefix);
  let path_len = string_len(path);
  if! lt_i32(path_len, prefix_len) {
    .f(Bool)
  } else {
    loop(
      , .(pos: I32) {
          if! eq_i32(pos, prefix_len) {
            if! eq_i32(pos, path_len) {
              widen_sum!(.t(Bool), I32 | Bool)
            } else match! string_code_at(path, pos) {
              (
                , .(code: I32) { widen_sum!(eq_i32(code, 47(I32)), I32 | Bool) }
                , .(_missing: .) { widen_sum!(.f(Bool), I32 | Bool) }
                )
            }
          } else match! string_code_at(prefix, pos) {
            (
              , .(prefix_code: I32) {
                  match! string_code_at(path, pos) {
                    (
                      , .(path_code: I32) {
                          if! eq_i32(prefix_code, path_code) {
                            widen_sum!(add_i32(pos, 1(I32)), I32 | Bool)
                          } else {
                            widen_sum!(.f(Bool), I32 | Bool)
                          }
                        }
                      , .(_missing_path: .) { widen_sum!(.f(Bool), I32 | Bool) }
                      )
                  }
                }
              , .(_missing_prefix: .) { widen_sum!(.f(Bool), I32 | Bool) }
              )
          }
        }
      , 0(I32)
      )
  }
}

/// Whether a visibility declaration is well-formed for its owning module.
pub fn visibility_valid_for_owner(visibility: Visibility, owner: String) -> Bool {
  match! Visibility.get(visibility) {
    (
      , .(_private: Visibility_private) { .t(Bool) }
      , .(_public: Visibility_public) { .t(Bool) }
      , .(scoped: Visibility_scoped) {
          module_path_has_prefix(Visibility_scoped.get(scoped), owner)
        }
      )
  }
}

/// Whether `consumer` may refer to an owned declaration with this visibility.
pub fn visibility_allows(visibility: Visibility, owner: String, consumer: String) -> Bool {
  match! Visibility.get(visibility) {
    (
      , .(_private: Visibility_private) { string_eq(owner, consumer) }
      , .(_public: Visibility_public) { .t(Bool) }
      , .(scoped: Visibility_scoped) {
          let root = Visibility_scoped.get(scoped);
          if! module_path_has_prefix(root, owner) {
            module_path_has_prefix(root, consumer)
          } else {
            .f(Bool)
          }
        }
      )
  }
}

// Join an owner or lexical alias to its final selected name with `.`.
fn dot_join(a: String, b: String) -> String { string_concat(a, string_concat("."(String), b)) }

// Render a name list as a comma-separated run (diagnostic text).
fn pnames_render(ps: Pnames) -> String {
  match! un_pnames(ps) {
    (
      , .(first: String, rest0: Pnames) {
          loop(
            , .(st: String & Pnames) {
                match! st {
                  .(acc: String, rem: Pnames) {
                    match! un_pnames(rem) {
                      (
                        , .(h: String, rest: Pnames) {
                            widen_sum!(
                              , (string_concat(acc, string_concat(", "(String), h)), rest)
                              , (String & Pnames) | String
                              )
                          }
                        , .(_e: .) { widen_sum!(acc, (String & Pnames) | String) }
                        )
                    }
                  }
                }
              }
            , (first, rest0)
            )
        }
      , .(_e: .) { ""(String) }
      )
  }
}

/// A declaration's erased runtime stages. Each unary `forall` contributes an
/// empty `Pnames` stage whose closure accepts Unit; each `(…)` group contributes
/// one named value-domain stage. The grammar admits several successive groups
/// (`Signature ::= SignatureGroup+`), which form one curried closure chain.
pub labels { pgroups: List(Pnames) };

/// The empty group sequence.
pub fn pgroups_nil() -> Pgroups { {pgroups = nil(Pnames, ())} }

/// Prepends one erased runtime stage.
pub fn pgroups_cons(head: Pnames, tail: Pgroups) -> Pgroups {
  {pgroups = cons(head, Pgroups.get(tail))}
}

/// One-step destructor on a group sequence.
pub fn un_pgroups(gs: Pgroups) -> . | (Pnames & Pgroups) {
  match! uncons(Pgroups.get(gs)) {
    (
      , .(h: Pnames, t: List(Pnames)) { widen_sum!((h, {pgroups = t}), . | (Pnames & Pgroups)) }
      , .(_e: .) { widen_sum!((), . | (Pnames & Pgroups)) }
      )
  }
}

/// A one-group sequence.
pub fn pgroups_one(g: Pnames) -> Pgroups { pgroups_cons(g, pgroups_nil()) }

/// Defines one top-level fn declaration: name, runtime parameter stages,
/// header token-run (the
/// signature from just after the name up to the body's `{` — type-binder
/// groups, value parameters with their types, and any return type,
/// retained for typed contract-matching), body tokens, visibility, and
/// declaration position.
pub labels { decl: String & Pgroups & Toks & Toks & Visibility & I32 };

/// Builds a fn declaration.
pub fn mk_decl(
  , name: String
  , params: Pgroups
  , header: Toks
  , body: Toks
  , visibility: Visibility
  , decl_pos: I32
  ) -> Decl { {decl = (name, (params, (header, (body, (visibility, decl_pos)))))} }

/// One-step destructor on a fn declaration.
pub fn un_decl(d: Decl) -> String & Pgroups & Toks & Toks & Visibility & I32 { Decl.get(d) }

/// The declaration's name.
pub fn decl_name(d: Decl) -> String {
  match! un_decl(d) {
    .(n: String, _p: Pgroups, _h: Toks, _b: Toks, _v: Visibility, _pos: I32) { n }
  }
}

/// The declaration's erased runtime stages.
pub fn decl_params(d: Decl) -> Pgroups {
  match! un_decl(d) {
    .(_n: String, p: Pgroups, _h: Toks, _b: Toks, _v: Visibility, _pos: I32) { p }
  }
}

/// The declaration's header token-run (its signature, name excluded).
pub fn decl_header(d: Decl) -> Toks {
  match! un_decl(d) {
    .(_n: String, _p: Pgroups, h: Toks, _b: Toks, _v: Visibility, _pos: I32) { h }
  }
}

/// The declaration's body token-run.
pub fn decl_body(d: Decl) -> Toks {
  match! un_decl(d) {
    .(_n: String, _p: Pgroups, _h: Toks, b: Toks, _v: Visibility, _pos: I32) { b }
  }
}

/// The declaration's complete visibility.
pub fn decl_visibility(d: Decl) -> Visibility {
  match! un_decl(d) {
    .(_n: String, _p: Pgroups, _h: Toks, _b: Toks, v: Visibility, _pos: I32) { v }
  }
}

/// Whether the declaration is host-exported (plain `pub`).
pub fn decl_exported(d: Decl) -> Bool { visibility_is_public(decl_visibility(d)) }

/// Whether the declaration is `pub(path)`-scoped: importable inside the
/// image, never a host export.
pub fn decl_scoped(d: Decl) -> Bool { visibility_is_scoped(decl_visibility(d)) }

/// The declaration-name byte offset within the source image.
pub fn decl_pos(d: Decl) -> I32 {
  match! un_decl(d) {
    .(_n: String, _p: Pgroups, _h: Toks, _b: Toks, _v: Visibility, pos: I32) { pos }
  }
}

/// A cons-list of fn declarations, in dependency order (earliest first).
pub labels { decls: List(Decl) };

/// The empty declaration list.
pub fn decls_nil() -> Decls { {decls = nil(Decl, ())} }

/// Prepends one declaration.
pub fn decls_cons(head: Decl, tail: Decls) -> Decls { {decls = cons(head, Decls.get(tail))} }

/// One-step destructor on a declaration list.
pub fn un_decls(ds: Decls) -> . | (Decl & Decls) {
  match! uncons(Decls.get(ds)) {
    (
      , .(h: Decl, t: List(Decl)) { widen_sum!((h, {decls = t}), . | (Decl & Decls)) }
      , .(_e: .) { widen_sum!((), . | (Decl & Decls)) }
      )
  }
}

// The declaration named `name`, or `()` when the list has no such fn.
fn decls_find(ds: Decls, name: String) -> . | Decl {
  loop(
    , .(remaining: Decls) {
        match! un_decls(remaining) {
          (
            , .(decl: Decl, rest: Decls) {
                if! string_eq(decl_name(decl), name) {
                  widen_sum!(widen_sum!(decl, . | Decl), Decls | . | Decl)
                } else {
                  widen_sum!(rest, Decls | . | Decl)
                }
              }
            , .(_empty: .) { widen_sum!(widen_sum!((), . | Decl), Decls | . | Decl) }
            )
        }
      }
    , ds
    )
}

// =====================================================================
// Module / Imports — the per-module structure of a whole-package image
// =====================================================================
//
// A whole-package image is several modules' emitted Kio' text. To resolve
// a cross-module reference **open-world-safely**, each module's bodies must
// resolve a bare name through *that module's own decls and its imports* —
// never a global flat namespace (a `pub fn foo` added to module B must not
// change how module C's `foo` resolves when C imports its `foo` from
// module A). So the package scanner records, per module, the module's
// name, the names it imports and the module each comes from, and its
// declarations.
//
// `Imports` is the import map: a cons-list of `(local-name, source-module)`
// entries, one per name in each selective `import m(…);` header — there
// the local name and the source declaration's name coincide. The declaration
// satisfies that entry only when its visibility admits the importing module:
// plain `pub`, or a matching `pub(path)`. The emit's other import form, the
// module alias `import m as a;`, is recorded separately (`Aliases` below); it
// provides `a.name` spellings subject to the same visibility gate rather than
// importing names one by one.
/// An import entry: a name and the module it is imported from.
pub labels { import: String & String };

/// Builds an import entry (local name, source module).
pub fn mk_import(name: String, from_module: String) -> Import { {import = (name, from_module)} }

/// One-step destructor on an import entry.
pub fn un_import(i: Import) -> String & String { Import.get(i) }

/// A cons-list of import entries.
pub labels { imports: List(Import) };

/// The empty import map.
pub fn imports_nil() -> Imports { {imports = nil(Import, ())} }

/// Prepends one import entry.
pub fn imports_cons(head: Import, tail: Imports) -> Imports {
  {imports = cons(head, Imports.get(tail))}
}

/// One-step destructor on an import map.
pub fn un_imports(im: Imports) -> . | (Import & Imports) {
  match! uncons(Imports.get(im)) {
    (
      , .(h: Import, t: List(Import)) { widen_sum!((h, {imports = t}), . | (Import & Imports)) }
      , .(_e: .) { widen_sum!((), . | (Import & Imports)) }
      )
  }
}

/// A module-alias entry: the local alias and the module it names
/// (`import path/to/mod as a;` records `(a, path/to/mod)`).
pub labels { mod_alias: String & String };

/// Builds a module-alias entry.
pub fn mk_alias(alias: String, target_module: String) -> Mod_alias {
  {mod_alias = (alias, target_module)}
}

/// The alias's local spelling.
pub fn alias_name(a: Mod_alias) -> String {
  match! Mod_alias.get(a) {
    .(n: String, _m: String) { n }
  }
}

/// The module the alias names.
pub fn alias_target(a: Mod_alias) -> String {
  match! Mod_alias.get(a) {
    .(_n: String, m: String) { m }
  }
}

/// A cons-list of module-alias entries.
pub labels { aliases: List(Mod_alias) };

/// The empty alias list.
pub fn aliases_nil() -> Aliases { {aliases = nil(Mod_alias, ())} }

/// Prepends one alias entry.
pub fn aliases_cons(head: Mod_alias, tail: Aliases) -> Aliases {
  {aliases = cons(head, Aliases.get(tail))}
}

/// One-step destructor on an alias list.
pub fn un_aliases(a: Aliases) -> . | (Mod_alias & Aliases) {
  match! uncons(Aliases.get(a)) {
    (
      , .(h: Mod_alias, t: List(Mod_alias)) {
          widen_sum!((h, {aliases = t}), . | (Mod_alias & Aliases))
        }
      , .(_e: .) { widen_sum!((), . | (Mod_alias & Aliases)) }
      )
  }
}

/// The source identity of one explicit recursive-data scope.
pub labels { recursive_type_scope: I32 };

/// Builds a recursive-data scope identity from the marker's byte offset.
pub fn recursive_type_scope(pos: I32) -> . | Recursive_type_scope {
  widen_sum!({recursive_type_scope = pos}, . | Recursive_type_scope)
}

/// The absence of an explicit recursive-data scope.
pub fn no_recursive_type_scope() -> . | Recursive_type_scope {
  widen_sum!((), . | Recursive_type_scope)
}

fn recursive_type_scopes_match(left: . | Recursive_type_scope, right: . | Recursive_type_scope) -> Bool {
  match! left {
    (
      , .(left_scope: Recursive_type_scope) {
          match! right {
            (
              , .(right_scope: Recursive_type_scope) {
                  eq_i32(
                    , Recursive_type_scope.get(left_scope)
                    , Recursive_type_scope.get(right_scope)
                    )
                }
              , .(_right_unscoped: .) { .f(Bool) }
              )
          }
        }
      , .(_left_unscoped: .) { .f(Bool) }
      )
  }
}

/// One own-module newtype's export-surface record: its name and declaration
/// position, erasure facts, the newtype and member visibilities, and the retained header run
/// (`[A]… <U>… : TYPE`) its member signatures render from, plus its exact
/// explicit recursive-data scope when one exists.
pub labels { member_decl: & String
& I32
& Nt_info
& Visibility
& Visibility
& Visibility
& Toks
& (. | Recursive_type_scope) };

/// Builds a member-surface record.
pub fn mk_member_decl(
  , name: String
  , decl_pos: I32
  , info: Nt_info
  , nt_visibility: Visibility
  , ctor_visibility: Visibility
  , proj_visibility: Visibility
  , header: Toks
  , recursive_scope: . | Recursive_type_scope
  ) -> Member_decl {
  {member_decl = (
    , name
    , (
        , decl_pos
        , (info, (nt_visibility, (ctor_visibility, (proj_visibility, (header, recursive_scope)))))
        )
    )}
}

/// The newtype's name.
pub fn member_name(m: Member_decl) -> String {
  match! Member_decl.get(m) {
    .(
      , n: String
      , _pos: I32
      , _i: Nt_info
      , _nv: Visibility
      , _cv: Visibility
      , _pv: Visibility
      , _h: Toks
      , _scope: . | Recursive_type_scope
      ) { n }
  }
}

/// The newtype declaration-name byte offset within the source image.
pub fn member_decl_pos(m: Member_decl) -> I32 {
  match! Member_decl.get(m) {
    .(
      , _n: String
      , pos: I32
      , _i: Nt_info
      , _nv: Visibility
      , _cv: Visibility
      , _pv: Visibility
      , _h: Toks
      , _scope: . | Recursive_type_scope
      ) { pos }
  }
}

/// The newtype's erasure facts.
pub fn member_info(m: Member_decl) -> Nt_info {
  match! Member_decl.get(m) {
    .(
      , _n: String
      , _pos: I32
      , i: Nt_info
      , _nv: Visibility
      , _cv: Visibility
      , _pv: Visibility
      , _h: Toks
      , _scope: . | Recursive_type_scope
      ) { i }
  }
}

/// The newtype declaration's complete visibility.
pub fn member_nt_visibility(m: Member_decl) -> Visibility {
  match! Member_decl.get(m) {
    .(
      , _n: String
      , _pos: I32
      , _i: Nt_info
      , visibility: Visibility
      , _cv: Visibility
      , _pv: Visibility
      , _h: Toks
      , _scope: . | Recursive_type_scope
      ) { visibility }
  }
}

/// The constructor member's complete visibility.
pub fn member_ctor_visibility(m: Member_decl) -> Visibility {
  match! Member_decl.get(m) {
    .(
      , _n: String
      , _pos: I32
      , _i: Nt_info
      , _nv: Visibility
      , visibility: Visibility
      , _pv: Visibility
      , _h: Toks
      , _scope: . | Recursive_type_scope
      ) { visibility }
  }
}

/// The projector member's complete visibility.
pub fn member_proj_visibility(m: Member_decl) -> Visibility {
  match! Member_decl.get(m) {
    .(
      , _n: String
      , _pos: I32
      , _i: Nt_info
      , _nv: Visibility
      , _cv: Visibility
      , visibility: Visibility
      , _h: Toks
      , _scope: . | Recursive_type_scope
      ) { visibility }
  }
}

/// Whether the newtype declaration itself is plain-`pub`.
pub fn member_nt_pub(m: Member_decl) -> Bool { visibility_is_public(member_nt_visibility(m)) }

/// Whether the constructor member is plain-`pub`.
pub fn member_ctor_pub(m: Member_decl) -> Bool { visibility_is_public(member_ctor_visibility(m)) }

/// Whether the projector member is plain-`pub`.
pub fn member_proj_pub(m: Member_decl) -> Bool { visibility_is_public(member_proj_visibility(m)) }

/// The retained newtype header run.
pub fn member_header(m: Member_decl) -> Toks {
  match! Member_decl.get(m) {
    .(
      , _n: String
      , _pos: I32
      , _i: Nt_info
      , _nv: Visibility
      , _cv: Visibility
      , _pv: Visibility
      , h: Toks
      , _scope: . | Recursive_type_scope
      ) { h }
  }
}

/// The exact explicit recursive-data scope of the newtype, when present.
pub fn member_recursive_scope(m: Member_decl) -> . | Recursive_type_scope {
  match! Member_decl.get(m) {
    .(
      , _n: String
      , _pos: I32
      , _i: Nt_info
      , _nv: Visibility
      , _cv: Visibility
      , _pv: Visibility
      , _h: Toks
      , scope: . | Recursive_type_scope
      ) { scope }
  }
}

/// A module's member-surface records, declaration order.
pub labels { members: List(Member_decl) };

/// The empty member list.
pub fn members_nil() -> Members { {members = nil(Member_decl, ())} }

/// Prepends one member record.
pub fn members_cons(head: Member_decl, tail: Members) -> Members {
  {members = cons(Member_decl, head, Members.get(tail))}
}

/// One-step destructor on a member list.
pub fn un_members(ms: Members) -> . | (Member_decl & Members) {
  match! uncons(Member_decl, Members.get(ms)) {
    (
      , .(h: Member_decl, t: List(Member_decl)) {
          widen_sum!((h, {members = t}), . | (Member_decl & Members))
        }
      , .(_e: .) { widen_sum!((), . | (Member_decl & Members)) }
      )
  }
}

/// Reverses a member list.
pub fn members_reverse(ms: Members) -> Members { {members = reverse(Member_decl, Members.get(ms))} }

// The newtype member record named `name`, or `()` when absent.
fn members_find(ms: Members, name: String) -> . | Member_decl {
  loop(
    , .(remaining: Members) {
        match! un_members(remaining) {
          (
            , .(member: Member_decl, rest: Members) {
                if! string_eq(member_name(member), name) {
                  widen_sum!(widen_sum!(member, . | Member_decl), Members | . | Member_decl)
                } else {
                  widen_sum!(rest, Members | . | Member_decl)
                }
              }
            , .(_empty: .) {
                widen_sum!(widen_sum!((), . | Member_decl), Members | . | Member_decl)
              }
            )
        }
      }
    , ms
    )
}

/// One type binder's spelling and kind-star count.
pub labels { binder_info: String & I32 };

/// A list of binder infos in introduction order.
pub labels { binders: List(Binder_info) };

/// The empty binder list.
pub fn binders_nil() -> Binders { {binders = nil(Binder_info, ())} }

/// Prepends one binder.
pub fn binders_cons(head: Binder_info, tail: Binders) -> Binders {
  {binders = cons(Binder_info, head, Binders.get(tail))}
}

/// One-step destructor on a binder list.
pub fn un_binders(binders: Binders) -> . | (Binder_info & Binders) {
  match! uncons(Binder_info, Binders.get(binders)) {
    (
      , .(head: Binder_info, tail: List(Binder_info)) {
          widen_sum!((head, {binders = tail}), . | (Binder_info & Binders))
        }
      , .(_empty: .) { widen_sum!((), . | (Binder_info & Binders)) }
      )
  }
}

/// Reverses a binder list.
pub fn binders_reverse(binders: Binders) -> Binders {
  {binders = reverse(Binder_info, Binders.get(binders))}
}

/// One retained `type` alias declaration: name, positional binders, body
/// token-run (the text after `=`, semicolon excluded), visibility, and
/// declaration byte offset, plus its exact recursive group when present.
pub labels { alias_decl: String & Binders & Toks & Visibility & I32 & (. | Recursive_type_scope) };

/// Builds a retained alias record.
pub fn mk_alias_decl(
  , name: String
  , binders: Binders
  , body: Toks
  , visibility: Visibility
  , decl_pos: I32
  , recursive_scope: . | Recursive_type_scope
  ) -> Alias_decl { {alias_decl = (name, binders, body, visibility, decl_pos, recursive_scope)} }

/// The alias's name.
pub fn tyalias_name(a: Alias_decl) -> String {
  match! Alias_decl.get(a) {
    .(n: String, _b: Binders, _t: Toks, _v: Visibility, _p: I32, _scope: . | Recursive_type_scope) {
      n
    }
  }
}

/// The alias's binder names, declaration order.
pub fn tyalias_binders(a: Alias_decl) -> Binders {
  match! Alias_decl.get(a) {
    .(_n: String, b: Binders, _t: Toks, _v: Visibility, _p: I32, _scope: . | Recursive_type_scope) {
      b
    }
  }
}

fn tyalias_binder_names(a: Alias_decl) -> Pnames {
  loop(
    , .(state: Binders & Pnames) {
        match! state {
          .(remaining: Binders, reversed: Pnames) {
            match! un_binders(remaining) {
              (
                , .(binder: Binder_info, rest: Binders) {
                    match! Binder_info.get(binder) {
                      .(name: String, _stars: I32) {
                        widen_sum!((rest, pnames_cons(name, reversed)), (Binders & Pnames) | Pnames)
                      }
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , {pnames = reverse(String, Pnames.get(reversed))}
                      , (Binders & Pnames) | Pnames
                      )
                  }
                )
            }
          }
        }
      }
    , (tyalias_binders(a), pnames_nil())
    )
}

/// The alias's body token-run.
pub fn tyalias_body(a: Alias_decl) -> Toks {
  match! Alias_decl.get(a) {
    .(_n: String, _b: Binders, t: Toks, _v: Visibility, _p: I32, _scope: . | Recursive_type_scope) {
      t
    }
  }
}

/// The alias declaration's complete visibility.
pub fn tyalias_visibility(a: Alias_decl) -> Visibility {
  match! Alias_decl.get(a) {
    .(
      , _n: String
      , _b: Binders
      , _t: Toks
      , visibility: Visibility
      , _p: I32
      , _scope: . | Recursive_type_scope
      ) { visibility }
  }
}

/// The declaration-name byte offset within the source image.
pub fn tyalias_decl_pos(a: Alias_decl) -> I32 {
  match! Alias_decl.get(a) {
    .(_n: String, _b: Binders, _t: Toks, _v: Visibility, p: I32, _scope: . | Recursive_type_scope) {
      p
    }
  }
}

/// The alias's exact recursive group, when present.
pub fn tyalias_recursive_scope(a: Alias_decl) -> . | Recursive_type_scope {
  match! Alias_decl.get(a) {
    .(_n: String, _b: Binders, _t: Toks, _v: Visibility, _p: I32, scope: . | Recursive_type_scope) {
      scope
    }
  }
}

/// A module's retained `type` aliases, declaration order.
pub labels { tyaliases: List(Alias_decl) };

/// The empty alias list.
pub fn tyaliases_nil() -> Tyaliases { {tyaliases = nil(Alias_decl, ())} }

/// Prepends one alias record.
pub fn tyaliases_cons(head: Alias_decl, tail: Tyaliases) -> Tyaliases {
  {tyaliases = cons(head, Tyaliases.get(tail))}
}

/// One-step destructor on an alias list.
pub fn un_tyaliases(as0: Tyaliases) -> . | (Alias_decl & Tyaliases) {
  match! uncons(Tyaliases.get(as0)) {
    (
      , .(h: Alias_decl, t: List(Alias_decl)) {
          widen_sum!((h, {tyaliases = t}), . | (Alias_decl & Tyaliases))
        }
      , .(_e: .) { widen_sum!((), . | (Alias_decl & Tyaliases)) }
      )
  }
}

/// Reverses an alias list.
pub fn tyaliases_reverse(as0: Tyaliases) -> Tyaliases {
  loop(
    , .(st: Tyaliases & Tyaliases) {
        match! st {
          .(rem: Tyaliases, acc: Tyaliases) {
            match! un_tyaliases(rem) {
              (
                , .(h: Alias_decl, rest: Tyaliases) {
                    widen_sum!((rest, tyaliases_cons(h, acc)), (Tyaliases & Tyaliases) | Tyaliases)
                  }
                , .(_e: .) { widen_sum!(acc, (Tyaliases & Tyaliases) | Tyaliases) }
                )
            }
          }
        }
      }
    , (as0, tyaliases_nil())
    )
}

// The retained alias named `name`, or `()` when absent.
fn tyaliases_find(aliases: Tyaliases, name: String) -> . | Alias_decl {
  loop(
    , .(remaining: Tyaliases) {
        match! un_tyaliases(remaining) {
          (
            , .(alias: Alias_decl, rest: Tyaliases) {
                if! string_eq(tyalias_name(alias), name) {
                  widen_sum!(widen_sum!(alias, . | Alias_decl), Tyaliases | . | Alias_decl)
                } else {
                  widen_sum!(rest, Tyaliases | . | Alias_decl)
                }
              }
            , .(_empty: .) {
                widen_sum!(widen_sum!((), . | Alias_decl), Tyaliases | . | Alias_decl)
              }
            )
        }
      }
    , aliases
    )
}

/// One retained host declaration header: whether it is a function, its
/// declaration-local name, the tokens after that name through the terminating
/// semicolon (with the semicolon excluded), and its declaration byte offset.
pub labels { host_header: Bool & String & Toks & I32 };

/// Builds one retained host declaration header.
pub fn mk_host_header(is_fn: Bool, name: String, header: Toks, decl_pos: I32) -> Host_header {
  {host_header = (is_fn, name, header, decl_pos)}
}

/// Whether the retained declaration is a host function rather than a host type.
pub fn host_header_is_fn(header: Host_header) -> Bool {
  match! Host_header.get(header) {
    .(is_fn: Bool, _name: String, _tokens: Toks, _decl_pos: I32) { is_fn }
  }
}

/// The declaration-local name of a retained host declaration.
pub fn host_header_name(header: Host_header) -> String {
  match! Host_header.get(header) {
    .(_is_fn: Bool, name: String, _tokens: Toks, _decl_pos: I32) { name }
  }
}

/// The retained tokens following a host declaration's local name.
pub fn host_header_tokens(header: Host_header) -> Toks {
  match! Host_header.get(header) {
    .(_is_fn: Bool, _name: String, tokens: Toks, _decl_pos: I32) { tokens }
  }
}

/// The declaration-name byte offset within the source image.
pub fn host_header_decl_pos(header: Host_header) -> I32 {
  match! Host_header.get(header) {
    .(_is_fn: Bool, _name: String, _tokens: Toks, decl_pos: I32) { decl_pos }
  }
}

/// A source-ordered list of retained host declaration headers.
pub labels { host_headers: List(Host_header) };

/// The empty retained host-declaration list.
pub fn host_headers_nil() -> Host_headers { {host_headers = nil(Host_header, ())} }

/// Prepends one retained host declaration.
pub fn host_headers_cons(head: Host_header, tail: Host_headers) -> Host_headers {
  {host_headers = cons(Host_header, head, Host_headers.get(tail))}
}

/// One-step destructor on retained host declaration headers.
pub fn un_host_headers(headers: Host_headers) -> . | (Host_header & Host_headers) {
  match! uncons(Host_header, Host_headers.get(headers)) {
    (
      , .(head: Host_header, tail: List(Host_header)) {
          widen_sum!((head, {host_headers = tail}), . | (Host_header & Host_headers))
        }
      , .(_empty: .) { widen_sum!((), . | (Host_header & Host_headers)) }
      )
  }
}

/// Reverses retained host declarations into source order.
pub fn host_headers_reverse(headers: Host_headers) -> Host_headers {
  {host_headers = reverse(Host_header, Host_headers.get(headers))}
}

/// One module of a whole-package image: its name, import map, module
/// aliases, its own newtype table (bare names), its fn declarations, its
/// `host fn` declaration names, its type-introducing declaration names
/// (`host type` and `type` aliases — the importable non-value names), and
/// its own newtypes' member-surface records, and the source headers of its
/// host declarations.
pub labels { module: & String
& Imports
& Aliases
& Ntab
& Decls
& Pnames
& Pnames
& Members
& Tyaliases
& Host_headers };

/// Builds a module record.
pub fn mk_module(
  , name: String
  , imports: Imports
  , aliases: Aliases
  , newtypes: Ntab
  , decls: Decls
  , hostfns: Pnames
  , typenames: Pnames
  , members: Members
  , als: Tyaliases
  , host_headers: Host_headers
  ) -> Module {
  {module = (
    , name
    , (
        , imports
        , (aliases, (newtypes, (decls, (hostfns, (typenames, (members, (als, host_headers)))))))
        )
    )}
}

/// One-step destructor on a module record.
pub fn un_module(m: Module) ->
  String & Imports & Aliases & Ntab & Decls & Pnames & Pnames & Members & Tyaliases & Host_headers
   { Module.get(m) }

/// The module's name.
pub fn module_name(m: Module) -> String {
  match! un_module(m) {
    .(
      , n: String
      , _i: Imports
      , _a: Aliases
      , _nt: Ntab
      , _d: Decls
      , _h: Pnames
      , _t: Pnames
      , _mm: Members
      , _als: Tyaliases
      , _host_headers: Host_headers
      ) { n }
  }
}

/// The module's import map.
pub fn module_imports(m: Module) -> Imports {
  match! un_module(m) {
    .(
      , _n: String
      , i: Imports
      , _a: Aliases
      , _nt: Ntab
      , _d: Decls
      , _h: Pnames
      , _t: Pnames
      , _mm: Members
      , _als: Tyaliases
      , _host_headers: Host_headers
      ) { i }
  }
}

/// The module's alias map.
pub fn module_aliases(m: Module) -> Aliases {
  match! un_module(m) {
    .(
      , _n: String
      , _i: Imports
      , a: Aliases
      , _nt: Ntab
      , _d: Decls
      , _h: Pnames
      , _t: Pnames
      , _mm: Members
      , _als: Tyaliases
      , _host_headers: Host_headers
      ) { a }
  }
}

/// The module's own newtype table (bare names).
pub fn module_newtypes(m: Module) -> Ntab {
  match! un_module(m) {
    .(
      , _n: String
      , _i: Imports
      , _a: Aliases
      , nt: Ntab
      , _d: Decls
      , _h: Pnames
      , _t: Pnames
      , _mm: Members
      , _als: Tyaliases
      , _host_headers: Host_headers
      ) { nt }
  }
}

/// The module's fn declarations.
pub fn module_decls(m: Module) -> Decls {
  match! un_module(m) {
    .(
      , _n: String
      , _i: Imports
      , _a: Aliases
      , _nt: Ntab
      , d: Decls
      , _h: Pnames
      , _t: Pnames
      , _mm: Members
      , _als: Tyaliases
      , _host_headers: Host_headers
      ) { d }
  }
}

/// The module's `host fn` declaration names.
pub fn module_hostfns(m: Module) -> Pnames {
  match! un_module(m) {
    .(
      , _n: String
      , _i: Imports
      , _a: Aliases
      , _nt: Ntab
      , _d: Decls
      , h: Pnames
      , _t: Pnames
      , _mm: Members
      , _als: Tyaliases
      , _host_headers: Host_headers
      ) { h }
  }
}

/// The module's type-introducing declaration names (`host type` + `type`).
pub fn module_typenames(m: Module) -> Pnames {
  match! un_module(m) {
    .(
      , _n: String
      , _i: Imports
      , _a: Aliases
      , _nt: Ntab
      , _d: Decls
      , _h: Pnames
      , t: Pnames
      , _mm: Members
      , _als: Tyaliases
      , _host_headers: Host_headers
      ) { t }
  }
}

/// The module's own newtypes' member-surface records.
pub fn module_members(m: Module) -> Members {
  match! un_module(m) {
    .(
      , _n: String
      , _i: Imports
      , _a: Aliases
      , _nt: Ntab
      , _d: Decls
      , _h: Pnames
      , _t: Pnames
      , mm: Members
      , _als: Tyaliases
      , _host_headers: Host_headers
      ) { mm }
  }
}

/// The module's retained `type` aliases.
pub fn module_tyaliases(m: Module) -> Tyaliases {
  match! un_module(m) {
    .(
      , _n: String
      , _i: Imports
      , _a: Aliases
      , _nt: Ntab
      , _d: Decls
      , _h: Pnames
      , _t: Pnames
      , _mm: Members
      , als: Tyaliases
      , _host_headers: Host_headers
      ) { als }
  }
}

/// The module's retained host declaration headers in source order.
pub fn module_host_headers(m: Module) -> Host_headers {
  match! un_module(m) {
    .(
      , _n: String
      , _i: Imports
      , _a: Aliases
      , _nt: Ntab
      , _d: Decls
      , _h: Pnames
      , _t: Pnames
      , _mm: Members
      , _als: Tyaliases
      , host_headers: Host_headers
      ) { host_headers }
  }
}

// Whether the module declares the exact host type name.
fn module_declares_host_type(module: Module, name: String) -> Bool {
  loop(
    , .(remaining: Host_headers) {
        match! un_host_headers(remaining) {
          (
            , .(header: Host_header, rest: Host_headers) {
                if! host_header_is_fn(header) {
                  widen_sum!(rest, Host_headers | Bool)
                } else if! string_eq(host_header_name(header), name) {
                  widen_sum!(.t(Bool), Host_headers | Bool)
                } else {
                  widen_sum!(rest, Host_headers | Bool)
                }
              }
            , .(_empty: .) { widen_sum!(.f(Bool), Host_headers | Bool) }
            )
        }
      }
    , module_host_headers(module)
    )
}

/// A cons-list of modules (a whole-package image).
pub labels { modules: List(Module) };

/// The empty module list.
pub fn modules_nil() -> Modules { {modules = nil(Module, ())} }

/// Prepends one module.
pub fn modules_cons(head: Module, tail: Modules) -> Modules {
  {modules = cons(head, Modules.get(tail))}
}

/// One-step destructor on a module list.
pub fn un_modules(ms: Modules) -> . | (Module & Modules) {
  match! uncons(Modules.get(ms)) {
    (
      , .(h: Module, t: List(Module)) { widen_sum!((h, {modules = t}), . | (Module & Modules)) }
      , .(_e: .) { widen_sum!((), . | (Module & Modules)) }
      )
  }
}

// The module record named `name`, or `()` when the image has none.
fn find_module(ms: Modules, name: String) -> . | Module {
  loop(
    , .(rem: Modules) {
        match! un_modules(rem) {
          (
            , .(m: Module, rest: Modules) {
                if! string_eq(module_name(m), name) {
                  widen_sum!(widen_sum!(m, . | Module), Modules | . | Module)
                } else {
                  widen_sum!(rest, Modules | . | Module)
                }
              }
            , .(_e: .) { widen_sum!(widen_sum!((), . | Module), Modules | . | Module) }
            )
        }
      }
    , ms
    )
}

// =====================================================================
// Hostfns — the host functions the loader seeds into the guest's env
// =====================================================================
//
// A host fn is a **value** the host provides, bound into the guest's
// environment; a guest applies one like any function (`value.kio`
// § `V_hostfn`). A body may refer to same-module host declarations or to
// declarations reached through selective or qualified imports. A `Hostfn`
// pairs the declaration's exact module-qualified descriptor with an
// independently derived inventory of ordered source value-group arities. The
// descriptor is host identity; the inventory describes public call packets.
// The private `Runtime_hostfn` below derives a separate evaluator schedule by
// interleaving erased-`forall` Unit stages with that unchanged inventory.
/// One exact host function the loader seeds, plus its public ordered
/// value-group arities. The group inventory is not part of descriptor identity.
pub labels { hostfn: Host_fn & Group_slots };

/// Builds a host-fn seed entry.
pub fn mk_hostfn(descriptor: Host_fn, groups: Group_slots) -> Hostfn {
  {hostfn = (descriptor, groups)}
}

/// The exact host-fn descriptor.
pub fn hostfn_descriptor(h: Hostfn) -> Host_fn {
  match! Hostfn.get(h) {
    .(descriptor: Host_fn, _groups: Group_slots) { descriptor }
  }
}

/// The ordered resolved FFI slot counts for the declaration's value groups.
pub fn hostfn_groups(h: Hostfn) -> Group_slots {
  match! Hostfn.get(h) {
    .(_descriptor: Host_fn, groups: Group_slots) { groups }
  }
}

/// A cons-list of host-fn seed entries.
pub labels { hostfns: List(Hostfn) };

/// The empty host-fn list.
pub fn hostfns_nil() -> Hostfns { {hostfns = nil(Hostfn, ())} }

/// Prepends one host-fn entry.
pub fn hostfns_cons(head: Hostfn, tail: Hostfns) -> Hostfns {
  {hostfns = cons(head, Hostfns.get(tail))}
}

/// One-step destructor on a host-fn list.
pub fn un_hostfns(hs: Hostfns) -> . | (Hostfn & Hostfns) {
  match! uncons(Hostfns.get(hs)) {
    (
      , .(h: Hostfn, t: List(Hostfn)) { widen_sum!((h, {hostfns = t}), . | (Hostfn & Hostfns)) }
      , .(_e: .) { widen_sum!((), . | (Hostfn & Hostfns)) }
      )
  }
}

// Loader-private staged host functions. Each entry bundles the unchanged
// public value-group inventory with the evaluator-only plan that adds one
// zero-slot Unit stage per erased unary `forall`. A declared Unit group also
// contributes a zero-slot stage. The bundle stays inside the
// opaque image state and cannot drift from a positional parallel list.
labels { runtime_hostfn: Hostfn & Group_slots };

labels { runtime_hostfns: List(Runtime_hostfn) };

fn mk_runtime_hostfn(hostfn: Hostfn, runtime_groups: Group_slots) -> Runtime_hostfn {
  {runtime_hostfn = (hostfn, runtime_groups)}
}

fn runtime_hostfns_nil() -> Runtime_hostfns { {runtime_hostfns = nil(Runtime_hostfn, ())} }

fn runtime_hostfns_cons(head: Runtime_hostfn, rest: Runtime_hostfns) -> Runtime_hostfns {
  {runtime_hostfns = cons(Runtime_hostfn, head, Runtime_hostfns.get(rest))}
}

fn un_runtime_hostfns(hs: Runtime_hostfns) -> . | (Runtime_hostfn & Runtime_hostfns) {
  match! uncons(Runtime_hostfn, Runtime_hostfns.get(hs)) {
    (
      , .(h: Runtime_hostfn, t: List(Runtime_hostfn)) {
          widen_sum!((h, {runtime_hostfns = t}), . | (Runtime_hostfn & Runtime_hostfns))
        }
      , .(_empty: .) { widen_sum!((), . | (Runtime_hostfn & Runtime_hostfns)) }
      )
  }
}

fn runtime_hostfn_public(h: Runtime_hostfn) -> Hostfn {
  match! Runtime_hostfn.get(h) {
    .(hostfn: Hostfn, _runtime: Group_slots) { hostfn }
  }
}

fn runtime_hostfn_groups(h: Runtime_hostfn) -> Group_slots {
  match! Runtime_hostfn.get(h) {
    .(_hostfn: Hostfn, runtime: Group_slots) { runtime }
  }
}

fn runtime_hostfns_has(hs: Runtime_hostfns, descriptor: Host_fn) -> Bool {
  loop(
    , .(remaining: Runtime_hostfns) {
        match! un_runtime_hostfns(remaining) {
          (
            , .(entry: Runtime_hostfn, rest: Runtime_hostfns) {
                if! host_fn_eq(hostfn_descriptor(runtime_hostfn_public(entry)), descriptor) {
                  widen_sum!(.t(Bool), Runtime_hostfns | Bool)
                } else {
                  widen_sum!(rest, Runtime_hostfns | Bool)
                }
              }
            , .(_empty: .) { widen_sum!(.f(Bool), Runtime_hostfns | Bool) }
            )
        }
      }
    , hs
    )
}

fn runtime_hostfns_public(hs: Runtime_hostfns) -> Hostfns {
  let reversed =
    loop(
      , .(state: Runtime_hostfns & Hostfns) {
          match! state {
            .(remaining: Runtime_hostfns, out: Hostfns) {
              match! un_runtime_hostfns(remaining) {
                (
                  , .(entry: Runtime_hostfn, rest: Runtime_hostfns) {
                      widen_sum!(
                        , (rest, hostfns_cons(runtime_hostfn_public(entry), out))
                        , (Runtime_hostfns & Hostfns) | Hostfns
                        )
                    }
                  , .(_empty: .) { widen_sum!(out, (Runtime_hostfns & Hostfns) | Hostfns) }
                  )
              }
            }
          }
        }
      , (hs, hostfns_nil())
      );
  {hostfns = reverse(Hostfn, Hostfns.get(reversed))}
}

// Whether `hs` already lists this exact host fn (dedup guard: the same host fn
// imported by several guest modules is seeded once).
fn hostfns_has(hs: Hostfns, descriptor: Host_fn) -> Bool {
  loop(
    , .(rem: Hostfns) {
        match! un_hostfns(rem) {
          (
            , .(h: Hostfn, rest: Hostfns) {
                if! host_fn_eq(hostfn_descriptor(h), descriptor) {
                  widen_sum!(.t(Bool), Hostfns | Bool)
                } else {
                  widen_sum!(rest, Hostfns | Bool)
                }
              }
            , .(_e: .) { widen_sum!(.f(Bool), Hostfns | Bool) }
            )
        }
      }
    , hs
    )
}

/// One exact host-function descriptor paired with its independently derived
/// public value-group shape. Image contracts and adapters share this entry
/// shape without sharing nominal authority.
pub labels { host_fn_binding: Host_fn & Group_slots };

/// Builds one exact host-function binding.
pub fn mk_host_fn_binding(descriptor: Host_fn, groups: Group_slots) -> Host_fn_binding {
  {host_fn_binding = (descriptor, groups)}
}

/// The binding's exact host-function descriptor.
pub fn host_fn_binding_descriptor(binding: Host_fn_binding) -> Host_fn {
  match! Host_fn_binding.get(binding) {
    .(descriptor: Host_fn, _groups: Group_slots) { descriptor }
  }
}

/// The binding's public value-group shape.
pub fn host_fn_binding_groups(binding: Host_fn_binding) -> Group_slots {
  match! Host_fn_binding.get(binding) {
    .(_descriptor: Host_fn, groups: Group_slots) { groups }
  }
}

/// The adapter's advertised host-function bindings.
pub labels { host_fn_bindings: List(Host_fn_binding) };

/// No advertised host functions.
pub fn host_fn_bindings_nil() -> Host_fn_bindings { {host_fn_bindings = nil(Host_fn_binding, ())} }

/// Prepends one advertised host-function binding.
pub fn host_fn_bindings_cons(head: Host_fn_binding, tail: Host_fn_bindings) -> Host_fn_bindings {
  {host_fn_bindings = cons(Host_fn_binding, head, Host_fn_bindings.get(tail))}
}

/// Splits the first advertised binding from the rest.
pub fn un_host_fn_bindings(bindings: Host_fn_bindings) -> . | (Host_fn_binding & Host_fn_bindings) {
  match! uncons(Host_fn_binding, Host_fn_bindings.get(bindings)) {
    (
      , .(head: Host_fn_binding, tail: List(Host_fn_binding)) {
          widen_sum!((head, {host_fn_bindings = tail}), . | (Host_fn_binding & Host_fn_bindings))
        }
      , .(_empty: .) { widen_sum!((), . | (Host_fn_binding & Host_fn_bindings)) }
      )
  }
}

/// A host adapter's single advertised inventory: exact host types and exact
/// host-function bindings. Function descriptors are derived from the bindings,
/// so descriptor and staging inventories cannot disagree.
pub labels { host_adapter: Host_types & Host_fn_bindings };

/// Builds an advertised host adapter inventory.
pub fn mk_host_adapter(types: Host_types, functions: Host_fn_bindings) -> Host_adapter {
  {host_adapter = (types, functions)}
}

/// The exact host types advertised by an adapter.
pub fn host_adapter_types(adapter: Host_adapter) -> Host_types {
  match! Host_adapter.get(adapter) {
    .(types: Host_types, _functions: Host_fn_bindings) { types }
  }
}

/// The exact host-function bindings advertised by an adapter.
pub fn host_adapter_functions(adapter: Host_adapter) -> Host_fn_bindings {
  match! Host_adapter.get(adapter) {
    .(_types: Host_types, functions: Host_fn_bindings) { functions }
  }
}

/// The complete exact host contract retained by an image. Unlike runtime
/// seeds, it includes bridge-admitted declarations even when no guest body
/// refers to them.
pub labels { host_contract: Host_types & Host_fn_bindings };

/// Builds an image host contract.
pub fn mk_host_contract(types: Host_types, functions: Host_fn_bindings) -> Host_contract {
  {host_contract = (types, functions)}
}

/// The exact required host types in an image contract.
pub fn host_contract_types(contract: Host_contract) -> Host_types {
  match! Host_contract.get(contract) {
    .(types: Host_types, _functions: Host_fn_bindings) { types }
  }
}

/// The exact required host functions and value-group shapes in an image contract.
pub fn host_contract_functions(contract: Host_contract) -> Host_fn_bindings {
  match! Host_contract.get(contract) {
    .(_types: Host_types, functions: Host_fn_bindings) { functions }
  }
}

fn group_slots_eq(left: Group_slots, right: Group_slots) -> Bool {
  loop(
    , .(state: Group_slots & Group_slots) {
        match! state {
          .(left0: Group_slots, right0: Group_slots) {
            match! un_group_slots(left0) {
              (
                , .(left_slots: I32, left_rest: Group_slots) {
                    match! un_group_slots(right0) {
                      (
                        , .(right_slots: I32, right_rest: Group_slots) {
                            if! eq_i32(left_slots, right_slots) {
                              widen_sum!(
                                , (left_rest, right_rest)
                                , (Group_slots & Group_slots) | Bool
                                )
                            } else {
                              widen_sum!(.f(Bool), (Group_slots & Group_slots) | Bool)
                            }
                          }
                        , .(_right_empty: .) {
                            widen_sum!(.f(Bool), (Group_slots & Group_slots) | Bool)
                          }
                        )
                    }
                  }
                , .(_left_empty: .) {
                    match! un_group_slots(right0) {
                      (
                        , .(_extra: I32, _rest: Group_slots) {
                            widen_sum!(.f(Bool), (Group_slots & Group_slots) | Bool)
                          }
                        , .(_right_empty: .) {
                            widen_sum!(.t(Bool), (Group_slots & Group_slots) | Bool)
                          }
                        )
                    }
                  }
                )
            }
          }
        }
      }
    , (left, right)
    )
}

// A usable staged host function has at least one value group, and every
// independently derived slot count is non-negative. Validation is deliberately
// localized at authority boundaries so unrelated adapter surplus remains
// inert under open-world extension.
fn group_slots_valid(groups: Group_slots) -> Bool {
  match! un_group_slots(groups) {
    (
      , .(first: I32, rest: Group_slots) {
          if! lt_i32(first, 0(I32)) {
            .f(Bool)
          } else {
            loop(
              , .(remaining: Group_slots) {
                  match! un_group_slots(remaining) {
                    (
                      , .(slots: I32, tail: Group_slots) {
                          if! lt_i32(slots, 0(I32)) {
                            widen_sum!(.f(Bool), Group_slots | Bool)
                          } else {
                            widen_sum!(tail, Group_slots | Bool)
                          }
                        }
                      , .(_empty: .) { widen_sum!(.t(Bool), Group_slots | Bool) }
                      )
                  }
                }
              , rest
              )
          }
        }
      , .(_empty: .) { .f(Bool) }
      )
  }
}

fn invalid_adapter_group_shape(id: Host_id) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: host adapter has invalid group shape for `"(String)
    , string_concat(host_id_render(id), "`"(String))
    ))
}

fn conflicting_host_function(id: Host_id) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: image has conflicting host-function descriptors for `"(String)
    , string_concat(host_id_render(id), "`"(String))
    ))
}

fn conflicting_image_host_type(id: Host_id) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: image has conflicting host-type descriptors for `"(String)
    , string_concat(host_id_render(id), "`"(String))
    ))
}

// Whether two validated exact type inventories denote the same descriptor
// set. Ordering and identical duplicates are immaterial.
fn host_type_sets_eq(left: Host_types, right: Host_types) -> Bool {
  let left_in_right =
    loop(
      , .(remaining: Host_types) {
          match! un_host_types(remaining) {
            (
              , .(descriptor: Host_type, rest: Host_types) {
                  match! find_host_type(right, host_type_id(descriptor)) {
                    (
                      , .(_missing: Missing_host_type) { widen_sum!(.f(Bool), Host_types | Bool) }
                      , .(found: Found_host_type) {
                          if! host_type_eq(Found_host_type.get(found), descriptor) {
                            widen_sum!(rest, Host_types | Bool)
                          } else {
                            widen_sum!(.f(Bool), Host_types | Bool)
                          }
                        }
                      , .(_conflict: Conflicting_host_type) {
                          widen_sum!(.f(Bool), Host_types | Bool)
                        }
                      )
                  }
                }
              , .(_empty: .) { widen_sum!(.t(Bool), Host_types | Bool) }
              )
          }
        }
      , left
      );
  if! left_in_right {
    loop(
      , .(remaining: Host_types) {
          match! un_host_types(remaining) {
            (
              , .(descriptor: Host_type, rest: Host_types) {
                  match! find_host_type(left, host_type_id(descriptor)) {
                    (
                      , .(_missing: Missing_host_type) { widen_sum!(.f(Bool), Host_types | Bool) }
                      , .(found: Found_host_type) {
                          if! host_type_eq(Found_host_type.get(found), descriptor) {
                            widen_sum!(rest, Host_types | Bool)
                          } else {
                            widen_sum!(.f(Bool), Host_types | Bool)
                          }
                        }
                      , .(_conflict: Conflicting_host_type) {
                          widen_sum!(.f(Bool), Host_types | Bool)
                        }
                      )
                  }
                }
              , .(_empty: .) { widen_sum!(.t(Bool), Host_types | Bool) }
              )
          }
        }
      , right
      )
  } else {
    .f(Bool)
  }
}

labels { adapter_binding_found: Host_fn_binding };

labels { adapter_binding_conflict: . };

type Adapter_binding_lookup = . | Adapter_binding_found | Adapter_binding_conflict;

labels { adapter_binding_search: Host_fn_bindings & Host_id & (. | Host_fn_binding) };

fn adapter_binding_lookup(bindings: Host_fn_bindings, id: Host_id) -> Adapter_binding_lookup {
  loop(
    , .(state: Adapter_binding_search) {
        match! Adapter_binding_search.get(state) {
          .(remaining: Host_fn_bindings, wanted: Host_id, found: . | Host_fn_binding) {
            match! un_host_fn_bindings(remaining) {
              (
                , .(candidate: Host_fn_binding, rest: Host_fn_bindings) {
                    if! host_id_eq(host_fn_id(host_fn_binding_descriptor(candidate)), wanted) {
                      match! found {
                        (
                          , .(prior: Host_fn_binding) {
                              if! host_fn_eq(
                                , host_fn_binding_descriptor(prior)
                                , host_fn_binding_descriptor(candidate)
                                ) {
                                if! group_slots_eq(
                                  , host_fn_binding_groups(prior)
                                  , host_fn_binding_groups(candidate)
                                  ) {
                                  widen_sum!(
                                    , {adapter_binding_search = (
                                        , rest
                                        , (wanted, widen_sum!(prior, . | Host_fn_binding))
                                        )}
                                    , Adapter_binding_search | Adapter_binding_lookup
                                    )
                                } else {
                                  widen_sum!(
                                    , widen_sum!(
                                        , {adapter_binding_conflict=}
                                        , Adapter_binding_lookup
                                        )
                                    , Adapter_binding_search | Adapter_binding_lookup
                                    )
                                }
                              } else {
                                widen_sum!(
                                  , widen_sum!({adapter_binding_conflict=}, Adapter_binding_lookup)
                                  , Adapter_binding_search | Adapter_binding_lookup
                                  )
                              }
                            }
                          , .(_none: .) {
                              widen_sum!(
                                , {adapter_binding_search = (
                                    , rest
                                    , (wanted, widen_sum!(candidate, . | Host_fn_binding))
                                    )}
                                , Adapter_binding_search | Adapter_binding_lookup
                                )
                            }
                          )
                      }
                    } else {
                      widen_sum!(
                        , {adapter_binding_search = (rest, (wanted, found))}
                        , Adapter_binding_search | Adapter_binding_lookup
                        )
                    }
                  }
                , .(_empty: .) {
                    match! found {
                      (
                        , .(binding: Host_fn_binding) {
                            widen_sum!(
                              , widen_sum!(
                                  , {adapter_binding_found = binding}
                                  , Adapter_binding_lookup
                                  )
                              , Adapter_binding_search | Adapter_binding_lookup
                              )
                          }
                        , .(_none: .) {
                            widen_sum!(
                              , widen_sum!((), Adapter_binding_lookup)
                              , Adapter_binding_search | Adapter_binding_lookup
                              )
                          }
                        )
                    }
                  }
                )
            }
          }
        }
      }
    , {adapter_binding_search = (bindings, (id, widen_sum!((), . | Host_fn_binding)))}
    )
}

fn missing_host_requirement(kind: String, id: Host_id) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: host adapter is missing required "(String)
    , string_concat(
        , kind
        , string_concat(" `"(String), string_concat(host_id_render(id), "`"(String)))
        )
    ))
}

fn conflicting_host_requirement(kind: String, id: Host_id) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: host adapter has conflicting "(String)
    , string_concat(
        , kind
        , string_concat(
            , " descriptors for `"(String)
            , string_concat(host_id_render(id), "`"(String))
            )
        )
    ))
}

fn mismatched_host_requirement(kind: String, id: Host_id) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: host adapter descriptor mismatch for required "(String)
    , string_concat(
        , kind
        , string_concat(" `"(String), string_concat(host_id_render(id), "`"(String)))
        )
    ))
}

fn preflight_host_types(required: Host_types, offered: Host_types) -> . | Diag {
  loop(
    , .(remaining: Host_types) {
        match! un_host_types(remaining) {
          (
            , .(descriptor: Host_type, rest: Host_types) {
                let id = host_type_id(descriptor);
                match! find_host_type(offered, id) {
                  (
                    , .(_missing: Missing_host_type) {
                        widen_sum!(
                          , widen_sum!(missing_host_requirement("host type"(String), id), . | Diag)
                          , Host_types | . | Diag
                          )
                      }
                    , .(found: Found_host_type) {
                        if! host_type_eq(Found_host_type.get(found), descriptor) {
                          widen_sum!(rest, Host_types | . | Diag)
                        } else {
                          widen_sum!(
                            , widen_sum!(
                                , mismatched_host_requirement("host type"(String), id)
                                , . | Diag
                                )
                            , Host_types | . | Diag
                            )
                        }
                      }
                    , .(_conflict: Conflicting_host_type) {
                        widen_sum!(
                          , widen_sum!(
                              , conflicting_host_requirement("host type"(String), id)
                              , . | Diag
                              )
                          , Host_types | . | Diag
                          )
                      }
                    )
                }
              }
            , .(_empty: .) { widen_sum!(widen_sum!((), . | Diag), Host_types | . | Diag) }
            )
        }
      }
    , required
    )
}

fn preflight_required_groups(required: Host_fn_bindings, offered: Host_fn_bindings) -> . | Diag {
  loop(
    , .(remaining: Host_fn_bindings) {
        match! un_host_fn_bindings(remaining) {
          (
            , .(required_binding: Host_fn_binding, rest: Host_fn_bindings) {
                let descriptor = host_fn_binding_descriptor(required_binding);
                let id = host_fn_id(descriptor);
                match! adapter_binding_lookup(offered, id) {
                  (
                    , .(found: Adapter_binding_found) {
                        let binding = Adapter_binding_found.get(found);
                        if! host_fn_eq(host_fn_binding_descriptor(binding), descriptor) {
                          if! group_slots_valid(host_fn_binding_groups(binding)) {
                            if! group_slots_eq(
                              , host_fn_binding_groups(binding)
                              , host_fn_binding_groups(required_binding)
                              ) {
                              widen_sum!(rest, Host_fn_bindings | . | Diag)
                            } else {
                              widen_sum!(
                                , widen_sum!(
                                    , mk_diag(string_concat(
                                        , "dyn_load_prime: host adapter group-shape mismatch for required host "
                                          "function `"(String)
                                        , string_concat(host_id_render(id), "`"(String))
                                        ))
                                    , . | Diag
                                    )
                                , Host_fn_bindings | . | Diag
                                )
                            }
                          } else {
                            widen_sum!(
                              , widen_sum!(invalid_adapter_group_shape(id), . | Diag)
                              , Host_fn_bindings | . | Diag
                              )
                          }
                        } else {
                          widen_sum!(
                            , widen_sum!(
                                , mismatched_host_requirement("host function"(String), id)
                                , . | Diag
                                )
                            , Host_fn_bindings | . | Diag
                            )
                        }
                      }
                    , .(_conflict: Adapter_binding_conflict) {
                        widen_sum!(
                          , widen_sum!(
                              , conflicting_host_requirement("host function"(String), id)
                              , . | Diag
                              )
                          , Host_fn_bindings | . | Diag
                          )
                      }
                    , .(_missing: .) {
                        widen_sum!(
                          , widen_sum!(
                              , missing_host_requirement("host function"(String), id)
                              , . | Diag
                              )
                          , Host_fn_bindings | . | Diag
                          )
                      }
                    )
                }
              }
            , .(_empty: .) { widen_sum!(widen_sum!((), . | Diag), Host_fn_bindings | . | Diag) }
            )
        }
      }
    , required
    )
}

fn adapter_preflight(
  , adapter: Host_adapter
  , required_types: Host_types
  , required_functions: Host_fn_bindings
  ) -> . | Diag {
  match! preflight_host_types(required_types, host_adapter_types(adapter)) {
    (
      , .(type_diag: Diag) { widen_sum!(type_diag, . | Diag) }
      , .(_types_ok: .) {
          preflight_required_groups(required_functions, host_adapter_functions(adapter))
        }
      )
  }
}

fn alias_spellings(
  , aliases: Aliases
  , owner: String
  , name: String
  , ordinary_allowed: Bool
  , initial: Pnl
  ) -> Pnl {
  loop(
    , .(state: Aliases & Pnl) {
        match! state {
          .(remaining: Aliases, spellings: Pnl) {
            match! un_aliases(remaining) {
              (
                , .(alias: Mod_alias, rest: Aliases) {
                    if! string_eq(alias_target(alias), owner) {
                      if! ordinary_allowed {
                        widen_sum!(
                          , (rest, pnl_cons(dot_join(alias_name(alias), name), spellings))
                          , (Aliases & Pnl) | Pnl
                          )
                      } else {
                        widen_sum!((rest, spellings), (Aliases & Pnl) | Pnl)
                      }
                    } else {
                      widen_sum!((rest, spellings), (Aliases & Pnl) | Pnl)
                    }
                  }
                , .(_empty: .) { widen_sum!(spellings, (Aliases & Pnl) | Pnl) }
                )
            }
          }
        }
      }
    , (aliases, initial)
    )
}

fn hostfn_imported_as(imports: Imports, name: String, owner: String) -> Bool {
  loop(
    , .(remaining: Imports) {
        match! un_imports(remaining) {
          (
            , .(import: Import, rest: Imports) {
                match! un_import(import) {
                  .(candidate: String, provider: String) {
                    if! string_eq(candidate, name) {
                      if! string_eq(provider, owner) {
                        widen_sum!(.t(Bool), Imports | Bool)
                      } else {
                        widen_sum!(rest, Imports | Bool)
                      }
                    } else {
                      widen_sum!(rest, Imports | Bool)
                    }
                  }
                }
              }
            , .(_empty: .) { widen_sum!(.f(Bool), Imports | Bool) }
            )
        }
      }
    , imports
    )
}

fn local_hostfn_precedes(modules: Modules, consumer: String, name: String, cutoff: I32) -> Bool {
  match! find_module(modules, consumer) {
    (
      , .(module: Module) {
          loop(
            , .(remaining: Host_headers) {
                match! un_host_headers(remaining) {
                  (
                    , .(header: Host_header, rest: Host_headers) {
                        if! host_header_is_fn(header) {
                          if! string_eq(host_header_name(header), name) {
                            widen_sum!(
                              , lt_i32(host_header_decl_pos(header), cutoff)
                              , Host_headers | Bool
                              )
                          } else {
                            widen_sum!(rest, Host_headers | Bool)
                          }
                        } else {
                          widen_sum!(rest, Host_headers | Bool)
                        }
                      }
                    , .(_empty: .) { widen_sum!(.f(Bool), Host_headers | Bool) }
                    )
                }
              }
            , module_host_headers(module)
            )
        }
      , .(_missing: .) { .f(Bool) }
      )
  }
}

fn hostfn_spellings(
  , hostfn: Hostfn
  , consumer: String
  , imports: Imports
  , aliases: Aliases
  , modules: Modules
  , cutoff: I32
  ) -> Pnl {
  let id = host_fn_id(hostfn_descriptor(hostfn));
  let owner = host_id_module(id);
  let name = host_id_local(id);
  let bare =
    if! string_eq(owner, consumer) {
      if! local_hostfn_precedes(modules, consumer, name, cutoff) {
        pnl_one(name)
      } else {
        pnl_nil()
      }
    } else if! hostfn_imported_as(imports, name, owner) {
      pnl_one(name)
    } else {
      pnl_nil()
    };
  alias_spellings(aliases, owner, name, .t(Bool), bare)
}

fn push_hostfns_scope_for(
  , hostfns: Hostfns
  , consumer: String
  , imports: Imports
  , aliases: Aliases
  , modules: Modules
  , cutoff: I32
  , base: Scope
  ) -> Scope {
  loop(
    , .(state: Hostfns & Scope) {
        match! state {
          .(remaining: Hostfns, scope: Scope) {
            match! un_hostfns(remaining) {
              (
                , .(hostfn: Hostfn, rest: Hostfns) {
                    widen_sum!(
                      , (
                          , rest
                          , scope_push_names(
                              , hostfn_spellings(
                                  , hostfn
                                  , consumer
                                  , imports
                                  , aliases
                                  , modules
                                  , cutoff
                                  )
                              , scope
                              )
                          )
                      , (Hostfns & Scope) | Scope
                      )
                  }
                , .(_empty: .) { widen_sum!(scope, (Hostfns & Scope) | Scope) }
                )
            }
          }
        }
      }
    , (hostfns, base)
    )
}

// =====================================================================
// Parsing one declaration to its erased fn term
// =====================================================================
//
// A top-level fn's value is a closure chain over its erased runtime stages.
// Each unary `forall` uses an empty Unit stage in the evaluator-internal
// type-application encoding. That encoding does not consume a residual
// `. -> ...` source layer. Each comma-separated value group is one unary
// function domain (`specs/prime.md` § Functions are unary over one domain
// type): `fn f(a, b, c) -> R { body }` has domain
// `A & (B & C)`, so that stage is `λp. body'`, not `λa. λb. λc.`. The body
// sees the params as separate binders, recovered from `p` by projection. A
// Kio' call packet supplies the same stages structurally: written leading
// type arguments become evaluator-internal Unit applications and its value
// arguments become one right-nested product (`product_of_args` in
// `parse.kio`).
//
// The body is parsed against a scope holding every stage's runtime binders on
// top of `fn_scope`: permitted host-function frames plus one positional frame
// per earlier guest function, containing only spellings visible from the
// current owner. The closure layout for each stage is then:
//
//   - **0 params** (domain `()`): `λ(). body`. The body never names the
//     unit param; the lambda still binds one slot, so cross-fn references
//     sit one deeper. Body scope: `[<domain>, fn_scope…]`.
//   - **1 param** (domain `A`): `λa. body`. The lambda binds the param
//     directly (there is no one-element product). Body scope:
//     `[a, fn_scope…]`.
//   - **N≥2 params** (domain `A & (B & …)`): `λp. let p0 = …; …; body`.
//     The lambda binds the product `p`; `N` lets bind each param to its
//     projection of `p`, last param innermost. Body scope:
//     `[p_{N-1}, …, p_0, <domain>, fn_scope…]` — the params nearest, then
//     the product binder, then the cross-fn names.
//
// Each layout's body scope matches the runtime environment after the
// closure is applied and the projection lets run (see `wrap_fn`), so de
// Bruijn resolution falls out without a post-hoc shift.

// The number of value parameters, as a host i32.
pub fn pnames_len(params: Pnames) -> I32 { length(Pnames.get(params)) }

// Push the value-param names onto `base` in **declaration order**, so the
// last parameter ends up nearest (de Bruijn index 0 of the body).
fn push_params(params: Pnames, base: Scope) -> Scope {
  loop(
    , .(st: Pnames & Scope) {
        match! st {
          .(rem: Pnames, acc: Scope) {
            match! un_pnames(rem) {
              (
                , .(name: String, rest: Pnames) {
                    widen_sum!((rest, scope_push(name, acc)), (Pnames & Scope) | Scope)
                  }
                , .(_e: .) { widen_sum!(acc, (Pnames & Scope) | Scope) }
                )
            }
          }
        }
      }
    , (params, base)
    )
}

// The frames one value-parameter group adds over `base`. A 1-param group
// binds its param directly as the lambda parameter, so no extra frame sits
// between the param and what is below. Every other arity binds a single
// **domain** value as the lambda parameter (unit for 0, the product for
// N≥2) and recovers the named params above it, so a `<domain>` frame sits
// between the params and what is below — matching the runtime environment
// `wrap_group` produces.
fn group_scope(params: Pnames, base: Scope) -> Scope {
  if! eq_i32(pnames_len(params), 1(I32)) {
    push_params(params, base)
  } else {
    push_params(params, scope_push("<domain>"(String), base))
  }
}

// The body scope for a fn with parameter groups `groups` over `fn_scope`:
// each group's frames stack over the previous group's, first group
// deepest — matching the curried closure chain `wrap_fn` builds (the
// first group's lambda is applied first, so its bindings sit outermost).
fn body_scope(groups: Pgroups, fn_scope: Scope) -> Scope {
  loop(
    , .(st: Pgroups & Scope) {
        match! st {
          .(rem: Pgroups, acc: Scope) {
            match! un_pgroups(rem) {
              (
                , .(g: Pnames, rest: Pgroups) {
                    widen_sum!((rest, group_scope(g, acc)), (Pgroups & Scope) | Scope)
                  }
                , .(_e: .) { widen_sum!(acc, (Pgroups & Scope) | Scope) }
                )
            }
          }
        }
      }
    , (groups, fn_scope)
    )
}

// A de Bruijn `Nat` from a host i32 (count of successors). A negative count
// yields zero — a well-formed export index is always in range.
fn nat_of_i32(n: I32) -> Nat {
  loop(
    , .(st: I32 & Nat) {
        match! st {
          .(k: I32, acc: Nat) {
            if! leq_i32(k, 0(I32)) {
              widen_sum!(acc, (I32 & Nat) | Nat)
            } else {
              widen_sum!((sub_i32(k, 1(I32)), ns(acc)), (I32 & Nat) | Nat)
            }
          }
        }
      }
    , (n, nz())
    )
}

// Apply `snd` to `t` exactly `k` times, descending `k` tails into a
// right-nested product. The i-th value parameter of an N-product lives at
// the i-th tail (`snd` applied i times); the first parameter is the
// outermost `fst`, the last parameter the deepest `snd` (no `fst`).
fn snd_n(k: I32, t: Term) -> Term {
  loop(
    , .(st: I32 & Term) {
        match! st {
          .(rem: I32, acc: Term) {
            if! leq_i32(rem, 0(I32)) {
              widen_sum!(acc, (I32 & Term) | Term)
            } else {
              widen_sum!((sub_i32(rem, 1(I32)), snd(acc)), (I32 & Term) | Term)
            }
          }
        }
      }
    , (k, t)
    )
}

// The projection that recovers value parameter `i` (0-based, declaration
// order) of an `n`-component product bound at de Bruijn index `i`. After
// the closure binds the product and `i` projection-lets run, the product
// sits at index `i`, so `var(i)` names it. Parameter `i < n-1` is
// `fst(snd^i(product))`; the last parameter (`i == n-1`) is `snd^(n-1)`,
// the product's deepest tail with no leading `fst`.
fn param_projection(i: I32, n: I32) -> Term {
  let at_product = snd_n(i, var(nat_of_i32(i)));
  if! eq_i32(i, sub_i32(n, 1(I32))) {
    at_product
  } else {
    fst(at_product)
  }
}

// Wrap `inner` in one group's closure. A 0- or 1-param group is
// `lam(inner)` (the lambda binds the unit / sole-param domain directly).
// An N≥2-param group binds the product and prefixes one projection-let per
// parameter, first parameter outermost so the last parameter ends
// innermost (de Bruijn index 0), matching the frames `group_scope` built.
fn wrap_group(params: Pnames, inner: Term) -> Term {
  let n = pnames_len(params);
  if! leq_i32(n, 1(I32)) {
    lam(inner)
  } else {
    lam(loop(
      , .(st: I32 & Term) {
          match! st {
            .(i: I32, acc: Term) {
              if! leq_i32(i, 0(I32)) {
                widen_sum!(let_(param_projection(0(I32), n), acc), (I32 & Term) | Term)
              } else {
                widen_sum!(
                  , (sub_i32(i, 1(I32)), let_(param_projection(i, n), acc))
                  , (I32 & Term) | Term
                  )
              }
            }
          }
        }
      , (sub_i32(n, 1(I32)), inner)
      ))
  }
}

// Reverse a group sequence.
fn pgroups_reverse(gs: Pgroups) -> Pgroups { {pgroups = reverse(Pgroups.get(gs))} }

// Wrap a parsed `body` in its curried closure chain: the last group's
// lambda innermost, the first group's outermost — `fn f(a: A)(b: B)` is
// `λa. λb. body`, matching `body_scope`.
fn wrap_fn(groups: Pgroups, body: Term) -> Term {
  loop(
    , .(st: Pgroups & Term) {
        match! st {
          .(rem: Pgroups, acc: Term) {
            match! un_pgroups(rem) {
              (
                , .(g: Pnames, rest: Pgroups) {
                    widen_sum!((rest, wrap_group(g, acc)), (Pgroups & Term) | Term)
                  }
                , .(_e: .) { widen_sum!(acc, (Pgroups & Term) | Term) }
                )
            }
          }
        }
      }
    , (pgroups_reverse(groups), body)
    )
}

/// Defines the parsed-fn-term arm (a successfully resolved declaration body).
pub labels { dr_ok: Term };

/// Defines the parse-failure arm (a malformed declaration body, with the
/// parse error's message and position).
pub labels { dr_err: Perr };

/// The outcome of resolving one declaration: its fn term, or a parse error.
pub type Decl_result = Dr_ok | Dr_err;

fn dr_ok(t: Term) -> Decl_result { widen_sum!({dr_ok = t}, Dr_ok | Dr_err) }

fn dr_err(e: Perr) -> Decl_result { widen_sum!({dr_err = e}, Dr_ok | Dr_err) }

// Destructor on `Pres` (a bare sum; identity projects it for `match!`).
fn un_pres(r: Pres) -> P_ok | P_err { r }

// Parse one declaration's body against `fn_scope` (the cross-fn names) and
// the newtype table visible to its module `nt` (so a qualified
// constructor / projector call erases), and wrap it in its runtime closure
// chain, yielding the fn's term.
fn resolve_decl(
  , d: Decl
  , fn_scope: Scope
  , nt: Ntab
  , resolve_host_type: String -> Host_type | String
  , bool_type: Host_type | String
  ) -> Decl_result {
  let scope = body_scope(decl_params(d), fn_scope);
  match! un_pres(parse_toks_scope_ntab(decl_body(d), scope, nt, resolve_host_type, bool_type)) {
    (
      , .(t: P_ok) { dr_ok(wrap_fn(decl_params(d), P_ok.get(t))) }
      , .(e: P_err) { dr_err(P_err.get(e)) }
      )
  }
}

// =====================================================================
// Resolving every declaration to a term list
// =====================================================================
//
// Walk the declarations front-to-back (earliest first). Maintain a growing
// `fn_scope` of the names already seen — before resolving `di` the scope
// holds `[name(d_{i-1}), …, name(d_0)]`, matching the runtime `let`-chain
// where `v_{i-1}` is nearest. Each resolved
// fn term is collected (in reverse), and the next name is prepended to the
// scope. A single malformed body fails the whole resolve.
/// A cons-list of resolved fn terms.
pub labels { terms_acc: List(Term) };

fn terms_acc_nil() -> Terms_acc { {terms_acc = nil(Term, ())} }

fn terms_acc_cons(head: Term, tail: Terms_acc) -> Terms_acc {
  {terms_acc = cons(head, Terms_acc.get(tail))}
}

fn un_terms_acc(ts: Terms_acc) -> . | (Term & Terms_acc) {
  match! uncons(Terms_acc.get(ts)) {
    (
      , .(h: Term, t: List(Term)) { widen_sum!((h, {terms_acc = t}), . | (Term & Terms_acc)) }
      , .(_e: .) { widen_sum!((), . | (Term & Terms_acc)) }
      )
  }
}

/// Defines the resolve-success arm (the fn terms in declaration order).
pub labels { rd_ok: Terms_acc };

/// Defines the resolve-failure arm: the owning module, the declaration
/// name, and the body's parse error.
pub labels { rd_err: String & String & Perr };

/// The outcome of resolving every declaration.
pub type Resolve_result = Rd_ok | Rd_err;

fn rd_ok(ts: Terms_acc) -> Resolve_result { widen_sum!({rd_ok = ts}, Rd_ok | Rd_err) }

fn rd_err(owner: String, name: String, e: Perr) -> Resolve_result {
  widen_sum!({rd_err = (owner, (name, e))}, Rd_ok | Rd_err)
}

fn un_decl_result(r: Decl_result) -> Dr_ok | Dr_err { r }

// Reverse the most-recent-first resolved-term accumulator into declaration order.
fn reverse_terms_acc(ts: Terms_acc) -> Terms_acc { {terms_acc = reverse(Terms_acc.get(ts))} }

// The `T_hostfn` seed terms for the host fns, in host-fn list order. Each
// evaluates to a fresh `V_hostfn`, with no arguments accumulated, at its exact
// descriptor and private runtime-stage shape (`eval.kio`'s `T_hostfn` arm).
// Prepended to the guest term list before the
// let-chain is built (`export_term`), so the host fns are bound **outermost**
// (the deepest de Bruijn indices), matching `push_hostfns_scope_for`.
fn hostfn_seed_terms(hfs: Runtime_hostfns) -> Terms_acc {
  reverse_terms_acc(loop(
    , .(st: Runtime_hostfns & Terms_acc) {
        match! st {
          .(rem: Runtime_hostfns, acc: Terms_acc) {
            match! un_runtime_hostfns(rem) {
              (
                , .(entry: Runtime_hostfn, rest: Runtime_hostfns) {
                    let hostfn = runtime_hostfn_public(entry);
                    widen_sum!(
                      , (
                          , rest
                          , terms_acc_cons(
                              , hostfn_ref(hostfn_descriptor(hostfn), runtime_hostfn_groups(entry))
                              , acc
                              )
                          )
                      , (Runtime_hostfns & Terms_acc) | Terms_acc
                      )
                  }
                , .(_e: .) { widen_sum!(acc, (Runtime_hostfns & Terms_acc) | Terms_acc) }
                )
            }
          }
        }
      }
    , (hfs, terms_acc_nil())
    ))
}

// Prepend `left` (in order) onto `right`, so `left`'s head ends up the
// outermost binding when the combined list feeds the let-chain.
fn prepend_terms_acc(left: Terms_acc, right: Terms_acc) -> Terms_acc {
  loop(
    , .(st: Terms_acc & Terms_acc) {
        match! st {
          .(rem: Terms_acc, acc: Terms_acc) {
            match! un_terms_acc(rem) {
              (
                , .(head: Term, rest: Terms_acc) {
                    widen_sum!(
                      , (rest, terms_acc_cons(head, acc))
                      , (Terms_acc & Terms_acc) | Terms_acc
                      )
                  }
                , .(_e: .) { widen_sum!(acc, (Terms_acc & Terms_acc) | Terms_acc) }
                )
            }
          }
        }
      }
    , (reverse_terms_acc(left), right)
    )
}

// =====================================================================
// The let-chain — bind every fn term, innermost-last, under a root
// =====================================================================
//
// `chain_term(terms, root)` wraps `root` in the `let`-chain
// `let t0; let t1; … ; let tk; root`, so evaluating it binds every
// top-level fn (each `ti` a closure) and then runs `root`, which references
// the fns by de Bruijn index. The chain is right-nested, so it is built by
// folding the reversed term list, prepending `let_(ti, …)` outermost-first.
fn chain_term(terms: Terms_acc, root: Term) -> Term {
  loop(
    , .(st: Terms_acc & Term) {
        match! st {
          .(rem: Terms_acc, acc: Term) {
            match! un_terms_acc(rem) {
              (
                , .(head: Term, rest: Terms_acc) {
                    widen_sum!((rest, let_(head, acc)), (Terms_acc & Term) | Term)
                  }
                , .(_e: .) { widen_sum!(acc, (Terms_acc & Term) | Term) }
                )
            }
          }
        }
      }
    , (reverse_terms_acc(terms), root)
    )
}

// The length of a resolved-term list, as a host i32.
fn terms_acc_len(ts: Terms_acc) -> I32 { length(Terms_acc.get(ts)) }

/// The diagnostic's message, with any carried byte offset rendered.
pub fn diag_message(d: Diag) -> String {
  match! Diag.get(d) {
    .(m: String, p: . | I32) {
      match! p {
        (
          , .(off: I32) {
              string_concat(
                , m
                , string_concat(
                    , " (at byte offset "(String)
                    , string_concat(int_to_string(off), ")"(String))
                    )
                )
            }
          , .(_none: .) { m }
          )
      }
    }
  }
}

/// The diagnostic's bare message, offset unrendered.
pub fn diag_bare_message(d: Diag) -> String {
  match! Diag.get(d) {
    .(m: String, _p: . | I32) { m }
  }
}

/// The diagnostic's source byte offset, or `()`.
pub fn diag_pos(d: Diag) -> . | I32 {
  match! Diag.get(d) {
    .(_m: String, p: . | I32) { p }
  }
}

// =====================================================================
// Whole-package load — per-module, open-world cross-module resolution
// =====================================================================
//
// A whole-package image is several modules (`Modules`). Loading it builds
// a flat `Image` (a global `let`-chain of every fn term), with the
// properties that keep cross-module resolution **open-world-safe**:
//
//   1. **Topological module order.** The chain is a `let`-sequence and a de
//      Bruijn reference points *backward*, so a module must be bound after
//      every module it imports from (selectively or through an alias).
//      Modules form a DAG — an import cycle is a malformed image, reported
//      as a `Diag` naming the cycle; `topo_sort` (Kahn's algorithm, driven
//      by the host `loop`) computes the order.
//   2. **Per-module visibility.** A bare name in module X's body resolves
//      to one of X's *own* fns, or to a fn X imports by that exact name from
//      that exact module whose visibility admits X — plain `pub`, or a
//      matching `pub(path)`. An alias-qualified `a.name` applies the same
//      gate to the aliased module, never a same-named fn in an unrelated
//      module. The per-decl scope lists every earlier global decl, but gives
//      a decl only the reference spellings the resolving module may use
//      (possibly none), so de Bruijn resolution lands on the right chain
//      position and an invisible same-named decl is skipped.
//      This is the open-world guarantee: a `pub fn foo` added to module B
//      cannot change how module C's `foo` resolves when C imports its
//      `foo` from A.
//   3. **Per-module newtype visibility.** The newtype table handed to the
//      parser for a decl in module X holds exactly the spellings X may use:
//      X's own newtypes bare, plus selectively imported and alias-qualified
//      entries whose declaration visibility admits X. Constructor and
//      projector visibility are carried independently, so each member side
//      is gated separately while erasing against the newtype X actually
//      names.

// Whether both flags hold.
fn and_both(a: Bool, b: Bool) -> Bool {
  if! a {
    b
  } else {
    .f(Bool)
  }
}

// Whether `imports` maps `name` to source module `from_module`.
fn imports_has(imports: Imports, name: String, from_module: String) -> Bool {
  loop(
    , .(rem: Imports) {
        match! un_imports(rem) {
          (
            , .(i: Import, rest: Imports) {
                match! un_import(i) {
                  .(n: String, m: String) {
                    if! and_both(string_eq(n, name), string_eq(m, from_module)) {
                      widen_sum!(.t(Bool), Imports | Bool)
                    } else {
                      widen_sum!(rest, Imports | Bool)
                    }
                  }
                }
              }
            , .(_e: .) { widen_sum!(.f(Bool), Imports | Bool) }
            )
        }
      }
    , imports
    )
}

// =====================================================================
// Topological module order (Kahn's algorithm)
// =====================================================================
//
// A module name list — the set of names already placed in the topo order,
// and the package's full module-name set (to tell a package dependency from
// a host-module import).
/// A cons-list of module names.
pub labels { names: List(String) };

fn names_nil() -> Names { {names = nil(String, ())} }

fn names_cons(head: String, tail: Names) -> Names { {names = cons(head, Names.get(tail))} }

fn un_names(ns: Names) -> . | (String & Names) {
  match! uncons(Names.get(ns)) {
    (
      , .(h: String, t: List(String)) { widen_sum!((h, {names = t}), . | (String & Names)) }
      , .(_e: .) { widen_sum!((), . | (String & Names)) }
      )
  }
}

// Whether `name` is in the name list.
fn names_has(ns: Names, name: String) -> Bool {
  elem(.(a: String, b: String) { string_eq(a, b) }, name, Names.get(ns))
}

// The package's module-name set.
fn module_names(ms: Modules) -> Names {
  loop(
    , .(st: Modules & Names) {
        match! st {
          .(rem: Modules, acc: Names) {
            match! un_modules(rem) {
              (
                , .(m: Module, rest: Modules) {
                    widen_sum!((rest, names_cons(module_name(m), acc)), (Modules & Names) | Names)
                  }
                , .(_e: .) { widen_sum!(acc, (Modules & Names) | Names) }
                )
            }
          }
        }
      }
    , (ms, names_nil())
    )
}

fn imports_deps_satisfied(imports: Imports, pkg_modules: Names, placed: Names) -> Bool {
  loop(
    , .(rem: Imports) {
        match! un_imports(rem) {
          (
            , .(i: Import, rest: Imports) {
                match! un_import(i) {
                  .(_n: String, from_module: String) {
                    if! names_has(pkg_modules, from_module) {
                      if! names_has(placed, from_module) {
                        widen_sum!(rest, Imports | Bool)
                      } else {
                        widen_sum!(.f(Bool), Imports | Bool)
                      }
                    } else {
                      widen_sum!(rest, Imports | Bool)
                    }
                  }
                }
              }
            , .(_e: .) { widen_sum!(.t(Bool), Imports | Bool) }
            )
        }
      }
    , imports
    )
}

fn aliases_deps_satisfied(als: Aliases, pkg_modules: Names, placed: Names) -> Bool {
  loop(
    , .(rem: Aliases) {
        match! un_aliases(rem) {
          (
            , .(a: Mod_alias, rest: Aliases) {
                let target = alias_target(a);
                if! names_has(pkg_modules, target) {
                  if! names_has(placed, target) {
                    widen_sum!(rest, Aliases | Bool)
                  } else {
                    widen_sum!(.f(Bool), Aliases | Bool)
                  }
                } else {
                  widen_sum!(rest, Aliases | Bool)
                }
              }
            , .(_e: .) { widen_sum!(.t(Bool), Aliases | Bool) }
            )
        }
      }
    , als
    )
}

// Whether every package-module `m` depends on — through a selective import
// or a module alias — is already in `placed`. A host-module import (a
// source module not in the package's module set) is not a chain
// dependency, so it is ignored.
fn deps_satisfied(m: Module, pkg_modules: Names, placed: Names) -> Bool {
  if! imports_deps_satisfied(module_imports(m), pkg_modules, placed) {
    aliases_deps_satisfied(module_aliases(m), pkg_modules, placed)
  } else {
    .f(Bool)
  }
}

// Pick the first not-yet-placed module whose package-deps are all placed,
// returning it and the remaining (unplaced, order-preserved) modules, or
// `()` when none is ready (a cycle, or all placed).
/// Wraps a Kahn pick's `(ready-module, remaining-modules)`.
labels { kahn_pick: Module & Modules };

fn reverse_modules(ms: Modules) -> Modules {
  loop(
    , .(st: Modules & Modules) {
        match! st {
          .(rem: Modules, acc: Modules) {
            match! un_modules(rem) {
              (
                , .(m: Module, rest: Modules) {
                    widen_sum!((rest, modules_cons(m, acc)), (Modules & Modules) | Modules)
                  }
                , .(_e: .) { widen_sum!(acc, (Modules & Modules) | Modules) }
                )
            }
          }
        }
      }
    , (ms, modules_nil())
    )
}

// Append two module lists (left ++ right).
fn append_modules(left: Modules, right: Modules) -> Modules {
  loop(
    , .(st: Modules & Modules) {
        match! st {
          .(rem: Modules, acc: Modules) {
            match! un_modules(rem) {
              (
                , .(m: Module, rest: Modules) {
                    widen_sum!((rest, modules_cons(m, acc)), (Modules & Modules) | Modules)
                  }
                , .(_e: .) { widen_sum!(acc, (Modules & Modules) | Modules) }
                )
            }
          }
        }
      }
    , (reverse_modules(left), right)
    )
}

// Walk `remaining`, accumulating skipped (not-ready) modules, until the
// first ready module; return it plus the other modules with order
// preserved (skipped-reversed-back ++ rest).
fn pick_ready(remaining: Modules, pkg_modules: Names, placed: Names) -> . | Kahn_pick {
  loop(
    , .(st: Modules & Modules) {
        match! st {
          .(rem: Modules, skipped: Modules) {
            match! un_modules(rem) {
              (
                , .(m: Module, rest: Modules) {
                    if! deps_satisfied(m, pkg_modules, placed) {
                      widen_sum!(
                        , widen_sum!(
                            , {kahn_pick = (m, append_modules(reverse_modules(skipped), rest))}
                            , . | Kahn_pick
                            )
                        , (Modules & Modules) | . | Kahn_pick
                        )
                    } else {
                      widen_sum!(
                        , (rest, modules_cons(m, skipped))
                        , (Modules & Modules) | . | Kahn_pick
                        )
                    }
                  }
                , .(_e: .) {
                    widen_sum!(widen_sum!((), . | Kahn_pick), (Modules & Modules) | . | Kahn_pick)
                  }
                )
            }
          }
        }
      }
    , (remaining, modules_nil())
    )
}

fn un_kahn_pick(p: . | Kahn_pick) -> . | Kahn_pick { p }

// Render the module names of `ms` as a comma-separated run (diagnostic
// text for the cycle report).
fn module_names_render(ms: Modules) -> String {
  match! un_modules(ms) {
    (
      , .(first: Module, rest0: Modules) {
          loop(
            , .(st: String & Modules) {
                match! st {
                  .(acc: String, rem: Modules) {
                    match! un_modules(rem) {
                      (
                        , .(m: Module, rest: Modules) {
                            widen_sum!(
                              , (
                                  , string_concat(acc, string_concat(", "(String), module_name(m)))
                                  , rest
                                  )
                              , (String & Modules) | String
                              )
                          }
                        , .(_e: .) { widen_sum!(acc, (String & Modules) | String) }
                        )
                    }
                  }
                }
              }
            , (module_name(first), rest0)
            )
        }
      , .(_e: .) { ""(String) }
      )
  }
}

/// Wraps the topo sort's success arm (the ordered modules).
labels { topo_ok: Modules };

// Topologically order the modules: repeatedly place a module whose
// package-deps are all already placed (Kahn's algorithm). When no module
// is ready and unplaced modules remain, the imports among them form a
// cycle — a malformed image, reported as a `Diag` naming the modules.
fn topo_sort(ms: Modules) -> Modules | Diag {
  let pkg_modules = module_names(ms);
  let loop_result =
    loop(
      , .(st: Modules & Modules & Names) {
          match! st {
            .(remaining: Modules, ordered_rev: Modules, placed: Names) {
              match! un_kahn_pick(pick_ready(remaining, pkg_modules, placed)) {
                (
                  , .(p: Kahn_pick) {
                      match! Kahn_pick.get(p) {
                        .(m: Module, rest: Modules) {
                          widen_sum!(
                            , (
                                , rest
                                , (modules_cons(m, ordered_rev), names_cons(module_name(m), placed))
                                )
                            , (Modules & Modules & Names) | Topo_ok | Diag
                            )
                        }
                      }
                    }
                  , .(_none: .) {
                      match! un_modules(remaining) {
                        (
                          , .(_m: Module, _rest: Modules) {
                              widen_sum!(
                                , mk_diag(string_concat(
                                    , "dyn_load_prime: malformed image — the module imports form a cycle among: "(String)
                                    , module_names_render(remaining)
                                    ))
                                , (Modules & Modules & Names) | Topo_ok | Diag
                                )
                            }
                          , .(_done: .) {
                              widen_sum!(
                                , {topo_ok = reverse_modules(ordered_rev)}
                                , (Modules & Modules & Names) | Topo_ok | Diag
                                )
                            }
                          )
                      }
                    }
                  )
              }
            }
          }
        }
      , (ms, (modules_nil(), names_nil()))
      );
  match! loop_result {
    (
      , .(ok: Topo_ok) { widen_sum!(Topo_ok.get(ok), Modules | Diag) }
      , .(d: Diag) { widen_sum!(d, Modules | Diag) }
      )
  }
}

fn un_topo(r: Modules | Diag) -> Modules | Diag { r }

// =====================================================================
// Flatten — the global decl list, each tagged with its owning module
// =====================================================================
//
// A global decl carries the `Decl` plus its owning module's name, import
// map, alias map, and the newtype table visible to that module — everything
// the per-decl scope and erasure need.
/// One global declaration: the decl, its owning module's name, that
/// module's imports and aliases, and the newtype table visible to it.
pub labels { gdecl: Decl & String & Imports & Aliases & Ntab };

fn mk_gdecl(d: Decl, owner: String, imports: Imports, als: Aliases, nt: Ntab) -> Gdecl {
  {gdecl = (d, (owner, (imports, (als, nt))))}
}

fn gdecl_decl(g: Gdecl) -> Decl {
  match! Gdecl.get(g) {
    .(d: Decl, _o: String, _i: Imports, _a: Aliases, _nt: Ntab) { d }
  }
}

fn gdecl_owner(g: Gdecl) -> String {
  match! Gdecl.get(g) {
    .(_d: Decl, o: String, _i: Imports, _a: Aliases, _nt: Ntab) { o }
  }
}

fn gdecl_imports(g: Gdecl) -> Imports {
  match! Gdecl.get(g) {
    .(_d: Decl, _o: String, i: Imports, _a: Aliases, _nt: Ntab) { i }
  }
}

fn gdecl_aliases(g: Gdecl) -> Aliases {
  match! Gdecl.get(g) {
    .(_d: Decl, _o: String, _i: Imports, a: Aliases, _nt: Ntab) { a }
  }
}

fn gdecl_ntab(g: Gdecl) -> Ntab {
  match! Gdecl.get(g) {
    .(_d: Decl, _o: String, _i: Imports, _a: Aliases, nt: Ntab) { nt }
  }
}

/// A cons-list of global declarations.
pub labels { gdecls: List(Gdecl) };

fn gdecls_nil() -> Gdecls { {gdecls = nil(Gdecl, ())} }

fn gdecls_cons(head: Gdecl, tail: Gdecls) -> Gdecls { {gdecls = cons(head, Gdecls.get(tail))} }

fn un_gdecls(gs: Gdecls) -> . | (Gdecl & Gdecls) {
  match! uncons(Gdecls.get(gs)) {
    (
      , .(h: Gdecl, t: List(Gdecl)) { widen_sum!((h, {gdecls = t}), . | (Gdecl & Gdecls)) }
      , .(_e: .) { widen_sum!((), . | (Gdecl & Gdecls)) }
      )
  }
}

fn reverse_gdecls(gs: Gdecls) -> Gdecls { {gdecls = reverse(Gdecls.get(gs))} }

// =====================================================================
// The nominal-member namespace visible to one module
// =====================================================================
//
// The parser erases a qualified member call against the source-visible type
// head the resolving module actually names. Literal newtypes use their own,
// selective-import, or qualified-import spellings. A fully positional
// identity alias additionally retains the terminal newtype's existing member
// namespace; the alias catalog augments this base table below.

// Add one provider table entry under `spelling` when its declaration is
// visible to `consumer`. Newtype member sides remain independently gated.
fn ntab_add_visible(
  , src: Module
  , consumer: String
  , name: String
  , spelling: String
  , entry: Nt_entry
  , acc: Ntab
  ) -> Ntab {
  let owner = module_name(src);
  match! members_find(module_members(src), name) {
    (
      , .(member: Member_decl) {
          if! visibility_allows(member_nt_visibility(member), owner, consumer) {
            ntab_cons_visible(
              , spelling
              , nt_entry_info(entry)
              , visibility_allows(member_ctor_visibility(member), owner, consumer)
              , visibility_allows(member_proj_visibility(member), owner, consumer)
              , acc
              )
          } else {
            acc
          }
        }
      , .(_missing: .) { acc }
      )
  }
}

// Prepend every visible entry of `src` onto `acc` under the spelling
// `prefix.name` (alias-qualified visibility).
fn ntab_prefix_visible(prefix: String, src: Module, consumer: String, acc: Ntab) -> Ntab {
  loop(
    , .(st: Ntab & Ntab) {
        match! st {
          .(rem: Ntab, out: Ntab) {
            match! un_ntab(rem) {
              (
                , .(name: String, cell: Nt_entry & Ntab) {
                    match! cell {
                      .(entry: Nt_entry, rest: Ntab) {
                        widen_sum!(
                          , (
                              , rest
                              , ntab_add_visible(
                                  , src
                                  , consumer
                                  , name
                                  , dot_join(prefix, name)
                                  , entry
                                  , out
                                  )
                              )
                          , (Ntab & Ntab) | Ntab
                          )
                      }
                    }
                  }
                , .(_e: .) { widen_sum!(out, (Ntab & Ntab) | Ntab) }
                )
            }
          }
        }
      }
    , (module_newtypes(src), acc)
    )
}

// The base literal-newtype table visible to module `x`: own entries bare;
// selective and alias-qualified imports only when declaration visibility
// admits `x`, with constructor and projector visibility gated independently.
fn ntab_for_module(x: Module, ms: Modules) -> Ntab {
  let with_imports =
    loop(
      , .(st: Imports & Ntab) {
          match! st {
            .(rem: Imports, acc: Ntab) {
              match! un_imports(rem) {
                (
                  , .(i: Import, rest: Imports) {
                      match! un_import(i) {
                        .(n: String, from_module: String) {
                          match! find_module(ms, from_module) {
                            (
                              , .(src: Module) {
                                  match! ntab_lookup(n, module_newtypes(src)) {
                                    (
                                      , .(entry: Nt_entry) {
                                          widen_sum!(
                                            , (
                                                , rest
                                                , ntab_add_visible(
                                                    , src
                                                    , module_name(x)
                                                    , n
                                                    , n
                                                    , entry
                                                    , acc
                                                    )
                                                )
                                            , (Imports & Ntab) | Ntab
                                            )
                                        }
                                      , .(_none: .) {
                                          widen_sum!((rest, acc), (Imports & Ntab) | Ntab)
                                        }
                                      )
                                  }
                                }
                              , .(_absent: .) { widen_sum!((rest, acc), (Imports & Ntab) | Ntab) }
                              )
                          }
                        }
                      }
                    }
                  , .(_e: .) { widen_sum!(acc, (Imports & Ntab) | Ntab) }
                  )
              }
            }
          }
        }
      , (module_imports(x), module_newtypes(x))
      );
  loop(
    , .(st: Aliases & Ntab) {
        match! st {
          .(rem: Aliases, acc: Ntab) {
            match! un_aliases(rem) {
              (
                , .(a: Mod_alias, rest: Aliases) {
                    match! find_module(ms, alias_target(a)) {
                      (
                        , .(src: Module) {
                            widen_sum!(
                              , (rest, ntab_prefix_visible(alias_name(a), src, module_name(x), acc))
                              , (Aliases & Ntab) | Ntab
                              )
                          }
                        , .(_absent: .) { widen_sum!((rest, acc), (Aliases & Ntab) | Ntab) }
                        )
                    }
                  }
                , .(_e: .) { widen_sum!(acc, (Aliases & Ntab) | Ntab) }
                )
            }
          }
        }
      }
    , (module_aliases(x), with_imports)
    )
}

// Prepend one module's decls (in declaration order) onto the reversed
// global accumulator, each tagged with the module's name, imports,
// aliases, and visible newtype table.
fn prepend_module_decls(m: Module, nt: Ntab, acc: Gdecls) -> Gdecls {
  let owner = module_name(m);
  let imports = module_imports(m);
  let als = module_aliases(m);
  loop(
    , .(st: Decls & Gdecls) {
        match! st {
          .(rem: Decls, out: Gdecls) {
            match! un_decls(rem) {
              (
                , .(d: Decl, rest: Decls) {
                    widen_sum!(
                      , (rest, gdecls_cons(mk_gdecl(d, owner, imports, als, nt), out))
                      , (Decls & Gdecls) | Gdecls
                      )
                  }
                , .(_e: .) { widen_sum!(out, (Decls & Gdecls) | Gdecls) }
                )
            }
          }
        }
      }
    , (module_decls(m), acc)
    )
}

// Flatten the topo-sorted modules into the global decl list, in module
// order then declaration order within each module.
fn flatten_modules(ordered: Modules, visible_newtypes: Module -> Ntab | Diag) -> Gdecls | Diag {
  let .(flattened: Gdecls | Diag) =
    loop(
      , .(st: Modules & Gdecls) {
          match! st {
            .(rem: Modules, acc: Gdecls) {
              match! un_modules(rem) {
                (
                  , .(m: Module, rest: Modules) {
                      match! visible_newtypes(m) {
                        (
                          , .(nt: Ntab) {
                              widen_sum!(
                                , (rest, prepend_module_decls(m, nt, acc))
                                , (Modules & Gdecls) | Gdecls | Diag
                                )
                            }
                          , .(diag: Diag) { widen_sum!(diag, (Modules & Gdecls) | Gdecls | Diag) }
                          )
                      }
                    }
                  , .(_e: .) { widen_sum!(acc, (Modules & Gdecls) | Gdecls | Diag) }
                  )
              }
            }
          }
        }
      , (ordered, gdecls_nil())
      );
  match! flattened {
    (
      , .(gs: Gdecls) { widen_sum!(reverse_gdecls(gs), Gdecls | Diag) }
      , .(diag: Diag) { widen_sum!(diag, Gdecls | Diag) }
      )
  }
}

// =====================================================================
// Per-module-scoped resolution of the global decl list
// =====================================================================
//
// Resolve every global decl against a scope built with per-module
// visibility. For the decl at global position `i` (owned by module X), the
// scope lists the earlier decls `[g_{i-1}, …, g_0]` (nearest first), each
// contributing the reference spellings X may use for it — possibly none —
// so the chain position is preserved while an invisible same-named decl is
// skipped.

// The spellings under which global decl `g` is referable from a body in
// module `x` (imports `x_imports`, aliases `x_aliases`): its bare name
// when `x` is the owner or selectively imports it from the owner, plus
// `a.name` for every permitted alias `x` binds to the owner.
// Whether a declaration may satisfy a recorded import from `consumer`.
// Loaded text is untrusted, so scoped visibility is checked here rather than
// inherited from the compiler that produced the image.
fn decl_importable(d: Decl, owner: String, consumer: String) -> Bool {
  visibility_allows(decl_visibility(d), owner, consumer)
}

fn gdecl_spellings(g: Gdecl, x: String, x_imports: Imports, x_aliases: Aliases) -> Pnl {
  let owner_g = gdecl_owner(g);
  let name = decl_name(gdecl_decl(g));
  if! string_eq(owner_g, x) {
    pnl_one(name)
  } else {
    let importable = decl_importable(gdecl_decl(g), owner_g, x);
    let base = if! importable {
      if! imports_has(x_imports, name, owner_g) {
        pnl_one(name)
      } else {
        pnl_nil()
      }
    } else {
      pnl_nil()
    };
    alias_spellings(x_aliases, owner_g, name, importable, base)
  }
}

// Build the body scope's cross-fn frames for a decl in module `x` (imports
// `x_imports`, aliases `x_aliases`): walk `earlier` (the earlier global
// decls in **natural order** `[g_0, …, g_{i-1}]`) pushing each frame's
// spellings over the host-fn base scope. Pushing reverses,
// so `g_{i-1}` (the immediately-preceding decl) ends nearest (index 0) —
// matching the chain's de Bruijn order.
fn fn_scope_for(
  , earlier: Gdecls
  , x: String
  , x_imports: Imports
  , x_aliases: Aliases
  , hostfns: Hostfns
  , modules: Modules
  , cutoff: I32
  ) -> Scope {
  loop(
    , .(st: Gdecls & Scope) {
        match! st {
          .(rem: Gdecls, acc: Scope) {
            match! un_gdecls(rem) {
              (
                , .(g: Gdecl, rest: Gdecls) {
                    widen_sum!(
                      , (rest, scope_push_names(gdecl_spellings(g, x, x_imports, x_aliases), acc))
                      , (Gdecls & Scope) | Scope
                      )
                  }
                , .(_e: .) { widen_sum!(acc, (Gdecls & Scope) | Scope) }
                )
            }
          }
        }
      }
    , (
        , earlier
        , push_hostfns_scope_for(hostfns, x, x_imports, x_aliases, modules, cutoff, scope_nil())
        )
    )
}

// Whether a source-local host function becomes newly visible between two
// ordinary declarations. A missing owner cannot arise for flattened
// declarations, but rebuilding is the fail-closed answer if the records ever
// disagree.
fn local_hostfn_between(modules: Modules, consumer: String, lower: I32, upper: I32) -> Bool {
  match! find_module(modules, consumer) {
    (
      , .(module: Module) {
          loop(
            , .(remaining: Host_headers) {
                match! un_host_headers(remaining) {
                  (
                    , .(header: Host_header, rest: Host_headers) {
                        if! host_header_is_fn(header) {
                          let position = host_header_decl_pos(header);
                          if! leq_i32(lower, position) {
                            if! lt_i32(position, upper) {
                              widen_sum!(.t(Bool), Host_headers | Bool)
                            } else {
                              widen_sum!(rest, Host_headers | Bool)
                            }
                          } else {
                            widen_sum!(rest, Host_headers | Bool)
                          }
                        } else {
                          widen_sum!(rest, Host_headers | Bool)
                        }
                      }
                    , .(_empty: .) { widen_sum!(.f(Bool), Host_headers | Bool) }
                    )
                }
              }
            , module_host_headers(module)
            )
        }
      , .(_missing: .) { .t(Bool) }
      )
  }
}

// The reusable scope is already advanced past the preceding declaration.
// It remains exact only for a later declaration in the same module when no
// intervening local host function changes the host-function base.
labels { fn_scope_cache: String & I32 & Scope };

type Maybe_fn_scope_cache = . | Fn_scope_cache;

fn rebuild_fn_scope(processed_rev: Gdecls, g: Gdecl, hostfns: Hostfns, modules: Modules) -> Scope {
  fn_scope_for(
    , reverse_gdecls(processed_rev)
    , gdecl_owner(g)
    , gdecl_imports(g)
    , gdecl_aliases(g)
    , hostfns
    , modules
    , decl_pos(gdecl_decl(g))
    )
}

fn scope_for_gdecl(
  , processed_rev: Gdecls
  , cache: Maybe_fn_scope_cache
  , g: Gdecl
  , hostfns: Hostfns
  , modules: Modules
  ) -> Scope {
  let owner = gdecl_owner(g);
  let cutoff = decl_pos(gdecl_decl(g));
  match! cache {
    (
      , .(saved: Fn_scope_cache) {
          match! Fn_scope_cache.get(saved) {
            .(saved_owner: String, saved_cutoff: I32, saved_scope: Scope) {
              if! string_eq(saved_owner, owner) {
                if! lt_i32(saved_cutoff, cutoff) {
                  if! local_hostfn_between(modules, owner, saved_cutoff, cutoff) {
                    rebuild_fn_scope(processed_rev, g, hostfns, modules)
                  } else {
                    saved_scope
                  }
                } else {
                  rebuild_fn_scope(processed_rev, g, hostfns, modules)
                }
              } else {
                rebuild_fn_scope(processed_rev, g, hostfns, modules)
              }
            }
          }
        }
      , .(_empty: .) { rebuild_fn_scope(processed_rev, g, hostfns, modules) }
      )
  }
}

fn advance_scope(g: Gdecl, scope: Scope) -> Scope {
  scope_push_names(gdecl_spellings(g, gdecl_owner(g), gdecl_imports(g), gdecl_aliases(g)), scope)
}

// The resolution loop streams the unprocessed suffix, processed declarations
// in reverse, resolved terms in reverse, and the exact reusable scope. The
// suffix and prefix advance together only after the current declaration
// resolves, so an error remains attached to exactly that declaration.
labels { resolve_walk: Gdecls & Gdecls & Terms_acc & Maybe_fn_scope_cache };

fn resolve_gdecls_step(
  , hostfns: Hostfns
  , ms: Modules
  , resolve_host_type: (String & I32 & String) -> Host_type | String
  , resolve_bool_type: (String & I32) -> Host_type | String
  , st: Resolve_walk
  ) -> Resolve_walk | Resolve_result {
  match! Resolve_walk.get(st) {
    .(remaining: Gdecls, processed_rev: Gdecls, acc: Terms_acc, cache: Maybe_fn_scope_cache) {
      match! un_gdecls(remaining) {
        (
          , .(g: Gdecl, rest: Gdecls) {
              let scope = scope_for_gdecl(processed_rev, cache, g, hostfns, ms);
              match! un_decl_result(resolve_decl(
                , gdecl_decl(g)
                , scope
                , gdecl_ntab(g)
                , .(spelling: String) {
                    resolve_host_type(gdecl_owner(g), decl_pos(gdecl_decl(g)), spelling)
                  }
                , resolve_bool_type(gdecl_owner(g), decl_pos(gdecl_decl(g)))
                )) {
                (
                  , .(t: Dr_ok) {
                      let next_cache =
                        widen_sum!(
                          , {fn_scope_cache = (
                              , gdecl_owner(g)
                              , (decl_pos(gdecl_decl(g)), advance_scope(g, scope))
                              )}
                          , Maybe_fn_scope_cache
                          );
                      widen_sum!(
                        , {resolve_walk = (
                            , rest
                            , (
                                , gdecls_cons(g, processed_rev)
                                , (terms_acc_cons(Dr_ok.get(t), acc), next_cache)
                                )
                            )}
                        , Resolve_walk | Resolve_result
                        )
                    }
                  , .(e: Dr_err) {
                      widen_sum!(
                        , rd_err(gdecl_owner(g), decl_name(gdecl_decl(g)), Dr_err.get(e))
                        , Resolve_walk | Resolve_result
                        )
                    }
                  )
              }
            }
          , .(_e: .) { widen_sum!(rd_ok(reverse_terms_acc(acc)), Resolve_walk | Resolve_result) }
          )
      }
    }
  }
}

fn import_visibility_diag(consumer: String, name: String, provider: String) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: malformed image — module `"(String)
    , string_concat(
        , consumer
        , string_concat(
            , "` imports `"(String)
            , string_concat(
                , name
                , string_concat(
                    , "` from `"(String)
                    , string_concat(provider, "`, but that item is not visible here"(String))
                    )
                )
            )
        )
    ))
}

// =====================================================================
// Bridge globs — the manifest's contract surface
// =====================================================================
//
// The emitted `.pkg.kio`'s `bridge { … }` block names the package's
// contract surface as module-path globs (`specs/package.md` § The bridge
// block): a literal segment matches itself, `*` matches one path segment,
// `**` matches a whole subtree (zero or more segments). The image exposes
// plain-`pub` functions and plain-`pub` member sides of plain-`pub` newtypes in
// bridge-matched modules; an image without its manifest admits the same
// surface from every module.
/// The optional bridge surface: `()` when the input carried no manifest;
/// otherwise its globs, empty when the manifest has no bridge block.
pub type Bridge = . | Pnames;

fn pnames_reverse_local(ps: Pnames) -> Pnames { {pnames = reverse(Pnames.get(ps))} }

// Split a `/`-separated path into its segments (in order).
fn path_segments(path: String) -> Pnames {
  let len = string_len(path);
  let loop_result =
    loop(
      , .(st: I32 & I32 & Pnames) {
          match! st {
            .(start: I32, pos: I32, acc: Pnames) {
              if! lt_i32(pos, len) {
                match! string_code_at(path, pos) {
                  (
                    , .(c: I32) {
                        if! eq_i32(c, 47(I32)) {
                          widen_sum!(
                            , (
                                , add_i32(pos, 1(I32))
                                , (
                                    , add_i32(pos, 1(I32))
                                    , pnames_cons(string_slice(path, start, pos), acc)
                                    )
                                )
                            , (I32 & I32 & Pnames) | Pnames
                            )
                        } else {
                          widen_sum!(
                            , (start, (add_i32(pos, 1(I32)), acc))
                            , (I32 & I32 & Pnames) | Pnames
                            )
                        }
                      }
                    , .(_e: .) {
                        widen_sum!(
                          , pnames_cons(string_slice(path, start, pos), acc)
                          , (I32 & I32 & Pnames) | Pnames
                          )
                      }
                    )
                }
              } else {
                widen_sum!(
                  , pnames_cons(string_slice(path, start, pos), acc)
                  , (I32 & I32 & Pnames) | Pnames
                  )
              }
            }
          }
        }
      , (0(I32), (0(I32), pnames_nil()))
      );
  match! loop_result {
    .(revd: Pnames) { pnames_reverse_local(revd) }
  }
}

// The nth tail of a segment list (0 = the list itself).
fn pnames_tail_at(ps: Pnames, n: I32) -> Pnames {
  loop(
    , .(st: Pnames & I32) {
        match! st {
          .(rem: Pnames, k: I32) {
            if! leq_i32(k, 0(I32)) {
              widen_sum!(rem, (Pnames & I32) | Pnames)
            } else match! un_pnames(rem) {
              (
                , .(_h: String, rest: Pnames) {
                    widen_sum!((rest, sub_i32(k, 1(I32))), (Pnames & I32) | Pnames)
                  }
                , .(_e: .) { widen_sum!(rem, (Pnames & I32) | Pnames) }
                )
            }
          }
        }
      }
    , (ps, n)
    )
}

// Whether a non-`**` glob segment matches a path segment.
fn or_seg_match(gseg: String, pseg: String) -> Bool {
  if! string_eq(gseg, "*"(String)) {
    .t(Bool)
  } else {
    string_eq(gseg, pseg)
  }
}

/// Wraps the glob matcher's verdict so the loop's exit arm is nominal.
labels { glob_verdict: Bool };

/// Wraps the matcher's `**` backtrack anchor (`()` until a `**` is seen,
/// then the glob tail after it and the path position it anchored at) —
/// nominal so the walk's product state keeps a closed shape.
labels { star_anchor: . | (Pnames & Pnames) };

fn no_anchor() -> Star_anchor { {star_anchor = widen_sum!((), . | (Pnames & Pnames))} }

fn anchor_at(g_after: Pnames, p_at: Pnames) -> Star_anchor {
  {star_anchor = widen_sum!((g_after, p_at), . | (Pnames & Pnames))}
}

// Resume the glob walk one path segment past the recorded `**` anchor, or
// fail when no `**` was seen.
fn glob_backtrack(star: Star_anchor) -> (Pnames & Pnames & Star_anchor) | Glob_verdict {
  match! Star_anchor.get(star) {
    (
      , .(g_after: Pnames, p_at: Pnames) {
          match! un_pnames(p_at) {
            (
              , .(_ph: String, pt: Pnames) {
                  widen_sum!(
                    , (g_after, (pt, anchor_at(g_after, pt)))
                    , (Pnames & Pnames & Star_anchor) | Glob_verdict
                    )
                }
              , .(_pend: .) {
                  widen_sum!(
                    , {glob_verdict = .f(Bool)}
                    , (Pnames & Pnames & Star_anchor) | Glob_verdict
                    )
                }
              )
          }
        }
      , .(_none: .) {
          widen_sum!({glob_verdict = .f(Bool)}, (Pnames & Pnames & Star_anchor) | Glob_verdict)
        }
      )
  }
}

// Whether the glob's segments match the path's segments, with `*` matching
// one segment and `**` matching zero or more. Iterative two-cursor walk
// with single-`**` backtracking (the classic wildcard-match shape): on a
// mismatch past a `**`, re-anchor the `**` one path segment further.
fn glob_segs_match(gsegs: Pnames, psegs: Pnames) -> Bool {
  Glob_verdict.get(loop(
    , .(st: Pnames & Pnames & Star_anchor) {
        match! st {
          .(g: Pnames, p: Pnames, star: Star_anchor) {
            match! un_pnames(g) {
              (
                , .(gh: String, gt: Pnames) {
                    if! string_eq(gh, "**"(String)) {
                      widen_sum!(
                        , (gt, (p, anchor_at(gt, p)))
                        , (Pnames & Pnames & Star_anchor) | Glob_verdict
                        )
                    } else match! un_pnames(p) {
                      (
                        , .(ph: String, pt: Pnames) {
                            if! or_seg_match(gh, ph) {
                              widen_sum!(
                                , (gt, (pt, star))
                                , (Pnames & Pnames & Star_anchor) | Glob_verdict
                                )
                            } else {
                              glob_backtrack(star)
                            }
                          }
                        , .(_pend: .) { glob_backtrack(star) }
                        )
                    }
                  }
                , .(_gend: .) {
                    match! un_pnames(p) {
                      (
                        , .(_ph: String, _pt: Pnames) { glob_backtrack(star) }
                        , .(_pend: .) {
                            widen_sum!(
                              , {glob_verdict = .t(Bool)}
                              , (Pnames & Pnames & Star_anchor) | Glob_verdict
                              )
                          }
                        )
                    }
                  }
                )
            }
          }
        }
      }
    , (gsegs, (psegs, no_anchor()))
    ))
}

// Whether the bridge admits a module: no manifest admits every module;
// otherwise some glob must match the module path.
fn bridge_admits(bridge: Bridge, module_path: String) -> Bool {
  match! bridge {
    (
      , .(globs: Pnames) {
          let psegs = path_segments(module_path);
          loop(
            , .(rem: Pnames) {
                match! un_pnames(rem) {
                  (
                    , .(g: String, rest: Pnames) {
                        if! glob_segs_match(path_segments(g), psegs) {
                          widen_sum!(.t(Bool), Pnames | Bool)
                        } else {
                          widen_sum!(rest, Pnames | Bool)
                        }
                      }
                    , .(_e: .) { widen_sum!(.f(Bool), Pnames | Bool) }
                    )
                }
              }
            , globs
            )
        }
      , .(_nomanifest: .) { .t(Bool) }
      )
  }
}

/// Successful revalidation of the manifest's bridge surface.
labels { bridge_valid: . };

type Bridge_validation = Bridge_valid | Diag;

fn bridge_glob_matches_module(glob: String, modules: Modules) -> Bool {
  let glob_segments = path_segments(glob);
  loop(
    , .(remaining: Modules) {
        match! un_modules(remaining) {
          (
            , .(module: Module, rest: Modules) {
                if! glob_segs_match(glob_segments, path_segments(module_name(module))) {
                  widen_sum!(.t(Bool), Modules | Bool)
                } else {
                  widen_sum!(rest, Modules | Bool)
                }
              }
            , .(_empty: .) { widen_sum!(.f(Bool), Modules | Bool) }
            )
        }
      }
    , modules
    )
}

fn dead_bridge_glob_diag(glob: String) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: bridge glob `"(String)
    , string_concat(glob, "` matches no module in this package"(String))
    ))
}

fn validate_bridge_globs(modules: Modules, bridge: Bridge) -> Bridge_validation {
  match! bridge {
    (
      , .(globs: Pnames) {
          loop(
            , .(remaining: Pnames) {
                match! un_pnames(remaining) {
                  (
                    , .(glob: String, rest: Pnames) {
                        if! bridge_glob_matches_module(glob, modules) {
                          widen_sum!(rest, Pnames | Bridge_validation)
                        } else {
                          widen_sum!(dead_bridge_glob_diag(glob), Pnames | Bridge_validation)
                        }
                      }
                    , .(_empty: .) { widen_sum!({bridge_valid=}, Pnames | Bridge_validation) }
                    )
                }
              }
            // The scanner cons-accumulates globs, so reverse them to report
            // the first manifest typo first.
            , pnames_reverse_local(globs)
            )
        }
      , .(_no_manifest: .) { widen_sum!({bridge_valid=}, Bridge_validation) }
      )
  }
}

fn bridge_root_names(modules: Modules, bridge: Bridge) -> Names {
  loop(
    , .(state: Modules & Names) {
        match! state {
          .(remaining: Modules, reversed: Names) {
            match! un_modules(remaining) {
              (
                , .(module: Module, rest: Modules) {
                    if! bridge_admits(bridge, module_name(module)) {
                      widen_sum!(
                        , (rest, names_cons(module_name(module), reversed))
                        , (Modules & Names) | Names
                        )
                    } else {
                      widen_sum!((rest, reversed), (Modules & Names) | Names)
                    }
                  }
                , .(_empty: .) { widen_sum!(reversed, (Modules & Names) | Names) }
                )
            }
          }
        }
      }
    , (modules, names_nil())
    )
}

fn enqueue_import_modules(imports: Imports, queue: Names) -> Names {
  loop(
    , .(state: Imports & Names) {
        match! state {
          .(remaining: Imports, acc: Names) {
            match! un_imports(remaining) {
              (
                , .(import: Import, rest: Imports) {
                    match! un_import(import) {
                      .(_name: String, provider: String) {
                        widen_sum!((rest, names_cons(provider, acc)), (Imports & Names) | Names)
                      }
                    }
                  }
                , .(_empty: .) { widen_sum!(acc, (Imports & Names) | Names) }
                )
            }
          }
        }
      }
    , (imports, queue)
    )
}

fn enqueue_alias_modules(aliases: Aliases, queue: Names) -> Names {
  loop(
    , .(state: Aliases & Names) {
        match! state {
          .(remaining: Aliases, acc: Names) {
            match! un_aliases(remaining) {
              (
                , .(alias: Mod_alias, rest: Aliases) {
                    widen_sum!(
                      , (rest, names_cons(alias_target(alias), acc))
                      , (Aliases & Names) | Names
                      )
                  }
                , .(_empty: .) { widen_sum!(acc, (Aliases & Names) | Names) }
                )
            }
          }
        }
      }
    , (aliases, queue)
    )
}

fn module_has_host_items(module: Module) -> Bool {
  match! un_host_headers(module_host_headers(module)) {
    (.(_header: Host_header, _rest: Host_headers) { .t(Bool) }, .(_empty: .) { .f(Bool) })
  }
}

fn bridge_walk_next(module: Module, remaining: Names, visited: Names) -> Names & Names {
  (
    , enqueue_import_modules(
        , module_imports(module)
        , enqueue_alias_modules(module_aliases(module), remaining)
        )
    , names_cons(module_name(module), visited)
    )
}

fn hidden_host_module_diag(module_name: String) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: module `"(String)
    , string_concat(
        , module_name
        , string_concat(
            , "` declares `host` items and is reachable from a bridged module, but is "
              "not itself selected by any bridge glob; add a glob matching `"(String)
            , string_concat(
                , module_name
                , "` to the package `bridge { … }` block so the host contract surface is "
                  "complete"(String)
                )
            )
        )
    ))
}

fn bridge_traversal_missing_module_diag(module_name: String) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: malformed image — bridge traversal reached absent module "
      "`"(String)
    , string_concat(module_name, "`"(String))
    ))
}

fn bridge_reachable_names(modules: Modules, bridge: Bridge) -> Names | Diag {
  loop(
    , .(state: Names & Names) {
        match! state {
          .(remaining: Names, visited: Names) {
            match! un_names(remaining) {
              (
                , .(name: String, rest: Names) {
                    if! names_has(visited, name) {
                      widen_sum!((rest, visited), (Names & Names) | Names | Diag)
                    } else match! find_module(modules, name) {
                      (
                        , .(module: Module) {
                            widen_sum!(
                              , bridge_walk_next(module, rest, visited)
                              , (Names & Names) | Names | Diag
                              )
                          }
                        , .(_missing: .) {
                            widen_sum!(
                              , bridge_traversal_missing_module_diag(name)
                              , (Names & Names) | Names | Diag
                              )
                          }
                        )
                    }
                  }
                , .(_empty: .) { widen_sum!(visited, (Names & Names) | Names | Diag) }
                )
            }
          }
        }
      }
    , (bridge_root_names(modules, bridge), names_nil())
    )
}

fn validate_reachable_host_modules(modules: Modules, bridge: Bridge, reachable: Names) -> Bridge_validation {
  loop(
    , .(remaining: Modules) {
        match! un_modules(remaining) {
          (
            , .(module: Module, rest: Modules) {
                if! names_has(reachable, module_name(module)) {
                  if! module_has_host_items(module) {
                    if! bridge_admits(bridge, module_name(module)) {
                      widen_sum!(rest, Modules | Bridge_validation)
                    } else {
                      widen_sum!(
                        , hidden_host_module_diag(module_name(module))
                        , Modules | Bridge_validation
                        )
                    }
                  } else {
                    widen_sum!(rest, Modules | Bridge_validation)
                  }
                } else {
                  widen_sum!(rest, Modules | Bridge_validation)
                }
              }
            , .(_empty: .) { widen_sum!({bridge_valid=}, Modules | Bridge_validation) }
            )
        }
      }
    , modules
    )
}

fn validate_bridge_module_completeness(modules: Modules, bridge: Bridge) -> Bridge_validation {
  match! bridge_reachable_names(modules, bridge) {
    (
      , .(reachable: Names) { validate_reachable_host_modules(modules, bridge, reachable) }
      , .(diag: Diag) { widen_sum!(diag, Bridge_validation) }
      )
  }
}

fn validate_package_bridge(modules: Modules, bridge: Bridge) -> Bridge_validation {
  match! validate_bridge_globs(modules, bridge) {
    (
      , .(_valid: Bridge_valid) { validate_bridge_module_completeness(modules, bridge) }
      , .(diag: Diag) { widen_sum!(diag, Bridge_validation) }
      )
  }
}

// =====================================================================
// Image — a loaded, resolved package
// =====================================================================
//
// An `Image` is the result of loading: the package's global declarations
// (each tagged with its owning module — the module-qualified contract
// surface), the resolved fn terms in the same order, the host fns the
// loader seeds into the guest's environment, the exact `Host_contract`
// preflight requirements, the owner-tagged newtype member surface, and the
// bridge surface (the manifest's contract narrowing, or `()` for the
// all-module plain-`pub` fallback). It is the runtime twin of a compiled
// artifact, ready for `instantiate` to evaluate and pack.
/// One image-surface member entry: the owning module's name and the
/// newtype's member-surface record.
pub labels { omember: String & Member_decl };

/// Builds an owner-tagged member entry.
pub fn mk_omember(owner: String, m: Member_decl) -> Omember { {omember = (owner, m)} }

/// The entry's owning module.
pub fn omember_owner(o: Omember) -> String {
  match! Omember.get(o) {
    .(owner: String, _m: Member_decl) { owner }
  }
}

/// The entry's member record.
pub fn omember_decl(o: Omember) -> Member_decl {
  match! Omember.get(o) {
    .(_owner: String, m: Member_decl) { m }
  }
}

/// The image's owner-tagged member entries, module then declaration order.
pub labels { omembers: List(Omember) };

/// The empty entry list.
pub fn omembers_nil() -> Omembers { {omembers = nil(Omember, ())} }

/// Prepends one entry.
pub fn omembers_cons(head: Omember, tail: Omembers) -> Omembers {
  {omembers = cons(Omember, head, Omembers.get(tail))}
}

/// One-step destructor on the entry list.
pub fn un_omembers(os: Omembers) -> . | (Omember & Omembers) {
  match! uncons(Omember, Omembers.get(os)) {
    (
      , .(h: Omember, t: List(Omember)) {
          widen_sum!((h, {omembers = t}), . | (Omember & Omembers))
        }
      , .(_e: .) { widen_sum!((), . | (Omember & Omembers)) }
      )
  }
}

/// Reverses the entry list.
pub fn omembers_reverse(os: Omembers) -> Omembers {
  {omembers = reverse(Omember, Omembers.get(os))}
}

/// One surface export: its module-qualified name and its canonical
/// signature rendering.
pub newtype Export_info : String & String {
  constructor seal_export_info;
  projector open_export_info
  }

/// A cons-list of export listing entries, declaration order.
pub newtype Export_infos : List(Export_info) {
  constructor seal_export_infos;
  projector open_export_infos
  }

/// Defines a loaded image: the module-tagged declarations, their resolved
/// fn terms, the seeded host fns, the exact host preflight contract, the
/// owner-tagged newtype member surface, the validated canonical export table,
/// and the bridge surface.
pub newtype Image :
  Gdecls & Terms_acc & Runtime_hostfns & Host_contract & Omembers & Export_infos & Bridge
  { constructor seal_image_state; projector open_image_state }

fn mk_image(
  , gs: Gdecls
  , terms: Terms_acc
  , hostfns: Runtime_hostfns
  , requirements: Host_contract
  , ms: Omembers
  , exports: Export_infos
  , bridge: Bridge
  ) -> Image {
  Image.seal_image_state((gs, (terms, (hostfns, (requirements, (ms, (exports, bridge)))))))
}

fn un_image(im: Image) ->
  Gdecls & Terms_acc & Runtime_hostfns & Host_contract & Omembers & Export_infos & Bridge
   { Image.open_image_state(im) }

/// The image's module-tagged declarations.
pub fn image_gdecls(im: Image) -> Gdecls {
  match! un_image(im) {
    .(
      , gs: Gdecls
      , _t: Terms_acc
      , _h: Runtime_hostfns
      , _r: Host_contract
      , _mm2: Omembers
      , _exports: Export_infos
      , _b: Bridge
      ) { gs }
  }
}

/// The image's resolved fn terms.
pub fn image_terms(im: Image) -> Terms_acc {
  match! un_image(im) {
    .(
      , _gs: Gdecls
      , t: Terms_acc
      , _h: Runtime_hostfns
      , _r: Host_contract
      , _mm2: Omembers
      , _exports: Export_infos
      , _b: Bridge
      ) { t }
  }
}

/// The host fns the loader seeds into the guest's environment.
pub fn image_hostfns(im: Image) -> Hostfns {
  match! un_image(im) {
    .(
      , _gs: Gdecls
      , _t: Terms_acc
      , h: Runtime_hostfns
      , _r: Host_contract
      , _mm2: Omembers
      , _exports: Export_infos
      , _b: Bridge
      ) { runtime_hostfns_public(h) }
  }
}

fn image_runtime_hostfns(im: Image) -> Runtime_hostfns {
  match! un_image(im) {
    .(
      , _gs: Gdecls
      , _t: Terms_acc
      , h: Runtime_hostfns
      , _r: Host_contract
      , _mm2: Omembers
      , _exports: Export_infos
      , _b: Bridge
      ) { h }
  }
}

/// The image's complete exact host requirements.
pub fn image_host_requirements(im: Image) -> Host_contract {
  match! un_image(im) {
    .(
      , _gs: Gdecls
      , _t: Terms_acc
      , _h: Runtime_hostfns
      , requirements: Host_contract
      , _mm2: Omembers
      , _exports: Export_infos
      , _b: Bridge
      ) { requirements }
  }
}

/// The image's bridge surface (`()` when the input carried no manifest).
pub fn image_bridge(im: Image) -> Bridge {
  match! un_image(im) {
    .(
      , _gs: Gdecls
      , _t: Terms_acc
      , _h: Runtime_hostfns
      , _r: Host_contract
      , _mm2: Omembers
      , _exports: Export_infos
      , b: Bridge
      ) { b }
  }
}

/// The image's owner-tagged newtype member surface.
pub fn image_members(im: Image) -> Omembers {
  match! un_image(im) {
    .(
      , _gs: Gdecls
      , _t: Terms_acc
      , _h: Runtime_hostfns
      , _r: Host_contract
      , mm: Omembers
      , _exports: Export_infos
      , _b: Bridge
      ) { mm }
  }
}

/// The image's validated canonical export table.
pub fn image_exports(im: Image) -> Export_infos {
  match! un_image(im) {
    .(
      , _gs: Gdecls
      , _t: Terms_acc
      , _h: Runtime_hostfns
      , _r: Host_contract
      , _mm: Omembers
      , exports: Export_infos
      , _b: Bridge
      ) { exports }
  }
}

/// Defines the load-success arm (a resolved image).
pub labels { lr_image: Image };

/// Defines the load-failure arm (a diagnostic).
pub labels { lr_diag: Diag };

/// The outcome of loading: a resolved image, or a diagnostic.
pub type Load_outcome = Lr_image | Lr_diag;

fn lr_image(im: Image) -> Load_outcome { widen_sum!({lr_image = im}, Lr_image | Lr_diag) }

/// Builds a load outcome from a diagnostic — the failure arm a source-text
/// entry point reports when an image cannot be scanned or resolved.
pub fn lr_diag(d: Diag) -> Load_outcome { widen_sum!({lr_diag = d}, Lr_image | Lr_diag) }

/// One-step destructor on a load outcome.
pub fn un_load_outcome(o: Load_outcome) -> Lr_image | Lr_diag { o }

fn un_resolve_result(r: Resolve_result) -> Rd_ok | Rd_err { r }

// The body-failure diagnostic: the owning module, the declaration, and the
// parse error's message, with the error's source offset carried for the
// text-level entry point to localize.
fn body_failure_diag(owner: String, name: String, e: Perr) -> Diag {
  mk_diag_at(
    , string_concat(
        , "dyn_load_prime: malformed image — module `"(String)
        , string_concat(
            , owner
            , string_concat(
                , "`, fn `"(String)
                , string_concat(name, string_concat("`: "(String), perr_message(e)))
                )
            )
        )
    , perr_pos(e)
    )
}

// The image's member surface: every module's own newtype member records,
// owner-tagged, module then declaration order. Bridge admittance and
// visibility gate at lookup time (like `gdecl_on_surface`), so the list
// carries every declaration.
fn collect_omembers(ordered: Modules) -> Omembers {
  omembers_reverse(loop(
    , .(st: Modules & Omembers) {
        match! st {
          .(rem: Modules, acc: Omembers) {
            match! un_modules(rem) {
              (
                , .(m: Module, rest: Modules) {
                    let owner = module_name(m);
                    widen_sum!(
                      , (
                          , rest
                          , loop(
                              , .(st2: Members & Omembers) {
                                  match! st2 {
                                    .(mm: Members, acc2: Omembers) {
                                      match! un_members(mm) {
                                        (
                                          , .(one: Member_decl, more: Members) {
                                              widen_sum!(
                                                , (
                                                    , more
                                                    , omembers_cons(mk_omember(owner, one), acc2)
                                                    )
                                                , (Members & Omembers) | Omembers
                                                )
                                            }
                                          , .(_e: .) {
                                              widen_sum!(acc2, (Members & Omembers) | Omembers)
                                            }
                                          )
                                      }
                                    }
                                  }
                                }
                              , (module_members(m), acc)
                              )
                          )
                      , (Modules & Omembers) | Omembers
                      )
                  }
                , .(_e: .) { widen_sum!(acc, (Modules & Omembers) | Omembers) }
                )
            }
          }
        }
      }
    , (ordered, omembers_nil())
    ))
}

// =====================================================================
// load_package_terms — whole-package records to a resolved image
// =====================================================================
/// Resolves a whole package (topo-sorted, per-module-scoped, host fns
/// derived from the modules' declarations) to a resolved image, or a
/// diagnostic naming what is malformed: an unresolvable import, an import
/// cycle, or a body that fails to parse. The bridge surface (the parsed
/// manifest's globs, or `()` when the input carried none) narrows the
/// image's export surface.
fn load_package_terms(
  , ms: Modules
  , bridge: Bridge
  , runtime_hostfns: Runtime_hostfns
  , requirements: Host_contract
  , visible_newtypes: Modules -> Module -> Ntab | Diag
  , derive_exports: (Gdecls & Omembers) -> Export_infos | Diag
  , resolve_host_type: (String & I32 & String) -> Host_type | String
  , resolve_bool_type: (String & I32) -> Host_type | String
  ) -> Load_outcome {
  match! un_topo(topo_sort(ms)) {
    (
      , .(ordered: Modules) {
          let hostfns = runtime_hostfns_public(runtime_hostfns);
          match! flatten_modules(ordered, visible_newtypes(ordered)) {
            (
              , .(gs: Gdecls) {
                  match! un_resolve_result(loop(
                    , .(st: Resolve_walk) {
                        resolve_gdecls_step(hostfns, ms, resolve_host_type, resolve_bool_type, st)
                      }
                    , {resolve_walk = (
                        , gs
                        , (gdecls_nil(), (terms_acc_nil(), widen_sum!((), Maybe_fn_scope_cache)))
                        )}
                    )) {
                    (
                      , .(ok: Rd_ok) {
                          let members = collect_omembers(ordered);
                          match! derive_exports((gs, members)) {
                            (
                              , .(exports: Export_infos) {
                                  lr_image(mk_image(
                                    , gs
                                    , Rd_ok.get(ok)
                                    , runtime_hostfns
                                    , requirements
                                    , members
                                    , exports
                                    , bridge
                                    ))
                                }
                              , .(diag: Diag) { lr_diag(diag) }
                              )
                          }
                        }
                      , .(e: Rd_err) {
                          match! Rd_err.get(e) {
                            .(owner: String, name: String, pe: Perr) {
                              lr_diag(body_failure_diag(owner, name, pe))
                            }
                          }
                        }
                      )
                  }
                }
              , .(diag: Diag) { lr_diag(diag) }
              )
          }
        }
      , .(d: Diag) { lr_diag(d) }
      )
  }
}

// =====================================================================
// Export resolution — the term that evaluates to one named export
// =====================================================================
//
// The export surface contains plain-`pub` functions and each plain-`pub`
// constructor or projector of a plain-`pub` newtype in a bridge-admitted
// module. Qualified spellings are `path/to/mod.item` for functions and
// `path/to/mod.Type.member` for members (`specs/versioning.md` § The
// compatibility relation). Lookup may instead use a unique bare function
// leaf or a unique bare `Type.member`; ambiguity is reported with the fully
// qualified candidates.
/// Defines a found export: its declaration-order position and its decl.
pub labels { ef_found: I32 & Gdecl };

/// Defines the absent-export arm.
pub labels { ef_absent: . };

/// Defines the ambiguous-bare-name arm (the qualified candidates).
pub labels { ef_ambiguous: Pnames };

/// Defines a found newtype-member export: the owner-tagged member record
/// and whether the projector (rather than the constructor) matched.
pub labels { ef_member: Omember & Bool };

/// The outcome of resolving an export name against the image's surface.
pub type Export_find = Ef_found | Ef_absent | Ef_ambiguous | Ef_member;

fn ef_found(pos: I32, g: Gdecl) -> Export_find {
  widen_sum!({ef_found = (pos, g)}, Ef_found | Ef_absent | Ef_ambiguous | Ef_member)
}

fn ef_absent() -> Export_find {
  widen_sum!({ef_absent=}, Ef_found | Ef_absent | Ef_ambiguous | Ef_member)
}

fn ef_ambiguous(candidates: Pnames) -> Export_find {
  widen_sum!({ef_ambiguous = candidates}, Ef_found | Ef_absent | Ef_ambiguous | Ef_member)
}

fn ef_member(o: Omember, is_proj: Bool) -> Export_find {
  widen_sum!({ef_member = (o, is_proj)}, Ef_found | Ef_absent | Ef_ambiguous | Ef_member)
}

/// One-step destructor on an export-resolution outcome.
pub fn un_export_find(r: Export_find) -> Ef_found | Ef_absent | Ef_ambiguous | Ef_member { r }

// Whether the name is a qualified spelling (contains a `.`).
fn name_is_qualified(name: String) -> Bool {
  loop(
    , .(pos: I32) {
        match! string_code_at(name, pos) {
          (
            , .(c: I32) {
                if! eq_i32(c, 46(I32)) {
                  widen_sum!(.t(Bool), I32 | Bool)
                } else {
                  widen_sum!(add_i32(pos, 1(I32)), I32 | Bool)
                }
              }
            , .(_e: .) { widen_sum!(.f(Bool), I32 | Bool) }
            )
        }
      }
    , 0(I32)
    )
}

// Whether global decl `g` is on the image's export surface: exported, and
// its owning module bridge-admitted.
fn gdecl_on_surface(g: Gdecl, bridge: Bridge) -> Bool {
  if! decl_exported(gdecl_decl(g)) {
    bridge_admits(bridge, gdecl_owner(g))
  } else {
    .f(Bool)
  }
}

// The qualified spelling of a global decl.
fn gdecl_qualified(g: Gdecl) -> String { dot_join(gdecl_owner(g), decl_name(gdecl_decl(g))) }

// The position just past the last `.` in `name`, or `()` when it has none.
fn last_dot_end(name: String) -> . | I32 {
  loop(
    , .(st: I32 & (. | I32)) {
        match! st {
          .(pos: I32, seen: . | I32) {
            match! string_code_at(name, pos) {
              (
                , .(c: I32) {
                    let seen1 =
                      if! eq_i32(c, 46(I32)) {
                        widen_sum!(add_i32(pos, 1(I32)), . | I32)
                      } else {
                        seen
                      };
                    widen_sum!((add_i32(pos, 1(I32)), seen1), (I32 & (. | I32)) | . | I32)
                  }
                , .(_e: .) { widen_sum!(seen, (I32 & (. | I32)) | . | I32) }
                )
            }
          }
        }
      }
    , (0(I32), widen_sum!((), . | I32))
    )
}

// Split `name` at its last `.` — `(prefix, leaf)` — or `()` when it has
// none.
fn split_last_dot(name: String) -> . | (String & String) {
  match! last_dot_end(name) {
    (
      , .(endpos: I32) {
          widen_sum!(
            , (
                , string_slice(name, 0(I32), sub_i32(endpos, 1(I32)))
                , string_slice(name, endpos, string_len(name))
                )
            , . | (String & String)
            )
        }
      , .(_none: .) { widen_sum!((), . | (String & String)) }
      )
  }
}

// A member lookup spelling decomposed: the owner filter (`()` for the
// bare `Type.member` form), the type name, and the member leaf.
labels { member_query: (. | String) & String & String };

// Decompose a lookup name into a member query: `Type.member` (one dot,
// no owner filter) or `path/to/mod.Type.member` (two dots, owner
// filtered). A dotless name never queries members.
fn member_query_of(name: String) -> . | Member_query {
  match! split_last_dot(name) {
    (
      , .(prefix: String, leaf: String) {
          match! split_last_dot(prefix) {
            (
              , .(owner: String, tyname: String) {
                  widen_sum!(
                    , {member_query = (widen_sum!(owner, . | String), (tyname, leaf))}
                    , . | Member_query
                    )
                }
              , .(_bare: .) {
                  widen_sum!(
                    , {member_query = (widen_sum!((), . | String), (prefix, leaf))}
                    , . | Member_query
                    )
                }
              )
          }
        }
      , .(_nodot: .) { widen_sum!((), . | Member_query) }
      )
  }
}

// Whether the query matches this surface entry, and on which member side:
// `()` for no match, else is-projector. The newtype and the matched member
// must be plain-`pub` and the owner bridge-admitted.
fn omember_match(o: Omember, q: Member_query, bridge: Bridge) -> . | Bool {
  match! Member_query.get(q) {
    .(owner_filter: . | String, tyname: String, leaf: String) {
      let md = omember_decl(o);
      let owner_ok =
        match! owner_filter {
          (.(want: String) { string_eq(omember_owner(o), want) }, .(_any: .) { .t(Bool) })
        };
      if! owner_ok {
        if! string_eq(member_name(md), tyname) {
          if! member_nt_pub(md) {
            if! bridge_admits(bridge, omember_owner(o)) {
              if! string_eq(leaf, nt_ctor(member_info(md))) {
                if! member_ctor_pub(md) {
                  widen_sum!(.f(Bool), . | Bool)
                } else {
                  widen_sum!((), . | Bool)
                }
              } else if! string_eq(leaf, nt_proj(member_info(md))) {
                if! member_proj_pub(md) {
                  widen_sum!(.t(Bool), . | Bool)
                } else {
                  widen_sum!((), . | Bool)
                }
              } else {
                widen_sum!((), . | Bool)
              }
            } else {
              widen_sum!((), . | Bool)
            }
          } else {
            widen_sum!((), . | Bool)
          }
        } else {
          widen_sum!((), . | Bool)
        }
      } else {
        widen_sum!((), . | Bool)
      }
    }
  }
}

// The member export's qualified spelling: `owner.Type.member`.
fn omember_qualified(o: Omember, is_proj: Bool) -> String {
  let md = omember_decl(o);
  let leaf =
    if! is_proj {
      nt_proj(member_info(md))
    } else {
      nt_ctor(member_info(md))
    };
  dot_join(dot_join(omember_owner(o), member_name(md)), leaf)
}

// Whether one side of the member is host-invocable: the newtype and that
// side plain-`pub`, the owner bridge-admitted.
fn omember_side_on_surface(o: Omember, is_proj: Bool, bridge: Bridge) -> Bool {
  let md = omember_decl(o);
  if! member_nt_pub(md) {
    if! bridge_admits(bridge, omember_owner(o)) {
      if! is_proj {
        member_proj_pub(md)
      } else {
        member_ctor_pub(md)
      }
    } else {
      .f(Bool)
    }
  } else {
    .f(Bool)
  }
}

/// Wraps the member walk's first-hit slot — nominal so the walk state
/// keeps a closed shape.
labels { mfirst_hit: . | (Omember & Bool) };

/// Wraps the member walk's exit `(first-hit, candidates)`.
labels { mscan_done: Mfirst_hit & Pnames };

// Scan the member surface for the query, extending the candidate list;
// yields the first hit and all matching qualified spellings.
fn member_scan(im: Image, name: String, cands0: Pnames) -> Mfirst_hit & Pnames {
  match! member_query_of(name) {
    (
      , .(q: Member_query) {
          match! Mscan_done.get(loop(
            , .(st: Omembers & Mfirst_hit & Pnames) {
                match! st {
                  .(rem: Omembers, first: Mfirst_hit, cands: Pnames) {
                    match! un_omembers(rem) {
                      (
                        , .(o: Omember, rest: Omembers) {
                            match! omember_match(o, q, image_bridge(im)) {
                              (
                                , .(is_proj: Bool) {
                                    let first1 =
                                      match! Mfirst_hit.get(first) {
                                        (
                                          , .(_seen: Omember & Bool) { first }
                                          , .(_none: .) {
                                              {mfirst_hit = widen_sum!(
                                                , (o, is_proj)
                                                , . | (Omember & Bool)
                                                )}
                                            }
                                          )
                                      };
                                    widen_sum!(
                                      , (
                                          , rest
                                          , (
                                              , first1
                                              , pnames_cons(omember_qualified(o, is_proj), cands)
                                              )
                                          )
                                      , (Omembers & Mfirst_hit & Pnames) | Mscan_done
                                      )
                                  }
                                , .(_no: .) {
                                    widen_sum!(
                                      , (rest, (first, cands))
                                      , (Omembers & Mfirst_hit & Pnames) | Mscan_done
                                      )
                                  }
                                )
                            }
                          }
                        , .(_e: .) {
                            widen_sum!(
                              , {mscan_done = (first, cands)}
                              , (Omembers & Mfirst_hit & Pnames) | Mscan_done
                              )
                          }
                        )
                    }
                  }
                }
              }
            , (image_members(im), ({mfirst_hit = widen_sum!((), . | (Omember & Bool))}, cands0))
            )) {
            .(first: Mfirst_hit, cands: Pnames) { (first, cands) }
          }
        }
      , .(_nodots: .) { ({mfirst_hit = widen_sum!((), . | (Omember & Bool))}, cands0) }
      )
  }
}

/// Wraps the first-hit slot of the surface walk (`()` until a matching
/// export is seen, then its position and decl) — nominal so the walk's
/// product state keeps a closed shape.
labels { first_hit: . | (I32 & Gdecl) };

fn no_hit() -> First_hit { {first_hit = widen_sum!((), . | (I32 & Gdecl))} }

fn hit_at(pos: I32, g: Gdecl) -> First_hit { {first_hit = widen_sum!((pos, g), . | (I32 & Gdecl))} }

// The single-candidate decision: the fn hit wins the position-carrying
// arm; otherwise the member hit carries its record.
fn decide_single(first: First_hit, mfirst: Mfirst_hit) -> Export_find {
  match! First_hit.get(first) {
    (
      , .(pos: I32, g: Gdecl) { ef_found(pos, g) }
      , .(_nofn: .) {
          match! Mfirst_hit.get(mfirst) {
            (.(o: Omember, is_proj: Bool) { ef_member(o, is_proj) }, .(_nom: .) { ef_absent() })
          }
        }
      )
  }
}

/// Resolves a qualified `path/to/mod.item` / `path/to/mod.Type.member`, a
/// unique bare function leaf, or a unique bare `Type.member` against the
/// image's surface.
// Whether the name has exactly one dot — the only shape where a
// module-qualified fn spelling and a bare `Type.member` spelling can
// collide (module paths use `/`, so a fn's qualified form always has one
// dot, and an owner-qualified member form has two or more).
fn name_has_one_dot(name: String) -> Bool {
  match! split_last_dot(name) {
    (
      , .(prefix: String, _leaf: String) {
          match! split_last_dot(prefix) {
            (.(_two: String & String) { .f(Bool) }, .(_bare: .) { .t(Bool) })
          }
        }
      , .(_nodot: .) { .f(Bool) }
      )
  }
}

fn mfirst_none() -> Mfirst_hit { {mfirst_hit = widen_sum!((), . | (Omember & Bool))} }

pub fn find_export(im: Image, name: String) -> Export_find {
  let qualified = name_is_qualified(name);
  let loop_result =
    loop(
      , .(st: Gdecls & I32 & First_hit & Pnames) {
          match! st {
            .(rem: Gdecls, idx: I32, first: First_hit, cands: Pnames) {
              match! un_gdecls(rem) {
                (
                  , .(g: Gdecl, rest: Gdecls) {
                      let hit =
                        if! gdecl_on_surface(g, image_bridge(im)) {
                          if! qualified {
                            string_eq(gdecl_qualified(g), name)
                          } else {
                            string_eq(decl_name(gdecl_decl(g)), name)
                          }
                        } else {
                          .f(Bool)
                        };
                      if! hit {
                        let first1 = match! First_hit.get(first) {
                          (.(_seen: I32 & Gdecl) { first }, .(_none: .) { hit_at(idx, g) })
                        };
                        widen_sum!(
                          , (
                              , rest
                              , (
                                  , add_i32(idx, 1(I32))
                                  , (first1, pnames_cons(gdecl_qualified(g), cands))
                                  )
                              )
                          , (Gdecls & I32 & First_hit & Pnames) | (First_hit & Pnames)
                          )
                      } else {
                        widen_sum!(
                          , (rest, (add_i32(idx, 1(I32)), (first, cands)))
                          , (Gdecls & I32 & First_hit & Pnames) | (First_hit & Pnames)
                          )
                      }
                    }
                  , .(_e: .) {
                      widen_sum!(
                        , (first, cands)
                        , (Gdecls & I32 & First_hit & Pnames) | (First_hit & Pnames)
                        )
                    }
                  )
              }
            }
          }
        }
      , (image_gdecls(im), (0(I32), (no_hit(), pnames_nil())))
      );
  match! loop_result {
    .(first: First_hit, fn_cands: Pnames) {
      let fn_hit =
        match! First_hit.get(first) {
          (.(_seen: I32 & Gdecl) { .t(Bool) }, .(_none: .) { .f(Bool) })
        };
      let fn_wins =
        if! name_has_one_dot(name) {
          fn_hit
        } else {
          .f(Bool)
        };
      let member_result =
        if! fn_wins {
          (mfirst_none(), fn_cands)
        } else {
          member_scan(im, name, fn_cands)
        };
      match! member_result {
        .(mfirst: Mfirst_hit, cands: Pnames) {
          match! un_pnames(cands) {
            (
              , .(_c: String, more: Pnames) {
                  match! un_pnames(more) {
                    (
                      , .(_c2: String, _rest: Pnames) { ef_ambiguous(pnames_reverse_local(cands)) }
                      , .(_one: .) { decide_single(first, mfirst) }
                      )
                  }
                }
              , .(_none: .) { ef_absent() }
              )
          }
        }
      }
    }
  }
}

// The erased member as a closed term: constructors and non-existential
// projectors are the identity; an existential projector is the CPS
// wrapper (`specs/prime.md` § The `newtype` primitive, § Existential
// introduction and elimination).
fn member_term(md: Member_decl, is_proj: Bool) -> Term {
  if! is_proj {
    if! nt_existential(member_info(md)) {
      lam(lam(app(var(nz()), var(ns(nz())))))
    } else {
      lam(var(nz()))
    }
  } else {
    lam(var(nz()))
  }
}

// The erased member as a runtime value: the identity closure, or the CPS
// wrapper's closure, over the empty environment (the closed forms
// `member_term` spells, entered one lambda in).
fn member_value(md: Member_decl, is_proj: Bool) -> Value {
  if! is_proj {
    if! nt_existential(member_info(md)) {
      vclosure(env_nil(), lam(app(var(nz()), var(ns(nz())))))
    } else {
      vclosure(env_nil(), var(nz()))
    }
  } else {
    vclosure(env_nil(), var(nz()))
  }
}

// `export_term(im, name)` builds the closed term whose value is the named
// export. A function export uses the full `let`-chain binding the seeded host
// fns (outermost) then every guest fn, with the root referencing the export's
// binding. The host fns are bound first (the deepest de Bruijn indices), so
// the export at guest declaration position `e` (of `k+1` guest fns) still sits
// at de Bruijn index `k - e` from the chain's innermost point (`v_k` is
// nearest, the host-fn bindings are below) — the root is `var(k - e)`,
// unchanged by the seeding. A member export instead uses its standalone
// synthesized constructor or projector term.
// Returns `()` when the surface has no such export (absent or ambiguous).
/// Builds the closed term that evaluates to the named export, or `()` when
/// the surface carries no unique export by that name.
pub fn export_term(im: Image, name: String) -> . | Term {
  match! un_export_find(find_export(im, name)) {
    (
      , .(hit: Ef_found) {
          match! Ef_found.get(hit) {
            .(pos: I32, _g: Gdecl) {
              let total = terms_acc_len(image_terms(im));
              let idx = sub_i32(sub_i32(total, 1(I32)), pos);
              let chain =
                prepend_terms_acc(hostfn_seed_terms(image_runtime_hostfns(im)), image_terms(im));
              widen_sum!(chain_term(chain, var(nat_of_i32(idx))), . | Term)
            }
          }
        }
      , .(_absent: Ef_absent) { widen_sum!((), . | Term) }
      , .(_amb: Ef_ambiguous) { widen_sum!((), . | Term) }
      , .(mh: Ef_member) {
          match! Ef_member.get(mh) {
            .(o: Omember, is_proj: Bool) {
              widen_sum!(member_term(omember_decl(o), is_proj), . | Term)
            }
          }
        }
      )
  }
}

// =====================================================================
// Signature-token helpers
// =====================================================================
//
// These token readers are shared by exact type resolution and synthesized
// newtype-member signatures. Semantic canonicalization happens only in the
// exact resolver below.

// The collected binder list and the tokens after the leading binder groups.
labels { binders_done: Binders & Toks };

// Is the head token the punctuation `code`? (Local mirror of the parser's
// helper, over the loader's imported token vocabulary.)
fn sig_head_is(ts: Toks, code: I32) -> Bool {
  match! un_toks(ts) {
    (
      , .(t: Token, _p: I32, _rest: Toks) {
          match! un_token(t) {
            (
              , .(_w: Tk_word) { .f(Bool) }
              , .(_n: Tk_num) { .f(Bool) }
              , .(_s: Tk_str) { .f(Bool) }
              , .(p: Tk_punct) { eq_i32(Tk_punct.get(p), code) }
              )
          }
        }
      , .(_e: .) { .f(Bool) }
      )
  }
}

fn sig_rest(ts: Toks) -> Toks {
  match! un_toks(ts) {
    (.(_t: Token, _p: I32, rest: Toks) { rest }, .(_e: .) { ts })
  }
}

fn sig_head_word(ts: Toks) -> . | String {
  match! un_toks(ts) {
    (
      , .(t: Token, _p: I32, _rest: Toks) {
          match! un_token(t) {
            (
              , .(w: Tk_word) { widen_sum!(Tk_word.get(w), . | String) }
              , .(_n: Tk_num) { widen_sum!((), . | String) }
              , .(_s: Tk_str) { widen_sum!((), . | String) }
              , .(_p: Tk_punct) { widen_sum!((), . | String) }
              )
          }
        }
      , .(_e: .) { widen_sum!((), . | String) }
      )
  }
}

labels { type_path_read: String & Toks };

labels { type_path_read_state: String & Toks };

// Read one grammar-level TypePath head while leaving any application tokens
// untouched. Qualified paths are lexed as word (`/` word)* `.` word, rather
// than as one word token.
fn read_type_path(ts: Toks) -> . | Type_path_read {
  match! sig_head_word(ts) {
    (
      , .(first: String) {
          loop(
            , .(state: Type_path_read_state) {
                match! Type_path_read_state.get(state) {
                  .(rendered: String, remaining: Toks) {
                    if! sig_head_is(remaining, 47(I32)) {
                      let after_slash = sig_rest(remaining);
                      match! sig_head_word(after_slash) {
                        (
                          , .(segment: String) {
                              widen_sum!(
                                , {type_path_read_state = (
                                    , string_concat(rendered, string_concat("/"(String), segment))
                                    , sig_rest(after_slash)
                                    )}
                                , Type_path_read_state | . | Type_path_read
                                )
                            }
                          , .(_missing_segment: .) {
                              widen_sum!((), Type_path_read_state | . | Type_path_read)
                            }
                          )
                      }
                    } else if! sig_head_is(remaining, 46(I32)) {
                      let after_dot = sig_rest(remaining);
                      match! sig_head_word(after_dot) {
                        (
                          , .(leaf: String) {
                              widen_sum!(
                                , {type_path_read = (
                                    , string_concat(rendered, string_concat("."(String), leaf))
                                    , sig_rest(after_dot)
                                    )}
                                , Type_path_read_state | . | Type_path_read
                                )
                            }
                          , .(_missing_leaf: .) {
                              widen_sum!((), Type_path_read_state | . | Type_path_read)
                            }
                          )
                      }
                    } else {
                      widen_sum!(
                        , {type_path_read = (rendered, remaining)}
                        , Type_path_read_state | . | Type_path_read
                        )
                    }
                  }
                }
              }
            , {type_path_read_state = (first, sig_rest(ts))}
            )
        }
      , .(_not_word: .) { widen_sum!((), . | Type_path_read) }
      )
  }
}

// A run of `*` kind stars: the count and the tokens after it.
fn count_stars(ts: Toks) -> I32 & Toks {
  let loop_result =
    loop(
      , .(st: Toks & I32) {
          match! st {
            .(cur: Toks, n: I32) {
              if! sig_head_is(cur, 42(I32)) {
                widen_sum!((sig_rest(cur), add_i32(n, 1(I32))), (Toks & I32) | (I32 & Toks))
              } else {
                widen_sum!((n, cur), (Toks & I32) | (I32 & Toks))
              }
            }
          }
        }
      , (ts, 0(I32))
      );
  match! loop_result {
    .(n: I32, after: Toks) { (n, after) }
  }
}

// Collect one group's comma-separated binders, the head just past the
// `[`; returns the extended (reversed) list and the tokens after the `]`.
fn collect_group_binders(ts: Toks, acc: Binders) -> Binders & Toks {
  match! Binders_done.get(loop(
    , .(st: Toks & Binders) {
        match! st {
          .(cur: Toks, out: Binders) {
            if! sig_head_is(cur, 93(I32)) {
              widen_sum!({binders_done = (out, sig_rest(cur))}, (Toks & Binders) | Binders_done)
            } else if! sig_head_is(cur, 44(I32)) {
              widen_sum!((sig_rest(cur), out), (Toks & Binders) | Binders_done)
            } else match! count_stars(cur) {
              .(stars: I32, after_stars: Toks) {
                match! sig_head_word(after_stars) {
                  (
                    , .(name: String) {
                        widen_sum!(
                          , (
                              , sig_rest(after_stars)
                              , binders_cons({binder_info = (name, stars)}, out)
                              )
                          , (Toks & Binders) | Binders_done
                          )
                      }
                    , .(_notword: .) {
                        widen_sum!(
                          , {binders_done = (out, after_stars)}
                          , (Toks & Binders) | Binders_done
                          )
                      }
                    )
                }
              }
            }
          }
        }
      }
    , (ts, acc)
    )) {
    .(out: Binders, after: Toks) { (out, after) }
  }
}

// Collect the leading type-binder groups `[*F][A]` (or `[A, B]`) into the
// binder list, returning it (introduction order) with the tokens after
// the groups.
fn collect_binders(ts: Toks) -> Binders & Toks {
  match! Binders_done.get(loop(
    , .(st: Toks & Binders) {
        match! st {
          .(cur: Toks, acc: Binders) {
            if! sig_head_is(cur, 91(I32)) {
              match! collect_group_binders(sig_rest(cur), acc) {
                .(acc1: Binders, after: Toks) {
                  widen_sum!((after, acc1), (Toks & Binders) | Binders_done)
                }
              }
            } else {
              widen_sum!({binders_done = (acc, cur)}, (Toks & Binders) | Binders_done)
            }
          }
        }
      }
    , (ts, binders_nil())
    )) {
    .(acc: Binders, after: Toks) { (binders_reverse(acc), after) }
  }
}

// A run of `n` kind stars.
fn star_run(n: I32) -> String {
  loop(
    , .(st: I32 & String) {
        match! st {
          .(k: I32, acc: String) {
            if! leq_i32(k, 0(I32)) {
              widen_sum!(acc, (I32 & String) | String)
            } else {
              widen_sum!(
                , (sub_i32(k, 1(I32)), string_concat(acc, "*"(String)))
                , (I32 & String) | String
                )
            }
          }
        }
      }
    , (n, ""(String))
    )
}

// The number of binders in introduction order.
fn binders_len(b: Binders) -> I32 { length(Binder_info, Binders.get(b)) }

fn binders_have_base_kind(binders: Binders) -> Bool {
  loop(
    , .(remaining: Binders) {
        match! un_binders(remaining) {
          (
            , .(binder: Binder_info, rest: Binders) {
                match! Binder_info.get(binder) {
                  .(_name: String, stars: I32) {
                    if! eq_i32(stars, 0(I32)) {
                      widen_sum!(rest, Binders | Bool)
                    } else {
                      widen_sum!(.f(Bool), Binders | Bool)
                    }
                  }
                }
              }
            , .(_empty: .) { widen_sum!(.t(Bool), Binders | Bool) }
            )
        }
      }
    , binders
    )
}

// =====================================================================
// Exact host-type descriptor parsing
// =====================================================================
fn toks_empty(ts: Toks) -> Bool {
  match! un_toks(ts) {
    (.(_t: Token, _p: I32, _rest: Toks) { .f(Bool) }, .(_empty: .) { .t(Bool) })
  }
}

labels { host_binder_state: Toks & Binders };

labels { host_group_state: Toks & Binders & Bool & Bool };

labels { host_binders_done: Binders & Toks };

labels { host_binders_bad: String };

type Host_binders_result = Host_binders_done | Host_binders_bad;

fn host_binders_done(binders: Binders, after: Toks) -> Host_binders_result {
  widen_sum!({host_binders_done = (binders, after)}, Host_binders_result)
}

fn host_binders_bad(detail: String) -> Host_binders_result {
  widen_sum!({host_binders_bad = detail}, Host_binders_result)
}

// Parse one non-empty binder group after its opening `[`. Unlike the
// permissive token collector, this validates the complete group because a
// loaded image is untrusted phase input.
fn parse_host_binder_group(ts: Toks, acc: Binders) -> Host_binders_result {
  loop(
    , .(state: Host_group_state) {
        match! Host_group_state.get(state) {
          .(remaining: Toks, out: Binders, seen_binder: Bool, after_binder: Bool) {
            if! sig_head_is(remaining, 93(I32)) {
              if! seen_binder {
                widen_sum!(
                  , host_binders_done(out, sig_rest(remaining))
                  , Host_group_state | Host_binders_result
                  )
              } else {
                widen_sum!(
                  , host_binders_bad("expected a type-parameter name"(String))
                  , Host_group_state | Host_binders_result
                  )
              }
            } else if! sig_head_is(remaining, 44(I32)) {
              widen_sum!(
                , {host_group_state = (sig_rest(remaining), (out, (seen_binder, .f(Bool))))}
                , Host_group_state | Host_binders_result
                )
            } else if! after_binder {
              widen_sum!(
                , if! toks_empty(remaining) {
                    host_binders_bad("unterminated type-parameter list"(String))
                  } else {
                    host_binders_bad("expected `,` or `]` after a type parameter"(String))
                  }
                , Host_group_state | Host_binders_result
                )
            } else match! count_stars(remaining) {
              .(stars: I32, after_stars: Toks) {
                match! sig_head_word(after_stars) {
                  (
                    , .(name: String) {
                        widen_sum!(
                          , {host_group_state = (
                              , sig_rest(after_stars)
                              , (
                                  , binders_cons({binder_info = (name, stars)}, out)
                                  , (.t(Bool), .t(Bool))
                                  )
                              )}
                          , Host_group_state | Host_binders_result
                          )
                      }
                    , .(_missing: .) {
                        widen_sum!(
                          , if! toks_empty(after_stars) {
                              host_binders_bad("unterminated type-parameter list"(String))
                            } else {
                              host_binders_bad("expected a type-parameter name"(String))
                            }
                          , Host_group_state | Host_binders_result
                          )
                      }
                    )
                }
              }
            }
          }
        }
      }
    , {host_group_state = (ts, (acc, (.f(Bool), .f(Bool))))}
    )
}

// Parse every leading type-binder group, returning introduction order and
// the first token after the groups.
fn parse_host_binders(ts: Toks) -> Host_binders_result {
  loop(
    , .(state: Host_binder_state) {
        match! Host_binder_state.get(state) {
          .(remaining: Toks, reversed: Binders) {
            if! sig_head_is(remaining, 91(I32)) {
              match! parse_host_binder_group(sig_rest(remaining), reversed) {
                (
                  , .(done: Host_binders_done) {
                      match! Host_binders_done.get(done) {
                        .(next_reversed: Binders, after: Toks) {
                          widen_sum!(
                            , {host_binder_state = (after, next_reversed)}
                            , Host_binder_state | Host_binders_result
                            )
                        }
                      }
                    }
                  , .(bad: Host_binders_bad) {
                      widen_sum!(bad, Host_binder_state | Host_binders_result)
                    }
                  )
              }
            } else {
              widen_sum!(
                , host_binders_done(binders_reverse(reversed), remaining)
                , Host_binder_state | Host_binders_result
                )
            }
          }
        }
      }
    , {host_binder_state = (ts, binders_nil())}
    )
}

// The scanner retains the token run after a host declaration's local name.
// Turn the star count on one type binder into its exact kind.
fn host_param_kind(stars: I32) -> Param_kind {
  loop(
    , .(st: I32 & Param_kind) {
        match! st {
          .(remaining: I32, kind: Param_kind) {
            if! leq_i32(remaining, 0(I32)) {
              widen_sum!(kind, (I32 & Param_kind) | Param_kind)
            } else {
              widen_sum!(
                , (sub_i32(remaining, 1(I32)), higher_kind(kind))
                , (I32 & Param_kind) | Param_kind
                )
            }
          }
        }
      }
    , (stars, base_kind())
    )
}

// Preserve declaration order while discarding binder spellings: exact host
// type descriptors carry only the ordered parameter kinds.
fn host_param_kinds(bs: Binders) -> Param_kinds {
  loop(
    , .(st: Binders & Param_kinds) {
        match! st {
          .(remaining: Binders, reversed: Param_kinds) {
            match! un_binders(remaining) {
              (
                , .(binder: Binder_info, rest: Binders) {
                    match! Binder_info.get(binder) {
                      .(_name: String, stars: I32) {
                        widen_sum!(
                          , (rest, param_kinds_cons(host_param_kind(stars), reversed))
                          , (Binders & Param_kinds) | Param_kinds
                          )
                      }
                    }
                  }
                , .(_empty: .) { widen_sum!(reversed, (Binders & Param_kinds) | Param_kinds) }
                )
            }
          }
        }
      }
    , (binders_reverse(bs), param_kinds_nil())
    )
}

// Parse an exact optional `{ owned }` suffix: false when absent, true when
// present, and unit when malformed. Ownership is a backend rendering hint,
// not part of a host type's dynamic identity.
fn parse_owned_suffix(ts: Toks) -> . | Bool {
  if! toks_empty(ts) {
    widen_sum!(.f(Bool), . | Bool)
  } else if! sig_head_is(ts, 123(I32)) {
    let after_open = sig_rest(ts);
    match! sig_head_word(after_open) {
      (
        , .(word: String) {
            let after_word = sig_rest(after_open);
            if! string_eq(word, "owned"(String)) {
              if! sig_head_is(after_word, 125(I32)) {
                let after_close = sig_rest(after_word);
                if! toks_empty(after_close) {
                  widen_sum!(.t(Bool), . | Bool)
                } else {
                  widen_sum!((), . | Bool)
                }
              } else {
                widen_sum!((), . | Bool)
              }
            } else {
              widen_sum!((), . | Bool)
            }
          }
        , .(_notword: .) { widen_sum!((), . | Bool) }
        )
    }
  } else {
    widen_sum!((), . | Bool)
  }
}

fn malformed_host_type(id: Host_id, detail: String) -> Host_type | Diag {
  widen_sum!(
    , mk_diag(string_concat(
        , "dyn_load_prime: malformed host type `"(String)
        , string_concat(host_id_render(id), string_concat("`: "(String), detail))
        ))
    , Host_type | Diag
    )
}

fn parse_role_host_type(id: Host_id, binders: Binders, ts: Toks) -> Host_type | Diag {
  if! eq_i32(binders_len(binders), 0(I32)) {
    if! sig_head_is(ts, 40(I32)) {
      let after_open = sig_rest(ts);
      match! sig_head_word(after_open) {
        (
          , .(role_spelling: String) {
              let after_name = sig_rest(after_open);
              if! sig_head_is(after_name, 41(I32)) {
                match! parse_owned_suffix(sig_rest(after_name)) {
                  (
                    , .(_owned: Bool) {
                        match! role_from_name(role_spelling) {
                          (
                            , .(role: Role) {
                                widen_sum!(mk_role_host_type(id, role), Host_type | Diag)
                              }
                            , .(_unknown: .) {
                                malformed_host_type(
                                  , id
                                  , string_concat(
                                      , "unknown role `"(String)
                                      , string_concat(role_spelling, "`"(String))
                                      )
                                  )
                              }
                            )
                        }
                      }
                    , .(_bad_suffix: .) {
                        malformed_host_type(
                          , id
                          , "unexpected tokens after the role annotation"(String)
                          )
                      }
                    )
                }
              } else {
                malformed_host_type(id, "unterminated role annotation"(String))
              }
            }
          , .(_missing_name: .) { malformed_host_type(id, "missing role name"(String)) }
          )
      }
    } else {
      malformed_host_type(id, "expected `(` after `role`"(String))
    }
  } else {
    malformed_host_type(id, "role-bearing host types cannot have type parameters"(String))
  }
}

// Parse the retained header of one host type. The two admitted shapes are
// disjoint: an ordered base-kind binder list without a role, or one closed
// role without binders. The optional Rust ownership block is a backend
// rendering hint and carries no dynamic descriptor identity.
fn parse_host_type_descriptor(module_name: String, header: Host_header) -> Host_type | Diag {
  let id = mk_host_id(module_name, host_header_name(header));
  match! parse_host_binders(host_header_tokens(header)) {
    (
      , .(done: Host_binders_done) {
          match! Host_binders_done.get(done) {
            .(binders: Binders, after_binders: Toks) {
              match! parse_owned_suffix(after_binders) {
                (
                  , .(_owned: Bool) {
                      if! binders_have_base_kind(binders) {
                        widen_sum!(
                          , mk_roleless_host_type(id, host_param_kinds(binders))
                          , Host_type | Diag
                          )
                      } else {
                        malformed_host_type(id, "host type parameters must have kind `*`"(String))
                      }
                    }
                  , .(_not_roleless: .) {
                      match! sig_head_word(after_binders) {
                        (
                          , .(keyword: String) {
                              if! string_eq(keyword, "role"(String)) {
                                parse_role_host_type(id, binders, sig_rest(after_binders))
                              } else {
                                malformed_host_type(id, "unexpected declaration suffix"(String))
                              }
                            }
                          , .(_notword: .) {
                              malformed_host_type(id, "unexpected declaration suffix"(String))
                            }
                          )
                      }
                    }
                  )
              }
            }
          }
        }
      , .(bad: Host_binders_bad) { malformed_host_type(id, Host_binders_bad.get(bad)) }
      )
  }
}

fn collect_module_host_types(module: Module, initial: Host_types) -> Host_types | Diag {
  loop(
    , .(state: Host_headers & Host_types) {
        match! state {
          .(remaining: Host_headers, collected: Host_types) {
            match! un_host_headers(remaining) {
              (
                , .(header: Host_header, rest: Host_headers) {
                    if! host_header_is_fn(header) {
                      widen_sum!((rest, collected), (Host_headers & Host_types) | Host_types | Diag)
                    } else match! parse_host_type_descriptor(module_name(module), header) {
                      (
                        , .(descriptor: Host_type) {
                            widen_sum!(
                              , (rest, host_types_cons(descriptor, collected))
                              , (Host_headers & Host_types) | Host_types | Diag
                              )
                          }
                        , .(diag: Diag) {
                            widen_sum!(diag, (Host_headers & Host_types) | Host_types | Diag)
                          }
                        )
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(collected, (Host_headers & Host_types) | Host_types | Diag)
                  }
                )
            }
          }
        }
      }
    , (module_host_headers(module), initial)
    )
}

fn collect_host_types(modules: Modules) -> Host_types | Diag {
  loop(
    , .(state: Modules & Host_types) {
        match! state {
          .(remaining: Modules, collected: Host_types) {
            match! un_modules(remaining) {
              (
                , .(module: Module, rest: Modules) {
                    match! collect_module_host_types(module, collected) {
                      (
                        , .(next: Host_types) {
                            widen_sum!((rest, next), (Modules & Host_types) | Host_types | Diag)
                          }
                        , .(diag: Diag) {
                            widen_sum!(diag, (Modules & Host_types) | Host_types | Diag)
                          }
                        )
                    }
                  }
                , .(_empty: .) { widen_sum!(collected, (Modules & Host_types) | Host_types | Diag) }
                )
            }
          }
        }
      }
    , (modules, host_types_nil())
    )
}

// =====================================================================
// Exact canonical type/signature parsing for Host_fn descriptors
// =====================================================================

// Name resolution and transparent-alias expansion rewrite every type head to
// one of the collision-free words consumed here: `h{module.Type}` for a host
// type, `n{module.Type}` for a nominal/newtype, or `#k` for a lexical binder.
// This parser then reconstructs the resolved type shape. Keeping shape and FFI
// slot count together prevents runtime staging from being inferred by reparsing
// the rendered canonical string.
labels { terminal_host_type: . | Host_type };

labels { nominal_ids: List(Host_id) };

fn nominal_ids_nil() -> Nominal_ids { {nominal_ids = nil(Host_id, ())} }

fn nominal_ids_cons(head: Host_id, tail: Nominal_ids) -> Nominal_ids {
  {nominal_ids = cons(Host_id, head, Nominal_ids.get(tail))}
}

fn un_nominal_ids(ids: Nominal_ids) -> . | (Host_id & Nominal_ids) {
  match! uncons(Host_id, Nominal_ids.get(ids)) {
    (
      , .(head: Host_id, tail: List(Host_id)) {
          widen_sum!((head, {nominal_ids = tail}), . | (Host_id & Nominal_ids))
        }
      , .(_empty: .) { widen_sum!((), . | (Host_id & Nominal_ids)) }
      )
  }
}

fn nominal_ids_contains(ids: Nominal_ids, wanted: Host_id) -> Bool {
  loop(
    , .(remaining: Nominal_ids) {
        match! un_nominal_ids(remaining) {
          (
            , .(candidate: Host_id, rest: Nominal_ids) {
                if! host_id_eq(candidate, wanted) {
                  widen_sum!(.t(Bool), Nominal_ids | Bool)
                } else {
                  widen_sum!(rest, Nominal_ids | Bool)
                }
              }
            , .(_empty: .) { widen_sum!(.f(Bool), Nominal_ids | Bool) }
            )
        }
      }
    , ids
    )
}

fn nominal_ids_insert(ids: Nominal_ids, id: Host_id) -> Nominal_ids {
  if! nominal_ids_contains(ids, id) {
    ids
  } else {
    nominal_ids_cons(id, ids)
  }
}

fn nominal_ids_union(left: Nominal_ids, right: Nominal_ids) -> Nominal_ids {
  loop(
    , .(state: Nominal_ids & Nominal_ids) {
        match! state {
          .(remaining: Nominal_ids, collected: Nominal_ids) {
            match! un_nominal_ids(remaining) {
              (
                , .(head: Host_id, tail: Nominal_ids) {
                    widen_sum!(
                      , (tail, nominal_ids_insert(collected, head))
                      , (Nominal_ids & Nominal_ids) | Nominal_ids
                      )
                  }
                , .(_empty: .) { widen_sum!(collected, (Nominal_ids & Nominal_ids) | Nominal_ids) }
                )
            }
          }
        }
      }
    , (left, right)
    )
}

fn nominal_ids_subset(left: Nominal_ids, right: Nominal_ids) -> Bool {
  loop(
    , .(remaining: Nominal_ids) {
        match! un_nominal_ids(remaining) {
          (
            , .(head: Host_id, tail: Nominal_ids) {
                if! nominal_ids_contains(right, head) {
                  widen_sum!(tail, Nominal_ids | Bool)
                } else {
                  widen_sum!(.f(Bool), Nominal_ids | Bool)
                }
              }
            , .(_empty: .) { widen_sum!(.t(Bool), Nominal_ids | Bool) }
            )
        }
      }
    , left
    )
}

fn nominal_id_sets_eq(left: Nominal_ids, right: Nominal_ids) -> Bool {
  if! nominal_ids_subset(left, right) {
    nominal_ids_subset(right, left)
  } else {
    .f(Bool)
  }
}

type Alias_ids = Nominal_ids;

fn alias_ids_nil() -> Alias_ids { nominal_ids_nil() }

fn alias_ids_cons(head: Host_id, tail: Alias_ids) -> Alias_ids { nominal_ids_cons(head, tail) }

fn un_alias_ids(ids: Alias_ids) -> . | (Host_id & Alias_ids) { un_nominal_ids(ids) }

fn alias_ids_union(left: Alias_ids, right: Alias_ids) -> Alias_ids {
  nominal_ids_union(left, right)
}

fn alias_id_sets_eq(left: Alias_ids, right: Alias_ids) -> Bool { nominal_id_sets_eq(left, right) }

labels { type_dependencies: Host_types & Nominal_ids & Alias_ids };

fn mk_type_dependencies(hosts: Host_types, nominals: Nominal_ids, aliases: Alias_ids) -> Type_dependencies {
  {type_dependencies = (hosts, (nominals, aliases))}
}

fn type_dependencies_hosts(dependencies: Type_dependencies) -> Host_types {
  match! Type_dependencies.get(dependencies) {
    .(hosts: Host_types, _nominals: Nominal_ids, _aliases: Alias_ids) { hosts }
  }
}

fn type_dependencies_nominals(dependencies: Type_dependencies) -> Nominal_ids {
  match! Type_dependencies.get(dependencies) {
    .(_hosts: Host_types, nominals: Nominal_ids, _aliases: Alias_ids) { nominals }
  }
}

fn type_dependencies_aliases(dependencies: Type_dependencies) -> Alias_ids {
  match! Type_dependencies.get(dependencies) {
    .(_hosts: Host_types, _nominals: Nominal_ids, aliases: Alias_ids) { aliases }
  }
}

fn type_dependencies_nil() -> Type_dependencies {
  mk_type_dependencies(host_types_nil(), nominal_ids_nil(), alias_ids_nil())
}

// Binder keys are parse-time identities. Canonical alpha numbers are assigned
// only when the fully expanded signature is rendered.
labels { canonical_binder: I32 & I32 };

labels { canonical_binders: List(Canonical_binder) };

fn canonical_binders_nil() -> Canonical_binders { {canonical_binders = nil(Canonical_binder, ())} }

fn canonical_binders_cons(key: I32, stars: I32, rest: Canonical_binders) -> Canonical_binders {
  {canonical_binders = cons(
    , Canonical_binder
    , {canonical_binder = (key, stars)}
    , Canonical_binders.get(rest)
    )}
}

fn un_canonical_binders(bs: Canonical_binders) -> . | (Canonical_binder & Canonical_binders) {
  match! uncons(Canonical_binder, Canonical_binders.get(bs)) {
    (
      , .(head: Canonical_binder, tail: List(Canonical_binder)) {
          widen_sum!((head, {canonical_binders = tail}), . | (Canonical_binder & Canonical_binders))
        }
      , .(_empty: .) { widen_sum!((), . | (Canonical_binder & Canonical_binders)) }
      )
  }
}

fn canonical_binders_reverse(bs: Canonical_binders) -> Canonical_binders {
  {canonical_binders = reverse(Canonical_binder, Canonical_binders.get(bs))}
}

fn canonical_binders_len(bs: Canonical_binders) -> I32 {
  length(Canonical_binder, Canonical_binders.get(bs))
}

labels { cr_text: String };

labels { cr_bound_ref: I32 };

labels { cr_binder_group: Canonical_binders };

rec {
  labels { cr_concat: Canonical_render & Canonical_render };
  labels { cr_scope: Canonical_binders & Canonical_render };
  labels { canonical_render: Cr_text | Cr_bound_ref | Cr_binder_group | Cr_concat | Cr_scope }
}

type Canonical_render_node = Cr_text | Cr_bound_ref | Cr_binder_group | Cr_concat | Cr_scope;

fn canonical_render_text(value: String) -> Canonical_render {
  {canonical_render = widen_sum!({cr_text = value}, Canonical_render_node)}
}

fn canonical_render_bound(key: I32) -> Canonical_render {
  {canonical_render = widen_sum!({cr_bound_ref = key}, Canonical_render_node)}
}

fn canonical_render_binders(bs: Canonical_binders) -> Canonical_render {
  {canonical_render = widen_sum!({cr_binder_group = bs}, Canonical_render_node)}
}

fn canonical_render_concat(left: Canonical_render, right: Canonical_render) -> Canonical_render {
  {canonical_render = widen_sum!({cr_concat = (left, right)}, Canonical_render_node)}
}

fn canonical_render_concat3(
  , first: Canonical_render
  , second: Canonical_render
  , third: Canonical_render
  ) -> Canonical_render { canonical_render_concat(first, canonical_render_concat(second, third)) }

fn canonical_render_scope(bs: Canonical_binders, body: Canonical_render) -> Canonical_render {
  {canonical_render = widen_sum!({cr_scope = (bs, body)}, Canonical_render_node)}
}

fn canonical_render_node(render: Canonical_render) -> Canonical_render_node {
  Canonical_render.get(render)
}

labels { canonical_type: & Canonical_render
& Bool
& I32
& Bool
& Type_dependencies
& Terminal_host_type
& Param_kinds };

fn mk_canonical_type(
  , rendered: Canonical_render
  , is_unit: Bool
  , tail_slots: I32
  , compound: Bool
  , dependencies: Type_dependencies
  , terminal: Terminal_host_type
  , remaining_params: Param_kinds
  ) -> Canonical_type {
  {canonical_type = (
    , rendered
    , (is_unit, (tail_slots, (compound, (dependencies, (terminal, remaining_params)))))
    )}
}

fn canonical_type_render(t: Canonical_type) -> Canonical_render {
  match! Canonical_type.get(t) {
    .(
      , rendered: Canonical_render
      , _unit: Bool
      , _slots: I32
      , _compound: Bool
      , _dependencies: Type_dependencies
      , _terminal: Terminal_host_type
      , _remaining_params: Param_kinds
      ) { rendered }
  }
}

fn canonical_type_is_unit(t: Canonical_type) -> Bool {
  match! Canonical_type.get(t) {
    .(
      , _rendered: Canonical_render
      , is_unit: Bool
      , _slots: I32
      , _compound: Bool
      , _dependencies: Type_dependencies
      , _terminal: Terminal_host_type
      , _remaining_params: Param_kinds
      ) { is_unit }
  }
}

fn canonical_type_tail_slots(t: Canonical_type) -> I32 {
  match! Canonical_type.get(t) {
    .(
      , _rendered: Canonical_render
      , _unit: Bool
      , slots: I32
      , _compound: Bool
      , _dependencies: Type_dependencies
      , _terminal: Terminal_host_type
      , _remaining_params: Param_kinds
      ) { slots }
  }
}

fn canonical_type_is_compound(t: Canonical_type) -> Bool {
  match! Canonical_type.get(t) {
    .(
      , _rendered: Canonical_render
      , _unit: Bool
      , _slots: I32
      , compound: Bool
      , _dependencies: Type_dependencies
      , _terminal: Terminal_host_type
      , _remaining_params: Param_kinds
      ) { compound }
  }
}

fn canonical_type_dependencies(t: Canonical_type) -> Type_dependencies {
  match! Canonical_type.get(t) {
    .(
      , _rendered: Canonical_render
      , _unit: Bool
      , _slots: I32
      , _compound: Bool
      , dependencies: Type_dependencies
      , _terminal: Terminal_host_type
      , _remaining_params: Param_kinds
      ) { dependencies }
  }
}

fn canonical_type_terminal(t: Canonical_type) -> Terminal_host_type {
  match! Canonical_type.get(t) {
    .(
      , _rendered: Canonical_render
      , _unit: Bool
      , _slots: I32
      , _compound: Bool
      , _dependencies: Type_dependencies
      , terminal: Terminal_host_type
      , _remaining_params: Param_kinds
      ) { terminal }
  }
}

fn canonical_type_remaining_params(t: Canonical_type) -> Param_kinds {
  match! Canonical_type.get(t) {
    .(
      , _rendered: Canonical_render
      , _unit: Bool
      , _slots: I32
      , _compound: Bool
      , _dependencies: Type_dependencies
      , _terminal: Terminal_host_type
      , remaining_params: Param_kinds
      ) { remaining_params }
  }
}

fn canonical_type_has_base_kind(t: Canonical_type) -> Bool {
  match! un_param_kinds(canonical_type_remaining_params(t)) {
    (.(_parameter: Param_kind, _rest: Param_kinds) { .f(Bool) }, .(_empty: .) { .t(Bool) })
  }
}

fn host_types_contains_exact(types: Host_types, wanted: Host_type) -> Bool {
  loop(
    , .(remaining: Host_types) {
        match! un_host_types(remaining) {
          (
            , .(candidate: Host_type, rest: Host_types) {
                if! host_type_eq(candidate, wanted) {
                  widen_sum!(.t(Bool), Host_types | Bool)
                } else {
                  widen_sum!(rest, Host_types | Bool)
                }
              }
            , .(_empty: .) { widen_sum!(.f(Bool), Host_types | Bool) }
            )
        }
      }
    , types
    )
}

fn host_types_insert_exact(types: Host_types, one: Host_type) -> Host_types {
  if! host_types_contains_exact(types, one) {
    types
  } else {
    host_types_cons(one, types)
  }
}

fn host_types_union_exact(left: Host_types, right: Host_types) -> Host_types {
  loop(
    , .(state: Host_types & Host_types) {
        match! state {
          .(remaining: Host_types, collected: Host_types) {
            match! un_host_types(remaining) {
              (
                , .(head: Host_type, tail: Host_types) {
                    widen_sum!(
                      , (tail, host_types_insert_exact(collected, head))
                      , (Host_types & Host_types) | Host_types
                      )
                  }
                , .(_empty: .) { widen_sum!(collected, (Host_types & Host_types) | Host_types) }
                )
            }
          }
        }
      }
    , (left, right)
    )
}

fn type_dependencies_union(left: Type_dependencies, right: Type_dependencies) -> Type_dependencies {
  mk_type_dependencies(
    , host_types_union_exact(type_dependencies_hosts(left), type_dependencies_hosts(right))
    , nominal_ids_union(type_dependencies_nominals(left), type_dependencies_nominals(right))
    , alias_ids_union(type_dependencies_aliases(left), type_dependencies_aliases(right))
    )
}

fn canonical_type_with_extra_dependencies(t: Canonical_type, extra: Type_dependencies) -> Canonical_type {
  match! Canonical_type.get(t) {
    .(
      , rendered: Canonical_render
      , is_unit: Bool
      , slots: I32
      , compound: Bool
      , dependencies: Type_dependencies
      , terminal: Terminal_host_type
      , remaining_params: Param_kinds
      ) {
      mk_canonical_type(
        , rendered
        , is_unit
        , slots
        , compound
        , type_dependencies_union(dependencies, extra)
        , terminal
        , remaining_params
        )
    }
  }
}

fn alias_type_dependency(owner: String, name: String) -> Type_dependencies {
  mk_type_dependencies(
    , host_types_nil()
    , nominal_ids_nil()
    , alias_ids_cons(mk_host_id(owner, name), alias_ids_nil())
    )
}

fn type_dependency_sets_eq(left: Type_dependencies, right: Type_dependencies) -> Bool {
  if! host_type_sets_eq(type_dependencies_hosts(left), type_dependencies_hosts(right)) {
    if! nominal_id_sets_eq(type_dependencies_nominals(left), type_dependencies_nominals(right)) {
      alias_id_sets_eq(type_dependencies_aliases(left), type_dependencies_aliases(right))
    } else {
      .f(Bool)
    }
  } else {
    .f(Bool)
  }
}

fn no_terminal_host_type() -> Terminal_host_type {
  {terminal_host_type = widen_sum!((), . | Host_type)}
}

fn canonical_unit() -> Canonical_type {
  mk_canonical_type(
    , canonical_render_text("."(String))
    , .t(Bool)
    , 1(I32)
    , .f(Bool)
    , type_dependencies_nil()
    , no_terminal_host_type()
    , param_kinds_nil()
    )
}

fn canonical_bottom() -> Canonical_type {
  mk_canonical_type(
    , canonical_render_text("!"(String))
    , .f(Bool)
    , 1(I32)
    , .f(Bool)
    , type_dependencies_nil()
    , no_terminal_host_type()
    , param_kinds_nil()
    )
}

fn canonical_atom_params(rendered: Canonical_render, remaining_params: Param_kinds) -> Canonical_type {
  mk_canonical_type(
    , rendered
    , .f(Bool)
    , 1(I32)
    , .f(Bool)
    , type_dependencies_nil()
    , no_terminal_host_type()
    , remaining_params
    )
}

fn host_type_params(descriptor: Host_type) -> Param_kinds {
  match! host_type_shape(descriptor) {
    (
      , .(roleless: Roleless_host_type) { Roleless_host_type.get(roleless) }
      , .(_role: Role_host_type) { param_kinds_nil() }
      )
  }
}

fn canonical_host_atom(descriptor: Host_type) -> Canonical_type {
  mk_canonical_type(
    , canonical_render_text(string_concat(
        , "h{"(String)
        , string_concat(host_id_render(host_type_id(descriptor)), "}"(String))
        ))
    , .f(Bool)
    , 1(I32)
    , .f(Bool)
    , mk_type_dependencies(
        , host_types_cons(descriptor, host_types_nil())
        , nominal_ids_nil()
        , alias_ids_nil()
        )
    , {terminal_host_type = widen_sum!(descriptor, . | Host_type)}
    , host_type_params(descriptor)
    )
}

fn canonical_nominal_atom(id: Host_id, params: Param_kinds) -> Canonical_type {
  mk_canonical_type(
    , canonical_render_text(string_concat(
        , "n{"(String)
        , string_concat(host_id_render(id), "}"(String))
        ))
    , .f(Bool)
    , 1(I32)
    , .f(Bool)
    , mk_type_dependencies(
        , host_types_nil()
        , nominal_ids_cons(id, nominal_ids_nil())
        , alias_ids_nil()
        )
    , no_terminal_host_type()
    , params
    )
}

fn canonical_product(left: Canonical_type, right: Canonical_type) -> Canonical_type {
  mk_canonical_type(
    , canonical_render_concat3(
        , canonical_render_text("("(String))
        , canonical_type_render(left)
        , canonical_render_concat3(
            , canonical_render_text(" & "(String))
            , canonical_type_render(right)
            , canonical_render_text(")"(String))
            )
        )
    , .f(Bool)
    , add_i32(1(I32), canonical_type_tail_slots(right))
    , .t(Bool)
    , type_dependencies_union(canonical_type_dependencies(left), canonical_type_dependencies(right))
    , no_terminal_host_type()
    , param_kinds_nil()
    )
}

fn canonical_sum(left: Canonical_type, right: Canonical_type) -> Canonical_type {
  mk_canonical_type(
    , canonical_render_concat3(
        , canonical_render_text("("(String))
        , canonical_type_render(left)
        , canonical_render_concat3(
            , canonical_render_text(" | "(String))
            , canonical_type_render(right)
            , canonical_render_text(")"(String))
            )
        )
    , .f(Bool)
    , 1(I32)
    , .t(Bool)
    , type_dependencies_union(canonical_type_dependencies(left), canonical_type_dependencies(right))
    , no_terminal_host_type()
    , param_kinds_nil()
    )
}

fn canonical_arrow(left: Canonical_type, right: Canonical_type) -> Canonical_type {
  mk_canonical_type(
    , canonical_render_concat3(
        , canonical_render_text("("(String))
        , canonical_type_render(left)
        , canonical_render_concat3(
            , canonical_render_text(" -> "(String))
            , canonical_type_render(right)
            , canonical_render_text(")"(String))
            )
        )
    , .f(Bool)
    , 1(I32)
    , .t(Bool)
    , type_dependencies_union(canonical_type_dependencies(left), canonical_type_dependencies(right))
    , no_terminal_host_type()
    , param_kinds_nil()
    )
}

labels { canonical_types: List(Canonical_type) };

fn canonical_types_nil() -> Canonical_types { {canonical_types = nil(Canonical_type, ())} }

fn canonical_types_cons(head: Canonical_type, tail: Canonical_types) -> Canonical_types {
  {canonical_types = cons(Canonical_type, head, Canonical_types.get(tail))}
}

fn un_canonical_types(types: Canonical_types) -> . | (Canonical_type & Canonical_types) {
  match! uncons(Canonical_type, Canonical_types.get(types)) {
    (
      , .(head: Canonical_type, tail: List(Canonical_type)) {
          widen_sum!((head, {canonical_types = tail}), . | (Canonical_type & Canonical_types))
        }
      , .(_empty: .) { widen_sum!((), . | (Canonical_type & Canonical_types)) }
      )
  }
}

fn canonical_types_have_base_kind(types: Canonical_types) -> Bool {
  loop(
    , .(remaining: Canonical_types) {
        match! un_canonical_types(remaining) {
          (
            , .(head: Canonical_type, tail: Canonical_types) {
                if! canonical_type_has_base_kind(head) {
                  widen_sum!(tail, Canonical_types | Bool)
                } else {
                  widen_sum!(.f(Bool), Canonical_types | Bool)
                }
              }
            , .(_empty: .) { widen_sum!(.t(Bool), Canonical_types | Bool) }
            )
        }
      }
    , types
    )
}

fn fold_canonical_chain(reversed: Canonical_types, product: Bool) -> Canonical_type {
  match! un_canonical_types(reversed) {
    (
      , .(last: Canonical_type, rest: Canonical_types) {
          loop(
            , .(state: Canonical_types & Canonical_type) {
                match! state {
                  .(remaining: Canonical_types, acc: Canonical_type) {
                    match! un_canonical_types(remaining) {
                      (
                        , .(head: Canonical_type, tail: Canonical_types) {
                            widen_sum!(
                              , (
                                  , tail
                                  , if! product {
                                      canonical_product(head, acc)
                                    } else {
                                      canonical_sum(head, acc)
                                    }
                                  )
                              , (Canonical_types & Canonical_type) | Canonical_type
                              )
                          }
                        , .(_empty: .) {
                            widen_sum!(acc, (Canonical_types & Canonical_type) | Canonical_type)
                          }
                        )
                    }
                  }
                }
              }
            , (rest, last)
            )
        }
      , .(_empty: .) {
          if! product {
            canonical_unit()
          } else {
            canonical_bottom()
          }
        }
      )
  }
}

fn canonical_args(reversed: Canonical_types) -> Canonical_render {
  let ordered = {canonical_types = reverse(Canonical_type, Canonical_types.get(reversed))};
  loop(
    , .(state: Canonical_types & Canonical_render & Bool) {
        match! state {
          .(remaining: Canonical_types, acc: Canonical_render, first: Bool) {
            match! un_canonical_types(remaining) {
              (
                , .(head: Canonical_type, tail: Canonical_types) {
                    widen_sum!(
                      , (
                          , tail
                          , (
                              , if! first {
                                  canonical_type_render(head)
                                } else {
                                  canonical_render_concat3(
                                    , acc
                                    , canonical_render_text(", "(String))
                                    , canonical_type_render(head)
                                    )
                                }
                              , .f(Bool)
                              )
                          )
                      , (Canonical_types & Canonical_render & Bool) | Canonical_render
                      )
                  }
                , .(_empty: .) {
                    widen_sum!(acc, (Canonical_types & Canonical_render & Bool) | Canonical_render)
                  }
                )
            }
          }
        }
      }
    , (ordered, (canonical_render_text(""(String)), .t(Bool)))
    )
}

fn canonical_types_dependencies(types: Canonical_types) -> Type_dependencies {
  loop(
    , .(state: Canonical_types & Type_dependencies) {
        match! state {
          .(remaining: Canonical_types, dependencies: Type_dependencies) {
            match! un_canonical_types(remaining) {
              (
                , .(head: Canonical_type, tail: Canonical_types) {
                    widen_sum!(
                      , (
                          , tail
                          , type_dependencies_union(canonical_type_dependencies(head), dependencies)
                          )
                      , (Canonical_types & Type_dependencies) | Type_dependencies
                      )
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , dependencies
                      , (Canonical_types & Type_dependencies) | Type_dependencies
                      )
                  }
                )
            }
          }
        }
      }
    , (types, type_dependencies_nil())
    )
}

fn canonical_types_reverse(types: Canonical_types) -> Canonical_types {
  {canonical_types = reverse(Canonical_type, Canonical_types.get(types))}
}

fn canonical_types_len(types: Canonical_types) -> I32 {
  length(Canonical_type, Canonical_types.get(types))
}

fn params_from_binder_kind(kind: Param_kind) -> Param_kinds {
  loop(
    , .(state: Param_kind & Param_kinds) {
        match! state {
          .(remaining: Param_kind, reversed: Param_kinds) {
            match! un_param_kind(remaining) {
              (
                , .(rest: Param_kind) {
                    widen_sum!(
                      , (rest, param_kinds_cons(base_kind(), reversed))
                      , (Param_kind & Param_kinds) | Param_kinds
                      )
                  }
                , .(_base: .) { widen_sum!(reversed, (Param_kind & Param_kinds) | Param_kinds) }
                )
            }
          }
        }
      }
    , (kind, param_kinds_nil())
    )
}

fn canonical_type_kind(t: Canonical_type) -> . | Param_kind {
  let params = canonical_type_remaining_params(t);
  let loop_result =
    loop(
      , .(remaining: Param_kinds) {
          match! un_param_kinds(remaining) {
            (
              , .(expected: Param_kind, rest: Param_kinds) {
                  if! param_kind_eq(expected, base_kind()) {
                    widen_sum!(rest, Param_kinds | Bool)
                  } else {
                    widen_sum!(.f(Bool), Param_kinds | Bool)
                  }
                }
              , .(_empty: .) { widen_sum!(.t(Bool), Param_kinds | Bool) }
              )
          }
        }
      , params
      );
  match! loop_result {
    .(all_base: Bool) {
      if! all_base {
        widen_sum!(host_param_kind(length(Param_kind, Param_kinds.get(params))), . | Param_kind)
      } else {
        widen_sum!((), . | Param_kind)
      }
    }
  }
}

labels { canonical_application_ok: Canonical_type };

labels { canonical_application_bad: Diag };

type Canonical_application_result = Canonical_application_ok | Canonical_application_bad;

fn canonical_parse_diag(detail: String) -> Diag {
  mk_diag(string_concat("dyn_load_prime: malformed exact host-function signature: "(String), detail))
}

fn validate_application_args(params: Param_kinds, reversed_args: Canonical_types) ->
  Param_kinds | Diag
   {
  loop(
    , .(state: Param_kinds & Canonical_types) {
        match! state {
          .(remaining_params: Param_kinds, remaining_args: Canonical_types) {
            match! un_canonical_types(remaining_args) {
              (
                , .(argument: Canonical_type, rest_args: Canonical_types) {
                    match! un_param_kinds(remaining_params) {
                      (
                        , .(expected: Param_kind, rest_params: Param_kinds) {
                            match! canonical_type_kind(argument) {
                              (
                                , .(actual: Param_kind) {
                                    if! param_kind_eq(expected, actual) {
                                      widen_sum!(
                                        , (rest_params, rest_args)
                                        , (Param_kinds & Canonical_types) | Param_kinds | Diag
                                        )
                                    } else {
                                      widen_sum!(
                                        , canonical_parse_diag("type argument kind does not match the selected constructor parameter"(String))
                                        , (Param_kinds & Canonical_types) | Param_kinds | Diag
                                        )
                                    }
                                  }
                                , .(_unrepresentable: .) {
                                    widen_sum!(
                                      , canonical_parse_diag("a partially applied higher-order constructor cannot fill a binder kind"(String))
                                      , (Param_kinds & Canonical_types) | Param_kinds | Diag
                                      )
                                  }
                                )
                            }
                          }
                        , .(_no_param: .) {
                            widen_sum!(
                              , canonical_parse_diag("type application supplies more arguments than the selected constructor "
                                                     "accepts"(String))
                              , (Param_kinds & Canonical_types) | Param_kinds | Diag
                              )
                          }
                        )
                    }
                  }
                , .(_no_args: .) {
                    widen_sum!(
                      , remaining_params
                      , (Param_kinds & Canonical_types) | Param_kinds | Diag
                      )
                  }
                )
            }
          }
        }
      }
    , (params, canonical_types_reverse(reversed_args))
    )
}

fn canonical_application(head: Canonical_type, args: Canonical_types) -> Canonical_application_result {
  match! validate_application_args(canonical_type_remaining_params(head), args) {
    (
      , .(remaining: Param_kinds) {
          widen_sum!(
            , {canonical_application_ok = mk_canonical_type(
                , canonical_render_concat3(
                    , canonical_type_render(head)
                    , canonical_render_text("("(String))
                    , canonical_render_concat(
                        , canonical_args(args)
                        , canonical_render_text(")"(String))
                        )
                    )
                , .f(Bool)
                , 1(I32)
                , .f(Bool)
                , type_dependencies_union(
                    , canonical_type_dependencies(head)
                    , canonical_types_dependencies(args)
                    )
                , canonical_type_terminal(head)
                , remaining
                )}
            , Canonical_application_result
            )
        }
      , .(diag: Diag) {
          widen_sum!({canonical_application_bad = diag}, Canonical_application_result)
        }
      )
  }
}

fn source_binders_text(bs: Binders) -> String {
  loop(
    , .(state: Binders & String) {
        match! state {
          .(remaining: Binders, acc: String) {
            match! un_binders(remaining) {
              (
                , .(binder: Binder_info, rest: Binders) {
                    match! Binder_info.get(binder) {
                      .(name: String, stars: I32) {
                        let piece =
                          string_concat(
                            , "["(String)
                            , string_concat(star_run(stars), string_concat(name, "]"(String)))
                            );
                        widen_sum!(
                          , (
                              , rest
                              , if! string_eq(acc, ""(String)) {
                                  piece
                                } else {
                                  string_concat(acc, string_concat(" "(String), piece))
                                }
                              )
                          , (Binders & String) | String
                          )
                      }
                    }
                  }
                , .(_empty: .) { widen_sum!(acc, (Binders & String) | String) }
                )
            }
          }
        }
      }
    , (bs, ""(String))
    )
}

fn canonical_forall(bs: Canonical_binders, body: Canonical_type) -> Canonical_type {
  if! eq_i32(canonical_binders_len(bs), 0(I32)) {
    body
  } else {
    mk_canonical_type(
      , canonical_render_scope(
          , bs
          , canonical_render_concat3(
              , canonical_render_text("("(String))
              , canonical_render_binders(bs)
              , canonical_render_concat3(
                  , canonical_render_text(" "(String))
                  , canonical_type_render(body)
                  , canonical_render_text(")"(String))
                  )
              )
          )
      , .f(Bool)
      , 1(I32)
      , .t(Bool)
      , canonical_type_dependencies(body)
      , no_terminal_host_type()
      , param_kinds_nil()
      )
  }
}

fn canonical_group(t: Canonical_type) -> Canonical_render {
  if! canonical_type_is_unit(t) {
    canonical_render_text("()"(String))
  } else if! canonical_type_is_compound(t) {
    canonical_type_render(t)
  } else {
    canonical_render_concat3(
      , canonical_render_text("("(String))
      , canonical_type_render(t)
      , canonical_render_text(")"(String))
      )
  }
}

labels { canonical_render_binding: I32 & I32 };

labels { canonical_render_bindings: List(Canonical_render_binding) };

fn canonical_render_bindings_nil() -> Canonical_render_bindings {
  {canonical_render_bindings = nil(Canonical_render_binding, ())}
}

fn canonical_render_bindings_cons(key: I32, alpha: I32, rest: Canonical_render_bindings) -> Canonical_render_bindings {
  {canonical_render_bindings = cons(
    , Canonical_render_binding
    , {canonical_render_binding = (key, alpha)}
    , Canonical_render_bindings.get(rest)
    )}
}

fn canonical_render_binding_find(bindings: Canonical_render_bindings, key: I32) -> . | I32 {
  loop(
    , .(remaining: Canonical_render_bindings) {
        match! uncons(Canonical_render_binding, Canonical_render_bindings.get(remaining)) {
          (
            , .(entry: Canonical_render_binding, tail: List(Canonical_render_binding)) {
                match! Canonical_render_binding.get(entry) {
                  .(candidate: I32, alpha: I32) {
                    if! eq_i32(candidate, key) {
                      widen_sum!(widen_sum!(alpha, . | I32), Canonical_render_bindings | . | I32)
                    } else {
                      widen_sum!(
                        , {canonical_render_bindings = tail}
                        , Canonical_render_bindings | . | I32
                        )
                    }
                  }
                }
              }
            , .(_empty: .) {
                widen_sum!(widen_sum!((), . | I32), Canonical_render_bindings | . | I32)
              }
            )
        }
      }
    , bindings
    )
}

labels { canonical_scope_bindings: Canonical_render_bindings & I32 };

fn extend_canonical_render_bindings(
  , bs: Canonical_binders
  , initial: Canonical_render_bindings
  , next_alpha: I32
  ) -> Canonical_scope_bindings {
  loop(
    , .(state: Canonical_binders & Canonical_render_bindings & I32) {
        match! state {
          .(remaining: Canonical_binders, bindings: Canonical_render_bindings, next: I32) {
            match! un_canonical_binders(remaining) {
              (
                , .(binder: Canonical_binder, rest: Canonical_binders) {
                    match! Canonical_binder.get(binder) {
                      .(key: I32, _stars: I32) {
                        widen_sum!(
                          , (
                              , rest
                              , (
                                  , canonical_render_bindings_cons(key, next, bindings)
                                  , add_i32(next, 1(I32))
                                  )
                              )
                          , (| (Canonical_binders & Canonical_render_bindings & I32)
                            | Canonical_scope_bindings)
                          )
                      }
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , {canonical_scope_bindings = (bindings, next)}
                      , (| (Canonical_binders & Canonical_render_bindings & I32)
                        | Canonical_scope_bindings)
                      )
                  }
                )
            }
          }
        }
      }
    , (bs, (initial, next_alpha))
    )
}

fn canonical_binder_group_text(bs: Canonical_binders, bindings: Canonical_render_bindings) ->
  String | Diag
   {
  loop(
    , .(state: Canonical_binders & String & Bool) {
        match! state {
          .(remaining: Canonical_binders, acc: String, first: Bool) {
            match! un_canonical_binders(remaining) {
              (
                , .(binder: Canonical_binder, rest: Canonical_binders) {
                    match! Canonical_binder.get(binder) {
                      .(key: I32, stars: I32) {
                        match! canonical_render_binding_find(bindings, key) {
                          (
                            , .(alpha: I32) {
                                let piece =
                                  string_concat(
                                    , "["(String)
                                    , string_concat(
                                        , star_run(stars)
                                        , string_concat(
                                            , "#"(String)
                                            , string_concat(int_to_string(alpha), "]"(String))
                                            )
                                        )
                                    );
                                widen_sum!(
                                  , (
                                      , rest
                                      , (
                                          , if! first {
                                              piece
                                            } else {
                                              string_concat(acc, string_concat(" "(String), piece))
                                            }
                                          , .f(Bool)
                                          )
                                      )
                                  , (Canonical_binders & String & Bool) | String | Diag
                                  )
                              }
                            , .(_missing: .) {
                                widen_sum!(
                                  , canonical_parse_diag("internal canonical renderer could not resolve a binder declaration"(String))
                                  , (Canonical_binders & String & Bool) | String | Diag
                                  )
                              }
                            )
                        }
                      }
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(acc, (Canonical_binders & String & Bool) | String | Diag)
                  }
                )
            }
          }
        }
      }
    , (bs, (""(String), .t(Bool)))
    )
}

labels { cr_visit: Canonical_render };

labels { cr_restore: Canonical_render_bindings };

type Canonical_render_task = Cr_visit | Cr_restore;

labels { canonical_render_tasks: List(Canonical_render_task) };

fn canonical_render_tasks_nil() -> Canonical_render_tasks {
  {canonical_render_tasks = nil(Canonical_render_task, ())}
}

fn canonical_render_tasks_cons(head: Canonical_render_task, rest: Canonical_render_tasks) -> Canonical_render_tasks {
  {canonical_render_tasks = cons(Canonical_render_task, head, Canonical_render_tasks.get(rest))}
}

fn canonical_render_visit(render: Canonical_render) -> Canonical_render_task {
  widen_sum!({cr_visit = render}, Canonical_render_task)
}

fn canonical_render_restore(bindings: Canonical_render_bindings) -> Canonical_render_task {
  widen_sum!({cr_restore = bindings}, Canonical_render_task)
}

fn un_canonical_render_tasks(tasks: Canonical_render_tasks) ->
  . | (Canonical_render_task & Canonical_render_tasks)
   {
  match! uncons(Canonical_render_task, Canonical_render_tasks.get(tasks)) {
    (
      , .(head: Canonical_render_task, tail: List(Canonical_render_task)) {
          widen_sum!(
            , (head, {canonical_render_tasks = tail})
            , . | (Canonical_render_task & Canonical_render_tasks)
            )
        }
      , .(_empty: .) { widen_sum!((), . | (Canonical_render_task & Canonical_render_tasks)) }
      )
  }
}

fn canonical_fragments_text(reversed: Pnames) -> String {
  loop(
    , .(state: Pnames & String) {
        match! state {
          .(remaining: Pnames, acc: String) {
            match! un_pnames(remaining) {
              (
                , .(fragment: String, rest: Pnames) {
                    widen_sum!((rest, string_concat(fragment, acc)), (Pnames & String) | String)
                  }
                , .(_empty: .) { widen_sum!(acc, (Pnames & String) | String) }
                )
            }
          }
        }
      }
    , (reversed, ""(String))
    )
}

labels { canonical_render_state: Canonical_render_tasks & Canonical_render_bindings & I32 & Pnames };

labels { canonical_rendered: String };

type Canonical_render_result = Canonical_render_state | Canonical_rendered | Diag;

fn render_canonical_type(render: Canonical_render) -> String | Diag {
  let loop_result =
    loop(
      , .(state: Canonical_render_state) {
          match! Canonical_render_state.get(state) {
            .(
              , tasks: Canonical_render_tasks
              , bindings: Canonical_render_bindings
              , next_alpha: I32
              , fragments: Pnames
              ) {
              match! un_canonical_render_tasks(tasks) {
                (
                  , .(task: Canonical_render_task, rest: Canonical_render_tasks) {
                      match! task {
                        (
                          , .(visit: Cr_visit) {
                              match! canonical_render_node(Cr_visit.get(visit)) {
                                (
                                  , .(text: Cr_text) {
                                      widen_sum!(
                                        , {canonical_render_state = (
                                            , rest
                                            , (
                                                , bindings
                                                , (
                                                    , next_alpha
                                                    , pnames_cons(Cr_text.get(text), fragments)
                                                    )
                                                )
                                            )}
                                        , Canonical_render_result
                                        )
                                    }
                                  , .(bound: Cr_bound_ref) {
                                      match! canonical_render_binding_find(
                                        , bindings
                                        , Cr_bound_ref.get(bound)
                                        ) {
                                        (
                                          , .(alpha: I32) {
                                              widen_sum!(
                                                , {canonical_render_state = (
                                                    , rest
                                                    , (
                                                        , bindings
                                                        , (
                                                            , next_alpha
                                                            , pnames_cons(
                                                                , string_concat(
                                                                    , "#"(String)
                                                                    , int_to_string(alpha)
                                                                    )
                                                                , fragments
                                                                )
                                                            )
                                                        )
                                                    )}
                                                , Canonical_render_result
                                                )
                                            }
                                          , .(_missing: .) {
                                              widen_sum!(
                                                , canonical_parse_diag("internal canonical renderer could not resolve a bound reference"(String))
                                                , Canonical_render_result
                                                )
                                            }
                                          )
                                      }
                                    }
                                  , .(group: Cr_binder_group) {
                                      match! canonical_binder_group_text(
                                        , Cr_binder_group.get(group)
                                        , bindings
                                        ) {
                                        (
                                          , .(text: String) {
                                              widen_sum!(
                                                , {canonical_render_state = (
                                                    , rest
                                                    , (
                                                        , bindings
                                                        , (next_alpha, pnames_cons(text, fragments))
                                                        )
                                                    )}
                                                , Canonical_render_result
                                                )
                                            }
                                          , .(diag: Diag) {
                                              widen_sum!(diag, Canonical_render_result)
                                            }
                                          )
                                      }
                                    }
                                  , .(concat: Cr_concat) {
                                      match! Cr_concat.get(concat) {
                                        .(left: Canonical_render, right: Canonical_render) {
                                          widen_sum!(
                                            , {canonical_render_state = (
                                                , canonical_render_tasks_cons(
                                                    , canonical_render_visit(left)
                                                    , canonical_render_tasks_cons(
                                                        , canonical_render_visit(right)
                                                        , rest
                                                        )
                                                    )
                                                , (bindings, (next_alpha, fragments))
                                                )}
                                            , Canonical_render_result
                                            )
                                        }
                                      }
                                    }
                                  , .(scope: Cr_scope) {
                                      match! Cr_scope.get(scope) {
                                        .(bs: Canonical_binders, body: Canonical_render) {
                                          match! Canonical_scope_bindings.get(extend_canonical_render_bindings(
                                            , bs
                                            , bindings
                                            , next_alpha
                                            )) {
                                            .(extended: Canonical_render_bindings, next: I32) {
                                              widen_sum!(
                                                , {canonical_render_state = (
                                                    , canonical_render_tasks_cons(
                                                        , canonical_render_visit(body)
                                                        , canonical_render_tasks_cons(
                                                            , canonical_render_restore(bindings)
                                                            , rest
                                                            )
                                                        )
                                                    , (extended, (next, fragments))
                                                    )}
                                                , Canonical_render_result
                                                )
                                            }
                                          }
                                        }
                                      }
                                    }
                                  )
                              }
                            }
                          , .(restore: Cr_restore) {
                              widen_sum!(
                                , {canonical_render_state = (
                                    , rest
                                    , (Cr_restore.get(restore), (next_alpha, fragments))
                                    )}
                                , Canonical_render_result
                                )
                            }
                          )
                      }
                    }
                  , .(_empty: .) {
                      widen_sum!(
                        , {canonical_rendered = canonical_fragments_text(fragments)}
                        , Canonical_render_result
                        )
                    }
                  )
              }
            }
          }
        }
      , {canonical_render_state = (
          , canonical_render_tasks_cons(
              , canonical_render_visit(render)
              , canonical_render_tasks_nil()
              )
          , (canonical_render_bindings_nil(), (0(I32), pnames_nil()))
          )}
      );
  match! loop_result {
    (
      , .(rendered: Canonical_rendered) {
          widen_sum!(Canonical_rendered.get(rendered), String | Diag)
        }
      , .(diag: Diag) { widen_sum!(diag, String | Diag) }
      )
  }
}

// An exact two-component-key map used by the loader's transient resolution
// indexes. The artifact language has no privileged mutable dictionary; this
// persistent trie derives solely from the parsed image. A lookup/update
// advances through each identifier byte once and scans only the fixed ASCII
// identifier alphabet at each level. The negative codes are structural
// separators and cannot collide with `string_code_at` output.
rec labels { exact_key_trie[A]: I32 & (. | A) & List(Exact_key_trie(A)) };

type Exact_key_catalog[A] = List(Exact_key_trie(A));

fn exact_key_catalog_nil[A]() -> Exact_key_catalog(A) { nil(Exact_key_trie(A), ()) }

fn exact_key_trie_code[A](node: Exact_key_trie(A)) -> I32 {
  match! Exact_key_trie.get(node) {
    .(code: I32, _value: . | A, _children: List(Exact_key_trie(A))) { code }
  }
}

fn exact_key_trie_value[A](node: Exact_key_trie(A)) -> . | A {
  match! Exact_key_trie.get(node) {
    .(_code: I32, value: . | A, _children: List(Exact_key_trie(A))) { value }
  }
}

fn exact_key_trie_children[A](node: Exact_key_trie(A)) -> Exact_key_catalog(A) {
  match! Exact_key_trie.get(node) {
    .(_code: I32, _value: . | A, children: List(Exact_key_trie(A))) { children }
  }
}

fn exact_key_trie_node[A](code: I32, value: . | A, children: Exact_key_catalog(A)) -> Exact_key_trie(A) {
  {exact_key_trie = (code, (value, children))}
}

fn exact_key_catalog_child[A](catalog: Exact_key_catalog(A), code: I32) -> . | Exact_key_trie(A) {
  loop(
    , .(remaining: Exact_key_catalog(A)) {
        match! uncons(Exact_key_trie(A), remaining) {
          (
            , .(node: Exact_key_trie(A), rest: Exact_key_catalog(A)) {
                if! eq_i32(exact_key_trie_code(node), code) {
                  widen_sum!(
                    , widen_sum!(node, . | Exact_key_trie(A))
                    , Exact_key_catalog(A) | . | Exact_key_trie(A)
                    )
                } else {
                  widen_sum!(rest, Exact_key_catalog(A) | . | Exact_key_trie(A))
                }
              }
            , .(_empty: .) {
                widen_sum!(
                  , widen_sum!((), . | Exact_key_trie(A))
                  , Exact_key_catalog(A) | . | Exact_key_trie(A)
                  )
              }
            )
        }
      }
    , catalog
    )
}

fn exact_key_catalog_without_code[A](catalog: Exact_key_catalog(A), code: I32) -> Exact_key_catalog(A) {
  loop(
    , .(state: Exact_key_catalog(A) & Exact_key_catalog(A)) {
        match! state {
          .(remaining: Exact_key_catalog(A), kept: Exact_key_catalog(A)) {
            match! uncons(Exact_key_trie(A), remaining) {
              (
                , .(node: Exact_key_trie(A), rest: Exact_key_catalog(A)) {
                    let next =
                      if! eq_i32(exact_key_trie_code(node), code) {
                        kept
                      } else {
                        cons(Exact_key_trie(A), node, kept)
                      };
                    widen_sum!(
                      , (rest, next)
                      , (Exact_key_catalog(A) & Exact_key_catalog(A)) | Exact_key_catalog(A)
                      )
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , kept
                      , (Exact_key_catalog(A) & Exact_key_catalog(A)) | Exact_key_catalog(A)
                      )
                  }
                )
            }
          }
        }
      }
    , (catalog, exact_key_catalog_nil(A, ()))
    )
}

fn exact_key_code(owner: String, name: String, pos: I32) -> I32 {
  let owner_len = string_len(owner);
  if! lt_i32(pos, owner_len) {
    match! string_code_at(owner, pos) {
      (.(code: I32) { code }, .(_outside: .) { -3(I32) })
    }
  } else if! eq_i32(pos, owner_len) {
    -1(I32)
  } else {
    let name_pos = sub_i32(sub_i32(pos, owner_len), 1(I32));
    let name_len = string_len(name);
    if! lt_i32(name_pos, name_len) {
      match! string_code_at(name, name_pos) {
        (.(code: I32) { code }, .(_outside: .) { -3(I32) })
      }
    } else {
      -2(I32)
    }
  }
}

labels { exact_key_trie_frame[A]: I32 & (. | A) & Exact_key_catalog(A) };

type Exact_key_trie_frames[A] = List(Exact_key_trie_frame(A));

fn exact_key_trie_frame_code[A](frame: Exact_key_trie_frame(A)) -> I32 {
  match! Exact_key_trie_frame.get(frame) {
    .(code: I32, _value: . | A, _siblings: Exact_key_catalog(A)) { code }
  }
}

fn exact_key_trie_frame_value[A](frame: Exact_key_trie_frame(A)) -> . | A {
  match! Exact_key_trie_frame.get(frame) {
    .(_code: I32, value: . | A, _siblings: Exact_key_catalog(A)) { value }
  }
}

fn exact_key_trie_frame_siblings[A](frame: Exact_key_trie_frame(A)) -> Exact_key_catalog(A) {
  match! Exact_key_trie_frame.get(frame) {
    .(_code: I32, _value: . | A, siblings: Exact_key_catalog(A)) { siblings }
  }
}

fn exact_key_catalog_insert[A](catalog: Exact_key_catalog(A), owner: String, name: String, value: A) -> Exact_key_catalog(A) {
  let reached =
    loop(
      , .(state: Exact_key_catalog(A) & I32 & Exact_key_trie_frames(A)) {
          match! state {
            .(siblings: Exact_key_catalog(A), pos: I32, frames: Exact_key_trie_frames(A)) {
              let code = exact_key_code(owner, name, pos);
              let prior = exact_key_catalog_child(siblings, code);
              let children =
                match! prior {
                  (
                    , .(node: Exact_key_trie(A)) { exact_key_trie_children(node) }
                    , .(_missing: .) { exact_key_catalog_nil(A, ()) }
                    )
                };
              let old_value =
                match! prior {
                  (
                    , .(node: Exact_key_trie(A)) { exact_key_trie_value(node) }
                    , .(_missing: .) { widen_sum!((), . | A) }
                    )
                };
              let other_siblings = exact_key_catalog_without_code(siblings, code);
              if! eq_i32(code, -2(I32)) {
                let terminal = cons(
                  , Exact_key_trie(A)
                  , exact_key_trie_node(code, widen_sum!(value, . | A), children)
                  , other_siblings
                  );
                widen_sum!(
                  , (frames, terminal)
                  , (| (Exact_key_catalog(A) & I32 & Exact_key_trie_frames(A))
                    | (Exact_key_trie_frames(A) & Exact_key_catalog(A)))
                  )
              } else {
                let frame = {exact_key_trie_frame = (code, (old_value, other_siblings))};
                widen_sum!(
                  , (children, add_i32(pos, 1(I32)), cons(Exact_key_trie_frame(A), frame, frames))
                  , (| (Exact_key_catalog(A) & I32 & Exact_key_trie_frames(A))
                    | (Exact_key_trie_frames(A) & Exact_key_catalog(A)))
                  )
              }
            }
          }
        }
      , (catalog, (0(I32), nil(Exact_key_trie_frame(A), ())))
      );
  match! reached {
    .(frames: Exact_key_trie_frames(A), leaf: Exact_key_catalog(A)) {
      loop(
        , .(state: Exact_key_trie_frames(A) & Exact_key_catalog(A)) {
            match! state {
              .(remaining: Exact_key_trie_frames(A), child: Exact_key_catalog(A)) {
                match! uncons(Exact_key_trie_frame(A), remaining) {
                  (
                    , .(frame: Exact_key_trie_frame(A), rest: Exact_key_trie_frames(A)) {
                        let parent =
                          cons(
                            , Exact_key_trie(A)
                            , exact_key_trie_node(
                                , exact_key_trie_frame_code(frame)
                                , exact_key_trie_frame_value(frame)
                                , child
                                )
                            , exact_key_trie_frame_siblings(frame)
                            );
                        widen_sum!(
                          , (rest, parent)
                          , (Exact_key_trie_frames(A) & Exact_key_catalog(A)) | Exact_key_catalog(A)
                          )
                      }
                    , .(_empty: .) {
                        widen_sum!(
                          , child
                          , (Exact_key_trie_frames(A) & Exact_key_catalog(A)) | Exact_key_catalog(A)
                          )
                      }
                    )
                }
              }
            }
          }
        , (frames, leaf)
        )
    }
  }
}

fn exact_key_catalog_find[A](catalog: Exact_key_catalog(A), owner: String, name: String) -> . | A {
  loop(
    , .(state: Exact_key_catalog(A) & I32) {
        match! state {
          .(siblings: Exact_key_catalog(A), pos: I32) {
            let code = exact_key_code(owner, name, pos);
            match! exact_key_catalog_child(siblings, code) {
              (
                , .(node: Exact_key_trie(A)) {
                    if! eq_i32(code, -2(I32)) {
                      widen_sum!(exact_key_trie_value(node), (Exact_key_catalog(A) & I32) | . | A)
                    } else {
                      widen_sum!(
                        , (exact_key_trie_children(node), add_i32(pos, 1(I32)))
                        , (Exact_key_catalog(A) & I32) | . | A
                        )
                    }
                  }
                , .(_missing: .) {
                    widen_sum!(widen_sum!((), . | A), (Exact_key_catalog(A) & I32) | . | A)
                  }
                )
            }
          }
        }
      }
    , (catalog, 0(I32))
    )
}

// One exact declaration/import fact indexed by `(module, local spelling)`.
// Keeping the original records lets the ordinary resolver remain the sole
// authority for visibility, source order, recursive scope, and ambiguity;
// the index only replaces repeated whole-module list scans.
labels { exact_type_module_fact: Module };

labels { exact_type_alias_fact: Alias_decl };

labels { exact_type_member_fact: Member_decl };

labels { exact_type_host_fact: Host_header };

labels { exact_type_import_fact: Import };

labels { exact_type_qualifier_fact: Mod_alias };

type Exact_type_fact =
  | Exact_type_module_fact
  | Exact_type_alias_fact
  | Exact_type_member_fact
  | Exact_type_host_fact
  | Exact_type_import_fact
  | Exact_type_qualifier_fact
  ;

type Exact_type_facts = List(Exact_type_fact);

type Exact_type_index = Exact_key_catalog(Exact_type_facts);

fn exact_type_index_nil() -> Exact_type_index { exact_key_catalog_nil(Exact_type_facts, ()) }

fn exact_type_index_facts(index: Exact_type_index, owner: String, name: String) -> Exact_type_facts {
  let .(found: . | Exact_type_facts) = exact_key_catalog_find(index, owner, name);
  match! found {
    (.(facts: Exact_type_facts) { facts }, .(_missing: .) { nil(Exact_type_fact, ()) })
  }
}

fn exact_type_index_add(index: Exact_type_index, owner: String, name: String, fact: Exact_type_fact) -> Exact_type_index {
  exact_key_catalog_insert(
    , index
    , owner
    , name
    , cons(Exact_type_fact, fact, exact_type_index_facts(index, owner, name))
    )
}

fn exact_type_index_add_aliases(index: Exact_type_index, owner: String, aliases: Tyaliases) -> Exact_type_index {
  loop(
    , .(state: Tyaliases & Exact_type_index) {
        match! state {
          .(remaining: Tyaliases, out: Exact_type_index) {
            match! un_tyaliases(remaining) {
              (
                , .(alias: Alias_decl, rest: Tyaliases) {
                    widen_sum!(
                      , (
                          , rest
                          , exact_type_index_add(
                              , out
                              , owner
                              , tyalias_name(alias)
                              , widen_sum!({exact_type_alias_fact = alias}, Exact_type_fact)
                              )
                          )
                      , (Tyaliases & Exact_type_index) | Exact_type_index
                      )
                  }
                , .(_empty: .) {
                    widen_sum!(out, (Tyaliases & Exact_type_index) | Exact_type_index)
                  }
                )
            }
          }
        }
      }
    , (aliases, index)
    )
}

fn exact_type_index_add_members(index: Exact_type_index, owner: String, members: Members) -> Exact_type_index {
  loop(
    , .(state: Members & Exact_type_index) {
        match! state {
          .(remaining: Members, out: Exact_type_index) {
            match! un_members(remaining) {
              (
                , .(member: Member_decl, rest: Members) {
                    widen_sum!(
                      , (
                          , rest
                          , exact_type_index_add(
                              , out
                              , owner
                              , member_name(member)
                              , widen_sum!({exact_type_member_fact = member}, Exact_type_fact)
                              )
                          )
                      , (Members & Exact_type_index) | Exact_type_index
                      )
                  }
                , .(_empty: .) { widen_sum!(out, (Members & Exact_type_index) | Exact_type_index) }
                )
            }
          }
        }
      }
    , (members, index)
    )
}

fn exact_type_index_add_host_headers(index: Exact_type_index, owner: String, headers: Host_headers) -> Exact_type_index {
  loop(
    , .(state: Host_headers & Exact_type_index) {
        match! state {
          .(remaining: Host_headers, out: Exact_type_index) {
            match! un_host_headers(remaining) {
              (
                , .(header: Host_header, rest: Host_headers) {
                    widen_sum!(
                      , (
                          , rest
                          , exact_type_index_add(
                              , out
                              , owner
                              , host_header_name(header)
                              , widen_sum!({exact_type_host_fact = header}, Exact_type_fact)
                              )
                          )
                      , (Host_headers & Exact_type_index) | Exact_type_index
                      )
                  }
                , .(_empty: .) {
                    widen_sum!(out, (Host_headers & Exact_type_index) | Exact_type_index)
                  }
                )
            }
          }
        }
      }
    , (headers, index)
    )
}

fn exact_type_index_add_imports(index: Exact_type_index, owner: String, imports: Imports) -> Exact_type_index {
  loop(
    , .(state: Imports & Exact_type_index) {
        match! state {
          .(remaining: Imports, out: Exact_type_index) {
            match! un_imports(remaining) {
              (
                , .(one: Import, rest: Imports) {
                    match! un_import(one) {
                      .(name: String, _provider: String) {
                        widen_sum!(
                          , (
                              , rest
                              , exact_type_index_add(
                                  , out
                                  , owner
                                  , name
                                  , widen_sum!({exact_type_import_fact = one}, Exact_type_fact)
                                  )
                              )
                          , (Imports & Exact_type_index) | Exact_type_index
                          )
                      }
                    }
                  }
                , .(_empty: .) { widen_sum!(out, (Imports & Exact_type_index) | Exact_type_index) }
                )
            }
          }
        }
      }
    , (imports, index)
    )
}

fn exact_type_index_add_qualifiers(index: Exact_type_index, owner: String, aliases: Aliases) -> Exact_type_index {
  loop(
    , .(state: Aliases & Exact_type_index) {
        match! state {
          .(remaining: Aliases, out: Exact_type_index) {
            match! un_aliases(remaining) {
              (
                , .(alias: Mod_alias, rest: Aliases) {
                    widen_sum!(
                      , (
                          , rest
                          , exact_type_index_add(
                              , out
                              , owner
                              , alias_name(alias)
                              , widen_sum!({exact_type_qualifier_fact = alias}, Exact_type_fact)
                              )
                          )
                      , (Aliases & Exact_type_index) | Exact_type_index
                      )
                  }
                , .(_empty: .) { widen_sum!(out, (Aliases & Exact_type_index) | Exact_type_index) }
                )
            }
          }
        }
      }
    , (aliases, index)
    )
}

fn exact_type_index_add_module(index: Exact_type_index, module: Module) -> Exact_type_index {
  let owner = module_name(module);
  let with_module =
    exact_type_index_add(
      , index
      , owner
      , ""(String)
      , widen_sum!({exact_type_module_fact = module}, Exact_type_fact)
      );
  let with_aliases = exact_type_index_add_aliases(with_module, owner, module_tyaliases(module));
  let with_members = exact_type_index_add_members(with_aliases, owner, module_members(module));
  let with_hosts =
    exact_type_index_add_host_headers(with_members, owner, module_host_headers(module));
  let with_imports = exact_type_index_add_imports(with_hosts, owner, module_imports(module));
  exact_type_index_add_qualifiers(with_imports, owner, module_aliases(module))
}

fn exact_type_index_for_modules(modules: Modules) -> Exact_type_index {
  loop(
    , .(state: Modules & Exact_type_index) {
        match! state {
          .(remaining: Modules, out: Exact_type_index) {
            match! un_modules(remaining) {
              (
                , .(module: Module, rest: Modules) {
                    widen_sum!(
                      , (rest, exact_type_index_add_module(out, module))
                      , (Modules & Exact_type_index) | Exact_type_index
                      )
                  }
                , .(_empty: .) { widen_sum!(out, (Modules & Exact_type_index) | Exact_type_index) }
                )
            }
          }
        }
      }
    , (modules, exact_type_index_nil())
    )
}

fn exact_type_facts_collect[A](facts: Exact_type_facts, select: Exact_type_fact -> . | A) -> List(A) {
  loop(
    , .(state: Exact_type_facts & List(A)) {
        match! state {
          .(remaining: Exact_type_facts, out: List(A)) {
            match! uncons(Exact_type_fact, remaining) {
              (
                , .(fact: Exact_type_fact, rest: Exact_type_facts) {
                    match! select(fact) {
                      (
                        , .(value: A) {
                            widen_sum!(
                              , (rest, cons(A, value, out))
                              , (Exact_type_facts & List(A)) | List(A)
                              )
                          }
                        , .(_skip: .) {
                            widen_sum!((rest, out), (Exact_type_facts & List(A)) | List(A))
                          }
                        )
                    }
                  }
                , .(_empty: .) { widen_sum!(out, (Exact_type_facts & List(A)) | List(A)) }
                )
            }
          }
        }
      }
    , (facts, nil(A, ()))
    )
}

fn exact_type_index_module(index: Exact_type_index, owner: String) -> . | Module {
  let modules =
    exact_type_facts_collect(
      , Module
      , exact_type_index_facts(index, owner, ""(String))
      , .(fact: Exact_type_fact) {
          match! fact {
            (
              , .(one: Exact_type_module_fact) {
                  widen_sum!(Exact_type_module_fact.get(one), . | Module)
                }
              , .(_one: Exact_type_alias_fact) { widen_sum!((), . | Module) }
              , .(_one: Exact_type_member_fact) { widen_sum!((), . | Module) }
              , .(_one: Exact_type_host_fact) { widen_sum!((), . | Module) }
              , .(_one: Exact_type_import_fact) { widen_sum!((), . | Module) }
              , .(_one: Exact_type_qualifier_fact) { widen_sum!((), . | Module) }
              )
          }
        }
      );
  match! uncons(Module, modules) {
    (
      , .(module: Module, _rest: List(Module)) { widen_sum!(module, . | Module) }
      , .(_none: .) { widen_sum!((), . | Module) }
      )
  }
}

fn exact_type_index_aliases(index: Exact_type_index, owner: String, name: String) -> Tyaliases {
  {tyaliases = exact_type_facts_collect(
    , Alias_decl
    , exact_type_index_facts(index, owner, name)
    , .(fact: Exact_type_fact) {
        match! fact {
          (
            , .(_one: Exact_type_module_fact) { widen_sum!((), . | Alias_decl) }
            , .(one: Exact_type_alias_fact) {
                widen_sum!(Exact_type_alias_fact.get(one), . | Alias_decl)
              }
            , .(_one: Exact_type_member_fact) { widen_sum!((), . | Alias_decl) }
            , .(_one: Exact_type_host_fact) { widen_sum!((), . | Alias_decl) }
            , .(_one: Exact_type_import_fact) { widen_sum!((), . | Alias_decl) }
            , .(_one: Exact_type_qualifier_fact) { widen_sum!((), . | Alias_decl) }
            )
        }
      }
    )}
}

fn exact_type_index_members(index: Exact_type_index, owner: String, name: String) -> Members {
  {members = exact_type_facts_collect(
    , Member_decl
    , exact_type_index_facts(index, owner, name)
    , .(fact: Exact_type_fact) {
        match! fact {
          (
            , .(_one: Exact_type_module_fact) { widen_sum!((), . | Member_decl) }
            , .(_one: Exact_type_alias_fact) { widen_sum!((), . | Member_decl) }
            , .(one: Exact_type_member_fact) {
                widen_sum!(Exact_type_member_fact.get(one), . | Member_decl)
              }
            , .(_one: Exact_type_host_fact) { widen_sum!((), . | Member_decl) }
            , .(_one: Exact_type_import_fact) { widen_sum!((), . | Member_decl) }
            , .(_one: Exact_type_qualifier_fact) { widen_sum!((), . | Member_decl) }
            )
        }
      }
    )}
}

fn exact_type_index_host_headers(index: Exact_type_index, owner: String, name: String) -> Host_headers {
  {host_headers = exact_type_facts_collect(
    , Host_header
    , exact_type_index_facts(index, owner, name)
    , .(fact: Exact_type_fact) {
        match! fact {
          (
            , .(_one: Exact_type_module_fact) { widen_sum!((), . | Host_header) }
            , .(_one: Exact_type_alias_fact) { widen_sum!((), . | Host_header) }
            , .(_one: Exact_type_member_fact) { widen_sum!((), . | Host_header) }
            , .(one: Exact_type_host_fact) {
                widen_sum!(Exact_type_host_fact.get(one), . | Host_header)
              }
            , .(_one: Exact_type_import_fact) { widen_sum!((), . | Host_header) }
            , .(_one: Exact_type_qualifier_fact) { widen_sum!((), . | Host_header) }
            )
        }
      }
    )}
}

fn exact_type_index_imports(index: Exact_type_index, owner: String, name: String) -> Imports {
  {imports = exact_type_facts_collect(
    , Import
    , exact_type_index_facts(index, owner, name)
    , .(fact: Exact_type_fact) {
        match! fact {
          (
            , .(_one: Exact_type_module_fact) { widen_sum!((), . | Import) }
            , .(_one: Exact_type_alias_fact) { widen_sum!((), . | Import) }
            , .(_one: Exact_type_member_fact) { widen_sum!((), . | Import) }
            , .(_one: Exact_type_host_fact) { widen_sum!((), . | Import) }
            , .(one: Exact_type_import_fact) {
                widen_sum!(Exact_type_import_fact.get(one), . | Import)
              }
            , .(_one: Exact_type_qualifier_fact) { widen_sum!((), . | Import) }
            )
        }
      }
    )}
}

fn exact_type_index_qualifiers(index: Exact_type_index, owner: String, name: String) -> Aliases {
  {aliases = exact_type_facts_collect(
    , Mod_alias
    , exact_type_index_facts(index, owner, name)
    , .(fact: Exact_type_fact) {
        match! fact {
          (
            , .(_one: Exact_type_module_fact) { widen_sum!((), . | Mod_alias) }
            , .(_one: Exact_type_alias_fact) { widen_sum!((), . | Mod_alias) }
            , .(_one: Exact_type_member_fact) { widen_sum!((), . | Mod_alias) }
            , .(_one: Exact_type_host_fact) { widen_sum!((), . | Mod_alias) }
            , .(_one: Exact_type_import_fact) { widen_sum!((), . | Mod_alias) }
            , .(one: Exact_type_qualifier_fact) {
                widen_sum!(Exact_type_qualifier_fact.get(one), . | Mod_alias)
              }
            )
        }
      }
    )}
}

// A type resolver is anchored in one declaring module and retains the source
// position used by declaration-specific lookup. An explicit recursive-data
// scope admits only declarations carrying the same marker identity; unrelated
// later declarations remain invisible, so adding one cannot retarget an
// existing signature. `host_types` contains exact descriptors from retained
// package declarations.
labels { type_context: & Modules
& Host_types
& Module
& I32
& (. | Recursive_type_scope)
& (. | Exact_type_index) };

fn mk_type_context_with_index(
  , modules: Modules
  , host_types: Host_types
  , module: Module
  , alias_cutoff: I32
  , recursive_scope: . | Recursive_type_scope
  , index: . | Exact_type_index
  ) -> Type_context {
  {type_context = (modules, (host_types, (module, (alias_cutoff, (recursive_scope, index)))))}
}

fn mk_type_context(
  , modules: Modules
  , host_types: Host_types
  , module: Module
  , alias_cutoff: I32
  , recursive_scope: . | Recursive_type_scope
  ) -> Type_context {
  mk_type_context_with_index(
    , modules
    , host_types
    , module
    , alias_cutoff
    , recursive_scope
    , widen_sum!((), . | Exact_type_index)
    )
}

fn mk_indexed_type_context(
  , modules: Modules
  , host_types: Host_types
  , module: Module
  , alias_cutoff: I32
  , recursive_scope: . | Recursive_type_scope
  , index: Exact_type_index
  ) -> Type_context {
  mk_type_context_with_index(
    , modules
    , host_types
    , module
    , alias_cutoff
    , recursive_scope
    , widen_sum!(index, . | Exact_type_index)
    )
}

fn type_context_modules(context: Type_context) -> Modules {
  match! Type_context.get(context) {
    .(
      , modules: Modules
      , _types: Host_types
      , _module: Module
      , _cutoff: I32
      , _recursive_scope: . | Recursive_type_scope
      , _index: . | Exact_type_index
      ) { modules }
  }
}

fn type_context_host_types(context: Type_context) -> Host_types {
  match! Type_context.get(context) {
    .(
      , _modules: Modules
      , types: Host_types
      , _module: Module
      , _cutoff: I32
      , _recursive_scope: . | Recursive_type_scope
      , _index: . | Exact_type_index
      ) { types }
  }
}

fn type_context_module(context: Type_context) -> Module {
  match! Type_context.get(context) {
    .(
      , _modules: Modules
      , _types: Host_types
      , module: Module
      , _cutoff: I32
      , _recursive_scope: . | Recursive_type_scope
      , _index: . | Exact_type_index
      ) { module }
  }
}

fn type_context_alias_cutoff(context: Type_context) -> I32 {
  match! Type_context.get(context) {
    .(
      , _modules: Modules
      , _types: Host_types
      , _module: Module
      , cutoff: I32
      , _recursive_scope: . | Recursive_type_scope
      , _index: . | Exact_type_index
      ) { cutoff }
  }
}

fn type_context_recursive_scope(context: Type_context) -> . | Recursive_type_scope {
  match! Type_context.get(context) {
    .(
      , _modules: Modules
      , _types: Host_types
      , _module: Module
      , _cutoff: I32
      , recursive_scope: . | Recursive_type_scope
      , _index: . | Exact_type_index
      ) { recursive_scope }
  }
}

fn type_context_exact_index(context: Type_context) -> . | Exact_type_index {
  match! Type_context.get(context) {
    .(
      , _modules: Modules
      , _types: Host_types
      , _module: Module
      , _cutoff: I32
      , _recursive_scope: . | Recursive_type_scope
      , index: . | Exact_type_index
      ) { index }
  }
}

fn type_context_for_alias(context: Type_context, module: Module, alias: Alias_decl) -> Type_context {
  mk_type_context_with_index(
    , type_context_modules(context)
    , type_context_host_types(context)
    , module
    , tyalias_decl_pos(alias)
    , tyalias_recursive_scope(alias)
    , type_context_exact_index(context)
    )
}

fn type_context_find_module(context: Type_context, owner: String) -> . | Module {
  match! type_context_exact_index(context) {
    (
      , .(index: Exact_type_index) { exact_type_index_module(index, owner) }
      , .(_unindexed: .) { find_module(type_context_modules(context), owner) }
      )
  }
}

fn type_context_aliases(context: Type_context, module: Module, name: String) -> Tyaliases {
  match! type_context_exact_index(context) {
    (
      , .(index: Exact_type_index) { exact_type_index_aliases(index, module_name(module), name) }
      , .(_unindexed: .) { module_tyaliases(module) }
      )
  }
}

fn type_context_members(context: Type_context, module: Module, name: String) -> Members {
  match! type_context_exact_index(context) {
    (
      , .(index: Exact_type_index) { exact_type_index_members(index, module_name(module), name) }
      , .(_unindexed: .) { module_members(module) }
      )
  }
}

fn type_context_host_headers(context: Type_context, module: Module, name: String) -> Host_headers {
  match! type_context_exact_index(context) {
    (
      , .(index: Exact_type_index) {
          exact_type_index_host_headers(index, module_name(module), name)
        }
      , .(_unindexed: .) { module_host_headers(module) }
      )
  }
}

fn type_context_imports(context: Type_context, name: String) -> Imports {
  let module = type_context_module(context);
  match! type_context_exact_index(context) {
    (
      , .(index: Exact_type_index) { exact_type_index_imports(index, module_name(module), name) }
      , .(_unindexed: .) { module_imports(module) }
      )
  }
}

fn type_context_qualifiers(context: Type_context, name: String) -> Aliases {
  let module = type_context_module(context);
  match! type_context_exact_index(context) {
    (
      , .(index: Exact_type_index) { exact_type_index_qualifiers(index, module_name(module), name) }
      , .(_unindexed: .) { module_aliases(module) }
      )
  }
}

// One lexical type binder and its monotonic construction key.
labels { type_bound: String & I32 & Param_kind };

labels { type_bounds: List(Type_bound) };

fn type_bounds_nil() -> Type_bounds { {type_bounds = nil(Type_bound, ())} }

fn type_bounds_cons(name: String, index: I32, kind: Param_kind, rest: Type_bounds) -> Type_bounds {
  {type_bounds = cons(Type_bound, {type_bound = (name, (index, kind))}, Type_bounds.get(rest))}
}

fn type_bound_index(bounds: Type_bounds, name: String) -> . | I32 {
  loop(
    , .(remaining: Type_bounds) {
        match! uncons(Type_bound, Type_bounds.get(remaining)) {
          (
            , .(entry: Type_bound, tail: List(Type_bound)) {
                match! Type_bound.get(entry) {
                  .(candidate: String, index: I32, _kind: Param_kind) {
                    if! string_eq(candidate, name) {
                      widen_sum!(widen_sum!(index, . | I32), Type_bounds | . | I32)
                    } else {
                      widen_sum!({type_bounds = tail}, Type_bounds | . | I32)
                    }
                  }
                }
              }
            , .(_empty: .) { widen_sum!(widen_sum!((), . | I32), Type_bounds | . | I32) }
            )
        }
      }
    , bounds
    )
}

fn type_bound_kind(bounds: Type_bounds, name: String) -> . | Param_kind {
  loop(
    , .(remaining: Type_bounds) {
        match! uncons(Type_bound, Type_bounds.get(remaining)) {
          (
            , .(entry: Type_bound, tail: List(Type_bound)) {
                match! Type_bound.get(entry) {
                  .(candidate: String, _index: I32, kind: Param_kind) {
                    if! string_eq(candidate, name) {
                      widen_sum!(widen_sum!(kind, . | Param_kind), Type_bounds | . | Param_kind)
                    } else {
                      widen_sum!({type_bounds = tail}, Type_bounds | . | Param_kind)
                    }
                  }
                }
              }
            , .(_empty: .) {
                widen_sum!(widen_sum!((), . | Param_kind), Type_bounds | . | Param_kind)
              }
            )
        }
      }
    , bounds
    )
}

// Alias formals map to already-canonical caller types. Alias-body lexical
// binders are checked first and therefore shadow a same-spelled formal.
labels { type_subst: String & Canonical_type };

labels { type_substs: List(Type_subst) };

fn type_substs_nil() -> Type_substs { {type_substs = nil(Type_subst, ())} }

fn type_substs_cons(name: String, value: Canonical_type, rest: Type_substs) -> Type_substs {
  {type_substs = cons(Type_subst, {type_subst = (name, value)}, Type_substs.get(rest))}
}

fn type_subst_find(substs: Type_substs, name: String) -> . | Canonical_type {
  loop(
    , .(remaining: Type_substs) {
        match! uncons(Type_subst, Type_substs.get(remaining)) {
          (
            , .(entry: Type_subst, tail: List(Type_subst)) {
                match! Type_subst.get(entry) {
                  .(candidate: String, value: Canonical_type) {
                    if! string_eq(candidate, name) {
                      widen_sum!(
                        , widen_sum!(value, . | Canonical_type)
                        , Type_substs | . | Canonical_type
                        )
                    } else {
                      widen_sum!({type_substs = tail}, Type_substs | . | Canonical_type)
                    }
                  }
                }
              }
            , .(_empty: .) {
                widen_sum!(widen_sum!((), . | Canonical_type), Type_substs | . | Canonical_type)
              }
            )
        }
      }
    , substs
    )
}

// The exact alias-expansion stack. It prevents cycles without imposing an
// arbitrary depth limit on legal acyclic alias chains.
labels { alias_ref: String & String };

labels { alias_ref_present: . };

labels { alias_refs: List(Alias_ref) & Exact_key_catalog(Alias_ref_present) };

fn alias_refs_list(refs: Alias_refs) -> List(Alias_ref) {
  match! Alias_refs.get(refs) {
    .(entries: List(Alias_ref), _index: Exact_key_catalog(Alias_ref_present)) { entries }
  }
}

fn alias_refs_index(refs: Alias_refs) -> Exact_key_catalog(Alias_ref_present) {
  match! Alias_refs.get(refs) {
    .(_entries: List(Alias_ref), index: Exact_key_catalog(Alias_ref_present)) { index }
  }
}

fn alias_refs_with_list(refs: Alias_refs, entries: List(Alias_ref)) -> Alias_refs {
  {alias_refs = (entries, alias_refs_index(refs))}
}

fn alias_refs_nil() -> Alias_refs {
  {alias_refs = (nil(Alias_ref, ()), exact_key_catalog_nil(Alias_ref_present, ()))}
}

fn alias_refs_cons(owner: String, name: String, rest: Alias_refs) -> Alias_refs {
  {alias_refs = (
    , cons(Alias_ref, {alias_ref = (owner, name)}, alias_refs_list(rest))
    , exact_key_catalog_insert(alias_refs_index(rest), owner, name, {alias_ref_present=})
    )}
}

fn alias_refs_has(refs: Alias_refs, owner: String, name: String) -> Bool {
  let .(found: . | Alias_ref_present) = exact_key_catalog_find(alias_refs_index(refs), owner, name);
  match! found {
    (.(_present: Alias_ref_present) { .t(Bool) }, .(_missing: .) { .f(Bool) })
  }
}

fn alias_refs_insert(refs: Alias_refs, owner: String, name: String) -> Alias_refs {
  if! alias_refs_has(refs, owner, name) {
    refs
  } else {
    alias_refs_cons(owner, name, refs)
  }
}

fn alias_refs_union(left: Alias_refs, right: Alias_refs) -> Alias_refs {
  loop(
    , .(state: Alias_refs & Alias_refs) {
        match! state {
          .(remaining: Alias_refs, collected: Alias_refs) {
            match! uncons(Alias_ref, alias_refs_list(remaining)) {
              (
                , .(entry: Alias_ref, tail: List(Alias_ref)) {
                    match! Alias_ref.get(entry) {
                      .(owner: String, name: String) {
                        widen_sum!(
                          , (
                              , alias_refs_with_list(remaining, tail)
                              , alias_refs_insert(collected, owner, name)
                              )
                          , (Alias_refs & Alias_refs) | Alias_refs
                          )
                      }
                    }
                  }
                , .(_empty: .) { widen_sum!(collected, (Alias_refs & Alias_refs) | Alias_refs) }
                )
            }
          }
        }
      }
    , (left, right)
    )
}

fn alias_refs_dependencies(refs: Alias_refs) -> Type_dependencies {
  loop(
    , .(state: Alias_refs & Alias_ids) {
        match! state {
          .(remaining: Alias_refs, aliases: Alias_ids) {
            match! uncons(Alias_ref, alias_refs_list(remaining)) {
              (
                , .(entry: Alias_ref, tail: List(Alias_ref)) {
                    match! Alias_ref.get(entry) {
                      .(owner: String, name: String) {
                        widen_sum!(
                          , (
                              , alias_refs_with_list(remaining, tail)
                              , alias_ids_cons(mk_host_id(owner, name), aliases)
                              )
                          , (Alias_refs & Alias_ids) | Type_dependencies
                          )
                      }
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , mk_type_dependencies(host_types_nil(), nominal_ids_nil(), aliases)
                      , (Alias_refs & Alias_ids) | Type_dependencies
                      )
                  }
                )
            }
          }
        }
      }
    , (refs, alias_ids_nil())
    )
}

fn canonical_type_with_alias_refs(t: Canonical_type, refs: Alias_refs) -> Canonical_type {
  canonical_type_with_extra_dependencies(t, alias_refs_dependencies(refs))
}

// Resolution environment. `next_index` is monotonic across nested and sibling
// traversal; scope restoration never rolls it back.
labels { type_env: Type_context & Type_bounds & Type_substs & Alias_refs & I32 };

fn mk_type_env(
  , context: Type_context
  , bounds: Type_bounds
  , substs: Type_substs
  , aliases: Alias_refs
  , next_index: I32
  ) -> Type_env { {type_env = (context, (bounds, (substs, (aliases, next_index))))} }

fn type_env_context(env: Type_env) -> Type_context {
  match! Type_env.get(env) {
    .(
      , context: Type_context
      , _bounds: Type_bounds
      , _substs: Type_substs
      , _aliases: Alias_refs
      , _next: I32
      ) { context }
  }
}

fn type_env_bounds(env: Type_env) -> Type_bounds {
  match! Type_env.get(env) {
    .(
      , _context: Type_context
      , bounds: Type_bounds
      , _substs: Type_substs
      , _aliases: Alias_refs
      , _next: I32
      ) { bounds }
  }
}

fn type_env_substs(env: Type_env) -> Type_substs {
  match! Type_env.get(env) {
    .(
      , _context: Type_context
      , _bounds: Type_bounds
      , substs: Type_substs
      , _aliases: Alias_refs
      , _next: I32
      ) { substs }
  }
}

fn type_env_aliases(env: Type_env) -> Alias_refs {
  match! Type_env.get(env) {
    .(
      , _context: Type_context
      , _bounds: Type_bounds
      , _substs: Type_substs
      , aliases: Alias_refs
      , _next: I32
      ) { aliases }
  }
}

fn type_env_next(env: Type_env) -> I32 {
  match! Type_env.get(env) {
    .(
      , _context: Type_context
      , _bounds: Type_bounds
      , _substs: Type_substs
      , _aliases: Alias_refs
      , next: I32
      ) { next }
  }
}

fn restore_type_env(saved: Type_env, current: Type_env) -> Type_env {
  mk_type_env(
    , type_env_context(saved)
    , type_env_bounds(saved)
    , type_env_substs(saved)
    , type_env_aliases(saved)
    , type_env_next(current)
    )
}

fn type_env_with_bounds(env: Type_env, bounds: Type_bounds, next_index: I32) -> Type_env {
  mk_type_env(
    , type_env_context(env)
    , bounds
    , type_env_substs(env)
    , type_env_aliases(env)
    , next_index
    )
}

labels { canonical_binders_result: Canonical_binders & Type_env };

fn canonicalize_binders(binders: Binders, initial: Type_env) -> Canonical_binders_result {
  match! Canonical_binders_result.get(loop(
    , .(state: Binders & Canonical_binders & Type_env) {
        match! state {
          .(remaining: Binders, reversed: Canonical_binders, env: Type_env) {
            match! un_binders(remaining) {
              (
                , .(binder: Binder_info, rest: Binders) {
                    match! Binder_info.get(binder) {
                      .(name: String, stars: I32) {
                        let index = type_env_next(env);
                        let next_env =
                          type_env_with_bounds(
                            , env
                            , type_bounds_cons(
                                , name
                                , index
                                , host_param_kind(stars)
                                , type_env_bounds(env)
                                )
                            , add_i32(index, 1(I32))
                            );
                        widen_sum!(
                          , (rest, (canonical_binders_cons(index, stars, reversed), next_env))
                          , (Binders & Canonical_binders & Type_env) | Canonical_binders_result
                          )
                      }
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , {canonical_binders_result = (canonical_binders_reverse(reversed), env)}
                      , (Binders & Canonical_binders & Type_env) | Canonical_binders_result
                      )
                  }
                )
            }
          }
        }
      }
    , (binders, (canonical_binders_nil(), initial))
    )) {
    .(renamed: Canonical_binders, env: Type_env) { {canonical_binders_result = (renamed, env)} }
  }
}

labels { alias_choice_found: Alias_decl };

labels { alias_choice_conflict: . };

type Alias_choice = . | Alias_choice_found | Alias_choice_conflict;

// Find one exact alias declaration. Local lookup applies the strict source
// cutoff; imported or qualified lookup ignores the provider's source cutoff
// but still requires its visibility (plain `pub` or matching `pub(path)`) to
// admit the consumer. Duplicate selected declarations are an ambiguity, not a
// list-order choice.
fn choose_alias(
  , aliases: Tyaliases
  , name: String
  , owner: String
  , consumer: String
  , cutoff: I32
  , limit: Bool
  , recursive_scope: . | Recursive_type_scope
  ) -> Alias_choice {
  loop(
    , .(state: Tyaliases & (. | Alias_decl)) {
        match! state {
          .(remaining: Tyaliases, found: . | Alias_decl) {
            match! un_tyaliases(remaining) {
              (
                , .(candidate: Alias_decl, rest: Tyaliases) {
                    let in_order =
                      if! limit {
                        if! lt_i32(tyalias_decl_pos(candidate), cutoff) {
                          .t(Bool)
                        } else {
                          recursive_type_scopes_match(
                            , tyalias_recursive_scope(candidate)
                            , recursive_scope
                            )
                        }
                      } else {
                        .t(Bool)
                      };
                    let visible =
                      if! in_order {
                        visibility_allows(tyalias_visibility(candidate), owner, consumer)
                      } else {
                        .f(Bool)
                      };
                    if! visible {
                      if! string_eq(tyalias_name(candidate), name) {
                        match! found {
                          (
                            , .(_prior: Alias_decl) {
                                widen_sum!(
                                  , widen_sum!({alias_choice_conflict=}, Alias_choice)
                                  , (Tyaliases & (. | Alias_decl)) | Alias_choice
                                  )
                              }
                            , .(_none: .) {
                                widen_sum!(
                                  , (rest, widen_sum!(candidate, . | Alias_decl))
                                  , (Tyaliases & (. | Alias_decl)) | Alias_choice
                                  )
                              }
                            )
                        }
                      } else {
                        widen_sum!((rest, found), (Tyaliases & (. | Alias_decl)) | Alias_choice)
                      }
                    } else {
                      widen_sum!((rest, found), (Tyaliases & (. | Alias_decl)) | Alias_choice)
                    }
                  }
                , .(_empty: .) {
                    match! found {
                      (
                        , .(alias: Alias_decl) {
                            widen_sum!(
                              , widen_sum!({alias_choice_found = alias}, Alias_choice)
                              , (Tyaliases & (. | Alias_decl)) | Alias_choice
                              )
                          }
                        , .(_none: .) {
                            widen_sum!(
                              , widen_sum!((), Alias_choice)
                              , (Tyaliases & (. | Alias_decl)) | Alias_choice
                              )
                          }
                        )
                    }
                  }
                )
            }
          }
        }
      }
    , (aliases, widen_sum!((), . | Alias_decl))
    )
}

labels { exact_head_host: Host_type };

labels { exact_head_nominal: Host_id & Param_kinds };

labels { exact_head_alias: String & Alias_decl };

type Exact_type_head = Exact_head_host | Exact_head_nominal | Exact_head_alias;

fn exact_head_host(descriptor: Host_type) -> Exact_type_head {
  widen_sum!({exact_head_host = descriptor}, Exact_type_head)
}

fn exact_head_nominal(id: Host_id, params: Param_kinds) -> Exact_type_head {
  widen_sum!({exact_head_nominal = (id, params)}, Exact_type_head)
}

fn exact_head_alias(owner: String, alias: Alias_decl) -> Exact_type_head {
  widen_sum!({exact_head_alias = (owner, alias)}, Exact_type_head)
}

labels { exact_type_head_ok: Exact_type_head & Alias_refs };

labels { exact_type_head_bad: Diag };

type Exact_type_head_result = Exact_type_head_ok | Exact_type_head_bad;

fn exact_type_head_success(head: Exact_type_head) -> Exact_type_head_result {
  widen_sum!({exact_type_head_ok = (head, alias_refs_nil())}, Exact_type_head_result)
}

fn exact_type_head_success_with_aliases(head: Exact_type_head, aliases: Alias_refs) -> Exact_type_head_result {
  widen_sum!({exact_type_head_ok = (head, aliases)}, Exact_type_head_result)
}

fn exact_type_head_ok_head(ok: Exact_type_head_ok) -> Exact_type_head {
  match! Exact_type_head_ok.get(ok) {
    .(head: Exact_type_head, _aliases: Alias_refs) { head }
  }
}

fn exact_type_head_ok_aliases(ok: Exact_type_head_ok) -> Alias_refs {
  match! Exact_type_head_ok.get(ok) {
    .(_head: Exact_type_head, aliases: Alias_refs) { aliases }
  }
}

fn exact_type_head_failure(diag: Diag) -> Exact_type_head_result {
  widen_sum!({exact_type_head_bad = diag}, Exact_type_head_result)
}

labels { host_pick_found: Host_type };

labels { host_pick_conflict: . };

type Host_pick = . | Host_pick_found | Host_pick_conflict | Diag;

// Parse only the selected exact host-type declaration. Unrelated malformed or
// conflicting declarations remain inert; duplicates of this selected ID are
// compared structurally here.
fn host_header_visible_at(header: Host_header, cutoff: I32, local: Bool) -> Bool {
  if! local {
    lt_i32(host_header_decl_pos(header), cutoff)
  } else {
    .t(Bool)
  }
}

fn pick_host_type(owner: String, headers: Host_headers, name: String, cutoff: I32, local: Bool) -> Host_pick {
  loop(
    , .(state: Host_headers & (. | Host_type)) {
        match! state {
          .(remaining: Host_headers, found: . | Host_type) {
            match! un_host_headers(remaining) {
              (
                , .(header: Host_header, rest: Host_headers) {
                    if! host_header_is_fn(header) {
                      widen_sum!((rest, found), (Host_headers & (. | Host_type)) | Host_pick)
                    } else if! string_eq(host_header_name(header), name) {
                      if! host_header_visible_at(header, cutoff, local) {
                        match! parse_host_type_descriptor(owner, header) {
                          (
                            , .(descriptor: Host_type) {
                                match! found {
                                  (
                                    , .(prior: Host_type) {
                                        if! host_type_eq(prior, descriptor) {
                                          widen_sum!(
                                            , (rest, found)
                                            , (Host_headers & (. | Host_type)) | Host_pick
                                            )
                                        } else {
                                          widen_sum!(
                                            , widen_sum!({host_pick_conflict=}, Host_pick)
                                            , (Host_headers & (. | Host_type)) | Host_pick
                                            )
                                        }
                                      }
                                    , .(_none: .) {
                                        widen_sum!(
                                          , (rest, widen_sum!(descriptor, . | Host_type))
                                          , (Host_headers & (. | Host_type)) | Host_pick
                                          )
                                      }
                                    )
                                }
                              }
                            , .(diag: Diag) {
                                widen_sum!(
                                  , widen_sum!(diag, Host_pick)
                                  , (Host_headers & (. | Host_type)) | Host_pick
                                  )
                              }
                            )
                        }
                      } else {
                        widen_sum!((rest, found), (Host_headers & (. | Host_type)) | Host_pick)
                      }
                    } else {
                      widen_sum!((rest, found), (Host_headers & (. | Host_type)) | Host_pick)
                    }
                  }
                , .(_empty: .) {
                    match! found {
                      (
                        , .(descriptor: Host_type) {
                            widen_sum!(
                              , widen_sum!({host_pick_found = descriptor}, Host_pick)
                              , (Host_headers & (. | Host_type)) | Host_pick
                              )
                          }
                        , .(_none: .) {
                            widen_sum!(
                              , widen_sum!((), Host_pick)
                              , (Host_headers & (. | Host_type)) | Host_pick
                              )
                          }
                        )
                    }
                  }
                )
            }
          }
        }
      }
    , (headers, widen_sum!((), . | Host_type))
    )
}

fn pick_module_host_type(module: Module, name: String, cutoff: I32, local: Bool) -> Host_pick {
  pick_host_type(module_name(module), module_host_headers(module), name, cutoff, local)
}

fn pick_type_context_host_type(
  , context: Type_context
  , module: Module
  , name: String
  , cutoff: I32
  , local: Bool
  ) -> Host_pick {
  pick_host_type(
    , module_name(module)
    , type_context_host_headers(context, module, name)
    , name
    , cutoff
    , local
    )
}

fn exact_type_resolution_diag(name: String, detail: String) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: cannot resolve exact type `"(String)
    , string_concat(name, string_concat("`: "(String), detail))
    ))
}

labels { member_choice_found: Member_decl };

labels { member_choice_conflict: . };

type Member_choice = . | Member_choice_found | Member_choice_conflict;

// Local exact lookup observes declaration order; imported and qualified
// provider lookup sees the provider's complete public surface.
fn choose_member(
  , members: Members
  , name: String
  , cutoff: I32
  , limit: Bool
  , recursive_scope: . | Recursive_type_scope
  ) -> Member_choice {
  loop(
    , .(state: Members & (. | Member_decl)) {
        match! state {
          .(remaining: Members, found: . | Member_decl) {
            match! un_members(remaining) {
              (
                , .(candidate: Member_decl, rest: Members) {
                    let in_order =
                      if! limit {
                        if! lt_i32(member_decl_pos(candidate), cutoff) {
                          .t(Bool)
                        } else {
                          recursive_type_scopes_match(
                            , member_recursive_scope(candidate)
                            , recursive_scope
                            )
                        }
                      } else {
                        .t(Bool)
                      };
                    if! in_order {
                      if! string_eq(member_name(candidate), name) {
                        match! found {
                          (
                            , .(_prior: Member_decl) {
                                widen_sum!(
                                  , widen_sum!({member_choice_conflict=}, Member_choice)
                                  , (Members & (. | Member_decl)) | Member_choice
                                  )
                              }
                            , .(_none: .) {
                                widen_sum!(
                                  , (rest, widen_sum!(candidate, . | Member_decl))
                                  , (Members & (. | Member_decl)) | Member_choice
                                  )
                              }
                            )
                        }
                      } else {
                        widen_sum!((rest, found), (Members & (. | Member_decl)) | Member_choice)
                      }
                    } else {
                      widen_sum!((rest, found), (Members & (. | Member_decl)) | Member_choice)
                    }
                  }
                , .(_empty: .) {
                    match! found {
                      (
                        , .(member: Member_decl) {
                            widen_sum!(
                              , widen_sum!({member_choice_found = member}, Member_choice)
                              , (Members & (. | Member_decl)) | Member_choice
                              )
                          }
                        , .(_none: .) {
                            widen_sum!(
                              , widen_sum!((), Member_choice)
                              , (Members & (. | Member_decl)) | Member_choice
                              )
                          }
                        )
                    }
                  }
                )
            }
          }
        }
      }
    , (members, widen_sum!((), . | Member_decl))
    )
}

fn member_param_kinds(member: Member_decl) -> Param_kinds | Diag {
  match! parse_host_binders(member_header(member)) {
    (
      , .(done: Host_binders_done) {
          match! Host_binders_done.get(done) {
            .(binders: Binders, _after: Toks) {
              widen_sum!(host_param_kinds(binders), Param_kinds | Diag)
            }
          }
        }
      , .(bad: Host_binders_bad) {
          widen_sum!(
            , exact_type_resolution_diag(member_name(member), Host_binders_bad.get(bad))
            , Param_kinds | Diag
            )
        }
      )
  }
}

labels { type_origin: String & String };

labels { type_origins: List(Type_origin) };

fn type_origin(owner: String, name: String) -> Type_origin { {type_origin = (owner, name)} }

fn type_origin_owner(origin: Type_origin) -> String {
  match! Type_origin.get(origin) {
    .(owner: String, _name: String) { owner }
  }
}

fn type_origin_name(origin: Type_origin) -> String {
  match! Type_origin.get(origin) {
    .(_owner: String, name: String) { name }
  }
}

fn type_origin_eq(left: Type_origin, right: Type_origin) -> Bool {
  if! string_eq(type_origin_owner(left), type_origin_owner(right)) {
    string_eq(type_origin_name(left), type_origin_name(right))
  } else {
    .f(Bool)
  }
}

fn type_origins_nil() -> Type_origins { {type_origins = nil(Type_origin, ())} }

fn type_origins_cons(head: Type_origin, tail: Type_origins) -> Type_origins {
  {type_origins = cons(Type_origin, head, Type_origins.get(tail))}
}

fn un_type_origins(origins: Type_origins) -> . | (Type_origin & Type_origins) {
  match! uncons(Type_origin, Type_origins.get(origins)) {
    (
      , .(head: Type_origin, tail: List(Type_origin)) {
          widen_sum!((head, {type_origins = tail}), . | (Type_origin & Type_origins))
        }
      , .(_empty: .) { widen_sum!((), . | (Type_origin & Type_origins)) }
      )
  }
}

labels { identity_commas_done: Toks };

fn identity_skip_commas(ts: Toks) -> Toks {
  Identity_commas_done.get(loop(
    , .(remaining: Toks) {
        if! sig_head_is(remaining, 44(I32)) {
          widen_sum!(sig_rest(remaining), Toks | Identity_commas_done)
        } else {
          widen_sum!({identity_commas_done = remaining}, Toks | Identity_commas_done)
        }
      }
    , ts
    ))
}

labels { identity_group_opened: I32 & Toks };

fn identity_open_groups(ts: Toks) -> Identity_group_opened {
  loop(
    , .(state: I32 & Toks) {
        match! state {
          .(count: I32, remaining: Toks) {
            if! sig_head_is(remaining, 40(I32)) {
              widen_sum!(
                , (add_i32(count, 1(I32)), sig_rest(remaining))
                , (I32 & Toks) | Identity_group_opened
                )
            } else {
              widen_sum!(
                , {identity_group_opened = (count, remaining)}
                , (I32 & Toks) | Identity_group_opened
                )
            }
          }
        }
      }
    , (0(I32), ts)
    )
}

fn identity_close_groups(count: I32, ts: Toks) -> . | Toks {
  loop(
    , .(state: I32 & Toks) {
        match! state {
          .(remaining_count: I32, remaining: Toks) {
            if! eq_i32(remaining_count, 0(I32)) {
              widen_sum!(widen_sum!(remaining, . | Toks), (I32 & Toks) | . | Toks)
            } else if! sig_head_is(remaining, 41(I32)) {
              widen_sum!(
                , (sub_i32(remaining_count, 1(I32)), sig_rest(remaining))
                , (I32 & Toks) | . | Toks
                )
            } else {
              widen_sum!(widen_sum!((), . | Toks), (I32 & Toks) | . | Toks)
            }
          }
        }
      }
    , (count, ts)
    )
}

fn identity_alias_argument(name: String, ts: Toks) -> . | Toks {
  match! Identity_group_opened.get(identity_open_groups(ts)) {
    .(groups: I32, at_argument: Toks) {
      match! sig_head_word(at_argument) {
        (
          , .(argument_name: String) {
              if! string_eq(argument_name, name) {
                identity_close_groups(groups, sig_rest(at_argument))
              } else {
                widen_sum!((), . | Toks)
              }
            }
          , .(_not_word: .) { widen_sum!((), . | Toks) }
          )
      }
    }
  }
}

fn identity_alias_args(binders: Binders, ts: Toks) -> . | Toks {
  loop(
    , .(state: Binders & Toks) {
        match! state {
          .(remaining_binders: Binders, remaining_tokens: Toks) {
            match! un_binders(remaining_binders) {
              (
                , .(binder: Binder_info, rest_binders: Binders) {
                    let at_argument = identity_skip_commas(remaining_tokens);
                    match! Binder_info.get(binder) {
                      .(binder_name: String, _stars: I32) {
                        match! identity_alias_argument(binder_name, at_argument) {
                          (
                            , .(after_argument: Toks) {
                                widen_sum!(
                                  , (rest_binders, after_argument)
                                  , (Binders & Toks) | . | Toks
                                  )
                              }
                            , .(_not_argument: .) {
                                widen_sum!(widen_sum!((), . | Toks), (Binders & Toks) | . | Toks)
                              }
                            )
                        }
                      }
                    }
                  }
                , .(_no_binders: .) {
                    let at_close = identity_skip_commas(remaining_tokens);
                    if! sig_head_is(at_close, 41(I32)) {
                      widen_sum!(
                        , widen_sum!(sig_rest(at_close), . | Toks)
                        , (Binders & Toks) | . | Toks
                        )
                    } else {
                      widen_sum!(widen_sum!((), . | Toks), (Binders & Toks) | . | Toks)
                    }
                  }
                )
            }
          }
        }
      }
    , (binders, ts)
    )
}

labels { identity_alias_target_read: String & Toks };

fn identity_alias_target_read_close(target: String, groups: I32, after: Toks) ->
  . | Identity_alias_target_read
   {
  match! identity_close_groups(groups, after) {
    (
      , .(remaining: Toks) {
          widen_sum!(
            , {identity_alias_target_read = (target, remaining)}
            , . | Identity_alias_target_read
            )
        }
      , .(_missing_close: .) { widen_sum!((), . | Identity_alias_target_read) }
      )
  }
}

fn read_identity_alias_target(binders: Binders, ts: Toks) -> . | Identity_alias_target_read {
  match! Identity_group_opened.get(identity_open_groups(ts)) {
    .(groups: I32, at_target: Toks) {
      match! read_type_path(at_target) {
        (
          , .(read: Type_path_read) {
              match! Type_path_read.get(read) {
                .(target: String, after_target: Toks) {
                  if! eq_i32(binders_len(binders), 0(I32)) {
                    identity_alias_target_read_close(target, groups, after_target)
                  } else if! sig_head_is(after_target, 40(I32)) {
                    match! identity_alias_args(binders, sig_rest(after_target)) {
                      (
                        , .(after: Toks) { identity_alias_target_read_close(target, groups, after) }
                        , .(_bad_args: .) { widen_sum!((), . | Identity_alias_target_read) }
                        )
                    }
                  } else {
                    widen_sum!((), . | Identity_alias_target_read)
                  }
                }
              }
            }
          , .(_not_path: .) { widen_sum!((), . | Identity_alias_target_read) }
          )
      }
    }
  }
}

fn identity_alias_target(alias: Alias_decl) -> . | String {
  match! read_identity_alias_target(tyalias_binders(alias), tyalias_body(alias)) {
    (
      , .(read: Identity_alias_target_read) {
          match! Identity_alias_target_read.get(read) {
            .(target: String, after: Toks) {
              if! toks_empty(after) {
                widen_sum!(target, . | String)
              } else {
                widen_sum!((), . | String)
              }
            }
          }
        }
      , .(_not_identity: .) { widen_sum!((), . | String) }
      )
  }
}

fn alias_target_named(aliases: Aliases, name: String) -> . | String | Diag {
  loop(
    , .(state: Aliases & (. | String)) {
        match! state {
          .(remaining: Aliases, found: . | String) {
            match! un_aliases(remaining) {
              (
                , .(alias: Mod_alias, rest: Aliases) {
                    if! string_eq(alias_name(alias), name) {
                      match! found {
                        (
                          , .(prior: String) {
                              if! string_eq(prior, alias_target(alias)) {
                                widen_sum!(
                                  , (rest, found)
                                  , (Aliases & (. | String)) | . | String | Diag
                                  )
                              } else {
                                widen_sum!(
                                  , exact_type_resolution_diag(
                                      , name
                                      , "module alias names more than one provider"(String)
                                      )
                                  , (Aliases & (. | String)) | . | String | Diag
                                  )
                              }
                            }
                          , .(_none: .) {
                              widen_sum!(
                                , (rest, widen_sum!(alias_target(alias), . | String))
                                , (Aliases & (. | String)) | . | String | Diag
                                )
                            }
                          )
                      }
                    } else {
                      widen_sum!((rest, found), (Aliases & (. | String)) | . | String | Diag)
                    }
                  }
                , .(_empty: .) { widen_sum!(found, (Aliases & (. | String)) | . | String | Diag) }
                )
            }
          }
        }
      }
    , (aliases, widen_sum!((), . | String))
    )
}

fn imported_type_candidates(imports: Imports, name: String, initial: Type_origins) -> Type_origins {
  loop(
    , .(state: Imports & Type_origins) {
        match! state {
          .(remaining: Imports, found: Type_origins) {
            match! un_imports(remaining) {
              (
                , .(one: Import, rest: Imports) {
                    match! un_import(one) {
                      .(imported: String, provider: String) {
                        if! string_eq(imported, name) {
                          widen_sum!(
                            , (rest, type_origins_cons(type_origin(provider, name), found))
                            , (Imports & Type_origins) | Type_origins
                            )
                        } else {
                          widen_sum!((rest, found), (Imports & Type_origins) | Type_origins)
                        }
                      }
                    }
                  }
                , .(_empty: .) { widen_sum!(found, (Imports & Type_origins) | Type_origins) }
                )
            }
          }
        }
      }
    , (imports, initial)
    )
}

fn resolve_provider_type_head(
  , context: Type_context
  , provider: String
  , local_name: String
  , selected_spelling: String
  ) -> Exact_type_head_result {
  match! type_context_find_module(context, provider) {
    (
      , .(module: Module) {
          let consumer = module_name(type_context_module(context));
          let local = string_eq(provider, consumer);
          let alias_choice =
            choose_alias(
              , type_context_aliases(context, module, local_name)
              , local_name
              , provider
              , consumer
              , type_context_alias_cutoff(context)
              , local
              , type_context_recursive_scope(context)
              );
          let nominal =
            choose_member(
              , type_context_members(context, module, local_name)
              , local_name
              , type_context_alias_cutoff(context)
              , local
              , type_context_recursive_scope(context)
              );
          match! pick_type_context_host_type(
            , context
            , module
            , local_name
            , type_context_alias_cutoff(context)
            , local
            ) {
            (
              , .(found_host: Host_pick_found) {
                  match! alias_choice {
                    (
                      , .(_alias: Alias_choice_found) {
                          exact_type_head_failure(exact_type_resolution_diag(
                            , selected_spelling
                            , "the provider declares more than one type species with that name"(String)
                            ))
                        }
                      , .(_conflict: Alias_choice_conflict) {
                          exact_type_head_failure(exact_type_resolution_diag(
                            , selected_spelling
                            , "the provider contains conflicting aliases with that name"(String)
                            ))
                        }
                      , .(_no_alias: .) {
                          match! nominal {
                            (
                              , .(_member: Member_choice_found) {
                                  exact_type_head_failure(exact_type_resolution_diag(
                                    , selected_spelling
                                    , "the provider declares more than one type species with that name"(String)
                                    ))
                                }
                              , .(_conflict: Member_choice_conflict) {
                                  exact_type_head_failure(exact_type_resolution_diag(
                                    , selected_spelling
                                    , "the provider contains duplicate nominal types with that name"(String)
                                    ))
                                }
                              , .(_no_nominal: .) {
                                  exact_type_head_success(exact_head_host(Host_pick_found.get(found_host)))
                                }
                              )
                          }
                        }
                      )
                  }
                }
              , .(_host_conflict: Host_pick_conflict) {
                  exact_type_head_failure(exact_type_resolution_diag(
                    , selected_spelling
                    , "the provider contains conflicting host-type descriptors"(String)
                    ))
                }
              , .(diag: Diag) { exact_type_head_failure(diag) }
              , .(_no_host: .) {
                  match! alias_choice {
                    (
                      , .(found_alias: Alias_choice_found) {
                          match! nominal {
                            (
                              , .(_member: Member_choice_found) {
                                  exact_type_head_failure(exact_type_resolution_diag(
                                    , selected_spelling
                                    , "the provider declares more than one type species with that name"(String)
                                    ))
                                }
                              , .(_conflict: Member_choice_conflict) {
                                  exact_type_head_failure(exact_type_resolution_diag(
                                    , selected_spelling
                                    , "the provider contains duplicate nominal types with that name"(String)
                                    ))
                                }
                              , .(_no_nominal: .) {
                                  exact_type_head_success(exact_head_alias(
                                    , provider
                                    , Alias_choice_found.get(found_alias)
                                    ))
                                }
                              )
                          }
                        }
                      , .(_conflict: Alias_choice_conflict) {
                          exact_type_head_failure(exact_type_resolution_diag(
                            , selected_spelling
                            , "the provider contains conflicting aliases with that name"(String)
                            ))
                        }
                      , .(_no_alias: .) {
                          match! nominal {
                            (
                              , .(found_member: Member_choice_found) {
                                  let member = Member_choice_found.get(found_member);
                                  if! visibility_allows(
                                    , member_nt_visibility(member)
                                    , provider
                                    , consumer
                                    ) {
                                    match! member_param_kinds(member) {
                                      (
                                        , .(params: Param_kinds) {
                                            exact_type_head_success(exact_head_nominal(
                                              , mk_host_id(provider, local_name)
                                              , params
                                              ))
                                          }
                                        , .(diag: Diag) { exact_type_head_failure(diag) }
                                        )
                                    }
                                  } else {
                                    exact_type_head_failure(exact_type_resolution_diag(
                                      , selected_spelling
                                      , "the nominal type is not visible here"(String)
                                      ))
                                  }
                                }
                              , .(_conflict: Member_choice_conflict) {
                                  exact_type_head_failure(exact_type_resolution_diag(
                                    , selected_spelling
                                    , "the provider contains duplicate nominal types with that name"(String)
                                    ))
                                }
                              , .(_no_nominal: .) {
                                  exact_type_head_failure(exact_type_resolution_diag(
                                    , selected_spelling
                                    , "the provider declares no such type"(String)
                                    ))
                                }
                              )
                          }
                        }
                      )
                  }
                }
              )
          }
        }
      , .(_missing: .) {
          exact_type_head_failure(exact_type_resolution_diag(
            , selected_spelling
            , "the provider module is absent"(String)
            ))
        }
      )
  }
}

fn local_type_spelling_present(context: Type_context, name: String) -> Bool {
  let module = type_context_module(context);
  let host_present =
    match! pick_type_context_host_type(
      , context
      , module
      , name
      , type_context_alias_cutoff(context)
      , .t(Bool)
      ) {
      (
        , .(_found: Host_pick_found) { .t(Bool) }
        , .(_conflict: Host_pick_conflict) { .t(Bool) }
        , .(_diag: Diag) { .t(Bool) }
        , .(_missing: .) { .f(Bool) }
        )
    };
  if! host_present {
    .t(Bool)
  } else match! choose_member(
    , type_context_members(context, module, name)
    , name
    , type_context_alias_cutoff(context)
    , .t(Bool)
    , type_context_recursive_scope(context)
    ) {
    (
      , .(_found: Member_choice_found) { .t(Bool) }
      , .(_conflict: Member_choice_conflict) { .t(Bool) }
      , .(_missing: .) {
          match! choose_alias(
            , type_context_aliases(context, module, name)
            , name
            , module_name(module)
            , module_name(module)
            , type_context_alias_cutoff(context)
            , .t(Bool)
            , type_context_recursive_scope(context)
            ) {
            (
              , .(_found: Alias_choice_found) { .t(Bool) }
              , .(_conflict: Alias_choice_conflict) { .t(Bool) }
              , .(_missing: .) { .f(Bool) }
              )
          }
        }
      )
  }
}

fn visible_type_candidates(context: Type_context, name: String) -> Type_origins | Diag {
  let module = type_context_module(context);
  match! split_last_dot(name) {
    (
      , .(qualifier: String, local_name: String) {
          match! alias_target_named(type_context_qualifiers(context, qualifier), qualifier) {
            (
              , .(provider: String) {
                  widen_sum!(
                    , type_origins_cons(type_origin(provider, local_name), type_origins_nil())
                    , Type_origins | Diag
                    )
                }
              , .(diag: Diag) { widen_sum!(diag, Type_origins | Diag) }
              , .(_missing: .) {
                  widen_sum!(
                    , exact_type_resolution_diag(
                        , name
                        , "the qualifier is not a module alias"(String)
                        )
                    , Type_origins | Diag
                    )
                }
              )
          }
        }
      , .(_bare: .) {
          let local =
            if! local_type_spelling_present(context, name) {
              type_origins_cons(type_origin(module_name(module), name), type_origins_nil())
            } else {
              type_origins_nil()
            };
          let candidates =
            imported_type_candidates(type_context_imports(context, name), name, local);
          match! un_type_origins(candidates) {
            (
              , .(_one: Type_origin, _rest: Type_origins) {
                  widen_sum!(candidates, Type_origins | Diag)
                }
              , .(_none: .) {
                  widen_sum!(
                    , exact_type_resolution_diag(name, "no type binding has that spelling"(String))
                    , Type_origins | Diag
                    )
                }
              )
          }
        }
      )
  }
}

labels { origin_terminal: Type_origin & Type_context & Alias_refs };

labels { origin_expand: Type_origins & Type_context & Alias_refs };

labels { origin_bad: Diag };

type Origin_action = Origin_terminal | Origin_expand | Origin_bad;

fn mk_origin_terminal(origin: Type_origin, lookup: Type_context, refs: Alias_refs) -> Origin_terminal {
  {origin_terminal = (origin, (lookup, refs))}
}

fn origin_terminal_action(origin: Type_origin, lookup: Type_context, refs: Alias_refs) -> Origin_action {
  widen_sum!(mk_origin_terminal(origin, lookup, refs), Origin_action)
}

fn origin_terminal_origin(terminal: Origin_terminal) -> Type_origin {
  match! Origin_terminal.get(terminal) {
    .(origin: Type_origin, _lookup: Type_context, _refs: Alias_refs) { origin }
  }
}

fn origin_terminal_lookup(terminal: Origin_terminal) -> Type_context {
  match! Origin_terminal.get(terminal) {
    .(_origin: Type_origin, lookup: Type_context, _refs: Alias_refs) { lookup }
  }
}

fn origin_terminal_refs(terminal: Origin_terminal) -> Alias_refs {
  match! Origin_terminal.get(terminal) {
    .(_origin: Type_origin, _lookup: Type_context, refs: Alias_refs) { refs }
  }
}

fn origin_bad_action(diag: Diag) -> Origin_action { widen_sum!({origin_bad = diag}, Origin_action) }

fn exact_head_param_kinds(head: Exact_type_head) -> Param_kinds {
  match! head {
    (
      , .(host: Exact_head_host) { host_type_params(Exact_head_host.get(host)) }
      , .(nominal: Exact_head_nominal) {
          match! Exact_head_nominal.get(nominal) {
            .(_id: Host_id, params: Param_kinds) { params }
          }
        }
      , .(alias_head: Exact_head_alias) {
          match! Exact_head_alias.get(alias_head) {
            .(_owner: String, alias: Alias_decl) { host_param_kinds(tyalias_binders(alias)) }
          }
        }
      )
  }
}

labels { identity_kinds_ok: . };

labels { identity_kinds_bad: Diag };

type Identity_kinds_result = Identity_kinds_ok | Identity_kinds_bad;

fn param_kinds_prefix_eq(expected: Param_kinds, actual: Param_kinds) -> Bool {
  loop(
    , .(state: Param_kinds & Param_kinds) {
        match! state {
          .(remaining_expected: Param_kinds, remaining_actual: Param_kinds) {
            match! un_param_kinds(remaining_expected) {
              (
                , .(expected_kind: Param_kind, expected_rest: Param_kinds) {
                    match! un_param_kinds(remaining_actual) {
                      (
                        , .(actual_kind: Param_kind, actual_rest: Param_kinds) {
                            if! param_kind_eq(expected_kind, actual_kind) {
                              widen_sum!(
                                , (expected_rest, actual_rest)
                                , (Param_kinds & Param_kinds) | Bool
                                )
                            } else {
                              widen_sum!(.f(Bool), (Param_kinds & Param_kinds) | Bool)
                            }
                          }
                        , .(_empty: .) { widen_sum!(.f(Bool), (Param_kinds & Param_kinds) | Bool) }
                        )
                    }
                  }
                , .(_empty: .) { widen_sum!(.t(Bool), (Param_kinds & Param_kinds) | Bool) }
                )
            }
          }
        }
      }
    , (expected, actual)
    )
}

fn validate_identity_target_kinds(
  , context: Type_context
  , candidates: Type_origins
  , expected: Param_kinds
  ) -> Identity_kinds_result {
  loop(
    , .(remaining: Type_origins) {
        match! un_type_origins(remaining) {
          (
            , .(candidate: Type_origin, rest: Type_origins) {
                match! resolve_provider_type_head(
                  , context
                  , type_origin_owner(candidate)
                  , type_origin_name(candidate)
                  , type_origin_name(candidate)
                  ) {
                  (
                    , .(ok: Exact_type_head_ok) {
                        if! param_kinds_prefix_eq(
                          , expected
                          , exact_head_param_kinds(exact_type_head_ok_head(ok))
                          ) {
                          widen_sum!(rest, Type_origins | Identity_kinds_result)
                        } else {
                          widen_sum!(
                            , widen_sum!(
                                , {identity_kinds_bad = exact_type_resolution_diag(
                                    , type_origin_name(candidate)
                                    , "identity alias parameters do not match the target parameter prefix"(String)
                                    )}
                                , Identity_kinds_result
                                )
                            , Type_origins | Identity_kinds_result
                            )
                        }
                      }
                    , .(bad: Exact_type_head_bad) {
                        widen_sum!(
                          , widen_sum!(
                              , {identity_kinds_bad = Exact_type_head_bad.get(bad)}
                              , Identity_kinds_result
                              )
                          , Type_origins | Identity_kinds_result
                          )
                      }
                    )
                }
              }
            , .(_empty: .) {
                widen_sum!(
                  , widen_sum!({identity_kinds_ok=}, Identity_kinds_result)
                  , Type_origins | Identity_kinds_result
                  )
              }
            )
        }
      }
    , candidates
    )
}

fn origin_alias_action(base: Type_context, owner: String, alias: Alias_decl, refs: Alias_refs) -> Origin_action {
  match! identity_alias_target(alias) {
    (
      , .(target: String) {
          if! alias_refs_has(refs, owner, tyalias_name(alias)) {
            origin_bad_action(exact_type_resolution_diag(
              , tyalias_name(alias)
              , "identity-only alias bindings form a cycle"(String)
              ))
          } else match! type_context_find_module(base, owner) {
            (
              , .(module: Module) {
                  let alias_context = type_context_for_alias(base, module, alias);
                  match! visible_type_candidates(alias_context, target) {
                    (
                      , .(candidates: Type_origins) {
                          match! validate_identity_target_kinds(
                            , alias_context
                            , candidates
                            , host_param_kinds(tyalias_binders(alias))
                            ) {
                            (
                              , .(_valid: Identity_kinds_ok) {
                                  widen_sum!(
                                    , {origin_expand = (
                                        , candidates
                                        , (
                                            , alias_context
                                            , alias_refs_cons(owner, tyalias_name(alias), refs)
                                            )
                                        )}
                                    , Origin_action
                                    )
                                }
                              , .(bad: Identity_kinds_bad) {
                                  origin_bad_action(Identity_kinds_bad.get(bad))
                                }
                              )
                          }
                        }
                      , .(diag: Diag) { origin_bad_action(diag) }
                      )
                  }
                }
              , .(_missing: .) {
                  origin_bad_action(exact_type_resolution_diag(
                    , tyalias_name(alias)
                    , "the alias owner module is absent"(String)
                    ))
                }
              )
          }
        }
      , .(_not_identity: .) {
          origin_terminal_action(type_origin(owner, tyalias_name(alias)), base, refs)
        }
      )
  }
}

fn classify_type_origin(
  , lookup: Type_context
  , origin: Type_origin
  , refs: Alias_refs
  , cached_alias: (String & String) -> . | Origin_terminal
  ) -> Origin_action {
  let owner = type_origin_owner(origin);
  let name = type_origin_name(origin);
  let consumer = module_name(type_context_module(lookup));
  let local = string_eq(owner, consumer);
  match! type_context_find_module(lookup, owner) {
    (
      , .(module: Module) {
          let alias_choice =
            choose_alias(
              , type_context_aliases(lookup, module, name)
              , name
              , owner
              , consumer
              , type_context_alias_cutoff(lookup)
              , local
              , type_context_recursive_scope(lookup)
              );
          let nominal =
            choose_member(
              , type_context_members(lookup, module, name)
              , name
              , type_context_alias_cutoff(lookup)
              , local
              , type_context_recursive_scope(lookup)
              );
          match! pick_type_context_host_type(
            , lookup
            , module
            , name
            , type_context_alias_cutoff(lookup)
            , local
            ) {
            (
              , .(_host: Host_pick_found) {
                  match! alias_choice {
                    (
                      , .(_alias: Alias_choice_found) {
                          origin_bad_action(exact_type_resolution_diag(
                            , name
                            , "the provider declares more than one type species with that name"(String)
                            ))
                        }
                      , .(_conflict: Alias_choice_conflict) {
                          origin_bad_action(exact_type_resolution_diag(
                            , name
                            , "the provider contains conflicting aliases with that name"(String)
                            ))
                        }
                      , .(_no_alias: .) {
                          match! nominal {
                            (
                              , .(_member: Member_choice_found) {
                                  origin_bad_action(exact_type_resolution_diag(
                                    , name
                                    , "the provider declares more than one type species with that name"(String)
                                    ))
                                }
                              , .(_conflict: Member_choice_conflict) {
                                  origin_bad_action(exact_type_resolution_diag(
                                    , name
                                    , "the provider contains duplicate nominal types with that name"(String)
                                    ))
                                }
                              , .(_none: .) { origin_terminal_action(origin, lookup, refs) }
                              )
                          }
                        }
                      )
                  }
                }
              , .(_host_conflict: Host_pick_conflict) {
                  origin_bad_action(exact_type_resolution_diag(
                    , name
                    , "the provider contains conflicting host-type descriptors"(String)
                    ))
                }
              , .(diag: Diag) { origin_bad_action(diag) }
              , .(_no_host: .) {
                  match! alias_choice {
                    (
                      , .(found_alias: Alias_choice_found) {
                          match! nominal {
                            (
                              , .(_member: Member_choice_found) {
                                  origin_bad_action(exact_type_resolution_diag(
                                    , name
                                    , "the provider declares more than one type species with that name"(String)
                                    ))
                                }
                              , .(_conflict: Member_choice_conflict) {
                                  origin_bad_action(exact_type_resolution_diag(
                                    , name
                                    , "the provider contains duplicate nominal types with that name"(String)
                                    ))
                                }
                              , .(_none: .) {
                                  let alias = Alias_choice_found.get(found_alias);
                                  if! visibility_allows(tyalias_visibility(alias), owner, consumer) {
                                    match! cached_alias((owner, name)) {
                                      (
                                        , .(terminal: Origin_terminal) {
                                            origin_terminal_action(
                                              , origin_terminal_origin(terminal)
                                              , origin_terminal_lookup(terminal)
                                              , alias_refs_union(
                                                  , alias_refs_cons(owner, name, refs)
                                                  , origin_terminal_refs(terminal)
                                                  )
                                              )
                                          }
                                        , .(_missing: .) {
                                            origin_alias_action(lookup, owner, alias, refs)
                                          }
                                        )
                                    }
                                  } else {
                                    origin_bad_action(exact_type_resolution_diag(
                                      , name
                                      , "the alias is not visible here"(String)
                                      ))
                                  }
                                }
                              )
                          }
                        }
                      , .(_conflict: Alias_choice_conflict) {
                          origin_bad_action(exact_type_resolution_diag(
                            , name
                            , "the provider contains conflicting aliases with that name"(String)
                            ))
                        }
                      , .(_no_alias: .) {
                          match! nominal {
                            (
                              , .(found_member: Member_choice_found) {
                                  if! visibility_allows(
                                    , member_nt_visibility(Member_choice_found.get(found_member))
                                    , owner
                                    , consumer
                                    ) {
                                    origin_terminal_action(origin, lookup, refs)
                                  } else {
                                    origin_bad_action(exact_type_resolution_diag(
                                      , name
                                      , "the nominal type is not visible here"(String)
                                      ))
                                  }
                                }
                              , .(_conflict: Member_choice_conflict) {
                                  origin_bad_action(exact_type_resolution_diag(
                                    , name
                                    , "the provider contains duplicate nominal types with that name"(String)
                                    ))
                                }
                              , .(_none: .) {
                                  origin_bad_action(exact_type_resolution_diag(
                                    , name
                                    , "the provider declares no such type"(String)
                                    ))
                                }
                              )
                          }
                        }
                      )
                  }
                }
              )
          }
        }
      , .(_missing: .) {
          origin_bad_action(exact_type_resolution_diag(
            , name
            , "the provider module is absent"(String)
            ))
        }
      )
  }
}

labels { origin_work: Type_origin & Type_context & Alias_refs };

labels { origin_works: List(Origin_work) };

fn origin_works_nil() -> Origin_works { {origin_works = nil(Origin_work, ())} }

fn origin_works_cons(head: Origin_work, tail: Origin_works) -> Origin_works {
  {origin_works = cons(Origin_work, head, Origin_works.get(tail))}
}

fn un_origin_works(work: Origin_works) -> . | (Origin_work & Origin_works) {
  match! uncons(Origin_work, Origin_works.get(work)) {
    (
      , .(head: Origin_work, tail: List(Origin_work)) {
          widen_sum!((head, {origin_works = tail}), . | (Origin_work & Origin_works))
        }
      , .(_empty: .) { widen_sum!((), . | (Origin_work & Origin_works)) }
      )
  }
}

fn origin_works_prepend(
  , candidates: Type_origins
  , lookup: Type_context
  , refs: Alias_refs
  , work: Origin_works
  ) -> Origin_works {
  loop(
    , .(state: Type_origins & Origin_works) {
        match! state {
          .(remaining: Type_origins, collected: Origin_works) {
            match! un_type_origins(remaining) {
              (
                , .(candidate: Type_origin, rest: Type_origins) {
                    widen_sum!(
                      , (
                          , rest
                          , origin_works_cons(
                              , {origin_work = (candidate, (lookup, refs))}
                              , collected
                              )
                          )
                      , (Type_origins & Origin_works) | Origin_works
                      )
                  }
                , .(_empty: .) {
                    widen_sum!(collected, (Type_origins & Origin_works) | Origin_works)
                  }
                )
            }
          }
        }
      }
    , (candidates, work)
    )
}

labels { exact_origin_ok: Type_origin & Type_context & Alias_refs };

labels { exact_origin_bad: Diag & Alias_refs };

type Exact_origin_result = Exact_origin_ok | Exact_origin_bad;

fn exact_origin_bad_diag(bad: Exact_origin_bad) -> Diag {
  match! Exact_origin_bad.get(bad) {
    .(diag: Diag, _refs: Alias_refs) { diag }
  }
}

fn exact_origin_bad_refs(bad: Exact_origin_bad) -> Alias_refs {
  match! Exact_origin_bad.get(bad) {
    .(_diag: Diag, refs: Alias_refs) { refs }
  }
}

labels { origin_walk_state: Origin_works & (. | Origin_terminal) & Alias_refs };

fn resolve_exact_type_origin_cached(
  , context: Type_context
  , spelling: String
  , cached_alias: (String & String) -> . | Origin_terminal
  ) -> Exact_origin_result {
  match! visible_type_candidates(context, spelling) {
    (
      , .(initial: Type_origins) {
          loop(
            , .(state: Origin_walk_state) {
                match! Origin_walk_state.get(state) {
                  .(work: Origin_works, found: . | Origin_terminal, walked: Alias_refs) {
                    match! un_origin_works(work) {
                      (
                        , .(item: Origin_work, rest: Origin_works) {
                            match! Origin_work.get(item) {
                              .(candidate: Type_origin, lookup: Type_context, refs: Alias_refs) {
                                match! classify_type_origin(lookup, candidate, refs, cached_alias) {
                                  (
                                    , .(terminal: Origin_terminal) {
                                        let terminal_refs =
                                          alias_refs_union(origin_terminal_refs(terminal), walked);
                                        match! found {
                                          (
                                            , .(prior: Origin_terminal) {
                                                let prior_origin = origin_terminal_origin(prior);
                                                let origin = origin_terminal_origin(terminal);
                                                if! type_origin_eq(prior_origin, origin) {
                                                  widen_sum!(
                                                    , {origin_walk_state = (
                                                        , rest
                                                        , widen_sum!(
                                                            , mk_origin_terminal(
                                                                , prior_origin
                                                                , origin_terminal_lookup(prior)
                                                                , terminal_refs
                                                                )
                                                            , . | Origin_terminal
                                                            )
                                                        , terminal_refs
                                                        )}
                                                    , Origin_walk_state | Exact_origin_result
                                                    )
                                                } else {
                                                  widen_sum!(
                                                    , widen_sum!(
                                                        , {exact_origin_bad = (
                                                            , exact_type_resolution_diag(
                                                                , spelling
                                                                , "visible bindings have different declaration origins"(String)
                                                                )
                                                            , terminal_refs
                                                            )}
                                                        , Exact_origin_result
                                                        )
                                                    , Origin_walk_state | Exact_origin_result
                                                    )
                                                }
                                              }
                                            , .(_none: .) {
                                                widen_sum!(
                                                  , {origin_walk_state = (
                                                      , rest
                                                      , widen_sum!(
                                                          , mk_origin_terminal(
                                                              , origin_terminal_origin(terminal)
                                                              , origin_terminal_lookup(terminal)
                                                              , terminal_refs
                                                              )
                                                          , . | Origin_terminal
                                                          )
                                                      , terminal_refs
                                                      )}
                                                  , Origin_walk_state | Exact_origin_result
                                                  )
                                              }
                                            )
                                        }
                                      }
                                    , .(expand: Origin_expand) {
                                        match! Origin_expand.get(expand) {
                                          .(
                                            , next: Type_origins
                                            , next_lookup: Type_context
                                            , next_refs: Alias_refs
                                            ) {
                                            widen_sum!(
                                              , {origin_walk_state = (
                                                  , origin_works_prepend(
                                                      , next
                                                      , next_lookup
                                                      , next_refs
                                                      , rest
                                                      )
                                                  , found
                                                  , walked
                                                  )}
                                              , Origin_walk_state | Exact_origin_result
                                              )
                                          }
                                        }
                                      }
                                    , .(bad: Origin_bad) {
                                        let visited = alias_refs_union(refs, walked);
                                        widen_sum!(
                                          , widen_sum!(
                                              , {exact_origin_bad = (Origin_bad.get(bad), visited)}
                                              , Exact_origin_result
                                              )
                                          , Origin_walk_state | Exact_origin_result
                                          )
                                      }
                                    )
                                }
                              }
                            }
                          }
                        , .(_empty: .) {
                            match! found {
                              (
                                , .(terminal: Origin_terminal) {
                                    widen_sum!(
                                      , widen_sum!(
                                          , {exact_origin_ok = Origin_terminal.get(terminal)}
                                          , Exact_origin_result
                                          )
                                      , Origin_walk_state | Exact_origin_result
                                      )
                                  }
                                , .(_none: .) {
                                    widen_sum!(
                                      , widen_sum!(
                                          , {exact_origin_bad = (
                                              , exact_type_resolution_diag(
                                                  , spelling
                                                  , "no terminal declaration origin was found"(String)
                                                  )
                                              , walked
                                              )}
                                          , Exact_origin_result
                                          )
                                      , Origin_walk_state | Exact_origin_result
                                      )
                                  }
                                )
                            }
                          }
                        )
                    }
                  }
                }
              }
            , {origin_walk_state = (
                , origin_works_prepend(initial, context, alias_refs_nil(), origin_works_nil())
                , widen_sum!((), . | Origin_terminal)
                , alias_refs_nil()
                )}
            )
        }
      , .(diag: Diag) {
          widen_sum!({exact_origin_bad = (diag, alias_refs_nil())}, Exact_origin_result)
        }
      )
  }
}

fn resolve_exact_type_origin(context: Type_context, spelling: String) -> Exact_origin_result {
  resolve_exact_type_origin_cached(
    , context
    , spelling
    , .(_key: String & String) { widen_sum!((), . | Origin_terminal) }
    )
}

fn resolve_exact_type_head(name: String, env: Type_env) -> Exact_type_head_result {
  let context = type_env_context(env);
  match! resolve_exact_type_origin(context, name) {
    (
      , .(ok: Exact_origin_ok) {
          match! Exact_origin_ok.get(ok) {
            .(origin: Type_origin, lookup: Type_context, aliases: Alias_refs) {
              match! Type_origin.get(origin) {
                .(owner: String, local_name: String) {
                  match! resolve_provider_type_head(lookup, owner, local_name, name) {
                    (
                      , .(head: Exact_type_head_ok) {
                          exact_type_head_success_with_aliases(
                            , exact_type_head_ok_head(head)
                            , aliases
                            )
                        }
                      , .(bad: Exact_type_head_bad) {
                          exact_type_head_failure(Exact_type_head_bad.get(bad))
                        }
                      )
                  }
                }
              }
            }
          }
        }
      , .(bad: Exact_origin_bad) { exact_type_head_failure(exact_origin_bad_diag(bad)) }
      )
  }
}

labels { punct_run_done: Toks };

fn skip_punct_run(ts: Toks, code: I32) -> Toks {
  Punct_run_done.get(loop(
    , .(remaining: Toks) {
        if! sig_head_is(remaining, code) {
          widen_sum!(sig_rest(remaining), Toks | Punct_run_done)
        } else {
          widen_sum!({punct_run_done = remaining}, Toks | Punct_run_done)
        }
      }
    , ts
    ))
}

fn canonical_starts_atom(ts: Toks) -> Bool {
  match! sig_head_word(ts) {
    (
      , .(_name: String) { .t(Bool) }
      , .(_notword: .) {
          if! sig_head_is(ts, 33(I32)) {
            .t(Bool)
          } else if! sig_head_is(ts, 46(I32)) {
            .t(Bool)
          } else {
            sig_head_is(ts, 40(I32))
          }
        }
      )
  }
}

labels { ctp_expr: Toks };

labels { ctp_chain: Toks };

labels { ctp_arrow: Toks };

labels { ctp_atom: Toks };

labels { ctp_return: Canonical_type & Toks };

labels { ctp_chain_return: Canonical_type & Toks & Bool };

type Ctp_task_shape = Ctp_expr | Ctp_chain | Ctp_arrow | Ctp_atom | Ctp_return | Ctp_chain_return;

labels { ctp_task: Ctp_task_shape };

labels { ctc_done: . };

labels { ctp_head_canonical: Canonical_type };

labels { ctp_head_exact: Exact_type_head & Alias_refs };

type Ctp_head = Ctp_head_canonical | Ctp_head_exact;

rec {
  labels { ctc_prefix: Canonical_binders & Type_env & Ctp_cont };
  labels { ctc_expr_chain: Ctp_cont };
  labels { ctc_expr_arrow: Canonical_type & Ctp_cont };
  labels { ctc_arrow_atom: Ctp_cont };
  labels { ctc_arrow_rhs: Canonical_type & Ctp_cont };
  labels { ctc_chain_first: (. | Bool) & Ctp_cont };
  labels { ctc_chain_item: Bool & Canonical_types & Ctp_cont };
  labels { ctc_paren: Ctp_cont };
  labels { ctc_app_arg: Ctp_head & Canonical_types & Ctp_cont };
  labels { ctc_alias_return: Type_env & Toks & Ctp_cont & Type_dependencies };
  type Ctp_cont_shape =
    | Ctc_done
    | Ctc_prefix
    | Ctc_expr_chain
    | Ctc_expr_arrow
    | Ctc_arrow_atom
    | Ctc_arrow_rhs
    | Ctc_chain_first
    | Ctc_chain_item
    | Ctc_paren
    | Ctc_app_arg
    | Ctc_alias_return;
  labels { ctp_cont: Ctp_cont_shape }
}

labels { ctp_state: Ctp_task & Ctp_cont & Type_env };

labels { ctp_ok: Canonical_type & Toks & Type_env };

labels { ctp_bad: Diag };

type Canonical_type_result = Ctp_ok | Ctp_bad;

fn mk_ctp_state(task: Ctp_task, cont: Ctp_cont, env: Type_env) -> Ctp_state {
  {ctp_state = (task, (cont, env))}
}

fn ctp_parse_expr(ts: Toks, cont: Ctp_cont, env: Type_env) -> Ctp_state | Canonical_type_result {
  widen_sum!(
    , mk_ctp_state({ctp_task = widen_sum!({ctp_expr = ts}, Ctp_task_shape)}, cont, env)
    , Ctp_state | Canonical_type_result
    )
}

fn ctp_parse_chain(ts: Toks, cont: Ctp_cont, env: Type_env) -> Ctp_state | Canonical_type_result {
  widen_sum!(
    , mk_ctp_state({ctp_task = widen_sum!({ctp_chain = ts}, Ctp_task_shape)}, cont, env)
    , Ctp_state | Canonical_type_result
    )
}

fn ctp_parse_arrow(ts: Toks, cont: Ctp_cont, env: Type_env) -> Ctp_state | Canonical_type_result {
  widen_sum!(
    , mk_ctp_state({ctp_task = widen_sum!({ctp_arrow = ts}, Ctp_task_shape)}, cont, env)
    , Ctp_state | Canonical_type_result
    )
}

fn ctp_parse_atom(ts: Toks, cont: Ctp_cont, env: Type_env) -> Ctp_state | Canonical_type_result {
  widen_sum!(
    , mk_ctp_state({ctp_task = widen_sum!({ctp_atom = ts}, Ctp_task_shape)}, cont, env)
    , Ctp_state | Canonical_type_result
    )
}

fn ctp_return_type(t: Canonical_type, rest: Toks, cont: Ctp_cont, env: Type_env) ->
  Ctp_state | Canonical_type_result
   {
  widen_sum!(
    , mk_ctp_state({ctp_task = widen_sum!({ctp_return = (t, rest)}, Ctp_task_shape)}, cont, env)
    , Ctp_state | Canonical_type_result
    )
}

fn ctp_return_chain(t: Canonical_type, rest: Toks, chain: Bool, cont: Ctp_cont, env: Type_env) ->
  Ctp_state | Canonical_type_result
   {
  widen_sum!(
    , mk_ctp_state(
        , {ctp_task = widen_sum!({ctp_chain_return = (t, (rest, chain))}, Ctp_task_shape)}
        , cont
        , env
        )
    , Ctp_state | Canonical_type_result
    )
}

fn canonical_parse_failure(detail: String) -> Ctp_state | Canonical_type_result {
  widen_sum!(
    , widen_sum!({ctp_bad = canonical_parse_diag(detail)}, Canonical_type_result)
    , Ctp_state | Canonical_type_result
    )
}

fn punct_after_arrow(ts: Toks) -> . | Toks {
  if! sig_head_is(ts, 45(I32)) {
    let after_minus = sig_rest(ts);
    if! sig_head_is(after_minus, 62(I32)) {
      widen_sum!(sig_rest(after_minus), . | Toks)
    } else {
      widen_sum!((), . | Toks)
    }
  } else {
    widen_sum!((), . | Toks)
  }
}

fn chain_kind(ts: Toks) -> . | Bool {
  if! sig_head_is(ts, 38(I32)) {
    widen_sum!(.t(Bool), . | Bool)
  } else if! sig_head_is(ts, 124(I32)) {
    widen_sum!(.f(Bool), . | Bool)
  } else {
    widen_sum!((), . | Bool)
  }
}

fn skip_chain(ts: Toks, product: Bool) -> Toks {
  if! product {
    skip_punct_run(ts, 38(I32))
  } else {
    skip_punct_run(ts, 124(I32))
  }
}

fn opposite_chain(ts: Toks, product: Bool) -> Bool {
  if! product {
    sig_head_is(ts, 124(I32))
  } else {
    sig_head_is(ts, 38(I32))
  }
}

fn finish_chain(reversed: Canonical_types, product: Bool, rest: Toks, cont: Ctp_cont, env: Type_env) ->
  Ctp_state | Canonical_type_result
   {
  if! canonical_types_have_base_kind(reversed) {
    ctp_return_chain(fold_canonical_chain(reversed, product), rest, .t(Bool), cont, env)
  } else {
    canonical_parse_failure("product and sum operands must have base kind"(String))
  }
}

fn continue_chain(
  , product: Bool
  , reversed: Canonical_types
  , rest: Toks
  , cont: Ctp_cont
  , env: Type_env
  ) -> Ctp_state | Canonical_type_result {
  if! opposite_chain(rest, product) {
    canonical_parse_failure("mixing `&` and `|` requires explicit parentheses"(String))
  } else match! chain_kind(rest) {
    (
      , .(same: Bool) {
          if! eq_i32(
            , if! same {
                1(I32)
              } else {
                0(I32)
              }
            , if! product {
                1(I32)
              } else {
                0(I32)
              }
            ) {
            let after = skip_chain(rest, product);
            if! canonical_starts_atom(after) {
              ctp_parse_atom(
                , after
                , {ctp_cont = widen_sum!(
                    , {ctc_chain_item = (product, (reversed, cont))}
                    , Ctp_cont_shape
                    )}
                , env
                )
            } else {
              finish_chain(reversed, product, after, cont, env)
            }
          } else {
            canonical_parse_failure("mixing `&` and `|` requires explicit parentheses"(String))
          }
        }
      , .(_none: .) { finish_chain(reversed, product, rest, cont, env) }
      )
  }
}

fn ctp_head_canonical(head: Canonical_type) -> Ctp_head {
  widen_sum!({ctp_head_canonical = head}, Ctp_head)
}

fn ctp_head_exact(head: Exact_type_head, aliases: Alias_refs) -> Ctp_head {
  widen_sum!({ctp_head_exact = (head, aliases)}, Ctp_head)
}

fn type_substs_for_alias(binders: Binders, reversed_args: Canonical_types) -> Type_substs | Diag {
  loop(
    , .(state: Binders & Canonical_types & Type_substs) {
        match! state {
          .(remaining_binders: Binders, remaining_args: Canonical_types, substs: Type_substs) {
            match! un_binders(remaining_binders) {
              (
                , .(binder: Binder_info, rest_binders: Binders) {
                    match! Binder_info.get(binder) {
                      .(name: String, _stars: I32) {
                        match! un_canonical_types(remaining_args) {
                          (
                            , .(argument: Canonical_type, rest_args: Canonical_types) {
                                widen_sum!(
                                  , (
                                      , rest_binders
                                      , (rest_args, type_substs_cons(name, argument, substs))
                                      )
                                  , (Binders & Canonical_types & Type_substs) | Type_substs | Diag
                                  )
                              }
                            , .(_missing_arg: .) {
                                widen_sum!(
                                  , canonical_parse_diag("transparent alias application has too few arguments"(String))
                                  , (Binders & Canonical_types & Type_substs) | Type_substs | Diag
                                  )
                              }
                            )
                        }
                      }
                    }
                  }
                , .(_no_binders: .) {
                    match! un_canonical_types(remaining_args) {
                      (
                        , .(_extra: Canonical_type, _rest: Canonical_types) {
                            widen_sum!(
                              , canonical_parse_diag("transparent alias application has too many arguments"(String))
                              , (Binders & Canonical_types & Type_substs) | Type_substs | Diag
                              )
                          }
                        , .(_done: .) {
                            widen_sum!(
                              , substs
                              , (Binders & Canonical_types & Type_substs) | Type_substs | Diag
                              )
                          }
                        )
                    }
                  }
                )
            }
          }
        }
      }
    , (binders, (canonical_types_reverse(reversed_args), type_substs_nil()))
    )
}

fn alias_underapplication_detail(alias: Alias_decl, args: Canonical_types) -> String {
  let required = binders_len(tyalias_binders(alias));
  let supplied = canonical_types_len(args);
  let required_noun =
    if! eq_i32(required, 1(I32)) {
      " type argument, but "(String)
    } else {
      " type arguments, but "(String)
    };
  let supplied_verb =
    if! eq_i32(supplied, 1(I32)) {
      " was supplied"(String)
    } else {
      " were supplied"(String)
    };
  string_concat(
    , "type alias `"(String)
    , string_concat(
        , tyalias_name(alias)
        , string_concat(
            , "` requires "(String)
            , string_concat(
                , int_to_string(required)
                , string_concat(
                    , required_noun
                    , string_concat(int_to_string(supplied), supplied_verb)
                    )
                )
            )
        )
    )
}

fn start_alias_expansion(
  , owner: String
  , alias: Alias_decl
  , args: Canonical_types
  , inherited_aliases: Alias_refs
  , caller_rest: Toks
  , parent: Ctp_cont
  , saved: Type_env
  ) -> Ctp_state | Canonical_type_result {
  let preserved_dependencies =
    type_dependencies_union(
      , canonical_types_dependencies(args)
      , type_dependencies_union(
          , alias_type_dependency(owner, tyalias_name(alias))
          , alias_refs_dependencies(inherited_aliases)
          )
      );
  match! validate_application_args(host_param_kinds(tyalias_binders(alias)), args) {
    (
      , .(remaining: Param_kinds) {
          match! un_param_kinds(remaining) {
            (
              , .(_next: Param_kind, _rest: Param_kinds) {
                  canonical_parse_failure(alias_underapplication_detail(alias, args))
                }
              , .(_saturated: .) {
                  if! alias_refs_has(type_env_aliases(saved), owner, tyalias_name(alias)) {
                    canonical_parse_failure(string_concat(
                      , "transparent alias cycle reaches `"(String)
                      , string_concat(
                          , owner
                          , string_concat(
                              , "."(String)
                              , string_concat(tyalias_name(alias), "`"(String))
                              )
                          )
                      ))
                  } else match! type_substs_for_alias(tyalias_binders(alias), args) {
                    (
                      , .(substs: Type_substs) {
                          match! find_module(type_context_modules(type_env_context(saved)), owner) {
                            (
                              , .(module: Module) {
                                  let context =
                                    mk_type_context(
                                      , type_context_modules(type_env_context(saved))
                                      , type_context_host_types(type_env_context(saved))
                                      , module
                                      , tyalias_decl_pos(alias)
                                      , tyalias_recursive_scope(alias)
                                      );
                                  let alias_env =
                                    mk_type_env(
                                      , context
                                      , type_bounds_nil()
                                      , substs
                                      , alias_refs_cons(
                                          , owner
                                          , tyalias_name(alias)
                                          , type_env_aliases(saved)
                                          )
                                      , type_env_next(saved)
                                      );
                                  ctp_parse_expr(
                                    , tyalias_body(alias)
                                    , {ctp_cont = widen_sum!(
                                        , {ctc_alias_return = (
                                            , saved
                                            , (caller_rest, (parent, preserved_dependencies))
                                            )}
                                        , Ctp_cont_shape
                                        )}
                                    , alias_env
                                    )
                                }
                              , .(_missing_owner: .) {
                                  canonical_parse_failure(string_concat(
                                    , "transparent alias owner module is absent: `"(String)
                                    , string_concat(owner, "`"(String))
                                    ))
                                }
                              )
                          }
                        }
                      , .(diag: Diag) {
                          widen_sum!(
                            , widen_sum!({ctp_bad = diag}, Canonical_type_result)
                            , Ctp_state | Canonical_type_result
                            )
                        }
                      )
                  }
                }
              )
          }
        }
      , .(diag: Diag) {
          widen_sum!(
            , widen_sum!({ctp_bad = diag}, Canonical_type_result)
            , Ctp_state | Canonical_type_result
            )
        }
      )
  }
}

fn canonical_application_return(
  , head: Canonical_type
  , args: Canonical_types
  , rest: Toks
  , parent: Ctp_cont
  , env: Type_env
  ) -> Ctp_state | Canonical_type_result {
  match! canonical_application(head, args) {
    (
      , .(ok: Canonical_application_ok) {
          ctp_return_type(Canonical_application_ok.get(ok), rest, parent, env)
        }
      , .(bad: Canonical_application_bad) {
          widen_sum!(
            , widen_sum!({ctp_bad = Canonical_application_bad.get(bad)}, Canonical_type_result)
            , Ctp_state | Canonical_type_result
            )
        }
      )
  }
}

fn finish_head_application(
  , head: Ctp_head
  , args: Canonical_types
  , rest: Toks
  , parent: Ctp_cont
  , env: Type_env
  ) -> Ctp_state | Canonical_type_result {
  match! head {
    (
      , .(canonical: Ctp_head_canonical) {
          canonical_application_return(Ctp_head_canonical.get(canonical), args, rest, parent, env)
        }
      , .(exact: Ctp_head_exact) {
          match! Ctp_head_exact.get(exact) {
            .(resolved: Exact_type_head, aliases: Alias_refs) {
              match! resolved {
                (
                  , .(host: Exact_head_host) {
                      canonical_application_return(
                        , canonical_type_with_alias_refs(
                            , canonical_host_atom(Exact_head_host.get(host))
                            , aliases
                            )
                        , args
                        , rest
                        , parent
                        , env
                        )
                    }
                  , .(nominal: Exact_head_nominal) {
                      match! Exact_head_nominal.get(nominal) {
                        .(id: Host_id, params: Param_kinds) {
                          canonical_application_return(
                            , canonical_type_with_alias_refs(
                                , canonical_nominal_atom(id, params)
                                , aliases
                                )
                            , args
                            , rest
                            , parent
                            , env
                            )
                        }
                      }
                    }
                  , .(alias_head: Exact_head_alias) {
                      match! Exact_head_alias.get(alias_head) {
                        .(owner: String, alias: Alias_decl) {
                          start_alias_expansion(owner, alias, args, aliases, rest, parent, env)
                        }
                      }
                    }
                  )
              }
            }
          }
        }
      )
  }
}

fn continue_type_head(head: Ctp_head, rest: Toks, parent: Ctp_cont, env: Type_env) ->
  Ctp_state | Canonical_type_result
   {
  if! sig_head_is(rest, 40(I32)) {
    let args0 = skip_punct_run(sig_rest(rest), 44(I32));
    if! sig_head_is(args0, 41(I32)) {
      canonical_parse_failure("type application requires at least one argument"(String))
    } else {
      ctp_parse_expr(
        , args0
        , {ctp_cont = widen_sum!(
            , {ctc_app_arg = (head, (canonical_types_nil(), parent))}
            , Ctp_cont_shape
            )}
        , env
        )
    }
  } else match! head {
    (
      , .(canonical: Ctp_head_canonical) {
          ctp_return_type(Ctp_head_canonical.get(canonical), rest, parent, env)
        }
      , .(exact: Ctp_head_exact) {
          match! Ctp_head_exact.get(exact) {
            .(resolved: Exact_type_head, aliases: Alias_refs) {
              match! resolved {
                (
                  , .(host: Exact_head_host) {
                      ctp_return_type(
                        , canonical_type_with_alias_refs(
                            , canonical_host_atom(Exact_head_host.get(host))
                            , aliases
                            )
                        , rest
                        , parent
                        , env
                        )
                    }
                  , .(nominal: Exact_head_nominal) {
                      match! Exact_head_nominal.get(nominal) {
                        .(id: Host_id, params: Param_kinds) {
                          ctp_return_type(
                            , canonical_type_with_alias_refs(
                                , canonical_nominal_atom(id, params)
                                , aliases
                                )
                            , rest
                            , parent
                            , env
                            )
                        }
                      }
                    }
                  , .(alias_head: Exact_head_alias) {
                      match! Exact_head_alias.get(alias_head) {
                        .(owner: String, alias: Alias_decl) {
                          if! eq_i32(binders_len(tyalias_binders(alias)), 0(I32)) {
                            start_alias_expansion(
                              , owner
                              , alias
                              , canonical_types_nil()
                              , aliases
                              , rest
                              , parent
                              , env
                              )
                          } else {
                            canonical_parse_failure(alias_underapplication_detail(
                              , alias
                              , canonical_types_nil()
                              ))
                          }
                        }
                      }
                    }
                  )
              }
            }
          }
        }
      )
  }
}

fn ctp_step(state: Ctp_state) -> Ctp_state | Canonical_type_result {
  match! Ctp_state.get(state) {
    .(task: Ctp_task, cont: Ctp_cont, env: Type_env) {
      match! Ctp_task.get(task) {
        (
          , .(expr: Ctp_expr) {
              let ts = Ctp_expr.get(expr);
              match! parse_host_binders(ts) {
                (
                  , .(done: Host_binders_done) {
                      match! Host_binders_done.get(done) {
                        .(bs: Binders, after: Toks) {
                          if! eq_i32(binders_len(bs), 0(I32)) {
                            ctp_parse_chain(
                              , ts
                              , {ctp_cont = widen_sum!({ctc_expr_chain = cont}, Ctp_cont_shape)}
                              , env
                              )
                          } else if! binders_have_base_kind(bs) {
                            match! Canonical_binders_result.get(canonicalize_binders(bs, env)) {
                              .(renamed: Canonical_binders, extended: Type_env) {
                                ctp_parse_expr(
                                  , after
                                  , {ctp_cont = widen_sum!(
                                      , {ctc_prefix = (renamed, (env, cont))}
                                      , Ctp_cont_shape
                                      )}
                                  , extended
                                  )
                              }
                            }
                          } else {
                            canonical_parse_failure("embedded forall binders must have base kind"(String))
                          }
                        }
                      }
                    }
                  , .(bad: Host_binders_bad) { canonical_parse_failure(Host_binders_bad.get(bad)) }
                  )
              }
            }
          , .(chain: Ctp_chain) {
              let ts = Ctp_chain.get(chain);
              match! chain_kind(ts) {
                (
                  , .(product: Bool) {
                      let after = skip_chain(ts, product);
                      if! opposite_chain(after, product) {
                        canonical_parse_failure("mixing `&` and `|` requires explicit parentheses"(String))
                      } else if! canonical_starts_atom(after) {
                        ctp_parse_arrow(
                          , after
                          , {ctp_cont = widen_sum!(
                              , {ctc_chain_first = (widen_sum!(product, . | Bool), cont)}
                              , Ctp_cont_shape
                              )}
                          , env
                          )
                      } else {
                        ctp_return_chain(
                          , if! product {
                              canonical_unit()
                            } else {
                              canonical_bottom()
                            }
                          , after
                          , .t(Bool)
                          , cont
                          , env
                          )
                      }
                    }
                  , .(_none: .) {
                      ctp_parse_arrow(
                        , ts
                        , {ctp_cont = widen_sum!(
                            , {ctc_chain_first = (widen_sum!((), . | Bool), cont)}
                            , Ctp_cont_shape
                            )}
                        , env
                        )
                    }
                  )
              }
            }
          , .(arrow: Ctp_arrow) {
              ctp_parse_atom(
                , Ctp_arrow.get(arrow)
                , {ctp_cont = widen_sum!({ctc_arrow_atom = cont}, Ctp_cont_shape)}
                , env
                )
            }
          , .(atom: Ctp_atom) {
              let ts = Ctp_atom.get(atom);
              if! sig_head_is(ts, 33(I32)) {
                ctp_return_type(canonical_bottom(), sig_rest(ts), cont, env)
              } else if! sig_head_is(ts, 46(I32)) {
                ctp_return_type(canonical_unit(), sig_rest(ts), cont, env)
              } else if! sig_head_is(ts, 40(I32)) {
                ctp_parse_expr(
                  , sig_rest(ts)
                  , {ctp_cont = widen_sum!({ctc_paren = cont}, Ctp_cont_shape)}
                  , env
                  )
              } else match! read_type_path(ts) {
                (
                  , .(read: Type_path_read) {
                      match! Type_path_read.get(read) {
                        .(name: String, rest: Toks) {
                          if! string_eq(name, "_"(String)) {
                            canonical_parse_failure("`_` is not allowed in an exact host-function signature"(String))
                          } else match! type_bound_index(type_env_bounds(env), name) {
                            (
                              , .(index: I32) {
                                  match! type_bound_kind(type_env_bounds(env), name) {
                                    (
                                      , .(kind: Param_kind) {
                                          continue_type_head(
                                            , ctp_head_canonical(canonical_atom_params(
                                                , canonical_render_bound(index)
                                                , params_from_binder_kind(kind)
                                                ))
                                            , rest
                                            , cont
                                            , env
                                            )
                                        }
                                      , .(_missing_kind: .) {
                                          canonical_parse_failure("resolved type binder has no retained kind"(String))
                                        }
                                      )
                                  }
                                }
                              , .(_not_bound: .) {
                                  match! type_subst_find(type_env_substs(env), name) {
                                    (
                                      , .(substituted: Canonical_type) {
                                          continue_type_head(
                                            , ctp_head_canonical(substituted)
                                            , rest
                                            , cont
                                            , env
                                            )
                                        }
                                      , .(_not_substituted: .) {
                                          match! resolve_exact_type_head(name, env) {
                                            (
                                              , .(ok: Exact_type_head_ok) {
                                                  continue_type_head(
                                                    , ctp_head_exact(
                                                        , exact_type_head_ok_head(ok)
                                                        , exact_type_head_ok_aliases(ok)
                                                        )
                                                    , rest
                                                    , cont
                                                    , env
                                                    )
                                                }
                                              , .(bad: Exact_type_head_bad) {
                                                  widen_sum!(
                                                    , widen_sum!(
                                                        , {ctp_bad = Exact_type_head_bad.get(bad)}
                                                        , Canonical_type_result
                                                        )
                                                    , Ctp_state | Canonical_type_result
                                                    )
                                                }
                                              )
                                          }
                                        }
                                      )
                                  }
                                }
                              )
                          }
                        }
                      }
                    }
                  , .(_notword: .) { canonical_parse_failure("expected a type"(String)) }
                  )
              }
            }
          , .(returned: Ctp_return) {
              match! Ctp_return.get(returned) {
                .(value: Canonical_type, rest: Toks) {
                  match! Ctp_cont.get(cont) {
                    (
                      , .(_done: Ctc_done) {
                          widen_sum!(
                            , widen_sum!({ctp_ok = (value, (rest, env))}, Canonical_type_result)
                            , Ctp_state | Canonical_type_result
                            )
                        }
                      , .(prefix: Ctc_prefix) {
                          match! Ctc_prefix.get(prefix) {
                            .(bs: Canonical_binders, saved: Type_env, parent: Ctp_cont) {
                              if! canonical_type_has_base_kind(value) {
                                ctp_return_type(
                                  , canonical_forall(bs, value)
                                  , rest
                                  , parent
                                  , restore_type_env(saved, env)
                                  )
                              } else {
                                canonical_parse_failure("a forall body must have base kind"(String))
                              }
                            }
                          }
                        }
                      , .(_bad: Ctc_expr_chain) {
                          canonical_parse_failure("internal canonical parser continuation mismatch"(String))
                        }
                      , .(outer_arrow: Ctc_expr_arrow) {
                          match! Ctc_expr_arrow.get(outer_arrow) {
                            .(left: Canonical_type, parent: Ctp_cont) {
                              if! canonical_type_has_base_kind(left) {
                                if! canonical_type_has_base_kind(value) {
                                  ctp_return_type(canonical_arrow(left, value), rest, parent, env)
                                } else {
                                  canonical_parse_failure("an arrow result must have base kind"(String))
                                }
                              } else {
                                canonical_parse_failure("an arrow parameter must have base kind"(String))
                              }
                            }
                          }
                        }
                      , .(after_atom: Ctc_arrow_atom) {
                          let parent = Ctc_arrow_atom.get(after_atom);
                          match! punct_after_arrow(rest) {
                            (
                              , .(rhs: Toks) {
                                  ctp_parse_expr(
                                    , rhs
                                    , {ctp_cont = widen_sum!(
                                        , {ctc_arrow_rhs = (value, parent)}
                                        , Ctp_cont_shape
                                        )}
                                    , env
                                    )
                                }
                              , .(_no_arrow: .) { ctp_return_type(value, rest, parent, env) }
                              )
                          }
                        }
                      , .(arrow_rhs: Ctc_arrow_rhs) {
                          match! Ctc_arrow_rhs.get(arrow_rhs) {
                            .(left: Canonical_type, parent: Ctp_cont) {
                              if! canonical_type_has_base_kind(left) {
                                if! canonical_type_has_base_kind(value) {
                                  ctp_return_type(canonical_arrow(left, value), rest, parent, env)
                                } else {
                                  canonical_parse_failure("an arrow result must have base kind"(String))
                                }
                              } else {
                                canonical_parse_failure("an arrow parameter must have base kind"(String))
                              }
                            }
                          }
                        }
                      , .(first: Ctc_chain_first) {
                          match! Ctc_chain_first.get(first) {
                            .(leading: . | Bool, parent: Ctp_cont) {
                              match! leading {
                                (
                                  , .(product: Bool) {
                                      continue_chain(
                                        , product
                                        , canonical_types_cons(value, canonical_types_nil())
                                        , rest
                                        , parent
                                        , env
                                        )
                                    }
                                  , .(_none: .) {
                                      match! chain_kind(rest) {
                                        (
                                          , .(product: Bool) {
                                              continue_chain(
                                                , product
                                                , canonical_types_cons(value, canonical_types_nil())
                                                , rest
                                                , parent
                                                , env
                                                )
                                            }
                                          , .(_no_chain: .) {
                                              ctp_return_chain(value, rest, .f(Bool), parent, env)
                                            }
                                          )
                                      }
                                    }
                                  )
                              }
                            }
                          }
                        }
                      , .(item: Ctc_chain_item) {
                          match! Ctc_chain_item.get(item) {
                            .(product: Bool, reversed: Canonical_types, parent: Ctp_cont) {
                              continue_chain(
                                , product
                                , canonical_types_cons(value, reversed)
                                , rest
                                , parent
                                , env
                                )
                            }
                          }
                        }
                      , .(paren: Ctc_paren) {
                          let parent = Ctc_paren.get(paren);
                          if! sig_head_is(rest, 41(I32)) {
                            ctp_return_type(value, sig_rest(rest), parent, env)
                          } else {
                            canonical_parse_failure("expected `)` after grouped type"(String))
                          }
                        }
                      , .(app: Ctc_app_arg) {
                          match! Ctc_app_arg.get(app) {
                            .(head: Ctp_head, reversed: Canonical_types, parent: Ctp_cont) {
                              let args1 = canonical_types_cons(value, reversed);
                              if! sig_head_is(rest, 41(I32)) {
                                finish_head_application(head, args1, sig_rest(rest), parent, env)
                              } else if! sig_head_is(rest, 44(I32)) {
                                let after_commas = skip_punct_run(rest, 44(I32));
                                if! sig_head_is(after_commas, 41(I32)) {
                                  finish_head_application(
                                    , head
                                    , args1
                                    , sig_rest(after_commas)
                                    , parent
                                    , env
                                    )
                                } else {
                                  ctp_parse_expr(
                                    , after_commas
                                    , {ctp_cont = widen_sum!(
                                        , {ctc_app_arg = (head, (args1, parent))}
                                        , Ctp_cont_shape
                                        )}
                                    , env
                                    )
                                }
                              } else {
                                canonical_parse_failure("expected `,` or `)` after type argument"(String))
                              }
                            }
                          }
                        }
                      , .(alias_return: Ctc_alias_return) {
                          match! Ctc_alias_return.get(alias_return) {
                            .(
                              , saved: Type_env
                              , caller_rest: Toks
                              , parent: Ctp_cont
                              , preserved_dependencies: Type_dependencies
                              ) {
                              if! toks_empty(rest) {
                                ctp_return_type(
                                  , canonical_type_with_extra_dependencies(
                                      , value
                                      , preserved_dependencies
                                      )
                                  , caller_rest
                                  , parent
                                  , restore_type_env(saved, env)
                                  )
                              } else {
                                canonical_parse_failure("transparent alias body contains trailing type syntax"(String))
                              }
                            }
                          }
                        }
                      )
                  }
                }
              }
            }
          , .(chain_result: Ctp_chain_return) {
              match! Ctp_chain_return.get(chain_result) {
                .(value: Canonical_type, rest: Toks, was_chain: Bool) {
                  match! Ctp_cont.get(cont) {
                    (
                      , .(after_chain: Ctc_expr_chain) {
                          let parent = Ctc_expr_chain.get(after_chain);
                          match! punct_after_arrow(rest) {
                            (
                              , .(rhs: Toks) {
                                  if! was_chain {
                                    canonical_parse_failure("product and sum types on the left of `->` must be parenthesized"(String))
                                  } else {
                                    ctp_parse_expr(
                                      , rhs
                                      , {ctp_cont = widen_sum!(
                                          , {ctc_expr_arrow = (value, parent)}
                                          , Ctp_cont_shape
                                          )}
                                      , env
                                      )
                                  }
                                }
                              , .(_no_arrow: .) { ctp_return_type(value, rest, parent, env) }
                              )
                          }
                        }
                      , .(_other: Ctc_done) {
                          canonical_parse_failure("internal canonical parser continuation mismatch"(String))
                        }
                      , .(_other: Ctc_prefix) {
                          canonical_parse_failure("internal canonical parser continuation mismatch"(String))
                        }
                      , .(_other: Ctc_expr_arrow) {
                          canonical_parse_failure("internal canonical parser continuation mismatch"(String))
                        }
                      , .(_other: Ctc_arrow_atom) {
                          canonical_parse_failure("internal canonical parser continuation mismatch"(String))
                        }
                      , .(_other: Ctc_arrow_rhs) {
                          canonical_parse_failure("internal canonical parser continuation mismatch"(String))
                        }
                      , .(_other: Ctc_chain_first) {
                          canonical_parse_failure("internal canonical parser continuation mismatch"(String))
                        }
                      , .(_other: Ctc_chain_item) {
                          canonical_parse_failure("internal canonical parser continuation mismatch"(String))
                        }
                      , .(_other: Ctc_paren) {
                          canonical_parse_failure("internal canonical parser continuation mismatch"(String))
                        }
                      , .(_other: Ctc_app_arg) {
                          canonical_parse_failure("internal canonical parser continuation mismatch"(String))
                        }
                      , .(_other: Ctc_alias_return) {
                          canonical_parse_failure("internal canonical parser continuation mismatch"(String))
                        }
                      )
                  }
                }
              }
            }
          )
      }
    }
  }
}

fn parse_canonical_type(ts: Toks, env: Type_env) -> Canonical_type_result {
  loop(
    , ctp_step
    , mk_ctp_state(
        , {ctp_task = widen_sum!({ctp_expr = ts}, Ctp_task_shape)}
        , {ctp_cont = widen_sum!({ctc_done=}, Ctp_cont_shape)}
        , env
        )
    )
}

labels { parsed_host_group: Canonical_type & I32 & Toks & Type_env };

type Parsed_host_group_result = Parsed_host_group | Diag;

labels { host_group_parse_state: Toks & Canonical_types & Type_env };

fn host_signature_subject(id: Host_id) -> String {
  string_concat(
    , "dyn_load_prime: malformed host function `"(String)
    , string_concat(host_id_render(id), "`"(String))
    )
}

fn signature_diag(subject: String, detail: String) -> Diag {
  mk_diag(string_concat(subject, string_concat(": "(String), detail)))
}

fn host_group_success(reversed: Canonical_types, rest: Toks, env: Type_env) -> Parsed_host_group_result {
  let domain = fold_canonical_chain(reversed, .t(Bool));
  let slots =
    if! canonical_type_is_unit(domain) {
      0(I32)
    } else {
      canonical_type_tail_slots(domain)
    };
  widen_sum!({parsed_host_group = (domain, (slots, (rest, env)))}, Parsed_host_group_result)
}

fn parse_host_value_group(subject: String, ts: Toks, initial: Type_env) -> Parsed_host_group_result {
  if! sig_head_is(ts, 40(I32)) {
    loop(
      , .(state: Host_group_parse_state) {
          match! Host_group_parse_state.get(state) {
            .(remaining: Toks, reversed: Canonical_types, env: Type_env) {
              let at_parameter = skip_punct_run(remaining, 44(I32));
              if! sig_head_is(at_parameter, 41(I32)) {
                widen_sum!(
                  , host_group_success(reversed, sig_rest(at_parameter), env)
                  , Host_group_parse_state | Parsed_host_group_result
                  )
              } else match! sig_head_word(at_parameter) {
                (
                  , .(_parameter: String) {
                      let after_name = sig_rest(at_parameter);
                      if! sig_head_is(after_name, 58(I32)) {
                        match! parse_canonical_type(sig_rest(after_name), env) {
                          (
                            , .(ok: Ctp_ok) {
                                match! Ctp_ok.get(ok) {
                                  .(
                                    , parameter_type: Canonical_type
                                    , after_type: Toks
                                    , next_env: Type_env
                                    ) {
                                    match! canonical_type_kind(parameter_type) {
                                      (
                                        , .(kind: Param_kind) {
                                            if! param_kind_eq(kind, base_kind()) {
                                              let next_reversed = canonical_types_cons(
                                                , parameter_type
                                                , reversed
                                                );
                                              if! sig_head_is(after_type, 44(I32)) {
                                                widen_sum!(
                                                  , {host_group_parse_state = (
                                                      , after_type
                                                      , (next_reversed, next_env)
                                                      )}
                                                  , (| Host_group_parse_state
                                                    | Parsed_host_group_result)
                                                  )
                                              } else if! sig_head_is(after_type, 41(I32)) {
                                                widen_sum!(
                                                  , host_group_success(
                                                      , next_reversed
                                                      , sig_rest(after_type)
                                                      , next_env
                                                      )
                                                  , (| Host_group_parse_state
                                                    | Parsed_host_group_result)
                                                  )
                                              } else {
                                                widen_sum!(
                                                  , signature_diag(
                                                      , subject
                                                      , "expected `,` or `)` after a value parameter type"(String)
                                                      )
                                                  , (| Host_group_parse_state
                                                    | Parsed_host_group_result)
                                                  )
                                              }
                                            } else {
                                              widen_sum!(
                                                , signature_diag(
                                                    , subject
                                                    , "a value parameter type must have base kind"(String)
                                                    )
                                                , Host_group_parse_state | Parsed_host_group_result
                                                )
                                            }
                                          }
                                        , .(_unknown: .) {
                                            widen_sum!(
                                              , signature_diag(
                                                  , subject
                                                  , "a value parameter type must be fully saturated"(String)
                                                  )
                                              , Host_group_parse_state | Parsed_host_group_result
                                              )
                                          }
                                        )
                                    }
                                  }
                                }
                              }
                            , .(bad: Ctp_bad) {
                                widen_sum!(
                                  , signature_diag(subject, diag_message(Ctp_bad.get(bad)))
                                  , Host_group_parse_state | Parsed_host_group_result
                                  )
                              }
                            )
                        }
                      } else {
                        widen_sum!(
                          , signature_diag(
                              , subject
                              , "expected `:` after a value parameter name"(String)
                              )
                          , Host_group_parse_state | Parsed_host_group_result
                          )
                      }
                    }
                  , .(_missing_name: .) {
                      widen_sum!(
                        , signature_diag(subject, "expected a value parameter name"(String))
                        , Host_group_parse_state | Parsed_host_group_result
                        )
                    }
                  )
              }
            }
          }
        }
      , {host_group_parse_state = (sig_rest(ts), (canonical_types_nil(), initial))}
      )
  } else {
    widen_sum!(
      , signature_diag(subject, "expected a value-parameter group"(String))
      , Parsed_host_group_result
      )
  }
}

fn group_slots_reverse(groups: Group_slots) -> Group_slots {
  loop(
    , .(state: Group_slots & Group_slots) {
        match! state {
          .(remaining: Group_slots, out: Group_slots) {
            match! un_group_slots(remaining) {
              (
                , .(slots: I32, rest: Group_slots) {
                    widen_sum!(
                      , (rest, group_slots_cons(slots, out))
                      , (Group_slots & Group_slots) | Group_slots
                      )
                  }
                , .(_empty: .) { widen_sum!(out, (Group_slots & Group_slots) | Group_slots) }
                )
            }
          }
        }
      }
    , (groups, group_slots_nil())
    )
}

// Prepends one empty runtime stage per erased unary `forall` binder. The
// list is accumulated in reverse order, so the following value stage is
// consed after these entries and reverses to `(type stages..., value stage)`.
fn group_slots_prepend_type_stages(count: I32, reversed: Group_slots) -> Group_slots {
  loop(
    , .(state: I32 & Group_slots) {
        match! state {
          .(remaining: I32, out: Group_slots) {
            if! leq_i32(remaining, 0(I32)) {
              widen_sum!(out, (I32 & Group_slots) | Group_slots)
            } else {
              widen_sum!(
                , (sub_i32(remaining, 1(I32)), group_slots_cons(0(I32), out))
                , (I32 & Group_slots) | Group_slots
                )
            }
          }
        }
      }
    , (count, reversed)
    )
}

labels { canonical_stage: Canonical_binders & Canonical_type & I32 };

labels { canonical_stages: List(Canonical_stage) };

fn canonical_stages_nil() -> Canonical_stages { {canonical_stages = nil(Canonical_stage, ())} }

fn canonical_stages_cons(
  , binders: Canonical_binders
  , domain: Canonical_type
  , value_slots: I32
  , rest: Canonical_stages
  ) -> Canonical_stages {
  {canonical_stages = cons(
    , Canonical_stage
    , {canonical_stage = (binders, (domain, value_slots))}
    , Canonical_stages.get(rest)
    )}
}

fn un_canonical_stages(stages: Canonical_stages) -> . | (Canonical_stage & Canonical_stages) {
  match! uncons(Canonical_stage, Canonical_stages.get(stages)) {
    (
      , .(head: Canonical_stage, tail: List(Canonical_stage)) {
          widen_sum!((head, {canonical_stages = tail}), . | (Canonical_stage & Canonical_stages))
        }
      , .(_empty: .) { widen_sum!((), . | (Canonical_stage & Canonical_stages)) }
      )
  }
}

// Convert the source-derived stage spine into the evaluator's internal
// application plan. `reversed_stages` is latest-first, so prepending each
// value group and its preceding unary `forall` Unit stages reconstructs source
// order directly. This plan never crosses the host-adapter boundary.
fn runtime_groups_from_reversed_stages(reversed_stages: Canonical_stages) -> Group_slots {
  loop(
    , .(state: Canonical_stages & Group_slots) {
        match! state {
          .(remaining: Canonical_stages, out: Group_slots) {
            match! un_canonical_stages(remaining) {
              (
                , .(stage: Canonical_stage, rest: Canonical_stages) {
                    match! Canonical_stage.get(stage) {
                      .(binders: Canonical_binders, _domain: Canonical_type, slots: I32) {
                        widen_sum!(
                          , (
                              , rest
                              , group_slots_prepend_type_stages(
                                  , canonical_binders_len(binders)
                                  , group_slots_cons(slots, out)
                                  )
                              )
                          , (Canonical_stages & Group_slots) | Group_slots
                          )
                      }
                    }
                  }
                , .(_empty: .) { widen_sum!(out, (Canonical_stages & Group_slots) | Group_slots) }
                )
            }
          }
        }
      }
    , (reversed_stages, group_slots_nil())
    )
}

fn canonical_signature_render(reversed_stages: Canonical_stages, result: Canonical_type) -> Canonical_render {
  loop(
    , .(state: Canonical_stages & Canonical_render) {
        match! state {
          .(remaining: Canonical_stages, suffix: Canonical_render) {
            match! un_canonical_stages(remaining) {
              (
                , .(stage: Canonical_stage, rest: Canonical_stages) {
                    match! Canonical_stage.get(stage) {
                      .(binders: Canonical_binders, domain: Canonical_type, _slots: I32) {
                        let stage_tail =
                          canonical_render_concat3(
                            , canonical_group(domain)
                            , canonical_render_text(" -> "(String))
                            , suffix
                            );
                        let full =
                          if! eq_i32(canonical_binders_len(binders), 0(I32)) {
                            stage_tail
                          } else {
                            canonical_render_scope(
                              , binders
                              , canonical_render_concat3(
                                  , canonical_render_binders(binders)
                                  , canonical_render_text(" "(String))
                                  , stage_tail
                                  )
                              )
                          };
                        widen_sum!(
                          , (rest, full)
                          , (Canonical_stages & Canonical_render) | Canonical_render
                          )
                      }
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(suffix, (Canonical_stages & Canonical_render) | Canonical_render)
                  }
                )
            }
          }
        }
      }
    , (reversed_stages, canonical_type_render(result))
    )
}

labels { derived_hostfn: Runtime_hostfn & Type_dependencies };

type Derived_hostfn_result = Derived_hostfn | Diag;

labels { host_signature_state: Toks & Type_env & Canonical_stages & Group_slots & Type_dependencies };

fn finish_host_signature(
  , id: Host_id
  , reversed_stages: Canonical_stages
  , reversed_groups: Group_slots
  , dependencies: Type_dependencies
  , result: Canonical_type
  ) -> Derived_hostfn_result {
  match! render_canonical_type(canonical_signature_render(reversed_stages, result)) {
    (
      , .(rendered: String) {
          let descriptor = mk_host_fn(id, rendered);
          widen_sum!(
            , {derived_hostfn = (
                , mk_runtime_hostfn(
                    , mk_hostfn(descriptor, group_slots_reverse(reversed_groups))
                    , runtime_groups_from_reversed_stages(reversed_stages)
                    )
                , type_dependencies_union(dependencies, canonical_type_dependencies(result))
                )}
            , Derived_hostfn_result
            )
        }
      , .(diag: Diag) { widen_sum!(diag, Derived_hostfn_result) }
      )
  }
}

fn derive_hostfn_header_with_type_scope(
  , modules: Modules
  , types: Host_types
  , module: Module
  , header: Host_header
  , subject: String
  , recursive_scope: . | Recursive_type_scope
  , initial_substs: Type_substs
  ) -> Derived_hostfn_result {
  let id = mk_host_id(module_name(module), host_header_name(header));
  let context =
    mk_type_context(modules, types, module, host_header_decl_pos(header), recursive_scope);
  let initial_env =
    mk_type_env(context, type_bounds_nil(), initial_substs, alias_refs_nil(), 0(I32));
  loop(
    , .(state: Host_signature_state) {
        match! Host_signature_state.get(state) {
          .(
            , remaining: Toks
            , env: Type_env
            , reversed_stages: Canonical_stages
            , reversed_groups: Group_slots
            , dependencies: Type_dependencies
            ) {
            match! parse_host_binders(remaining) {
              (
                , .(binders_done: Host_binders_done) {
                    match! Host_binders_done.get(binders_done) {
                      .(source_binders: Binders, at_group: Toks) {
                        match! Canonical_binders_result.get(canonicalize_binders(
                          , source_binders
                          , env
                          )) {
                          .(canonical_bs: Canonical_binders, group_env: Type_env) {
                            match! parse_host_value_group(subject, at_group, group_env) {
                              (
                                , .(group: Parsed_host_group) {
                                    match! Parsed_host_group.get(group) {
                                      .(
                                        , domain: Canonical_type
                                        , group_slots: I32
                                        , after_group: Toks
                                        , next_env: Type_env
                                        ) {
                                        let stages =
                                          canonical_stages_cons(
                                            , canonical_bs
                                            , domain
                                            , group_slots
                                            , reversed_stages
                                            );
                                        let groups = group_slots_cons(group_slots, reversed_groups);
                                        let deps =
                                          type_dependencies_union(
                                            , dependencies
                                            , canonical_type_dependencies(domain)
                                            );
                                        match! punct_after_arrow(after_group) {
                                          (
                                            , .(return_tokens: Toks) {
                                                match! parse_canonical_type(return_tokens, next_env) {
                                                  (
                                                    , .(ok: Ctp_ok) {
                                                        match! Ctp_ok.get(ok) {
                                                          .(
                                                            , result: Canonical_type
                                                            , after_result: Toks
                                                            , _final_env: Type_env
                                                            ) {
                                                            if! toks_empty(after_result) {
                                                              match! canonical_type_kind(result) {
                                                                (
                                                                  , .(kind: Param_kind) {
                                                                      if! param_kind_eq(
                                                                        , kind
                                                                        , base_kind()
                                                                        ) {
                                                                        widen_sum!(
                                                                          , finish_host_signature(
                                                                              , id
                                                                              , stages
                                                                              , groups
                                                                              , deps
                                                                              , result
                                                                              )
                                                                          , (| Host_signature_state
                                                                            | Derived_hostfn_result)
                                                                          )
                                                                      } else {
                                                                        widen_sum!(
                                                                          , signature_diag(
                                                                              , subject
                                                                              , "the return type must have base kind"(String)
                                                                              )
                                                                          , (| Host_signature_state
                                                                            | Derived_hostfn_result)
                                                                          )
                                                                      }
                                                                    }
                                                                  , .(_unknown: .) {
                                                                      widen_sum!(
                                                                        , signature_diag(
                                                                            , subject
                                                                            , "the return type must be fully saturated"(String)
                                                                            )
                                                                        , (| Host_signature_state
                                                                          | Derived_hostfn_result)
                                                                        )
                                                                    }
                                                                  )
                                                              }
                                                            } else {
                                                              widen_sum!(
                                                                , signature_diag(
                                                                    , subject
                                                                    , "unexpected tokens after the return type"(String)
                                                                    )
                                                                , (| Host_signature_state
                                                                  | Derived_hostfn_result)
                                                                )
                                                            }
                                                          }
                                                        }
                                                      }
                                                    , .(bad: Ctp_bad) {
                                                        widen_sum!(
                                                          , signature_diag(
                                                              , subject
                                                              , diag_message(Ctp_bad.get(bad))
                                                              )
                                                          , (| Host_signature_state
                                                            | Derived_hostfn_result)
                                                          )
                                                      }
                                                    )
                                                }
                                              }
                                            , .(_no_arrow: .) {
                                                if! toks_empty(after_group) {
                                                  widen_sum!(
                                                    , signature_diag(
                                                        , subject
                                                        , "expected `->` and a return type after the final value group"(String)
                                                        )
                                                    , Host_signature_state | Derived_hostfn_result
                                                    )
                                                } else if! sig_head_is(after_group, 91(I32)) {
                                                  widen_sum!(
                                                    , {host_signature_state = (
                                                        , after_group
                                                        , (next_env, (stages, (groups, deps)))
                                                        )}
                                                    , Host_signature_state | Derived_hostfn_result
                                                    )
                                                } else if! sig_head_is(after_group, 40(I32)) {
                                                  widen_sum!(
                                                    , {host_signature_state = (
                                                        , after_group
                                                        , (next_env, (stages, (groups, deps)))
                                                        )}
                                                    , Host_signature_state | Derived_hostfn_result
                                                    )
                                                } else {
                                                  widen_sum!(
                                                    , signature_diag(
                                                        , subject
                                                        , "expected another value group or `->`"(String)
                                                        )
                                                    , Host_signature_state | Derived_hostfn_result
                                                    )
                                                }
                                              }
                                            )
                                        }
                                      }
                                    }
                                  }
                                , .(diag: Diag) {
                                    widen_sum!(diag, Host_signature_state | Derived_hostfn_result)
                                  }
                                )
                            }
                          }
                        }
                      }
                    }
                  }
                , .(bad: Host_binders_bad) {
                    widen_sum!(
                      , signature_diag(subject, Host_binders_bad.get(bad))
                      , Host_signature_state | Derived_hostfn_result
                      )
                  }
                )
            }
          }
        }
      }
    , {host_signature_state = (
        , host_header_tokens(header)
        , (initial_env, (canonical_stages_nil(), (group_slots_nil(), type_dependencies_nil())))
        )}
    )
}

fn derive_hostfn_header(modules: Modules, types: Host_types, module: Module, header: Host_header) -> Derived_hostfn_result {
  derive_hostfn_header_with_type_scope(
    , modules
    , types
    , module
    , header
    , host_signature_subject(mk_host_id(module_name(module), host_header_name(header)))
    , no_recursive_type_scope()
    , type_substs_nil()
    )
}

labels { source_hostfn_search: Host_headers & (. | (Runtime_hostfn & Type_dependencies)) };

fn derive_named_source_hostfn(modules: Modules, types: Host_types, module: Module, name: String) -> Derived_hostfn_result {
  let id = mk_host_id(module_name(module), name);
  loop(
    , .(state: Source_hostfn_search) {
        match! Source_hostfn_search.get(state) {
          .(remaining: Host_headers, found: . | (Runtime_hostfn & Type_dependencies)) {
            match! un_host_headers(remaining) {
              (
                , .(header: Host_header, rest: Host_headers) {
                    if! host_header_is_fn(header) {
                      if! string_eq(host_header_name(header), name) {
                        match! derive_hostfn_header(modules, types, module, header) {
                          (
                            , .(derived: Derived_hostfn) {
                                match! Derived_hostfn.get(derived) {
                                  .(runtime_hostfn: Runtime_hostfn, dependencies: Type_dependencies) {
                                    let hostfn = runtime_hostfn_public(runtime_hostfn);
                                    match! found {
                                      (
                                        , .(
                                            , prior_runtime_hostfn: Runtime_hostfn
                                            , prior_dependencies: Type_dependencies
                                            ) {
                                            let prior = runtime_hostfn_public(prior_runtime_hostfn);
                                            if! host_fn_eq(
                                              , hostfn_descriptor(prior)
                                              , hostfn_descriptor(hostfn)
                                              ) {
                                              if! group_slots_eq(
                                                , hostfn_groups(prior)
                                                , hostfn_groups(hostfn)
                                                ) {
                                                if! group_slots_eq(
                                                  , runtime_hostfn_groups(prior_runtime_hostfn)
                                                  , runtime_hostfn_groups(runtime_hostfn)
                                                  ) {
                                                  if! type_dependency_sets_eq(
                                                    , prior_dependencies
                                                    , dependencies
                                                    ) {
                                                    widen_sum!(
                                                      , {source_hostfn_search = (rest, found)}
                                                      , Source_hostfn_search | Derived_hostfn_result
                                                      )
                                                  } else {
                                                    widen_sum!(
                                                      , conflicting_host_function(id)
                                                      , Source_hostfn_search | Derived_hostfn_result
                                                      )
                                                  }
                                                } else {
                                                  widen_sum!(
                                                    , conflicting_host_function(id)
                                                    , Source_hostfn_search | Derived_hostfn_result
                                                    )
                                                }
                                              } else {
                                                widen_sum!(
                                                  , conflicting_host_function(id)
                                                  , Source_hostfn_search | Derived_hostfn_result
                                                  )
                                              }
                                            } else {
                                              widen_sum!(
                                                , conflicting_host_function(id)
                                                , Source_hostfn_search | Derived_hostfn_result
                                                )
                                            }
                                          }
                                        , .(_none: .) {
                                            widen_sum!(
                                              , {source_hostfn_search = (
                                                  , rest
                                                  , widen_sum!(
                                                      , (runtime_hostfn, dependencies)
                                                      , . | (Runtime_hostfn & Type_dependencies)
                                                      )
                                                  )}
                                              , Source_hostfn_search | Derived_hostfn_result
                                              )
                                          }
                                        )
                                    }
                                  }
                                }
                              }
                            , .(diag: Diag) {
                                widen_sum!(diag, Source_hostfn_search | Derived_hostfn_result)
                              }
                            )
                        }
                      } else {
                        widen_sum!(
                          , {source_hostfn_search = (rest, found)}
                          , Source_hostfn_search | Derived_hostfn_result
                          )
                      }
                    } else {
                      widen_sum!(
                        , {source_hostfn_search = (rest, found)}
                        , Source_hostfn_search | Derived_hostfn_result
                        )
                    }
                  }
                , .(_empty: .) {
                    match! found {
                      (
                        , .(runtime_hostfn: Runtime_hostfn, dependencies: Type_dependencies) {
                            widen_sum!(
                              , {derived_hostfn = (runtime_hostfn, dependencies)}
                              , Source_hostfn_search | Derived_hostfn_result
                              )
                          }
                        , .(_missing: .) {
                            widen_sum!(
                              , mk_diag(string_concat(
                                  , "dyn_load_prime: selected host function is absent: `"(String)
                                  , string_concat(host_id_render(id), "`"(String))
                                  ))
                              , Source_hostfn_search | Derived_hostfn_result
                              )
                          }
                        )
                    }
                  }
                )
            }
          }
        }
      }
    , {source_hostfn_search = (
        , module_host_headers(module)
        , widen_sum!((), . | (Runtime_hostfn & Type_dependencies))
        )}
    )
}

fn exact_host_type_for_spelling(context: Type_context, spelling: String) -> Host_type | String {
  let env = mk_type_env(context, type_bounds_nil(), type_substs_nil(), alias_refs_nil(), 0(I32));
  match! resolve_exact_type_head(spelling, env) {
    (
      , .(ok: Exact_type_head_ok) {
          match! exact_type_head_ok_head(ok) {
            (
              , .(host: Exact_head_host) {
                  widen_sum!(Exact_head_host.get(host), Host_type | String)
                }
              , .(_nominal: Exact_head_nominal) {
                  widen_sum!(
                    , string_concat(
                        , "dyn_load_prime: literal annotation `"(String)
                        , string_concat(spelling, "` does not name a host type"(String))
                        )
                    , Host_type | String
                    )
                }
              , .(_alias: Exact_head_alias) {
                  widen_sum!(
                    , string_concat(
                        , "dyn_load_prime: literal annotation `"(String)
                        , string_concat(
                            , spelling
                            , "` does not resolve to one exact host type"(String)
                            )
                        )
                    , Host_type | String
                    )
                }
              )
          }
        }
      , .(bad: Exact_type_head_bad) {
          widen_sum!(diag_message(Exact_type_head_bad.get(bad)), Host_type | String)
        }
      )
  }
}

fn host_type_has_bool_role(descriptor: Host_type) -> Bool {
  match! host_type_shape(descriptor) {
    (
      , .(_roleless: Roleless_host_type) { .f(Bool) }
      , .(role: Role_host_type) { role_eq(Role_host_type.get(role), bool_role()) }
      )
  }
}

fn insert_bool_descriptor(found: Host_types, descriptor: Host_type) -> Host_types {
  if! host_type_has_bool_role(descriptor) {
    host_types_insert_exact(found, descriptor)
  } else {
    found
  }
}

type Direct_host_type_lookup = . | Host_type | Diag;

fn direct_host_type_at(context: Type_context, owner: String, name: String) -> Direct_host_type_lookup {
  match! find_host_type(type_context_host_types(context), mk_host_id(owner, name)) {
    (
      , .(_missing: Missing_host_type) { widen_sum!((), Direct_host_type_lookup) }
      , .(found: Found_host_type) {
          widen_sum!(Found_host_type.get(found), Direct_host_type_lookup)
        }
      , .(_conflict: Conflicting_host_type) {
          widen_sum!(conflicting_image_host_type(mk_host_id(owner, name)), Direct_host_type_lookup)
        }
      )
  }
}

fn collect_local_direct_bool(context: Type_context, initial: Host_types) -> Host_types | Diag {
  let module = type_context_module(context);
  loop(
    , .(state: Host_headers & Host_types) {
        match! state {
          .(remaining: Host_headers, found: Host_types) {
            match! un_host_headers(remaining) {
              (
                , .(header: Host_header, rest: Host_headers) {
                    if! host_header_is_fn(header) {
                      widen_sum!((rest, found), (Host_headers & Host_types) | Host_types | Diag)
                    } else if! lt_i32(
                      , host_header_decl_pos(header)
                      , type_context_alias_cutoff(context)
                      ) {
                      match! direct_host_type_at(
                        , context
                        , module_name(module)
                        , host_header_name(header)
                        ) {
                        (
                          , .(descriptor: Host_type) {
                              widen_sum!(
                                , (rest, insert_bool_descriptor(found, descriptor))
                                , (Host_headers & Host_types) | Host_types | Diag
                                )
                            }
                          , .(diag: Diag) {
                              widen_sum!(diag, (Host_headers & Host_types) | Host_types | Diag)
                            }
                          , .(_missing: .) {
                              widen_sum!(
                                , (rest, found)
                                , (Host_headers & Host_types) | Host_types | Diag
                                )
                            }
                          )
                      }
                    } else {
                      widen_sum!((rest, found), (Host_headers & Host_types) | Host_types | Diag)
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(found, (Host_headers & Host_types) | Host_types | Diag)
                  }
                )
            }
          }
        }
      }
    , (module_host_headers(module), initial)
    )
}

fn import_names_direct_host_type(context: Type_context, provider_name: String, name: String) -> Bool {
  match! find_module(type_context_modules(context), provider_name) {
    (.(provider: Module) { module_declares_host_type(provider, name) }, .(_missing: .) { .f(Bool) })
  }
}

fn collect_imported_direct_bool(context: Type_context, initial: Host_types) -> Host_types | Diag {
  loop(
    , .(state: Imports & Host_types) {
        match! state {
          .(remaining: Imports, found: Host_types) {
            match! un_imports(remaining) {
              (
                , .(import: Import, rest: Imports) {
                    match! un_import(import) {
                      .(name: String, provider: String) {
                        if! import_names_direct_host_type(context, provider, name) {
                          match! direct_host_type_at(context, provider, name) {
                            (
                              , .(descriptor: Host_type) {
                                  widen_sum!(
                                    , (rest, insert_bool_descriptor(found, descriptor))
                                    , (Imports & Host_types) | Host_types | Diag
                                    )
                                }
                              , .(diag: Diag) {
                                  widen_sum!(diag, (Imports & Host_types) | Host_types | Diag)
                                }
                              , .(_missing: .) {
                                  widen_sum!(
                                    , (rest, found)
                                    , (Imports & Host_types) | Host_types | Diag
                                    )
                                }
                              )
                          }
                        } else {
                          widen_sum!((rest, found), (Imports & Host_types) | Host_types | Diag)
                        }
                      }
                    }
                  }
                , .(_empty: .) { widen_sum!(found, (Imports & Host_types) | Host_types | Diag) }
                )
            }
          }
        }
      }
    , (module_imports(type_context_module(context)), initial)
    )
}

fn alias_bool_descriptor(name: String, env: Type_env) -> . | Host_type {
  match! resolve_exact_type_head(name, env) {
    (
      , .(ok: Exact_type_head_ok) {
          match! exact_type_head_ok_head(ok) {
            (
              , .(host: Exact_head_host) {
                  let descriptor = Exact_head_host.get(host);
                  if! host_type_has_bool_role(descriptor) {
                    widen_sum!(descriptor, . | Host_type)
                  } else {
                    widen_sum!((), . | Host_type)
                  }
                }
              , .(_nominal: Exact_head_nominal) { widen_sum!((), . | Host_type) }
              , .(_alias: Exact_head_alias) { widen_sum!((), . | Host_type) }
              )
          }
        }
      , .(_bad: Exact_type_head_bad) { widen_sum!((), . | Host_type) }
      )
  }
}

fn collect_local_alias_bool(context: Type_context, initial: Host_types) -> Host_types {
  let env = mk_type_env(context, type_bounds_nil(), type_substs_nil(), alias_refs_nil(), 0(I32));
  loop(
    , .(state: Tyaliases & Host_types) {
        match! state {
          .(remaining: Tyaliases, found: Host_types) {
            match! un_tyaliases(remaining) {
              (
                , .(alias: Alias_decl, rest: Tyaliases) {
                    if! lt_i32(tyalias_decl_pos(alias), type_context_alias_cutoff(context)) {
                      match! alias_bool_descriptor(tyalias_name(alias), env) {
                        (
                          , .(descriptor: Host_type) {
                              widen_sum!(
                                , (rest, host_types_insert_exact(found, descriptor))
                                , (Tyaliases & Host_types) | Host_types
                                )
                            }
                          , .(_not_bool: .) {
                              widen_sum!((rest, found), (Tyaliases & Host_types) | Host_types)
                            }
                          )
                      }
                    } else {
                      widen_sum!((rest, found), (Tyaliases & Host_types) | Host_types)
                    }
                  }
                , .(_empty: .) { widen_sum!(found, (Tyaliases & Host_types) | Host_types) }
                )
            }
          }
        }
      }
    , (module_tyaliases(type_context_module(context)), initial)
    )
}

fn collect_imported_alias_bool(context: Type_context, initial: Host_types) -> Host_types {
  let env = mk_type_env(context, type_bounds_nil(), type_substs_nil(), alias_refs_nil(), 0(I32));
  loop(
    , .(state: Imports & Host_types) {
        match! state {
          .(remaining: Imports, found: Host_types) {
            match! un_imports(remaining) {
              (
                , .(import: Import, rest: Imports) {
                    match! un_import(import) {
                      .(name: String, provider_name: String) {
                        match! find_module(type_context_modules(context), provider_name) {
                          (
                            , .(provider: Module) {
                                match! tyaliases_find(module_tyaliases(provider), name) {
                                  (
                                    , .(_alias: Alias_decl) {
                                        match! alias_bool_descriptor(name, env) {
                                          (
                                            , .(descriptor: Host_type) {
                                                widen_sum!(
                                                  , (
                                                      , rest
                                                      , host_types_insert_exact(found, descriptor)
                                                      )
                                                  , (Imports & Host_types) | Host_types
                                                  )
                                              }
                                            , .(_not_bool: .) {
                                                widen_sum!(
                                                  , (rest, found)
                                                  , (Imports & Host_types) | Host_types
                                                  )
                                              }
                                            )
                                        }
                                      }
                                    , .(_not_alias: .) {
                                        widen_sum!(
                                          , (rest, found)
                                          , (Imports & Host_types) | Host_types
                                          )
                                      }
                                    )
                                }
                              }
                            , .(_missing: .) {
                                widen_sum!((rest, found), (Imports & Host_types) | Host_types)
                              }
                            )
                        }
                      }
                    }
                  }
                , .(_empty: .) { widen_sum!(found, (Imports & Host_types) | Host_types) }
                )
            }
          }
        }
      }
    , (module_imports(type_context_module(context)), initial)
    )
}

fn unique_bool_descriptor(candidates: Host_types) -> Host_type | String {
  match! un_host_types(candidates) {
    (
      , .(first: Host_type, rest: Host_types) {
          match! un_host_types(rest) {
            (
              , .(_second: Host_type, _tail: Host_types) {
                  widen_sum!(
                    , "dyn_load_prime: more than one `role(bool)` type is in unqualified "
                      "lexical scope"(String)
                    , Host_type | String
                    )
                }
              , .(_end: .) { widen_sum!(first, Host_type | String) }
              )
          }
        }
      , .(_empty: .) {
          widen_sum!(
            , "dyn_load_prime: no `role(bool)` host type is in unqualified lexical "
              "scope"(String)
            , Host_type | String
            )
        }
      )
  }
}

fn exact_bool_type_for_context(context: Type_context) -> Host_type | String {
  match! collect_local_direct_bool(context, host_types_nil()) {
    (
      , .(local: Host_types) {
          match! collect_imported_direct_bool(context, local) {
            (
              , .(direct: Host_types) {
                  match! un_host_types(direct) {
                    (
                      , .(_head: Host_type, _tail: Host_types) { unique_bool_descriptor(direct) }
                      , .(_none: .) {
                          unique_bool_descriptor(collect_imported_alias_bool(
                            , context
                            , collect_local_alias_bool(context, host_types_nil())
                            ))
                        }
                      )
                  }
                }
              , .(diag: Diag) { widen_sum!(diag_message(diag), Host_type | String) }
              )
          }
        }
      , .(diag: Diag) { widen_sum!(diag_message(diag), Host_type | String) }
      )
  }
}

labels { hostfn_selection: Runtime_hostfns & Host_types };

type Hostfn_selection_result = Hostfn_selection | Diag;

fn selection_add(
  , selection: Hostfn_selection
  , runtime_hostfn: Runtime_hostfn
  , dependencies: Host_types
  ) -> Hostfn_selection {
  match! Hostfn_selection.get(selection) {
    .(hostfns: Runtime_hostfns, selected_types: Host_types) {
      let hostfn = runtime_hostfn_public(runtime_hostfn);
      {hostfn_selection = (
        , if! runtime_hostfns_has(hostfns, hostfn_descriptor(hostfn)) {
            hostfns
          } else {
            runtime_hostfns_cons(runtime_hostfn, hostfns)
          }
        , host_types_union_exact(selected_types, dependencies)
        )}
    }
  }
}

fn import_target_visibility(module: Module, name: String) -> . | Visibility {
  if! pnames_has(module_hostfns(module), name) {
    widen_sum!(public_visibility(), . | Visibility)
  } else if! module_declares_host_type(module, name) {
    widen_sum!(public_visibility(), . | Visibility)
  } else match! decls_find(module_decls(module), name) {
    (
      , .(decl: Decl) { widen_sum!(decl_visibility(decl), . | Visibility) }
      , .(_not_fn: .) {
          match! members_find(module_members(module), name) {
            (
              , .(member: Member_decl) { widen_sum!(member_nt_visibility(member), . | Visibility) }
              , .(_not_newtype: .) {
                  match! tyaliases_find(module_tyaliases(module), name) {
                    (
                      , .(alias: Alias_decl) {
                          widen_sum!(tyalias_visibility(alias), . | Visibility)
                        }
                      , .(_not_alias: .) { widen_sum!((), . | Visibility) }
                      )
                  }
                }
              )
          }
        }
      )
  }
}

fn missing_import_provider_diag(consumer: String, provider: String) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: malformed image — module `"(String)
    , string_concat(
        , consumer
        , string_concat(
            , "` imports from absent module `"(String)
            , string_concat(provider, "`"(String))
            )
        )
    ))
}

fn missing_import_item_diag(consumer: String, name: String, provider: String) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: malformed image — module `"(String)
    , string_concat(
        , consumer
        , string_concat(
            , "` imports `"(String)
            , string_concat(
                , name
                , string_concat(
                    , "` from `"(String)
                    , string_concat(provider, "`, which declares no such item"(String))
                    )
                )
            )
        )
    ))
}

labels { imports_valid: . };

type Imports_validation = Imports_valid | Diag;

// A cheap package scan decides whether the loader needs the complete exact
// type-origin resolver even when the image has no member-capable aliases.
// Imports are counted conservatively here; the indexed validation below
// filters them to actual type bindings before making a judgment. The small
// name list avoids building a persistent trie on the ordinary path. Beyond 32
// distinct spellings the scan conservatively selects the indexed path, so
// this probe's equality work remains bounded.
type Type_spelling_presence = Pnames;

type Type_spelling_scan = Type_spelling_presence & I32 & Bool;

fn type_spelling_scan_add(scan: Type_spelling_scan, name: String) -> Type_spelling_scan {
  match! scan {
    .(seen: Type_spelling_presence, count: I32, overlap: Bool) {
      if! overlap {
        scan
      } else if! pnames_has(seen, name) {
        (seen, (count, .t(Bool)))
      } else {
        let at_limit = leq_i32(32(I32), count);
        (pnames_cons(name, seen), (add_i32(count, 1(I32)), at_limit))
      }
    }
  }
}

fn type_spelling_scan_names(names: Pnames, initial: Type_spelling_scan) -> Type_spelling_scan {
  loop(
    , .(state: Pnames & Type_spelling_scan) {
        match! state {
          .(remaining: Pnames, scan: Type_spelling_scan) {
            match! un_pnames(remaining) {
              (
                , .(name: String, rest: Pnames) {
                    widen_sum!(
                      , (rest, type_spelling_scan_add(scan, name))
                      , (Pnames & Type_spelling_scan) | Type_spelling_scan
                      )
                  }
                , .(_empty: .) {
                    widen_sum!(scan, (Pnames & Type_spelling_scan) | Type_spelling_scan)
                  }
                )
            }
          }
        }
      }
    , (names, initial)
    )
}

fn type_spelling_scan_members(members: Members, initial: Type_spelling_scan) -> Type_spelling_scan {
  loop(
    , .(state: Members & Type_spelling_scan) {
        match! state {
          .(remaining: Members, scan: Type_spelling_scan) {
            match! un_members(remaining) {
              (
                , .(member: Member_decl, rest: Members) {
                    widen_sum!(
                      , (rest, type_spelling_scan_add(scan, member_name(member)))
                      , (Members & Type_spelling_scan) | Type_spelling_scan
                      )
                  }
                , .(_empty: .) {
                    widen_sum!(scan, (Members & Type_spelling_scan) | Type_spelling_scan)
                  }
                )
            }
          }
        }
      }
    , (members, initial)
    )
}

fn type_spelling_scan_imports(imports: Imports, initial: Type_spelling_scan) -> Type_spelling_scan {
  loop(
    , .(state: Imports & Type_spelling_scan) {
        match! state {
          .(remaining: Imports, scan: Type_spelling_scan) {
            match! un_imports(remaining) {
              (
                , .(one: Import, rest: Imports) {
                    match! un_import(one) {
                      .(name: String, _provider: String) {
                        widen_sum!(
                          , (rest, type_spelling_scan_add(scan, name))
                          , (Imports & Type_spelling_scan) | Type_spelling_scan
                          )
                      }
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(scan, (Imports & Type_spelling_scan) | Type_spelling_scan)
                  }
                )
            }
          }
        }
      }
    , (imports, initial)
    )
}

fn module_has_type_spelling_overlap(module: Module) -> Bool {
  let initial = (pnames_nil(), (0(I32), .f(Bool)));
  let with_names = type_spelling_scan_names(module_typenames(module), initial);
  let with_members = type_spelling_scan_members(module_members(module), with_names);
  match! type_spelling_scan_imports(module_imports(module), with_members) {
    .(_seen: Type_spelling_presence, _count: I32, overlap: Bool) { overlap }
  }
}

fn modules_have_type_spelling_overlap(modules: Modules) -> Bool {
  loop(
    , .(remaining: Modules) {
        match! un_modules(remaining) {
          (
            , .(module: Module, rest: Modules) {
                if! module_has_type_spelling_overlap(module) {
                  widen_sum!(.t(Bool), Modules | Bool)
                } else {
                  widen_sum!(rest, Modules | Bool)
                }
              }
            , .(_empty: .) { widen_sum!(.f(Bool), Modules | Bool) }
            )
        }
      }
    , modules
    )
}

// Validate every selective import independently from host-function seeding.
// An unused ordinary import is still a checked package edge.
fn validate_module_imports(module: Module, modules: Modules) -> Imports_validation {
  loop(
    , .(remaining: Imports) {
        match! un_imports(remaining) {
          (
            , .(import: Import, rest: Imports) {
                match! un_import(import) {
                  .(name: String, provider_name: String) {
                    match! find_module(modules, provider_name) {
                      (
                        , .(provider: Module) {
                            match! import_target_visibility(provider, name) {
                              (
                                , .(visibility: Visibility) {
                                    if! visibility_allows(
                                      , visibility
                                      , provider_name
                                      , module_name(module)
                                      ) {
                                      widen_sum!(rest, Imports | Imports_validation)
                                    } else {
                                      widen_sum!(
                                        , import_visibility_diag(
                                            , module_name(module)
                                            , name
                                            , provider_name
                                            )
                                        , Imports | Imports_validation
                                        )
                                    }
                                  }
                                , .(_missing: .) {
                                    widen_sum!(
                                      , missing_import_item_diag(
                                          , module_name(module)
                                          , name
                                          , provider_name
                                          )
                                      , Imports | Imports_validation
                                      )
                                  }
                                )
                            }
                          }
                        , .(_absent: .) {
                            widen_sum!(
                              , missing_import_provider_diag(module_name(module), provider_name)
                              , Imports | Imports_validation
                              )
                          }
                        )
                    }
                  }
                }
              }
            , .(_empty: .) { widen_sum!({imports_valid=}, Imports | Imports_validation) }
            )
        }
      }
    , module_imports(module)
    )
}

fn validate_module_alias_targets(module: Module, modules: Modules) -> Imports_validation {
  loop(
    , .(remaining: Aliases) {
        match! un_aliases(remaining) {
          (
            , .(alias: Mod_alias, rest: Aliases) {
                match! find_module(modules, alias_target(alias)) {
                  (
                    , .(_provider: Module) { widen_sum!(rest, Aliases | Imports_validation) }
                    , .(_absent: .) {
                        widen_sum!(
                          , missing_import_provider_diag(module_name(module), alias_target(alias))
                          , Aliases | Imports_validation
                          )
                      }
                    )
                }
              }
            , .(_empty: .) { widen_sum!({imports_valid=}, Aliases | Imports_validation) }
            )
        }
      }
    , module_aliases(module)
    )
}

fn validate_package_imports(modules: Modules) -> Imports_validation {
  loop(
    , .(remaining: Modules) {
        match! un_modules(remaining) {
          (
            , .(module: Module, rest: Modules) {
                match! validate_module_imports(module, modules) {
                  (
                    , .(_valid: Imports_valid) {
                        match! validate_module_alias_targets(module, modules) {
                          (
                            , .(_aliases_valid: Imports_valid) {
                                widen_sum!(rest, Modules | Imports_validation)
                              }
                            , .(diag: Diag) { widen_sum!(diag, Modules | Imports_validation) }
                            )
                        }
                      }
                    , .(diag: Diag) { widen_sum!(diag, Modules | Imports_validation) }
                    )
                }
              }
            , .(_empty: .) { widen_sum!({imports_valid=}, Modules | Imports_validation) }
            )
        }
      }
    , modules
    )
}

// Ordinary functions, host functions, and qualified module aliases share the
// value-name namespace. Provider presence classifies selective imports;
// a separate consumer set counts their written introductions.
type Value_binding_origins = Exact_key_catalog(Bool);

type Value_binding_validation = Value_binding_origins | Diag;

fn value_binding_origin_diag(consumer: String, name: String) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: malformed image — module `"(String)
    , string_concat(
        , consumer
        , string_concat(
            , "` introduces visible value/module-alias binding `"(String)
            , string_concat(name, "` more than once"(String))
            )
        )
    ))
}

fn record_value_binding_origin(origins: Value_binding_origins, consumer: String, name: String) -> Value_binding_validation {
  match! exact_key_catalog_find(origins, consumer, name) {
    (
      , .(_prior: Bool) {
          widen_sum!(value_binding_origin_diag(consumer, name), Value_binding_validation)
        }
      , .(_first: .) {
          widen_sum!(
            , exact_key_catalog_insert(origins, consumer, name, .t(Bool))
            , Value_binding_validation
            )
        }
      )
  }
}

fn add_ordinary_value_origins(owner: String, declarations: Decls, initial: Value_binding_origins) -> Value_binding_validation {
  loop(
    , .(state: Decls & Value_binding_origins) {
        match! state {
          .(remaining: Decls, origins: Value_binding_origins) {
            match! un_decls(remaining) {
              (
                , .(declaration: Decl, rest: Decls) {
                    let name = decl_name(declaration);
                    match! record_value_binding_origin(origins, owner, name) {
                      (
                        , .(next: Value_binding_origins) {
                            widen_sum!(
                              , (rest, next)
                              , (Decls & Value_binding_origins) | Value_binding_validation
                              )
                          }
                        , .(diag: Diag) {
                            widen_sum!(
                              , diag
                              , (Decls & Value_binding_origins) | Value_binding_validation
                              )
                          }
                        )
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(origins, (Decls & Value_binding_origins) | Value_binding_validation)
                  }
                )
            }
          }
        }
      }
    , (declarations, initial)
    )
}

fn add_host_value_origins(owner: String, headers: Host_headers, initial: Value_binding_origins) -> Value_binding_validation {
  loop(
    , .(state: Host_headers & Value_binding_origins) {
        match! state {
          .(remaining: Host_headers, origins: Value_binding_origins) {
            match! un_host_headers(remaining) {
              (
                , .(header: Host_header, rest: Host_headers) {
                    if! host_header_is_fn(header) {
                      let name = host_header_name(header);
                      match! record_value_binding_origin(origins, owner, name) {
                        (
                          , .(next: Value_binding_origins) {
                              widen_sum!(
                                , (rest, next)
                                , (Host_headers & Value_binding_origins) | Value_binding_validation
                                )
                            }
                          , .(diag: Diag) {
                              widen_sum!(
                                , diag
                                , (Host_headers & Value_binding_origins) | Value_binding_validation
                                )
                            }
                          )
                      }
                    } else {
                      widen_sum!(
                        , (rest, origins)
                        , (Host_headers & Value_binding_origins) | Value_binding_validation
                        )
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , origins
                      , (Host_headers & Value_binding_origins) | Value_binding_validation
                      )
                  }
                )
            }
          }
        }
      }
    , (headers, initial)
    )
}

fn value_binding_index_for_modules(modules: Modules) -> Value_binding_validation {
  loop(
    , .(state: Modules & Value_binding_origins) {
        match! state {
          .(remaining: Modules, origins: Value_binding_origins) {
            match! un_modules(remaining) {
              (
                , .(module: Module, rest: Modules) {
                    let owner = module_name(module);
                    match! add_ordinary_value_origins(owner, module_decls(module), origins) {
                      (
                        , .(with_ordinary: Value_binding_origins) {
                            match! add_host_value_origins(
                              , owner
                              , module_host_headers(module)
                              , with_ordinary
                              ) {
                              (
                                , .(with_host: Value_binding_origins) {
                                    widen_sum!(
                                      , (rest, with_host)
                                      , (Modules & Value_binding_origins) | Value_binding_validation
                                      )
                                  }
                                , .(diag: Diag) {
                                    widen_sum!(
                                      , diag
                                      , (Modules & Value_binding_origins) | Value_binding_validation
                                      )
                                  }
                                )
                            }
                          }
                        , .(diag: Diag) {
                            widen_sum!(
                              , diag
                              , (Modules & Value_binding_origins) | Value_binding_validation
                              )
                          }
                        )
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , origins
                      , (Modules & Value_binding_origins) | Value_binding_validation
                      )
                  }
                )
            }
          }
        }
      }
    , (modules, exact_key_catalog_nil(Bool, ()))
    )
}

fn add_imported_value_origins(
  , consumer: String
  , imports: Imports
  , index: Value_binding_origins
  , initial: Value_binding_origins
  ) -> Value_binding_validation {
  loop(
    , .(state: Imports & Value_binding_origins) {
        match! state {
          .(remaining: Imports, origins: Value_binding_origins) {
            match! un_imports(remaining) {
              (
                , .(one: Import, rest: Imports) {
                    match! un_import(one) {
                      .(name: String, provider: String) {
                        match! exact_key_catalog_find(index, provider, name) {
                          (
                            , .(_present: Bool) {
                                match! record_value_binding_origin(origins, consumer, name) {
                                  (
                                    , .(next: Value_binding_origins) {
                                        widen_sum!(
                                          , (rest, next)
                                          , (| (Imports & Value_binding_origins)
                                            | Value_binding_validation)
                                          )
                                      }
                                    , .(diag: Diag) {
                                        widen_sum!(
                                          , diag
                                          , (| (Imports & Value_binding_origins)
                                            | Value_binding_validation)
                                          )
                                      }
                                    )
                                }
                              }
                            , .(_type_import: .) {
                                widen_sum!(
                                  , (rest, origins)
                                  , (Imports & Value_binding_origins) | Value_binding_validation
                                  )
                              }
                            )
                        }
                      }
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , origins
                      , (Imports & Value_binding_origins) | Value_binding_validation
                      )
                  }
                )
            }
          }
        }
      }
    , (imports, initial)
    )
}

fn add_module_alias_origins(consumer: String, aliases: Aliases, initial: Value_binding_origins) -> Value_binding_validation {
  loop(
    , .(state: Aliases & Value_binding_origins) {
        match! state {
          .(remaining: Aliases, origins: Value_binding_origins) {
            match! un_aliases(remaining) {
              (
                , .(alias: Mod_alias, rest: Aliases) {
                    match! record_value_binding_origin(origins, consumer, alias_name(alias)) {
                      (
                        , .(next: Value_binding_origins) {
                            widen_sum!(
                              , (rest, next)
                              , (Aliases & Value_binding_origins) | Value_binding_validation
                              )
                          }
                        , .(diag: Diag) {
                            widen_sum!(
                              , diag
                              , (Aliases & Value_binding_origins) | Value_binding_validation
                              )
                          }
                        )
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , origins
                      , (Aliases & Value_binding_origins) | Value_binding_validation
                      )
                  }
                )
            }
          }
        }
      }
    , (aliases, initial)
    )
}

fn validate_module_value_binding_origins(module: Module, index: Value_binding_origins) -> Imports_validation {
  let consumer = module_name(module);
  let empty = exact_key_catalog_nil(Bool, ());
  match! add_ordinary_value_origins(consumer, module_decls(module), empty) {
    (
      , .(with_ordinary: Value_binding_origins) {
          match! add_host_value_origins(consumer, module_host_headers(module), with_ordinary) {
            (
              , .(with_host: Value_binding_origins) {
                  match! add_imported_value_origins(
                    , consumer
                    , module_imports(module)
                    , index
                    , with_host
                    ) {
                    (
                      , .(with_imports: Value_binding_origins) {
                          match! add_module_alias_origins(
                            , consumer
                            , module_aliases(module)
                            , with_imports
                            ) {
                            (
                              , .(_valid: Value_binding_origins) {
                                  widen_sum!({imports_valid=}, Imports_validation)
                                }
                              , .(diag: Diag) { widen_sum!(diag, Imports_validation) }
                              )
                          }
                        }
                      , .(diag: Diag) { widen_sum!(diag, Imports_validation) }
                      )
                  }
                }
              , .(diag: Diag) { widen_sum!(diag, Imports_validation) }
              )
          }
        }
      , .(diag: Diag) { widen_sum!(diag, Imports_validation) }
      )
  }
}

fn validate_package_value_binding_origins(modules: Modules) -> Imports_validation {
  match! value_binding_index_for_modules(modules) {
    (
      , .(index: Value_binding_origins) {
          loop(
            , .(remaining: Modules) {
                match! un_modules(remaining) {
                  (
                    , .(module: Module, rest: Modules) {
                        match! validate_module_value_binding_origins(module, index) {
                          (
                            , .(_valid: Imports_valid) {
                                widen_sum!(rest, Modules | Imports_validation)
                              }
                            , .(diag: Diag) { widen_sum!(diag, Modules | Imports_validation) }
                            )
                        }
                      }
                    , .(_empty: .) { widen_sum!({imports_valid=}, Modules | Imports_validation) }
                    )
                }
              }
            , modules
            )
        }
      , .(diag: Diag) { widen_sum!(diag, Imports_validation) }
      )
  }
}

fn validate_package_binding_origins(modules: Modules) -> Imports_validation {
  match! validate_package_imports(modules) {
    (
      , .(_imports_valid: Imports_valid) { validate_package_value_binding_origins(modules) }
      , .(diag: Diag) { widen_sum!(diag, Imports_validation) }
      )
  }
}

// A same-module host declaration establishes its bare lexical binding without
// an import edge. Seed every such exact declaration: this avoids guessing at
// body use or shadowing while remaining inert until a guest actually calls it.
fn select_local_source_hostfns(
  , module: Module
  , modules: Modules
  , types: Host_types
  , initial: Hostfn_selection
  ) -> Hostfn_selection_result {
  loop(
    , .(state: Host_headers & Hostfn_selection) {
        match! state {
          .(remaining: Host_headers, selection: Hostfn_selection) {
            match! un_host_headers(remaining) {
              (
                , .(header: Host_header, rest: Host_headers) {
                    if! host_header_is_fn(header) {
                      match! derive_named_source_hostfn(
                        , modules
                        , types
                        , module
                        , host_header_name(header)
                        ) {
                        (
                          , .(derived: Derived_hostfn) {
                              match! Derived_hostfn.get(derived) {
                                .(runtime_hostfn: Runtime_hostfn, dependencies: Type_dependencies) {
                                  widen_sum!(
                                    , (
                                        , rest
                                        , selection_add(
                                            , selection
                                            , runtime_hostfn
                                            , type_dependencies_hosts(dependencies)
                                            )
                                        )
                                    , (Host_headers & Hostfn_selection) | Hostfn_selection_result
                                    )
                                }
                              }
                            }
                          , .(diag: Diag) {
                              widen_sum!(
                                , diag
                                , (Host_headers & Hostfn_selection) | Hostfn_selection_result
                                )
                            }
                          )
                      }
                    } else {
                      widen_sum!(
                        , (rest, selection)
                        , (Host_headers & Hostfn_selection) | Hostfn_selection_result
                        )
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , selection
                      , (Host_headers & Hostfn_selection) | Hostfn_selection_result
                      )
                  }
                )
            }
          }
        }
      }
    , (module_host_headers(module), initial)
    )
}

fn derive_package_runtime_hostfns(modules: Modules, types: Host_types) -> Hostfn_selection_result {
  loop(
    , .(state: Modules & Hostfn_selection) {
        match! state {
          .(remaining: Modules, selection: Hostfn_selection) {
            match! un_modules(remaining) {
              (
                , .(module: Module, rest: Modules) {
                    match! select_local_source_hostfns(module, modules, types, selection) {
                      (
                        , .(selected: Hostfn_selection) {
                            widen_sum!(
                              , (rest, selected)
                              , (Modules & Hostfn_selection) | Hostfn_selection_result
                              )
                          }
                        , .(diag: Diag) {
                            widen_sum!(diag, (Modules & Hostfn_selection) | Hostfn_selection_result)
                          }
                        )
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(selection, (Modules & Hostfn_selection) | Hostfn_selection_result)
                  }
                )
            }
          }
        }
      }
    , (modules, {hostfn_selection = (runtime_hostfns_nil(), host_types_nil())})
    )
}

fn dependency_subject(kind: String, name: String) -> String {
  string_concat(
    , "dyn_load_prime: "(String)
    , string_concat(kind, string_concat(" `"(String), string_concat(name, "`"(String))))
    )
}

fn unbridged_dependency_diag(subject: String, species: String, dependency: Host_id) -> Diag {
  mk_diag(string_concat(
    , subject
    , string_concat(
        , " reaches unbridged "(String)
        , string_concat(
            , species
            , string_concat(" `"(String), string_concat(host_id_render(dependency), "`"(String)))
            )
        )
    ))
}

fn nominal_dependency_diag(subject: String, detail: String, dependency: Host_id) -> Diag {
  mk_diag(string_concat(
    , subject
    , string_concat(
        , detail
        , string_concat(" `"(String), string_concat(host_id_render(dependency), "`"(String)))
        )
    ))
}

fn validate_bridge_nominal_dependency(
  , modules: Modules
  , bridge: Bridge
  , subject: String
  , dependency: Host_id
  ) -> . | Diag {
  match! find_module(modules, host_id_module(dependency)) {
    (
      , .(module: Module) {
          match! choose_member(
            , module_members(module)
            , host_id_local(dependency)
            , 0(I32)
            , .f(Bool)
            , no_recursive_type_scope()
            ) {
            (
              , .(found: Member_choice_found) {
                  let member = Member_choice_found.get(found);
                  if! member_nt_pub(member) {
                    if! bridge_admits(bridge, host_id_module(dependency)) {
                      widen_sum!((), . | Diag)
                    } else {
                      widen_sum!(
                        , unbridged_dependency_diag(subject, "nominal type"(String), dependency)
                        , . | Diag
                        )
                    }
                  } else {
                    widen_sum!(
                      , nominal_dependency_diag(
                          , subject
                          , " reaches non-public nominal type"(String)
                          , dependency
                          )
                      , . | Diag
                      )
                  }
                }
              , .(_conflict: Member_choice_conflict) {
                  widen_sum!(
                    , nominal_dependency_diag(
                        , subject
                        , " is malformed: it references an ambiguous nominal type"(String)
                        , dependency
                        )
                    , . | Diag
                    )
                }
              , .(_missing: .) {
                  widen_sum!(
                    , nominal_dependency_diag(
                        , subject
                        , " is malformed: it references an absent nominal type"(String)
                        , dependency
                        )
                    , . | Diag
                    )
                }
              )
          }
        }
      , .(_missing_module: .) {
          widen_sum!(
            , nominal_dependency_diag(
                , subject
                , " is malformed: it references a nominal type from an absent module"(String)
                , dependency
                )
            , . | Diag
            )
        }
      )
  }
}

fn validate_bridge_nominal_dependencies(
  , modules: Modules
  , dependencies: Nominal_ids
  , bridge: Bridge
  , subject: String
  ) -> . | Diag {
  loop(
    , .(remaining: Nominal_ids) {
        match! un_nominal_ids(remaining) {
          (
            , .(dependency: Host_id, rest: Nominal_ids) {
                match! validate_bridge_nominal_dependency(modules, bridge, subject, dependency) {
                  (
                    , .(diag: Diag) {
                        widen_sum!(widen_sum!(diag, . | Diag), Nominal_ids | . | Diag)
                      }
                    , .(_valid: .) { widen_sum!(rest, Nominal_ids | . | Diag) }
                    )
                }
              }
            , .(_empty: .) { widen_sum!(widen_sum!((), . | Diag), Nominal_ids | . | Diag) }
            )
        }
      }
    , dependencies
    )
}

fn alias_dependency_diag(subject: String, detail: String, dependency: Host_id) -> Diag {
  mk_diag(string_concat(
    , subject
    , string_concat(
        , detail
        , string_concat(" `"(String), string_concat(host_id_render(dependency), "`"(String)))
        )
    ))
}

fn validate_bridge_alias_dependency(
  , modules: Modules
  , bridge: Bridge
  , subject: String
  , dependency: Host_id
  ) -> . | Diag {
  match! find_module(modules, host_id_module(dependency)) {
    (
      , .(module: Module) {
          match! choose_alias(
            , module_tyaliases(module)
            , host_id_local(dependency)
            , host_id_module(dependency)
            , host_id_module(dependency)
            , 0(I32)
            , .f(Bool)
            , no_recursive_type_scope()
            ) {
            (
              , .(found: Alias_choice_found) {
                  let alias = Alias_choice_found.get(found);
                  if! visibility_is_public(tyalias_visibility(alias)) {
                    if! bridge_admits(bridge, host_id_module(dependency)) {
                      widen_sum!((), . | Diag)
                    } else {
                      widen_sum!(
                        , unbridged_dependency_diag(subject, "type alias"(String), dependency)
                        , . | Diag
                        )
                    }
                  } else {
                    widen_sum!(
                      , alias_dependency_diag(
                          , subject
                          , " reaches non-public type alias"(String)
                          , dependency
                          )
                      , . | Diag
                      )
                  }
                }
              , .(_conflict: Alias_choice_conflict) {
                  widen_sum!(
                    , alias_dependency_diag(
                        , subject
                        , " is malformed: it references an ambiguous type alias"(String)
                        , dependency
                        )
                    , . | Diag
                    )
                }
              , .(_missing: .) {
                  widen_sum!(
                    , alias_dependency_diag(
                        , subject
                        , " is malformed: it references an absent type alias"(String)
                        , dependency
                        )
                    , . | Diag
                    )
                }
              )
          }
        }
      , .(_missing_module: .) {
          widen_sum!(
            , alias_dependency_diag(
                , subject
                , " is malformed: it references a type alias from an absent module"(String)
                , dependency
                )
            , . | Diag
            )
        }
      )
  }
}

fn validate_bridge_alias_dependencies(
  , modules: Modules
  , dependencies: Alias_ids
  , bridge: Bridge
  , subject: String
  ) -> . | Diag {
  loop(
    , .(remaining: Alias_ids) {
        match! un_alias_ids(remaining) {
          (
            , .(dependency: Host_id, rest: Alias_ids) {
                match! validate_bridge_alias_dependency(modules, bridge, subject, dependency) {
                  (
                    , .(diag: Diag) { widen_sum!(widen_sum!(diag, . | Diag), Alias_ids | . | Diag) }
                    , .(_valid: .) { widen_sum!(rest, Alias_ids | . | Diag) }
                    )
                }
              }
            , .(_empty: .) { widen_sum!(widen_sum!((), . | Diag), Alias_ids | . | Diag) }
            )
        }
      }
    , dependencies
    )
}

fn validate_bridge_type_dependencies(
  , modules: Modules
  , dependencies: Type_dependencies
  , bridge: Bridge
  , subject: String
  ) -> . | Diag {
  match! validate_bridge_nominal_dependencies(
    , modules
    , type_dependencies_nominals(dependencies)
    , bridge
    , subject
    ) {
    (
      , .(diag: Diag) { widen_sum!(diag, . | Diag) }
      , .(_nominals_valid: .) {
          validate_bridge_alias_dependencies(
            , modules
            , type_dependencies_aliases(dependencies)
            , bridge
            , subject
            )
        }
      )
  }
}

labels { contract_selection: Host_types & Host_fn_bindings };

type Contract_selection_result = Contract_selection | Diag;

fn select_bridge_module_contract(
  , modules: Modules
  , bridge: Bridge
  , all_types: Host_types
  , module: Module
  , initial_types: Host_types
  , initial_functions: Host_fn_bindings
  ) -> Contract_selection_result {
  loop(
    , .(state: Host_headers & Host_types & Host_fn_bindings) {
        match! state {
          .(
            , remaining: Host_headers
            , selected_types: Host_types
            , selected_functions: Host_fn_bindings
            ) {
            match! un_host_headers(remaining) {
              (
                , .(header: Host_header, rest: Host_headers) {
                    if! host_header_is_fn(header) {
                      match! derive_hostfn_header(modules, all_types, module, header) {
                        (
                          , .(derived: Derived_hostfn) {
                              match! Derived_hostfn.get(derived) {
                                .(runtime_hostfn: Runtime_hostfn, dependencies: Type_dependencies) {
                                  let hostfn = runtime_hostfn_public(runtime_hostfn);
                                  match! validate_bridge_type_dependencies(
                                    , modules
                                    , dependencies
                                    , bridge
                                    , dependency_subject(
                                        , "host-requirement signature"(String)
                                        , host_id_render(host_fn_id(hostfn_descriptor(hostfn)))
                                        )
                                    ) {
                                    (
                                      , .(diag: Diag) {
                                          widen_sum!(
                                            , diag
                                            , (| (Host_headers & Host_types & Host_fn_bindings)
                                              | Contract_selection_result)
                                            )
                                        }
                                      , .(_valid: .) {
                                          widen_sum!(
                                            , (
                                                , rest
                                                , (
                                                    , host_types_union_exact(
                                                        , type_dependencies_hosts(dependencies)
                                                        , selected_types
                                                        )
                                                    , host_fn_bindings_cons(
                                                        , mk_host_fn_binding(
                                                            , hostfn_descriptor(hostfn)
                                                            , hostfn_groups(hostfn)
                                                            )
                                                        , selected_functions
                                                        )
                                                    )
                                                )
                                            , (| (Host_headers & Host_types & Host_fn_bindings)
                                              | Contract_selection_result)
                                            )
                                        }
                                      )
                                  }
                                }
                              }
                            }
                          , .(diag: Diag) {
                              widen_sum!(
                                , diag
                                , (| (Host_headers & Host_types & Host_fn_bindings)
                                  | Contract_selection_result)
                                )
                            }
                          )
                      }
                    } else match! direct_host_type_at(
                      , mk_type_context(
                          , modules
                          , all_types
                          , module
                          , host_header_decl_pos(header)
                          , no_recursive_type_scope()
                          )
                      , module_name(module)
                      , host_header_name(header)
                      ) {
                      (
                        , .(descriptor: Host_type) {
                            widen_sum!(
                              , (
                                  , rest
                                  , (
                                      , host_types_insert_exact(selected_types, descriptor)
                                      , selected_functions
                                      )
                                  )
                              , (| (Host_headers & Host_types & Host_fn_bindings)
                                | Contract_selection_result)
                              )
                          }
                        , .(diag: Diag) {
                            widen_sum!(
                              , diag
                              , (| (Host_headers & Host_types & Host_fn_bindings)
                                | Contract_selection_result)
                              )
                          }
                        , .(_missing: .) {
                            widen_sum!(
                              , exact_type_resolution_diag(
                                  , host_header_name(header)
                                  , "the retained host declaration has no exact descriptor"(String)
                                  )
                              , (| (Host_headers & Host_types & Host_fn_bindings)
                                | Contract_selection_result)
                              )
                          }
                        )
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , {contract_selection = (selected_types, selected_functions)}
                      , (Host_headers & Host_types & Host_fn_bindings) | Contract_selection_result
                      )
                  }
                )
            }
          }
        }
      }
    , (module_host_headers(module), (initial_types, initial_functions))
    )
}

fn derive_bridge_contract(modules: Modules, bridge: Bridge, all_types: Host_types) ->
  Host_contract | Diag
   {
  loop(
    , .(state: Modules & Host_types & Host_fn_bindings) {
        match! state {
          .(remaining: Modules, selected_types: Host_types, selected_functions: Host_fn_bindings) {
            match! un_modules(remaining) {
              (
                , .(module: Module, rest: Modules) {
                    if! bridge_admits(bridge, module_name(module)) {
                      match! select_bridge_module_contract(
                        , modules
                        , bridge
                        , all_types
                        , module
                        , selected_types
                        , selected_functions
                        ) {
                        (
                          , .(selected: Contract_selection) {
                              match! Contract_selection.get(selected) {
                                .(types: Host_types, functions: Host_fn_bindings) {
                                  widen_sum!(
                                    , (rest, (types, functions))
                                    , (| (Modules & Host_types & Host_fn_bindings)
                                      | Host_contract
                                      | Diag)
                                    )
                                }
                              }
                            }
                          , .(diag: Diag) {
                              widen_sum!(
                                , diag
                                , (Modules & Host_types & Host_fn_bindings) | Host_contract | Diag
                                )
                            }
                          )
                      }
                    } else {
                      widen_sum!(
                        , (rest, (selected_types, selected_functions))
                        , (Modules & Host_types & Host_fn_bindings) | Host_contract | Diag
                        )
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , mk_host_contract(selected_types, selected_functions)
                      , (Modules & Host_types & Host_fn_bindings) | Host_contract | Diag
                      )
                  }
                )
            }
          }
        }
      }
    , (modules, (host_types_nil(), host_fn_bindings_nil()))
    )
}

fn exact_host_type_for_decl(
  , modules: Modules
  , types: Host_types
  , owner: String
  , decl_position: I32
  , spelling: String
  ) -> Host_type | String {
  match! find_module(modules, owner) {
    (
      , .(module: Module) {
          exact_host_type_for_spelling(
            , mk_type_context(modules, types, module, decl_position, no_recursive_type_scope())
            , spelling
            )
        }
      , .(_missing: .) {
          widen_sum!(
            , string_concat(
                , "dyn_load_prime: declaration owner module is absent: `"(String)
                , string_concat(owner, "`"(String))
                )
            , Host_type | String
            )
        }
      )
  }
}

fn exact_bool_type_for_decl(modules: Modules, types: Host_types, owner: String, decl_position: I32) ->
  Host_type | String
   {
  match! find_module(modules, owner) {
    (
      , .(module: Module) {
          exact_bool_type_for_context(mk_type_context(
            , modules
            , types
            , module
            , decl_position
            , no_recursive_type_scope()
            ))
        }
      , .(_missing: .) {
          widen_sum!(
            , string_concat(
                , "dyn_load_prime: declaration owner module is absent: `"(String)
                , string_concat(owner, "`"(String))
                )
            , Host_type | String
            )
        }
      )
  }
}

// =====================================================================
// Member-export signatures — derived from the retained newtype header
// =====================================================================
//
// A member's signature is assembled as source-spelled text from the
// header's raw tokens, then passed through the same exact resolver as host
// declarations. Host expectations copy the resulting canonical export string;
// they are not reparsed or granted source-name resolution.

// The source spelling of a token run, single-space separated (the lexer
// is whitespace-insensitive, so this only needs to re-lex faithfully).
fn toks_source_text(ts: Toks) -> String {
  loop(
    , .(st: Toks & String) {
        match! st {
          .(cur: Toks, acc: String) {
            match! un_toks(cur) {
              (
                , .(t: Token, _p: I32, rest: Toks) {
                    let piece =
                      match! un_token(t) {
                        (
                          , .(w: Tk_word) { Tk_word.get(w) }
                          , .(n: Tk_num) { Tk_num.get(n) }
                          , .(_str: Tk_str) { "<string>"(String) }
                          , .(pc: Tk_punct) {
                              match! ascii_char(Tk_punct.get(pc)) {
                                (.(ch: String) { ch }, .(_wide: .) { "?"(String) })
                              }
                            }
                          )
                      };
                    let acc1 =
                      if! string_eq(acc, ""(String)) {
                        piece
                      } else {
                        string_concat(acc, string_concat(" "(String), piece))
                      };
                    widen_sum!((rest, acc1), (Toks & String) | String)
                  }
                , .(_e: .) { widen_sum!(acc, (Toks & String) | String) }
                )
            }
          }
        }
      }
    , (ts, ""(String))
    )
}

fn rest_toks(ts: Toks) -> Toks {
  match! un_toks(ts) {
    (.(_t: Token, _p: I32, r: Toks) { r }, .(_e: .) { toks_nil() })
  }
}

// Whether a token is the given punctuation code.
fn is_punct(t: Token, code: I32) -> Bool {
  match! un_token(t) {
    (
      , .(_w: Tk_word) { .f(Bool) }
      , .(_n: Tk_num) { .f(Bool) }
      , .(_s: Tk_str) { .f(Bool) }
      , .(pc: Tk_punct) { eq_i32(Tk_punct.get(pc), code) }
      )
  }
}

// Reverse a most-recent-first token accumulator into source order,
// keeping per-token offsets.
fn toks_rev(ts: Toks) -> Toks {
  loop(
    , .(st: Toks & Toks) {
        match! st {
          .(rem: Toks, acc: Toks) {
            match! un_toks(rem) {
              (
                , .(t: Token, p: I32, rest: Toks) {
                    widen_sum!((rest, toks_cons(t, p, acc)), (Toks & Toks) | Toks)
                  }
                , .(_e: .) { widen_sum!(acc, (Toks & Toks) | Toks) }
                )
            }
          }
        }
      }
    , (ts, toks_nil())
    )
}

// Whether the head token is the given punct (a local sibling of the
// parser's `head_is_punct`, over this module's token views).
fn head_is_punct_tok(ts: Toks, code: I32) -> Bool {
  match! un_toks(ts) {
    (.(t: Token, _p: I32, _rest: Toks) { is_punct(t, code) }, .(_e: .) { .f(Bool) })
  }
}

fn drop_close_angle(ts: Toks) -> Toks {
  if! head_is_punct_tok(ts, 62(I32)) {
    rest_toks(ts)
  } else {
    ts
  }
}

fn drop_colon(ts: Toks) -> Toks {
  if! head_is_punct_tok(ts, 58(I32)) {
    rest_toks(ts)
  } else {
    ts
  }
}

/// Wraps a group copy's `(reversed-copied, remaining-tokens,
/// top-level-item-count)`.
labels { group_copy: Toks & Toks & I32 };

// Copy one balanced `open … close` group (inclusive) onto the reversed
// accumulator. Repeated top-level commas do not create empty items.
fn copy_group_run(ts: Toks, open: I32, close: I32, acc0: Toks) -> Toks & Toks & I32 {
  match! Group_copy.get(loop(
    , .(st: Toks & I32 & Toks & I32 & Bool) {
        match! st {
          .(cur: Toks, depth: I32, acc: Toks, item_count: I32, in_item: Bool) {
            match! un_toks(cur) {
              (
                , .(t: Token, p: I32, rest: Toks) {
                    let top_level = eq_i32(depth, 1(I32));
                    let separator =
                      if! top_level {
                        is_punct(t, 44(I32))
                      } else {
                        .f(Bool)
                      };
                    let closing =
                      if! top_level {
                        is_punct(t, close)
                      } else {
                        .f(Bool)
                      };
                    let item_count1 =
                      if! top_level {
                        if! separator {
                          item_count
                        } else if! closing {
                          item_count
                        } else if! in_item {
                          item_count
                        } else {
                          add_i32(item_count, 1(I32))
                        }
                      } else {
                        item_count
                      };
                    let in_item1 =
                      if! top_level {
                        if! separator {
                          .f(Bool)
                        } else if! closing {
                          in_item
                        } else {
                          .t(Bool)
                        }
                      } else {
                        in_item
                      };
                    let d1 =
                      if! is_punct(t, open) {
                        add_i32(depth, 1(I32))
                      } else if! is_punct(t, close) {
                        sub_i32(depth, 1(I32))
                      } else {
                        depth
                      };
                    if! eq_i32(d1, 0(I32)) {
                      widen_sum!(
                        , {group_copy = (toks_cons(t, p, acc), (rest, item_count1))}
                        , (Toks & I32 & Toks & I32 & Bool) | Group_copy
                        )
                    } else {
                      widen_sum!(
                        , (rest, (d1, (toks_cons(t, p, acc), (item_count1, in_item1))))
                        , (Toks & I32 & Toks & I32 & Bool) | Group_copy
                        )
                    }
                  }
                , .(_e: .) {
                    widen_sum!(
                      , {group_copy = (acc, (cur, item_count))}
                      , (Toks & I32 & Toks & I32 & Bool) | Group_copy
                      )
                  }
                )
            }
          }
        }
      }
    , (ts, (0(I32), (acc0, (0(I32), .f(Bool)))))
    )) {
    .(copied: Toks, after: Toks, item_count: I32) { (copied, (after, item_count)) }
  }
}

/// Wraps the universal-run split's `(universal-run, remaining-tokens,
/// binder-count, valid)`.
labels { uni_split: Toks & Toks & I32 & Bool };

// Copy the leading `[...]` binder runs verbatim; the remainder starts at
// the existential runs or the `:`.
fn take_binder_runs(header: Toks) -> Toks & Toks & I32 & Bool {
  match! Uni_split.get(loop(
    , .(st: Toks & Toks & I32) {
        match! st {
          .(cur: Toks, acc: Toks, count: I32) {
            if! head_is_punct_tok(cur, 91(I32)) {
              match! copy_group_run(cur, 91(I32), 93(I32), acc) {
                .(acc1: Toks, after: Toks, group_count: I32) {
                  if! lt_i32(0(I32), group_count) {
                    widen_sum!(
                      , (after, (acc1, add_i32(count, group_count)))
                      , (Toks & Toks & I32) | Uni_split
                      )
                  } else {
                    widen_sum!(
                      , {uni_split = (toks_rev(acc), (cur, (count, .f(Bool))))}
                      , (Toks & Toks & I32) | Uni_split
                      )
                  }
                }
              }
            } else {
              widen_sum!(
                , {uni_split = (toks_rev(acc), (cur, (count, .t(Bool))))}
                , (Toks & Toks & I32) | Uni_split
                )
            }
          }
        }
      }
    , (header, (toks_nil(), 0(I32)))
    )) {
    .(uni: Toks, rest: Toks, count: I32, valid: Bool) { (uni, (rest, (count, valid))) }
  }
}

// Combine a canonical signature's unary-`forall` stages with independently
// supplied public value-group sizes. Binder and balanced-group scanners own
// each public stage boundary. Once the public inventory is exhausted, the
// nonempty result suffix stays opaque.
labels { adapter_runtime_groups_state: Toks & Group_slots & Group_slots };

type Adapter_runtime_groups_step = Adapter_runtime_groups_state | Group_slots | Diag;

fn adapter_runtime_groups_bad(id: Host_id) -> Adapter_runtime_groups_step {
  widen_sum!(invalid_adapter_group_shape(id), Adapter_runtime_groups_step)
}

fn adapter_runtime_groups(binding: Host_fn_binding) -> Group_slots | Diag {
  let descriptor = host_fn_binding_descriptor(binding);
  let public_groups = host_fn_binding_groups(binding);
  if! group_slots_valid(public_groups) {
    match! lex(host_fn_signature(descriptor)) {
      (
        , .(signature: Toks) {
            loop(
              , .(state: Adapter_runtime_groups_state) {
                  match! Adapter_runtime_groups_state.get(state) {
                    .(
                      , remaining_signature: Toks
                      , remaining_public: Group_slots
                      , reversed_runtime: Group_slots
                      ) {
                      match! un_group_slots(remaining_public) {
                        (
                          , .(slots: I32, rest: Group_slots) {
                              match! take_binder_runs(remaining_signature) {
                                .(
                                  , _binders: Toks
                                  , at_group: Toks
                                  , binder_count: I32
                                  , valid_binders: Bool
                                  ) {
                                  if! valid_binders {
                                    if! head_is_punct_tok(at_group, 40(I32)) {
                                      match! copy_group_run(at_group, 40(I32), 41(I32), toks_nil()) {
                                        .(_domain: Toks, after_group: Toks, _domain_items: I32) {
                                          match! punct_after_arrow(after_group) {
                                            (
                                              , .(after_arrow: Toks) {
                                                  if! toks_empty(after_arrow) {
                                                    adapter_runtime_groups_bad(host_fn_id(descriptor))
                                                  } else {
                                                    widen_sum!(
                                                      , {adapter_runtime_groups_state = (
                                                          , after_arrow
                                                          , (
                                                              , rest
                                                              , group_slots_cons(
                                                                  , slots
                                                                  , group_slots_prepend_type_stages(
                                                                      , binder_count
                                                                      , reversed_runtime
                                                                      )
                                                                  )
                                                              )
                                                          )}
                                                      , Adapter_runtime_groups_step
                                                      )
                                                  }
                                                }
                                              , .(_missing_arrow: .) {
                                                  adapter_runtime_groups_bad(host_fn_id(descriptor))
                                                }
                                              )
                                          }
                                        }
                                      }
                                    } else {
                                      adapter_runtime_groups_bad(host_fn_id(descriptor))
                                    }
                                  } else {
                                    adapter_runtime_groups_bad(host_fn_id(descriptor))
                                  }
                                }
                              }
                            }
                          , .(_no_public_groups: .) {
                              if! toks_empty(remaining_signature) {
                                adapter_runtime_groups_bad(host_fn_id(descriptor))
                              } else {
                                widen_sum!(
                                  , group_slots_reverse(reversed_runtime)
                                  , Adapter_runtime_groups_step
                                  )
                              }
                            }
                          )
                      }
                    }
                  }
                }
              , {adapter_runtime_groups_state = (signature, (public_groups, group_slots_nil()))}
              )
          }
        , .(_lex_error: Lex_err) {
            widen_sum!(invalid_adapter_group_shape(host_fn_id(descriptor)), Group_slots | Diag)
          }
        )
    }
  } else {
    widen_sum!(invalid_adapter_group_shape(host_fn_id(descriptor)), Group_slots | Diag)
  }
}

fn adapter_hostfn_value(adapter: Host_adapter, descriptor: Host_fn) -> Value | Diag {
  let rendered = host_id_render(host_fn_id(descriptor));
  match! adapter_binding_lookup(host_adapter_functions(adapter), host_fn_id(descriptor)) {
    (
      , .(found: Adapter_binding_found) {
          let binding = Adapter_binding_found.get(found);
          if! host_fn_eq(host_fn_binding_descriptor(binding), descriptor) {
            match! adapter_runtime_groups(binding) {
              (
                , .(runtime_groups: Group_slots) {
                    widen_sum!(vhostfn_fresh(descriptor, runtime_groups), Value | Diag)
                  }
                , .(diag: Diag) { widen_sum!(diag, Value | Diag) }
                )
            }
          } else {
            widen_sum!(
              , mk_diag(string_concat(
                  , "dyn_load_prime: host adapter descriptor mismatch for `"(String)
                  , string_concat(rendered, "`"(String))
                  ))
              , Value | Diag
              )
          }
        }
      , .(_conflict: Adapter_binding_conflict) {
          widen_sum!(
            , mk_diag(string_concat(
                , "dyn_load_prime: host adapter has conflicting bindings for `"(String)
                , string_concat(rendered, "`"(String))
                ))
            , Value | Diag
            )
        }
      , .(_missing: .) {
          widen_sum!(
            , mk_diag(string_concat(
                , "dyn_load_prime: host adapter does not offer `"(String)
                , string_concat(rendered, "`"(String))
                ))
            , Value | Diag
            )
        }
      )
  }
}

/// Wraps the existential-names split `(names, remaining-tokens)`.
labels { exi_split: Pnames & Toks };

// Collect the `<Name>` runs' binder names; the remainder starts at `:`.
fn take_existential_names(ts0: Toks) -> Pnames & Toks {
  match! Exi_split.get(loop(
    , .(st: Toks & Pnames) {
        match! st {
          .(cur: Toks, acc: Pnames) {
            if! head_is_punct_tok(cur, 60(I32)) {
              match! un_toks(rest_toks(cur)) {
                (
                  , .(t: Token, _p: I32, after_name: Toks) {
                      match! un_token(t) {
                        (
                          , .(w: Tk_word) {
                              widen_sum!(
                                , (drop_close_angle(after_name), pnames_cons(Tk_word.get(w), acc))
                                , (Toks & Pnames) | Exi_split
                                )
                            }
                          , .(_n: Tk_num) {
                              widen_sum!({exi_split = (acc, cur)}, (Toks & Pnames) | Exi_split)
                            }
                          , .(_st: Tk_str) {
                              widen_sum!({exi_split = (acc, cur)}, (Toks & Pnames) | Exi_split)
                            }
                          , .(_pc: Tk_punct) {
                              widen_sum!({exi_split = (acc, cur)}, (Toks & Pnames) | Exi_split)
                            }
                          )
                      }
                    }
                  , .(_e: .) { widen_sum!({exi_split = (acc, cur)}, (Toks & Pnames) | Exi_split) }
                  )
              }
            } else {
              widen_sum!({exi_split = (acc, cur)}, (Toks & Pnames) | Exi_split)
            }
          }
        }
      }
    , (ts0, pnames_nil())
    )) {
    .(names: Pnames, rest: Toks) { (pnames_reverse_local(names), rest) }
  }
}

// The comma-separated raw binder names of the leading universal groups —
// the type-application arguments a member signature names.
fn binder_names_csv(header: Toks) -> String {
  match! collect_binders(header) {
    .(bs: Binders, _after: Toks) {
      loop(
        , .(st: Binders & String) {
            match! st {
              .(rem: Binders, acc: String) {
                match! un_binders(rem) {
                  (
                    , .(h: Binder_info, rest: Binders) {
                        match! Binder_info.get(h) {
                          .(n: String, _stars: I32) {
                            let acc1 =
                              if! string_eq(acc, ""(String)) {
                                n
                              } else {
                                string_concat(acc, string_concat(", "(String), n))
                              };
                            widen_sum!((rest, acc1), (Binders & String) | String)
                          }
                        }
                      }
                    , .(_e: .) { widen_sum!(acc, (Binders & String) | String) }
                    )
                }
              }
            }
          }
        , (bs, ""(String))
        )
    }
  }
}

// The member's applied type spelling: `Head(A, B)`, or bare `Head` for a
// monomorphic newtype.
fn member_applied_type(md: Member_decl, head: String) -> String {
  let csv = binder_names_csv(member_header(md));
  if! string_eq(csv, ""(String)) {
    head
  } else {
    string_concat(head, string_concat("("(String), string_concat(csv, ")"(String))))
  }
}

// Each existential name as its own `[U]` binder-group text.
fn existential_groups_text(names: Pnames) -> String {
  loop(
    , .(st: Pnames & String) {
        match! st {
          .(rem: Pnames, acc: String) {
            match! un_pnames(rem) {
              (
                , .(n: String, rest: Pnames) {
                    widen_sum!(
                      , (
                          , rest
                          , string_concat(
                              , acc
                              , string_concat("["(String), string_concat(n, "]"(String)))
                              )
                          )
                      , (Pnames & String) | String
                      )
                  }
                , .(_e: .) { widen_sum!(acc, (Pnames & String) | String) }
                )
            }
          }
        }
      }
    , (names, ""(String))
    )
}

fn toks_contain_word(ts: Toks, wanted: String) -> Bool {
  loop(
    , .(remaining: Toks) {
        match! un_toks(remaining) {
          (
            , .(token: Token, _position: I32, rest: Toks) {
                let matches =
                  match! un_token(token) {
                    (
                      , .(word: Tk_word) { string_eq(Tk_word.get(word), wanted) }
                      , .(_number: Tk_num) { .f(Bool) }
                      , .(_string: Tk_str) { .f(Bool) }
                      , .(_punct: Tk_punct) { .f(Bool) }
                      )
                  };
                if! matches {
                  widen_sum!(.t(Bool), Toks | Bool)
                } else {
                  widen_sum!(rest, Toks | Bool)
                }
              }
            , .(_empty: .) { widen_sum!(.f(Bool), Toks | Bool) }
            )
        }
      }
    , ts
    )
}

labels { fresh_type_name_candidate: String };

// The candidate is absent from every original word token in the complete
// retained header, including binders, existentials, and the payload. Appending
// `x` preserves TypeName syntax, and a finite token run makes the deterministic
// search terminate.
fn fresh_member_type_name(header: Toks, initial: String) -> String {
  loop(
    , .(state: Fresh_type_name_candidate) {
        let candidate = Fresh_type_name_candidate.get(state);
        if! toks_contain_word(header, candidate) {
          widen_sum!(
            , {fresh_type_name_candidate = string_concat(candidate, "x"(String))}
            , Fresh_type_name_candidate | String
            )
        } else {
          widen_sum!(candidate, Fresh_type_name_candidate | String)
        }
      }
    , {fresh_type_name_candidate = initial}
    )
}

fn fresh_member_result_binder(header: Toks) -> String {
  fresh_member_type_name(header, "Zzcps_r"(String))
}

fn fresh_member_nominal_placeholder(header: Toks) -> String {
  fresh_member_type_name(header, "Zzcps_n"(String))
}

// The member export's source-spelled signature text. Constructors take the
// payload to the applied type; projectors reverse that mapping, with
// existential projectors exposing their payload through CPS.
fn member_sig_text(o: Omember, is_proj: Bool, nominal_placeholder: String) -> String {
  let md = omember_decl(o);
  match! take_binder_runs(member_header(md)) {
    .(uni: Toks, rest0: Toks, _binder_count: I32, _valid_binders: Bool) {
      match! take_existential_names(rest0) {
        .(exi: Pnames, rest1: Toks) {
          let payload = toks_source_text(drop_colon(rest1));
          let ub = toks_source_text(uni);
          let applied = member_applied_type(md, nominal_placeholder);
          if! is_proj {
            if! nt_existential(member_info(md)) {
              let result_binder = fresh_member_result_binder(member_header(md));
              let continuation = string_concat(
                , existential_groups_text(exi)
                , string_concat(
                    , " ("(String)
                    , string_concat(payload, string_concat(") -> "(String), result_binder))
                    )
                );
              string_concat(
                , ub
                , string_concat(
                    , "(value: "(String)
                    , string_concat(
                        , applied
                        , string_concat(
                            , ")["(String)
                            , string_concat(
                                , result_binder
                                , string_concat(
                                    , "](continuation: "(String)
                                    , string_concat(
                                        , continuation
                                        , string_concat(") -> "(String), result_binder)
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            } else {
              string_concat(
                , ub
                , string_concat(
                    , "(value: "(String)
                    , string_concat(applied, string_concat(") -> "(String), payload))
                    )
                )
            }
          } else {
            string_concat(
              , ub
              , string_concat(
                  , existential_groups_text(exi)
                  , string_concat(
                      , "(value: "(String)
                      , string_concat(payload, string_concat(") -> "(String), applied))
                      )
                  )
              )
          }
        }
      }
    }
  }
}

fn alias_sig_text(alias: Alias_decl) -> String {
  let binders = source_binders_text(tyalias_binders(alias));
  let prefix =
    if! string_eq(binders, ""(String)) {
      ""(String)
    } else {
      string_concat(binders, " "(String))
    };
  string_concat(
    , prefix
    , string_concat(
        , "(value: "(String)
        , string_concat(toks_source_text(tyalias_body(alias)), ") -> ."(String))
        )
    )
}

// =====================================================================
// The export listing — the surface's names and signatures
// =====================================================================
fn mk_export_info(name: String, sig: String) -> Export_info {
  Export_info.seal_export_info((name, sig))
}

/// The entry's module-qualified name.
pub fn export_info_name(e: Export_info) -> String {
  match! Export_info.open_export_info(e) {
    .(n: String, _s: String) { n }
  }
}

/// The entry's canonical signature rendering.
pub fn export_info_sig(e: Export_info) -> String {
  match! Export_info.open_export_info(e) {
    .(_n: String, s: String) { s }
  }
}

fn export_infos_nil() -> Export_infos { Export_infos.seal_export_infos(nil(Export_info, ())) }

fn export_infos_cons(head: Export_info, tail: Export_infos) -> Export_infos {
  Export_infos.seal_export_infos(cons(head, Export_infos.open_export_infos(tail)))
}

/// One-step destructor on an export listing.
pub fn un_export_infos(es: Export_infos) -> . | (Export_info & Export_infos) {
  match! uncons(Export_infos.open_export_infos(es)) {
    (
      , .(h: Export_info, t: List(Export_info)) {
          widen_sum!((h, Export_infos.seal_export_infos(t)), . | (Export_info & Export_infos))
        }
      , .(_e: .) { widen_sum!((), . | (Export_info & Export_infos)) }
      )
  }
}

fn reverse_export_infos(es: Export_infos) -> Export_infos {
  loop(
    , .(st: Export_infos & Export_infos) {
        match! st {
          .(rem: Export_infos, acc: Export_infos) {
            match! un_export_infos(rem) {
              (
                , .(h: Export_info, rest: Export_infos) {
                    widen_sum!(
                      , (rest, export_infos_cons(h, acc))
                      , (Export_infos & Export_infos) | Export_infos
                      )
                  }
                , .(_e: .) { widen_sum!(acc, (Export_infos & Export_infos) | Export_infos) }
                )
            }
          }
        }
      }
    , (es, export_infos_nil())
    )
}

fn derive_validated_signature(
  , modules: Modules
  , types: Host_types
  , module: Module
  , local_name: String
  , header: Toks
  , decl_position: I32
  , bridge: Bridge
  , subject: String
  , recursive_scope: . | Recursive_type_scope
  , initial_substs: Type_substs
  ) -> Derived_hostfn_result {
  match! derive_hostfn_header_with_type_scope(
    , modules
    , types
    , module
    , mk_host_header(.t(Bool), local_name, header, decl_position)
    , subject
    , recursive_scope
    , initial_substs
    ) {
    (
      , .(derived: Derived_hostfn) {
          match! Derived_hostfn.get(derived) {
            .(_runtime_hostfn: Runtime_hostfn, dependencies: Type_dependencies) {
              match! validate_bridge_type_dependencies(modules, dependencies, bridge, subject) {
                (
                  , .(diag: Diag) { widen_sum!(diag, Derived_hostfn_result) }
                  , .(_valid: .) { widen_sum!(derived, Derived_hostfn_result) }
                  )
              }
            }
          }
        }
      , .(diag: Diag) { widen_sum!(diag, Derived_hostfn_result) }
      )
  }
}

// Resolves one exported header through the same exact type resolver used by
// host declarations, then validates the nominal and transparent-alias identities
// it reaches. Host-module bridge completeness is validated package-wide.
fn canonical_export_signature(
  , modules: Modules
  , types: Host_types
  , module: Module
  , local_name: String
  , qualified_name: String
  , header: Toks
  , decl_position: I32
  , bridge: Bridge
  , recursive_scope: . | Recursive_type_scope
  , initial_substs: Type_substs
  ) -> String | Diag {
  match! derive_validated_signature(
    , modules
    , types
    , module
    , local_name
    , header
    , decl_position
    , bridge
    , dependency_subject("export signature"(String), qualified_name)
    , recursive_scope
    , initial_substs
    ) {
    (
      , .(derived: Derived_hostfn) {
          match! Derived_hostfn.get(derived) {
            .(runtime_hostfn: Runtime_hostfn, _dependencies: Type_dependencies) {
              let hostfn = runtime_hostfn_public(runtime_hostfn);
              widen_sum!(host_fn_signature(hostfn_descriptor(hostfn)), String | Diag)
            }
          }
        }
      , .(diag: Diag) { widen_sum!(diag, String | Diag) }
      )
  }
}

fn export_owner_missing(owner: String) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: malformed image — export owner module is absent: `"(String)
    , string_concat(owner, "`"(String))
    ))
}

labels { fn_export_rows_state: Gdecls & Export_infos };

type Fn_export_rows_step = Fn_export_rows_state | Export_infos | Diag;

// Whether a fn header carries its top-level result arrow. Arrows inside a
// value parameter's function type remain nested under its parameter group.
fn export_header_has_result_arrow(header: Toks) -> Bool {
  loop(
    , .(state: Toks & I32) {
        match! state {
          .(remaining: Toks, paren_depth: I32) {
            match! un_toks(remaining) {
              (
                , .(token: Token, _pos: I32, rest: Toks) {
                    if! is_punct(token, 40(I32)) {
                      widen_sum!((rest, add_i32(paren_depth, 1(I32))), (Toks & I32) | Bool)
                    } else if! is_punct(token, 41(I32)) {
                      widen_sum!((rest, sub_i32(paren_depth, 1(I32))), (Toks & I32) | Bool)
                    } else if! eq_i32(paren_depth, 0(I32)) {
                      if! is_punct(token, 45(I32)) {
                        if! head_is_punct_tok(rest, 62(I32)) {
                          widen_sum!(.t(Bool), (Toks & I32) | Bool)
                        } else {
                          widen_sum!((rest, paren_depth), (Toks & I32) | Bool)
                        }
                      } else {
                        widen_sum!((rest, paren_depth), (Toks & I32) | Bool)
                      }
                    } else {
                      widen_sum!((rest, paren_depth), (Toks & I32) | Bool)
                    }
                  }
                , .(_empty: .) { widen_sum!(.f(Bool), (Toks & I32) | Bool) }
                )
            }
          }
        }
      }
    , (header, 0(I32))
    )
}

// Ordinary Kio fns may omit `-> .`; host fns may not. Supply only that
// language-defined default before handing the header to the shared exact
// host-signature resolver.
fn ordinary_export_header(header: Toks) -> Toks | Diag {
  if! export_header_has_result_arrow(header) {
    widen_sum!(header, Toks | Diag)
  } else match! lex(string_concat(toks_source_text(header), " -> ."(String))) {
    (
      , .(with_unit: Toks) { widen_sum!(with_unit, Toks | Diag) }
      , .(err: Lex_err) {
          widen_sum!(
            , mk_diag(string_concat(
                , "dyn_load_prime: malformed image — could not add the implicit unit result "
                  "to an export: "(String)
                , lex_err_message(err)
                ))
            , Toks | Diag
            )
        }
      )
  }
}

// Canonical fn rows, most-recent first. Derivation does not touch the
// Gdecl/Terms_acc ordering used to execute bodies.
fn canonical_fn_export_rows(modules: Modules, types: Host_types, bridge: Bridge, gs: Gdecls) ->
  Export_infos | Diag
   {
  loop(
    , .(state: Fn_export_rows_state) {
        match! Fn_export_rows_state.get(state) {
          .(remaining: Gdecls, acc: Export_infos) {
            match! un_gdecls(remaining) {
              (
                , .(g: Gdecl, rest: Gdecls) {
                    if! gdecl_on_surface(g, bridge) {
                      match! find_module(modules, gdecl_owner(g)) {
                        (
                          , .(module: Module) {
                              let decl = gdecl_decl(g);
                              match! ordinary_export_header(decl_header(decl)) {
                                (
                                  , .(header: Toks) {
                                      match! canonical_export_signature(
                                        , modules
                                        , types
                                        , module
                                        , decl_name(decl)
                                        , gdecl_qualified(g)
                                        , header
                                        , decl_pos(decl)
                                        , bridge
                                        , no_recursive_type_scope()
                                        , type_substs_nil()
                                        ) {
                                        (
                                          , .(signature: String) {
                                              widen_sum!(
                                                , {fn_export_rows_state = (
                                                    , rest
                                                    , export_infos_cons(
                                                        , mk_export_info(
                                                            , gdecl_qualified(g)
                                                            , signature
                                                            )
                                                        , acc
                                                        )
                                                    )}
                                                , Fn_export_rows_step
                                                )
                                            }
                                          , .(diag: Diag) { widen_sum!(diag, Fn_export_rows_step) }
                                          )
                                      }
                                    }
                                  , .(diag: Diag) { widen_sum!(diag, Fn_export_rows_step) }
                                  )
                              }
                            }
                          , .(_missing: .) {
                              widen_sum!(export_owner_missing(gdecl_owner(g)), Fn_export_rows_step)
                            }
                          )
                      }
                    } else {
                      widen_sum!({fn_export_rows_state = (rest, acc)}, Fn_export_rows_step)
                    }
                  }
                , .(_empty: .) { widen_sum!(acc, Fn_export_rows_step) }
                )
            }
          }
        }
      }
    , {fn_export_rows_state = (gs, export_infos_nil())}
    )
}

fn member_local_name(o: Omember, is_proj: Bool) -> String {
  let md = omember_decl(o);
  if! is_proj {
    nt_proj(member_info(md))
  } else {
    nt_ctor(member_info(md))
  }
}

fn canonical_member_signature(
  , modules: Modules
  , types: Host_types
  , module: Module
  , bridge: Bridge
  , o: Omember
  , is_proj: Bool
  ) -> String | Diag {
  let member = omember_decl(o);
  let placeholder = fresh_member_nominal_placeholder(member_header(member));
  match! member_param_kinds(member) {
    (
      , .(params: Param_kinds) {
          match! lex(member_sig_text(o, is_proj, placeholder)) {
            (
              , .(header: Toks) {
                  canonical_export_signature(
                    , modules
                    , types
                    , module
                    , member_local_name(o, is_proj)
                    , omember_qualified(o, is_proj)
                    , header
                    , member_decl_pos(member)
                    , bridge
                    , member_recursive_scope(member)
                    , type_substs_cons(
                        , placeholder
                        , canonical_nominal_atom(
                            , mk_host_id(omember_owner(o), member_name(member))
                            , params
                            )
                        , type_substs_nil()
                        )
                    )
                }
              , .(err: Lex_err) {
                  widen_sum!(
                    , mk_diag(string_concat(
                        , "dyn_load_prime: malformed image — could not assemble signature for "
                          "export `"(String)
                        , string_concat(
                            , omember_qualified(o, is_proj)
                            , string_concat("`: "(String), lex_err_message(err))
                            )
                        ))
                    , String | Diag
                    )
                }
              )
          }
        }
      , .(diag: Diag) { widen_sum!(diag, String | Diag) }
      )
  }
}

// Adds one canonical member row when that member side is on the surface.
fn canonical_member_row(
  , modules: Modules
  , types: Host_types
  , bridge: Bridge
  , o: Omember
  , is_proj: Bool
  , acc: Export_infos
  ) -> Export_infos | Diag {
  if! omember_side_on_surface(o, is_proj, bridge) {
    match! find_module(modules, omember_owner(o)) {
      (
        , .(module: Module) {
            match! canonical_member_signature(modules, types, module, bridge, o, is_proj) {
              (
                , .(signature: String) {
                    widen_sum!(
                      , export_infos_cons(
                          , mk_export_info(omember_qualified(o, is_proj), signature)
                          , acc
                          )
                      , Export_infos | Diag
                      )
                  }
                , .(diag: Diag) { widen_sum!(diag, Export_infos | Diag) }
                )
            }
          }
        , .(_missing: .) { widen_sum!(export_owner_missing(omember_owner(o)), Export_infos | Diag) }
        )
    }
  } else {
    widen_sum!(acc, Export_infos | Diag)
  }
}

labels { member_export_rows_state: Omembers & Export_infos };

type Member_export_rows_step = Member_export_rows_state | Export_infos | Diag;

// Canonical member rows consed after the reversed fn rows. Constructor
// precedes projector after the final reversal.
fn canonical_member_export_rows(
  , modules: Modules
  , types: Host_types
  , bridge: Bridge
  , members: Omembers
  , fn_rows: Export_infos
  ) -> Export_infos | Diag {
  loop(
    , .(state: Member_export_rows_state) {
        match! Member_export_rows_state.get(state) {
          .(remaining: Omembers, acc: Export_infos) {
            match! un_omembers(remaining) {
              (
                , .(o: Omember, rest: Omembers) {
                    match! canonical_member_row(modules, types, bridge, o, .f(Bool), acc) {
                      (
                        , .(with_ctor: Export_infos) {
                            match! canonical_member_row(
                              , modules
                              , types
                              , bridge
                              , o
                              , .t(Bool)
                              , with_ctor
                              ) {
                              (
                                , .(with_projector: Export_infos) {
                                    widen_sum!(
                                      , {member_export_rows_state = (rest, with_projector)}
                                      , Member_export_rows_step
                                      )
                                  }
                                , .(diag: Diag) { widen_sum!(diag, Member_export_rows_step) }
                                )
                            }
                          }
                        , .(diag: Diag) { widen_sum!(diag, Member_export_rows_step) }
                        )
                    }
                  }
                , .(_empty: .) { widen_sum!(acc, Member_export_rows_step) }
                )
            }
          }
        }
      }
    , {member_export_rows_state = (members, fn_rows)}
    )
}

fn public_alias_lex_diag(owner: String, alias: Alias_decl, error: Lex_err) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: malformed image — could not assemble contract for public "
      "type alias `"(String)
    , string_concat(
        , dot_join(owner, tyalias_name(alias))
        , string_concat("`: "(String), lex_err_message(error))
        )
    ))
}

fn validate_public_aliases(modules: Modules, types: Host_types, bridge: Bridge, module: Module) ->
  . | Diag
   {
  if! bridge_admits(bridge, module_name(module)) {
    loop(
      , .(remaining: Tyaliases) {
          match! un_tyaliases(remaining) {
            (
              , .(alias: Alias_decl, rest: Tyaliases) {
                  if! visibility_is_public(tyalias_visibility(alias)) {
                    match! lex(alias_sig_text(alias)) {
                      (
                        , .(header: Toks) {
                            match! derive_validated_signature(
                              , modules
                              , types
                              , module
                              , "type_contract"(String)
                              , header
                              , tyalias_decl_pos(alias)
                              , bridge
                              , dependency_subject(
                                  , "public type alias"(String)
                                  , dot_join(module_name(module), tyalias_name(alias))
                                  )
                              , tyalias_recursive_scope(alias)
                              , type_substs_nil()
                              ) {
                              (
                                , .(_valid: Derived_hostfn) {
                                    widen_sum!(rest, Tyaliases | . | Diag)
                                  }
                                , .(diag: Diag) {
                                    widen_sum!(widen_sum!(diag, . | Diag), Tyaliases | . | Diag)
                                  }
                                )
                            }
                          }
                        , .(error: Lex_err) {
                            widen_sum!(
                              , widen_sum!(
                                  , public_alias_lex_diag(module_name(module), alias, error)
                                  , . | Diag
                                  )
                              , Tyaliases | . | Diag
                              )
                          }
                        )
                    }
                  } else {
                    widen_sum!(rest, Tyaliases | . | Diag)
                  }
                }
              , .(_empty: .) { widen_sum!(widen_sum!((), . | Diag), Tyaliases | . | Diag) }
              )
          }
        }
      , module_tyaliases(module)
      )
  } else {
    widen_sum!((), . | Diag)
  }
}

fn validate_public_alias_surface(modules: Modules, types: Host_types, bridge: Bridge) -> . | Diag {
  loop(
    , .(remaining: Modules) {
        match! un_modules(remaining) {
          (
            , .(module: Module, rest: Modules) {
                match! validate_public_aliases(modules, types, bridge, module) {
                  (
                    , .(diag: Diag) { widen_sum!(widen_sum!(diag, . | Diag), Modules | . | Diag) }
                    , .(_valid: .) { widen_sum!(rest, Modules | . | Diag) }
                    )
                }
              }
            , .(_empty: .) { widen_sum!(widen_sum!((), . | Diag), Modules | . | Diag) }
            )
        }
      }
    , modules
    )
}

fn public_nominal_subject(o: Omember) -> String {
  dependency_subject(
    , "public nominal type"(String)
    , dot_join(omember_owner(o), member_name(omember_decl(o)))
    )
}

fn validate_public_nominal_header(modules: Modules, bridge: Bridge, o: Omember) -> . | Diag {
  let member = omember_decl(o);
  let subject = public_nominal_subject(o);
  match! parse_host_binders(member_header(member)) {
    (
      , .(done: Host_binders_done) {
          match! Host_binders_done.get(done) {
            .(binders: Binders, _after: Toks) {
              let _kinds = host_param_kinds(binders);
              validate_bridge_nominal_dependency(
                , modules
                , bridge
                , subject
                , mk_host_id(omember_owner(o), member_name(member))
                )
            }
          }
        }
      , .(bad: Host_binders_bad) {
          widen_sum!(
            , mk_diag(string_concat(subject, string_concat(": "(String), Host_binders_bad.get(bad))))
            , . | Diag
            )
        }
      )
  }
}

fn validate_public_nominal_surface(modules: Modules, bridge: Bridge, members: Omembers) -> . | Diag {
  loop(
    , .(remaining: Omembers) {
        match! un_omembers(remaining) {
          (
            , .(o: Omember, rest: Omembers) {
                let member = omember_decl(o);
                if! bridge_admits(bridge, omember_owner(o)) {
                  if! member_nt_pub(member) {
                    match! validate_public_nominal_header(modules, bridge, o) {
                      (
                        , .(diag: Diag) {
                            widen_sum!(widen_sum!(diag, . | Diag), Omembers | . | Diag)
                          }
                        , .(_valid: .) { widen_sum!(rest, Omembers | . | Diag) }
                        )
                    }
                  } else {
                    widen_sum!(rest, Omembers | . | Diag)
                  }
                } else {
                  widen_sum!(rest, Omembers | . | Diag)
                }
              }
            , .(_empty: .) { widen_sum!(widen_sum!((), . | Diag), Omembers | . | Diag) }
            )
        }
      }
    , members
    )
}

fn validate_public_type_surface(
  , modules: Modules
  , types: Host_types
  , bridge: Bridge
  , members: Omembers
  ) -> . | Diag {
  match! validate_public_alias_surface(modules, types, bridge) {
    (
      , .(diag: Diag) { widen_sum!(diag, . | Diag) }
      , .(_aliases_valid: .) { validate_public_nominal_surface(modules, bridge, members) }
      )
  }
}

// Builds and validates the canonical export table once at load time. The
// table is stored in Image and consumed unchanged by listing and contracts.
fn derive_export_infos(
  , modules: Modules
  , gs: Gdecls
  , members: Omembers
  , bridge: Bridge
  , types: Host_types
  ) -> Export_infos | Diag {
  match! validate_public_type_surface(modules, types, bridge, members) {
    (
      , .(diag: Diag) { widen_sum!(diag, Export_infos | Diag) }
      , .(_type_surface_valid: .) {
          match! canonical_fn_export_rows(modules, types, bridge, gs) {
            (
              , .(fn_rows: Export_infos) {
                  match! canonical_member_export_rows(modules, types, bridge, members, fn_rows) {
                    (
                      , .(all_rows: Export_infos) {
                          widen_sum!(reverse_export_infos(all_rows), Export_infos | Diag)
                        }
                      , .(diag: Diag) { widen_sum!(diag, Export_infos | Diag) }
                      )
                  }
                }
              , .(diag: Diag) { widen_sum!(diag, Export_infos | Diag) }
              )
          }
        }
      )
  }
}

// Identity-only aliases retain the terminal nominal's constructor/projector
// namespace in Kio'. The catalog resolves each alias through the ordinary
// exact-origin walker and shares completed chain suffixes, then maps
// local/selective/qualified spellings onto that terminal. Structural, partial,
// reordered, cyclic, missing, or kind-changing aliases contribute no entry.
fn param_kinds_exact_eq(left: Param_kinds, right: Param_kinds) -> Bool {
  if! param_kinds_prefix_eq(left, right) {
    param_kinds_prefix_eq(right, left)
  } else {
    .f(Bool)
  }
}

labels { identity_alias_member: Origin_terminal & Member_decl };

fn identity_alias_member_owner(resolved: Identity_alias_member) -> String {
  match! Identity_alias_member.get(resolved) {
    .(terminal: Origin_terminal, _member: Member_decl) {
      type_origin_owner(origin_terminal_origin(terminal))
    }
  }
}

fn identity_alias_member_decl(resolved: Identity_alias_member) -> Member_decl {
  match! Identity_alias_member.get(resolved) {
    .(_terminal: Origin_terminal, member: Member_decl) { member }
  }
}

fn identity_alias_member_terminal(resolved: Identity_alias_member) -> Origin_terminal {
  match! Identity_alias_member.get(resolved) {
    .(terminal: Origin_terminal, _member: Member_decl) { terminal }
  }
}

labels { identity_alias_resolution: Identity_alias_member & Alias_refs };

// The terminal alias catalog reuses the loader's artifact-local exact-key
// trie. Catalog construction below resolves every alias once and member lookup
// reads the completed terminal without rescanning declaration lists.
type Identity_alias_catalog = Exact_key_catalog(Identity_alias_member);

fn identity_alias_catalog_nil() -> Identity_alias_catalog {
  exact_key_catalog_nil(Identity_alias_member, ())
}

fn identity_alias_catalog_insert(
  , catalog: Identity_alias_catalog
  , owner: String
  , name: String
  , member: Identity_alias_member
  ) -> Identity_alias_catalog { exact_key_catalog_insert(catalog, owner, name, member) }

fn identity_alias_catalog_find(catalog: Identity_alias_catalog, owner: String, name: String) ->
  . | Identity_alias_member
   { exact_key_catalog_find(catalog, owner, name) }

fn identity_alias_ref_has_exact_kinds(
  , reference: Alias_ref
  , member: Identity_alias_member
  , index: Exact_type_index
  ) -> Bool {
  match! Alias_ref.get(reference) {
    .(owner_name: String, alias_name: String) {
      match! exact_type_index_module(index, owner_name) {
        (
          , .(owner: Module) {
              match! tyaliases_find(
                , exact_type_index_aliases(index, owner_name, alias_name)
                , alias_name
                ) {
                (
                  , .(alias: Alias_decl) {
                      match! member_param_kinds(identity_alias_member_decl(member)) {
                        (
                          , .(terminal: Param_kinds) {
                              param_kinds_exact_eq(
                                , host_param_kinds(tyalias_binders(alias))
                                , terminal
                                )
                            }
                          , .(_bad: Diag) { .f(Bool) }
                          )
                      }
                    }
                  , .(_missing: .) { .f(Bool) }
                  )
              }
            }
          , .(_missing: .) { .f(Bool) }
          )
      }
    }
  }
}

fn identity_alias_catalog_insert_refs(
  , catalog: Identity_alias_catalog
  , refs: Alias_refs
  , member: Identity_alias_member
  , index: Exact_type_index
  ) -> Identity_alias_catalog {
  loop(
    , .(state: Alias_refs & Identity_alias_catalog) {
        match! state {
          .(remaining: Alias_refs, out: Identity_alias_catalog) {
            match! uncons(Alias_ref, alias_refs_list(remaining)) {
              (
                , .(one: Alias_ref, rest: List(Alias_ref)) {
                    match! Alias_ref.get(one) {
                      .(owner: String, name: String) {
                        let next =
                          if! identity_alias_ref_has_exact_kinds(one, member, index) {
                            identity_alias_catalog_insert(out, owner, name, member)
                          } else {
                            out
                          };
                        widen_sum!(
                          , (alias_refs_with_list(remaining, rest), next)
                          , (Alias_refs & Identity_alias_catalog) | Identity_alias_catalog
                          )
                      }
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(out, (Alias_refs & Identity_alias_catalog) | Identity_alias_catalog)
                  }
                )
            }
          }
        }
      }
    , (refs, catalog)
    )
}

fn identity_alias_terminal_member(terminal: Origin_terminal) -> . | Identity_alias_member {
  let origin = origin_terminal_origin(terminal);
  let lookup = origin_terminal_lookup(terminal);
  match! type_context_find_module(lookup, type_origin_owner(origin)) {
    (
      , .(owner: Module) {
          match! members_find(
            , type_context_members(lookup, owner, type_origin_name(origin))
            , type_origin_name(origin)
            ) {
            (
              , .(member: Member_decl) {
                  widen_sum!(
                    , {identity_alias_member = (terminal, member)}
                    , . | Identity_alias_member
                    )
                }
              , .(_missing: .) { widen_sum!((), . | Identity_alias_member) }
              )
          }
        }
      , .(_missing: .) { widen_sum!((), . | Identity_alias_member) }
      )
  }
}

fn identity_alias_full_resolution(
  , alias: Alias_decl
  , owner: Module
  , modules: Modules
  , types: Host_types
  , index: Exact_type_index
  , catalog: Identity_alias_catalog
  ) -> (. | Identity_alias_resolution) & Alias_refs {
  let context =
    mk_indexed_type_context(
      , modules
      , types
      , owner
      , add_i32(tyalias_decl_pos(alias), 1(I32))
      , tyalias_recursive_scope(alias)
      , index
      );
  match! resolve_exact_type_origin_cached(
    , context
    , tyalias_name(alias)
    , .(key: String & String) {
        match! key {
          .(key_owner: String, key_name: String) {
            match! identity_alias_catalog_find(catalog, key_owner, key_name) {
              (
                , .(member: Identity_alias_member) {
                    widen_sum!(identity_alias_member_terminal(member), . | Origin_terminal)
                  }
                , .(_missing: .) { widen_sum!((), . | Origin_terminal) }
                )
            }
          }
        }
      }
    ) {
    (
      , .(resolved: Exact_origin_ok) {
          match! Exact_origin_ok.get(resolved) {
            .(origin: Type_origin, lookup: Type_context, refs: Alias_refs) {
              match! identity_alias_terminal_member(mk_origin_terminal(
                , origin
                , lookup
                , alias_refs_nil()
                )) {
                (
                  , .(member: Identity_alias_member) {
                      (
                        , widen_sum!(
                            , {identity_alias_resolution = (member, refs)}
                            , . | Identity_alias_resolution
                            )
                        , refs
                        )
                    }
                  , .(_none: .) { (widen_sum!((), . | Identity_alias_resolution), refs) }
                  )
              }
            }
          }
        }
      , .(bad: Exact_origin_bad) {
          (widen_sum!((), . | Identity_alias_resolution), exact_origin_bad_refs(bad))
        }
      )
  }
}

fn identity_alias_terminal_resolution(
  , alias: Alias_decl
  , owner: Module
  , modules: Modules
  , types: Host_types
  , index: Exact_type_index
  , catalog: Identity_alias_catalog
  ) -> (. | Identity_alias_resolution) & Alias_refs {
  match! identity_alias_target(alias) {
    (
      , .(_target: String) {
          identity_alias_full_resolution(alias, owner, modules, types, index, catalog)
        }
      , .(_not_identity: .) { (widen_sum!((), . | Identity_alias_resolution), alias_refs_nil()) }
      )
  }
}

labels { identity_alias_build_pair: Identity_alias_catalog & Alias_refs };

fn identity_alias_catalog_for_module(
  , owner: Module
  , modules: Modules
  , types: Host_types
  , index: Exact_type_index
  , initial: Identity_alias_catalog
  , initial_processed: Alias_refs
  ) -> Identity_alias_build_pair {
  loop(
    , .(state: Tyaliases & Identity_alias_catalog & Alias_refs) {
        match! state {
          .(remaining: Tyaliases, catalog: Identity_alias_catalog, processed: Alias_refs) {
            match! un_tyaliases(remaining) {
              (
                , .(alias: Alias_decl, rest: Tyaliases) {
                    let owner_name = module_name(owner);
                    let alias_name = tyalias_name(alias);
                    if! alias_refs_has(processed, owner_name, alias_name) {
                      widen_sum!(
                        , (rest, (catalog, processed))
                        , (| (Tyaliases & Identity_alias_catalog & Alias_refs)
                          | Identity_alias_build_pair)
                        )
                    } else match! identity_alias_terminal_resolution(
                      , alias
                      , owner
                      , modules
                      , types
                      , index
                      , catalog
                      ) {
                      .(resolution: . | Identity_alias_resolution, walked: Alias_refs) {
                        let all_walked = alias_refs_insert(walked, owner_name, alias_name);
                        let next_processed = alias_refs_union(all_walked, processed);
                        let next_catalog =
                          match! resolution {
                            (
                              , .(resolved: Identity_alias_resolution) {
                                  match! Identity_alias_resolution.get(resolved) {
                                    .(member: Identity_alias_member, _refs: Alias_refs) {
                                      identity_alias_catalog_insert_refs(
                                        , catalog
                                        , all_walked
                                        , member
                                        , index
                                        )
                                    }
                                  }
                                }
                              , .(_none: .) { catalog }
                              )
                          };
                        widen_sum!(
                          , (rest, (next_catalog, next_processed))
                          , (| (Tyaliases & Identity_alias_catalog & Alias_refs)
                            | Identity_alias_build_pair)
                          )
                      }
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , {identity_alias_build_pair = (catalog, processed)}
                      , (| (Tyaliases & Identity_alias_catalog & Alias_refs)
                        | Identity_alias_build_pair)
                      )
                  }
                )
            }
          }
        }
      }
    , (module_tyaliases(owner), (initial, initial_processed))
    )
}

fn identity_alias_catalog_for_modules(
  , ordered: Modules
  , modules: Modules
  , types: Host_types
  , index: Exact_type_index
  ) -> Identity_alias_catalog {
  let .(built: Identity_alias_build_pair) =
    loop(
      , .(state: Modules & Identity_alias_catalog & Alias_refs) {
          match! state {
            .(remaining: Modules, catalog: Identity_alias_catalog, processed: Alias_refs) {
              match! un_modules(remaining) {
                (
                  , .(owner: Module, rest: Modules) {
                      match! Identity_alias_build_pair.get(identity_alias_catalog_for_module(
                        , owner
                        , modules
                        , types
                        , index
                        , catalog
                        , processed
                        )) {
                        .(next_catalog: Identity_alias_catalog, next_processed: Alias_refs) {
                          widen_sum!(
                            , (rest, (next_catalog, next_processed))
                            , (| (Modules & Identity_alias_catalog & Alias_refs)
                              | Identity_alias_build_pair)
                            )
                        }
                      }
                    }
                  , .(_empty: .) {
                      widen_sum!(
                        , {identity_alias_build_pair = (catalog, processed)}
                        , (| (Modules & Identity_alias_catalog & Alias_refs)
                          | Identity_alias_build_pair)
                        )
                    }
                  )
              }
            }
          }
        }
      , (ordered, (identity_alias_catalog_nil(), alias_refs_nil()))
      );
  match! Identity_alias_build_pair.get(built) {
    .(catalog: Identity_alias_catalog, _processed: Alias_refs) { catalog }
  }
}

fn tyaliases_have_identity_member_namespace(aliases: Tyaliases) -> Bool {
  loop(
    , .(remaining: Tyaliases) {
        match! un_tyaliases(remaining) {
          (
            , .(alias: Alias_decl, rest: Tyaliases) {
                match! identity_alias_target(alias) {
                  (
                    , .(_target: String) { widen_sum!(.t(Bool), Tyaliases | Bool) }
                    , .(_not_identity: .) { widen_sum!(rest, Tyaliases | Bool) }
                    )
                }
              }
            , .(_empty: .) { widen_sum!(.f(Bool), Tyaliases | Bool) }
            )
        }
      }
    , aliases
    )
}

fn modules_have_identity_member_namespace(modules: Modules) -> Bool {
  loop(
    , .(remaining: Modules) {
        match! un_modules(remaining) {
          (
            , .(module: Module, rest: Modules) {
                if! tyaliases_have_identity_member_namespace(module_tyaliases(module)) {
                  widen_sum!(.t(Bool), Modules | Bool)
                } else {
                  widen_sum!(rest, Modules | Bool)
                }
              }
            , .(_empty: .) { widen_sum!(.f(Bool), Modules | Bool) }
            )
        }
      }
    , modules
    )
}

fn identity_alias_member_for_projection(
  , alias: Alias_decl
  , owner: Module
  , catalog: Identity_alias_catalog
  ) -> . | Identity_alias_member {
  // The catalog contains every independently validated member-capable alias.
  // A miss stays fail-closed: re-resolving it here could turn an ambiguous
  // consumer spelling into a member namespace. The caller uses the complete
  // consumer type context to reject conflicting visible origins.
  identity_alias_catalog_find(catalog, module_name(owner), tyalias_name(alias))
}

fn visible_type_binding_origin_diag(consumer: String, spelling: String) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: malformed image — module `"(String)
    , string_concat(
        , consumer
        , string_concat(
            , "` has visible type bindings named `"(String)
            , string_concat(spelling, "` that do not share one declaration origin"(String))
            )
        )
    ))
}

fn ntab_add_identity_alias(
  , alias: Alias_decl
  , owner: Module
  , consumer_context: Type_context
  , spelling: String
  , catalog: Identity_alias_catalog
  , acc: Ntab
  ) -> Ntab | Diag {
  let consumer = module_name(type_context_module(consumer_context));
  if! visibility_allows(tyalias_visibility(alias), module_name(owner), consumer) {
    match! identity_alias_member_for_projection(alias, owner, catalog) {
      (
        , .(resolved: Identity_alias_member) {
            match! resolve_exact_type_origin_cached(
              , consumer_context
              , spelling
              , .(key: String & String) {
                  match! key {
                    .(key_owner: String, key_name: String) {
                      match! identity_alias_catalog_find(catalog, key_owner, key_name) {
                        (
                          , .(member: Identity_alias_member) {
                              widen_sum!(
                                , identity_alias_member_terminal(member)
                                , . | Origin_terminal
                                )
                            }
                          , .(_missing: .) { widen_sum!((), . | Origin_terminal) }
                          )
                      }
                    }
                  }
                }
              ) {
              (
                , .(visible: Exact_origin_ok) {
                    match! Exact_origin_ok.get(visible) {
                      .(visible_origin: Type_origin, _lookup: Type_context, _refs: Alias_refs) {
                        let terminal = identity_alias_member_terminal(resolved);
                        if! type_origin_eq(origin_terminal_origin(terminal), visible_origin) {
                          let terminal_owner = identity_alias_member_owner(resolved);
                          let member = identity_alias_member_decl(resolved);
                          widen_sum!(
                            , ntab_cons_visible(
                                , spelling
                                , member_info(member)
                                , visibility_allows(
                                    , member_ctor_visibility(member)
                                    , terminal_owner
                                    , consumer
                                    )
                                , visibility_allows(
                                    , member_proj_visibility(member)
                                    , terminal_owner
                                    , consumer
                                    )
                                , acc
                                )
                            , Ntab | Diag
                            )
                        } else {
                          widen_sum!(
                            , visible_type_binding_origin_diag(consumer, spelling)
                            , Ntab | Diag
                            )
                        }
                      }
                    }
                  }
                , .(_bad: Exact_origin_bad) {
                    widen_sum!(visible_type_binding_origin_diag(consumer, spelling), Ntab | Diag)
                  }
                )
            }
          }
        , .(_none: .) { widen_sum!(acc, Ntab | Diag) }
        )
    }
  } else {
    widen_sum!(acc, Ntab | Diag)
  }
}

fn ntab_add_identity_aliases_from(
  , owner: Module
  , consumer_context: Type_context
  , prefix: . | String
  , catalog: Identity_alias_catalog
  , acc: Ntab
  ) -> Ntab | Diag {
  loop(
    , .(state: Tyaliases & Ntab) {
        match! state {
          .(remaining: Tyaliases, out: Ntab) {
            match! un_tyaliases(remaining) {
              (
                , .(alias: Alias_decl, rest: Tyaliases) {
                    let spelling =
                      match! prefix {
                        (
                          , .(head: String) { dot_join(head, tyalias_name(alias)) }
                          , .(_bare: .) { tyalias_name(alias) }
                          )
                      };
                    match! ntab_add_identity_alias(
                      , alias
                      , owner
                      , consumer_context
                      , spelling
                      , catalog
                      , out
                      ) {
                      (
                        , .(next: Ntab) {
                            widen_sum!((rest, next), (Tyaliases & Ntab) | Ntab | Diag)
                          }
                        , .(diag: Diag) { widen_sum!(diag, (Tyaliases & Ntab) | Ntab | Diag) }
                        )
                    }
                  }
                , .(_empty: .) { widen_sum!(out, (Tyaliases & Ntab) | Ntab | Diag) }
                )
            }
          }
        }
      }
    , (module_tyaliases(owner), acc)
    )
}

fn ntab_add_selective_identity_aliases(
  , module: Module
  , consumer_context: Type_context
  , index: Exact_type_index
  , catalog: Identity_alias_catalog
  , acc: Ntab
  ) -> Ntab | Diag {
  loop(
    , .(state: Imports & Ntab) {
        match! state {
          .(remaining: Imports, out: Ntab) {
            match! un_imports(remaining) {
              (
                , .(one: Import, rest: Imports) {
                    match! un_import(one) {
                      .(name: String, provider: String) {
                        match! exact_type_index_module(index, provider) {
                          (
                            , .(owner: Module) {
                                match! tyaliases_find(
                                  , exact_type_index_aliases(index, provider, name)
                                  , name
                                  ) {
                                  (
                                    , .(alias: Alias_decl) {
                                        match! ntab_add_identity_alias(
                                          , alias
                                          , owner
                                          , consumer_context
                                          , name
                                          , catalog
                                          , out
                                          ) {
                                          (
                                            , .(next: Ntab) {
                                                widen_sum!(
                                                  , (rest, next)
                                                  , (Imports & Ntab) | Ntab | Diag
                                                  )
                                              }
                                            , .(diag: Diag) {
                                                widen_sum!(diag, (Imports & Ntab) | Ntab | Diag)
                                              }
                                            )
                                        }
                                      }
                                    , .(_not_alias: .) {
                                        widen_sum!((rest, out), (Imports & Ntab) | Ntab | Diag)
                                      }
                                    )
                                }
                              }
                            , .(_missing: .) {
                                widen_sum!((rest, out), (Imports & Ntab) | Ntab | Diag)
                              }
                            )
                        }
                      }
                    }
                  }
                , .(_empty: .) { widen_sum!(out, (Imports & Ntab) | Ntab | Diag) }
                )
            }
          }
        }
      }
    , (module_imports(module), acc)
    )
}

fn ntab_add_qualified_identity_aliases(
  , module: Module
  , consumer_context: Type_context
  , index: Exact_type_index
  , catalog: Identity_alias_catalog
  , acc: Ntab
  ) -> Ntab | Diag {
  loop(
    , .(state: Aliases & Ntab) {
        match! state {
          .(remaining: Aliases, out: Ntab) {
            match! un_aliases(remaining) {
              (
                , .(qualified: Mod_alias, rest: Aliases) {
                    match! exact_type_index_module(index, alias_target(qualified)) {
                      (
                        , .(owner: Module) {
                            match! ntab_add_identity_aliases_from(
                              , owner
                              , consumer_context
                              , widen_sum!(alias_name(qualified), . | String)
                              , catalog
                              , out
                              ) {
                              (
                                , .(next: Ntab) {
                                    widen_sum!((rest, next), (Aliases & Ntab) | Ntab | Diag)
                                  }
                                , .(diag: Diag) { widen_sum!(diag, (Aliases & Ntab) | Ntab | Diag) }
                                )
                            }
                          }
                        , .(_missing: .) { widen_sum!((rest, out), (Aliases & Ntab) | Ntab | Diag) }
                        )
                    }
                  }
                , .(_empty: .) { widen_sum!(out, (Aliases & Ntab) | Ntab | Diag) }
                )
            }
          }
        }
      }
    , (module_aliases(module), acc)
    )
}

// Type aliases, host types, newtypes, and selected imports each introduce
// their written spelling once. Alias-member projection is validated separately.
type Validated_type_spellings = Exact_key_catalog(Bool);

type Type_spelling_validation = Validated_type_spellings | Diag;

fn validate_type_spelling_occurrence(seen: Validated_type_spellings, owner: String, name: String) -> Type_spelling_validation {
  match! exact_key_catalog_find(seen, owner, name) {
    (
      , .(_prior: Bool) {
          widen_sum!(
            , mk_diag(string_concat(
                , "dyn_load_prime: malformed image — module `"(String)
                , string_concat(
                    , owner
                    , string_concat(
                        , "` introduces visible type binding `"(String)
                        , string_concat(name, "` more than once"(String))
                        )
                    )
                ))
            , Type_spelling_validation
            )
        }
      , .(_first: .) {
          widen_sum!(
            , exact_key_catalog_insert(seen, owner, name, .t(Bool))
            , Type_spelling_validation
            )
        }
      )
  }
}

fn validate_type_spelling_names(names: Pnames, owner: String, initial: Validated_type_spellings) -> Type_spelling_validation {
  loop(
    , .(state: Pnames & Validated_type_spellings) {
        match! state {
          .(remaining: Pnames, seen: Validated_type_spellings) {
            match! un_pnames(remaining) {
              (
                , .(name: String, rest: Pnames) {
                    match! validate_type_spelling_occurrence(seen, owner, name) {
                      (
                        , .(next: Validated_type_spellings) {
                            widen_sum!(
                              , (rest, next)
                              , (Pnames & Validated_type_spellings) | Type_spelling_validation
                              )
                          }
                        , .(diag: Diag) {
                            widen_sum!(
                              , diag
                              , (Pnames & Validated_type_spellings) | Type_spelling_validation
                              )
                          }
                        )
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(seen, (Pnames & Validated_type_spellings) | Type_spelling_validation)
                  }
                )
            }
          }
        }
      }
    , (names, initial)
    )
}

fn validate_type_spelling_members(
  , members: Members
  , owner: String
  , initial: Validated_type_spellings
  ) -> Type_spelling_validation {
  loop(
    , .(state: Members & Validated_type_spellings) {
        match! state {
          .(remaining: Members, seen: Validated_type_spellings) {
            match! un_members(remaining) {
              (
                , .(member: Member_decl, rest: Members) {
                    match! validate_type_spelling_occurrence(seen, owner, member_name(member)) {
                      (
                        , .(next: Validated_type_spellings) {
                            widen_sum!(
                              , (rest, next)
                              , (Members & Validated_type_spellings) | Type_spelling_validation
                              )
                          }
                        , .(diag: Diag) {
                            widen_sum!(
                              , diag
                              , (Members & Validated_type_spellings) | Type_spelling_validation
                              )
                          }
                        )
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , seen
                      , (Members & Validated_type_spellings) | Type_spelling_validation
                      )
                  }
                )
            }
          }
        }
      }
    , (members, initial)
    )
}

fn exact_type_index_has_type_binding(index: Exact_type_index, owner: String, name: String) -> Bool {
  match! un_tyaliases(exact_type_index_aliases(index, owner, name)) {
    (
      , .(_alias: Alias_decl, _rest: Tyaliases) { .t(Bool) }
      , .(_no_alias: .) {
          match! un_members(exact_type_index_members(index, owner, name)) {
            (
              , .(_member: Member_decl, _rest: Members) { .t(Bool) }
              , .(_no_member: .) {
                  loop(
                    , .(headers: Host_headers) {
                        match! un_host_headers(headers) {
                          (
                            , .(header: Host_header, rest: Host_headers) {
                                if! host_header_is_fn(header) {
                                  widen_sum!(rest, Host_headers | Bool)
                                } else {
                                  widen_sum!(.t(Bool), Host_headers | Bool)
                                }
                              }
                            , .(_none: .) { widen_sum!(.f(Bool), Host_headers | Bool) }
                            )
                        }
                      }
                    , exact_type_index_host_headers(index, owner, name)
                    )
                }
              )
          }
        }
      )
  }
}

fn validate_type_spelling_imports(
  , imports: Imports
  , owner: String
  , index: Exact_type_index
  , initial: Validated_type_spellings
  ) -> Type_spelling_validation {
  loop(
    , .(state: Imports & Validated_type_spellings) {
        match! state {
          .(remaining: Imports, seen: Validated_type_spellings) {
            match! un_imports(remaining) {
              (
                , .(one: Import, rest: Imports) {
                    match! un_import(one) {
                      .(name: String, provider: String) {
                        if! exact_type_index_has_type_binding(index, provider, name) {
                          match! validate_type_spelling_occurrence(seen, owner, name) {
                            (
                              , .(next: Validated_type_spellings) {
                                  widen_sum!(
                                    , (rest, next)
                                    , (| (Imports & Validated_type_spellings)
                                      | Type_spelling_validation)
                                    )
                                }
                              , .(diag: Diag) {
                                  widen_sum!(
                                    , diag
                                    , (| (Imports & Validated_type_spellings)
                                      | Type_spelling_validation)
                                    )
                                }
                              )
                          }
                        } else {
                          widen_sum!(
                            , (rest, seen)
                            , (Imports & Validated_type_spellings) | Type_spelling_validation
                            )
                        }
                      }
                    }
                  }
                , .(_empty: .) {
                    widen_sum!(
                      , seen
                      , (Imports & Validated_type_spellings) | Type_spelling_validation
                      )
                  }
                )
            }
          }
        }
      }
    , (imports, initial)
    )
}

fn validate_visible_type_binding_origins(module: Module, index: Exact_type_index) -> Imports_validation {
  let owner = module_name(module);
  let empty = exact_key_catalog_nil(Bool, ());
  match! validate_type_spelling_names(module_typenames(module), owner, empty) {
    (
      , .(with_names: Validated_type_spellings) {
          match! validate_type_spelling_members(module_members(module), owner, with_names) {
            (
              , .(with_members: Validated_type_spellings) {
                  match! validate_type_spelling_imports(
                    , module_imports(module)
                    , owner
                    , index
                    , with_members
                    ) {
                    (
                      , .(_valid: Validated_type_spellings) {
                          widen_sum!({imports_valid=}, Imports_validation)
                        }
                      , .(diag: Diag) { widen_sum!(diag, Imports_validation) }
                      )
                  }
                }
              , .(diag: Diag) { widen_sum!(diag, Imports_validation) }
              )
          }
        }
      , .(diag: Diag) { widen_sum!(diag, Imports_validation) }
      )
  }
}

fn ntab_for_module_with_exact_type_origins(
  , module: Module
  , modules: Modules
  , types: Host_types
  , index: Exact_type_index
  , catalog: Identity_alias_catalog
  ) -> Ntab | Diag {
  // Dynamic loading trusts precompiled bodies, but import/binding-origin
  // structure is rederived from the whole module. Reuse one exact consumer
  // context so alias projections reconcile against every visible type binding,
  // including aliases and host types that do not themselves own members.
  let consumer_context =
    mk_indexed_type_context(
      , modules
      , types
      , module
      , 2147483647(I32)
      , no_recursive_type_scope()
      , index
      );
  match! validate_visible_type_binding_origins(module, index) {
    (
      , .(_origins_valid: Imports_valid) {
          let initial = ntab_for_module(module, modules);
          let local =
            ntab_add_identity_aliases_from(
              , module
              , consumer_context
              , widen_sum!((), . | String)
              , catalog
              , initial
              );
          match! local {
            (
              , .(local_ok: Ntab) {
                  match! ntab_add_selective_identity_aliases(
                    , module
                    , consumer_context
                    , index
                    , catalog
                    , local_ok
                    ) {
                    (
                      , .(selective: Ntab) {
                          match! ntab_add_qualified_identity_aliases(
                            , module
                            , consumer_context
                            , index
                            , catalog
                            , selective
                            ) {
                            (
                              , .(qualified: Ntab) { widen_sum!(qualified, Ntab | Diag) }
                              , .(diag: Diag) { widen_sum!(diag, Ntab | Diag) }
                              )
                          }
                        }
                      , .(diag: Diag) { widen_sum!(diag, Ntab | Diag) }
                      )
                  }
                }
              , .(diag: Diag) { widen_sum!(diag, Ntab | Diag) }
              )
          }
        }
      , .(diag: Diag) { widen_sum!(diag, Ntab | Diag) }
      )
  }
}

/// Resolves a whole package (topo-sorted, per-module-scoped, host fns
/// derived from the modules' declarations) to a resolved image, or a
/// diagnostic naming malformed host declarations, imports, cycles, or
/// bodies. The bridge surface narrows the image's contract surface.
pub(loader) fn resolve_package(ms: Modules, bridge: Bridge) -> Load_outcome {
  match! collect_host_types(ms) {
    (
      , .(types: Host_types) {
          match! validate_package_binding_origins(ms) {
            (
              , .(_imports_valid: Imports_valid) {
                  match! validate_package_bridge(ms, bridge) {
                    (
                      , .(_bridge_valid: Bridge_valid) {
                          match! derive_package_runtime_hostfns(ms, types) {
                            (
                              , .(selected: Hostfn_selection) {
                                  match! Hostfn_selection.get(selected) {
                                    .(hostfns: Runtime_hostfns, _runtime_types: Host_types) {
                                      match! derive_bridge_contract(ms, bridge, types) {
                                        (
                                          , .(requirements: Host_contract) {
                                              load_package_terms(
                                                , ms
                                                , bridge
                                                , hostfns
                                                , requirements
                                                , .(ordered: Modules) {
                                                    let needs_exact_type_index =
                                                      if! modules_have_identity_member_namespace(ms) {
                                                        .t(Bool)
                                                      } else {
                                                        modules_have_type_spelling_overlap(ms)
                                                      };
                                                    if! needs_exact_type_index {
                                                      let type_index = exact_type_index_for_modules(ms);
                                                      let catalog = identity_alias_catalog_for_modules(
                                                        , ordered
                                                        , ms
                                                        , types
                                                        , type_index
                                                        );
                                                      .(module: Module) {
                                                        ntab_for_module_with_exact_type_origins(
                                                          , module
                                                          , ms
                                                          , types
                                                          , type_index
                                                          , catalog
                                                          )
                                                      }
                                                    } else {
                                                      .(module: Module) {
                                                        widen_sum!(
                                                          , ntab_for_module(module, ms)
                                                          , Ntab | Diag
                                                          )
                                                      }
                                                    }
                                                  }
                                                , .(parts: Gdecls & Omembers) {
                                                    match! parts {
                                                      .(gs: Gdecls, members: Omembers) {
                                                        derive_export_infos(
                                                          , ms
                                                          , gs
                                                          , members
                                                          , bridge
                                                          , types
                                                          )
                                                      }
                                                    }
                                                  }
                                                , .(owner: String, position: I32, spelling: String) {
                                                    exact_host_type_for_decl(
                                                      , ms
                                                      , types
                                                      , owner
                                                      , position
                                                      , spelling
                                                      )
                                                  }
                                                , .(owner: String, position: I32) {
                                                    exact_bool_type_for_decl(
                                                      , ms
                                                      , types
                                                      , owner
                                                      , position
                                                      )
                                                  }
                                                )
                                            }
                                          , .(diag: Diag) { lr_diag(diag) }
                                          )
                                      }
                                    }
                                  }
                                }
                              , .(diag: Diag) { lr_diag(diag) }
                              )
                          }
                        }
                      , .(diag: Diag) { lr_diag(diag) }
                      )
                  }
                }
              , .(diag: Diag) { lr_diag(diag) }
              )
          }
        }
      , .(diag: Diag) { lr_diag(diag) }
      )
  }
}

// The shared lookup-failure diagnostics (the export ops and the contract
// check report absence and ambiguity identically).
fn absent_export_diag(name: String) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: the image's surface declares no exported `"(String)
    , string_concat(name, "`"(String))
    ))
}

fn ambiguous_export_diag(name: String, candidates: Pnames) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: `"(String)
    , string_concat(
        , name
        , string_concat(
            , "` is ambiguous — qualify it as one of: "(String)
            , pnames_render(candidates)
            )
        )
    ))
}

// =====================================================================
// The existential boundary — `Loaded`, a record of ops over a hidden P
// =====================================================================
//
// `instantiate` presents a loaded image at the host-expected existential
// interface. `dyn_load_prime` provides one **universal** such interface,
// `Loaded = exists P. Surface(P)`: the representation `P` of a loaded
// guest value is hidden behind the nominal boundary, and the surface is a
// **record** of the operations a host needs to use a `P` — one labeled
// field per operation, accessed by name (`surf.?{lookup}`; see
// `docs/guides/products.md`). Row polymorphism lets a host
// helper demand only the fields it uses: `fn f[P, R](surf: Lookup(P) &
// Apply(P) & R)`.
//
// Every fallible operation returns value-or-`Diag`, so a failure says
// what went wrong — the absent or ambiguous export by name, the stuck
// call's reason (including the unknown host identity), the wrong-shape
// marshal — rather than collapsing to `()`.
//
// The host opens `Loaded` with its CPS projector, getting a fresh
// universe `P` and the record; it calls a guest export by marshalling
// arguments in (`i32_in`, `str_in`, `pair_in`, …), applying the looked-up
// closure, and marshalling the result back out — never learning that `P`
// is `dyn_load_prime`'s `Value`. A host that knows the guest's signatures
// wraps this in its own typed interface, which type-checks at the host's
// own compile time. A **multi-value-param** export takes one product
// domain (`specs/prime.md` § Functions are unary over one domain type):
// call `f(a, b, c)` by folding the right-nested product with `pair_in`. A
// **zero-param** export takes the `unit_in` value. Under the erased
// runtime `P` IS `Value` (the universal representation), so the pack is a
// no-op and the surface entries are the loader's own closures.
/// Defines the lookup operation: the named export's already-evaluated value.
pub labels { lookup[P]: String -> P | Diag };

/// Defines the apply operation: apply a loaded closure to a loaded value.
pub labels { apply[P]: (P & P) -> P | Diag };

/// Defines the explicit-budget apply operation.
pub labels { apply_fuel[P]: (P & P & I32) -> P | Diag };

/// Defines the unit value (what a zero-param export is applied to).
pub labels { unit_in[P]: P };

/// Defines the host-i32 in-marshal.
pub labels { i32_in[P]: I32 -> P };

/// Defines the host-i32 out-marshal.
pub labels { i32_out[P]: P -> I32 | Diag };

/// Defines the host-f64 in-marshal.
pub labels { f64_in[P]: F64 -> P };

/// Defines the host-f64 out-marshal.
pub labels { f64_out[P]: P -> F64 | Diag };

/// Defines the host-string in-marshal.
pub labels { str_in[P]: String -> P };

/// Defines the host-string out-marshal.
pub labels { str_out[P]: P -> String | Diag };

/// Defines the host-bool in-marshal.
pub labels { bool_in[P]: Bool -> P };

/// Defines the host-bool out-marshal.
pub labels { bool_out[P]: P -> Bool | Diag };

/// Defines the product constructor (fold multi-param arguments with it).
pub labels { pair_in[P]: (P & P) -> P };

/// Defines the product decomposition.
pub labels { pair_out[P]: P -> (P & P) | Diag };

/// Defines the left sum injection.
pub labels { left_in[P]: P -> P };

/// Defines the right sum injection.
pub labels { right_in[P]: P -> P };

/// Defines the sum-arm test: whether a sum value is the left injection.
pub labels { sum_is_left[P]: P -> Bool | Diag };

/// Defines the sum-payload projection.
pub labels { sum_payload[P]: P -> P | Diag };

/// Defines the host-capability injection: mints a guest-callable value from
/// an exact descriptor offered by the adapter and its separate public group
/// inventory. A missing or mismatched descriptor is diagnosed immediately.
pub labels { hostfn_in[P]: Host_fn -> P | Diag };

/// Defines the surface's export listing (names + canonical signatures).
pub labels { exports: Export_infos };

/// The record of operations a host performs over a loaded guest value at
/// the hidden type `P` — one labeled field per operation.
pub type Surface[P] =
  & Lookup(P)
  & Apply(P)
  & Apply_fuel(P)
  & Unit_in(P)
  & I32_in(P)
  & I32_out(P)
  & F64_in(P)
  & F64_out(P)
  & Str_in(P)
  & Str_out(P)
  & Bool_in(P)
  & Bool_out(P)
  & Pair_in(P)
  & Pair_out(P)
  & Left_in(P)
  & Right_in(P)
  & Sum_is_left(P)
  & Sum_payload(P)
  & Hostfn_in(P)
  & Exports
  ;

/// A loaded, instantiated package: an existential hiding the representation
/// `P` (the existential witness the host never sees) behind the surface record.
pub labels { loaded <P> : Surface(P) };

// =====================================================================
// Binding the chain once — the instantiation environment
// =====================================================================
//
// `instantiate` evaluates every top-level binding exactly once, in chain
// order — the seeded host fns (outermost), then each guest fn in the
// resolved global order, each next binding evaluated in the environment
// of the previous ones. The result is the environment a `lookup` reads by
// de Bruijn position: no per-lookup re-evaluation. A top-level binding
// whose evaluation goes stuck fails the instantiation with a `Diag`
// naming the declaration and the reason.
fn un_eval_result(r: Eval_result) -> Ev_done | Ev_stuck { r }

fn seed_env(hfs: Runtime_hostfns) -> Env {
  loop(
    , .(st: Runtime_hostfns & Env) {
        match! st {
          .(rem: Runtime_hostfns, acc: Env) {
            match! un_runtime_hostfns(rem) {
              (
                , .(entry: Runtime_hostfn, rest: Runtime_hostfns) {
                    let hostfn = runtime_hostfn_public(entry);
                    widen_sum!(
                      , (
                          , rest
                          , env_push(
                              , vhostfn_fresh(
                                  , hostfn_descriptor(hostfn)
                                  , runtime_hostfn_groups(entry)
                                  )
                              , acc
                              )
                          )
                      , (Runtime_hostfns & Env) | Env
                      )
                  }
                , .(_e: .) { widen_sum!(acc, (Runtime_hostfns & Env) | Env) }
                )
            }
          }
        }
      }
    , (hfs, env_nil())
    )
}

// The qualified name of the global decl the chain is currently binding
// (for the stuck diagnostic), or a placeholder when the lists disagree.
fn head_gdecl_name(gs: Gdecls) -> String {
  match! un_gdecls(gs) {
    (
      , .(g: Gdecl, _rest: Gdecls) { gdecl_qualified(g) }
      , .(_e: .) { "<unknown declaration>"(String) }
      )
  }
}

fn rest_gdecls(gs: Gdecls) -> Gdecls {
  match! un_gdecls(gs) {
    (.(_g: Gdecl, rest: Gdecls) { rest }, .(_e: .) { gs })
  }
}

fn eval_chain(
  , call: (Host_fn & Value) -> Call_result
  , make_lit: (String & Host_type) -> Value
  , test_bool: (Host_type & Scalar) -> Side
  , im: Image
  ) -> Env | Diag {
  loop(
    , .(st: Gdecls & Terms_acc & Env) {
        match! st {
          .(gs: Gdecls, ts: Terms_acc, env: Env) {
            match! un_terms_acc(ts) {
              (
                , .(t: Term, ts_rest: Terms_acc) {
                    match! un_eval_result(prime_eval_in(call, make_lit, test_bool, t, env)) {
                      (
                        , .(v: Ev_done) {
                            widen_sum!(
                              , (rest_gdecls(gs), (ts_rest, env_push(Ev_done.get(v), env)))
                              , (Gdecls & Terms_acc & Env) | Env | Diag
                              )
                          }
                        , .(s: Ev_stuck) {
                            widen_sum!(
                              , mk_diag(string_concat(
                                  , "dyn_load_prime: evaluating top-level `"(String)
                                  , string_concat(
                                      , head_gdecl_name(gs)
                                      , string_concat("` got stuck — "(String), stuck_reason(s))
                                      )
                                  ))
                              , (Gdecls & Terms_acc & Env) | Env | Diag
                              )
                          }
                        )
                    }
                  }
                , .(_done: .) { widen_sum!(env, (Gdecls & Terms_acc & Env) | Env | Diag) }
                )
            }
          }
        }
      }
    , (image_gdecls(im), (image_terms(im), seed_env(image_runtime_hostfns(im))))
    )
}

// =====================================================================
// The concrete surface over `Value`
// =====================================================================
//
// These closures realize `Surface(Value)`; packing them as `Surface(P)`
// is the no-op existential pack. The host capabilities and the bound
// environment are captured, so an export's host effects dispatch through
// the capabilities the host supplied at `instantiate`.
fn not_shape_diag(wanted: String) -> Diag {
  mk_diag(string_concat("dyn_load_prime: the value is not "(String), wanted))
}

// Project a typed host value out of a marshalled `Value`, host-side:
// `value_to_scalar` unwraps the opaque scalar from the `V_host` arm (a
// structural value-model projection, not a scalar inspection), then the
// host's `scalar_as_*` asks for the typed value.
fn surf_i32_out(v: Value) -> I32 | Diag {
  match! value_to_scalar(v) {
    (
      , .(s: Scalar) {
          match! scalar_as_i32(s) {
            (
              , .(n: I32) { widen_sum!(n, I32 | Diag) }
              , .(_no: .) { widen_sum!(not_shape_diag("an i32"(String)), I32 | Diag) }
              )
          }
        }
      , .(_no: .) { widen_sum!(not_shape_diag("a host scalar"(String)), I32 | Diag) }
      )
  }
}

fn surf_f64_out(v: Value) -> F64 | Diag {
  match! value_to_scalar(v) {
    (
      , .(s: Scalar) {
          match! scalar_as_f64(s) {
            (
              , .(n: F64) { widen_sum!(n, F64 | Diag) }
              , .(_no: .) { widen_sum!(not_shape_diag("an f64"(String)), F64 | Diag) }
              )
          }
        }
      , .(_no: .) { widen_sum!(not_shape_diag("a host scalar"(String)), F64 | Diag) }
      )
  }
}

fn surf_str_out(v: Value) -> String | Diag {
  match! value_to_scalar(v) {
    (
      , .(s: Scalar) {
          match! scalar_as_str(s) {
            (
              , .(t: String) { widen_sum!(t, String | Diag) }
              , .(_no: .) { widen_sum!(not_shape_diag("a string"(String)), String | Diag) }
              )
          }
        }
      , .(_no: .) { widen_sum!(not_shape_diag("a host scalar"(String)), String | Diag) }
      )
  }
}

fn surf_bool_out(v: Value) -> Bool | Diag {
  match! value_to_scalar(v) {
    (
      , .(s: Scalar) {
          match! scalar_as_bool(s) {
            (
              , .(b: Bool) { widen_sum!(b, Bool | Diag) }
              , .(_no: .) { widen_sum!(not_shape_diag("a bool"(String)), Bool | Diag) }
              )
          }
        }
      , .(_no: .) { widen_sum!(not_shape_diag("a host scalar"(String)), Bool | Diag) }
      )
  }
}

fn surf_pair_out(v: Value) -> (Value & Value) | Diag {
  match! un_value(v) {
    (
      , .(p: V_product) {
          match! V_product.get(p) {
            .(a: Value, b: Value) { widen_sum!((a, b), (Value & Value) | Diag) }
          }
        }
      , .(_c: V_closure) { widen_sum!(not_shape_diag("a product"(String)), (Value & Value) | Diag) }
      , .(_s: V_sum) { widen_sum!(not_shape_diag("a product"(String)), (Value & Value) | Diag) }
      , .(_u: V_unit) { widen_sum!(not_shape_diag("a product"(String)), (Value & Value) | Diag) }
      , .(_h: V_host) { widen_sum!(not_shape_diag("a product"(String)), (Value & Value) | Diag) }
      , .(_f: V_hostfn) { widen_sum!(not_shape_diag("a product"(String)), (Value & Value) | Diag) }
      )
  }
}

fn surf_sum_is_left(v: Value) -> Bool | Diag {
  match! un_value(v) {
    (
      , .(sm: V_sum) {
          match! V_sum.get(sm) {
            .(sd: Side, _payload: Value) {
              widen_sum!(side_select(.t(Bool), .f(Bool), sd), Bool | Diag)
            }
          }
        }
      , .(_c: V_closure) { widen_sum!(not_shape_diag("a sum"(String)), Bool | Diag) }
      , .(_p: V_product) { widen_sum!(not_shape_diag("a sum"(String)), Bool | Diag) }
      , .(_u: V_unit) { widen_sum!(not_shape_diag("a sum"(String)), Bool | Diag) }
      , .(_h: V_host) { widen_sum!(not_shape_diag("a sum"(String)), Bool | Diag) }
      , .(_f: V_hostfn) { widen_sum!(not_shape_diag("a sum"(String)), Bool | Diag) }
      )
  }
}

fn surf_sum_payload(v: Value) -> Value | Diag {
  match! un_value(v) {
    (
      , .(sm: V_sum) {
          match! V_sum.get(sm) {
            .(_sd: Side, payload: Value) { widen_sum!(payload, Value | Diag) }
          }
        }
      , .(_c: V_closure) { widen_sum!(not_shape_diag("a sum"(String)), Value | Diag) }
      , .(_p: V_product) { widen_sum!(not_shape_diag("a sum"(String)), Value | Diag) }
      , .(_u: V_unit) { widen_sum!(not_shape_diag("a sum"(String)), Value | Diag) }
      , .(_h: V_host) { widen_sum!(not_shape_diag("a sum"(String)), Value | Diag) }
      , .(_f: V_hostfn) { widen_sum!(not_shape_diag("a sum"(String)), Value | Diag) }
      )
  }
}

// Look the named export's bound value up in the instantiation environment.
fn env_export(im: Image, env: Env, name: String) -> Value | Diag {
  match! un_export_find(find_export(im, name)) {
    (
      , .(hit: Ef_found) {
          match! Ef_found.get(hit) {
            .(pos: I32, _g: Gdecl) {
              let total = terms_acc_len(image_terms(im));
              let idx = sub_i32(sub_i32(total, 1(I32)), pos);
              match! env_lookup(env, nat_of_i32(idx)) {
                (
                  , .(v: Value) { widen_sum!(v, Value | Diag) }
                  , .(_oob: .) {
                      widen_sum!(
                        , mk_diag("dyn_load_prime: the instantiation environment is out of step with the "
                                  "image's declarations"(String))
                        , Value | Diag
                        )
                    }
                  )
              }
            }
          }
        }
      , .(_absent: Ef_absent) { widen_sum!(absent_export_diag(name), Value | Diag) }
      , .(amb: Ef_ambiguous) {
          widen_sum!(ambiguous_export_diag(name, Ef_ambiguous.get(amb)), Value | Diag)
        }
      , .(mh: Ef_member) {
          match! Ef_member.get(mh) {
            .(o: Omember, is_proj: Bool) {
              widen_sum!(member_value(omember_decl(o), is_proj), Value | Diag)
            }
          }
        }
      )
  }
}

// Apply through the evaluator, mapping a stuck run to its reason.
fn apply_diag(
  , call: (Host_fn & Value) -> Call_result
  , make_lit: (String & Host_type) -> Value
  , test_bool: (Host_type & Scalar) -> Side
  , f: Value
  , a: Value
  , fuel: I32
  ) -> Value | Diag {
  match! un_eval_result(prime_apply_fuel(call, make_lit, test_bool, f, a, fuel)) {
    (
      , .(v: Ev_done) { widen_sum!(Ev_done.get(v), Value | Diag) }
      , .(s: Ev_stuck) {
          widen_sum!(
            , mk_diag(string_concat(
                , "dyn_load_prime: the call got stuck — "(String)
                , stuck_reason(s)
                ))
            , Value | Diag
            )
        }
      )
  }
}

// Build the concrete surface record over `Value` for an instantiated
// image: the host capabilities and the bound environment are captured
// into the operation closures.
fn value_surface(
  , adapter: Host_adapter
  , call: (Host_fn & Value) -> Call_result
  , make_lit: (String & Host_type) -> Value
  , test_bool: (Host_type & Scalar) -> Side
  , im: Image
  , env: Env
  ) -> Surface(Value) {
  {
    , lookup = .(name: String) -> Value | Diag { env_export(im, env, name) }
    , apply = .(pair: Value & Value) -> Value | Diag {
        match! pair {
          .(f: Value, a: Value) { apply_diag(call, make_lit, test_bool, f, a, default_fuel()) }
        }
      }
    , apply_fuel = .(triple: Value & Value & I32) -> Value | Diag {
        match! triple {
          .(f: Value, a: Value, fuel: I32) { apply_diag(call, make_lit, test_bool, f, a, fuel) }
        }
      }
    , unit_in = vunit()
    , i32_in = .(n: I32) -> Value { vhost(scalar_of_i32(n)) }
    , i32_out = .(v: Value) -> I32 | Diag { surf_i32_out(v) }
    , f64_in = .(n: F64) -> Value { vhost(scalar_of_f64(n)) }
    , f64_out = .(v: Value) -> F64 | Diag { surf_f64_out(v) }
    , str_in = .(s: String) -> Value { vhost(scalar_of_str(s)) }
    , str_out = .(v: Value) -> String | Diag { surf_str_out(v) }
    , bool_in = .(b: Bool) -> Value { vhost(scalar_of_bool(b)) }
    , bool_out = .(v: Value) -> Bool | Diag { surf_bool_out(v) }
    , pair_in = .(prod: Value & Value) -> Value {
        match! prod {
          .(a: Value, b: Value) { vproduct(a, b) }
        }
      }
    , pair_out = .(v: Value) -> (Value & Value) | Diag { surf_pair_out(v) }
    , left_in = .(v: Value) -> Value { vleft(v) }
    , right_in = .(v: Value) -> Value { vright(v) }
    , sum_is_left = .(v: Value) -> Bool | Diag { surf_sum_is_left(v) }
    , sum_payload = .(v: Value) -> Value | Diag { surf_sum_payload(v) }
    , hostfn_in = .(descriptor: Host_fn) -> Value | Diag {
        adapter_hostfn_value(adapter, descriptor)
      }
    , exports = image_exports(im)
    }
}

// =====================================================================
// instantiate — bind the chain once and pack behind the existential
// =====================================================================
//
// `instantiate` first checks the image's retained exact host requirements
// against the advertised adapter. It then takes the **host capabilities** the
// guest's host effects dispatch through — `call` (op dispatch), `make_lit`
// (literal construction), and `test_bool` (the conditional decision) — binds
// every top-level value once against them, and packs the surface record behind
// `Loaded`, hiding `Value` as the existential witness `P`. The evaluator
// hardcodes no host vocabulary, so the host chooses the capabilities: the
// standard ones are `hostrec.kio`'s `serve_default` / `make_lit_default` /
// `test_bool_default` (via `defaults.kio`); a host with a different
// vocabulary threads its own. A top-level binding whose evaluation goes
// stuck fails the instantiation with a `Diag` naming it.
fn un_env_or_diag(r: Env | Diag) -> Env | Diag { r }

/// Instantiates a loaded image against the host capabilities: binds every
/// top-level value once and packs the export surface behind the existential
/// interface, or reports an adapter mismatch or the binding that got stuck.
pub fn instantiate(
  , adapter: Host_adapter
  , call: (Host_fn & Value) -> Call_result
  , make_lit: (String & Host_type) -> Value
  , test_bool: (Host_type & Scalar) -> Side
  , im: Image
  ) -> Loaded | Diag {
  let requirements = image_host_requirements(im);
  match! adapter_preflight(
    , adapter
    , host_contract_types(requirements)
    , host_contract_functions(requirements)
    ) {
    (
      , .(preflight_diag: Diag) { widen_sum!(preflight_diag, Loaded | Diag) }
      , .(_preflight_ok: .) {
          match! un_env_or_diag(eval_chain(call, make_lit, test_bool, im)) {
            (
              , .(env: Env) {
                  widen_sum!(
                    , Loaded.mk(value_surface(adapter, call, make_lit, test_bool, im, env))
                    , Loaded | Diag
                    )
                }
              , .(d: Diag) { widen_sum!(d, Loaded | Diag) }
              )
          }
        }
      )
  }
}

// =====================================================================
// Contract-match — verify the image inhabits the host's interface
// =====================================================================
//
// Before instantiating, a host states the contract it expects: each function
// export as `path/to/mod.item` or a unique bare `item`, and each member export
// as `path/to/mod.Type.member` or a unique bare `Type.member`, with the exact
// canonical signature returned by `image_exports`. The canonical table
// resolves aliases and import spellings
// to module-qualified host (`h{module.Type}`) and nominal
// (`n{module.Type}`) identities, while numbering type binders positionally.
// Contract-match compares that validated table directly, so the same
// declaration reached through different source spellings has one identity
// and declarations with the same leaf name remain distinct. Export identity is
// module-qualified per `specs/versioning.md`; no `.sig.kio` is consulted —
// the contract types come from the image's own declared signatures, and
// the bodies stay trusted exactly as a compiled artifact's are.
/// Defines one expected export entry: its (possibly qualified) name and
/// the canonical signature text the host expects.
pub labels { expect: String & String };

/// Builds an expected-export entry, e.g.
/// `mk_expect("pid/controller.step", "(n{pid.State} & h{host.F64}) -> n{pid.State}")`.
pub fn mk_expect(name: String, sig: String) -> Expect { {expect = (name, sig)} }

/// One-step destructor on an expected-export entry.
pub fn un_expect(e: Expect) -> String & String { Expect.get(e) }

/// A host contract: a cons-list of the exported entries the host expects.
pub labels { contract: List(Expect) };

/// The empty contract.
pub fn contract_nil() -> Contract { {contract = nil(Expect, ())} }

/// Prepends one expected entry to a contract.
pub fn contract_cons(head: Expect, tail: Contract) -> Contract {
  {contract = cons(head, Contract.get(tail))}
}

/// One-step destructor on a contract.
pub fn un_contract(c: Contract) -> . | (Expect & Contract) {
  match! uncons(Contract.get(c)) {
    (
      , .(h: Expect, t: List(Expect)) { widen_sum!((h, {contract = t}), . | (Expect & Contract)) }
      , .(_e: .) { widen_sum!((), . | (Expect & Contract)) }
      )
  }
}

fn export_signature_find(exports: Export_infos, qualified_name: String) -> . | String {
  loop(
    , .(remaining: Export_infos) {
        match! un_export_infos(remaining) {
          (
            , .(entry: Export_info, rest: Export_infos) {
                if! string_eq(export_info_name(entry), qualified_name) {
                  widen_sum!(
                    , widen_sum!(export_info_sig(entry), . | String)
                    , Export_infos | . | String
                    )
                } else {
                  widen_sum!(rest, Export_infos | . | String)
                }
              }
            , .(_empty: .) { widen_sum!(widen_sum!((), . | String), Export_infos | . | String) }
            )
        }
      }
    , exports
    )
}

fn missing_canonical_export_diag(qualified_name: String) -> Diag {
  mk_diag(string_concat(
    , "dyn_load_prime: malformed image — canonical signature is absent for "
      "export `"(String)
    , string_concat(qualified_name, "`"(String))
    ))
}

fn check_canonical_signature(im: Image, qualified_name: String, want: String) -> . | Diag {
  match! export_signature_find(image_exports(im), qualified_name) {
    (
      , .(got: String) {
          if! string_eq(want, got) {
            widen_sum!((), . | Diag)
          } else {
            widen_sum!(
              , mk_diag(string_concat(
                  , "dyn_load_prime: contract mismatch — export `"(String)
                  , string_concat(
                      , qualified_name
                      , string_concat(
                          , "` declares `"(String)
                          , string_concat(
                              , got
                              , string_concat(
                                  , "` but the host expects `"(String)
                                  , string_concat(want, "`"(String))
                                  )
                              )
                          )
                      )
                  ))
              , . | Diag
              )
          }
        }
      , .(_missing: .) { widen_sum!(missing_canonical_export_diag(qualified_name), . | Diag) }
      )
  }
}

// Check one expected entry against the image's surface: present (uniquely,
// when named bare), and signature-matched. Returns `()` on a match, or a
// diagnostic.
fn check_one(im: Image, e: Expect) -> . | Diag {
  match! un_expect(e) {
    .(name: String, signature: String) {
      match! un_export_find(find_export(im, name)) {
        (
          , .(hit: Ef_found) {
              match! Ef_found.get(hit) {
                .(_pos: I32, g: Gdecl) {
                  check_canonical_signature(im, gdecl_qualified(g), signature)
                }
              }
            }
          , .(_absent: Ef_absent) { widen_sum!(absent_export_diag(name), . | Diag) }
          , .(ambiguous: Ef_ambiguous) {
              widen_sum!(ambiguous_export_diag(name, Ef_ambiguous.get(ambiguous)), . | Diag)
            }
          , .(member: Ef_member) {
              match! Ef_member.get(member) {
                .(o: Omember, is_proj: Bool) {
                  check_canonical_signature(im, omember_qualified(o, is_proj), signature)
                }
              }
            }
          )
      }
    }
  }
}

fn un_maybe_diag(m: . | Diag) -> . | Diag { m }

// The loop state walks the remaining contract; the result is `. | Diag`
// (the first mismatch wins, else `()`).
type Cm_state = Contract;

type Cm_step = Cm_state | . | Diag;

fn contract_step(im: Image, st: Cm_state) -> Cm_step {
  match! un_contract(st) {
    (
      , .(e: Expect, rest: Contract) {
          match! un_maybe_diag(check_one(im, e)) {
            (
              , .(d: Diag) { widen_sum!(widen_sum!(d, . | Diag), Cm_state | . | Diag) }
              , .(_ok: .) { widen_sum!(rest, Cm_state | . | Diag) }
              )
          }
        }
      , .(_done: .) { widen_sum!(widen_sum!((), . | Diag), Cm_state | . | Diag) }
      )
  }
}

/// Contract-matches the host's expected interface against the image's
/// declared surface: `()` when the image inhabits the contract, or the
/// first mismatch as a `Diag`.
pub fn contract_check(im: Image, c: Contract) -> . | Diag {
  loop(.(st: Cm_state) { contract_step(im, st) }, c)
}

/// Contract-matches, then preflights and instantiates against the adapter and
/// host capabilities, or returns the first mismatch as a `Diag`. The runtime
/// twin of a compiled artifact's package factory, gated on both contracts.
pub fn instantiate_checked(
  , adapter: Host_adapter
  , call: (Host_fn & Value) -> Call_result
  , make_lit: (String & Host_type) -> Value
  , test_bool: (Host_type & Scalar) -> Side
  , im: Image
  , c: Contract
  ) -> Loaded | Diag {
  match! un_maybe_diag(contract_check(im, c)) {
    (
      , .(d: Diag) { widen_sum!(d, Loaded | Diag) }
      , .(_ok: .) { instantiate(adapter, call, make_lit, test_bool, im) }
      )
  }
}
