module loader/scan;

import chars(c_colon, c_comma, c_eq, c_gt, c_lbrace, c_lbrack, c_lparen, c_lt, c_rbrace, c_rbrack);
import chars(c_rparen, c_semi, c_slash, c_star, c_under, is_digit, is_lower, is_upper);
import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
