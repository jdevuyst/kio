/// The Kio' term parser: a token list → the erased de Bruijn `Term`, name-resolved against a binder scope.
module parse;

import chars(c_amp, c_bang, c_bar, c_colon, c_comma, c_dot, c_eq, c_gt, c_lbrace);
import chars(c_lbrack, c_lparen, c_minus, c_rbrace, c_rbrack, c_rparen, c_semi, c_slash, c_under);
import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import host_descriptor(Host_type);
import lex(Lex_err, lex, lex_err_message, lex_err_pos);
import list/core(List, cons, nil, uncons);
import list/list(elem, length, null, reverse);
import prime(Nat, Term, Terms);
import prime(absurd, app, either, fst);
import prime(ite, lam, left, let_, lit, ns, nz, pair);
import prime(right, snd, tcons, tnil, un_terms, unit, var, {terms});
import testapi(Bool, I32, String);
import testapi/arith(add_i32, eq_i32, leq_i32, sub_i32);
import testapi/fmt(int_to_string);
import testapi/iter(loop);
import testapi/text(string_code_at, string_concat, string_eq);
import token(Tk_num, Tk_punct, Tk_str, Tk_word, Token, Token_shape, Toks);
import token(toks_cons, toks_nil, un_token, un_toks, {tk_num}, {tk_punct}, {tk_str}, {tk_word});

// `parse.kio` — read the Kio' term grammar (as the existing Prime emit
// writes it) into the erased de Bruijn `Term` that `prime_eval` consumes.
// The parser is the **inverse of the Prime pretty-printer**: the emitter
// writes a `Term` as Kio' text; this reads that text back.
//
// **What it parses.** A single Kio' *term expression* — the right-hand
// side of a `fn` body or a lambda body. The `Term` AST is the *erased*
// core (`prime.kio`): type identities and annotations erase, while each unary
// `forall` binder/application survives structurally as an ordinary Unit
// lambda/application stage. The parser materializes those stages, drops the
// remaining annotations, and resolves names to de Bruijn indices. Exact
// host-type descriptors remain where literals and conditionals need them at
// the host boundary.
//
// **Recursion-free, like the evaluator.** Kio' has no in-language
// recursion (`specs/prime.md` § Order-sensitive visibility), so parsing
// a tree of arbitrary depth is *iteration*, driven by the host `loop` —
// a CEK-style abstract machine, the same shape `eval.kio` uses. The
// control is "parse this token-run in this scope" or "yield this term";
// the continuation is an explicit frame stack; each frame carries the
// binder scope it needs, so de Bruijn resolution falls out of the frame
// structure without a separate resolution pass.
//
// **The emitted surface this inverts** (studied from real `kio build`
// `kio-prime` output):
//
//   - literals carry their host type: `5(I32)`, `"hi"(String)`,
//     `.t(Bool)` / `.f(Bool)`; the unit value is `()`.
//   - a variable is a bare identifier; a lambda is `.(x: T) { body }`
//     (one value param) or the zero-param thunk `.() { body }`.
//   - application is postfix and repeatable: `f(a)(b)` is
//     `app(app(f, a), b)`; a zero-arg call `t()` applies to the unit
//     value.
//   - the eight intrinsics carry **explicit positional type-args first**,
//     then value-args: `__pair__(A, B, a, b)`, `__fst__(A, B, p)`,
//     `__snd__(A, B, p)`, `__left__(A, B, x)`, `__right__(A, B, x)`,
//     `__either__(A, B, C, s, f, g)`,
//     `__if_then_else__(A, c, .() { t }, .() { e })`, `__absurd__(A, x)`.
//   - a host-item call uses the same staged syntax as any other value;
//     polymorphic host items carry leading type arguments whose erased,
//     evaluator-internal encoding uses Unit applications before their
//     value-domain packet. That encoding does not consume a residual
//     `. -> ...` source layer.
//
// `__either__` handlers and `__if_then_else__` thunks are ordinary function
// values. The parser therefore retains both kinds as lambdas. `eval.kio`
// evaluates all three intrinsic value arguments left-to-right, then applies
// only the selected handler (to the payload) or thunk (to Unit).
//
// **The free-name boundary.** A bare identifier that is not a local binder
// resolves against the supplied *initial scope*. Loader scopes contain
// permitted host functions plus one positional frame per preceding guest
// function, with only the spellings visible from the current owner. The
// parser itself only ever resolves against the scope it is given.

// =====================================================================
// Pnl — a name list (dot-lambda parameters, and a scope frame's spellings)
// =====================================================================
//
// A plain cons-list of names. Dot-lambda parameter lists use it in
// declaration order; a binder-scope frame uses it as the set of reference
// spellings that resolve to that frame (see § Scope below).
/// A cons-list of names.
pub labels { pnl: List(String) };

/// The empty name list.
pub fn pnl_nil() -> Pnl { {pnl = nil(String, ())} }

/// Prepends one name.
pub fn pnl_cons(name: String, rest: Pnl) -> Pnl { {pnl = cons(name, Pnl.get(rest))} }

/// One-step destructor on a name list.
pub fn un_pnl(p: Pnl) -> . | (String & Pnl) {
  match! uncons(Pnl.get(p)) {
    (
      , .(h: String, t: List(String)) { widen_sum!((h, {pnl = t}), . | (String & Pnl)) }
      , .(_e: .) { widen_sum!((), . | (String & Pnl)) }
      )
  }
}

/// A one-name list.
pub fn pnl_one(name: String) -> Pnl { pnl_cons(name, pnl_nil()) }

// Whether the list contains `name`.
fn pnl_has(p: Pnl, name: String) -> Bool {
  elem(.(a: String, b: String) { string_eq(a, b) }, name, Pnl.get(p))
}

// =====================================================================
// Scope — the binder environment, innermost binder first
// =====================================================================
//
// Resolving a variable name to a de Bruijn index is a walk down the
// scope counting frames until a frame's spellings contain the name. The
// scope is a cons-list of frames; index 0 is the head (nearest binder).
//
// **A frame carries a spelling list, not one name.** An ordinary binder
// (a lambda / let / value param) has exactly one spelling. A top-level fn
// the loader seeds can be referenced under several: its bare name where a
// module imports it selectively (`import m(f);`), and an alias-qualified
// spelling (`a.f`) where a module imports its module qualified
// (`import m as a;`) — both may coexist for one chain position, so the frame
// lists every spelling that resolves to it. A decl not visible to the
// resolving module contributes an empty spelling list, which no
// reference matches, preserving the chain position.
//
/// A binder scope: a cons-list of in-scope spelling frames, innermost first.
pub rec labels { scope: . | (Pnl & Scope) };

/// The empty scope.
pub fn scope_nil() -> Scope { {scope = widen_sum!((), . | (Pnl & Scope))} }

/// Extends the scope with one frame carrying explicit spellings at index 0.
pub fn scope_push_names(spellings: Pnl, s: Scope) -> Scope {
  {scope = widen_sum!((spellings, s), . | (Pnl & Scope))}
}

/// Extends the scope with one binder name at index 0.
pub fn scope_push(name: String, s: Scope) -> Scope { scope_push_names(pnl_one(name), s) }

/// One-step destructor on a scope.
pub fn un_scope(s: Scope) -> . | (Pnl & Scope) { Scope.get(s) }

// `scope_index` walks the scope for `name`, accumulating the de Bruijn
// depth, and returns the matching index or `()` when the name is unbound.
// The loop state is `(Scope & Nat)`: the remaining scope and the depth so
// far.
/// Resolves `name` to its de Bruijn index in `s`, or `()` when unbound.
pub fn scope_index(name: String, s: Scope) -> . | Nat {
  loop(
    , .(st: Scope & Nat) {
        match! st {
          .(rest: Scope, depth: Nat) {
            match! un_scope(rest) {
              (
                , .(spellings: Pnl, tail: Scope) {
                    if! pnl_has(spellings, name) {
                      widen_sum!(widen_sum!(depth, . | Nat), (Scope & Nat) | . | Nat)
                    } else {
                      widen_sum!((tail, ns(depth)), (Scope & Nat) | . | Nat)
                    }
                  }
                , .(_empty: .) { widen_sum!(widen_sum!((), . | Nat), (Scope & Nat) | . | Nat) }
                )
            }
          }
        }
      }
    , (s, nz())
    )
}

// =====================================================================
// Ntab — the resolving module's visible declaration table
// =====================================================================
//
// A loaded package declares `newtype`s — the surface's `labels` sums and
// products lower to ordinary `newtype`s, so every sum / product crosses a
// nominal boundary with a user-named constructor / projector reached by
// dotted path (`Box.mk(...)`, `Color.get(...)`; `specs/prime.md` § The
// `newtype` primitive). Under the erased runtime a non-existential
// wrap / unwrap is the **identity** on the payload value. The parser recognizes
// `X.member`, checks the selected member's visibility, and constructs the
// corresponding erased member value with its declared universal and
// existential type-function stages intact. Ordinary structural postfix parsing
// then applies whatever type and value arguments are written at the use site;
// `Ntab` describes the member value, not call-site argument selection.
//
// `Ntab` maps the visible spelling of each newtype to its erasure facts plus
// independent constructor and projector visibility gates. The table is
// constant while one declaration body is parsed, so it rides the machine
// state read-only rather than living in every frame. The loader builds it for
// that declaration's module from the scanner's package-wide newtype facts.
//
// A newtype name and a value binder live in **separate namespaces** — a
// fn parameter `box` and a newtype `Box` never collide on case, and the
// erasure only fires when `X` is followed by `.member`. So `Ntab` is a
// table distinct from `Scope`: a name in `Ntab` is not a runtime value
// and must never resolve to a de Bruijn index.
//
// Each entry records what the erasure needs: the universal type-arity,
// how many existential binders the projector exposes (an existential projector erases to the
// CPS wrap, not the identity — `specs/prime.md` § Existential
// introduction and elimination), and the declared constructor / projector
// member names (the emitted call is `X.<member>(…)` with the names the
// declaration chose; `specs/grammar.md` § Productions (Kio'),
// `NewtypeMember`).
/// Defines one newtype's erasure-relevant facts: universal and existential
/// type arities, constructor name, projector name.
pub labels { nt_info: I32 & I32 & String & String };

/// Builds a newtype-table entry payload.
pub fn mk_nt_info(arity: I32, existential_arity: I32, ctor: String, proj: String) -> Nt_info {
  {nt_info = (arity, (existential_arity, (ctor, proj)))}
}

/// The entry's universal type-arity.
pub fn nt_arity(i: Nt_info) -> I32 {
  match! Nt_info.get(i) {
    .(a: I32, _r: I32 & String & String) { a }
  }
}

/// The number of existential binders exposed to the projector handler.
fn nt_existential_arity(i: Nt_info) -> I32 {
  match! Nt_info.get(i) {
    .(_a: I32, r: I32 & String & String) {
      match! r {
        .(e: I32, _m: String & String) { e }
      }
    }
  }
}

/// Whether the newtype declares existential binders.
pub fn nt_existential(i: Nt_info) -> Bool {
  if! leq_i32(1(I32), nt_existential_arity(i)) {
    .t(Bool)
  } else {
    .f(Bool)
  }
}

/// The declared constructor member name.
pub fn nt_ctor(i: Nt_info) -> String {
  match! Nt_info.get(i) {
    .(_a: I32, r: I32 & String & String) {
      match! r {
        .(_e: I32, m: String & String) {
          match! m {
            .(c: String, _p: String) { c }
          }
        }
      }
    }
  }
}

/// The declared projector member name.
pub fn nt_proj(i: Nt_info) -> String {
  match! Nt_info.get(i) {
    .(_a: I32, r: I32 & String & String) {
      match! r {
        .(_e: I32, m: String & String) {
          match! m {
            .(_c: String, p: String) { p }
          }
        }
      }
    }
  }
}

/// One parser-visible newtype entry: erasure facts plus independently
/// authorized constructor and projector capabilities.
pub labels { nt_entry: Nt_info & Bool & Bool };

/// Builds one parser-visible newtype entry.
pub fn mk_nt_entry(info: Nt_info, ctor_allowed: Bool, proj_allowed: Bool) -> Nt_entry {
  {nt_entry = (info, ctor_allowed, proj_allowed)}
}

/// The entry's erasure facts.
pub fn nt_entry_info(entry: Nt_entry) -> Nt_info {
  match! Nt_entry.get(entry) {
    .(info: Nt_info, _ctor: Bool, _proj: Bool) { info }
  }
}

/// Whether the constructor may be named from the resolving module.
pub fn nt_entry_ctor_allowed(entry: Nt_entry) -> Bool {
  match! Nt_entry.get(entry) {
    .(_info: Nt_info, allowed: Bool, _proj: Bool) { allowed }
  }
}

/// Whether the projector may be named from the resolving module.
pub fn nt_entry_proj_allowed(entry: Nt_entry) -> Bool {
  match! Nt_entry.get(entry) {
    .(_info: Nt_info, _ctor: Bool, allowed: Bool) { allowed }
  }
}

/// A visibility table: a cons-list of `(spelling, entry)` over the newtypes a
/// module can name.
pub rec labels { ntab: . | (String & Nt_entry & Ntab) };

/// The empty table.
pub fn ntab_nil() -> Ntab { {ntab = widen_sum!((), . | (String & Nt_entry & Ntab))} }

/// Records one entry under a spelling.
pub fn ntab_cons_entry(name: String, e: Nt_entry, t: Ntab) -> Ntab {
  {ntab = widen_sum!((name, (e, t)), . | (String & Nt_entry & Ntab))}
}

/// Records one newtype's name and erasure facts.
pub fn ntab_cons(name: String, info: Nt_info, t: Ntab) -> Ntab {
  ntab_cons_entry(name, mk_nt_entry(info, .t(Bool), .t(Bool)), t)
}

/// Records one newtype with independently authorized member sides.
pub fn ntab_cons_visible(
  , name: String
  , info: Nt_info
  , ctor_allowed: Bool
  , proj_allowed: Bool
  , t: Ntab
  ) -> Ntab { ntab_cons_entry(name, mk_nt_entry(info, ctor_allowed, proj_allowed), t) }

/// One-step destructor on a table.
pub fn un_ntab(t: Ntab) -> . | (String & Nt_entry & Ntab) { Ntab.get(t) }

// Project the tail `Ntab` out of a table cell's `(Nt_entry & Ntab)` payload.
fn snd_ntab(cell: Nt_entry & Ntab) -> Ntab {
  match! cell {
    .(_i: Nt_entry, tail: Ntab) { tail }
  }
}

// Project the entry out of a table cell's `(Nt_entry & Ntab)` payload.
fn fst_ntab_info(cell: Nt_entry & Ntab) -> Nt_entry {
  match! cell {
    .(i: Nt_entry, _tail: Ntab) { i }
  }
}

// `ntab_lookup` walks the table for `name`, returning its entry, or `()`
// when `name` names no visible newtype. The loop state is the remaining
// `Ntab`; it returns `. | Nt_entry`.
/// Resolves a spelling to its table entry, or `()` when it names none.
pub fn ntab_lookup(name: String, t: Ntab) -> . | Nt_entry {
  loop(
    , .(rest: Ntab) {
        match! un_ntab(rest) {
          (
            , .(head: String, tail_cell: Nt_entry & Ntab) {
                if! string_eq(head, name) {
                  widen_sum!(
                    , widen_sum!(fst_ntab_info(tail_cell), . | Nt_entry)
                    , Ntab | . | Nt_entry
                    )
                } else {
                  widen_sum!(snd_ntab(tail_cell), Ntab | . | Nt_entry)
                }
              }
            , .(_empty: .) { widen_sum!(widen_sum!((), . | Nt_entry), Ntab | . | Nt_entry) }
            )
        }
      }
    , t
    )
}

/// Resolves a spelling to a newtype's erasure facts, or `()` when it names
/// no visible newtype.
pub fn ntab_lookup_newtype(name: String, t: Ntab) -> . | Nt_entry { ntab_lookup(name, t) }

// =====================================================================
// Pnl — a dot-lambda's value-parameter names, and the product-domain wrap
// =====================================================================
//
// A dot-lambda `.(p0: T0, p1: T1, …) { body }` binds **one domain value**:
// Kio''s functions are unary over one domain type (`specs/prime.md`
// § Functions are unary over one domain type), so a multi-parameter
// dot-lambda's comma-separated params synthesize one **product** domain
// `T0 & (T1 & …)`, exactly as a top-level `fn`'s param list does, and a
// call `f(a, b, c)` builds the one right-nested product argument. The body
// sees the params as separate binders recovered from the product by
// projection. (`match!`'s product-clause handlers and the emit's sum /
// product destructuring lower to multi-parameter dot-lambdas, so this is
// core emitted grammar.)
//
// `Pnl` is the parser's value-parameter-name list (declaration order). The
// closure layout mirrors the loader's top-level `wrap_fn` (`loader.kio`):
//
//   - **0 params** (`.() { … }`): `lam(body)` over a unit binder.
//   - **1 param** (`.(x: A) { … }`): `lam(body)` binding the sole param.
//   - **N≥2 params**: `lam(let p0 = …; …; body)` binding the product and
//     prefixing one projection-let per param (first param outermost, last
//     param innermost at de Bruijn 0).
// The number of parameters, as a host i32.
fn pnl_len(p: Pnl) -> I32 { length(Pnl.get(p)) }

// Reverse a most-recent-first name list into declaration order.
fn pnl_reverse(p: Pnl) -> Pnl { {pnl = reverse(Pnl.get(p))} }

// Push the params onto `base` in declaration order, so the last param ends
// nearest (de Bruijn 0 of the body).
fn pnl_push_scope(p: Pnl, base: Scope) -> Scope {
  loop(
    , .(st: Pnl & Scope) {
        match! st {
          .(rem: Pnl, acc: Scope) {
            match! un_pnl(rem) {
              (
                , .(name: String, rest: Pnl) {
                    widen_sum!((rest, scope_push(name, acc)), (Pnl & Scope) | Scope)
                  }
                , .(_e: .) { widen_sum!(acc, (Pnl & Scope) | Scope) }
                )
            }
          }
        }
      }
    , (p, base)
    )
}

// The frames one dot-lambda parameter group adds over `base`. A 1-param
// group binds its param directly (no extra frame); every other arity binds
// one domain value (unit for 0, the product for N≥2) and recovers the named
// params above a `<domain>` frame.
fn lambda_group_scope(params: Pnl, base: Scope) -> Scope {
  if! eq_i32(pnl_len(params), 1(I32)) {
    pnl_push_scope(params, base)
  } else {
    pnl_push_scope(params, scope_push("<domain>"(String), base))
  }
}

// =====================================================================
// Pnlg — a dot-lambda's parameter groups
// =====================================================================
//
// A dot-lambda's signature is one or more value-parameter groups
// (`FnSignature ::= FnSignatureGroup+`), each binding one domain value in
// a curried closure chain: `.(x: A)(y: B) { body }` is `λx. λy. body`.
/// A cons-list of dot-lambda parameter groups.
pub labels { pnlg: List(Pnl) };

fn pnlg_nil() -> Pnlg { {pnlg = nil(Pnl, ())} }

fn pnlg_cons(g: Pnl, rest: Pnlg) -> Pnlg { {pnlg = cons(g, Pnlg.get(rest))} }

fn un_pnlg(gs: Pnlg) -> . | (Pnl & Pnlg) {
  match! uncons(Pnlg.get(gs)) {
    (
      , .(h: Pnl, t: List(Pnl)) { widen_sum!((h, {pnlg = t}), . | (Pnl & Pnlg)) }
      , .(_e: .) { widen_sum!((), . | (Pnl & Pnlg)) }
      )
  }
}

fn pnlg_reverse(gs: Pnlg) -> Pnlg { {pnlg = reverse(Pnlg.get(gs))} }

// The body scope for a dot-lambda with parameter groups `groups` over
// `base`: each group's frames stack over the previous group's, first group
// deepest — matching the curried chain `wrap_lambda` builds.
fn lambda_body_scope(groups: Pnlg, base: Scope) -> Scope {
  loop(
    , .(st: Pnlg & Scope) {
        match! st {
          .(rem: Pnlg, acc: Scope) {
            match! un_pnlg(rem) {
              (
                , .(g: Pnl, rest: Pnlg) {
                    widen_sum!((rest, lambda_group_scope(g, acc)), (Pnlg & Scope) | Scope)
                  }
                , .(_e: .) { widen_sum!(acc, (Pnlg & Scope) | Scope) }
                )
            }
          }
        }
      }
    , (groups, base)
    )
}

// A de Bruijn `Nat` from a host i32 (count of successors).
fn pnl_nat_of_i32(n: I32) -> Nat {
  loop(
    , .(st: I32 & Nat) {
        match! st {
          .(k: I32, acc: Nat) {
            if! leq_i32(k, 0(I32)) {
              widen_sum!(acc, (I32 & Nat) | Nat)
            } else {
              widen_sum!((sub_i32(k, 1(I32)), ns(acc)), (I32 & Nat) | Nat)
            }
          }
        }
      }
    , (n, nz())
    )
}

// Apply `snd` `k` times, descending `k` tails into a right-nested product.
fn pnl_snd_n(k: I32, t: Term) -> Term {
  loop(
    , .(st: I32 & Term) {
        match! st {
          .(rem: I32, acc: Term) {
            if! leq_i32(rem, 0(I32)) {
              widen_sum!(acc, (I32 & Term) | Term)
            } else {
              widen_sum!((sub_i32(rem, 1(I32)), snd(acc)), (I32 & Term) | Term)
            }
          }
        }
      }
    , (k, t)
    )
}

// The projection that recovers value parameter `i` (0-based) of an
// `n`-component product bound at de Bruijn index `i`: `fst(snd^i(product))`,
// except the last param (`i == n-1`) is `snd^(n-1)` with no leading `fst`.
fn pnl_param_projection(i: I32, n: I32) -> Term {
  let at_product = pnl_snd_n(i, var(pnl_nat_of_i32(i)));
  if! eq_i32(i, sub_i32(n, 1(I32))) {
    at_product
  } else {
    fst(at_product)
  }
}

// Wrap `inner` in one group's closure: `lam(inner)` for 0 / 1 params, or
// (for N≥2) a lambda binding the product and prefixing one projection-let
// per parameter (first param outermost), matching `lambda_group_scope`.
fn wrap_lambda_group(params: Pnl, inner: Term) -> Term {
  let n = pnl_len(params);
  if! leq_i32(n, 1(I32)) {
    lam(inner)
  } else {
    lam(loop(
      , .(st: I32 & Term) {
          match! st {
            .(i: I32, acc: Term) {
              if! leq_i32(i, 0(I32)) {
                widen_sum!(let_(pnl_param_projection(0(I32), n), acc), (I32 & Term) | Term)
              } else {
                widen_sum!(
                  , (sub_i32(i, 1(I32)), let_(pnl_param_projection(i, n), acc))
                  , (I32 & Term) | Term
                  )
              }
            }
          }
        }
      , (sub_i32(n, 1(I32)), inner)
      ))
  }
}

/// Wraps a dot-lambda body in its curried closure chain: the last group's
/// lambda innermost, the first group's outermost, matching
/// `lambda_body_scope`.
pub fn wrap_lambda(groups: Pnlg, body: Term) -> Term {
  loop(
    , .(st: Pnlg & Term) {
        match! st {
          .(rem: Pnlg, acc: Term) {
            match! un_pnlg(rem) {
              (
                , .(g: Pnl, rest: Pnlg) {
                    widen_sum!((rest, wrap_lambda_group(g, acc)), (Pnlg & Term) | Term)
                  }
                , .(_e: .) { widen_sum!(acc, (Pnlg & Term) | Term) }
                )
            }
          }
        }
      }
    , (pnlg_reverse(groups), body)
    )
}

// =====================================================================
// Token helpers — peek at the head token / classify punctuation
// =====================================================================
/// The head token of a list, or `()` at end-of-input.
fn peek(ts: Toks) -> . | Token {
  match! un_toks(ts) {
    (
      , .(h: Token, _p: I32, _t: Toks) { widen_sum!(h, . | Token) }
      , .(_e: .) { widen_sum!((), . | Token) }
      )
  }
}

/// The head token's source byte offset, or `()` at end-of-input.
fn head_pos(ts: Toks) -> . | I32 {
  match! un_toks(ts) {
    (
      , .(_h: Token, p: I32, _t: Toks) { widen_sum!(p, . | I32) }
      , .(_e: .) { widen_sum!((), . | I32) }
      )
  }
}

/// The tail of a token list (the head dropped), or the empty list at end-of-input.
fn rest(ts: Toks) -> Toks {
  match! un_toks(ts) {
    (.(_h: Token, _p: I32, t: Toks) { t }, .(_e: .) { toks_nil() })
  }
}

/// Whether `t` is the punctuation mark with code `code`.
fn is_punct(t: Token, code: I32) -> Bool {
  match! un_token(t) {
    (
      , .(_w: Tk_word) { .f(Bool) }
      , .(_i: Tk_num) { .f(Bool) }
      , .(_s: Tk_str) { .f(Bool) }
      , .(p: Tk_punct) { eq_i32(Tk_punct.get(p), code) }
      )
  }
}

/// Whether the head of `ts` is the punctuation mark `code`.
fn head_is_punct(ts: Toks, code: I32) -> Bool {
  match! peek(ts) {
    (.(t: Token) { is_punct(t, code) }, .(_e: .) { .f(Bool) })
  }
}

// The head token's word spelling, or `()` when the head is not a word.
fn head_word_str(ts: Toks) -> . | String {
  match! peek(ts) {
    (
      , .(t: Token) {
          match! un_token(t) {
            (
              , .(w: Tk_word) { widen_sum!(Tk_word.get(w), . | String) }
              , .(_i: Tk_num) { widen_sum!((), . | String) }
              , .(_s: Tk_str) { widen_sum!((), . | String) }
              , .(_p: Tk_punct) { widen_sum!((), . | String) }
              )
          }
        }
      , .(_e: .) { widen_sum!((), . | String) }
      )
  }
}

/// Drops a leading comma if the head is one; otherwise leaves `ts` unchanged.
fn drop_comma(ts: Toks) -> Toks {
  if! head_is_punct(ts, c_comma()) {
    rest(ts)
  } else {
    ts
  }
}

// =====================================================================
// Type-argument skip — erase one balanced type token-run
// =====================================================================
//
// Intrinsic call sites carry explicit positional type-args (`__pair__(A,
// B, a, b)`); under erasure these are dropped. A type-arg is a balanced
// token run ending at the first depth-0 `,` or `)` (type expressions
// carry no top-level commas — products use `&`, function types use
// `->`). The skip counts bracket depth and stops at that delimiter
// without consuming it. The emitter's leading-comma multi-line style
// means a type-arg may be preceded by a comma, so a leading comma is
// dropped first.
//
// The loop state is `(Toks & I32)` (remaining tokens, bracket depth);
// the exit is the remaining `Toks`. A nesting opener raises the depth, a
// closer at depth > 0 lowers it; at depth 0 a `,` or `)` ends the run.

// Whether `t` is a depth-0 type-arg delimiter (`,` or `)`).
fn is_delim(t: Token) -> Bool {
  if! is_punct(t, c_comma()) {
    .t(Bool)
  } else {
    is_punct(t, c_rparen())
  }
}

// Whether a punctuation code opens a bracket nesting.
fn is_open_code(code: I32) -> Bool {
  if! eq_i32(code, c_lparen()) {
    .t(Bool)
  } else if! eq_i32(code, 91(I32)) {
    .t(Bool)
  } else {
    eq_i32(code, c_lbrace())
  }
}

// Whether a punctuation code closes a bracket nesting.
fn is_close_code(code: I32) -> Bool {
  if! eq_i32(code, c_rparen()) {
    .t(Bool)
  } else if! eq_i32(code, 93(I32)) {
    .t(Bool)
  } else {
    eq_i32(code, c_rbrace())
  }
}

// The next bracket depth after consuming `t`: an opener `(` `[` `{`
// raises it, a closer `)` `]` `}` lowers it, anything else leaves it.
// Reached only when consuming a token (a depth-0 delimiter is handled
// before this), so a `)` here is always a nesting close.
fn bracket_delta(t: Token, depth: I32) -> I32 {
  match! un_token(t) {
    (
      , .(_w: Tk_word) { depth }
      , .(_i: Tk_num) { depth }
      , .(_s: Tk_str) { depth }
      , .(p: Tk_punct) {
          let code = Tk_punct.get(p);
          if! is_open_code(code) {
            add_i32(depth, 1(I32))
          } else if! is_close_code(code) {
            sub_i32(depth, 1(I32))
          } else {
            depth
          }
        }
      )
  }
}

/// Skips one type-argument (optionally comma-led), returning the tokens after it.
fn skip_type_arg(ts0: Toks) -> Toks {
  let ts = drop_comma(ts0);
  loop(
    , .(st: Toks & I32) {
        match! st {
          .(cur: Toks, depth: I32) {
            match! peek(cur) {
              (
                , .(t: Token) {
                    if! eq_i32(depth, 0(I32)) {
                      if! is_delim(t) {
                        widen_sum!(cur, (Toks & I32) | Toks)
                      } else {
                        widen_sum!((rest(cur), bracket_delta(t, depth)), (Toks & I32) | Toks)
                      }
                    } else {
                      widen_sum!((rest(cur), bracket_delta(t, depth)), (Toks & I32) | Toks)
                    }
                  }
                , .(_e: .) { widen_sum!(cur, (Toks & I32) | Toks) }
                )
            }
          }
        }
      }
    , (ts, 0(I32))
    )
}

// =====================================================================
// Type-arguments at a value application — the type/value discriminator
// =====================================================================
//
// An ordinary polymorphic value carries its type arguments positionally at
// each application site: this is the same for a top-level fn, a local alias,
// a host fn, a newtype member value, or a projected dictionary method such as
// `Functor.fmap(F, inst)(A, B, f, x)`. The parser deliberately has no
// declaration arity at the call site, so it discriminates each written
// argument structurally, applies the leading **type** arguments as erased Unit
// stages, then collects the value arguments. Intrinsics use the same
// structural discriminator but discard their type arguments while building
// their dedicated term node. The discrimination relies on Kio's naming rule:
// a type head is uppercase immediately or immediately after one `_`; a value
// head starts lowercase or `_` but never `_` followed immediately by uppercase
// (`language.md` § Naming conventions).
// An argument's first token decides:
//
//   - a type-shaped word **not** followed by `.` heads a type (`String`,
//     `_String`, `List(A)`, `F(B)`) — skip it;
//   - a type-shaped word **followed by `.`** heads a value (a qualified
//     constructor / projector call `Box.un(…)` or `_Box.un(…)`) — stop;
//   - a `(` followed by `)` is the unit value `()` — stop; a `(` followed
//     by anything else heads a parenthesised type (`A -> B`, `(A & B)`) —
//     skip it (the emitter strips value grouping, so a non-unit `(`-led
//     argument is a type);
//   - a `.` followed by a delimiter or type operator heads the unit type —
//     skip it;
//   - a lowercase word, a literal, a dot-lambda / bool-literal, or any
//     other token heads a value — stop.
//
// Only the **leading** run of type-args is skipped; the first value
// argument ends the skip, so a value application with no type-args
// (`f(a)`, `print(s)`) skips nothing.

// Whether the host character code is an ASCII uppercase letter (`A`–`Z`).
fn is_upper_code(c: I32) -> Bool {
  if! leq_i32(65(I32), c) {
    leq_i32(c, 90(I32))
  } else {
    .f(Bool)
  }
}

// Whether the word has a type-shaped head: `A`–`Z`, or exactly one leading
// `_` followed by `A`–`Z`. This local spelling test is independent of the
// loaded declaration set, preserving open-world argument classification.
fn word_starts_type_name(w: String) -> Bool {
  match! string_code_at(w, 0(I32)) {
    (
      , .(first: I32) {
          if! is_upper_code(first) {
            .t(Bool)
          } else if! eq_i32(first, c_under()) {
            match! string_code_at(w, 1(I32)) {
              (.(second: I32) { is_upper_code(second) }, .(_empty: .) { .f(Bool) })
            }
          } else {
            .f(Bool)
          }
        }
      , .(_empty: .) { .f(Bool) }
      )
  }
}

// Given the tokens just after `.`, whether it is the unit type rather
// than a dot-led value form. Dot-lambdas start with `.(...)` or `.()`;
// bool literals start with `.t` / `.f`; type uses are either bare before
// a delimiter or followed by a type operator (`|`, `&`, or `->`, whose
// first token is `-`).
fn unit_dot_is_type(after: Toks) -> Bool {
  if! head_is_punct(after, c_bar()) {
    .t(Bool)
  } else if! head_is_punct(after, c_amp()) {
    .t(Bool)
  } else if! head_is_punct(after, c_comma()) {
    .t(Bool)
  } else if! head_is_punct(after, c_rparen()) {
    .t(Bool)
  } else {
    head_is_punct(after, c_minus())
  }
}

// Whether a lowercase-headed argument heads a **type**: a module path in
// a type position (`a/b.Name` — expression references never contain `/`),
// or an alias-qualified type head (`a.Name` with no member call after it).
// An alias-qualified newtype member call (`a.Box.mk(…)`) and an
// alias-qualified value path (`a.helper`) head values.
fn lower_head_is_typearg(ts: Toks) -> Bool {
  let after = rest(ts);
  if! head_is_punct(after, c_slash()) {
    .t(Bool)
  } else if! head_is_punct(after, c_dot()) {
    let seg = rest(after);
    match! head_word_str(seg) {
      (
        , .(w2: String) {
            if! word_starts_type_name(w2) {
              if! head_is_punct(rest(seg), c_dot()) {
                .f(Bool)
              } else {
                .t(Bool)
              }
            } else {
              .f(Bool)
            }
          }
        , .(_notword: .) { .f(Bool) }
        )
    }
  } else {
    .f(Bool)
  }
}

// Whether the argument starting at `ts` heads a **type** argument (to be
// skipped at a value application), per the discriminator above.
fn arg_is_typearg(ts: Toks) -> Bool {
  match! peek(ts) {
    (
      , .(t: Token) {
          match! un_token(t) {
            (
              , .(w: Tk_word) {
                  if! word_starts_type_name(Tk_word.get(w)) {
                    // Type-shaped head: a type unless it is a qualified
                    // member call (a value).
                    if! head_is_punct(rest(ts), c_dot()) {
                      .f(Bool)
                    } else {
                      .t(Bool)
                    }
                  } else {
                    lower_head_is_typearg(ts)
                  }
                }
              , .(_i: Tk_num) { .f(Bool) }
              , .(_s: Tk_str) { .f(Bool) }
              , .(p: Tk_punct) {
                  // A `(` heads a parenthesised type, except the unit value `()`.
                  // A `.` heads the unit type when followed by a delimiter or
                  // type operator; dot-lambdas and bool literals remain values.
                  if! eq_i32(Tk_punct.get(p), c_lparen()) {
                    if! head_is_punct(rest(ts), c_rparen()) {
                      .f(Bool)
                    } else {
                      .t(Bool)
                    }
                  } else if! eq_i32(Tk_punct.get(p), c_dot()) {
                    unit_dot_is_type(rest(ts))
                  } else if! eq_i32(Tk_punct.get(p), c_bang()) {
                    .t(Bool)
                  } else if! eq_i32(Tk_punct.get(p), c_lbrack()) {
                    .t(Bool)
                  } else {
                    .f(Bool)
                  }
                }
              )
          }
        }
      , .(_e: .) { .f(Bool) }
      )
  }
}

// Skip the leading type-args at a value application (the `(` already
// consumed), stopping at the first value argument. The emitter's
// leading-comma style means a type-arg may be comma-led; `skip_type_arg`
// drops a leading comma.
/// Wraps the value-application type-arg skip's exit (the tokens at the first value-arg).
labels { vta_done: Toks };

fn skip_value_typeargs(ts: Toks) -> Toks {
  Vta_done.get(loop(
    , .(cur: Toks) {
        let cur1 = drop_comma(cur);
        if! arg_is_typearg(cur1) {
          widen_sum!(skip_type_arg(cur1), Toks | Vta_done)
        } else {
          widen_sum!({vta_done = cur}, Toks | Vta_done)
        }
      }
    , ts
    ))
}

/// Wraps a structurally consumed type-application run's `(term, tokens)`.
labels { type_apps_done: Term & Toks };

// Apply every written leading type argument to an ordinary runtime value as
// one evaluator-internal Unit application per unary `forall`. This represents
// only type application: it does not consume a following `. -> ...` value
// layer when the written packet ends after its type arguments. No callee name,
// declaration signature, or provenance participates. The cursor stops at the
// first value argument (or the closing `)`).
fn apply_value_typeargs(value: Term, ts: Toks) -> Term & Toks {
  match! Type_apps_done.get(loop(
    , .(st: Term & Toks) {
        match! st {
          .(current: Term, remaining0: Toks) {
            let remaining = drop_comma(remaining0);
            if! arg_is_typearg(remaining) {
              widen_sum!(
                , (app(current, unit()), skip_type_arg(remaining))
                , (Term & Toks) | Type_apps_done
                )
            } else {
              widen_sum!({type_apps_done = (current, remaining0)}, (Term & Toks) | Type_apps_done)
            }
          }
        }
      }
    , (value, ts)
    )) {
    .(applied: Term, after: Toks) { (applied, after) }
  }
}

// =====================================================================
// Tg — what a finished argument-list builds
// =====================================================================
//
// An argument-list collects value-arg terms up to the closing `)`; `Tg`
// names what node those terms form. `Tg_app` carries the already-built
// callee value and applies it to the collected args (left-associated;
// zero args means apply to the unit value, the `t()` zero-arg call). A host
// fn is just a seeded variable, so a host call is an ordinary `Tg_app` — no
// dedicated host-call target. The eight intrinsic tags build the matching
// `Term` node from the collected args.
/// Defines the apply-to-value target (the callee already in hand).
pub labels { tg_app: Term };

/// Defines the pair-construction target.
pub labels { tg_pair: . };

/// Defines the first-projection target.
pub labels { tg_fst: . };

/// Defines the second-projection target.
pub labels { tg_snd: . };

/// Defines the left-injection target.
pub labels { tg_left: . };

/// Defines the right-injection target.
pub labels { tg_right: . };

/// Defines the sum-elimination target.
pub labels { tg_either: . };

/// Defines the branching target.
pub labels { tg_ite: . };

/// Defines the bottom-elimination target.
pub labels { tg_absurd: . };

/// What a finished argument-list builds.
pub labels { tg: | Tg_app
| Tg_pair
| Tg_fst
| Tg_snd
| Tg_left
| Tg_right
| Tg_either
| Tg_ite
| Tg_absurd };

/// The bare target sum inside a `Tg` — the widen target for target constructors.
pub type Tg_shape =
  Tg_app | Tg_pair | Tg_fst | Tg_snd | Tg_left | Tg_right | Tg_either | Tg_ite | Tg_absurd
  ;

/// One-step destructor on a `Tg`.
pub fn un_tg(t: Tg) -> Tg_shape { Tg.get(t) }

fn tg_app(callee: Term) -> Tg { {tg = widen_sum!({tg_app = callee}, Tg_shape)} }

fn tg_pair() -> Tg { {tg = widen_sum!({tg_pair=}, Tg_shape)} }

fn tg_fst() -> Tg { {tg = widen_sum!({tg_fst=}, Tg_shape)} }

fn tg_snd() -> Tg { {tg = widen_sum!({tg_snd=}, Tg_shape)} }

fn tg_left() -> Tg { {tg = widen_sum!({tg_left=}, Tg_shape)} }

fn tg_right() -> Tg { {tg = widen_sum!({tg_right=}, Tg_shape)} }

fn tg_either() -> Tg { {tg = widen_sum!({tg_either=}, Tg_shape)} }

fn tg_ite() -> Tg { {tg = widen_sum!({tg_ite=}, Tg_shape)} }

fn tg_absurd() -> Tg { {tg = widen_sum!({tg_absurd=}, Tg_shape)} }

// Apply a value to `count` erased type-stage Unit arguments.
fn apply_unit_stages(value: Term, count: I32) -> Term {
  loop(
    , .(state: I32 & Term) {
        match! state {
          .(remaining: I32, current: Term) {
            if! leq_i32(remaining, 0(I32)) {
              widen_sum!(current, (I32 & Term) | Term)
            } else {
              widen_sum!((sub_i32(remaining, 1(I32)), app(current, unit())), (I32 & Term) | Term)
            }
          }
        }
      }
    , (count, value)
    )
}

// Wrap a runtime value in one Unit closure per unary type binder.
fn wrap_type_stages(count: I32, value: Term) -> Term {
  loop(
    , .(state: I32 & Term) {
        match! state {
          .(remaining: I32, current: Term) {
            if! leq_i32(remaining, 0(I32)) {
              widen_sum!(current, (I32 & Term) | Term)
            } else {
              widen_sum!((sub_i32(remaining, 1(I32)), lam(current)), (I32 & Term) | Term)
            }
          }
        }
      }
    , (count, value)
    )
}

// The CPS wrapper an existential projector reduces to. Its runtime shape is
// `λpayload. λ(type R). λhandler. handler(type U...) payload`: the hidden
// Unit binders/applications retain each explicit `forall` stage while the
// erased payload still crosses the newtype boundary unchanged.
fn cps_wrapper(existential_arity: I32) -> Term {
  lam(lam(lam(app(apply_unit_stages(var(nz()), existential_arity), var(ns(ns(nz())))))))
}

// The erased form of a constructor / projector used as a value (a
// type-only application `N.mk(T)`): the identity closure.
fn identity_wrapper() -> Term { lam(var(nz())) }

// The exact value-argument count a target consumes, or `()` for an
// application (which takes any count — zero args is the unit call `t()`).
fn tg_expected_args(t: Tg) -> . | I32 {
  match! un_tg(t) {
    (
      , .(_a: Tg_app) { widen_sum!((), . | I32) }
      , .(_p: Tg_pair) { widen_sum!(2(I32), . | I32) }
      , .(_f: Tg_fst) { widen_sum!(1(I32), . | I32) }
      , .(_s: Tg_snd) { widen_sum!(1(I32), . | I32) }
      , .(_l: Tg_left) { widen_sum!(1(I32), . | I32) }
      , .(_r: Tg_right) { widen_sum!(1(I32), . | I32) }
      , .(_e: Tg_either) { widen_sum!(3(I32), . | I32) }
      , .(_i: Tg_ite) { widen_sum!(3(I32), . | I32) }
      , .(_x: Tg_absurd) { widen_sum!(1(I32), . | I32) }
      )
  }
}

// The target's name for a diagnostic.
fn tg_describe(t: Tg) -> String {
  match! un_tg(t) {
    (
      , .(_a: Tg_app) { "an application"(String) }
      , .(_p: Tg_pair) { "`__pair__`"(String) }
      , .(_f: Tg_fst) { "`__fst__`"(String) }
      , .(_s: Tg_snd) { "`__snd__`"(String) }
      , .(_l: Tg_left) { "`__left__`"(String) }
      , .(_r: Tg_right) { "`__right__`"(String) }
      , .(_e: Tg_either) { "`__either__`"(String) }
      , .(_i: Tg_ite) { "`__if_then_else__`"(String) }
      , .(_x: Tg_absurd) { "`__absurd__`"(String) }
      )
  }
}

// The length of a term list, as a host i32.
fn terms_len(ts: Terms) -> I32 { length(Terms.get(ts)) }

// Check a finished argument list's count against the target's expected
// count: `()` on a match (or for an application), else the mismatch
// message. A missing or surplus intrinsic argument is a malformed image,
// diagnosed rather than silently defaulted.
fn args_count_mismatch(tg: Tg, got: I32) -> . | String {
  match! tg_expected_args(tg) {
    (
      , .(want: I32) {
          if! eq_i32(want, got) {
            widen_sum!((), . | String)
          } else {
            widen_sum!(
              , string_concat(
                  , "wrong number of value arguments to "(String)
                  , string_concat(
                      , tg_describe(tg)
                      , string_concat(
                          , " — expected "(String)
                          , string_concat(
                              , int_to_string(want)
                              , string_concat(", got "(String), int_to_string(got))
                              )
                          )
                      )
                  )
              , . | String
              )
          }
        }
      , .(_any: .) { widen_sum!((), . | String) }
      )
  }
}

fn un_maybe_msg(m: . | String) -> . | String { m }

// =====================================================================
// Head classification — intrinsic / variable
// =====================================================================
//
// When an identifier heads a call, it is one of: an intrinsic (a reserved
// `__name__`, with a node tag to build), or an
// ordinary **variable** — a local binder, a seeded top-level fn, or a **host
// fn** (seeded into the scope as a `V_hostfn` value at load time; `loader.kio`
// § Hostfns). All three are variables whose following `(args)` is an
// application, handled by the postfix machinery; a host fn is not special at
// the call site — it resolves by name like any value. A name that is neither
// an intrinsic nor in scope is unbound (a malformed image), surfaced as a
// parse error by the variable resolution, not classified as a host call.
/// Defines the call-head classification: an intrinsic call with its target.
pub labels { hc_call: Tg };

/// Defines the variable classification (the head is an ordinary variable reference).
pub labels { hc_var: . };

/// A call head is a node-building call or an ordinary variable.
pub type Headclass = Hc_call | Hc_var;

fn hc_call(t: Tg) -> Headclass { widen_sum!({hc_call = t}, Hc_call | Hc_var) }

fn hc_var() -> Headclass { widen_sum!({hc_var=}, Hc_call | Hc_var) }

fn classify_intrinsic2(w: String) -> . | Headclass {
  if! string_eq(w, "__right__"(String)) {
    widen_sum!(hc_call(tg_right()), . | Headclass)
  } else if! string_eq(w, "__either__"(String)) {
    widen_sum!(hc_call(tg_either()), . | Headclass)
  } else if! string_eq(w, "__if_then_else__"(String)) {
    widen_sum!(hc_call(tg_ite()), . | Headclass)
  } else if! string_eq(w, "__absurd__"(String)) {
    widen_sum!(hc_call(tg_absurd()), . | Headclass)
  } else {
    widen_sum!((), . | Headclass)
  }
}

// Classify an intrinsic name (a `__name__`) to its target,
// or `()` when the name is not an intrinsic.
fn classify_intrinsic(w: String) -> . | Headclass {
  if! string_eq(w, "__pair__"(String)) {
    widen_sum!(hc_call(tg_pair()), . | Headclass)
  } else if! string_eq(w, "__fst__"(String)) {
    widen_sum!(hc_call(tg_fst()), . | Headclass)
  } else if! string_eq(w, "__snd__"(String)) {
    widen_sum!(hc_call(tg_snd()), . | Headclass)
  } else if! string_eq(w, "__left__"(String)) {
    widen_sum!(hc_call(tg_left()), . | Headclass)
  } else {
    classify_intrinsic2(w)
  }
}

// Classify a call-head word against the current scope: an intrinsic, or an
// ordinary variable. A non-intrinsic word is always a variable — a local
// binder, a seeded top-level fn, or a seeded host fn — and is resolved to its
// de Bruijn index by the variable machinery (an unbound word surfaces there
// as a parse error). A name that shadows a host fn as a local binder simply
// resolves to the nearer binder, since both are scope entries.
fn classify_head(w: String, sc: Scope) -> Headclass {
  match! classify_intrinsic(w) {
    (.(hc: Headclass) { hc }, .(_none: .) { hc_var() })
  }
}

// =====================================================================
// Collected-argument list and node building
// =====================================================================
//
// Value-args are collected most-recent-first (`tcons` onto the front),
// then reversed into call order before the node is built. `terms_reverse`
// performs that one reversal; the per-arm node builders read positional
// args (`arg0` / `arg1` / `arg2`) off the in-order list. A missing
// positional arg falls back to the unit value — a well-formed image never
// triggers it, but keeping the accessors total avoids an `Eval_result`
// dependency here (the parser is upstream of evaluation).
/// Reverses a term list (most-recent-first into call order).
fn terms_reverse(ts: Terms) -> Terms { {terms = reverse(Terms.get(ts))} }

/// The first term of a list, or the unit term when empty.
fn arg0(ts: Terms) -> Term {
  match! un_terms(ts) {
    (.(h: Term, _t: Terms) { h }, .(_e: .) { unit() })
  }
}

/// The second term of a list, or the unit term when shorter.
fn arg1(ts: Terms) -> Term {
  match! un_terms(ts) {
    (.(_h: Term, t: Terms) { arg0(t) }, .(_e: .) { unit() })
  }
}

/// The third term of a list, or the unit term when shorter.
fn arg2(ts: Terms) -> Term {
  match! un_terms(ts) {
    (.(_h: Term, t: Terms) { arg1(t) }, .(_e: .) { unit() })
  }
}

// Fold the in-order value-args of one call bracket into the single domain
// value the callee is applied to. Kio''s functions are unary over one
// domain type (`specs/prime.md` § Functions are unary over one domain
// type): a declaration's comma-separated value parameters synthesize one
// **product** domain (`fn f(a, b, c)` has domain `A & (B & C)`), and a call
// `f(a, b, c)` builds that one right-nested product argument
// (`specs/language.md` § Type parameters: `(a, b, c)` is
// `__pair__(a, __pair__(b, c))`). So a finished argument list folds to:
//   - 0 args  → the unit value `()` (a `. -> R` function's unit domain;
//               `f()` and `f(())` both pass `()`),
//   - 1 arg   → the argument itself (no product wrapper),
//   - ≥2 args → the right-nested product `pair(a0, pair(a1, …))`.
// Higher-order currying (a function returning a function) is written with
// *separate* call brackets — `f(a)(b)` is two one-argument applications —
// so the per-bracket product fold here never collapses a curried chain.
fn product_of_args(args: Terms) -> Term {
  // Reverse to most-significant-last → `[an, …, a1, a0]`; seed the fold with
  // `an` (the deepest `snd`) and fold `pair(head, acc)` over the rest, so
  // `a0` lands as the outermost `fst` — exactly the right-nested product.
  let rev = terms_reverse(args);
  match! un_terms(rev) {
    (
      , .(deepest: Term, rest0: Terms) {
          loop(
            , .(st: Term & Terms) {
                match! st {
                  .(acc: Term, remaining: Terms) {
                    match! un_terms(remaining) {
                      (
                        , .(head: Term, rest_t: Terms) {
                            widen_sum!((pair(head, acc), rest_t), (Term & Terms) | Term)
                          }
                        , .(_e: .) { widen_sum!(acc, (Term & Terms) | Term) }
                        )
                    }
                  }
                }
              }
            , (deepest, rest0)
            )
        }
      , .(_e: .) { unit() }
      )
  }
}

// Apply `callee` to the single domain value its argument list folds to.
fn build_app(callee: Term, args: Terms) -> Term { app(callee, product_of_args(args)) }

// Build the `Term` node a finished intrinsic or ordinary application
// argument-list forms, from the target and the collected (reversed) terms.
fn built(t: Term) -> Term | String { widen_sum!(t, Term | String) }

fn build_node(tg: Tg, rev_args: Terms, bool_type: Host_type | String) -> Term | String {
  let args = terms_reverse(rev_args);
  match! un_tg(tg) {
    (
      , .(a: Tg_app) { built(build_app(Tg_app.get(a), args)) }
      , .(_p: Tg_pair) { built(pair(arg0(args), arg1(args))) }
      , .(_f: Tg_fst) { built(fst(arg0(args))) }
      , .(_s: Tg_snd) { built(snd(arg0(args))) }
      , .(_l: Tg_left) { built(left(arg0(args))) }
      , .(_r: Tg_right) { built(right(arg0(args))) }
      , .(_e: Tg_either) { built(either(arg0(args), arg1(args), arg2(args))) }
      , .(_i: Tg_ite) {
          match! bool_type {
            (
              , .(message: String) { widen_sum!(message, Term | String) }
              , .(ty: Host_type) { built(ite(ty, arg0(args), arg1(args), arg2(args))) }
              )
          }
        }
      , .(_x: Tg_absurd) { built(absurd(arg0(args))) }
      )
  }
}

// =====================================================================
// The parser machine — a CEK abstract machine over the token list
// =====================================================================
//
// Parsing a tree of arbitrary depth without in-language recursion is the
// same problem the evaluator solves: an explicit control + continuation
// the host `loop` drives one transition at a time. The control either
// *parses* an expression from a token-run under a binder scope, or *yields*
// a built term plus the tokens after it; the
// continuation is a stack of frames, each carrying the scope it resumes
// under, so de Bruijn resolution is implicit in the frame structure.
//
// A **step budget** (a host `I32`, decremented each transition) bounds a
// run: a well-formed image parses in a finite number of steps, so the
// budget defends only against a malformed image, yielding the `P_err`
// result rather than looping. Precise spanned diagnostics on a malformed
// image are a refinement; this parser targets well-formed Prime emit and
// is total (every run yields a term or `P_err`).

// =====================================================================
// Ctl — what the machine parses or yields this transition
// =====================================================================
//
// A **block** is a `(stmt ;)* finalexpr` body — the right-hand side of a
// `fn`, a lambda body, or a let body. A bare **expr** is a
// single expression that never spans a `;` — an argument value. The two
// controls keep the distinction: `Pc_block` admits expression-statements
// (`e; rest`, lowering to `let_(e, rest)` with an unused binder, since
// the evaluator pushes the discarded `()` result), while `Pc_expr` parses
// exactly one expression and a following `;` is not its concern.
/// Defines the parse-block control state (a `(stmt ;)* finalexpr` body).
pub labels { pc_block: Toks & Scope };

/// Defines the parse-expression control state (one expression, no statements).
pub labels { pc_expr: Toks & Scope };

/// Defines the yield-term control state (a built term and the tokens after it).
pub labels { pc_yield: Term & Toks };

/// The machine's current activity.
pub labels { pctl: Pc_block | Pc_expr | Pc_yield };

/// The bare control sum inside a `Pctl`.
pub type Pctl_shape = Pc_block | Pc_expr | Pc_yield;

fn c_pblock(ts: Toks, sc: Scope) -> Pctl { {pctl = widen_sum!({pc_block = (ts, sc)}, Pctl_shape)} }

fn c_pexpr(ts: Toks, sc: Scope) -> Pctl { {pctl = widen_sum!({pc_expr = (ts, sc)}, Pctl_shape)} }

fn c_pyield(t: Term, ts: Toks) -> Pctl { {pctl = widen_sum!({pc_yield = (t, ts)}, Pctl_shape)} }

fn un_pctl(c: Pctl) -> Pctl_shape { Pctl.get(c) }

// =====================================================================
// Pf — one pending parser continuation frame
// =====================================================================
//
//   Pf_post   Scope                         a value was yielded; apply any
//                                           postfix `(args)` under this scope
//   Pf_coll   Tg & Terms & Scope            collecting value-args: target,
//                                           reversed args, scope
//   Pf_letrhs String & Scope                let RHS done; bind the name and
//                                           parse the body in the pushed scope
//   Pf_letbody Term                          let body done; build `let_(rhs, body)`
//   Pf_lam    ()                            lambda body done; wrap in `lam`
/// Defines the postfix-application frame.
pub labels { pf_post: Scope };

/// Defines the argument-collection frame.
pub labels { pf_coll: Tg & Terms & Scope };

/// Defines the let-right-hand-side frame.
pub labels { pf_letrhs: String & Scope };

/// Defines the let-body frame.
pub labels { pf_letbody: Term };

/// Defines the lambda-body frame (carrying the dot-lambda's parameter
/// groups, to wrap the body in its curried product-projecting closure).
pub labels { pf_lam: Pnlg };

/// Defines the block-statement frame (decides expression-statement vs. final block expr).
pub labels { pf_stmt: Scope };

/// Defines the parenthesized-grouping frame (expects the closing `)`).
pub labels { pf_group: Scope };

/// One pending parser continuation frame.
pub labels { pf: Pf_post | Pf_coll | Pf_letrhs | Pf_letbody | Pf_lam | Pf_stmt | Pf_group };

/// The bare frame sum inside a `Pf`.
pub type Pf_shape = Pf_post | Pf_coll | Pf_letrhs | Pf_letbody | Pf_lam | Pf_stmt | Pf_group;

fn mk_post(sc: Scope) -> Pf { {pf = widen_sum!({pf_post = sc}, Pf_shape)} }

fn mk_coll(tg: Tg, rev: Terms, sc: Scope) -> Pf {
  {pf = widen_sum!({pf_coll = (tg, (rev, sc))}, Pf_shape)}
}

fn mk_letrhs(name: String, sc: Scope) -> Pf {
  {pf = widen_sum!({pf_letrhs = (name, sc)}, Pf_shape)}
}

fn mk_letbody(rhs: Term) -> Pf { {pf = widen_sum!({pf_letbody = rhs}, Pf_shape)} }

fn mk_lam(groups: Pnlg) -> Pf { {pf = widen_sum!({pf_lam = groups}, Pf_shape)} }

fn mk_stmt(sc: Scope) -> Pf { {pf = widen_sum!({pf_stmt = sc}, Pf_shape)} }

fn mk_group(sc: Scope) -> Pf { {pf = widen_sum!({pf_group = sc}, Pf_shape)} }

fn un_pf(f: Pf) -> Pf_shape { Pf.get(f) }

// =====================================================================
// Pk — the continuation, a stack of frames
// =====================================================================
/// The parser continuation stack, innermost frame first.
pub rec labels { pk: . | (Pf & Pk) };

fn pk_nil() -> Pk { {pk = widen_sum!((), . | (Pf & Pk))} }

fn pk_push(f: Pf, k: Pk) -> Pk { {pk = widen_sum!((f, k), . | (Pf & Pk))} }

fn un_pk(k: Pk) -> . | (Pf & Pk) { Pk.get(k) }

// =====================================================================
// Pstate / Pres — the running configuration and the run outcome
// =====================================================================
/// Defines the running parser configuration: control, continuation, remaining step budget, and the resolving module's declaration table.
pub labels { pstate: Pctl & Pk & I32 & Ntab };

fn mk_pstate(c: Pctl, k: Pk, fuel: I32, nt: Ntab) -> Pstate { {pstate = (c, (k, (fuel, nt)))} }

fn un_pstate(s: Pstate) -> Pctl & Pk & I32 & Ntab { Pstate.get(s) }

/// Defines a parse error's payload: a message, and the source byte offset
/// it points at (`()` when the error is at end-of-input).
pub labels { perr: String & (. | I32) };

/// Builds a parse-error payload.
pub fn mk_perr(message: String, pos: . | I32) -> Perr { {perr = (message, pos)} }

/// Builds a parse-error payload pointing at the head of `ts` (or
/// end-of-input when `ts` is empty).
pub fn mk_perr_at(message: String, ts: Toks) -> Perr { mk_perr(message, head_pos(ts)) }

/// The parse error's message.
pub fn perr_message(e: Perr) -> String {
  match! Perr.get(e) {
    .(m: String, _p: . | I32) { m }
  }
}

/// The parse error's byte offset, or `()` when it points at end-of-input.
pub fn perr_pos(e: Perr) -> . | I32 {
  match! Perr.get(e) {
    .(_m: String, p: . | I32) { p }
  }
}

/// Defines the successful parse-result arm.
pub labels { p_ok: Term };

/// Defines the failed parse-result arm (malformed image or budget exhausted),
/// carrying the error's message and position.
pub labels { p_err: Perr };

/// The outcome of a parse run: a term, or a parse error.
pub type Pres = P_ok | P_err;

/// Builds the successful parse result.
pub fn p_ok(t: Term) -> Pres { widen_sum!({p_ok = t}, P_ok | P_err) }

/// Builds the parse-error result.
pub fn p_err(e: Perr) -> Pres { widen_sum!({p_err = e}, P_ok | P_err) }

fn pgo(s: Pstate) -> Pstate | Pres { widen_sum!(s, Pstate | Pres) }

fn phalt(r: Pres) -> Pstate | Pres { widen_sum!(r, Pstate | Pres) }

// Halt with a parse error pointing at the head of `ts`.
fn perr_halt(message: String, ts: Toks) -> Pstate | Pres { phalt(p_err(mk_perr_at(message, ts))) }

// Skip a run of `;` tokens — the block grammar admits stray semicolons
// (`specs/grammar.md` § Productions (Kio'), `BlockBody ::= ';'* (Stmt
// ';'*)* Expr ';'*`).
/// Wraps the semicolon-skip loop's exit (the tokens after the run).
labels { after_semis: Toks };

fn skip_semis(ts: Toks) -> Toks {
  After_semis.get(loop(
    , .(cur: Toks) {
        if! head_is_punct(cur, c_semi()) {
          widen_sum!(rest(cur), Toks | After_semis)
        } else {
          widen_sum!({after_semis = cur}, Toks | After_semis)
        }
      }
    , ts
    ))
}

/// Wraps a literal annotation read's `(source-path, remaining-tokens)`.
labels { lit_annot: String & Toks };

/// Wraps the annotation path walk's exact source spelling.
labels { annot_path: String };

// The exact annotation path spelling: `I32`, `t.String`, or `a/b.Temp`.
// Resolution belongs to the declaring module's validated namespace, so the
// parser retains every owner/alias segment rather than dequalifying to a leaf.
fn exact_annot_path(first: String, ts: Toks) -> String {
  Annot_path.get(loop(
    , .(st: Toks & String) {
        match! st {
          .(cur: Toks, path: String) {
            if! head_is_punct(cur, c_slash()) {
              match! head_word_str(rest(cur)) {
                (
                  , .(seg: String) {
                      widen_sum!(
                        , (rest(rest(cur)), string_concat(path, string_concat("/"(String), seg)))
                        , (Toks & String) | Annot_path
                        )
                    }
                  , .(_notword: .) { widen_sum!({annot_path = path}, (Toks & String) | Annot_path) }
                  )
              }
            } else if! head_is_punct(cur, c_dot()) {
              match! head_word_str(rest(cur)) {
                (
                  , .(seg: String) {
                      widen_sum!(
                        , (rest(rest(cur)), string_concat(path, string_concat("."(String), seg)))
                        , (Toks & String) | Annot_path
                        )
                    }
                  , .(_notword: .) { widen_sum!({annot_path = path}, (Toks & String) | Annot_path) }
                  )
              }
            } else {
              widen_sum!({annot_path = path}, (Toks & String) | Annot_path)
            }
          }
        }
      }
    , (ts, first)
    ))
}

// Read a literal's mandatory host-type annotation `( <type> )`, returning
// the type's exact source-path spelling and the tokens after the `)`, or a
// parse error. Every Kio' literal carries the annotation (`5(I32)`,
// `"hi"(String)`, `562.406(F64)`; grammar `LiteralCall`). The caller resolves
// the retained spelling in the declaring module's validated namespace to the
// exact `Host_type` the host receives. Consuming the annotation keeps `(I32)`
// from being misread as a postfix application; `exact_annot_path` retains every
// alias or module segment, and `skip_type_arg` walks any remaining annotation
// type arguments to the closing `)`.
fn read_lit_annot(ts: Toks) -> Lit_annot | Perr {
  if! head_is_punct(ts, c_lparen()) {
    let ts1 = rest(ts);
    match! head_word_str(ts1) {
      (
        , .(first: String) {
            let type_name = exact_annot_path(first, rest(ts1));
            let ts2 = skip_type_arg(ts1);
            if! head_is_punct(ts2, c_rparen()) {
              widen_sum!({lit_annot = (type_name, rest(ts2))}, Lit_annot | Perr)
            } else {
              widen_sum!(
                , mk_perr_at("expected `)` closing a literal's type annotation"(String), ts2)
                , Lit_annot | Perr
                )
            }
          }
        , .(_notword: .) {
            widen_sum!(
              , mk_perr_at("a literal's type annotation must name its host type"(String), ts1)
              , Lit_annot | Perr
              )
          }
        )
    }
  } else {
    widen_sum!(
      , mk_perr_at("a literal must carry a parenthesized type annotation"(String), ts)
      , Lit_annot | Perr
      )
  }
}

fn un_lit_annot_read(r: Lit_annot | Perr) -> Lit_annot | Perr { r }

// Begin collecting the value-arguments of a call (the `(` already
// consumed, and for an intrinsic the type-args already skipped). An
// immediate `)` is an empty argument list — the node is built from no
// args (for an application, `t()` applies the callee to the unit value).
// Otherwise parse the first value-arg into a `Pf_coll` frame. Every argument,
// including `__either__` handlers and `__if_then_else__` thunks, is an
// ordinary value expression. The emitter's leading-comma style means a
// leading comma may precede the first arg.
// The erased result of a type-only application's target. An ordinary
// application target already carries its Unit applications. Intrinsic targets never
// appear bare (`bare_target_msg` rejects them first), so their arms yield
// an inert unit.
fn bare_target(t: Tg) -> Term {
  match! un_tg(t) {
    (
      , .(a: Tg_app) { Tg_app.get(a) }
      , .(_p: Tg_pair) { unit() }
      , .(_f: Tg_fst) { unit() }
      , .(_s: Tg_snd) { unit() }
      , .(_l: Tg_left) { unit() }
      , .(_r: Tg_right) { unit() }
      , .(_e: Tg_either) { unit() }
      , .(_i: Tg_ite) { unit() }
      , .(_x: Tg_absurd) { unit() }
      )
  }
}

// A type-only application is well-formed only for targets that are values
// under erasure — an ordinary application callee. The Kio' intrinsics are
// syntax, not values — a bare `__pair__(A, B)` with no value arguments is
// a malformed image.
fn bare_target_msg(t: Tg) -> . | String {
  let reject =
    string_concat(
      , "type-only application of "(String)
      , string_concat(tg_describe(t), " — an intrinsic requires its value arguments"(String))
      );
  match! un_tg(t) {
    (
      , .(_a: Tg_app) { widen_sum!((), . | String) }
      , .(_p: Tg_pair) { widen_sum!(reject, . | String) }
      , .(_f: Tg_fst) { widen_sum!(reject, . | String) }
      , .(_s: Tg_snd) { widen_sum!(reject, . | String) }
      , .(_l: Tg_left) { widen_sum!(reject, . | String) }
      , .(_r: Tg_right) { widen_sum!(reject, . | String) }
      , .(_e: Tg_either) { widen_sum!(reject, . | String) }
      , .(_i: Tg_ite) { widen_sum!(reject, . | String) }
      , .(_x: Tg_absurd) { widen_sum!(reject, . | String) }
      )
  }
}

// Boolean disjunction over two already-computed host bools.
fn or_bool(a: Bool, b: Bool) -> Bool {
  if! a {
    .t(Bool)
  } else {
    b
  }
}

fn start_args(tg: Tg, source_empty: Bool, ts: Toks, sc: Scope, k: Pk, fuel: I32, nt: Ntab) ->
  Pstate | Pres
   {
  let ts1 = drop_comma(ts);
  if! head_is_punct(ts1, c_rparen()) {
    if! source_empty {
      match! un_maybe_msg(args_count_mismatch(tg, 0(I32))) {
        (
          , .(msg: String) { perr_halt(msg, ts1) }
          , .(_ok: .) {
              match! build_node(
                , tg
                , tnil()
                , widen_sum!(
                    , "conditional descriptor requested for a non-conditional node"(String)
                    , Host_type | String
                    )
                ) {
                (
                  , .(message: String) { perr_halt(message, ts1) }
                  , .(node: Term) {
                      pgo(mk_pstate(c_pyield(node, rest(ts1)), pk_push(mk_post(sc), k), fuel, nt))
                    }
                  )
              }
            }
          )
      }
    } else {
      // Every written argument was a type: a type-only application `f(T...)`.
      // The ordinary target already carries one Unit application per type
      // argument, but this packet performs no value-domain application. Yield
      // it through a postfix frame so a chained `(args)` still applies it.
      match! un_maybe_msg(bare_target_msg(tg)) {
        (
          , .(msg: String) { perr_halt(msg, ts1) }
          , .(_ok: .) {
              pgo(mk_pstate(c_pyield(bare_target(tg), rest(ts1)), pk_push(mk_post(sc), k), fuel, nt))
            }
          )
      }
    }
  } else {
    let coll = mk_coll(tg, tnil(), sc);
    pgo(mk_pstate(c_pexpr(ts1, sc), pk_push(coll, k), fuel, nt))
  }
}

// =====================================================================
// Yielding a value to the continuation
// =====================================================================
//
// `do_pyield` feeds a built term (and the tokens after it) to the top
// frame; an empty continuation means the whole expression is parsed and
// the term is the result. Every arm of `do_pyield_frame` either halts or
// returns the next `Pstate` — none calls back into `do_pyield`, so the
// host `loop` (not in-language recursion) drives the iteration, exactly
// as `eval.kio`'s machine does. This keeps the helper call graph acyclic,
// which Kio''s no-recursion / order-sensitive-visibility rule requires.

// Decompose the top frame and resume it with the yielded `(v, ts)`,
// producing the next machine state.
//
//   Pf_post   — postfix: a `(` after `v` opens an application of `v` to
//               the parenthesized args (target `Tg_app`); otherwise `v`
//               is final here and re-yielded against the popped
//               continuation, so the next frame down handles it.
//   Pf_coll   — push `v` as the just-parsed arg; a `,` parses the next
//               ordinary value expression, while a `)` builds the node and
//               re-yields it through a fresh postfix frame.
//   Pf_letrhs — the RHS is `v`; parse the body in the pushed scope, with
//               the body's result going to `Pf_letbody`.
//   Pf_letbody — the body is `v`; re-yield `let_(rhs, v)`.
//   Pf_lam    — the body is `v`; consume `}`, re-yield `lam(v)`.
fn do_pyield_frame(
  , bool_type: Host_type | String
  , v: Term
  , ts: Toks
  , top: Pf
  , rest_k: Pk
  , fuel: I32
  , nt: Ntab
  ) -> Pstate | Pres {
  match! un_pf(top) {
    (
      , .(fr: Pf_post) {
          let sc = Pf_post.get(fr);
          if! head_is_punct(ts, c_lparen()) {
            // A postfix packet on an ordinary value represents each leading
            // type argument as one evaluator-internal Unit application, then
            // applies at most one written value-domain packet. Surface
            // flattening has already become nested Kio' applications, so no
            // declaration shape is needed here. This also covers aliases
            // and projected values.
            let args0 = rest(ts);
            match! apply_value_typeargs(v, args0) {
              .(typed: Term, after_types: Toks) {
                start_args(
                  , tg_app(typed)
                  , head_is_punct(drop_comma(args0), c_rparen())
                  , after_types
                  , sc
                  , rest_k
                  , fuel
                  , nt
                  )
              }
            }
          } else {
            pgo(mk_pstate(c_pyield(v, ts), rest_k, fuel, nt))
          }
        }
      , .(fr: Pf_coll) {
          match! Pf_coll.get(fr) {
            .(tg: Tg, rev: Terms, sc: Scope) {
              let rev1 = tcons(v, rev);
              if! head_is_punct(ts, c_comma()) {
                let coll = mk_coll(tg, rev1, sc);
                pgo(mk_pstate(c_pexpr(rest(ts), sc), pk_push(coll, rest_k), fuel, nt))
              } else if! head_is_punct(ts, c_rparen()) {
                match! un_maybe_msg(args_count_mismatch(tg, terms_len(rev1))) {
                  (
                    , .(msg: String) { perr_halt(msg, ts) }
                    , .(_ok: .) {
                        match! build_node(tg, rev1, bool_type) {
                          (
                            , .(message: String) { perr_halt(message, ts) }
                            , .(node: Term) {
                                pgo(mk_pstate(
                                  , c_pyield(node, rest(ts))
                                  , pk_push(mk_post(sc), rest_k)
                                  , fuel
                                  , nt
                                  ))
                              }
                            )
                        }
                      }
                    )
                }
              } else {
                perr_halt("expected `,` or `)` in an argument list"(String), ts)
              }
            }
          }
        }
      , .(fr: Pf_letrhs) {
          match! Pf_letrhs.get(fr) {
            .(name: String, sc: Scope) {
              if! head_is_punct(ts, c_semi()) {
                pgo(mk_pstate(
                  , c_pblock(rest(ts), scope_push(name, sc))
                  , pk_push(mk_letbody(v), rest_k)
                  , fuel
                  , nt
                  ))
              } else {
                perr_halt("expected `;` after a `let` binding's right-hand side"(String), ts)
              }
            }
          }
        }
      , .(fr: Pf_letbody) {
          pgo(mk_pstate(c_pyield(let_(Pf_letbody.get(fr), v), ts), rest_k, fuel, nt))
        }
      , .(fr: Pf_lam) {
          if! head_is_punct(ts, c_rbrace()) {
            pgo(mk_pstate(c_pyield(wrap_lambda(Pf_lam.get(fr), v), rest(ts)), rest_k, fuel, nt))
          } else {
            perr_halt("expected `}` closing a lambda body"(String), ts)
          }
        }
      , .(fr: Pf_stmt) {
          let sc = Pf_stmt.get(fr);
          if! head_is_punct(ts, c_semi()) {
            // An expression-statement — unless only trailing semicolons
            // remain before the block's end, in which case the expression
            // was the block's final one (`BlockBody` admits `Expr ';'*`).
            let ts1 = skip_semis(ts);
            match! peek(ts1) {
              (
                , .(_t: Token) {
                    if! head_is_punct(ts1, c_rbrace()) {
                      pgo(mk_pstate(c_pyield(v, ts1), rest_k, fuel, nt))
                    } else {
                      pgo(mk_pstate(
                        , c_pblock(ts1, scope_push_names(pnl_nil(), sc))
                        , pk_push(mk_letbody(v), rest_k)
                        , fuel
                        , nt
                        ))
                    }
                  }
                , .(_end: .) { pgo(mk_pstate(c_pyield(v, ts1), rest_k, fuel, nt)) }
                )
            }
          } else {
            pgo(mk_pstate(c_pyield(v, ts), rest_k, fuel, nt))
          }
        }
      , .(fr: Pf_group) {
          let gsc = Pf_group.get(fr);
          if! head_is_punct(ts, c_rparen()) {
            pgo(mk_pstate(c_pyield(v, rest(ts)), pk_push(mk_post(gsc), rest_k), fuel, nt))
          } else {
            perr_halt("expected `)` closing a parenthesized expression"(String), ts)
          }
        }
      )
  }
}

// Feed the yielded `(v, ts)` to the continuation: resume the top frame,
// or finish with `P_ok` when the continuation is empty.
fn do_pyield(bool_type: Host_type | String, v: Term, ts: Toks, k: Pk, fuel: I32, nt: Ntab) ->
  Pstate | Pres
   {
  match! un_pk(k) {
    (
      , .(top: Pf, rest_k: Pk) { do_pyield_frame(bool_type, v, ts, top, rest_k, fuel, nt) }
      , .(_empty: .) { phalt(p_ok(v)) }
      )
  }
}

// =====================================================================
// Parsing an expression — dispatch on the first token
// =====================================================================
//
// Every primary is yielded to a fresh postfix frame, so a following
// `(args)` becomes an application (`f(a)`, `.(x){…}(a)`, `t()`). Compound
// primaries (lambda, let, intrinsic / host call) push frames and set the
// control to parse their sub-expressions.

// The yielded value enters a postfix frame so any trailing `(args)`
// applies it. `k` is the continuation the postfix frame sits on top of.
fn yield_primary(v: Term, ts: Toks, sc: Scope, k: Pk, fuel: I32, nt: Ntab) -> Pstate | Pres {
  pgo(mk_pstate(c_pyield(v, ts), pk_push(mk_post(sc), k), fuel, nt))
}

fn yield_literal(
  , resolve_host_type: String -> Host_type | String
  , text: String
  , type_name: String
  , after: Toks
  , pos: . | I32
  , sc: Scope
  , k: Pk
  , fuel: I32
  , nt: Ntab
  ) -> Pstate | Pres {
  match! resolve_host_type(type_name) {
    (
      , .(message: String) { phalt(p_err(mk_perr(message, pos))) }
      , .(host_type: Host_type) { yield_primary(lit(text, host_type), after, sc, k, fuel, nt) }
      )
  }
}

// Begin a node-building call. The `(` is already consumed; skip its written
// leading type arguments structurally before collecting the value arguments.
fn start_call(tg: Tg, ts: Toks, sc: Scope, k: Pk, fuel: I32, nt: Ntab) -> Pstate | Pres {
  start_args(
    , tg
    , head_is_punct(drop_comma(ts), c_rparen())
    , skip_value_typeargs(ts)
    , sc
    , k
    , fuel
    , nt
    )
}

// A boolean literal `.t(Bool)` / `.f(Bool)`: `w` is the `t` / `f` word, `ts`
// is just after it (at the `( Bool )` annotation). The literal's text is the
// `t` / `f` spelling and the annotation resolves to an exact host descriptor;
// the host constructs the bool scalar from them. The parser pins no Boolean
// representation itself. Any other word after `.` is not
// a Kio' value form.
fn parse_bool_lit(
  , resolve_host_type: String -> Host_type | String
  , w: String
  , ts: Toks
  , sc: Scope
  , k: Pk
  , fuel: I32
  , nt: Ntab
  ) -> Pstate | Pres {
  if! or_bool(string_eq(w, "t"(String)), string_eq(w, "f"(String))) {
    match! un_lit_annot_read(read_lit_annot(ts)) {
      (
        , .(a: Lit_annot) {
            match! Lit_annot.get(a) {
              .(ty: String, after: Toks) {
                yield_literal(resolve_host_type, w, ty, after, head_pos(ts), sc, k, fuel, nt)
              }
            }
          }
        , .(e: Perr) { phalt(p_err(e)) }
        )
    }
  } else {
    perr_halt("expected `t` or `f` in a boolean literal after `.`"(String), ts)
  }
}

/// Wraps one lambda binder-group scan's `(arity, remaining-tokens)`.
labels { lambda_binder_scan: I32 & Toks };

// Count every unary binder in one `[A, B]` group and return the cursor after
// it. A grouped spelling is semantically the same consecutive `forall`
// chain as `[A][B]`, so each binder becomes its own erased Unit stage.
fn scan_lambda_binder_group(ts: Toks) -> Lambda_binder_scan | Perr {
  let pos = head_pos(ts);
  loop(
    , .(st: Toks & I32) {
        match! st {
          .(cur: Toks, n: I32) {
            match! peek(cur) {
              (
                , .(_token: Token) {
                    if! head_is_punct(cur, c_rbrack()) {
                      widen_sum!(
                        , {lambda_binder_scan = (n, rest(cur))}
                        , (Toks & I32) | Lambda_binder_scan | Perr
                        )
                    } else if! head_is_punct(cur, c_comma()) {
                      widen_sum!(
                        , (rest(cur), add_i32(n, 1(I32)))
                        , (Toks & I32) | Lambda_binder_scan | Perr
                        )
                    } else {
                      widen_sum!((rest(cur), n), (Toks & I32) | Lambda_binder_scan | Perr)
                    }
                  }
                , .(_eof: .) {
                    widen_sum!(
                      , mk_perr("unterminated type-binder group in a lambda"(String), pos)
                      , (Toks & I32) | Lambda_binder_scan | Perr
                      )
                  }
                )
            }
          }
        }
      }
    , (rest(ts), 1(I32))
    )
}

// Scan a dot-lambda's value-parameter list — the head just after the `(` —
// collecting names (declaration order) and returning them plus the tokens
// after the `)`. Each `NAME : TYPE` item contributes its name; the type is
// skipped; `,` separates; `)` ends. A zero-param list returns the empty
// names. (The result names are most-recent-first; the caller reverses.)
/// Wraps a lambda-param scan's `(rev-names, remaining-tokens)`.
labels { lparams: Pnl & Toks };

fn scan_lambda_params(ts: Toks) -> Pnl & Toks {
  Lparams.get(loop(
    , .(st: Toks & Pnl) {
        match! st {
          .(cur0: Toks, acc: Pnl) {
            // A wrapped header puts the list comma-first (the emitter's
            // leading-comma style), so a comma may precede any param.
            let cur = drop_comma(cur0);
            if! head_is_punct(cur, c_rparen()) {
              widen_sum!({lparams = (acc, rest(cur))}, (Toks & Pnl) | Lparams)
            } else match! peek(cur) {
              (
                , .(t: Token) {
                    match! un_token(t) {
                      (
                        , .(nm: Tk_word) {
                            // A param's type annotation is optional in a
                            // dot-lambda (`FnSignatureParam`): the emit writes
                            // unannotated continuation params (`.[U](pair) {…}`).
                            let after_name = rest(cur);
                            let after_type =
                              if! head_is_punct(after_name, c_colon()) {
                                skip_type_arg(rest(after_name))
                              } else {
                                after_name
                              };
                            let after_comma = drop_comma(after_type);
                            widen_sum!(
                              , (after_comma, pnl_cons(Tk_word.get(nm), acc))
                              , (Toks & Pnl) | Lparams
                              )
                          }
                        , .(_i: Tk_num) {
                            widen_sum!({lparams = (acc, cur)}, (Toks & Pnl) | Lparams)
                          }
                        , .(_s: Tk_str) {
                            widen_sum!({lparams = (acc, cur)}, (Toks & Pnl) | Lparams)
                          }
                        , .(_p: Tk_punct) {
                            widen_sum!({lparams = (acc, cur)}, (Toks & Pnl) | Lparams)
                          }
                        )
                    }
                  }
                , .(_e: .) { widen_sum!({lparams = (acc, cur)}, (Toks & Pnl) | Lparams) }
                )
            }
          }
        }
      }
    , (ts, pnl_nil())
    ))
}

// Skip the tokens of a return type up to — without consuming — the first
// depth-0 `{` (a Kio' type contains no braces, so the body's `{` is the
// first one at depth 0).
/// Wraps the return-type skip's exit (the tokens at the body's `{`).
labels { ret_done: Toks };

fn skip_to_lbrace(ts: Toks) -> Toks {
  Ret_done.get(loop(
    , .(st: Toks & I32) {
        match! st {
          .(cur: Toks, depth: I32) {
            match! peek(cur) {
              (
                , .(t: Token) {
                    if! eq_i32(depth, 0(I32)) {
                      if! is_punct(t, c_lbrace()) {
                        widen_sum!({ret_done = cur}, (Toks & I32) | Ret_done)
                      } else {
                        widen_sum!((rest(cur), bracket_delta(t, depth)), (Toks & I32) | Ret_done)
                      }
                    } else {
                      widen_sum!((rest(cur), bracket_delta(t, depth)), (Toks & I32) | Ret_done)
                    }
                  }
                , .(_e: .) { widen_sum!({ret_done = cur}, (Toks & I32) | Ret_done) }
                )
            }
          }
        }
      }
    , (ts, 0(I32))
    ))
}

// Skip an optional `-> Type` return annotation between a lambda's
// parameter list and its body `{` (the emit writes one whenever the
// source lambda carried it; erased like every other annotation).
fn skip_ret_annot(ts: Toks) -> Toks {
  if! head_is_punct(ts, c_minus()) {
    if! head_is_punct(rest(ts), c_gt()) {
      skip_to_lbrace(rest(rest(ts)))
    } else {
      ts
    }
  } else {
    ts
  }
}

/// Wraps the lambda-signature collection's
/// `(groups, remaining-tokens, saw-value-group)`.
labels { lgroups: Pnlg & Toks & Bool };

fn pnlg_prepend_empty(count: I32, groups: Pnlg) -> Pnlg {
  loop(
    , .(st: I32 & Pnlg) {
        match! st {
          .(remaining: I32, acc: Pnlg) {
            if! leq_i32(remaining, 0(I32)) {
              widen_sum!(acc, (I32 & Pnlg) | Pnlg)
            } else {
              widen_sum!(
                , (sub_i32(remaining, 1(I32)), pnlg_cons(pnl_nil(), acc))
                , (I32 & Pnlg) | Pnlg
                )
            }
          }
        }
      }
    , (count, groups)
    )
}

// Collect a dot-lambda signature's parameter groups — one or more `(…)`
// groups, possibly interleaved with (erased) `[A]…` type-binder runs —
// returning the groups in signature order and the tokens after the last
// group.
fn collect_lambda_groups(ts0: Toks) -> Lgroups | Perr {
  let loop_result =
    loop(
      , .(st: Toks & Pnlg & Bool) {
          match! st {
            .(cur: Toks, acc: Pnlg, saw_value_group: Bool) {
              if! head_is_punct(cur, c_lbrack()) {
                match! scan_lambda_binder_group(cur) {
                  (
                    , .(group: Lambda_binder_scan) {
                        match! Lambda_binder_scan.get(group) {
                          .(arity: I32, after: Toks) {
                            widen_sum!(
                              , (after, pnlg_prepend_empty(arity, acc), saw_value_group)
                              , (Toks & Pnlg & Bool) | Lgroups | Perr
                              )
                          }
                        }
                      }
                    , .(error: Perr) { widen_sum!(error, (Toks & Pnlg & Bool) | Lgroups | Perr) }
                    )
                }
              } else if! head_is_punct(cur, c_lparen()) {
                match! scan_lambda_params(rest(cur)) {
                  .(rev_params: Pnl, after_params: Toks) {
                    widen_sum!(
                      , (after_params, pnlg_cons(pnl_reverse(rev_params), acc), .t(Bool))
                      , (Toks & Pnlg & Bool) | Lgroups | Perr
                      )
                  }
                }
              } else {
                widen_sum!(
                  , {lgroups = (pnlg_reverse(acc), cur, saw_value_group)}
                  , (Toks & Pnlg & Bool) | Lgroups | Perr
                  )
              }
            }
          }
        }
      , (ts0, pnlg_nil(), .f(Bool))
      );
  match! loop_result {
    (
      , .(done: Lgroups) { widen_sum!(done, Lgroups | Perr) }
      , .(error: Perr) { widen_sum!(error, Lgroups | Perr) }
      )
  }
}

// A lambda primary, `ts` positioned just after the `.`. The signature's
// parameter groups are collected; each unary type binder is retained as an
// erased Unit stage. A 0-param value group likewise binds a unit value, a 1-param group
// binds the sole param, and an N≥2-param group binds one product domain
// with the named params recovered by projection; several groups build the
// curried chain (`wrap_lambda` via the `Pf_lam` frame). An optional `-> R`
// return annotation before the body is erased. The body is parsed in the
// groups' scope (`lambda_body_scope`). A `Pf_post` frame (in the
// **use-site** scope `sc`) sits under `Pf_lam` so a lambda that is
// immediately applied — `.(x: T) { body }(arg)`, the shape the `match!`
// elaborator's handlers lower to — has its trailing `(args)` turned into
// an application.
fn parse_lambda(ts0: Toks, sc: Scope, k: Pk, fuel: I32, nt: Ntab) -> Pstate | Pres {
  match! collect_lambda_groups(ts0) {
    (
      , .(done: Lgroups) {
          match! Lgroups.get(done) {
            .(groups: Pnlg, after_groups: Toks, saw_value_group: Bool) {
              if! saw_value_group {
                let at_brace = skip_ret_annot(after_groups);
                if! head_is_punct(at_brace, c_lbrace()) {
                  pgo(mk_pstate(
                    , c_pblock(rest(at_brace), lambda_body_scope(groups, sc))
                    , pk_push(mk_lam(groups), pk_push(mk_post(sc), k))
                    , fuel
                    , nt
                    ))
                } else {
                  perr_halt("expected `{` opening a lambda body"(String), at_brace)
                }
              } else {
                perr_halt("expected `(` opening a lambda's parameter list"(String), after_groups)
              }
            }
          }
        }
      , .(error: Perr) { phalt(p_err(error)) }
      )
  }
}

// A `.`-led primary: a boolean literal (`.t(Bool)` / `.f(Bool)`) or a
// lambda (`.(x: T) { … }` or the zero-param `.() { … }`). `ts` is
// positioned just after the `.`.
fn parse_dot(
  , resolve_host_type: String -> Host_type | String
  , ts: Toks
  , sc: Scope
  , k: Pk
  , fuel: I32
  , nt: Ntab
  ) -> Pstate | Pres {
  match! peek(ts) {
    (
      , .(t: Token) {
          match! un_token(t) {
            (
              , .(w: Tk_word) {
                  parse_bool_lit(resolve_host_type, Tk_word.get(w), rest(ts), sc, k, fuel, nt)
                }
              , .(_i: Tk_num) {
                  perr_halt("expected a boolean literal or a lambda after `.`"(String), ts)
                }
              , .(_s: Tk_str) {
                  perr_halt("expected a boolean literal or a lambda after `.`"(String), ts)
                }
              , .(_p: Tk_punct) { parse_lambda(ts, sc, k, fuel, nt) }
              )
          }
        }
      , .(_e: .) { perr_halt("unexpected end of input after `.`"(String), ts) }
      )
  }
}

// Destructor on `Headclass` (a bare sum; the identity projects it for match).
fn un_pheadclass(h: Headclass) -> Hc_call | Hc_var { h }

// Resolve an in-scope variable `w` (already classified `Hc_var`) at index
// `idx`. Every ordinary value follows the same postfix path. That path reads
// only the written Kio' packet, so a direct declaration, local alias, host
// value, or projected value cannot select different application behavior.
fn resolve_var(w: String, idx: Nat, ts: Toks, sc: Scope, k: Pk, fuel: I32, nt: Ntab) ->
  Pstate | Pres
   { yield_primary(var(idx), ts, sc, k, fuel, nt) }

// Boolean conjunction over two already-computed host bools.
fn and_bool(a: Bool, b: Bool) -> Bool {
  if! a {
    b
  } else {
    .f(Bool)
  }
}

// The dotted spelling `a.b`.
fn join2(a: String, b: String) -> String { string_concat(a, string_concat("."(String), b)) }

// Classify and parse a word that is not a dotted reference: an intrinsic
// call, or an ordinary variable — a local binder, a seeded top-level fn
// (possibly under an alias-qualified spelling), or a seeded host fn —
// resolved to its de Bruijn index against the scope. An unbound name is a
// malformed image, reported with the name and its position.
fn parse_word_classified(w: String, wpos: . | I32, ts: Toks, sc: Scope, k: Pk, fuel: I32, nt: Ntab) ->
  Pstate | Pres
   {
  match! un_pheadclass(classify_head(w, sc)) {
    (
      , .(c: Hc_call) {
          if! head_is_punct(ts, c_lparen()) {
            start_call(Hc_call.get(c), rest(ts), sc, k, fuel, nt)
          } else {
            phalt(p_err(mk_perr(
              , string_concat(
                  , "expected `(` after the intrinsic `"(String)
                  , string_concat(w, "`"(String))
                  )
              , wpos
              )))
          }
        }
      , .(_v: Hc_var) {
          match! scope_index(w, sc) {
            (
              , .(idx: Nat) { resolve_var(w, idx, ts, sc, k, fuel, nt) }
              , .(_unbound: .) {
                  phalt(p_err(mk_perr(
                    , string_concat("unbound name `"(String), string_concat(w, "`"(String)))
                    , wpos
                    )))
                }
              )
          }
        }
      )
  }
}

// A qualified newtype member call or reference: the newtype identified by
// its visible `spelling` (bare `Box`, or alias-qualified `a.Box`) with
// entry `info`, the `member` word read, and `after_member` the tokens just
// past it. A constructor and a non-existential projector erase to the
// **identity** on the single payload argument;
// `specs/prime.md` § The `newtype` primitive); an **existential projector**
// erases to the CPS form, so the emitted curried second
// application `(R, k)` delivers the payload to the continuation
// (`specs/prime.md` § Existential introduction and elimination). The parser
// constructs that erased member value with every universal stage intact and
// always hands it to ordinary postfix parsing. Consequently direct calls,
// partial type application, and aliases of a member have identical behavior.
// A member word that names
// neither declared member is a malformed image.
fn parse_member(
  , spelling: String
  , entry: Nt_entry
  , member: String
  , wpos: . | I32
  , after_member: Toks
  , sc: Scope
  , k: Pk
  , fuel: I32
  , nt: Ntab
  ) -> Pstate | Pres {
  let info = nt_entry_info(entry);
  let is_proj = string_eq(member, nt_proj(info));
  if! or_bool(string_eq(member, nt_ctor(info)), is_proj) {
    let allowed = if! is_proj {
      nt_entry_proj_allowed(entry)
    } else {
      nt_entry_ctor_allowed(entry)
    };
    if! allowed {
      let existential_proj = and_bool(is_proj, nt_existential(info));
      let leading_stages = if! is_proj {
        nt_arity(info)
      } else {
        add_i32(nt_arity(info), nt_existential_arity(info))
      };
      let core = if! existential_proj {
        cps_wrapper(nt_existential_arity(info))
      } else {
        identity_wrapper()
      };
      yield_primary(wrap_type_stages(leading_stages, core), after_member, sc, k, fuel, nt)
    } else {
      phalt(p_err(mk_perr(
        , string_concat(
            , "newtype member `"(String)
            , string_concat(
                , member
                , string_concat(
                    , "` is not visible through `"(String)
                    , string_concat(spelling, "`"(String))
                    )
                )
            )
        , wpos
        )))
    }
  } else {
    phalt(p_err(mk_perr(
      , string_concat(
          , "`"(String)
          , string_concat(
              , member
              , string_concat(
                  , "` is not the constructor or projector of newtype `"(String)
                  , string_concat(spelling, "`"(String))
                  )
              )
          )
      , wpos
      )))
  }
}

// An alias-qualified newtype member call `a.X.member(…)`: `a.X` must be a
// visible newtype spelling in the resolving module, and a member must
// follow (`a.X` alone is a type, which never stands in expression
// position).
fn parse_alias_newtype(
  , w: String
  , w2: String
  , wpos: . | I32
  , after2: Toks
  , sc: Scope
  , k: Pk
  , fuel: I32
  , nt: Ntab
  ) -> Pstate | Pres {
  let spelled = join2(w, w2);
  match! ntab_lookup_newtype(spelled, nt) {
    (
      , .(entry: Nt_entry) {
          if! head_is_punct(after2, c_dot()) {
            match! head_word_str(rest(after2)) {
              (
                , .(member: String) {
                    parse_member(spelled, entry, member, wpos, rest(rest(after2)), sc, k, fuel, nt)
                  }
                , .(_notword: .) { perr_halt("expected a member name after `.`"(String), after2) }
                )
            }
          } else {
            phalt(p_err(mk_perr(
              , string_concat(
                  , "expected `.member` after the newtype `"(String)
                  , string_concat(spelled, "`"(String))
                  )
              , wpos
              )))
          }
        }
      , .(_no: .) {
          phalt(p_err(mk_perr(
            , string_concat("unknown newtype `"(String), string_concat(spelled, "`"(String)))
            , wpos
            )))
        }
      )
  }
}

// A dotted reference `w.…` — a newtype member call (`Box.mk(…)`), an
// alias-qualified newtype member call (`a.Box.mk(…)`), or an
// alias-qualified value path (`a.helper`, resolved by its joined
// spelling against the scope the loader seeded). `ts` is at the `.`.
fn parse_dotted(w: String, wpos: . | I32, ts: Toks, sc: Scope, k: Pk, fuel: I32, nt: Ntab) ->
  Pstate | Pres
   {
  let seg = rest(ts);
  match! head_word_str(seg) {
    (
      , .(w2: String) {
          match! ntab_lookup_newtype(w, nt) {
            (
              , .(entry: Nt_entry) { parse_member(w, entry, w2, wpos, rest(seg), sc, k, fuel, nt) }
              , .(_nont: .) {
                  if! word_starts_type_name(w2) {
                    parse_alias_newtype(w, w2, wpos, rest(seg), sc, k, fuel, nt)
                  } else {
                    parse_word_classified(join2(w, w2), wpos, rest(seg), sc, k, fuel, nt)
                  }
                }
              )
          }
        }
      , .(_notword: .) { perr_halt("expected a member name after `.`"(String), ts) }
      )
  }
}

// A word primary: a dotted reference (a newtype member call, an
// alias-qualified member call, or an alias-qualified item), an intrinsic
// call, or an ordinary variable. `ts` is positioned just after the word;
// `wpos` is the word's source offset for diagnostics.
fn parse_word(w: String, wpos: . | I32, ts: Toks, sc: Scope, k: Pk, fuel: I32, nt: Ntab) ->
  Pstate | Pres
   {
  if! head_is_punct(ts, c_dot()) {
    parse_dotted(w, wpos, ts, sc, k, fuel, nt)
  } else {
    parse_word_classified(w, wpos, ts, sc, k, fuel, nt)
  }
}

// A `let x = E; B` binding. `ts` is positioned just after `let`: read the
// binder name, drop `=`, parse the RHS in the *current* scope (Kio' let is
// non-recursive — the RHS does not see the binder), then the `Pf_letrhs`
// frame parses the body in the pushed scope.
fn parse_let(ts: Toks, sc: Scope, k: Pk, fuel: I32, nt: Ntab) -> Pstate | Pres {
  match! peek(ts) {
    (
      , .(t: Token) {
          match! un_token(t) {
            (
              , .(nm: Tk_word) {
                  let after_name = rest(ts);
                  if! head_is_punct(after_name, c_eq()) {
                    pgo(mk_pstate(
                      , c_pexpr(rest(after_name), sc)
                      , pk_push(mk_letrhs(Tk_word.get(nm), sc), k)
                      , fuel
                      , nt
                      ))
                  } else {
                    perr_halt("expected `=` after a `let` binder"(String), after_name)
                  }
                }
              , .(_i: Tk_num) { perr_halt("expected a binder name after `let`"(String), ts) }
              , .(_s: Tk_str) { perr_halt("expected a binder name after `let`"(String), ts) }
              , .(_p: Tk_punct) { perr_halt("expected a binder name after `let`"(String), ts) }
              )
          }
        }
      , .(_e: .) { perr_halt("expected a binder name after `let`"(String), ts) }
      )
  }
}

// Whether the tokens after `let` have the binding shape `NAME = ...` —
// the two-token lookahead separating a `let` binding from a reference to
// a declaration named `let` (Kio has no reserved words, so an image may
// declare and call a fn spelled `let`).
fn is_let_binding_head(ts: Toks) -> Bool {
  match! peek(ts) {
    (
      , .(tok: Token) {
          match! un_token(tok) {
            (
              , .(_nm: Tk_word) { head_is_punct(rest(ts), c_eq()) }
              , .(_i: Tk_num) { .f(Bool) }
              , .(_s: Tk_str) { .f(Bool) }
              , .(_p: Tk_punct) { .f(Bool) }
              )
          }
        }
      , .(_e: .) { .f(Bool) }
      )
  }
}

// A word in expression position: `let` followed by a binding-shaped
// lookahead opens a binding; anything else — including a reference to a
// declaration named `let` — is a call head or variable.
fn do_pword(w: String, wpos: . | I32, ts: Toks, sc: Scope, k: Pk, fuel: I32, nt: Ntab) ->
  Pstate | Pres
   {
  if! string_eq(w, "let"(String)) {
    if! is_let_binding_head(ts) {
      parse_let(ts, sc, k, fuel, nt)
    } else {
      parse_word(w, wpos, ts, sc, k, fuel, nt)
    }
  } else {
    parse_word(w, wpos, ts, sc, k, fuel, nt)
  }
}

// A punctuation-led primary: `.` opens a bool-literal or lambda; `(`
// opens the unit value `()` or a parenthesized expression (`ExprAtom ::=
// '(' Expr ')'`). Any other punctuation is not a primary.
fn do_ppunct(
  , resolve_host_type: String -> Host_type | String
  , code: I32
  , ts: Toks
  , sc: Scope
  , k: Pk
  , fuel: I32
  , nt: Ntab
  ) -> Pstate | Pres {
  if! eq_i32(code, c_dot()) {
    parse_dot(resolve_host_type, rest(ts), sc, k, fuel, nt)
  } else if! eq_i32(code, c_lparen()) {
    let ts1 = rest(ts);
    if! head_is_punct(ts1, c_rparen()) {
      yield_primary(unit(), rest(ts1), sc, k, fuel, nt)
    } else {
      pgo(mk_pstate(c_pexpr(ts1, sc), pk_push(mk_group(sc), k), fuel, nt))
    }
  } else {
    perr_halt("unexpected token at the start of an expression"(String), ts)
  }
}

// Fold an adjacent string-literal run into one literal value — the
// `STR_LIT+` grammar the emitter's >72-character chunking writes
// (`specs/grammar.md` § Lexical structure: adjacent `STR_LIT` tokens fold
// into a single literal).
/// Wraps the string-run fold's `(folded-content, remaining-tokens)`.
labels { strfold: String & Toks };

fn fold_str_run(first: String, ts: Toks) -> String & Toks {
  Strfold.get(loop(
    , .(st: String & Toks) {
        match! st {
          .(acc: String, cur: Toks) {
            match! peek(cur) {
              (
                , .(t: Token) {
                    match! un_token(t) {
                      (
                        , .(_w: Tk_word) {
                            widen_sum!({strfold = (acc, cur)}, (String & Toks) | Strfold)
                          }
                        , .(_i: Tk_num) {
                            widen_sum!({strfold = (acc, cur)}, (String & Toks) | Strfold)
                          }
                        , .(s: Tk_str) {
                            widen_sum!(
                              , (string_concat(acc, Tk_str.get(s)), rest(cur))
                              , (String & Toks) | Strfold
                              )
                          }
                        , .(_p: Tk_punct) {
                            widen_sum!({strfold = (acc, cur)}, (String & Toks) | Strfold)
                          }
                        )
                    }
                  }
                , .(_e: .) { widen_sum!({strfold = (acc, cur)}, (String & Toks) | Strfold) }
                )
            }
          }
        }
      }
    , (first, ts)
    ))
}

// Parse one expression from `ts` in scope `sc`. Dispatch on the first
// token: a literal / unit yields directly, `let` opens a binding, `.`
// opens a bool-literal or lambda, and a word opens a call or variable.
fn do_pexpr(
  , resolve_host_type: String -> Host_type | String
  , ts: Toks
  , sc: Scope
  , k: Pk
  , fuel: I32
  , nt: Ntab
  ) -> Pstate | Pres {
  match! peek(ts) {
    (
      , .(t: Token) {
          match! un_token(t) {
            (
              , .(n: Tk_num) {
                  match! un_lit_annot_read(read_lit_annot(rest(ts))) {
                    (
                      , .(a: Lit_annot) {
                          match! Lit_annot.get(a) {
                            .(ty: String, after: Toks) {
                              yield_literal(
                                , resolve_host_type
                                , Tk_num.get(n)
                                , ty
                                , after
                                , head_pos(ts)
                                , sc
                                , k
                                , fuel
                                , nt
                                )
                            }
                          }
                        }
                      , .(e: Perr) { phalt(p_err(e)) }
                      )
                  }
                }
              , .(s: Tk_str) {
                  match! fold_str_run(Tk_str.get(s), rest(ts)) {
                    .(content: String, after_run: Toks) {
                      match! un_lit_annot_read(read_lit_annot(after_run)) {
                        (
                          , .(a: Lit_annot) {
                              match! Lit_annot.get(a) {
                                .(ty: String, after: Toks) {
                                  yield_literal(
                                    , resolve_host_type
                                    , content
                                    , ty
                                    , after
                                    , head_pos(ts)
                                    , sc
                                    , k
                                    , fuel
                                    , nt
                                    )
                                }
                              }
                            }
                          , .(e: Perr) { phalt(p_err(e)) }
                          )
                      }
                    }
                  }
                }
              , .(w: Tk_word) { do_pword(Tk_word.get(w), head_pos(ts), rest(ts), sc, k, fuel, nt) }
              , .(p: Tk_punct) {
                  do_ppunct(resolve_host_type, Tk_punct.get(p), ts, sc, k, fuel, nt)
                }
              )
          }
        }
      , .(_e: .) { perr_halt("unexpected end of input inside a body"(String), ts) }
      )
  }
}

// Parse a block body `;* (stmt ;+)* finalexpr ;*`: skip any stray leading
// semicolons, then parse the first statement's expression with a `Pf_stmt`
// frame, which then decides — a following `;` makes it an
// expression-statement (lowering to a `let_` with an unused binder, the
// rest of the block as its body) and anything else makes it the block's
// final expression.
fn do_pblock(ts: Toks, sc: Scope, k: Pk, fuel: I32, nt: Ntab) -> Pstate | Pres {
  pgo(mk_pstate(c_pexpr(skip_semis(ts), sc), pk_push(mk_stmt(sc), k), fuel, nt))
}

// =====================================================================
// One machine transition — the host `loop` body
// =====================================================================
fn ptransition(
  , resolve_host_type: String -> Host_type | String
  , bool_type: Host_type | String
  , s: Pstate
  ) -> Pstate | Pres {
  match! un_pstate(s) {
    .(c: Pctl, k: Pk, fuel: I32, nt: Ntab) {
      if! leq_i32(fuel, 0(I32)) {
        phalt(p_err(mk_perr(
          , "parser step budget exhausted — the declaration body is unreasonably "
            "large, or the image is malformed in a way that stalls the parse"(String)
          , widen_sum!((), . | I32)
          )))
      } else {
        let fuel1 = sub_i32(fuel, 1(I32));
        match! un_pctl(c) {
          (
            , .(bl: Pc_block) {
                match! Pc_block.get(bl) {
                  .(ts: Toks, sc: Scope) { do_pblock(ts, sc, k, fuel1, nt) }
                }
              }
            , .(ev: Pc_expr) {
                match! Pc_expr.get(ev) {
                  .(ts: Toks, sc: Scope) { do_pexpr(resolve_host_type, ts, sc, k, fuel1, nt) }
                }
              }
            , .(yv: Pc_yield) {
                match! Pc_yield.get(yv) {
                  .(v: Term, ts: Toks) { do_pyield(bool_type, v, ts, k, fuel1, nt) }
                }
              }
            )
        }
      }
    }
  }
}

// =====================================================================
// parse — the entry points
// =====================================================================
/// The default parser step budget — generous for any image a test drives,
/// while still bounding a malformed run.
pub fn parse_fuel_default() -> I32 { 1000000(I32) }

/// Parses one Kio' term expression (a token list) into the erased de
/// Bruijn `Term`, resolving free names against the initial scope and
/// erasing qualified newtype constructor / projector calls against `nt`,
/// resolving literal annotations to exact host-type descriptors, and attaching
/// the declaring module's exact Boolean descriptor to conditional nodes, under
/// an explicit step budget. The CEK machine is driven by the host `loop`.
pub fn parse_toks_scope_ntab_fuel(
  , ts: Toks
  , sc: Scope
  , nt: Ntab
  , resolve_host_type: String -> Host_type | String
  , bool_type: Host_type | String
  , fuel: I32
  ) -> Pres {
  loop(
    , .(s: Pstate) { ptransition(resolve_host_type, bool_type, s) }
    , mk_pstate(c_pblock(ts, sc), pk_nil(), fuel, nt)
    )
}

/// Parses one Kio' term expression with exact host-type dependencies supplied
/// by the validated declaring-module context.
pub fn parse_toks_scope_ntab(
  , ts: Toks
  , sc: Scope
  , nt: Ntab
  , resolve_host_type: String -> Host_type | String
  , bool_type: Host_type | String
  ) -> Pres {
  parse_toks_scope_ntab_fuel(ts, sc, nt, resolve_host_type, bool_type, parse_fuel_default())
}

/// Parses one Kio' term expression with free names resolved against `sc`
/// (no declared newtypes — the empty newtype table), under an explicit
/// step budget.
pub fn parse_toks_scope_fuel(
  , ts: Toks
  , sc: Scope
  , resolve_host_type: String -> Host_type | String
  , bool_type: Host_type | String
  , fuel: I32
  ) -> Pres { parse_toks_scope_ntab_fuel(ts, sc, ntab_nil(), resolve_host_type, bool_type, fuel) }

/// Parses one Kio' term expression with free names resolved against `sc`
/// (no declared newtypes).
pub fn parse_toks_scope(
  , ts: Toks
  , sc: Scope
  , resolve_host_type: String -> Host_type | String
  , bool_type: Host_type | String
  ) -> Pres { parse_toks_scope_ntab(ts, sc, ntab_nil(), resolve_host_type, bool_type) }

/// Parses one closed Kio' term expression (no free names) from a token list.
pub fn parse_toks(
  , ts: Toks
  , resolve_host_type: String -> Host_type | String
  , bool_type: Host_type | String
  ) -> Pres { parse_toks_scope(ts, scope_nil(), resolve_host_type, bool_type) }

/// Parses one closed Kio' term expression from source text: lex, then parse.
/// A lexical error surfaces as the parse-error arm.
pub fn parse_str(
  , src: String
  , resolve_host_type: String -> Host_type | String
  , bool_type: Host_type | String
  ) -> Pres {
  match! lex(src) {
    (
      , .(ts: Toks) { parse_toks(ts, resolve_host_type, bool_type) }
      , .(e: Lex_err) { p_err(mk_perr(lex_err_message(e), widen_sum!(lex_err_pos(e), . | I32))) }
      )
  }
}

// =====================================================================
// Host-free algebra laws (`equiv`)
// =====================================================================
//
// `kio test` discharges these by partial evaluation. The parser proper
// folds the host `loop` and string primitives, which the partial
// evaluator leaves opaque, so end-to-end parsing is exercised by the
// differential runner rather than here — exactly as `eval.kio`'s
// `prime_eval` is. What `equiv` *can* pin is the parser's host-free data
// algebra: the binder scope, the argument-list target tags, the parse
// result, and the positional argument accessors. These reduce to a Kio'
// normal form and fix the structures the machine threads.

// --- Scope (the binder environment) ---

// `un_scope(scope_push(n, s))` recovers the non-empty arm: a one-spelling
// frame.
equiv un_scope_push(n: String, s: Scope) {
  un_scope(scope_push(n, s));
  widen_sum!((pnl_one(n), s), . | (Pnl & Scope))
}

// `un_scope(scope_push_names(ns_, s))` recovers the pushed spelling list.
equiv un_scope_push_names(ns_: Pnl, s: Scope) {
  un_scope(scope_push_names(ns_, s));
  widen_sum!((ns_, s), . | (Pnl & Scope))
}

// `un_scope(scope_nil())` recovers the empty arm.
equiv un_scope_nil() {
  un_scope(scope_nil());
  widen_sum!((), . | (Pnl & Scope))
}

// --- Pnl (the name list) ---
equiv un_pnl_cons_head(n: String, p: Pnl) {
  match! un_pnl(pnl_cons(n, p)) {
    (.(h: String, _t: Pnl) { h }, .(_e: .) { ""(String) })
  };
  n
}

equiv un_pnl_cons_tail(n: String, p: Pnl) {
  match! un_pnl(pnl_cons(n, p)) {
    (.(_h: String, t: Pnl) { Pnl.get(t) }, .(_e: .) { nil(String, ()) })
  };
  Pnl.get(p)
}

equiv un_pnl_nil() {
  un_pnl(pnl_nil());
  widen_sum!((), . | (String & Pnl))
}

// --- Nt_info (a newtype's erasure facts) ---
//
// Each accessor recovers its component of the entry.
equiv nt_arity_round(a: I32, e: I32, c: String, p: String) {
  nt_arity(mk_nt_info(a, e, c, p));
  a
}

equiv nt_existential_round(a: I32, e: I32, c: String, p: String) {
  nt_existential(mk_nt_info(a, e, c, p));
  if! leq_i32(1(I32), e) {
    .t(Bool)
  } else {
    .f(Bool)
  }
}

equiv nt_ctor_round(a: I32, e: I32, c: String, p: String) {
  nt_ctor(mk_nt_info(a, e, c, p));
  c
}

equiv nt_proj_round(a: I32, e: I32, c: String, p: String) {
  nt_proj(mk_nt_info(a, e, c, p));
  p
}

// --- Ntab (the resolving-module declaration table) ---
//
// `un_ntab(ntab_cons(n, i, t))` recovers a newtype entry with both member
// gates open; `un_ntab(ntab_nil())` recovers the empty arm. `ntab_lookup` itself folds the
// host `loop` (opaque to the partial evaluator), so the table's host-free
// algebra is what `equiv` pins — exactly as the binder scope (`scope_index`
// folds `loop` and carries no law either); lookup behaviour is
// exercised end to end by the differential runner.
equiv un_ntab_cons(n: String, i: Nt_info, t: Ntab) {
  un_ntab(ntab_cons(n, i, t));
  widen_sum!((n, (mk_nt_entry(i, .t(Bool), .t(Bool)), t)), . | (String & Nt_entry & Ntab))
}

equiv un_ntab_nil() {
  un_ntab(ntab_nil());
  widen_sum!((), . | (String & Nt_entry & Ntab))
}

// --- Tg (argument-list target tags) ---
//
// One law per payload shape: the apply target carries a `Term` and the
// intrinsic targets are nullary — a representative of each payload shape
// pins the constructor / projector pairing.
equiv un_tg_app(t: Term) {
  un_tg(tg_app(t));
  widen_sum!({tg_app = t}, Tg_shape)
}

equiv un_tg_pair() {
  un_tg(tg_pair());
  widen_sum!({tg_pair=}, Tg_shape)
}

equiv un_tg_ite() {
  un_tg(tg_ite());
  widen_sum!({tg_ite=}, Tg_shape)
}

// --- Pres (the parse outcome) and Perr (the error payload) ---
equiv un_p_ok(t: Term) {
  p_ok(t);
  widen_sum!({p_ok = t}, P_ok | P_err)
}

equiv un_p_err(e: Perr) {
  p_err(e);
  widen_sum!({p_err = e}, P_ok | P_err)
}

// One law per position arm — an opaque `. | I32` parameter would need a
// sum-eta step the normalizer does not take.
equiv perr_message_at(m: String, i: I32) {
  perr_message(mk_perr(m, widen_sum!(i, . | I32)));
  m
}

equiv perr_message_nopos(m: String) {
  perr_message(mk_perr(m, widen_sum!((), . | I32)));
  m
}

equiv perr_pos_at(m: String, i: I32) {
  perr_pos(mk_perr(m, widen_sum!(i, . | I32)));
  widen_sum!(i, . | I32)
}

equiv perr_pos_nopos(m: String) {
  perr_pos(mk_perr(m, widen_sum!((), . | I32)));
  widen_sum!((), . | I32)
}

// --- positional argument accessors over a concrete term list ---
//
// `arg0` / `arg1` / `arg2` read the first three terms of an in-order
// argument list; these fold no host call, so a fixed three-element list
// reduces to a normal form. The list `[unit, a, b]` pins each accessor.
equiv arg0_three(a: Term, b: Term) {
  arg0(tcons(unit(), tcons(a, tcons(b, tnil()))));
  unit()
}

equiv arg1_three(a: Term, b: Term) {
  arg1(tcons(unit(), tcons(a, tcons(b, tnil()))));
  a
}

equiv arg2_three(a: Term, b: Term) {
  arg2(tcons(unit(), tcons(a, tcons(b, tnil()))));
  b
}
