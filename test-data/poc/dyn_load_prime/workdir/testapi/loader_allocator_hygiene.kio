fn probe_image() -> String {
  "module allocator_probe;\n\nimport hostapi(Zzcps_r);\n\npub newtype "
  "Outer[Zzcps_r][Zzcps_rx] <U> : (Zzcps_r & Zzcps_rx) & U {\n  constructor "
  "mk_outer;\n  pub projector un_outer;\n  };\n\npub newtype Free <U> : Zzcps_r "
  "& U {\n  constructor mk_free;\n  pub projector un_free;\n  };\n\npackage "
  "allocator_probe_pkg;\n\nbridge { allocator_probe; hostapi; }\n\nmodule "
  "hostapi;\n\nhost type Zzcps_r;\n"(String)
}

// An unused private alias whose target cannot be resolved is outside the
// loader's documented validation boundary. The valid identity alias beside it
// exercises the same discovery pass through a qualified provider import.
fn unused_malformed_alias_image() -> String {
  "module alias_probe;\n\nimport provider as p;\n\ntype Bad = missing.Missing;\n"
  "type Good = p.Good;\n\npub fn ok() -> . { () }\n\npackage alias_probe_pkg;\n\n"
  "bridge { alias_probe; provider; }\n\nmodule provider;\n\npub newtype Good : "
  ". { pub constructor make; pub projector open; };\n"(String)
}

// Selecting the malformed alias as a callable member head is different: body
// parsing needs a concrete terminal nominal and must reject the image.
fn used_malformed_alias_image() -> String {
  "module alias_probe;\n\ntype Bad = missing.Missing;\n\npub fn broken() -> . { "
  "Bad.make(()) }\n\npackage alias_probe_pkg;\n\nbridge { alias_probe; }\n"(String)
}

// The declarations are written in legal lexical order. Resolving the final
// alias still crosses every preceding identity-only edge.
