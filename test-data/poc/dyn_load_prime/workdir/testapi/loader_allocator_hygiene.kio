module testapi/loader_allocator_hygiene;

import loader(Export_info, Export_infos, export_info_name, export_info_sig);
import loader(Lr_diag, Lr_image, diag_bare_message, diag_message, image_exports);
import loader(un_export_infos, un_load_outcome);
import loader/scan(load_package);
import macros/control(macro if);
import macros/match(macro match);
import testapi(Bool, String);
import testapi/text(string_concat, string_eq);

fn probe_image() -> String {
  "module allocator_probe;\n\nimport hostapi(Zzcps_r);\n\npub type { "
  "Outer[Zzcps_r][Zzcps_rx] <U> : (Zzcps_r & Zzcps_rx) & U {\n  mk;\n  pub "
  "get;\n  }; };\n\npub type { Free <U> : Zzcps_r & U {\n  mk;\n  pub get;\n  }; "
  "};\n\npackage allocator_probe_pkg;\n\nbridge { allocator_probe; hostapi; }\n\n"
  "module hostapi;\n\nhost type Zzcps_r;\n"[String]
}

// An unused private alias whose target cannot be resolved is outside the
// loader's documented validation boundary. The valid identity alias beside it
// exercises the same discovery pass through a qualified provider import.
fn unused_malformed_alias_image() -> String {
  "module alias_probe;\n\nimport provider as p;\n\ntype Bad = missing.Missing;\n"
  "type Good = p.Good;\n\npub fn ok() -> . { () }\n\npackage alias_probe_pkg;\n\n"
  "bridge { alias_probe; provider; }\n\nmodule provider;\n\npub type { Good : . "
  "{ pub mk; pub get; }; };\n"[String]
}

// Selecting the malformed alias as a callable member head is different: body
// parsing needs a concrete terminal nominal and must reject the image.
fn used_malformed_alias_image() -> String {
  "module alias_probe;\n\ntype Bad = missing.Missing;\n\npub fn broken() -> . { "
  "Bad.mk(()) }\n\npackage alias_probe_pkg;\n\nbridge { alias_probe; }\n"[String]
}

// The declarations are written in legal lexical order. Resolving the final
// alias still crosses every preceding identity-only edge.
fn long_identity_alias_chain_image() -> String {
  "module alias_chain;\n\nimport provider as p;\n\ntype Forward0 = p.Terminal;\n"
  "type Forward1 = Forward0;\ntype Forward2 = Forward1;\ntype Forward3 = "
  "Forward2;\ntype Forward4 = Forward3;\ntype Forward5 = Forward4;\ntype "
  "Forward6 = Forward5;\ntype Forward7 = Forward6;\ntype Forward8 = Forward7;\n"
  "type Forward9 = Forward8;\ntype Forward10 = Forward9;\ntype Forward11 = "
  "Forward10;\ntype Forward12 = Forward11;\ntype Forward13 = Forward12;\ntype "
  "Forward14 = Forward13;\ntype Forward15 = Forward14;\ntype Forward16 = "
  "Forward15;\ntype Forward17 = Forward16;\ntype Forward18 = Forward17;\ntype "
  "Forward19 = Forward18;\ntype Forward20 = Forward19;\ntype Forward21 = "
  "Forward20;\ntype Forward22 = Forward21;\ntype Forward23 = Forward22;\ntype "
  "Forward24 = Forward23;\ntype Forward25 = Forward24;\ntype Forward26 = "
  "Forward25;\ntype Forward27 = Forward26;\ntype Forward28 = Forward27;\ntype "
  "Forward29 = Forward28;\ntype Forward30 = Forward29;\ntype Forward31 = "
  "Forward30;\ntype Forward32 = Forward31;\ntype Forward33 = Forward32;\ntype "
  "Forward34 = Forward33;\ntype Forward35 = Forward34;\ntype Forward36 = "
  "Forward35;\ntype Forward37 = Forward36;\ntype Forward38 = Forward37;\ntype "
  "Forward39 = Forward38;\ntype Forward40 = Forward39;\ntype Forward41 = "
  "Forward40;\ntype Forward42 = Forward41;\ntype Forward43 = Forward42;\ntype "
  "Forward44 = Forward43;\ntype Forward45 = Forward44;\ntype Forward46 = "
  "Forward45;\ntype Forward47 = Forward46;\ntype Forward48 = Forward47;\ntype "
  "Forward49 = Forward48;\ntype Forward50 = Forward49;\ntype Forward51 = "
  "Forward50;\ntype Forward52 = Forward51;\ntype Forward53 = Forward52;\ntype "
  "Forward54 = Forward53;\ntype Forward55 = Forward54;\ntype Forward56 = "
  "Forward55;\ntype Forward57 = Forward56;\ntype Forward58 = Forward57;\ntype "
  "Forward59 = Forward58;\ntype Forward60 = Forward59;\ntype Forward61 = "
  "Forward60;\ntype Forward62 = Forward61;\ntype Forward63 = Forward62;\n\npub "
  "fn run() -> . { Forward63.mk(()) }\n\npackage alias_chain_pkg;\n\nbridge { "
  "alias_chain; provider; }\n\nmodule provider;\n\npub type { Terminal : . { "
  "pub mk; pub get; }; };\n"[String]
}

