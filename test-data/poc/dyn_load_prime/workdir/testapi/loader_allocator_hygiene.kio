fn export_line(entry: Export_info) -> String {
  string_concat(
  , export_info_name(entry)
  , string_concat(" : "[String], string_concat(export_info_sig(entry), "\n"[String]))
  )
}

fn expected_exports() -> String {
  "allocator_probe.Outer.get : [#0] [#1] (n{allocator_probe.Outer}(#0, #1)) "
  "-> [#2] ([#3] (((#0 & #1) & #3) -> #2)) -> #2\nallocator_probe.Free.get : "
  "(n{allocator_probe.Free}) -> [#0] ([#1] ((h{hostapi.Zzcps_r} & #1) -> "
  "#0)) -> #0\n"[String]
}

fn mismatch(actual: String) -> String {
  string_concat("loader export signature mismatch:\n"[String], actual)
}

fn inspect_exports(exports: Export_infos) -> String {
  match(un_export_infos(exports)) {
    (
    , .(outer: Export_info, after_outer: Export_infos) {
        match(un_export_infos(after_outer)) {
          (
          , .(free: Export_info, after_free: Export_infos) {
              match(un_export_infos(after_free)) {
                (
                , .(extra: Export_info, _rest: Export_infos) {
                    mismatch(string_concat(
                    , export_line(outer)
                    , string_concat(export_line(free), export_line(extra))
                    ))
                  }
                , .(_empty: .) {
                    let actual = string_concat(export_line(outer), export_line(free));
                    if(string_eq(actual, expected_exports())) {
                      ""[String]
                    } else {
                      mismatch(actual)
                    }
                  }
                )
              }
            }
          , .(_empty: .) { mismatch(export_line(outer)) }
          )
        }
      }
    , .(_empty: .) { mismatch("no exports\n"[String]) }
    )
  }
}

fn macro_import_image(selector: String) -> String {
  string_concat(
  , "module macro_import_probe;\n\nimport provider("[String]
  , string_concat(
    , selector
    , ");\n\npub fn run() -> . { call() }\n\npackage macro_import_probe_pkg;\n\n"
      "bridge { macro_import_probe; provider; }\n\nmodule provider;\n\npub fn "
      "macro() -> . { () }\npub fn choose() -> . { () }\n"[String]
    )
  )
}

fn ordinary_import_image(selector: String) -> String {
  string_concat(
  , "module ordinary_import_probe;\nimport provider("[String]
  , string_concat(
    , selector
    , ");\npub fn run() -> . { () }\npackage ordinary_import_probe_pkg;\nbridge { "
      "ordinary_import_probe; provider; }\nmodule provider;\npub fn choose() -> . "
      "{ () }\n"[String]
    )
  )
}

fn ordinary_import_boundary_report() -> String {
  string_concat(
  , expect_loaded(
    , ordinary_import_image("choose"[String])
    , "loader rejected an ordinary identifier import"[String]
    )
  , expect_rejected(
    , ordinary_import_image("{choose}"[String])
    , "loader accepted a braced import selector"[String]
    )
  )
}

fn macro_import_boundary_report() -> String {
  let ordinary =
    expect_loaded(
    , macro_import_image("macro as call"[String])
    , "loader rejected an ordinary import whose name is macro"[String]
    );
  if(string_eq(ordinary, ""[String])) {
    match(un_load_outcome(load_package(macro_import_image("macro choose as call"[String])))) {
      (
      , .(_loaded: Lr_image) { "loader accepted a surface macro import tag\n"[String] }
      , .(diagnostic: Lr_diag) {
          let actual = diag_bare_message(Lr_diag.get(diagnostic));
          if(string_eq(
          , actual
          , "dyn_load_prime: malformed image — expected comma or closing parenthesis "
            "in import list at line 3, column 23"[String]
          )) {
            ""[String]
          } else {
            string_concat(
            , "loader macro import rejection: "[String]
            , string_concat(actual, "\n"[String])
            )
          }
        }
      )
    }
  } else {
    ordinary
  }
}

fn existing_loader_hygiene_report() -> String {
  match(un_load_outcome(load_package(probe_image()))) {
    (
    , .(image: Lr_image) {
        let allocator_report = inspect_exports(image_exports(Lr_image.get(image)));
        if(string_eq(allocator_report, ""[String])) {
          match(un_load_outcome(load_package(unused_malformed_alias_image()))) {
            (
            , .(_unused_ok: Lr_image) {
                match(un_load_outcome(load_package(used_malformed_alias_image()))) {
                  (
                  , .(_used_wrongly_loaded: Lr_image) {
                      "loader accepted a member use through an unresolved alias\n"[String]
                    }
                  , .(_used_rejected: Lr_diag) {
                      let value_origins = value_binding_origin_report();
                      if(string_eq(value_origins, ""[String])) {
                        let macro_imports = macro_import_boundary_report();
                        if(string_eq(macro_imports, ""[String])) {
                          identity_alias_catalog_report()
                        } else {
                          macro_imports
                        }
                      } else {
                        value_origins
                      }
                    }
                  )
                }
              }
            , .(diagnostic: Lr_diag) {
                string_concat(
                , "loader rejected an unused private malformed alias: "[String]
                , string_concat(diag_message(Lr_diag.get(diagnostic)), "\n"[String])
                )
              }
            )
          }
        } else {
          allocator_report
        }
      }
    , .(diagnostic: Lr_diag) {
        string_concat(
        , "loader allocator probe failed to load: "[String]
        , string_concat(diag_message(Lr_diag.get(diagnostic)), "\n"[String])
        )
      }
    )
  }
}

// Exercise the emitted nominal grammar through the public loading boundary.
fn nominal_grammar_image(declarations: String) -> String {
  string_concat(
  , "module nominal_grammar;\n"[String]
  , string_concat(
    , declarations
    , "\npub fn run() -> . { () }\npackage nominal_grammar_probe;\nbridge { "
      "nominal_grammar; }\n"[String]
    )
  )
}

fn nominal_grammar_report() -> String {
  let accepted =
    expect_loaded(
    , nominal_grammar_image("type Plain = .;\ntype { Empty: . { mk; get } }\ntype { ; Box[A]<U>: A & U "
                            "{ ;; get;;; mk;; }; };\npub(nominal_grammar) type { Scoped: . { "
                            "pub(nominal_grammar) get; mk; }; }\nrec type { Chain[A]: . | (A & "
                            "Chain[A]) { mk; get; }; }\nrec { type Alias = Node; type { Node: . | "
                            "Alias { get; mk; }; }; }\n"[String])
    , "loader rejected explicit nominal grammar"[String]
    );
  let report0 =
    string_concat(
    , accepted
    , expect_rejected(
      , nominal_grammar_image("type {}"[String])
      , "loader accepted an empty nominal block"[String]
      )
    );
  let report1 =
    string_concat(
    , report0
    , expect_rejected(
      , nominal_grammar_image("type { N: .; } type { Next: . { mk; get; }; }"[String])
      , "loader accepted an omitted member body before another declaration"[String]
      )
    );
  let report2 =
    string_concat(
    , report1
    , expect_rejected(
      , nominal_grammar_image("type { N: . { mk; get; }; M: . { mk; get; }; }"[String])
      , "loader accepted multiple nominal entries"[String]
      )
    );
  let report3 =
    string_concat(
    , report2
    , expect_rejected(
      , nominal_grammar_image("type { ;; N: . { mk; get; }; }"[String])
      , "loader accepted repeated leading entry separators"[String]
      )
    );
  let report4 =
    string_concat(
    , report3
    , expect_rejected(
      , nominal_grammar_image("type { N: . { mk; get; };; }"[String])
      , "loader accepted repeated trailing entry separators"[String]
      )
    );
  let report5 =
    string_concat(
    , report4
    , expect_rejected(
      , nominal_grammar_image("type { N: . { mk; get; }; };;"[String])
      , "loader accepted repeated declaration suffix separators"[String]
      )
    );
  let report6 =
    string_concat(
    , report5
    , expect_rejected(
      , nominal_grammar_image("type { N: . { mk; }; }"[String])
      , "loader accepted a missing get role"[String]
      )
    );
  let report7 =
    string_concat(
    , report6
    , expect_rejected(
      , nominal_grammar_image("type { N: . { get; }; }"[String])
      , "loader accepted a missing mk role"[String]
      )
    );
  let report8 =
    string_concat(
    , report7
    , expect_rejected(
      , nominal_grammar_image("type { N: . { mk; mk; }; }"[String])
      , "loader accepted duplicate mk roles"[String]
      )
    );
  let report9 =
    string_concat(
    , report8
    , expect_rejected(
      , nominal_grammar_image("type { N: . { get; get; }; }"[String])
      , "loader accepted duplicate get roles"[String]
      )
    );
  let report10 =
    string_concat(
    , report9
    , expect_rejected(
      , nominal_grammar_image("type { N: . { mk get; }; }"[String])
      , "loader accepted a missing member separator"[String]
      )
    );
  let report11 =
    string_concat(
    , report10
    , expect_rejected(
      , nominal_grammar_image("type { N: . { mk custom; get; }; }"[String])
      , "loader accepted a custom member name"[String]
      )
    );
  let report13 =
    string_concat(
    , report11
    , expect_rejected(
      , nominal_grammar_image("type { N: . { mk() { () }; get; }; }"[String])
      , "loader accepted an executable member body"[String]
      )
    );
  let report14 =
    string_concat(
    , report13
    , expect_rejected(
      , nominal_grammar_image("type { N: { mk; get; }; }"[String])
      , "loader accepted a missing payload"[String]
      )
    );
  let report15 =
    string_concat(
    , report14
    , expect_rejected(
      , nominal_grammar_image("rec type Alias = .;"[String])
      , "loader accepted a recursive alias singleton"[String]
      )
    );
  let report16 =
    string_concat(
    , report15
    , expect_rejected(
      , nominal_grammar_image("rec { type { N: . { mk; get; }; }; }"[String])
      , "loader accepted a singleton mutual group"[String]
      )
    );
  let report18 =
    string_concat(
    , report16
    , expect_rejected(
      , nominal_grammar_image("type { N: . { pub(unrelated) mk; get; }; }"[String])
      , "loader accepted an unrelated scoped member visibility"[String]
      )
    );
  report18
}

pub(testapi) fn loader_allocator_hygiene_report() -> String {
  let grammar = string_concat(nominal_grammar_report(), ordinary_import_boundary_report());
  if(string_eq(grammar, ""[String])) { existing_loader_hygiene_report() } else { grammar }
}
