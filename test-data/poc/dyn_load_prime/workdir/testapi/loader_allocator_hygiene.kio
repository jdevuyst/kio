  "module alias_chain;\n\nimport provider as p;\n\ntype Forward0 = p.Terminal;\n"
  "type Forward1 = Forward0;\ntype Forward2 = Forward1;\ntype Forward3 = "
  "Forward2;\ntype Forward4 = Forward3;\ntype Forward5 = Forward4;\ntype "
  "Forward6 = Forward5;\ntype Forward7 = Forward6;\ntype Forward8 = Forward7;\n"
  "type Forward9 = Forward8;\ntype Forward10 = Forward9;\ntype Forward11 = "
  "Forward10;\ntype Forward12 = Forward11;\ntype Forward13 = Forward12;\ntype "
  "Forward14 = Forward13;\ntype Forward15 = Forward14;\ntype Forward16 = "
  "Forward15;\ntype Forward17 = Forward16;\ntype Forward18 = Forward17;\ntype "
  "Forward19 = Forward18;\ntype Forward20 = Forward19;\ntype Forward21 = "
  "Forward20;\ntype Forward22 = Forward21;\ntype Forward23 = Forward22;\ntype "
  "Forward24 = Forward23;\ntype Forward25 = Forward24;\ntype Forward26 = "
  "Forward25;\ntype Forward27 = Forward26;\ntype Forward28 = Forward27;\ntype "
  "Forward29 = Forward28;\ntype Forward30 = Forward29;\ntype Forward31 = "
  "Forward30;\ntype Forward32 = Forward31;\ntype Forward33 = Forward32;\ntype "
  "Forward34 = Forward33;\ntype Forward35 = Forward34;\ntype Forward36 = "
  "Forward35;\ntype Forward37 = Forward36;\ntype Forward38 = Forward37;\ntype "
  "Forward39 = Forward38;\ntype Forward40 = Forward39;\ntype Forward41 = "
  "Forward40;\ntype Forward42 = Forward41;\ntype Forward43 = Forward42;\ntype "
  "Forward44 = Forward43;\ntype Forward45 = Forward44;\ntype Forward46 = "
  "Forward45;\ntype Forward47 = Forward46;\ntype Forward48 = Forward47;\ntype "
