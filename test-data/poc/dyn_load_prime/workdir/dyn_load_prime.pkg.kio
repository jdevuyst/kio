package dyn_load_prime;

build {
  cache "out/.kio-cache/";

  docs {
    md ".";
    md_out "out/docs-md/";
    html "out/docs/"
  };

  target js {
    out "out/js/";
    baseline es2020
  };

  target ts {
    out "out/ts/";
    baseline v5_0
  };

  target python {
    out "out/python/";
    baseline v3_10
  };

  target java {
    out "out/java/";
    baseline v21
  };

  target rust {
    out "out/rust/";
    baseline v1_85
  };

  target go {
    out "out/go/";
    baseline v1_26
  };

  target swift {
    out "out/swift/";
    baseline v6_0
  };

  target haskell {
    out "out/haskell/";
    baseline ghc9_10
  }
}

bridge {
  list/core;
  testapi;
  testapi/**;
  prime;
  host_descriptor;
  value;
  result;
  marshal;
  eval;
  hostrec;
  imageio;
  token;
  chars;
  lex;
  parse;
  loader;
  defaults;
  loader/scan;
  elab/elaborator_util;
  elab/match;
  elab/spine_elaborators
}
