package queue;

build {
  cache "out/.kio-cache/";

  docs {
    md ".";
    md_out "out/docs-md/";
    html "out/docs/"
  };

  target js {
    out "out/js/"
  };

  target ts {
    out "out/ts/"
  };

  target python {
    out "out/python/"
  };

  target java {
    out "out/java/"
  };

  target rust {
    out "out/rust/"
  };

  target go {
    out "out/go/"
  };

  target swift {
    out "out/swift/"
  };

  target haskell {
    out "out/haskell/"
  }
}

bridge {
  core;
  queue;
  elab/testapi;
  list/core;
  list/elab/testapi
}
