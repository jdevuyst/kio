bimap(inc, shout, err) = err(boom!)
bind(ok, checked_inc) = ok(42)
bind(err, checked_inc) = err(boom)
apply(ok(inc), ok(41)) = ok(42)
or_else(err, ok(7)) = ok(7)
unwrap_or(0, err) = 0
unwrap_or(0, ok) = 41
unwrap_err_or(none, ok) = none
swap(ok(41)) = err(41)
swap(err(boom)) = ok(boom)
