package elab;

build {
  cache "out/.kio-cache/";

  docs {
    md ".";
    md_out "out/docs-md/";
    html "out/docs/"
  };

  target js {
    out "out/js/"
  };

  target ts {
    out "out/ts/"
  };

  target python {
    out "out/python/"
  };

  target java {
    out "out/java/"
  };

  target rust {
    out "out/rust/"
  };

  target go {
    out "out/go/"
  };

  target swift {
    out "out/swift/"
  };

  target haskell {
    out "out/haskell/"
  }
}

bridge {
  testapi;
  elaborator_util;
  type_of;
  tuple_elaborators;
  spine_elaborators;
  row_elaborators;
  algebraic_elaborators;
  derive;
  match;
  control;
  sequence;
  lookup;
  show
}
