sig app v(3);

v(1) {
  with {
    mod api {
      rec {
        pub type { A: A | B { pub mk; pub get } };
        pub type { B: B | A { pub mk; pub get } }
      }
    }
  };
  nonbreaking {
    add {
      api.A;
      api.B
    }
  }
}

v(2) {
  with {
    mod api {
      rec {
        pub type { A: (A | B) | . { pub mk; pub get } };
        pub type { B: B | A { pub mk; pub get } }
      }
    }
  };
  breaking {
    modify {
      api.A;
      mod api {
        pub type { A: (A | B) | . { pub mk; pub get } }
      }
    }
  }
}
