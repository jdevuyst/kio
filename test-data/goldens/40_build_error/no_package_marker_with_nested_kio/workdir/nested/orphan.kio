module orphan_nested/junk;

// Deliberately ill-formed to expose the bug: were `kio build` to
// recurse into this subdirectory (because the root has no build
// file and no package file), it would fail at the parse-error tier
// (exit 11). The fix bails at the build-error tier (exit 40)
// before the recursion happens.
fn brk() -> . { this is not valid kio }
