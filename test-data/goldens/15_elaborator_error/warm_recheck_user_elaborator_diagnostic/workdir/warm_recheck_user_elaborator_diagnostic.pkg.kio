package warm_recheck_user_elaborator_diagnostic;

build {
  cache "out/.kio-cache/";

  target js {
    out "out/js/";
    baseline es2020
  };

  target ts {
    out "out/ts/";
    baseline v5_0
  }
}

bridge {
  warm_recheck_user_elaborator_diagnostic;
  warm_recheck_user_elaborator_diagnostic/**;
  elaborators
}
