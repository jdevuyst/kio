module dnr/main;

import elab/derive(derive);

pub newtype Box[A] : A { pub constructor mk_box; pub projector un_box }

pub newtype List[A] : A { pub constructor mk_list; pub projector un_list }

pub newtype Monad[*F] : [A][B] (F(A) & (A -> F(B))) -> F(B) {
  pub constructor mk_monad;
  pub projector bind
  }

fn box_monad() -> Monad(Box) { Monad.mk_monad(.[A][B](m, k) { k(Box.un_box(m)) }) }

// The goal is `Monad(List)` but the only candidate produces
// `Monad(Box)` — no rule unifies with the goal, so resolution finds
// zero derivations (the `derive_no_rule_applies` condition).
fn bad() -> Monad(List) { derive!(box_monad, Monad(List)) }

pub fn main() -> . { () }
