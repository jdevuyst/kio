module dnd/main;

import elab/derive(derive);

pub newtype Box[A] : A { pub constructor mk_box; pub projector un_box }

pub newtype Monad[*F] : [A][B] (F(A) & (A -> F(B))) -> F(B) {
  pub constructor mk_monad;
  pub projector bind
  }

fn box_monad() -> Monad(Box) { Monad.mk_monad(.[A][B](m, k) { k(Box.un_box(m)) }) }

// A non-decreasing rule: its precondition `Monad(Box)` is *equal to*
// its result `Monad(Box)`, not a strict structural sub-term. Such a
// self-feeding rule would let resolution loop, so it is rejected at
// the `derive!` site (the `derive_rule_not_decreasing` condition).
fn looping(inner: Monad(Box)) -> Monad(Box) { inner }

fn bad() -> Monad(Box) { derive!((looping, box_monad), Monad(Box)) }

pub fn main() -> . { () }
