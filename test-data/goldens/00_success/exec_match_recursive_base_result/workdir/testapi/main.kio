mod testapi/main;

import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type I32; type String }
import testapi/io { fn print }
import testapi/iter { fn loop }

type Step = { More: . } | { Done: . };

fn done_step() -> Step { (Done.mk(()).>widen_sum)[Step] }

rec(loop) fn optional(step: Step) -> I32 | . {
  match(step) {
    (.(_more: More) { recur optional(done_step()) }, .(_done: Done) { widen_sum(()) })
  }
}

type Found = { Value: I32 } | { Absent: . };

fn not_found() -> Found { (Absent.mk(()).>widen_sum)[Found] }

rec(loop) fn find(step: Step) -> Found {
  match(step) {
    (.(_done: Done) -> _ { not_found() }, .(_more: More) { recur find(done_step()) })
  }
}

fn report_optional(value: I32 | .) {
  match(value) {
    (.(_number: I32) { print("unexpected optional\n") }, .(_empty: .) { print("widen base\n") })
  }
}

fn report_found(value: Found) {
  match(value) {
    (
    , .(_value: Value) { print("unexpected found\n") }
    , .(_absent: Absent) { print("ordinary base\n") }
    )
  }
}

pub fn main() { report_optional(optional(done_step())); report_found(find(done_step())) }
