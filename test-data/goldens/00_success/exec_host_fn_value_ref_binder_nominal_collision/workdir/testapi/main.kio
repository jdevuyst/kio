mod testapi/main;

import testapi { type Box; type I32 }
import testapi/arith { fn box_get; fn box_make }
import testapi/fmt { fn i32_to_string }
import testapi/io { fn print }

type { T: I32 { mk; get } }

fn make_box(make: [A] A -> Box[A], value: I32) -> Box[I32] { make(value) }

pub fn main() { let boxed = make_box(box_make, 9); print(i32_to_string(box_get(boxed))) }
