module testapi/main;

import __comptime__;
import testapi(I32, String);
import testapi/fmt(print_i32);
import testapi/io(print);

pure fn keep_impl(_ct: __Comptime__, _source: __Type__, value: __Checked_term__, _marker: __Type__) -> __Checked_term__ {
  value
}

macro keep : [Source] Source -> [Marker] Source { impl keep_impl }

pure fn marked_impl(
, _ct: __Comptime__
, fills: __Fill_ctx__
, _source: __Type__
, value: __Checked_term__
, _marker: __Type__
) -> __Checked_term__ & __Fill_ctx__ { (value, fills) }

macro marked : [Source] Source -> [Marker] Source { impl(fills) marked_impl }

fn ordinary[Source](value: Source)[Marker] -> Source { value }

fn late(value: I32) -> [Marker] I32 { keep(value) }

fn early(value: I32) -> [Marker] I32 { marked(value) }

fn normal(value: I32) -> [Marker] I32 { ordinary(value) }

pub fn main() {
  print_i32(late(7)[String]);
  print_i32(early(8)[String]);
  print_i32(normal(9)[String]);
  print("\n")
}
