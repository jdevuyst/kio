module testapi/main;

import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(String);
import testapi/io as io;

labels { first: String, second: String, tag: . };

fn typed(input: First | Second) -> String {
  match! input {
    .(_all: .) { "typed\n" }
  }
}

fn fallback(input: First | Second) -> String {
  match! input {
    .(_first: First) { "first\n" };
    .() { "fallback\n" }
  }
}

fn overlap(input: First | Second) -> String {
  match! input {
    .(_first: First) { "narrow\n" };
    .(_rest: First | Second) { "wide\n" }
  }
}

fn named(_all: .) -> String { "named\n" }

fn produce() -> First { io.print("source\n"); {first = "value"} }

fn with_unit_component(value: First) -> String {
  match! value {
    .(_unit: ., payload: First) { payload.?{first} }
  }
}

fn tagged(value: Tag | First) -> String {
  match! value {
    .(_tag: Tag) { "tag\n" };
    .() { "untagged\n" }
  }
}

fn produce_pair() -> First & Second {
  io.print("pair-source\n");
  ({first = "left"}, {second = "right"})
}

fn rigid[A](input: . | A) -> String {
  match! input {
    .(_present: A) { "rigid-present\n" };
    .() { "rigid-empty\n" }
  }
}

fn rigid_pair[A](input: . | (A & A)) -> String {
  match! input {
    .(_first: A, _second: A) { "rigid-pair\n" };
    .() { "rigid-pair-empty\n" }
  }
}

fn empty[A]() -> . | A { widen_sum!((), . | A) }

fn present[A](value: A) -> . | A { widen_sum!(value, . | A) }

fn unit_sum(input: First | Second) -> String {
  match! input {
    .(slot: . | First) {
      match! slot {
        .(value: First) { value.?{first} };
        .() { "sum-unit\n" }
      }
    }
  }
}

fn nested_unit_sum(input: Tag & Second) -> String {
  match! input {
    .(slot: (. | First) & Second) {
      let .(choice, payload) = slot;
      io.print(match! choice {
        .(value: First) { value.?{first} };
        .() { "nested-unit\n" }
      });
      payload.?{second}
    }
  }
}

fn produce_second() -> Second { io.print("sum-source\n"); {second = "discarded"} }

fn produce_nested() -> Tag & Second {
  io.print("nested-source\n");
  ({tag=}, {second = "nested-payload\n"})
}

pub fn main() -> . {
  let left = widen_sum!({first = "left"}, First | Second);
  let right = widen_sum!({second = "right"}, First | Second);
  io.print(typed(left));
  io.print(typed(right));
  io.print(match! produce() {
    .() { "zero\n" }
  });
  io.print(match! produce() {
    named
  });
  io.print(fallback(left));
  io.print(fallback(right));
  io.print(overlap(left));
  io.print(overlap(right));
  io.print(with_unit_component({first = "component\n"}));
  io.print(tagged(widen_sum!({tag=}, Tag | First)));
  io.print(tagged(widen_sum!({first = "left"}, Tag | First)));
  io.print(match! produce_pair() {
    .() { "pair\n" }
  });
  io.print(rigid(., empty(., ())));
  io.print(rigid(., present(., ())));
  io.print(rigid_pair(., empty(. & ., ())));
  io.print(rigid_pair(., present(((), ()))));
  io.print(unit_sum(widen_sum!({first = "sum-first\n"}, First | Second)));
  io.print(unit_sum(widen_sum!(produce_second(), First | Second)));
  io.print(nested_unit_sum(produce_nested()));
  io.print(match! produce_second() {
    .(_slot: . | First) { "direct-sum\n" }
  })
}
