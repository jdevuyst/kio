/// Explicit t.I32 annotations retain the exact qualified carrier through
/// imported host calls and Kio' emission without an unqualified type import.
mod testapi/main;

import testapi as t;
import testapi/arith { fn add_i32 }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

pub fn wrap(x: t.I32) -> t.I32 { x }

pub fn main() { print(int_to_string(add_i32(wrap(40[t.I32]), 2[t.I32]))) }
