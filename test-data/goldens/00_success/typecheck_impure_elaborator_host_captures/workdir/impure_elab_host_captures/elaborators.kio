module impure_elab_host_captures/elaborators;

import __intrinsics__;

import __comptime__;
import impure_elab_host_captures(I32, id_i32);

pub type Target_request = __Type__ | .;

pub pure fn checked_impl(
  , ct: __Comptime__
  , _i32_type: __Type__
  , _id_i32: __Checked_term__
  , _source: __Type__
  , value: __Checked_term__
  , target: Target_request
  ) -> __Checked_term__ {
  __either__(
    , __Type__
    , .
    , __Checked_term__
    , target
    , .(_target: __Type__) -> __Checked_term__ { value }
    , .() -> __Checked_term__ { __elab_error__(ct, "elaborator needs a target") }
    )
}

pub elab checked : [Source] Source -> [Target] Target { captures (I32, id_i32); impl checked_impl }
