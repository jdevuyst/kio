module testapi/main;

import macros/control(macro if);
import testapi(I32, String, default Bool);
import testapi/array(array_get, array_make_filled);
import testapi/io(print);

pub fn main() {
  let flags = array_make_filled(1, .t);
  if(array_get(flags, 0)) { print("true\n") } else { print("false\n") }
}
