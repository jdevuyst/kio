mod testapi/main;

import macros/control { macro if }
import testapi { type Bool; type I32; type String }
import testapi/array { fn array_get; fn array_make_filled }
import testapi/io { fn print }

pub fn main() {
  let flags = array_make_filled(1, .t[Bool]);
  if(array_get(flags, 0)) { print("true\n") } else { print("false\n") }
}
