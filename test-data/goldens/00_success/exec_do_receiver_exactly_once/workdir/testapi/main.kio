module testapi/main;

import elab/sequence(do);
import testapi/io as io;

newtype Box[A] : A { constructor box; projector unbox }

fn bind[A][B](value: Box(A), next: A -> Box(B)) -> Box(B) {
  io.print("bind\n");
  next(Box.unbox(value))
}

fn make_bind() -> [A][B] (Box(A) & (A -> Box(B))) -> Box(B) { io.print("factory\n"); bind }

fn action() -> Box(.) { io.print("action\n"); Box.box(()) }

pub fn main() -> . {
  io.print("zero\n");
  let zero =
    do! make_bind() {
      Box.box(())
    };
  Box.unbox(zero);
  io.print("one\n");
  let one =
    do! make_bind() {
      let value <- action();
      Box.box(value)
    };
  Box.unbox(one);
  io.print("two\n");
  let two =
    do! make_bind() {
      let first <- action();
      let second <- action();
      Box.box(second)
    };
  Box.unbox(two)
}
