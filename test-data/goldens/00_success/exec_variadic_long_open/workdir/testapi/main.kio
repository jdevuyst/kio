mod testapi/main;

import testapi { type I32; type String }
import testapi/fmt { fn i32_to_string }
import testapi/io { fn print }
import testapi/numeric { fn local_result; op_var [%? ?%]; op_var [%?:+-*=!@$^& &^$@!=*-+:?%] }

pub fn main() {
  print(i32_to_string([%?:+-*=!@$^& 1, 2, 3 &^$@!=*-+:?%]));
  print("\n");
  print(i32_to_string([%? 4, 5 ?%]));
  print("\n");
  print(i32_to_string(local_result()));
  print("\n")
}
