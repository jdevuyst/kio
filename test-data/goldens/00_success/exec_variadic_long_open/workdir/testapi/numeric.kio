mod testapi/numeric;

import testapi { type I32 }
import testapi/arith { fn add_i32 }

pub fn add(a: I32, b: I32) -> I32 { add_i32(a, b) }

pub fn zero() -> I32 { 0 }

pub op_var [%? ?%] { foldl add zero }

pub op_var [%?:+-*=!@$^& &^$@!=*-+:?%] { foldl add zero }

pub fn local_result() -> I32 { [%?:+-*=!@$^& 6, 7 &^$@!=*-+:?%] }
