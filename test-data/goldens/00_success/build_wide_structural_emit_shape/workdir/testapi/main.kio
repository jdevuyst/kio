mod testapi/main;

import __intrinsics__;

import testapi { type I32 }

pub type { A: I32 { pub mk; pub get } }

pub type { B: I32 { pub mk; pub get } }

pub type { C: I32 { pub mk; pub get } }

pub type { D: I32 { pub mk; pub get } }

pub type { E: I32 { pub mk; pub get } }

pub type { F: I32 { pub mk; pub get } }

pub type { G: I32 { pub mk; pub get } }

pub type { H: I32 { pub mk; pub get } }

pub type { I: I32 { pub mk; pub get } }

pub type { J: I32 { pub mk; pub get } }

pub type { K: I32 { pub mk; pub get } }

pub type { L: I32 { pub mk; pub get } }

pub type Product_tail12 = K & L;

pub type Product_tail11 = J & Product_tail12;

pub type Product_tail10 = I & Product_tail11;

pub type Product_tail9 = H & Product_tail10;

pub type Product_tail8 = G & Product_tail9;

pub type Product_tail7 = F & Product_tail8;

pub type Product_tail6 = E & Product_tail7;

pub type Product_tail5 = D & Product_tail6;

pub type Product_tail4 = C & Product_tail5;

pub type Product_tail3 = B & Product_tail4;

pub type Wide_product = A & Product_tail3;

pub type Sum_tail12 = K | L;

pub type Sum_tail11 = J | Sum_tail12;

pub type Sum_tail10 = I | Sum_tail11;

pub type Sum_tail9 = H | Sum_tail10;

pub type Sum_tail8 = G | Sum_tail9;

pub type Sum_tail7 = F | Sum_tail8;

pub type Sum_tail6 = E | Sum_tail7;

pub type Sum_tail5 = D | Sum_tail6;

pub type Sum_tail4 = C | Sum_tail5;

pub type Sum_tail3 = B | Sum_tail4;

pub type Wide_sum = A | Sum_tail3;

pub fn product_case() -> Wide_product {
  __pair__[A][Product_tail3](
  , A.mk(1[I32])
  , __pair__[B][Product_tail4](
    , B.mk(2[I32])
    , __pair__[C][Product_tail5](
      , C.mk(3[I32])
      , __pair__[D][Product_tail6](
        , D.mk(4[I32])
        , __pair__[E][Product_tail7](
          , E.mk(5[I32])
          , __pair__[F][Product_tail8](
            , F.mk(6[I32])
            , __pair__[G][Product_tail9](
              , G.mk(7[I32])
              , __pair__[H][Product_tail10](
                , H.mk(8[I32])
                , __pair__[I][Product_tail11](
                  , I.mk(9[I32])
                  , __pair__[J][Product_tail12](
                    , J.mk(10[I32])
                    , __pair__[K][L](K.mk(11[I32]), L.mk(12[I32]))
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

pub fn sum_case() -> Wide_sum {
  __right__[A][Sum_tail3](__right__[B][Sum_tail4](__right__[C][Sum_tail5](__right__[D][Sum_tail6](__right__[E][Sum_tail7](__right__[F][Sum_tail8](__right__[G][Sum_tail9](__right__[H][Sum_tail10](__right__[I][Sum_tail11](__right__[J][Sum_tail12](__right__[K][L](L.mk(12[I32]))))))))))))
}
