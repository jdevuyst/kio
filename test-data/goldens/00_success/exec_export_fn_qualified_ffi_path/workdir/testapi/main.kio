mod testapi/main;

import testapi { type String }
import testapi/boxlib { type Box }
import testapi/io { fn print }
import testapi/token { type Token }

pub fn boxify(token: Token) -> Box[Token] { Box.mk(token) }

pub fn main() {
  let token = Token.mk("exported-function qualified ffi path\n");
  print(Token.get(Box.get(boxify(token))))
}
