module derive_memo_wide_candidate_set/main;

import __intrinsics__;

import macros/derive(macro derive);
import testapi(String);

pub type { Cell[A]: A { pub mk; pub get } }

pub type { Pair[A][B]: A & B { pub mk; pub get } }

pub type { Render[A]: A -> String { pub mk; pub get } }

pub type { Atom0: String { pub mk; pub get } }

pub type { Atom1: String { pub mk; pub get } }

pub type { Atom2: String { pub mk; pub get } }

pub type { Atom3: String { pub mk; pub get } }

pub type { Atom4: String { pub mk; pub get } }

pub type { Atom5: String { pub mk; pub get } }

fn render_cell_string() -> Render[Cell[String]] {
  Render.mk(.(c) { Cell.get(c) })
}

fn render_atom0() -> Render[Atom0] {
  Render.mk(.(a) { Atom0.get(a) })
}

fn render_atom1() -> Render[Atom1] {
  Render.mk(.(a) { Atom1.get(a) })
}

fn render_atom2() -> Render[Atom2] {
  Render.mk(.(a) { Atom2.get(a) })
}

fn render_atom3() -> Render[Atom3] {
  Render.mk(.(a) { Atom3.get(a) })
}

fn render_atom4() -> Render[Atom4] {
  Render.mk(.(a) { Atom4.get(a) })
}

fn render_atom5() -> Render[Atom5] {
  Render.mk(.(a) { Atom5.get(a) })
}

fn render_pair[A][B](ra: Render[A], rb: Render[B]) -> Render[Pair[A][B]] {
  Render.mk(.(p) { Render.get(ra)(__fst__[A][B](Pair.get[A][B](p))) })
}

fn derived0() -> Render[Pair[Cell[String]][Pair[Cell[String]][Pair[Cell[String]][Cell[String]]]]] {
  derive((
  , render_atom0
  , render_atom1
  , render_atom2
  , render_atom3
  , render_atom4
  , render_atom5
  , render_pair
  , render_cell_string
  ))[Render[Pair[Cell[String]][Pair[Cell[String]][Pair[Cell[String]][Cell[String]]]]]]
}

fn derived1() -> Render[Pair[Cell[String]][Pair[Cell[String]][Pair[Cell[String]][Cell[String]]]]] {
  derive((
  , render_atom0
  , render_atom1
  , render_atom2
  , render_atom3
  , render_atom4
  , render_atom5
  , render_pair
  , render_cell_string
  ))[Render[Pair[Cell[String]][Pair[Cell[String]][Pair[Cell[String]][Cell[String]]]]]]
}

fn derived2() -> Render[Pair[Cell[String]][Pair[Cell[String]][Pair[Cell[String]][Cell[String]]]]] {
  derive((
  , render_atom0
  , render_atom1
  , render_atom2
  , render_atom3
  , render_atom4
  , render_atom5
  , render_pair
  , render_cell_string
  ))[Render[Pair[Cell[String]][Pair[Cell[String]][Pair[Cell[String]][Cell[String]]]]]]
}

fn derived3() -> Render[Pair[Cell[String]][Pair[Cell[String]][Pair[Cell[String]][Cell[String]]]]] {
  derive((
  , render_atom0
  , render_atom1
  , render_atom2
  , render_atom3
  , render_atom4
  , render_atom5
  , render_pair
  , render_cell_string
  ))[Render[Pair[Cell[String]][Pair[Cell[String]][Pair[Cell[String]][Cell[String]]]]]]
}

pub fn main() { () }
