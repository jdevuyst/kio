module testapi/main;

import elab/control(if);
import testapi(Bool, I32, String);
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter as iter;
import testapi/text as text;

fn mark(label: String, value: I32) -> I32 { io.print(text.string_concat(label, "\n")); value }

rec(iter.loop_reentry) fn delayed(remaining: I32, left: I32, right: I32) -> I32 -> I32 {
  if! arith.leq_i32(remaining, 0) {
    .(increment: I32) { arith.add_i32(arith.add_i32(left, right), increment) }
  } else {
    .(increment: I32) {
      arith.add_i32(
      , mark("outer", increment)
      , recur(escape) delayed(mark("count", 0), mark("left", left), mark("right", right))(0)
      )
    }
  }
}

pub fn main() {
  let saved = delayed(1, 10, 20);
  io.print("ready\n");
  io.print(fmt.i32_to_string(saved(3)));
  io.print("\n");
  io.print(fmt.i32_to_string(saved(4)));
  io.print("\n")
}
