mod testapi/main;

import __intrinsics__;

import testapi { type I32; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

pub type { A: I32 { pub mk; pub get } }

pub type { B: I32 { pub mk; pub get } }

pub type { C: I32 { pub mk; pub get } }

pub type { D: I32 { pub mk; pub get } }

pub type { E: I32 { pub mk; pub get } }

pub type { F: I32 { pub mk; pub get } }

pub type { G: I32 { pub mk; pub get } }

pub type { H: I32 { pub mk; pub get } }

type Tail7 = G | H;

type Tail6 = F | Tail7;

type Tail5 = E | Tail6;

type Tail4 = D | Tail5;

type Tail3 = C | Tail4;

type Tail1 = B | Tail3;

type Wide = A | Tail1;

fn inject_a() -> Wide { __left__[A][Tail1](A.mk(1[I32])) }

fn inject_d() -> Wide {
  __right__[A][Tail1](__right__[B][Tail3](__right__[C][Tail4](__left__[D][Tail5](D.mk(4[I32])))))
}

fn inject_h() -> Wide {
  __right__[A][Tail1](__right__[B][Tail3](__right__[C][Tail4](__right__[D][Tail5](__right__[E][Tail6](__right__[F][Tail7](__right__[G][H](H.mk(8[I32]))))))))
}

fn describe_tail7(value: Tail7) -> I32 {
  __either__[G][H][I32](value, .(g: G) -> I32 { G.get(g) }, .(h: H) -> I32 { H.get(h) })
}

fn describe_tail6(value: Tail6) -> I32 {
  __either__[F][Tail7][I32](
  , value
  , .(f: F) -> I32 { F.get(f) }
  , .(tail: Tail7) -> I32 { describe_tail7(tail) }
  )
}

fn describe_tail5(value: Tail5) -> I32 {
  __either__[E][Tail6][I32](
  , value
  , .(e: E) -> I32 { E.get(e) }
  , .(tail: Tail6) -> I32 { describe_tail6(tail) }
  )
}

fn describe_tail4(value: Tail4) -> I32 {
  __either__[D][Tail5][I32](
  , value
  , .(d: D) -> I32 { D.get(d) }
  , .(tail: Tail5) -> I32 { describe_tail5(tail) }
  )
}

fn describe_tail3(value: Tail3) -> I32 {
  __either__[C][Tail4][I32](
  , value
  , .(c: C) -> I32 { C.get(c) }
  , .(tail: Tail4) -> I32 { describe_tail4(tail) }
  )
}

fn describe_tail1(value: Tail1) -> I32 {
  __either__[B][Tail3][I32](
  , value
  , .(b: B) -> I32 { B.get(b) }
  , .(tail: Tail3) -> I32 { describe_tail3(tail) }
  )
}

fn describe(value: Wide) -> I32 {
  __either__[A][Tail1][I32](
  , value
  , .(a: A) -> I32 { A.get(a) }
  , .(tail: Tail1) -> I32 { describe_tail1(tail) }
  )
}

pub fn main() {
  print("a:"[String]);
  print(int_to_string(describe(inject_a())));
  print("\n"[String]);
  print("d:"[String]);
  print(int_to_string(describe(inject_d())));
  print("\n"[String]);
  print("h:"[String]);
  print(int_to_string(describe(inject_h())));
  print("\n"[String])
}
