module support;

import __intrinsics__;

import __comptime__;

pub pure fn zero(ct: __Comptime__) -> __Type_arity__ { __type_arity_zero__(ct) }

pub pure fn one(ct: __Comptime__) -> __Type_arity__ { __type_arity_succ__(ct, zero(ct)) }

pub pure fn three(ct: __Comptime__) -> __Type_arity__ {
  __type_arity_succ__(ct, __type_arity_succ__(ct, one(ct)))
}

pub pure fn predecessor(ct: __Comptime__, n: __Type_arity__) -> __Type_arity__ {
  let result =
    __type_arity_fold__(
    , ct
    , __Type_arity__ & __Type_arity__
    , n
    , (zero(ct), zero(ct))
    , .(_previous: __Type_arity__, current: __Type_arity__) -> __Type_arity__ & __Type_arity__ {
        (current, __type_arity_succ__(ct, current))
      }
    );
  __fst__(result)
}

pub pure fn reject[R](ct: __Comptime__) -> R {
  __structural_recur__(
  , ct
  , .
  , .
  , R
  , ()
  , ()
  , .(again: (. & .) -> R, _fuel: ., _state: .) -> R { again((), ()) }
  )
}
