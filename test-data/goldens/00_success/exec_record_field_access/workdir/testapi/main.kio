mod testapi/main;

import macros/row_macros { macro select }
import testapi { type I32; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

// Two nominal values compose as a `Foo & Bar` product.
type { Foo: I32 { mk; get }; Bar: String { mk; get } }

// Select each payload from the product using its nominal projector.
pub fn main() {
  let r = (Foo.mk(42), Bar.mk("kio\n"));
  print(int_to_string(r.>select { Foo.get }));
  print(r.>select { Bar.get })
}
