mod main;

type { A: . { pub mk; pub get } }

type { B: . { pub mk; pub get } }

// Apply a function through two successive type and value stages. Both
// calls below exercise the staged form over the nominal types A and B.
fn foo[A](v1: A)[B](v2: B) { () }

fn flat() { foo[A](A.mk(()))[B](B.mk(())) }

fn curried() { foo[A](A.mk(()))[B](B.mk(())) }
