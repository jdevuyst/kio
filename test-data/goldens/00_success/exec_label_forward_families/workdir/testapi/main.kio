mod testapi/main;

import origin { type Item; type Pack }
import testapi { type String }
import testapi/io { fn print }
import view as field;
import view { type Entry }

fn make_item[A](value: A) -> Item[A] { Entry.mk(value) }

fn read_item[A](value: Item[A]) -> A { field.Entry.get(value) }

fn inspect_packet(value: Pack[String]) {
  Pack.get(value)(.[U](prefix: String, payload: U, format: U -> String) {
    print(prefix);
    print(format(payload))
  })
}

pub fn main() {
  print(read_item(make_item("generic-string\n")));
  read_item(make_item(()));
  print("generic-unit\n");
  print(read_item(Item.mk("original-generic\n")));
  inspect_packet(field.Packet.mk(("existential-string: ", "payload\n", .(text: String) { text })));
  inspect_packet(field.Packet.mk(("existential-unit: ", (), .(_unit: .) { "unit\n" })))
}
