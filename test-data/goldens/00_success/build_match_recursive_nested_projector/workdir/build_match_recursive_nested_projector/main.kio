mod build_match_recursive_nested_projector/main;

import build_match_recursive_nested_projector { type Bool; fn loop }
import macros/match { macro match }

pub rec type { List[A]: . | (A & List[A]) { mk; get } }

pub rec(loop) fn same_length[A](left: List[A], right: List[A]) -> Bool {
  match(left.>List.get) {
    (
    , .(_head: A, rest: List[A]) {
        match(right.>List.get) {
          (.(_other: A, others: List[A]) { recur same_length(rest, others) }, .(_empty: .) { .f })
        }
      }
    , .(_empty: .) {
        match(right.>List.get) {
          (.(_head: A, _rest: List[A]) { .f }, .(_empty: .) { .t })
        }
      }
    )
  }
}
