/// A host that vendors dyn_load_prime, loads a guest's emitted Prime image at runtime, and calls its exports.
module testapi/main;

import defaults(instantiate_default);
import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import loader(Diag, Loaded, Surface);
import loader(Lr_diag, Lr_image, un_load_outcome);
import loader({apply}, {i32_in}, {i32_out}, {lookup}, {str_in}, {str_out});
import loader/scan(load_package);
import testapi(Bool, I32, String);
import testapi/fmt(int_to_string);
import testapi/io(print);
import testapi/text(string_concat, string_eq);

// `testapi/main.kio` — the dyn_load_prime integration golden's host, end to end
// on each runtime target. It vendors the dyn_load_prime package (the run.sh
// assembles the live test-data/poc/dyn_load_prime/workdir/ source alongside this module,
// so there is no committed fork to drift) and loads a
// guest package from its **emitted Prime image text** — the verbatim
// `kio build kio-prime` output for:
//
//   pub fn square(x: I32) -> I32 { mul_i32(x, x) }
//   pub fn greet(name: String) -> String { string_concat("Hi, ", name) }
//
// It opens the loaded existential and calls each export through the
// surface, asserting square(7) = 49 and greet("World") = "Hi, World" — the
// full user-facing flow (emit a package as a Prime image, load it at
// runtime, instantiate, call a guest item), runnable in CI on every
// target dyn_load_prime compiles to.

// The guest package's whole emitted Kio' image, verbatim. Adjacent string
// literals fold into one (specs/grammar.md § Lexical structure).
fn guest_image() -> String {
  "module hostapi;\n\nhost type I32 role(i32);\nhost type String role(str);\n"
  "host fn add_i32(p0: I32, p1: I32) -> I32;\nhost fn int_to_string(p0: I32) "
  "-> String;\nhost fn mul_i32(p0: I32, p1: I32) -> I32;\nhost fn "
  "string_concat(p0: String, p1: String) -> String;\n\nmodule g;\n\nimport "
  "hostapi(I32, String, add_i32, int_to_string, mul_i32, string_concat);\n\n"
  "pub fn square(x: I32) -> I32 { mul_i32(x, x) }\n\npub fn greet(name: "
  "String) -> String { string_concat(\"Hi, \"(String), name) }\n\npackage "
  "guest;\n\nbridge { hostapi; g; }\n"
}

// Apply an `I32 -> I32` export named `name` to `arg` through the record
// surface, reading just the operations it needs by field name; `()` on
// any failure.
fn run_i32[P](surf: Surface(P), name: String, arg: I32) -> . | I32 {
  match! surf.?{lookup}(name) {
    (
      , .(g: P) {
          match! surf.?{apply}((g, surf.?{i32_in}(arg))) {
            (
              , .(r: P) {
                  match! surf.?{i32_out}(r) {
                    (.(n: I32) { widen_sum!(n, . | I32) }, .(_d: Diag) { widen_sum!((), . | I32) })
                  }
                }
              , .(_d: Diag) { widen_sum!((), . | I32) }
              )
          }
        }
      , .(_d: Diag) { widen_sum!((), . | I32) }
      )
  }
}

// Apply a `String -> String` export named `name` to `arg` through the
// record surface; `()` on any failure.
fn run_str[P](surf: Surface(P), name: String, arg: String) -> . | String {
  match! surf.?{lookup}(name) {
    (
      , .(g: P) {
          match! surf.?{apply}((g, surf.?{str_in}(arg))) {
            (
              , .(r: P) {
                  match! surf.?{str_out}(r) {
                    (
                      , .(s: String) { widen_sum!(s, . | String) }
                      , .(_d: Diag) { widen_sum!((), . | String) }
                      )
                  }
                }
              , .(_d: Diag) { widen_sum!((), . | String) }
              )
          }
        }
      , .(_d: Diag) { widen_sum!((), . | String) }
      )
  }
}

fn un_inst(r: Loaded | Diag) -> Loaded | Diag { r }

fn call_i32(handle: Loaded, name: String, arg: I32) -> . | I32 {
  Loaded.get(handle)(.[P](surf: Surface(P)) { run_i32(surf, name, arg) })
}

fn call_str(handle: Loaded, name: String, arg: String) -> . | String {
  Loaded.get(handle)(.[P](surf: Surface(P)) { run_str(surf, name, arg) })
}

fn loaded_square(arg: I32) -> . | I32 {
  match! un_load_outcome(load_package(guest_image())) {
    (
      , .(im: Lr_image) {
          match! un_inst(instantiate_default(Lr_image.get(im))) {
            (
              , .(handle: Loaded) { call_i32(handle, "square"(String), arg) }
              , .(_d: Diag) { widen_sum!((), . | I32) }
              )
          }
        }
      , .(_d: Lr_diag) { widen_sum!((), . | I32) }
      )
  }
}

fn loaded_greet(arg: String) -> . | String {
  match! un_load_outcome(load_package(guest_image())) {
    (
      , .(im: Lr_image) {
          match! un_inst(instantiate_default(Lr_image.get(im))) {
            (
              , .(handle: Loaded) { call_str(handle, "greet"(String), arg) }
              , .(_d: Diag) { widen_sum!((), . | String) }
              )
          }
        }
      , .(_d: Lr_diag) { widen_sum!((), . | String) }
      )
  }
}

// Render an expected-vs-actual i32 assertion as a PASS / FAIL line.
// Equality is compared on the rendered text (the host's own
// `string_eq` over the two `int_to_string`s), keeping the assertion in
// the string-op vocabulary.
fn assert_i32(label: String, expected: I32, actual: . | I32) -> String {
  match! actual {
    (
      , .(n: I32) {
          if! string_eq(int_to_string(n), int_to_string(expected)) {
            string_concat(label, "PASS\n"(String))
          } else {
            string_concat(
              , label
              , string_concat("FAIL (got "(String), string_concat(int_to_string(n), ")\n"(String)))
              )
          }
        }
      , .(_e: .) { string_concat(label, "FAIL (no result)\n"(String)) }
      )
  }
}

fn assert_str(label: String, expected: String, actual: . | String) -> String {
  match! actual {
    (
      , .(s: String) {
          if! string_eq(s, expected) {
            string_concat(label, "PASS\n"(String))
          } else {
            string_concat(
              , label
              , string_concat("FAIL (got "(String), string_concat(s, ")\n"(String)))
              )
          }
        }
      , .(_e: .) { string_concat(label, "FAIL (no result)\n"(String)) }
      )
  }
}

/// Loads the guest image, calls `square(7)` and `greet("World")` through the loaded existential, and prints a PASS / FAIL line for each.
pub fn main() -> . {
  print(assert_i32("square(7) == 49: "(String), 49(I32), loaded_square(7(I32))));
  print(assert_str(
    , "greet(\"World\") == \"Hi, World\": "(String)
    , "Hi, World"(String)
    , loaded_greet("World"(String))
    ))
}
