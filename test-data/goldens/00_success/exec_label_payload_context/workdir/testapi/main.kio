module testapi/main;

import testapi(String);
import testapi/io(print);

newtype Box[A] : String { pub constructor make; pub projector unpack }

fn empty[A]() -> Box(A) { Box.make("empty\n") }

labels State = { first: Box(.), second: Box(. -> .) };

fn initial() -> State { {first = empty(), second = empty()} }

fn show(value: First) -> . { print(value.?{first}.>Box.unpack) }

pub fn main() -> . {
  show({first = empty()});
  let single = {first = empty()};
  show(single);
  let state = initial();
  print(state.?{second}.>Box.unpack);
  let updated = state.!{first = empty()};
  print(updated.?{first}.>Box.unpack)
}
