module testapi/main;

import macros/row_macros(macro record, macro select, macro with_);
import testapi(String);
import testapi/io(print);

type { Box[A]: String { pub mk; pub get } }

fn empty[A]() -> Box[A] { Box.mk("empty\n") }

type State = { First: Box[.]; Second: Box[. -> .] };

fn initial() -> State {
  record { First.mk(empty()); Second.mk(empty()) }
}

fn show(value: First) {
  print(value.>select { First.get }.>Box.get)
}

pub fn main() {
  show(First.mk(empty()));
  let single = First.mk(empty());
  show(single);
  let state = initial();
  print(state.>select { Second.get }.>Box.get);
  let updated = state.>with_ { First.mk(empty()) };
  print(updated.>select { First.get }.>Box.get)
}
