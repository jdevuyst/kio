module testapi/main;

import testapi(String);
import testapi/io(print);

// Declare a 3-element product type using chain sugar. Equivalent
// (right-associative) to `(String & (String & String))` — the same
// shape a 3-tuple inhabits.
type Triple = String & String & String;

// Match-destructure a `Triple` to pull the third element. The
// `match!` pattern's value-param run mirrors the right-spine of
// the product, so the third clause-arg binds to the trailing
// `String`.
fn third((_a: String, _b: String, c: String)) -> String { c }

pub fn main() -> . { print(third(("first\n", "second\n", "third\n"))) }
