/// Revalidates package bridge globs and transitive host-module completeness.
mod testapi/main;

import loader { fn diag_message; fn un_load_outcome }
import loader { fn export_info_name; fn image_exports; fn un_export_infos }
import loader { type Export_info; type Export_infos }
import loader { type Lr_diag; type Lr_image }
import loader/scan { fn load_package }
import macros/match { macro match }
import testapi { type String }
import testapi/io { fn print }
import testapi/text { fn string_concat }

fn describe(source: String) -> String {
  match(un_load_outcome(load_package(source))) {
    (
    , .(_loaded: Lr_image) { "accepted"[String] }
    , .(rejected: Lr_diag) { diag_message(Lr_diag.get(rejected)) }
    )
  }
}

fn result_line(label: String, source: String) -> String {
  string_concat(label, string_concat(describe(source), "\n"[String]))
}

fn first_export(source: String) -> String {
  match(un_load_outcome(load_package(source))) {
    (
    , .(loaded: Lr_image) {
        match(un_export_infos(image_exports(Lr_image.get(loaded)))) {
          (
          , .(export: Export_info, _rest: Export_infos) { export_info_name(export) }
          , .(_empty: .) { "<empty>"[String] }
          )
        }
      }
    , .(rejected: Lr_diag) { diag_message(Lr_diag.get(rejected)) }
    )
  }
}

fn export_line(label: String, source: String) -> String {
  string_concat(label, string_concat(first_export(source), "\n"[String]))
}

pub fn main() {
  print(result_line(
  , "dead glob: "[String]
  , "mod present;\npub fn entry() -> . { () }\npkg guest;\nbridge { "
    "missing/first/**; missing/second/**; }\n"[String]
  ));
  print(result_line(
  , "transitive hidden host: "[String]
  , "mod host;\nhost type Number role(i32);\nmod mid;\nimport host as h;\npub fn "
    "helper() -> . { () }\nmod main;\nimport mid {fn helper}\npub fn entry() -> "
    ". { helper() }\npkg guest;\nbridge { main; }\n"[String]
  ));
  print(result_line(
  , "stable hidden host: "[String]
  , "mod alpha;\nhost type Early role(i32);\nmod zeta;\nhost type Later "
    "role(i32);\nmod main;\nimport zeta {type Later}\nimport alpha as a;\npub fn "
    "entry() -> . { () }\npkg guest;\nbridge { main; }\n"[String]
  ));
  print(result_line(
  , "accepted control: "[String]
  , "mod host;\nhost type Number role(i32);\nmod mid;\nimport host as h;\npub fn "
    "helper() -> . { () }\nmod main;\nimport mid {fn helper}\npub fn entry() -> "
    ". { helper() }\npkg guest;\nbridge { main; host; }\n"[String]
  ));
  print(export_line(
  , "manifest without bridge: "[String]
  , "mod main;\npub fn entry() -> . { () }\npkg guest;\n"[String]
  ));
  print(export_line(
  , "empty bridge: "[String]
  , "mod main;\npub fn entry() -> . { () }\npkg guest;\nbridge {}\n"[String]
  ));
  print(export_line("no manifest: "[String], "mod main;\npub fn entry() -> . { () }\n"[String]))
}
