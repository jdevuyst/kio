module testapi/main;

import macros/row_macros(macro select, macro with_);
import testapi(I32, String);
import testapi/fmt(int_to_string);
import testapi/io(print);

type { Foo: I32 { mk; get }; Bar: String { mk; get } }

pub fn main() {
  let updated = Foo.mk(1).>with_ { Foo.mk(2); Bar.mk("x") };
  print(int_to_string(updated.>select { Foo.get }));
  print(updated.>select { Bar.get })
}
