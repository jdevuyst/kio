module testapi/main;

import elab/spine_elaborators(widen_sum);
import testapi(I32, String);
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter as iter;

pub fn main() {
  let identity =
    iter.loop(
    , .
    , [A] A -> A
    , .(_state: .) -> . | ([A] A -> A) {
        .[A](value: A) -> A { value }.>widen_sum!
      }
    , ()
    );
  io.print(fmt.i32_to_string(identity(I32, 41)));
  io.print("\n");
  io.print(identity(String, "kept\n"))
}
