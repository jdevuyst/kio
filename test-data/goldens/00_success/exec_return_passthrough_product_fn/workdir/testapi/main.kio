module testapi/main;

import testapi(String);
import testapi/io(print);
import testapi/text(string_concat);

fn id[A](x: A) -> A { x }

fn make() -> (String & String) -> String {
  id((String & String) -> String, .(left: String, right: String) -> String { left })
}

fn make_iife() -> (String & String) -> String {
  .() { id((String & String) -> String, .(left: String, right: String) -> String { left }) }()
}

pub fn main() -> . {
  let f = make();
  let g = make_iife();
  print(string_concat(
    , f(("left\n"(String), "right"(String)))
    , g(("wrapped\n"(String), "right"(String)))
    ))
}
