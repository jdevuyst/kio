module testapi/main;

import flag(Bool, bool_to, no, yes);
import testapi(String);
import testapi/fmt(bool_to_string);
import testapi/io(print);
import testapi/text(string_concat, string_eq);

// The root module `Bool` is imported *bare* (not `flag.Bool`) from the
// root module core. A `type Bool role(bool)` is also declared in
// the consumer's package file. The root module contract says the
// imported `Bool` keeps meaning the structural sum regardless of the
// consumer's host surface, so a root-module `Bool` reference must render as
// the sum — not get rewritten to the host `bool` because a same-named
// type happens to be in scope.

// Root_module-`Bool` site: `yes()` / `no()` build the structural sum, and
// `bool_to` eliminates it. The parameter / return `Bool` here is the
// root module alias, not the same-named host type.
fn show_flag_bool(b: Bool) -> String { bool_to("true", "false", b) }

pub fn main() -> . {
  // Root_module Bool: yes() is true, no() is false.
  print(string_concat("root module yes  = ", string_concat(show_flag_bool(yes()), "\n")));
  print(string_concat("root module no   = ", string_concat(show_flag_bool(no()), "\n")));
  // Host Bool: `string_eq` returns the host `role(bool)`, fed straight
  // to `bool_to_string`. The environment `Bool` is named only in the
  // package file's host function signatures, so it stays the type;
  // the two `Bool`s coexist with distinct meanings.
  print(string_concat("host  eq   = ", string_concat(bool_to_string(string_eq("a", "a")), "\n")));
  print(string_concat("host  neq  = ", string_concat(bool_to_string(string_eq("a", "b")), "\n")))
}
