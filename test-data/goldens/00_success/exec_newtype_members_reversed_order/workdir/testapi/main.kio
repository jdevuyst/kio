module testapi/main;

import testapi(I32);
import testapi/fmt(int_to_string);
import testapi/io(print);

// Nominal members are an unordered set: here `get` is written before
// `mk`. The parser, the Kio' verifier, and every backend accept either
// order; `kio fmt` canonicalizes the pair to `mk` then `get` (see specs/style.md).
type { Wrap: I32 { pub get; pub mk; }; };

fn wrapped() -> Wrap { Wrap.mk(42[I32]) }

pub fn main() { print(int_to_string(Wrap.get(wrapped()))) }
