module testapi/opt;

import elab/spine_elaborators(widen_sum);
import testapi(I32);

// A labels-shape optional. The `present` label mints a newtype `Present`;
// the `pub type Option` names the sum of that label with unit. When a
// consumer imports `Option` and widens it (without importing
// `Present` directly), alias unfolding retains this module as the
// exact owner of the generated nominal. The consumer module guards
// that identity against an unrelated imported module's same-leaf
// public newtype.
pub labels { present: I32 };

pub type Option = Present | .;

pub fn some(x: I32) -> Option { widen_sum!({present = x}) }

pub fn none() -> Option { widen_sum!(()) }
