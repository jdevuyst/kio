/// Lazy conditionals and immediate scoped expressions.
mod continuations/macros/control;

import __comptime__;
import continuations/testapi as _rehost_hegfhdhegbhagj;

pub type Bool = _rehost_hegfhdhegbhagj.Bool;

pure fn invoke(ct: __Comptime__, thunk: __Checked_term__) -> __Checked_term__ {
  __term_call__(ct, __term_type__(ct, thunk), thunk, __term_unit__(ct))
}

pure fn if_checked(
, ct: __Comptime__
, fills: __Fill_ctx__
, result_type: __Type__
, inputs: __Checked_term__
) -> __Checked_term__ & __Fill_ctx__ {
  let inputs_type = __term_type__(ct, inputs);
  let branches = __intrinsic_snd__(ct, inputs_type, inputs);
  let branches_type = __term_type__(ct, branches);
  let true_result = invoke(ct, __intrinsic_fst__(ct, branches_type, branches));
  let false_result = invoke(ct, __intrinsic_snd__(ct, branches_type, branches));
  let with_true = __fill__(ct, fills, result_type, __term_type__(ct, true_result));
  let with_false = __fill__(ct, with_true, result_type, __term_type__(ct, false_result));
  (
  , __term_let__(
    , ct
    , inputs_type
    , inputs
    , .(bound: __Checked_term__) -> __Checked_term__ {
        let bound_branches = __intrinsic_snd__(ct, inputs_type, bound);
        __intrinsic_if_then_else__(
        , ct
        , result_type
        , __intrinsic_fst__(ct, inputs_type, bound)
        , .() -> __Checked_term__ {
            invoke(ct, __intrinsic_fst__(ct, branches_type, bound_branches))
          }
        , .() -> __Checked_term__ {
            invoke(ct, __intrinsic_snd__(ct, branches_type, bound_branches))
          }
        )
      }
    )
  , with_false
  )
}

/// Evaluates its arguments once and invokes only the selected branch thunk.
pub macro if : [Result] (Bool & (. -> Result) & (. -> Result)) -> Result { trailing thunk; trailing thunk else; impl(fills) if_checked }

pure fn scope_checked(
, ct: __Comptime__
, fills: __Fill_ctx__
, _result_type: __Type__
, body: __Checked_term__
) -> __Checked_term__ & __Fill_ctx__ { (invoke(ct, body), fills) }

/// Evaluates a scoped body once and returns its final expression.
pub macro scope : [Result] (. -> Result) -> Result { trailing thunk; impl(fills) scope_checked }

pure fn and_checked(ct: __Comptime__, fills: __Fill_ctx__, inputs: __Checked_term__) ->
  __Checked_term__ & __Fill_ctx__
   {
  let inputs_type = __term_type__(ct, inputs);
  (
  , __term_let__(
    , ct
    , inputs_type
    , inputs
    , .(bound: __Checked_term__) -> __Checked_term__ {
        __intrinsic_and__(
        , ct
        , __intrinsic_fst__(ct, inputs_type, bound)
        , .() -> __Checked_term__ { invoke(ct, __intrinsic_snd__(ct, inputs_type, bound)) }
        )
      }
    )
  , fills
  )
}

pure fn or_checked(ct: __Comptime__, fills: __Fill_ctx__, inputs: __Checked_term__) ->
  __Checked_term__ & __Fill_ctx__
   {
  let inputs_type = __term_type__(ct, inputs);
  (
  , __term_let__(
    , ct
    , inputs_type
    , inputs
    , .(bound: __Checked_term__) -> __Checked_term__ {
        __intrinsic_or__(
        , ct
        , __intrinsic_fst__(ct, inputs_type, bound)
        , .() -> __Checked_term__ { invoke(ct, __intrinsic_snd__(ct, inputs_type, bound)) }
        )
      }
    )
  , fills
  )
}

/// Evaluates the right thunk only when the left value is true.
pub macro and : (Bool & (. -> Bool)) -> Bool { trailing thunk; impl(fills) and_checked }

/// Evaluates the right thunk only when the left value is false.
pub macro or : (Bool & (. -> Bool)) -> Bool { trailing thunk; impl(fills) or_checked }

/// Negates a Boolean value.
pub fn not(value: Bool) -> Bool {
  if(value) { .f } else { .t }
}

/// Conjunction with a delayed right operand.
pub op_macro _ && .__ { impl and }

/// Disjunction with a delayed right operand.
pub op_macro _ || .__ { impl or }

/// Builds a checked sum dispatch after evaluating its entire input packet once.
pub pure fn checked_sum_dispatch(
, ct: __Comptime__
, fills: __Fill_ctx__
, result_type: __Type__
, inputs: __Checked_term__
, source: __Checked_term__ -> __Checked_term__
, left: (__Checked_term__ & __Checked_term__) -> __Checked_term__
, right: (__Checked_term__ & __Checked_term__) -> __Checked_term__
, fallback: __Checked_term__ -> __Checked_term__
) -> __Checked_term__ & __Fill_ctx__ {
  let inputs_type = __term_type__(ct, inputs);
  let fallback_term = fallback(inputs);
  let result =
    __term_let__(
    , ct
    , inputs_type
    , inputs
    , .(bound: __Checked_term__) -> __Checked_term__ {
        let subject = source(bound);
        __intrinsic_either__(
        , ct
        , __term_type__(ct, subject)
        , result_type
        , subject
        , .(value: __Checked_term__) -> __Checked_term__ { left((bound, value)) }
        , .(value: __Checked_term__) -> __Checked_term__ { right((bound, value)) }
        )
      }
    );
  (result, __fill_result__(ct, fills, __term_type__(ct, fallback_term)))
}
