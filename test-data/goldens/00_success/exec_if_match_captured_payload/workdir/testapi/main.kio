module testapi/main;

import macros/control(macro if);
import macros/match(macro match);
import macros/spine_macros(macro widen_sum);
import testapi(Bool, String);
import testapi/io as io;

fn choose(condition: Bool, value: String | .) -> String {
  match(value) {
    .(line: String) {
      if(condition) { line } else { "else\n" }
    };
    .(_empty: .) -> String { "empty\n" }
  }
}

pub fn main() {
  io.print(choose(.t, widen_sum("then\n"[String])[String | .]));
  io.print(choose(.f, widen_sum("unused\n"[String])[String | .]));
  io.print(choose(.t, widen_sum(())[String | .]))
}
