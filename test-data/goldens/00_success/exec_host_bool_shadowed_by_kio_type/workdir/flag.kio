module flag;

import elab/match(match);
import elab/spine_elaborators(widen_sum);

// A pure two-state truth value also named `Bool`. The point of this
// golden: this name collides with the host `host type Bool role(bool)`
// declared in `testapi`. A `host fn … -> Bool` in another module (whose
// `Bool` is the host type it imports) must keep meaning the host
// `role(bool)` type, never get rewritten to this structural sum just
// because a same-named Kio type is declared elsewhere in the package.
// The two `Bool`s coexist with distinct meanings, each resolved in its
// own module's scope (open-world — see `specs/language.md`
// § Open-world design).
pub labels { btrue: ., bfalse: . };

pub type Bool = Btrue | Bfalse;

pub fn yes() -> Bool { widen_sum!({btrue=}) }

pub fn no() -> Bool { widen_sum!({bfalse=}) }

// Eliminate this module's `Bool` to a caller-chosen value, keeping the
// underlying labels on this module's side of the import.
pub fn bool_to[A](on_true: A, on_false: A, b: Bool) -> A {
  match! b {
    (.(_t: Btrue) { on_true }, .(_f: Bfalse) { on_false })
  }
}
