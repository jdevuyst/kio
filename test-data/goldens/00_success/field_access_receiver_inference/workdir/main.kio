module main;

host type String role(str);

host fn make[A]() -> A;

type { Item[A]: A { mk; get } }

fn annotated_literal() -> String { Item.get(Item.mk("text"[String])) }

fn annotated_factory() -> String { Item.get(Item.mk(make[String]())) }

fn getter_literal() -> String { Item.get(Item.mk("text")) }

fn getter_factory() -> String { Item.get(Item.mk(make())) }
