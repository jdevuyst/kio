mod observer;

import __comptime__;

pure fn keep_impl(
, ct: __Comptime__
, fills: __Fill_ctx__
, source: __Type__
, value: __Checked_term__
, _target: .
) -> __Checked_term__ & __Fill_ctx__ { (value, __fill_result__(ct, fills, source)) }

pub macro keep : [Source] Source -> [Target] Target { impl(fills) keep_impl }
