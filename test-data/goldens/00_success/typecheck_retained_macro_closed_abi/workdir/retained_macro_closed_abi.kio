module retained_macro_closed_abi;

import retained_macro_closed_abi/macros(macro infer);

default host type I32 role(i32);

default host type String role(str);

fn consume[A][B](_function: (A & B) -> (A & B), _left: A, _right: B) { () }

fn checked() {
  consume(.(pair) { infer(pair) }, 0, "closed")
}
