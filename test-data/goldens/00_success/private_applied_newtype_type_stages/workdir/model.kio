mod model;

import testapi/io as io;

pub type { Phantom[A]: . { mk; get } }

pub fn source[A] -> Phantom[A] { io.print("create\n"); Phantom.mk(()) }

pub fn consume[A](value: Phantom[A]) { value.>Phantom.get }

type { Hidden[*F][A][B]: . { mk; get } }

fn hidden[A][B] -> Hidden[Phantom][A][B] { io.print("hidden\n"); Hidden.mk(()) }

pub fn private_case() {
  let delayed = hidden[.];
  io.print("partial\n");
  let value = delayed[.];
  value.>Hidden.get;
  io.print("private\n")
}

type { Local: . { mk; get } }

fn local() -> Local { Local.mk(()) }

pub fn nullary_case() { local().>Local.get; io.print("nullary\n") }
