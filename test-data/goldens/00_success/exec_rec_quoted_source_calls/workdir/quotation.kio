module quotation;

import __comptime__;

pure fn duplicate_impl(ct: __Comptime__, _a: __Type__, value: __Checked_term__) -> __Checked_term__ {
  __term_let__(
  , ct
  , _a
  , value
  , .(saved: __Checked_term__) -> __Checked_term__ { __intrinsic_pair__(ct, saved, saved) }
  )
}

pub macro duplicate : [A] A -> (A & A) { impl duplicate_impl }
