module testapi/main;

import macros/match(macro match);
import macros/spine_macros(macro widen_sum);
import testapi(I32, String);
import testapi/io(print);

newtype Box[A] : A { pub constructor mk_box; pub projector un_box }

fn label[A](b: Box[A]) -> String { "domain match!\n" }

fn handle(p: (Box[I32] | Box[String]) & String) -> String {
  match(p) {
    .[A](b: Box[A]) { label(b) }
  }
}

pub fn main() {
  let p = (widen_sum(Box.mk_box("hi"[String]))[Box[I32] | Box[String]], "ignored"[String]);
  print(handle(p))
}
