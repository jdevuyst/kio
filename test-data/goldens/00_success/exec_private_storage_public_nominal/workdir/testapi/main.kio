module testapi/main;

import macros/control(macro if);
import testapi(Bool);
import testapi/io as io;

pub type { Cell[A]: A { mk; get } }

type { Stored[A]: Cell[A] { mk; get } }

pub fn choose[A](condition: Bool, first: A, second: A) -> A {
  let stored = if(condition) { Stored.mk(Cell.mk(first)) } else { Stored.mk(Cell.mk(second)) };
  stored.>Stored.get.>Cell.get
}

pub fn main() {
  let .(condition: Bool) = choose(.f, .f, .t);
  io.print(choose(condition, "left ", "wrong "));
  io.print(choose(.f, "wrong\n", "right\n"))
}
