mod testapi/a;

import testapi { type String }

// Modules `a` and `b` each define a newtype `Functor` with the same
// leaf name, so the Rust emitter must disambiguate the host-facing
// struct names and route the polymorphic-fn projector turbofish
// through those mangled names — not the dotted module-qualified key.
pub type { Box[A]: A { pub mk; pub get } }

pub type { Functor[*F]: [A][B] ((A -> B) & F[A]) -> F[B] { pub mk; pub get } }

pub fn run_a() -> String {
  let dict = Functor.mk[Box](.[A][B](step, m) { Box.mk[B](step(Box.get[A](m))) });
  let branded = Box.mk[String]("left ok\n"[String]);
  let mapped = Functor.get[Box](dict)[String][String](.(s) { s }, branded);
  Box.get[String](mapped)
}
