mod testapi/main;

import testapi { type Int; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

// Each `literal` declares a named literal alias. Alias resolution
// substitutes references inline; the emitted JS is identical to
// writing the literal at each use site.
lit max_size = 100;

lit greeting = "hello alias\n";

fn print_int(n: Int) { let s = int_to_string(n); let l = print(s); print("\n"[String]) }

pub fn main() { let g = print(greeting[String]); print_int(max_size[Int]) }
