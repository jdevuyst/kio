mod testapi/main;

import macros/sequence { type Bind; macro do }
import testapi { type String }
import testapi/io as io;

type { Box[A]: A { mk; get } }

fn pure[A](value: A) -> Box[A] { Box.mk(value) }

fn bind[A][B](value: Box[A], next: A -> Box[B]) -> Box[B] { next(Box.get(value)) }

fn receiver() -> Bind[Box] { io.print("receiver\n"); bind }

pub fn main() {
  let result = do(receiver()) { let value <- pure("retained\n"[String]); pure(value) };
  io.print(Box.get(result))
}
