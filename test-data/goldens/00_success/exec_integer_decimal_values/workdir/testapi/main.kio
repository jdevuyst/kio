mod testapi/main;

import testapi { type Int; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

lit ten = 0010;

type Number = Int;

fn show(value: Int) { print(int_to_string(value)); print("\n"[String]) }

pub fn main() {
  let decimal = ten[Int];
  show(decimal);
  show(-0[Number]);
  show(-2147483648);
  show(2147483647)
}
