mod testapi/main;

import testapi { type I32 }
import testapi/fmt { fn print_i32 }

fn duplicate[A](value: A) -> A & A { (value, value) }

fn first[A][B]((value: A, _other: B)) -> A { value }

fn anchored(known: I32) -> I32 {
  .[T](_seed, _early: T, late: I32 & T) -> I32 { first(late) }((), known, duplicate(7))
}

pub fn main() { print_i32(anchored(8)) }
