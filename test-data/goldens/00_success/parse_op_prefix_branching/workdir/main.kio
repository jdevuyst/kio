module main;

pub newtype A : . { pub constructor mk_a; pub projector un_a }

fn cat(a: A, b: A) -> A { a }

// Complete operator words may share a character prefix while remaining
// distinct: `&&++` and `&&--` are each one contiguous symbol word.
op _ &&++ _ { impl cat }

op _ &&-- _ { impl cat }

pub fn main(x: A, y: A) -> A { x &&++ y }
