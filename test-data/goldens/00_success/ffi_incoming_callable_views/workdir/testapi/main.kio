module testapi/main;

import testapi as t;
import testapi/arith as h;

pub type { Seal: t.I32 { mk; get } }

pub type { Other: t.I32 { mk; get } }

pub fn make_seal(value: t.I32) -> Seal { Seal.mk(value) }

pub fn read_seal(value: Seal) -> t.I32 { value.>Seal.get }

pub fn make_other(value: t.I32) -> Other { Other.mk(value) }

pub type { Vault[A]: A { mk; get } }

pub fn stash[A](value: A) -> Vault[A] { Vault.mk(value) }

pub fn release[A](value: Vault[A]) -> A { value.>Vault.get }

pub fn host_result(box: t.Box[Seal], consume: . -> .) { let value = h.box_get(box); consume() }

fn host_getter() -> t.Box[Seal] -> Seal { h.box_get[Seal] }

pub fn host_value_result(box: t.Box[Seal], consume: . -> .) {
  let getter = host_getter();
  let value = getter(box);
  consume()
}

pub fn receive(vault: Vault[. -> Seal], consume: . -> .) {
  let callback = vault.>Vault.get;
  let value = callback();
  consume()
}

pub fn receive_computed(vault: Vault[. -> Seal], consume: . -> .) {
  let value = (vault.>Vault.get)(());
  consume()
}

pub fn local_callback(value: Seal) -> Vault[. -> Seal] {
  Vault.mk(.() { value })
}

pub fn specialized_observer(consume: . -> .) -> Vault[Seal -> .] {
  let generic = .[A](_value: A) { consume() };
  Vault.mk(generic[Seal])
}

fn apply_callback(callback: ((t.I32 & t.I32) & t.I32) -> ., value: (t.I32 & t.I32) & t.I32) ->
  (t.I32 & t.I32) & t.I32
   { callback(value); value }

pub fn invoke_via_helper(
, vault: Vault[((t.I32 & t.I32) & t.I32) -> .]
, value: (t.I32 & t.I32) & t.I32
) -> (t.I32 & t.I32) & t.I32 { apply_callback(vault.>Vault.get, value) }

pub fn invoke_direct(vault: Vault[((t.I32 & t.I32) & t.I32) -> .], value: (t.I32 & t.I32) & t.I32) ->
  (t.I32 & t.I32) & t.I32
   { let callback = vault.>Vault.get; callback(value); value }

pub fn invoke_computed(vault: Vault[((t.I32 & t.I32) & t.I32) -> .], value: (t.I32 & t.I32) & t.I32) ->
  (t.I32 & t.I32) & t.I32
   { (vault.>Vault.get)(value); value }

pub fn receive_pair(vault: Vault[. -> ((t.I32 & t.I32) & t.I32)], after: . -> .) ->
  (t.I32 & t.I32) & t.I32
   { let callback = vault.>Vault.get; let value = callback(); after(); value }
