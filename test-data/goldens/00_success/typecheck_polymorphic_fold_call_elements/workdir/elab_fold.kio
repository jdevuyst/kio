module elab_fold;

import __comptime__;

pub pure fn implementation_base() -> . { () }

pub pure fn right_step[A](_value: A, _acc: .) -> . { () }

pub varop [* *] { foldr right_step implementation_base }

pub pure fn left_step[A](_acc: ., _value: A) -> . { () }

pub varop [! !] { foldl left_step implementation_base }

pub pure fn multislot_step[A][B]((_left: A, _right: B), _acc: .) -> . { () }

pub pure fn entry[A][B](left: A, right: B) -> A & B { (left, right) }

pub op _ => _ { impl entry }

pub varop [% %] { foldr multislot_step implementation_base }

pub pure fn finalize(_acc: .) -> . { () }

pub varop [+ +] { foldr right_step implementation_base; finalize finalize }

pure fn nested_nonfinalizing_impl(_ct: __Comptime__, _source: __Type__, value: __Checked_term__) -> __Checked_term__ {
  [% () => [* (), () *] %];
  value
}

pub elab nested_nonfinalizing : [Source] Source -> Source { impl nested_nonfinalizing_impl }

pure fn nested_finalizing_impl(_ct: __Comptime__, _source: __Type__, value: __Checked_term__) -> __Checked_term__ {
  [% () => [+ (), () +] %];
  value
}

pub elab nested_finalizing : [Source] Source -> Source { impl nested_finalizing_impl }

pure fn nested_empty_impl(_ct: __Comptime__, _source: __Type__, value: __Checked_term__) -> __Checked_term__ {
  [% () => [+ +] %];
  value
}

pub elab nested_empty : [Source] Source -> Source { impl nested_empty_impl }

pure fn nested_left_impl(_ct: __Comptime__, _source: __Type__, value: __Checked_term__) -> __Checked_term__ {
  [! [* () *], [+ () +] !];
  value
}

pub elab nested_left : [Source] Source -> Source { impl nested_left_impl }
