mod macro_util;

import __intrinsics__;

import __comptime__;

pub pure fn choose_checked_term(
, ct: __Comptime__
, cond: Comptime_bool
, on_true: __Checked_term__
, on_false: __Checked_term__
) -> __Checked_term__ {
  __comptime_if_then_else__(ct)(
  , cond
  , .() -> __Checked_term__ { on_true }
  , .() -> __Checked_term__ { on_false }
  )
}
