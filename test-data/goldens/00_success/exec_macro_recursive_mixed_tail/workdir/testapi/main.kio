mod testapi/main;

import choose { macro choose }
import testapi { type Bool; type I32 }
import testapi/arith { fn leq_i32 }
import testapi/io { fn print }
import testapi/iter { fn loop }

type { Box[A]: A { mk; get } }

fn finish_unit(value: .) { print("same\n"); value }

fn finish_box(value: Box[.]) { let unit = Box.get(value); print("box\n") }

rec(loop) fn same(n: I32) {
  finish_unit(choose(leq_i32(1, n))(.() { let next = recur(cont) same(0); next })(()))
}

rec(loop) fn boxed(n: I32) {
  finish_box(choose(leq_i32(1, n))(.() { let next = recur(cont) boxed(0); Box.mk(next) })(Box.mk(())))
}

pub fn main() { same(1); boxed(1) }
