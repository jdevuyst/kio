module probe/main;

import __intrinsics__;

import elab/control(if);
import probe(Bool);

fn gen() -> (. | .) | . {
  if! .t {
    __left__(
      , . | .
      , .
      , if! .t {
          __left__(., ., ())
        } else {
          __right__(., ., ())
        }
      )
  } else {
    __right__(. | ., ., ())
  }
}
