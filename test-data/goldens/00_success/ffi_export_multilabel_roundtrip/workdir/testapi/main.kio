mod testapi/main;

import macros/match { macro match }
import testapi { type I32; type String }
import testapi/io { fn print }

pub type { A: I32; B: String }

pub fn say(p: A & B) {
  print(B.get(match(p) {
    .(_a: A, b_slot: B) { b_slot }
  }))
}

pub fn echo_pair(p: A & B) -> A & B { p }

pub fn echo_a(value: A) -> A { value }
