package user_elaborator_owner_context;

build {
  cache "out/.kio-cache/";

  target js {
    out "out/js/";
    baseline es2020
  };

  target ts {
    out "out/ts/";
    baseline v5_0
  }
}

bridge {
  user_elaborator_owner_context;
  user_elaborator_owner_context/**;
  elaborator_owner_b;
  elaborator_owner_c;
  elaborators
}
