mod main;

import __intrinsics__;

rec type { List[A]: . | (A & List[A]) { pub mk; pub get } }

fn destruct[A](l: List[A]) -> . | (A & List[A]) { List.get[A](l) }

rec type { Tree: . | Tree { pub mk; pub get } }

fn empty() -> Tree { Tree.mk(__left__[.][Tree](())) }

rec {
  type { Even: . | Odd { pub mk; pub get } };
  type { Odd: . | Even { pub mk; pub get } }
}
