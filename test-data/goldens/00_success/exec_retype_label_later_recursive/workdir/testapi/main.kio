mod testapi/main;

import core/store as target;
import testapi { type String }
import testapi/io { fn print }
import widget/store as source;

pub fn main() {
  let later =
    (
    , target.Seed.mk("later-seed\n"[String])
    , source.Branch.mk(.(_next: source.Later[String] -> String) { "later-branch\n" })
    );
  print(source.later_seed(later));
  print(source.later_branch(later, .(_row: source.Later[String]) { "unused" }));
  let first =
    (
    , target.Seed.mk("first-seed\n"[String])
    , source.Left.mk(.(_next: source.Second[String] -> String) { "first-left\n" })
    );
  let second =
    (
    , target.Seed.mk("second-seed\n"[String])
    , source.Right.mk(.(_next: source.First[String] -> String) { "second-right\n" })
    );
  print(source.first_seed(first));
  print(source.first_left(first, .(_row: source.Second[String]) { "unused" }));
  print(source.second_seed(second));
  print(source.second_right(second, .(_row: source.First[String]) { "unused" }))
}
