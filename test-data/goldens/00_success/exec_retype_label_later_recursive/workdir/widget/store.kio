module widget/store;

import core/store as _rehost_gdgphcgfcphdhegphcgf;

pub type Seed[A] = _rehost_gdgphcgfcphdhegphcgf.Seed(A);

pub type {seed} = {_rehost_gdgphcgfcphdhegphcgf.seed};

rec {
  pub labels { branch[A]: (Later(A) -> A) -> A };
  pub type Later[A] = Seed(A) & Branch(A)
}

rec {
  pub labels { left[A]: (Second(A) -> A) -> A };
  pub type First[A] = Seed(A) & Left(A);
  pub labels { right[A]: (First(A) -> A) -> A };
  pub type Second[A] = Seed(A) & Right(A)
}

pub fn later_seed[A](row: Later(A)) -> A { row.?{seed} }

pub fn later_branch[A](row: Later(A), next: Later(A) -> A) -> A { row.?{branch}(next) }

pub fn first_seed[A](row: First(A)) -> A { row.?{seed} }

pub fn first_left[A](row: First(A), next: Second(A) -> A) -> A { row.?{left}(next) }

pub fn second_seed[A](row: Second(A)) -> A { row.?{seed} }

pub fn second_right[A](row: Second(A), next: First(A) -> A) -> A { row.?{right}(next) }
