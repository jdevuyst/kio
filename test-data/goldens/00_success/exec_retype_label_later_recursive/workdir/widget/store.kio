mod widget/store;

import core/store as _rehost_gdgphcgfcphdhegphcgf;
import widget/macros/row_macros { macro select }

pub type Seed[A] = _rehost_gdgphcgfcphdhegphcgf.Seed[A];

rec {
  pub type { Branch[A]: (Later[A] -> A) -> A { pub mk; pub get } };
  pub type Later[A] = Seed[A] & Branch[A]
}

rec {
  pub type { Left[A]: (Second[A] -> A) -> A { pub mk; pub get } };
  pub type { Right[A]: (First[A] -> A) -> A { pub mk; pub get } };
  pub type First[A] = Seed[A] & Left[A];
  pub type Second[A] = Seed[A] & Right[A]
}

pub fn later_seed[A](row: Later[A]) -> A {
  row.>select { Seed.get[A] }
}

pub fn later_branch[A](row: Later[A], next: Later[A] -> A) -> A {
  let function = row.>select { Branch.get[A] };
  function(next)
}

pub fn first_seed[A](row: First[A]) -> A {
  row.>select { Seed.get[A] }
}

pub fn first_left[A](row: First[A], next: Second[A] -> A) -> A {
  let function = row.>select { Left.get[A] };
  function(next)
}

pub fn second_seed[A](row: Second[A]) -> A {
  row.>select { Seed.get[A] }
}

pub fn second_right[A](row: Second[A], next: First[A] -> A) -> A {
  let function = row.>select { Right.get[A] };
  function(next)
}
