pure fn one_sum_natural_result(ct: __Comptime__, source: __Type__, value: __Checked_term__) -> Macro_result {
  let target =
    __type_sum_spine_fold__(ct)[__Type__](
    , source
    , __type_bottom__(ct)
    , .(selected: __Type__, arm: __Type__) -> __Type__ {
        __comptime_if_then_else__(ct)(
        , __type_equal__(ct, selected, __type_bottom__(ct))
        , .() -> __Type__ { arm }
        , .() -> __Type__ { selected }
        )
      }
    );
  one_sum_impl(ct, source, value, target)
}

