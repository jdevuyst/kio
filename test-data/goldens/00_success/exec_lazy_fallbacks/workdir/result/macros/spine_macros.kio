pure fn one_sum_impl(ct: __Comptime__, source: __Type__, value: __Checked_term__, target: __Type__) -> Macro_result {
  let source_spine = sum_spine(ct, source);
  let target_spine = sum_spine(ct, target);
  __comptime_if_then_else__(ct)(
  , __type_is_sum_root__(ct, target)
  , .() -> Macro_result { err(ct, __"one_sum target must not be a top-level sum"__(ct)) }
  , .() -> Macro_result {
      __either__[Route_list][__Diagnostic_text__][Macro_result](
      , route_source_arms_collapse(ct, source_spine, target_slots(ct, target_spine))
      , .(routes: Route_list) -> Macro_result {
          build_sum_from_routes(ct, source_spine, target, target_spine, routes, value)
