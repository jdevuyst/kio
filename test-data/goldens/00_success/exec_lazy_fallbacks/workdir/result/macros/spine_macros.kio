pure fn bind_product_target(
, ct: __Comptime__
, source: __Type__
, value: __Checked_term__
, target: __Type__
, build: __Checked_term__ -> __Checked_term__
) -> __Checked_term__ {
  __comptime_if_then_else__(ct)(
  , __type_equal__(ct, target, __type_unit__(ct))
  , .() -> __Checked_term__ { build(value) }
  , .() -> __Checked_term__ { __term_let__(ct, source, value, build) }
  )
}

