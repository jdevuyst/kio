mod testapi/main;

import macros/match { macro match }
import testapi { type String }
import testapi/io { fn print }

fn identity[A](value: A) -> A { value }

fn classify() -> String {
  match(identity("ignored"[String])) {
    .[A](_value: A) { "matched scalar call\n" }
  }
}

pub fn main() { print(classify()) }
