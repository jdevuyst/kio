mod testapi/main;

import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type I32; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

// `match` derives its result type from the clauses. Both arms here
// return `String`, so the direct result type is `String`.
fn render(v: I32 | String) -> String {
  match(v) {
    (.(n: I32) { int_to_string(n) }, .(s: String) { s })
  }
}

pub fn main() { print(render(widen_sum("match! derived: ok\n"[String]))) }
