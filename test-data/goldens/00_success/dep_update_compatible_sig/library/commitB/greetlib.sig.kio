signature greetlib v(3);

/// v1: first + second
v(1) {
  nonbreaking {
    add {
      module greet {
        pub fn first[A](x: A, _y: A) -> A;
        pub fn second[A](_x: A, y: A) -> A
      }
    }
  }
}

/// v2: add third
v(2) {
  nonbreaking {
    add {
      module greet {
        pub fn third[A](x: A, _y: A, _z: A) -> A
      }
    }
  }
}
