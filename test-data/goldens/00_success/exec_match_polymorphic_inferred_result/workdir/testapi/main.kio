module testapi/main;

import macros/match(macro match);
import macros/spine_macros(macro widen_sum);
import testapi(default I32, default String);
import testapi/io(print);

newtype Box[A] : A { constructor box; projector unbox }

fn label[A](value: Box(A)) -> String { "matched\n" }

fn handle(value: Box(I32) | Box(String)) -> String {
  match(value) {
    .[A](boxed: Box(A)) { label(boxed) }
  }
}

pub fn main() { print(handle(widen_sum(Box.box(42)))); print(handle(widen_sum(Box.box("text")))) }
