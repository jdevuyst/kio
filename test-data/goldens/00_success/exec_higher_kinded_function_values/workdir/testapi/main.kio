mod testapi/main;

import testapi { type String }
import testapi/io { fn print }

type { Box[A]: A { mk; get } }

type Apply[*F] = F[String] -> F[String];

type Scheme = [*F] Apply[F];

rec type { Recursive: . | (([*F] F[String] -> F[String]) & Recursive) { mk; get } }

type { Existential <U>: U & ([*F] F[U] -> F[U]) { mk; get } }

fn through_anonymous_scheme(value: Box[String]) -> String {
  let keep = .(function: Scheme) -> Scheme { function };
  let same = keep(.[*F](item: F[String]) -> F[String] { item });
  let applied = same[Box](value);
  Box.get[String](applied)
}

pub fn main() { print(through_anonymous_scheme(Box.mk[String]("structural hkt\n"[String]))) }
