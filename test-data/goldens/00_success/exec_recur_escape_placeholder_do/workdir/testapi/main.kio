module testapi/main;

import elab/control(if);
import elab/sequence(do);
import testapi(Bool, I32, String);
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter as iter;

rec(iter.loop_reentry) fn placeholder(remaining: I32) -> I32 -> I32 {
  if! arith.leq_i32(remaining, 0) {
    .value. { value1 }
  } else {
    .value. { recur(escape) placeholder(arith.sub_i32(remaining, 1))(arith.add_i32(value1, 1)) }
  }
}

type Deferred[A] = . -> A;

fn chain[A][B](action: Deferred(A), next: A -> Deferred(B)) -> Deferred(B) {
  .() { next(action())() }
}

rec(iter.loop_reentry) fn sequenced(remaining: I32) -> Deferred(I32) {
  if! arith.leq_i32(remaining, 0) {
    .() { 41 }
  } else do! chain {
    let _unit <- .() { io.print("bind\n") };
    recur(escape) sequenced(arith.sub_i32(remaining, 1))
  }
}

pub fn main() {
  let saved_placeholder = placeholder(2);
  let saved_do = sequenced(2);
  io.print("ready\n");
  io.print(fmt.i32_to_string(saved_placeholder(5)));
  io.print("\n");
  io.print(fmt.i32_to_string(saved_placeholder(6)));
  io.print("\n");
  io.print(fmt.i32_to_string(saved_do()));
  io.print("\n");
  io.print(fmt.i32_to_string(saved_do()));
  io.print("\n")
}
