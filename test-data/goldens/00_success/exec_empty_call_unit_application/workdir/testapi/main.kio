mod testapi/main;

import testapi { type String }
import testapi/io { fn print }

fn identity[A](value: A) -> A { value }

fn accept_unit(_value: .) -> String { "unit application: ok\n" }

fn apply_unit(function: . -> .) { function(()) }

pub fn main() { let message = accept_unit(identity()); apply_unit(identity[_]); print(message) }
