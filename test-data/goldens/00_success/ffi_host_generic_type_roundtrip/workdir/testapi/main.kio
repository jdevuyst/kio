mod testapi/main;

import testapi { type Box; type I32; type String }
import testapi/arith { fn box_get; fn box_make }
import testapi/fmt { fn i32_to_string }
import testapi/io { fn print }

fn keep[T](b: Box[T]) -> Box[T] { b }

pub fn main() {
  let b = keep(box_make(42[I32]));
  print(i32_to_string(box_get(b)));
  print("\n"[String])
}
