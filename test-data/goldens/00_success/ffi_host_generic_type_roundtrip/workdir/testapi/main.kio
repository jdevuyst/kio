module testapi/main;

import testapi(Box, I32, String);
import testapi/arith(box_get, box_make);
import testapi/fmt(i32_to_string);
import testapi/io(print);

fn keep[T](b: Box(T)) -> Box(T) { b }

pub fn main() -> . {
  let b = keep(box_make(42(I32)));
  print(i32_to_string(box_get(b)));
  print("\n"(String))
}
