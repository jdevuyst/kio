mod testapi/main;

import testapi { type String }
import testapi/io as io;

type { Box <U>: [A] (String & A) -> U { mk; get } }

fn make_box() -> Box {
  Box.mk(.[A](text: String, _value: A) -> String { io.print(text); ""[String] })
}

fn invoke(box: Box) {
  Box.get(box)(.[U](function: [A] (String & A) -> U) {
    let _hidden = function[.](("existential function payload ok\n"[String], ()));
    ()
  })
}

pub fn main() { invoke(make_box()) }
