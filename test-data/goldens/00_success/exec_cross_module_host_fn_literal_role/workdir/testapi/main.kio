/// Contextually inferred integer literals retain the imported I32 identity across the
/// host-call boundary and Kio' emission. The sibling qualified case retains
/// the module-qualified spelling of the same carrier.
mod testapi/main;

import testapi { type I32 }
import testapi/arith { fn add_i32 }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

pub fn main() { print(int_to_string(add_i32(40, 2))) }
