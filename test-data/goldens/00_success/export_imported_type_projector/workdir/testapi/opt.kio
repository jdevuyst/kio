module testapi/opt;

import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(String);
import testapi/io(print);
import testapi/text(string_concat);

// `Option(String)` as `String | .`: the `String` arm carries a
// present value, the `()` arm is absence. Exposed with a public
// constructor `mk_opt` and projector `un_opt` so another module can
// import the type and destructure it through the type name.
pub newtype Opt : String | . { pub constructor mk_opt; pub projector un_opt }

pub fn some(v: String) -> Opt { Opt.mk_opt(widen_sum!(v)) }

pub fn none() -> Opt { Opt.mk_opt(widen_sum!(())) }

// Render an already-projected `Opt` payload (`String | .`). The
// caller does the projection through the imported type
// (`value.>Opt.un_opt`); this helper renders the resulting sum.
pub fn show(payload: String | .) -> . {
  print(string_concat(
    , match! payload {
        (.(s: String) { string_concat("some(", string_concat(s, ")")) }, .(_empty: .) { "none" })
      }
    , "\n"
    ))
}
