mod testapi/opt;

import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type String }
import testapi/io { fn print }
import testapi/text { fn string_concat }

// `Option(String)` as `String | .`: the `String` arm carries a
// present value, the `()` arm is absence. Exposed with a public
// constructor `mk` and projector `get` so another module can
// import the type and destructure it through the type name.
pub type { Opt: String | . { pub mk; pub get } }

pub fn some(v: String) -> Opt { Opt.mk(widen_sum(v)) }

pub fn none() -> Opt { Opt.mk(widen_sum(())) }

// Render an already-projected `Opt` payload (`String | .`). The
// caller does the projection through the imported type
// (`value.>Opt.get`); this helper renders the resulting sum.
pub fn show(payload: String | .) {
  print(string_concat(
  , match(payload) {
      (.(s: String) { string_concat("some(", string_concat(s, ")")) }, .(_empty: .) { "none" })
    }
  , "\n"
  ))
}
