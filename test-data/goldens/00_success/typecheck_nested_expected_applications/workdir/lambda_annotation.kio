module lambda_annotation;

host type Witness;

host fn make[A]() -> A;

fn consume[T](_f: T -> T) -> . { () }

fn consume_binder[T](_f: [A] (A & T) -> T, _value: T) -> . { () }

fn consume_pair[P][R](_f: P -> R, _value: P) -> . { () }

fn annotation_pins_outer_type() -> . { consume(.(value: Witness) { make() }) }

fn annotation_pins_outer_type_with_return_placeholder() -> . {
  consume(.(value: Witness) -> _ { make() })
}

fn explicit_binder_parameter_waits_for_later_sibling(value: Witness) -> . {
  consume_binder(.[C](item, carried) { carried }, value)
}

fn parameter_spine_waits_for_later_sibling(left: Witness, right: Witness) -> . {
  consume_pair(.(first, _second) { first }, (left, right))
}
