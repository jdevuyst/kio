module testapi/main;

import macros/match(macro match);
import macros/row_macros(macro record_, macro select);
import macros/spine_macros(macro widen_sum);
import testapi(String);
import testapi/io as io;

type Version = { Value: String; Stamp: String };

type { Tail: String }

fn catchall(input: . | (Version & Tail)) {
  match(input) {
    .(_all: .) { io.print("catchall\n") }
  }
}

fn product_first(input: . | (Version & Tail)) {
  match(input) {
    .(head: Version, rest: Tail) {
      io.print(head.>select { Value.get });
      io.print(head.>select { Stamp.get });
      io.print(rest.>select { Tail.get })
    };
    .(_empty: .) { io.print("empty\n") }
  }
}

pub fn main() {
  let empty = widen_sum(())[. | (Version & Tail)];
  let packet =
    widen_sum((record_ { Value.mk("value\n"); Stamp.mk("stamp\n") }, Tail.mk("tail\n")))[| .
    | (Version & Tail)];
  catchall(empty);
  catchall(packet);
  product_first(empty);
  product_first(packet)
}
