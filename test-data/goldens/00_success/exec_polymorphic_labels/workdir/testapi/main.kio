mod testapi/main;

import testapi { type I32; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

// The polymorphic nominal `Show[A]` carries a function `A -> String`
// and is reachable in type position with the same parameterisation.
pub type { Show[A]: A -> String }

// Build the dictionary using `Show.mk`. The typer infers its leading
// type-arg from
// the value-arg's type, the same way it does for tuple-literal
// `__pair__` desugaring (specs/language.md § Type flow,
// "surface forms that desugar to polymorphic intrinsic calls
// with elided type arguments"). Two instantiations: `Show(I32)`
// and `Show(String)`, exercising both inference paths.
fn make_int_show() -> Show[I32] { Show.mk(int_to_string) }

fn opaque_string(s: String) -> String { s }

fn make_string_show() -> Show[String] { Show.mk(opaque_string) }

pub fn main() {
  let int_dict = make_int_show();
  // `Show.get(int_dict)` projects the polymorphic payload
  // out of the dictionary and instantiates it at I32; the result
  // is `I32 -> String`.
  let ints = Show.get(int_dict);
  print(ints(7));
  print("\n");
  let str_dict = make_string_show();
  let strs = Show.get(str_dict);
  print(strs("hello"))
}
