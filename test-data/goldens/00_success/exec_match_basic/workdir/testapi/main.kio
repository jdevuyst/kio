module testapi/main;

import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(I32, String);
import testapi/fmt(int_to_string);
import testapi/io(print);

// Basic `match!` over a sum scrutinee.
//
// The scrutinee `(I32 | String)` has two arms. The clauses dispatch
// each arm:
//   - .(n: I32) handles the I32 branch — print the int.
//   - .(s: String) handles the String branch — print the string
//     directly.
// Both clause bodies have type `.`, so the match's overall type is
// `.`. A later `let _r = ...;` binds and discards it.
fn handle(v: I32 | String) -> . {
  let _r =
    match! v {
      (.(n: I32) { print(int_to_string(n)) }, .(s: String) { print(s) })
    };
  ()
}

pub fn main() -> . { handle(widen_sum!("matched right\n")) }
