module testapi/main;

import testapi(String);
import testapi/io(print);

// The nominal `A` is shadowed by a type-parameter `[A]` in each
// declaration below. The binder determines every use in its scope.
type { A: String }

// The function signature `[A]` shadows the nominal in parameter and return types.
fn id_fn[A](x: A) -> A { x }

// The alias header `[A]` shadows the nominal in the body.
type Id[A] = A;

fn use_id(x: Id[String]) -> Id[String] { x }

// The nominal header `[A]` shadows the outer nominal in the payload.
type { Wrap[A]: A { pub mk; pub get } }

fn make_wrap(s: String) -> Wrap[String] { Wrap.mk(s) }

fn open_wrap(w: Wrap[String]) -> String { Wrap.get(w) }

// A function-type `[A] A -> A` binder shadows the outer nominal
// inside the annotation; the declaration is elaborated and typechecked.
fn via_forall(g: [A] A -> A, s: String) -> String { g(s) }

pub fn main() {
  print(id_fn("via-fn-param\n"));
  print(use_id("via-alias\n"));
  print(open_wrap(make_wrap("via-newtype\n")))
}
