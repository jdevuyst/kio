module testapi/main;

import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(String);
import testapi/io as io;

labels Version = { value: String, stamp: String };

labels { tail: String, other: String };

fn handle(input: . | Other | (Version & Tail)) -> . {
  match! input {
    .(unrelated: Other) { io.print(unrelated.?{other}) };
    .(head: Version, rest: Tail) {
      io.print(head.?{value});
      io.print(head.?{stamp});
      io.print(rest.?{tail})
    };
    .(_empty: .) { io.print("empty\n") }
  }
}

pub fn main() -> . {
  handle(widen_sum!((), . | Other | (Version & Tail)));
  handle(widen_sum!({other = "other\n"}, . | Other | (Version & Tail)));
  handle(widen_sum!(
    , ({value = "value\n", stamp = "stamp\n"}, {tail = "tail\n"})
    , . | Other | (Version & Tail)
    ))
}
