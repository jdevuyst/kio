mod testapi/main;

import macros/match { macro match }
import macros/row_macros { macro record_; macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type String }
import testapi/io as io;

type Version = { Value: String; Stamp: String };

type { Tail: String; Other: String }

fn handle(input: . | Other | (Version & Tail)) {
  match(input) {
    .(unrelated: Other) {
      io.print(unrelated.>select { Other.get })
    };
    .(head: Version, rest: Tail) {
      io.print(head.>select { Value.get });
      io.print(head.>select { Stamp.get });
      io.print(rest.>select { Tail.get })
    };
    .(_empty: .) { io.print("empty\n") }
  }
}

pub fn main() {
  handle(widen_sum(())[. | Other | (Version & Tail)]);
  handle(widen_sum(Other.mk("other\n"))[. | Other | (Version & Tail)]);
  handle(widen_sum((record_ { Value.mk("value\n"); Stamp.mk("stamp\n") }, Tail.mk("tail\n")))[| .
  | Other
  | (Version & Tail)])
}
