mod testapi/main;

import macros/match { macro match }
import testapi/io { fn print }

type { A: . { mk; get } }

type { B: . { mk; get } }

fn source() -> A & B { print("source\n"); (A.mk(()), B.mk(())) }

fn clause(a: A, b: B) { A.get(a); B.get(b); print("body\n") }

pub fn main() {
  match(source()) { clause }
}
