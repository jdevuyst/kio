/// A polymorphic value remains staged inside an actively constructed record.
mod testapi/main;

import __intrinsics__;

host fn observe(_unit: .);

host fn consume(_unit: .);

type { Payload: [A] . { mk; get }; Marker: . { mk; get } }

fn named[A] { observe() }

fn nested[A] -> [B] . {
  observe();
  .[B] { consume() }
}

fn adjacent[A][B] { consume() }

fn explicit[A]() { consume() }

fn bundle() -> Payload & Marker { (Payload.mk(named), Marker.mk(())) }

pub fn main() {
  consume();
  let saved = named;
  consume();
  saved[.];
  let inner = nested[.];
  consume();
  inner[.];
  let later = adjacent[.];
  observe();
  later[.];
  let thunk = explicit[.];
  observe();
  thunk();
  let record = bundle();
  consume();
  let stored = Payload.get(__fst__[Payload][Marker](record));
  consume();
  stored[.];
  .(_marker: .) { consume() }(Marker.get(__snd__[Payload][Marker](record)))
}
