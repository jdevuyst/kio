mod core/mutual;

rec {
  pub type { Left[A]: (Right[A] -> A) -> A { pub mk; pub get } };
  pub type { Right[A]: (Left[A] -> A) -> A { pub mk; pub get } }
}

pub fn read_left[A](value: Left[A], next: Right[A] -> A) -> A { Left.get(value)(next) }

pub fn read_right[A](value: Right[A], next: Left[A] -> A) -> A { Right.get(value)(next) }
