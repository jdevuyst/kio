module testapi/main;

import macros/match(macro match);
import testapi(String);
import testapi/io(print);

// The named nominal declaration introduces the product alias and its
// component types. The body constructs the pair, then unwraps its second component.
type Pair = { First: String; Second: String };

fn second_of(p: Pair) -> Second {
  match(p) {
    .(_first_slot: First, second_slot: Second) { second_slot }
  }
}

pub fn main() {
  let p = (First.mk("skipped\n"), Second.mk("shown\n"));
  print(Second.get(second_of(p)))
}
