mod testapi/main;

import macros/sequence { macro do }
import testapi { type String }
import testapi/io { fn print }
import testapi/text { fn string_concat }

// The canonical brand: payload exactly equals the type-parameter,
// so crossing through `Identity.mk` / `Identity.get` is a
// runtime identity at every target.
pub type { Identity[A]: A { pub mk; pub get } }

// A `Monad[*F]` instance with a polymorphic-function payload.
// The bind function is the canonical bind shape, parameterised over
// the carrier types `[A]` and `[B]`. Projecting the instance with
// `Monad.get(monad)` gives a value whose polymorphism survives
// — a valid `do`-block receiver against any brand `f` and any
// payload pair `(a, b)`.
pub type { Monad[*F]: [A][B] (F[A] & (A -> F[B])) -> F[B] { pub mk; pub get } }

// `Identity`'s monad instance. Peel the input via `Identity.get`
// (a runtime identity since the carrier *is* `a`) and hand the
// payload to the continuation, which returns an already-branded
// value. No re-injection step is needed in the body — `k`'s
// return type matches the bind function return type directly.
fn identity_monad() -> Monad[Identity] {
  Monad.mk(.[A][B](m, k) { k(Identity.get(m)) })
}

// A `do`-block over `Monad.get(monad)`. Two binds
// thread a `String` payload, with a pure-let middle step. The
// block desugars to nested `Monad.get(monad)(payload,
// .(...) {...})` calls at the Kio' boundary.
fn use_instance() -> String {
  let monad = identity_monad();
  let seed = Identity.mk("monad on identity"[String]);
  let result =
    do(Monad.get(monad)) {
      let prefix <- seed;
      let middle = " ok"[String];
      let trailed <- Identity.mk(string_concat(prefix, middle));
      Identity.mk(string_concat(trailed, "\n"[String]))
    };
  Identity.get(result)
}

pub fn main() { print(use_instance()) }
