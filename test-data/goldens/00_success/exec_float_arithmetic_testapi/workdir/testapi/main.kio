module testapi/main;

import testapi(F32, F64, String);
import testapi/arith(add_f32, add_f64, mul_f64, sub_f64);
import testapi/fmt(f32_to_string, f64_to_string);
import testapi/io(print);

fn print_f32(n: F32) -> . { let s = f32_to_string(n); let l = print(s); print("\n"(String)) }

fn print_f64(n: F64) -> . { let s = f64_to_string(n); let l = print(s); print("\n"(String)) }

pub fn main() -> . {
  let a = print_f64(add_f64(0.5(F64), 0.25(F64)));
  let b = print_f64(sub_f64(0.5(F64), 0.25(F64)));
  let c = print_f64(mul_f64(0.5(F64), 0.5(F64)));
  print_f32(add_f32(0.25(F32), 0.5(F32)))
}
