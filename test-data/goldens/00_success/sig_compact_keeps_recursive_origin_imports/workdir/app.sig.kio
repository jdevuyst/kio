signature app v(3);

v(1) {
  with {
    module api {
      import left as dep;
      pub rec type { Left: dep.Token | Left { pub mk; pub get } }
    }
  };
  breaking {
    add {
      module left {
        host type Token
      }
    }
  };
  nonbreaking {
    add {
      api.Left
    }
  }
}

v(2) {
  with {
    module api {
      import right as dep;
      pub rec type { Right: dep.Token | Right { pub mk; pub get } }
    }
  };
  breaking {
    add {
      module right {
        host type Token
      }
    }
  };
  nonbreaking {
    add {
      api.Right
    }
  }
}
