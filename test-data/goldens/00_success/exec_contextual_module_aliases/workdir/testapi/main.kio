module testapi/main;

import testapi(String);
import testapi/io(print);
import testapi/provider as do;
import testapi/provider as if;

fn apply(f: String -> String, value: String) -> String { f(value) }

pub fn main() {
  print(if.identity("qualified call\n"(String)));
  let bound = do.identity;
  print(bound("bound value\n"(String)));
  print(apply(if.identity, "call argument\n"(String)))
}
