module testapi/main;

import macros/match(macro match);
import testapi(String);
import testapi/io(print);

// The local binding determines the returned value.
fn via_let(s: String) -> String { let mid = s; mid }

// The function parameter determines the returned value.
fn via_param(hed: String) -> String { hed }

// The match-clause parameter determines the returned value.
fn via_clause(s: String) -> String {
  match(s) {
    .(tal: String) { tal }
  }
}

pub fn main() {
  print(via_let("via-let\n"));
  print(via_param("via-param\n"));
  print(via_clause("via-clause\n"))
}
