module testapi/main;

import macros/row_macros(macro record, macro select);
import testapi(I32, String);
import testapi/fmt(print_i32);
import testapi/io(print);

type { Box[A]: (A -> A) -> A { mk; get }; First[A]: A { mk; get }; Second[A]: A { mk; get } }

fn mark(tag: String, value: I32) -> I32 { print(tag); value }

fn constructed() -> Second[I32] & First[I32] {
  record { First.mk(mark("A", 1)); Second.mk(mark("B", 2)) }
}

fn direct() -> Second[I32] & First[I32] {
  let first = First.mk(mark("C", 3));
  let second = Second.mk(mark("D", 4));
  (second, first)
}

pub fn main() {
  let chosen = Box.mk(.(_identity: I32 -> I32) { 7 });
  print_i32(Box.get(chosen)(.(value: I32) { value }));
  let row = constructed();
  print_i32(row.>select { First.get[I32] });
  print_i32(row.>select { Second.get[I32] });
  let comparison = direct();
  print_i32(comparison.>select { First.get[I32] });
  print_i32(comparison.>select { Second.get[I32] });
  print("\n")
}
