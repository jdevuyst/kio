mod build_recursive_newtype_boundary/main;

import __intrinsics__;

import build_recursive_newtype_boundary { type I32 }

rec {
  pub type { Tree: I32 | Forest { pub mk; pub get } };
  pub type { Forest: . | (Tree & Forest) { pub mk; pub get } }
}

pub fn leaf(n: I32) -> Tree { Tree.mk(__left__[I32][Forest](n)) }

pub fn node(f: Forest) -> Tree { Tree.mk(__right__[I32][Forest](f)) }

pub fn empty() -> Forest { Forest.mk(__left__[.][Tree & Forest](())) }

pub fn graft(t: Tree, f: Forest) -> Forest { Forest.mk(__right__[.][Tree & Forest]((t, f))) }

// Walk into the forest's first tree and return its leaf value, or the
// default when the forest is empty or the first tree is itself a node.
pub fn first_leaf(d: I32, f: Forest) -> I32 {
  __either__[.][Tree & Forest][I32](
  , Forest.get(f)
  , .(_e: .) -> I32 { d }
  , .(cell: Tree & Forest) -> I32 {
      __either__[I32][Forest][I32](
      , Tree.get(__fst__[Tree][Forest](cell))
      , .(n: I32) -> I32 { n }
      , .(_sub: Forest) -> I32 { d }
      )
    }
  )
}

pub fn main() { () }
