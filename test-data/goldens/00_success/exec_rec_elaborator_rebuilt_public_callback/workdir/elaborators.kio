module elaborators;

import __intrinsics__;

import __comptime__;
import testapi(Bool);

pure fn choose_callbacks_impl(
  , ct: __Comptime__
  , fills: __Fill_ctx__
  , condition: __Checked_term__
  , required: __Checked_term__
  ) -> __Checked_term__ & __Fill_ctx__ {
  let unit_type = __reflect_type__(ct, .);
  let zero = __type_arity_zero__(ct);
  let callback_type = __type_arrow__(ct, unit_type, zero, unit_type);
  let fallback =
    __term_fn__(
      , ct
      , callback_type
      , .(_unit: __Checked_term__) -> __Checked_term__ { __term_unit__(ct) }
      );
  let result =
    __intrinsic_if_then_else__(
      , ct
      , unit_type
      , condition
      , .() -> __Checked_term__ {
          let fallback_with_unused_required =
            __term_let__(
              , ct
              , callback_type
              , required
              , .(_unused: __Checked_term__) -> __Checked_term__ { fallback }
              );
          __term_call__(ct, callback_type, fallback_with_unused_required, __term_unit__(ct))
        }
      , .() -> __Checked_term__ { __term_call__(ct, callback_type, required, __term_unit__(ct)) }
      );
  (result, fills)
}

pub elab choose_callbacks : Bool -> (. -> .) -> . { impl(fills) choose_callbacks_impl }
