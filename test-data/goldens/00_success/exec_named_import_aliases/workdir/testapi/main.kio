mod testapi/main;

import provider { type Duo as Pair; type Plain as Alias; fn echo as say; fn echo as tell }
import testapi { type String as Also_text; type String as Text }
import testapi/io { fn print as again; fn print as write }

fn first(left: Alias, _right: Alias) -> Text { left }

fn partial[*F](value: F[Text]) -> F[Text] { value }

pub fn main() {
  let wrapped = partial[Pair[Text]](Pair.mk[Text][Text]("core\n"[Text], ""[Text]));
  write(say(first(Pair.get[Text][Text](wrapped))));
  let send = again;
  send(tell("again\n"[Also_text]))
}
