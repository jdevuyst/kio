module testapi/main;

import macros/algebraic_macros(macro align);
import macros/control(macro if);
import macros/spine_macros(macro widen_sum);
import testapi(Bool, String);
import testapi/io(print);

// The branches explicitly construct `String | String`; `align`
// collapses to `String`, payload preserved (only the arm tag is
// dropped).
fn pick(b: Bool) -> String {
  align(if(b) {
    widen_sum("collapsed\n"[String])[String | String]
  } else {
    widen_sum("collapsed\n"[String])[String | String]
  })
}

pub fn main() { print(pick(.t)) }
