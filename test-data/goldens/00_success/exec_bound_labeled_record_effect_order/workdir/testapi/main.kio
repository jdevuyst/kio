mod testapi/main;

import macros/row_macros { macro select }
import testapi { type I32; type String }
import testapi/arith { fn add_i32 }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

type { First: I32 { mk; get }; Second: I32 { mk; get }; Third: I32 { mk; get } }

type Row_fields = First & Second & Third;

type Row = First & Second & Third;

fn mark(label: String, value: I32) -> I32 { print(label); value }

fn sum_bound_record(offset: I32) -> I32 {
  let row = (First.mk(mark("A", 1)), Second.mk(mark("B", 2)), Third.mk(mark("C", 3)));
  let later = mark("D", 4);
  add_i32(
  , add_i32(offset, row.>select { First.get })
  , add_i32(row.>select { Second.get }, add_i32(row.>select { Third.get }, later))
  )
}

pub fn main() {
  let total = sum_bound_record(0);
  print("=");
  print(int_to_string(total));
  print("\n")
}
