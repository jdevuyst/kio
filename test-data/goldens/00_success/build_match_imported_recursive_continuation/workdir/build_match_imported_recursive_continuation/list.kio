mod build_match_imported_recursive_continuation/list;

import macros/spine_macros { macro widen_sum }

pub rec type { List[A]: . | (A & List[A]) { pub mk; pub get } }

pub type Copied[A] = List[A];

pub fn nil[A]() -> List[A] { List.mk(widen_sum(())[. | (A & List[A])]) }

pub fn cons[A](head: A, tail: List[A]) -> List[A] {
  List.mk(widen_sum((head, tail))[. | (A & List[A])])
}
