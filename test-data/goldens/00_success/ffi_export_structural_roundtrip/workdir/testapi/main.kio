module testapi/main;

import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(Bool, I16, I32, I64, I8, String, U16, U32, U64, U8);
import testapi/fmt(int_to_string);

pub type Wide_product = I32 & I32 & I32 & I32 & I32 & I32 & I32 & I32 & I32 & I32 & I32 & I32;

pub type Wide_sum = I8 | I16 | I32 | I64 | U8 | U16 | U32 | U64 | Bool | String;

pub fn pair_swap((n: I32, s: String)) -> String & I32 { (s, n) }

pub fn dispatch_left(s: I32 | String) -> String {
  match! s {
    (.(n: I32) { int_to_string(n) }, .(t: String) { t })
  }
}

pub fn rotate((
  , a: I32
  , b: I32
  , c: I32
  , d: I32
  , e: I32
  , f: I32
  , g: I32
  , h: I32
  , i: I32
  , j: I32
  , k: I32
  , l: I32
  )) -> Wide_product { (l, a, b, c, d, e, f, g, h, i, j, k) }

pub fn classify(value: Wide_sum) -> I32 {
  match! value {
    (
      , .(_v: I8) { 1(I32) }
      , .(_v: I16) { 2(I32) }
      , .(_v: I32) { 3(I32) }
      , .(_v: I64) { 4(I32) }
      , .(_v: U8) { 5(I32) }
      , .(_v: U16) { 6(I32) }
      , .(_v: U32) { 7(I32) }
      , .(_v: U64) { 8(I32) }
      , .(_v: Bool) { 9(I32) }
      , .(_v: String) { 10(I32) }
      )
  }
}

pub fn echo_sum(value: Wide_sum) -> Wide_sum { value }

pub fn choose_first() -> Wide_sum { widen_sum!(1(I8), Wide_sum) }

pub fn choose_middle() -> Wide_sum { widen_sum!(5(U8), Wide_sum) }

pub fn choose_last() -> Wide_sum { widen_sum!("ten"(String), Wide_sum) }
