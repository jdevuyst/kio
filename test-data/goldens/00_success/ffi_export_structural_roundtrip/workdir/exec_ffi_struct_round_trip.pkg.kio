package exec_ffi_struct_round_trip;

build {
  cache "out/.kio-cache/";

  target js {
    out "out/js/"
  };

  target ts {
    out "out/ts/"
  };

  target python {
    out "out/python/"
  };

  target java {
    out "out/java/"
  };

  target rust {
    out "out/rust/"
  };

  target go {
    out "out/go/"
  };

  target swift {
    out "out/swift/"
  };

  target haskell {
    out "out/haskell/"
  }
}

bridge {
  testapi;
  testapi/**;
  elab/testapi
}
