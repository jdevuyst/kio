module main;

import macros/sequence(macro do);

type { Left: . { mk; get } }

type { Right: . { mk; get } }

type { Box[A]: A { mk; get } }

fn pure[A](value: A) -> Box[A] { Box.mk(value) }

fn choose_second[A](first: A, second: Right) -> Box[Right] {
  do(.[A][B](value: Box[A], next: A -> Box[B]) -> Box[B] { next(Box.get(value)) }) {
    let first_value <- pure(first);
    let second_value <- pure(second);
    pure(second_value)
  }
}

pub fn main() { choose_second(Left.mk(), Right.mk()).>Box.get.>Right.get }
