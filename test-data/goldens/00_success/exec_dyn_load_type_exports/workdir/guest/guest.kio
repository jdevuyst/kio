module guest;

import hostapi(I32, Resource, add_i32);
import internal(bump);

pub type Twin[A] = A & A;

pub type { Box[A]: A { pub mk; pub get } }

pub type { Sealed <U>: I32 & U { pub mk; pub get } }

pub type { Outer[A][B] <U>: (A & B) & U { pub mk; pub get } }

pub type { Free <U>: Resource & U { pub mk; pub get } }

pub type { Token: I32 { pub mk; pub(guest) get } }

pub type { Mirror[A]: Twin[A] { pub mk; pub get } }

pub(guest) type { Leak: I32 { pub mk; pub get } }

pub fn seal(n: I32) -> Sealed { Sealed.mk((n, bump(n))) }

pub(guest) fn hidden_fn(n: I32) -> I32 { bump(n) }
