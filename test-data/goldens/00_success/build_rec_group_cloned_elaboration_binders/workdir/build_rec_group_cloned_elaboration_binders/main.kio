mod build_rec_group_cloned_elaboration_binders/main;

import build_rec_group_cloned_elaboration_binders {
  type Bool;
  type I32;
  type String;
  fn done;
  fn empty;
  fn loop
}
import macros/control { macro if }

rec(loop) {
  pub fn spaces(n: I32) -> String { recur pad(n, empty()) };
  fn pad(n: I32, acc: String) -> String {
    if(done(n)) { acc } else { recur pad(n, acc) }
  }
}
