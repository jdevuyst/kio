module recursive;

pub rec type Label_list[A] = { Nil[A]: . } | { Cons[A]: A & Label_list[A] };

rec {
  pub type Chain[A] = . | Chain_node[A];
  pub type { Chain_node[A]: A & Chain[A] { pub mk; pub get } }
}

rec {
  pub type { Tree: . | Forest { pub mk; pub get } };
  pub type { Forest: . | Tree { pub mk; pub get } }
}
