mod testapi/main;

import testapi { type String }
import testapi/io { fn print }

// A nominal with an existential binder has a CPS-shaped projector.
// To consume the value, call `Box.get` with the boxed value and a
// continuation polymorphic over the hidden type.
type { Box[A] <U>: A & U }

fn make_box[A][U](x: A, y: U) -> Box[A] { Box.mk((x, y)) }

fn discard[A][B](_p: A & B) { () }

fn extract[A](b: Box[A]) {
  Box.get[A](b)(.[U](pair) { discard(pair) })
}

pub fn main() {
  let b = make_box("x\n"[String], "y\n"[String]);
  extract(b);
  print("labels-existential-ok\n")
}
