module testapi/main;

import testapi(String);
import testapi/io(print);

// A `labels` entry with an existential binder run desugars to a
// `newtype` whose projector is CPS-shaped. To consume the value,
// call the newtype's projector member directly through the uppercase
// nominal: `Box.get(a, b)((), .[U](pair) { ... })`.
labels { box[A] <U> : A & U };

fn make_box[A][U](x: A, y: U) -> Box(A) { Box.mk((x, y)) }

fn discard[A][B](_p: A & B) -> . { () }

fn extract[A](b: Box(A)) -> . { Box.get(A, b)(.[U](pair) { discard(pair) }) }

pub fn main() -> . { let b = make_box("x\n", "y\n"); extract(b); print("labels-existential-ok\n") }
