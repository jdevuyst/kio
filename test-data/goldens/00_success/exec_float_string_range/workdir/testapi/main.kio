mod testapi/main;

import testapi { type F32; type F64; type String }
import testapi/fmt { fn f32_to_string; fn f64_to_string }
import testapi/io { fn print }

pub fn main() {
  print(f64_to_string(18446744073709551616.0[F64]));
  print("\n"[String]);
  print(f64_to_string(-18446744073709551616.0[F64]));
  print("\n"[String]);
  print(f32_to_string(18446744073709551616.0[F32]));
  print("\n"[String]);
  print(f32_to_string(-18446744073709551616.0[F32]));
  print("\n"[String])
}
