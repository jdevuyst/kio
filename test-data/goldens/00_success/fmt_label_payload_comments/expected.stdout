mod fmt_label_payload_comments;

type { Ready: . { mk; get } }

fn construct(ready: .) -> Ready {
  record {
    Ready.mk(
    // construction leading
    , ready
    // construction trailing
    )
  }
}

fn construct_unit() -> Ready {
  record {
    Ready.mk((
    // construction unit
    ))
  }
}

fn update(row: Ready, other: .) -> Ready {
  row.>with {
    Ready.mk(
    // update leading
    , other
    // update trailing
    )
  }
}

fn update_unit(row: Ready) -> Ready {
  row.>with {
    Ready.mk((
    // update unit
    ))
  }
}

fn canonical(ready: .) -> Ready & Ready {
  (record { Ready.mk(ready) }, record { Ready.mk(()) })
}
