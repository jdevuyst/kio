module testapi/main;

import __intrinsics__;

import testapi(String);
import testapi/io(print);

pub fn pick_bool[Comptime_bool](value: Comptime_bool | Comptime_bool) -> Comptime_bool {
  __either__(
  , Comptime_bool
  , Comptime_bool
  , Comptime_bool
  , value
  , .(left: Comptime_bool) { left }
  , .(right: Comptime_bool) { right }
  )
}

pub fn pick_str[Comptime_str](value: Comptime_str | Comptime_str) -> Comptime_str {
  __either__(
  , Comptime_str
  , Comptime_str
  , Comptime_str
  , value
  , .(left: Comptime_str) { left }
  , .(right: Comptime_str) { right }
  )
}

pub fn main() {
  print(pick_bool(String, __left__(String, String, "bool\n"(String))));
  print(pick_str(String, __right__(String, String, "str\n"(String))))
}
