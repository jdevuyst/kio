module testapi/main;

import dict/dict as d;
import dict/dict(op _ => _, varop [% %]);
import elab/control(if);
import testapi(Bool, I32, String);
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/text as text;

fn compare(a: I32, b: I32) -> d.Ordering {
  if! arith.lt_i32(a, b) {
    d.lt()
  } else if! arith.eq_i32(a, b) {
    d.eq()
  } else {
    d.gt()
  }
}

fn append_entry(carry: String, key: I32, value: I32) -> String {
  text.string_concat(
    , carry
    , text.string_concat(
        , fmt.int_to_string(key)
        , text.string_concat("=", text.string_concat(fmt.int_to_string(value), ";"))
        )
    )
}

fn show(label: String, value: String) -> . {
  io.print(text.string_concat(label, text.string_concat(value, "\n")))
}

fn compare_desc(a: I32, b: I32) -> d.Ordering { compare(b, a) }

fn empty_literal() -> d.Dict(I32, I32) { [% %](compare) }

pub fn main() -> . {
  let empty = empty_literal();
  show("empty-size:", fmt.int_to_string(d.size(empty)));
  show(
    , "empty-fold:"
    , fmt.int_to_string(d.fold_asc(
        , empty
        , 17
        , .(carry: I32, _key: I32, _value: I32) -> I32 { arith.add_i32(carry, 1) }
        ))
    );
  let .(build: d.Compare(I32) -> d.Dict(I32, I32)) = [% 2 => 20, 1 => 10, 2 => 200, 3 => 30 %];
  let ascending = build(compare);
  let descending = build(compare_desc);
  show("ascending:", d.fold_asc(ascending, "", append_entry));
  show("descending:", d.fold_asc(descending, "", append_entry));
  show("bindings:", fmt.int_to_string(d.size(ascending)))
}
