module testapi/main;

import __intrinsics__;

import macros/row_macros(macro select);
import testapi(I32);
import testapi/fmt(int_to_string);
import testapi/io(print);

type { Foo: I32 { mk; get } }

pub fn main() {
  let both = Foo.mk(7).>select { Foo.get; Foo.get };
  print(int_to_string(__fst__[I32][I32](both)));
  print(int_to_string(__snd__[I32][I32](both)))
}
