mod testapi/main;

import __intrinsics__;

import testapi { type String }
import testapi/io { fn print }

// `Maybe` and `Either` as concrete type constructors.
pub type { Maybe[A]: . | A { pub mk; pub get } }

pub type { Either[E][A]: E | A { pub mk; pub get } }

// Exercises a polymorphic-fn dictionary whose stored function applies
// the abstract arity-2 binder `F` to a STRUCTURED argument `Maybe(A)`
// (mentioning the per-call binder A) alongside a bare binder `C`: the
// carrier slot is `F(Maybe(A), C)`, not a flat `F(A, C)`. The abstract
// carrier must round-trip a value whose first argument is itself a
// concrete type-constructor application.
pub type { Sid[**F]: [A][C] F[Maybe[A]][C] -> F[Maybe[A]][C] { pub mk; pub get } }

// `Either`'s instance: identity on the carrier (the value round-trips the
// typed<->erased boundary unchanged, which is what we are testing).
fn either_sid() -> Sid[Either] {
  Sid.mk[Either](.[A][C](val) { val })
}

fn use_sid() -> String {
  let dict = either_sid();
  let inner = Maybe.mk[String](__right__[.][String]("structured carrier ok\n"[String]));
  let carrier = Either.mk[Maybe[String]][String](__left__[Maybe[String]][String](inner));
  let out = Sid.get[Either](dict)[String][String](carrier);
  __either__[Maybe[String]][String][String](
  , Either.get[Maybe[String]][String](out)
  , .(m) {
      __either__[.][String][String](Maybe.get[String](m), .(u) { "empty\n"[String] }, .(s) { s })
    }
  , .(s) { s }
  )
}

pub fn main() { print(use_sid()) }
