/// Module-level doc-comment.
module fmt_doc_comments/main;

/// Docs for fn.
fn hello(s: String) -> . { print(s) }

/// Docs for alias.
type Alias = String;

/// Docs for newtype.
newtype Wrapped : String { constructor mk_wrapped; projector un_wrapped }

/// Docs for labels — named form.
labels T = { f: String };

/// Pub fn with doc.
pub fn greet(s: String) -> . { print(s) }

/// Docs for op.
op ! _ { impl hello }

// A regular line comment — not a doc-comment.
fn no_doc() -> . { () }
