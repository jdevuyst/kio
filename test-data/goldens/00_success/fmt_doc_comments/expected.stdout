mod fmt_doc_comments;

/// Docs for host type.
host type String role(str);

/// Docs for host fn.
host fn print(s: String);
/// Module-level doc-comment.
mod fmt_doc_comments/main;

/// Docs for fn.
fn hello(s: String) { print(s) }

/// Docs for alias.
type Alias = String;

/// Docs for newtype.
type { Wrapped: String { mk; get } }

/// Docs for labels — named form.
type T = { F: String };

/// Pub fn with doc.
pub fn greet(s: String) { print(s) }

/// Docs for op.
op ! _ { impl hello }

// A regular line comment — not a doc-comment.
fn no_doc() { () }
pkg fmt_doc_comments;

build {
  cache "out/.kio-cache/";

  target js {
    out "out/js/";
    baseline es2020
  };

  target ts {
    out "out/ts/";
    baseline v5_0
  }
}

bridge {
  fmt_doc_comments;
  fmt_doc_comments/**
}
