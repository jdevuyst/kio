module testapi/main;

import testapi(String);
import testapi/io(print);

// The payload names an alias, and both members are used point-free:
// the boundary etas built for the bare member values must see the
// alias's expansion, exactly as a direct call does.
type Msg = String;

newtype Box : Msg { pub constructor mk_box; pub projector un_box }

fn apply_ctor(f: Msg -> Box, x: String) -> Box { f(x) }

fn apply_proj(g: Box -> Msg, b: Box) -> Msg { g(b) }

pub fn main() -> . {
  let b = apply_ctor(Box.mk_box, "alias payload crosses"(String));
  print(apply_proj(Box.un_box, b))
}
