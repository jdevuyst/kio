mod literal_alias/main;

import literal_alias { type I32; type Str }

// Literal aliases name bare literal tokens. Each reference is
// replaced inline with the bound literal at the Surface → Desugared
// boundary.
lit greeting = "hi";

lit max_size = 100;

fn get_greeting() -> Str { greeting[Str] }

fn get_max() -> I32 { max_size[I32] }
