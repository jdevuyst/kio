mod build_closure_compound_param/main;

import build_closure_compound_param { fn build; fn step }
import build_closure_compound_param { type Bool; type I32; type Str }
import macros/match { macro match }

fn use_step() -> I32 {
  step(.(t: I32 & Str & Bool) -> I32 {
    match(t) {
      .(a: I32, _s: Str, _b: Bool) { a }
    }
  })
}

fn use_build() -> I32 {
  build(.(_n: I32) -> I32 & Str & Bool { (0, "x", .t) })
}

pub fn main() { () }
