module testapi/main;

import elab/spine_elaborators(one_prod);
import testapi(Bool, I32, String);
import testapi/io(print);

// `one_prod!` picks a value of type T from a product by finding the
// first source slot of type T. Here the source `(String & I32 &
// Bool)` has a single String slot; one_prod! locates it.
fn pick_string(p: String & I32 & Bool) -> String { one_prod!(p) }

pub fn main() -> . { let triple = ("one_prod: picked\n", 1, .t); print(pick_string(triple)) }
