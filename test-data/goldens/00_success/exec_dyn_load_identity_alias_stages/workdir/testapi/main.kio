mod testapi/main;

import loader {
  type Load_outcome;
  type Lr_diag;
  type Lr_image;
  fn diag_message;
  fn un_load_outcome
}
import loader/scan { fn load_package }
import macros/match { macro match }
import testapi { type String }
import testapi/io { fn print }
import testapi/text { fn string_concat }

fn image() -> String {
  "mod guest;\n\nimport provider as source;\n\ntype Mid[A][B] = "
  "source.Box[A][B];\ntype Alias[A][B] = Mid[A][B];\n\npub fn run() -> . & . { "
  "Alias.get[.][.](Alias.mk[.][.]((), ())) }\n\npkg alias_image;\n\nbridge { "
  "guest; provider; }\n\nmod provider;\n\npub type { Box[A][B]: A & B { pub mk; "
  "pub get; }; };\n"[String]
}

fn outcome(loaded: Load_outcome) -> String {
  match(un_load_outcome(loaded)) {
    (
    , .(_image: Lr_image) { "loaded\n"[String] }
    , .(diagnostic: Lr_diag) { string_concat(diag_message(Lr_diag.get(diagnostic)), "\n"[String]) }
    )
  }
}

pub fn main() { print(outcome(load_package(image()))) }
