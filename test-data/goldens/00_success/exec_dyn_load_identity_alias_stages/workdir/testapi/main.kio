module testapi/main;

import loader(Load_outcome, Lr_diag, Lr_image, diag_message, un_load_outcome);
import loader/scan(load_package);
import macros/match(macro match);
import testapi(String);
import testapi/io(print);
import testapi/text(string_concat);

fn image() -> String {
  "module guest;\n\nimport provider as source;\n\ntype Mid[A][B] = "
  "source.Box[A][B];\ntype Alias[A][B] = Mid[A][B];\n\npub fn run() -> . & . { "
  "Alias.get[.][.](Alias.mk[.][.]((), ())) }\n\npackage alias_image;\n\nbridge "
  "{ guest; provider; }\n\nmodule provider;\n\npub type { Box[A][B]: A & B { "
  "pub mk; pub get; }; };\n"[String]
}

fn outcome(loaded: Load_outcome) -> String {
  match(un_load_outcome(loaded)) {
    (
    , .(_image: Lr_image) { "loaded\n"[String] }
    , .(diagnostic: Lr_diag) { string_concat(diag_message(Lr_diag.get(diagnostic)), "\n"[String]) }
    )
  }
}

pub fn main() { print(outcome(load_package(image()))) }
