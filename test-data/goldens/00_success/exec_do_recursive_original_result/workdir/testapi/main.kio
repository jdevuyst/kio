mod testapi/main;

import macros/control { macro if }
import macros/sequence { macro do }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn leq_i32 }
import testapi/io { fn print }
import testapi/iter { fn loop }

type { Box[A]: A { mk; get } }

fn bind[A][B](value: Box[A], next: A -> Box[B]) -> Box[B] { next(Box.get(value)) }

rec(loop) fn go(n: I32) {
  if(leq_i32(n, 0)) {
    print("base\n")
  } else {
    Box.get(do(bind) { let next = recur(cont) go(0); let printed = print("resume\n"); Box.mk(next) })
  }
}

pub fn main() { go(1) }
