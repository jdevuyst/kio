module testapi/main;

import macros/control(macro if);
import macros/sequence(macro do);
import testapi(Bool, I32, String);
import testapi/arith(leq_i32);
import testapi/io(print);
import testapi/iter(loop);

type { Box[A]: A { mk; get } }

fn bind[A][B](value: Box[A], next: A -> Box[B]) -> Box[B] { next(Box.get(value)) }

rec(loop) fn go(n: I32) {
  if(leq_i32(n, 0)) {
    print("base\n")
  } else {
    Box.get(do(bind) { let next = recur(cont) go(0); let printed = print("resume\n"); Box.mk(next) })
  }
}

pub fn main() { go(1) }
