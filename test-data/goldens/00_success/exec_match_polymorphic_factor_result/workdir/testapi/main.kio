module testapi/main;

import macros/match(macro match);
import testapi(String);
import testapi/io as io;

type { Box[A]: A { pub mk; pub get } }

type { Tag: . }

fn project(input: Box[String] & Tag) -> String {
  match(input) {
    .[A](slot: Box[A]) -> A { slot.>Box.get }
  }
}

pub fn main() { io.print(project((Box.mk("factor-result\n"), Tag.mk(())))) }
