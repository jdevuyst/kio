mod testapi/main;

import testapi {type String}
import testapi/io {fn print}

fn base() -> String { "empty" }

fn seed(_value: String) -> String { "seeded" }

fn right(_left: String, value: String) -> String { value }

fn left(value: String, _right: String) -> String { value }

fn finish(value: String) -> String {
  print(value);
  "done"
}

op_var [* *] { finalize finish; foldl right base; };

op_var [+ +] { finalize finish; foldr left base; };

op_var [! !] { finalize finish; foldl1 right seed; };

op_var [% %] { finalize finish; foldr1 left seed; };

pub fn main() {
  print([* "a", "b", "c" *]);
  print("\n");
  print([+ "a", "b", "c" +]);
  print("\n");
  print([! "a", "b", "c" !]);
  print("\n");
  print([% "a", "b", "c" %]);
  print("\n");
  print([* *]);
  print("\n");
  print([+ +]);
  print("\n");
  print([! "solo" !]);
  print("\n");
  print([% "solo" %]);
  print("\n")
}
