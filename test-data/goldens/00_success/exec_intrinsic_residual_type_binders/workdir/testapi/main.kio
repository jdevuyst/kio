mod testapi/main;

import __intrinsics__;

import testapi { type Bool; type I32 }
import testapi/fmt { fn print_i32 }

fn choose[A](condition: Bool, yes: A, no: A) -> A {
  let select = __if_then_else__[Bool];
  select[A](condition, .() { yes }, .() { no })
}

pub fn main() { print_i32(choose(.t, 7, 8)); print_i32(choose(.f, 7, 8)) }
