module testapi/main;

import testapi(String);
import testapi/io(print);

// A trivial arity-1 type constructor: the payload is the
// type-parameter itself, so `Box(A)` is just its carrier `A`.
pub type { Box[A]: A { pub mk; pub get } }

// A `Functor[*F]` dictionary with a polymorphic-function payload:
// `Functor.get` lifts an `A -> B` through the type constructor to an
// `F(A) -> F(B)`. The dictionary is an ordinary polymorphic value
// the body constructs and applies; its `[A][B]` binders are
// instantiated at each call site.
pub type { Functor[*F]: [A][B] ((A -> B) & F[A]) -> F[B] { pub mk; pub get } }

// The Box instance: peel via `Box.get`, apply the function, re-
// brand via `Box.mk`. Polymorphic in `[A][B]`; the body
// operates uniformly across instantiations.
fn box_functor() -> Functor[Box] {
  Functor.mk[Box](.[A][B](step, m) { Box.mk[B](step(Box.get[A](m))) })
}

// Surface a String through the dictionary: brand a literal, lift
// an identity step through `Functor.get`, peel the brand back.
fn use_dictionary() -> String {
  let dict = box_functor();
  let branded = Box.mk[String]("functor dictionary ok\n"[String]);
  let mapped = Functor.get[Box](dict)[String][String](.(s) { s }, branded);
  Box.get[String](mapped)
}

pub fn main() { print(use_dictionary()) }
