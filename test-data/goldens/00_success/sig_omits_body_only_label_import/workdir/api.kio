mod api;

import labels { type Item }
import types as t;
import types { type A }
import types { type Kept }

pub fn make() { Item.get(Item.mk(())) }

pub fn keep(value: Kept) -> Kept { value }

pub fn keep_qualified(value: t.Kept) -> t.Kept { value }

pub fn shadow(value: A)[A](shadowed: A) -> A { shadowed }
