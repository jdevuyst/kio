module provider;

import __comptime__;
import macros/control(macro scope);

pure fn choose_impl(ct: __Comptime__) -> __Checked_term__ {
  scope {
    __comptime_if_then_else__(ct)(
    , __.t__(ct)
    , .() -> __Checked_term__ { __term_unit__(ct) }
    , .() -> __Checked_term__ { __term_unit__(ct) }
    )
  }
}

pub macro choose : . -> . { impl choose_impl }
