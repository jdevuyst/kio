/// This case's loading host: read the freshly-emitted guest image from stdin, load it, and call its exports.
mod testapi/main;

import defaults { fn apply_default; fn eval_default }
import imageio { fn read_image_stdin }
import loader { fn diag_message; fn export_term; fn un_load_outcome }
import loader { type Contract; fn contract_check; fn contract_cons; fn contract_nil; fn mk_expect }
import loader { type Diag; type Image; type Lr_diag; type Lr_image }
import loader/scan { fn load_package }
import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import prime { type Term }
import result { type Ev_done; type Ev_stuck }
import testapi { type I32; type Scalar; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }
import testapi/iter { fn loop }
import testapi/scalar { fn scalar_as_i32; fn scalar_of_i32 }
import testapi/text { fn string_concat }
import value { fn value_to_scalar; fn vhost }
import value { type Value }

/// The argument list one call applies, in order.
rec type { Vargs: . | (Value & Vargs) { mk; get } }

fn vargs_nil() -> Vargs { Vargs.mk(widen_sum(())[. | (Value & Vargs)]) }

fn vargs_cons(a: Value, rest: Vargs) -> Vargs {
  Vargs.mk(widen_sum((a, rest))[. | (Value & Vargs)])
}

fn vargs_one(a: Value) -> Vargs { vargs_cons(a, vargs_nil()) }

fn un_vargs(v: Vargs) -> . | (Value & Vargs) { Vargs.get(v) }

fn vi32(n: I32) -> Value { vhost(scalar_of_i32(n)) }

// Apply `f` to each argument in turn (each parameter takes one
// application), or `()` on a stuck application.
fn apply_chain(f: Value, args: Vargs) -> . | Value {
  loop(
  , .(st: Value & Vargs) {
      match(st) {
        .(cur: Value, rem: Vargs) {
          match(un_vargs(rem)) {
            (
            , .(a: Value, rest: Vargs) {
                match(apply_default(cur, a)) {
                  (
                  , .(v: Ev_done) { widen_sum((Ev_done.get(v), rest))[(Value & Vargs) | . | Value] }
                  , .(_s: Ev_stuck) {
                      widen_sum(widen_sum(())[. | Value])[(Value & Vargs) | . | Value]
                    }
                  )
                }
              }
            , .(_done: .) { widen_sum(widen_sum(cur)[. | Value])[(Value & Vargs) | . | Value] }
            )
          }
        }
      }
    }
  , (f, args)
  )
}

// Evaluate the named export in the loaded image and apply it to the
// arguments, or `()` on any failure.
fn call_export(im: Image, name: String, args: Vargs) -> . | Value {
  match(export_term(im, name)) {
    (
    , .(t: Term) {
        match(eval_default(t)) {
          (
          , .(v: Ev_done) { apply_chain(Ev_done.get(v), args) }
          , .(_s: Ev_stuck) { widen_sum(())[. | Value] }
          )
        }
      }
    , .(_absent: .) { widen_sum(())[. | Value] }
    )
  }
}

// Render an optional call result through the i32 scalar projection.
fn show_i32(label: String, r: . | Value) -> String {
  match(r) {
    (
    , .(v: Value) {
        match(value_to_scalar(v)) {
          (
          , .(s: Scalar) {
              match(scalar_as_i32(s)) {
                (
                , .(n: I32) { string_concat(label, string_concat(int_to_string(n), "\n"[String])) }
                , .(_no: .) { string_concat(label, "<not an i32>\n"[String]) }
                )
              }
            }
          , .(_no: .) { string_concat(label, "<not a scalar>\n"[String]) }
          )
        }
      }
    , .(_e: .) { string_concat(label, "<error>\n"[String]) }
    )
  }
}

// The shadowing shape: the guest reuses its outer binder's spelling for
// the inner group; the expectation spells both fresh.
fn shadow_line(im: Image, label: String, sig: String) -> String {
  match(contract_check(im, contract_cons(mk_expect("shadow"[String], sig), contract_nil()))) {
    (
    , .(d: Diag) { string_concat(label, string_concat(diag_message(d), "\n"[String])) }
    , .(_ok: .) { string_concat(label, "ok\n"[String]) }
    )
  }
}

fn contract_line(im: Image, label: String, name: String, sig: String) -> String {
  match(contract_check(im, contract_cons(mk_expect(name, sig), contract_nil()))) {
    (
    , .(d: Diag) { string_concat(label, string_concat(diag_message(d), "\n"[String])) }
    , .(_ok: .) { string_concat(label, "ok\n"[String]) }
    )
  }
}

/// Loads the piped-in image and prints each probed export's result; a
/// load failure prints the diagnostic instead.
pub fn main() {
  match(un_load_outcome(load_package(read_image_stdin()))) {
    (
    , .(im0: Lr_image) {
        let im = Lr_image.get(im0);
        print(show_i32(
        , "use_higher(5) = "[String]
        , call_export(im, "use_higher"[String], vargs_one(vi32(5[I32])))
        ));
        print(contract_line(
        , im
        , "contract (rank-2, renamed inner binder) = "[String]
        , "higher"[String]
        , "[#0] (([#1] (#1 -> #1)) & #0) -> #0"[String]
        ));
        print(contract_line(
        , im
        , "contract (rank-2, wrong inner arrow) = "[String]
        , "higher"[String]
        , "[#0] (([#1] (#1 -> #0)) & #0) -> #0"[String]
        ));
        print(shadow_line(
        , im
        , "contract (rank-2, shadowed outer spelling) = "[String]
        , "[#0] (([#1] (#1 -> #1)) & #0) -> #0"[String]
        ));
        print(contract_line(
        , im
        , "contract (alias control binder scope) = "[String]
        , "accept_poly"[String]
        , "([#0] (#0 -> h{hostapi.I32})) -> ."[String]
        ));
        print(contract_line(
        , im
        , "contract (duplicated alias binder scopes) = "[String]
        , "accept_duplicate"[String]
        , "(([#0] (#0 -> h{hostapi.I32})) & ([#1] (#1 -> h{hostapi.I32}))) -> ."[String]
        ));
        print(contract_line(
        , im
        , "contract (erased phantom binder scope) = "[String]
        , "accept_drop"[String]
        , "([#0] (#0 -> h{hostapi.I32})) -> ."[String]
        ))
      }
    , .(d: Lr_diag) {
        print(string_concat(
        , "load failed: "[String]
        , string_concat(diag_message(Lr_diag.get(d)), "\n"[String])
        ))
      }
    )
  }
}
