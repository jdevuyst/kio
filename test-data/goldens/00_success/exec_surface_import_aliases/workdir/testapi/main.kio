mod testapi/main;

import syntax as syntax;
import syntax {
  lit word as message;
  lit word as other;
  macro identity as keep;
  macro identity as retain;
  op + _ as ++ _;
  op + _ as -- _;
  op_var [* *] as [% %]
}
import testapi as host;
import testapi { type String as A }
import testapi/io { fn print }

fn shadow[A](_value: A) -> host.String { keep("surface\n") }

pub fn main() {
  print(keep(++ message));
  print(retain(-- other));
  print([% message %]);
  print(syntax.id(keep(other)));
  print(shadow[.](()))
}
