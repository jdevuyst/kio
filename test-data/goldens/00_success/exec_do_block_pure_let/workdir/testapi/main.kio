mod testapi/main;

import macros/sequence { macro do }
import testapi { type String }
import testapi/io { fn print }
import testapi/text { fn string_concat }

pub type { Box[A]: A { pub mk; pub get } }

fn box_pure[A](x: A) -> Box[A] { Box.mk(x) }

fn box_bind[A][B](m: Box[A], k: A -> Box[B]) -> Box[B] { k(Box.get(m)) }

// Interleaved pure-let and bind-let statements. The pure-let
// stays a lexical scope wrapper around the continuation tree —
// no `box_bind` step gets inserted at that position. The bind
// statements are the only ones that introduce a `box_bind` call.
//
// Elaboration (roughly):
//
//   box_bind(box_pure("hello"),
//     .(a: String) {
//       let b = "world";
//       box_bind(box_pure(string_concat(a, b)),
//         .(c: String) {
//           box_pure(string_concat(c, "\n"))
//         })
//     })
fn run() -> Box[String] {
  do(box_bind) {
    let a <- box_pure("hello"[String]);
    let b = "world"[String];
    let c <- box_pure(string_concat(a, b));
    box_pure(string_concat(c, "\n"))
  }
}

pub fn main() { print(Box.get(run())) }
