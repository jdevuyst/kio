module derive_memo_deep_stack/main;

import __intrinsics__;

import macros/derive(macro derive);
import testapi(String);

pub type { Cell[A]: A { pub mk; pub get } }

pub type { Pair[A][B]: A & B { pub mk; pub get } }

pub type { Render[A]: A -> String { pub mk; pub get } }

type Deep = Pair[Cell[String]][Pair[Cell[String]][Pair[Cell[String]][Pair[Cell[String]][Pair[Cell[String]][Pair[Cell[String]][Cell[String]]]]]]];

fn render_cell_string() -> Render[Cell[String]] {
  Render.mk(.(c) { Cell.get(c) })
}

fn render_pair[A][B](ra: Render[A], rb: Render[B]) -> Render[Pair[A][B]] {
  Render.mk(.(p) { Render.get(ra)(__fst__[A][B](Pair.get[A][B](p))) })
}

fn derived0() -> Render[Deep] { derive((render_pair, render_cell_string))[Render[Deep]] }

fn derived1() -> Render[Deep] { derive((render_pair, render_cell_string))[Render[Deep]] }

fn derived2() -> Render[Deep] { derive((render_pair, render_cell_string))[Render[Deep]] }

pub fn main() { () }
