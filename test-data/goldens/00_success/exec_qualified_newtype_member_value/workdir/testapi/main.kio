mod testapi/main;

import testapi { type I32 }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }
import testapi/types as t;

fn build(make: I32 -> t.Celsius, n: I32) -> t.Celsius { make(n) }

fn unwrap(read: t.Celsius -> I32, c: t.Celsius) -> I32 { read(c) }

pub fn main() {
  let temp = build(t.Celsius.mk, 25[I32]);
  print(int_to_string(unwrap(t.Celsius.get, temp)))
}
