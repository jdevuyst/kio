mod testapi/main;

import testapi { type Count; type I32; type String; type Token }
import testapi/arith { fn add_count }
import testapi/fmt { fn count_to_string; fn i32_to_string }
import testapi/io { fn print }
import testapi/opaque { fn make_token; fn token_value }

fn keep(t: Token) -> Token { t }

pub fn main() {
  let token = keep(make_token(37));
  print(i32_to_string(token_value(token)));
  print("|"[String]);
  print(count_to_string(add_count(40[Count], 2[Count])));
  print("\n"[String])
}
