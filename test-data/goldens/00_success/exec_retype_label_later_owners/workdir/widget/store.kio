module widget/store;

import core/relay as _rehost_gdgphcgfcphcgfgmgbhj;
import core/store as _rehost_gdgphcgfcphdhegphcgf;

pub type Foo = _rehost_gdgphcgfcphcgfgmgbhj.Foo;

pub type {foo} = {_rehost_gdgphcgfcphdhegphcgf.foo};

pub labels { box[A]: A };

pub type Later[A] = Foo & Box(A);

pub labels Still[A] = { box[A]: _ };

