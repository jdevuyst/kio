module testapi/main;

import core/store as target;
import testapi(String);
import testapi/io(print);
import widget/store as source;

pub fn main() {
  target.accept_foo(source.Foo.mk(()));
  print("terminal-identity\n");
  source.accept_foo(target.Foo.mk(()));
  source.Foo.get(target.Foo.mk(()));
  print("original-constructor\n");
  print(source.later_box((source.Foo.mk(()), source.Box.mk("later-mixed\n"))));
  print(source.still_box(source.Box.mk("unselected-origin\n")));
  source.later_box((source.Foo.mk(()), source.Box.mk(())));
  source.still_box(source.Box.mk(()));
  print("generic-unit\n")
}
