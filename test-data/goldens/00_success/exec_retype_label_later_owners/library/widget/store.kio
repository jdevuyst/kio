mod store;

import macros/row_macros { macro select }

pub type { Foo: . { pub mk; pub get } }

pub type { Box[A]: A { pub mk; pub get } }

pub type Later[A] = Foo & Box[A];

pub type Still[A] = Box[A];

pub fn accept_foo(value: Foo) { Foo.get(value) }

pub fn later_box[A](row: Later[A]) -> A {
  row.>select { Box.get[A] }
}

pub fn still_box[A](row: Still[A]) -> A {
  row.>select { Box.get[A] }
}
