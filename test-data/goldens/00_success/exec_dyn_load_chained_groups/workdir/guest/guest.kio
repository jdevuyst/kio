module guest;

import hostapi(I32, add_i32);

newtype Box[A] : A { constructor mk_box; projector un_box }

pub fn f[A](x: I32)[B]() -> I32 { add_i32(x, 1) }

pub fn call_chain(x: I32) -> I32 { f(I32, x)(I32, ()) }

fn g[T]() -> I32 { 9 }

fn via_binder(h: [T] . -> I32) -> I32 { h(I32, ()) }

pub fn use_binder(x: I32) -> I32 { add_i32(via_binder(g), x) }

pub fn call_via_let(x: I32) -> I32 { let g = f(I32, x); g(I32, ()) }

pub fn call_via_alias(x: I32) -> I32 { let h = f(I32, x); let g = h; g(I32, ()) }

pub fn m(x: I32)[B]() -> I32 { add_i32(x, 2) }

pub fn call_mono_chain(x: I32) -> I32 { m(x)(I32, ()) }

fn id[A](value: A) -> A { value }

pub fn call_residual(x: I32) -> I32 { id(I32)(x) }

pub fn call_bottom_head() -> I32 { g(!, ()) }

pub fn call_rank_head() -> I32 { g([T] T -> T, ()) }

fn consecutive[A][B](value: A, _witness: B) -> A { value }

pub fn call_partial_consecutive(x: I32) -> I32 { consecutive(I32, x, x) }

pub fn call_lambda_stages(x: I32) -> I32 {
  let staged = .[A][B](value: A) { value };
  let rest = staged(I32);
  rest(I32, x)
}

pub fn call_member_values(x: I32) -> I32 {
  let construct = Box.mk_box;
  let project = Box.un_box;
  project(I32, construct(I32, x))
}
