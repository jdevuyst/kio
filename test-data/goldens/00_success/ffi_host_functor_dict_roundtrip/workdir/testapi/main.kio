module testapi/main;

import __intrinsics__;

import testapi(String);
import testapi/arith(round_functor);
import testapi/io(print);
import testapi/types(Box, Capture, Functor, Shadow);

// The Box instance delegates through `Shadow`, whose payload keeps its
// outer carrier separate from its nested polymorphic identity function.
fn box_functor() -> Functor(Box) {
  Functor.mk_functor(
    , Box
    , .[A][B](step, m) {
        let captured = Capture.mk_capture(Box(A), .[T](_value: T) { m });
        let shadowed =
          Shadow.mk_shadow(
            , Box(A)
            , __pair__(
                , Box(A)
                , ([T] T -> T) & Capture(Box(A))
                , m
                , __pair__([T] T -> T, Capture(Box(A)), .[T](value: T) { value }, captured)
                )
            );
        let mapped = step(shadowed);
        __fst__(Box(B), ([T] T -> T) & Capture(Box(B)), Shadow.un_shadow(Box(B), mapped))
      }
    )
}

// Build the dictionary, hand it across the host boundary, and use the
// dictionary the host hands back: brand a literal, lift an identity
// step through `fmap`, peel the brand. Printing the recovered string
// proves the round-tripped dictionary still functions as a dictionary.
pub fn main() -> . {
  let dict = round_functor(box_functor());
  let branded = Box.mk_box(String, __pair__(String, ., "functor dict roundtrip ok\n"(String), ()));
  let mapped = Functor.fmap(Box, dict)(String, String, .(s) { s }, branded);
  print(__fst__(String, ., Box.un_box(String, mapped)))
}
