package ffi_incoming_callable_stages;

build {
  cache "out/.kio-cache/";

  target js {
    out "out/js/";
    baseline es2020
  };

  target ts {
    out "out/ts/";
    baseline v5_0
  };

  target python {
    out "out/python/";
    baseline v3_10
  };

  target kio-prime {
    out "out/kio-prime/"
  }
}

bridge {
  testapi;
  testapi/main
}
