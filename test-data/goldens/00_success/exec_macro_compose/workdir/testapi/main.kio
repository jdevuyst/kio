module testapi/main;

import macros/spine_macros(macro narrow_prod, macro reorder_prod);
import testapi(I32, String);
import testapi/io(print);

type { A: I32 { pub mk; pub get } }

type { B: I32 { pub mk; pub get } }

type { C: I32 { pub mk; pub get } }

type { D: I32 { pub mk; pub get } }

// Repeated macro composition: a function-call chain pins each
// step's target type via the parameter type, so each macro call
// sees the elaborated output of the previous macro call as its source.
// `reorder` swaps A & B & C & D to D & C & B & A; the three
// `drop_*` functions each take the previous step's output and apply
// `narrow_prod` to peel off one factor. The chain terminates in `D`.
// This asserts that elaborations compose without dropping or
// duplicating factors mid-chain — a straight-through reduction.
fn reorder(p: A & B & C & D) -> D & C & B & A { reorder_prod(p) }

fn drop_a(p: D & C & B & A) -> D & C & B { narrow_prod(p) }

fn drop_b(p: D & C & B) -> D & C { narrow_prod(p) }

fn drop_c(p: D & C) -> D { narrow_prod(p) }

fn last_factor(p: A & B & C & D) -> D { drop_c(drop_b(drop_a(reorder(p)))) }

pub fn main() {
  let p = (A.mk(1), B.mk(2), C.mk(3), D.mk(4));
  // Force evaluation of the chain; the constant message confirms
  // the program reached the print without a macro error.
  let _ = last_factor(p);
  print("compose-ok\n")
}
