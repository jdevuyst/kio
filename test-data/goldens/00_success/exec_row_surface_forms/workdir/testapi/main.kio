mod testapi/main;

import macros/row_macros { macro record; macro record_; macro select; macro with }
import testapi { type I32; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }
import testapi/labels as ql;
import testapi/labels { type Tag }
import testapi/text { fn string_concat }

type { Foo: I32 { mk; get }; Bar: String { mk; get }; Ready: . { mk; get } }

fn colon(label: String, value: String) -> String { string_concat(label, string_concat("=", value)) }

fn show(row: Bar & Foo) -> String {
  string_concat(row.>select { Bar.get }, string_concat(":", int_to_string(row.>select { Foo.get })))
}

fn construct_reordered(foo: I32, bar: String) -> Bar & Foo {
  record { Foo.mk(foo); Bar.mk(bar) }
}

fn access_written_order(row: Foo & Bar) -> I32 & String {
  row.>select { Foo.get; Bar.get }
}

fn update_reordered(row: Foo & Bar, foo: I32, bar: String) -> Bar & Foo {
  row.>with { Foo.mk(foo); Bar.mk(bar) }
}

fn observe_access(_pair: I32 & String) { () }

fn empty_construct() { () }

fn empty_access(row: Foo & Bar) {
  row.>select {}
}

fn empty_update(row: Foo & Bar) -> Bar & Foo {
  row.>with {}
}

fn row_let(row: Foo & Bar & Ready) -> String {
  let .(payload, foo, ready) = row.>select { Bar.get; Foo.get; Ready.get };
  string_concat(payload, string_concat(":", int_to_string(foo)))
}

fn qualified(tag: String) -> Tag { ql.Tag.mk(tag) }

pub fn main() {
  let constructed = construct_reordered(7, "made");
  print(colon("construct", show(constructed)));
  print("\n");
  let source = record_ { Foo.mk(7); Bar.mk("made") };
  let accessed = access_written_order(source);
  observe_access(accessed);
  print(colon(
  , "access"
  , show(record {
      Bar.mk(source.>select { Bar.get });
      Foo.mk(source.>select { Foo.get })
    })
  ));
  print("\n");
  let updated = update_reordered(source, 9, "next");
  print(colon("update", show(updated)));
  print("\n");
  empty_construct();
  empty_access(source);
  let emptied = empty_update(source);
  print(colon("empty", show(emptied)));
  print("\n");
  let row = record_ { Foo.mk(7); Bar.mk("made"); Ready.mk(()) };
  print(colon("rowlet", row_let(row)));
  print("\n");
  print(colon("qualified", qualified("tagged").>ql.Tag.get));
  print("\n")
}
