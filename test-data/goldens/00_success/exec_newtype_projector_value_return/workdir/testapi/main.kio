mod testapi/main;

import testapi { type I32; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

type { Count: I32 { mk; get } }

fn projector() -> Count -> I32 { Count.get }

pub fn main() {
  let get = projector();
  print(int_to_string(get(Count.mk(42))));
  print("\n"[String])
}
