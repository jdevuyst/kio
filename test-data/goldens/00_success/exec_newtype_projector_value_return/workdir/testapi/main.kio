module testapi/main;

import testapi(I32, String);
import testapi/fmt(int_to_string);
import testapi/io(print);

type { Count: I32 { mk; get } }

fn projector() -> Count -> I32 { Count.get }

pub fn main() {
  let get = projector();
  print(int_to_string(get(Count.mk(42))));
  print("\n"[String])
}
