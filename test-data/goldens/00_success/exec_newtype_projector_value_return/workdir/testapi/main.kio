module testapi/main;

import testapi(I32, String);
import testapi/fmt(int_to_string);
import testapi/io(print);

newtype Count : I32 { constructor mk_count; projector get_count }

fn projector() -> Count -> I32 { Count.get_count }

pub fn main() -> . {
  let get = projector();
  print(int_to_string(get(Count.mk_count(42))));
  print("\n"(String))
}
