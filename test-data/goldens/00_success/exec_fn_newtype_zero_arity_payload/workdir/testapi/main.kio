mod testapi/main;

import testapi { type I32 }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

// A zero-arity function-typed newtype payload — the "lazy thunk"
// pattern. The newtype's projector returns a closure with the same
// shape as the stored fn: `. -> I32`, callable with no args.
type { Lazy: . -> I32 { pub mk; pub get } }

fn lazy42() -> Lazy {
  Lazy.mk(.() { 42[I32] })
}

pub fn main() { let l = lazy42(); print(int_to_string(Lazy.get(l)())) }
