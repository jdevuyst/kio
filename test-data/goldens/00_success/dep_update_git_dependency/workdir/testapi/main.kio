module testapi/main;

import greetlib/greet(marker);
import testapi(String);
import testapi/io(print);

// `marker` is a re-rooted generic export from the git dependency whose
// *behavior differs between commit A and commit B*: at A it returns its
// first argument, at B its second. The lockfile starts pinned to A; the
// build+run after `kio dep update` re-pins to B prints the second
// argument, so the run demonstrates that `dep update` advanced which
// commit's code the consumer threads its host `String` through — not
// only that the lockfile SHA changed.
pub fn greeting() -> String {
  marker("locked to old commit\n"(String), "advanced to new commit\n"(String))
}

pub fn main() -> . { print(greeting()) }
