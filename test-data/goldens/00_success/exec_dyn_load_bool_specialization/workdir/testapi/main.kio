mod testapi/main;

import host_descriptor {
  fn bool_role;
  fn host_id_local;
  fn host_type_id;
  fn host_type_shape;
  fn i32_role;
  fn role_name
}
import host_descriptor {
  fn host_types_cons;
  fn host_types_nil;
  fn mk_host_id;
  fn mk_role_host_type
}
import host_descriptor { type Host_type; type Role_host_type; type Roleless_host_type }
import hostrec { fn make_lit_default; fn serve_default }
import loader {
  type Apply;
  type I32_out;
  type Lookup;
  type Unit_in;
  fn diag_message;
  fn un_load_outcome
}
import loader { type Diag; type Loaded; type Lr_diag; type Lr_image; type Surface }
import loader { type Host_adapter; fn host_fn_bindings_nil; fn instantiate; fn mk_host_adapter }
import loader/scan { fn load_package }
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import testapi { type Bool; type I32; type Scalar; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }
import testapi/scalar { fn scalar_as_str; fn scalar_of_str }
import testapi/text { fn string_concat; fn string_eq }
import value { type Side; type Value; fn s_left; fn s_right; fn vhost }

fn adapter() -> Host_adapter {
  mk_host_adapter(
  , host_types_cons(
    , mk_role_host_type(mk_host_id("hostapi"[String], "I32"[String]), i32_role())
    , host_types_cons(
      , mk_role_host_type(mk_host_id("hostapi"[String], "First"[String]), bool_role())
      , host_types_cons(
        , mk_role_host_type(mk_host_id("hostapi"[String], "Second"[String]), bool_role())
        , host_types_cons(
          , mk_role_host_type(mk_host_id("hostapi"[String], "Flag"[String]), bool_role())
          , host_types_nil()
          )
        )
      )
    )
  , host_fn_bindings_nil()
  )
}

fn bool_type(ty: Host_type) -> Bool {
  match(host_type_shape(ty)) {
    (
    , .(role: Role_host_type) { string_eq(role_name(Role_host_type.get(role)), "bool"[String]) }
    , .(_other: Roleless_host_type) { .f[Bool] }
    )
  }
}

// Each Boolean carrier has a distinct host representation; a wrong descriptor
// at the conditional boundary therefore changes the observable branch.
fn make_literal(text: String, ty: Host_type) -> Value {
  if(bool_type(ty)) {
    vhost(scalar_of_str(string_concat(host_id_local(host_type_id(ty)), text)))
  } else {
    make_lit_default(text, ty)
  }
}

fn test_boolean(ty: Host_type, scalar: Scalar) -> Side {
  match(scalar_as_str(scalar)) {
    (
    , .(text: String) {
        if(string_eq(text, string_concat(host_id_local(host_type_id(ty)), "t"[String]))) {
          s_right()
        } else {
          s_left()
        }
      }
    , .(_wrong_representation: .) { s_left() }
    )
  }
}

fn call_value[P](surface: Surface[P]) -> String {
  match((surface.>select { Lookup.get[P] })("value"[String])) {
    (
    , .(callee: P) {
        match((surface.>select { Apply.get[P] })((callee, surface.>select { Unit_in.get[P] }))) {
          (
          , .(answer: P) {
              match((surface.>select { I32_out.get[P] })(answer)) {
                (.(value: I32) { int_to_string(value) }, .(diag: Diag) { diag_message(diag) })
              }
            }
          , .(diag: Diag) { diag_message(diag) }
          )
        }
      }
    , .(diag: Diag) { diag_message(diag) }
    )
  }
}

fn rejected(name: String, source: String) {
  print(name);
  print(": "[String]);
  match(un_load_outcome(load_package(source))) {
    (
    , .(_image: Lr_image) { print("unexpected acceptance"[String]) }
    , .(diag: Lr_diag) { print(diag_message(Lr_diag.get(diag))) }
    )
  };
  print("\n"[String])
}

fn evaluated(source: String) {
  match(un_load_outcome(load_package(source))) {
    (
    , .(image: Lr_image) {
        match(instantiate(adapter(), serve_default, make_literal, test_boolean, Lr_image.get(image))) {
          (
          , .(loaded: Loaded) {
              Loaded.get(loaded)(.[P](surface: Surface[P]) { print(call_value(surface)) })
            }
          , .(diag: Diag) { print(diag_message(diag)) }
          )
        }
      }
    , .(diag: Lr_diag) { print(diag_message(Lr_diag.get(diag))) }
    )
  };
  print("\n"[String])
}

pub fn main() {
  evaluated("mod hostapi; host type I32 role(i32); host type First role(bool); host "
            "type Second role(bool); mod guest; import __intrinsics__; import hostapi "
            "{type I32; type First; type Second} type Identity[A] = A; pub fn value() "
            "-> I32 { __if_then_else__[Identity[First]][I32](.t[Identity[First]], .() "
            "-> I32 { __if_then_else__[Second][I32](.t[Second], .() -> I32 { 73[I32] "
            "}, .() -> I32 { 0[I32] }) }, .() -> I32 { 0[I32] }) } pkg guest; bridge "
            "{ guest; hostapi; }"[String]);
  evaluated("mod hostapi; host type I32 role(i32); host type Flag role(bool); mod "
            "guest; import __intrinsics__; import hostapi {type I32; type Flag} fn "
            "default() -> I32 { 74[I32] } pub fn value() -> I32 { "
            "__if_then_else__[Flag][I32](.f[Flag], .() -> I32 { 0[I32] }, .() -> I32 "
            "{ default() }) } pkg guest; bridge { guest; hostapi; }"[String]);
  evaluated("mod hostapi; host type I32 role(i32); host type Flag role(bool); mod "
            "guest; import __intrinsics__; import hostapi {type I32; type Flag} type "
            "Ignore[A] = Flag; fn pick[A](condition: Flag, yes: A, no: A) -> A { "
            "__if_then_else__[Ignore[A]][A](condition, .() -> A { yes }, .() -> A { "
            "no }) } pub fn value() -> I32 { pick[I32](.t[Flag], 75[I32], 0[I32]) } "
            "pkg guest; bridge { guest; hostapi; }"[String]);
  evaluated("mod hostapi; host type I32 role(i32); host type Flag role(bool); mod "
            "guest; import __intrinsics__; import hostapi {type I32; type Flag} type "
            "Ignore[*F] = Flag; type { Box[A]: A { mk; get } } pub fn value() -> I32 "
            "{ .[*F](condition: Flag) -> I32 { "
            "__if_then_else__[Ignore[F]][I32](condition, .() -> I32 { 76[I32] }, .() "
            "-> I32 { 0[I32] }) }[Box](.t[Flag]) } pkg guest; bridge { guest; "
            "hostapi; }"[String]);
  evaluated("mod hostapi; host type I32 role(i32); host type Flag role(bool); mod "
            "guest; import __intrinsics__; import hostapi {type I32; type Flag} type "
            "Ignore[A] = Flag; pub fn value() -> I32 { let ignored = .[Flag]() -> "
            "Ignore[Flag] { .t[Ignore[Flag]] }; __if_then_else__[Flag][I32](.t[Flag], "
            ".() -> I32 { 77[I32] }, .() -> I32 { 0[I32] }) } pkg guest; bridge { "
            "guest; hostapi; }"[String]);
  rejected(
  , "nonbool"[String]
  , "mod hostapi; host type I32 role(i32); mod guest; import __intrinsics__; "
    "import hostapi {type I32} pub fn value() -> I32 { "
    "__if_then_else__[I32][I32](1[I32], .() -> I32 { 1[I32] }, .() -> I32 { "
    "0[I32] }) } pkg guest; bridge { guest; hostapi; }"[String]
  );
  rejected(
  , "underapplied"[String]
  , "mod hostapi; host type I32 role(i32); host type Flag role(bool); mod "
    "guest; import __intrinsics__; import hostapi {type I32; type Flag} type "
    "Identity[A] = A; pub fn value() -> I32 { "
    "__if_then_else__[Identity][I32](.t[Flag], .() -> I32 { 1[I32] }, .() -> "
    "I32 { 0[I32] }) } pkg guest; bridge { guest; hostapi; }"[String]
  );
  rejected(
  , "rigid"[String]
  , "mod hostapi; host type I32 role(i32); mod guest; import __intrinsics__; "
    "import hostapi {type I32} pub fn value[B](condition: B) -> I32 { "
    "__if_then_else__[B][I32](condition, .() -> I32 { 1[I32] }, .() -> I32 { "
    "0[I32] }) } pkg guest; bridge { guest; hostapi; }"[String]
  );
  rejected(
  , "shadowed"[String]
  , "mod hostapi; host type I32 role(i32); host type Flag role(bool); mod "
    "guest; import __intrinsics__; import hostapi {type I32; type Flag} pub "
    "fn value[Flag](condition: Flag) -> I32 { "
    "__if_then_else__[Flag][I32](condition, .() -> I32 { 1[I32] }, .() -> I32 "
    "{ 0[I32] }) } pkg guest; bridge { guest; hostapi; }"[String]
  );
  rejected(
  , "nested shadow"[String]
  , "mod hostapi; host type I32 role(i32); host type Flag role(bool); mod "
    "guest; import __intrinsics__; import hostapi {type I32; type Flag} pub "
    "fn value() -> I32 { let ignored = .[Flag](condition: Flag) -> I32 { "
    "__if_then_else__[Flag][I32](condition, .() -> I32 { 1[I32] }, .() -> I32 "
    "{ 0[I32] }) }; 0[I32] } pkg guest; bridge { guest; hostapi; }"[String]
  );
  rejected(
  , "removed modifier"[String]
  , "mod hostapi; default host type Flag role(bool); pkg guest; bridge { "
    "hostapi; }"[String]
  )
}
