module testapi/main;

import macros/derive(macro derive);
import testapi(String);
import testapi/io(print);

pub type { Box[A]: A { pub mk; pub get } }

pub type { Monad[*F]: [A][B] (F[A] & (A -> F[B])) -> F[B] { pub mk; pub get } }

// The candidate is an inline `fn`-literal defining the rule on the
// spot, rather than a reference to a named top-level `fn`. A
// zero-precondition base instance written inline.
fn use_derived() -> String {
  let monad =
    derive(.() -> Monad[Box] {
      Monad.mk(.[A][B](m, k) { k(Box.get(m)) })
    })[Monad[Box]];
  let lifted = Box.mk("derive! inline fn: ok\n"[String]);
  let stepped = Monad.get(monad)[String][String](lifted, .(s) { Box.mk(s) });
  Box.get(stepped)
}

pub fn main() { print(use_derived()) }
