    ));
  print(source_result_line(
    , "lambda without value parameter group: "(String)
    , "module bad;\npub fn broken() -> . { .[A] { () } }\n"(String)
    ));
  print(source_result_line(
    , "bare transparent alias: "(String)
    , "module alias_bare;\ntype Pair[A][B] = A & B;\nhost fn rejected(x: Pair) -> "
      ".;\n"(String)
    ));
  print(source_result_line(
    , "local undersaturated transparent alias: "(String)
    , "module alias_partial;\nnewtype Higher[*F] : . { constructor mk_higher; "
      "projector un_higher; };\ntype Pair[A][B] = A & B;\nhost fn rejected(x: "
      "Higher(Pair(.))) -> .;\n"(String)
    ));
  print(source_result_line(
    , "selective undersaturated transparent alias: "(String)
    , "module selective_decoy;\npub type Pair[A] = A;\nmodule selective_provider;\n"
      "pub type Pair[A][B] = A & B;\nmodule selective_consumer;\nimport "
      "selective_provider(Pair);\nimport selective_decoy as decoy;\nnewtype "
