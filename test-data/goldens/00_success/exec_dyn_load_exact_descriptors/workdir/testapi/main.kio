import value(un_value, value_to_scalar, vhost, vhostfn_fresh, vproduct, vunit);

fn describe_host_type_lookup(result: Host_type_lookup) -> String {
  match! result {
    (
      , .(_missing: Missing_host_type) { "missing"(String) }
      , .(_found: Found_host_type) { "found"(String) }
      , .(_conflict: Conflicting_host_type) { "conflict"(String) }
      )
  }
}

fn describe_host_function_lookup(result: Host_function_lookup) -> String {
  match! result {
    (
      , .(_missing: Missing_host_function) { "missing"(String) }
      , .(_found: Found_host_function) { "found"(String) }
      , .(_conflict: Conflicting_host_function) { "conflict"(String) }
      )
  }
}

fn describe_duplicate_image(source: String) -> String {
  match! un_load_outcome(load_package(source)) {
    (
      , .(_loaded: Lr_image) { "accepted"(String) }
      , .(rejected: Lr_diag) { diag_message(Lr_diag.get(rejected)) }
      )
  }
}

fn print_duplicate_image_results() -> . {
  print(string_concat(
    , "duplicate module identity: "(String)
    , string_concat(describe_duplicate_image("module same;\nmodule same;\n"(String)), "\n"(String))
    ));
  print(string_concat(
    , "duplicate host declaration identity: "(String)
    , string_concat(
        , describe_duplicate_image("module same;\nhost type Value role(i32);\nhost type Value role(i32);\n"(String))
        , "\n"(String)
        )
    ))
}

fn print_malformed_host_descriptor_results() -> . {
  print(string_concat(
    , "malformed host type binder: "(String)
    , string_concat(
        , describe_duplicate_image("module same;\nhost type Box[A;\n"(String))
        , "\n"(String)
        )
    ))
}

fn source_result_line(label: String, source: String) -> String {
  string_concat(label, string_concat(describe_duplicate_image(source), "\n"(String)))
}

