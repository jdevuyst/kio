  print(source_result_line(
    , "later local host type in literal: "(String)
    , "module later_literal;\nimport __intrinsics__;\npub fn literal() -> . { let "
      "n = 1(Number); () }\nhost type Number role(i32);\n"(String)
    ));
  print(source_result_line(
    , "later local host type in host function signature: "(String)
    , "module later_host_signature;\nhost fn consume(x: Number) -> .;\nhost type "
      "Number role(i32);\n"(String)
    ));
  print(source_result_line(
    , "alias reaching later local host type: "(String)
    , "module later_alias;\ntype Number_alias = Number;\nhost fn consume(x: "
      "Number_alias) -> .;\nhost type Number role(i32);\n"(String)
    ));
  print(source_result_line(
    , "earlier local host function: "(String)
    , "module earlier_function;\nhost fn ping() -> .;\npub fn call() -> . { "
      "ping() }\n"(String)
    ));
  print(source_result_line(
    , "later local host function: "(String)
    , "module later_function;\npub fn call() -> . { ping() }\nhost fn ping() -> "
      ".;\n"(String)
    ));
  print(source_result_line(
    , "missing host return arrow: "(String)
    , "module malformed;\nhost fn missing();\n"(String)
    ));
  print(source_result_line(
    , "unterminated declaration type binders: "(String)
    , "module bad;\npub fn broken[A)() -> . { () }\n"(String)
    ));
  print(source_result_line(
    , "unterminated lambda type binders: "(String)
