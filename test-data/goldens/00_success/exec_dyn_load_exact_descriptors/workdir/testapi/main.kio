/// Loads a guest that uses same-leaf host declarations from two modules and
/// checks exact identities through canonicalization, preflight, and execution.
module testapi/main;

import defaults(eval_default);
import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import eval(prime_apply);
import host_descriptor(Conflicting_host_function, Conflicting_host_type, Host_fn, Host_type);
import host_descriptor(Found_host_function, Found_host_type);
import host_descriptor(Host_function_lookup, Host_type_lookup);
import host_descriptor(Host_types);
import host_descriptor(Missing_host_function, Missing_host_type);
import host_descriptor(base_kind, higher_kind, i32_role, i64_role, str_role);
import host_descriptor(find_host_function, find_host_type, host_fn_eq, host_id_eq, host_id_render);
import host_descriptor(host_functions_cons, host_functions_nil, host_types_cons, host_types_nil);
import host_descriptor(host_type_eq, host_type_id);
import host_descriptor(mk_host_fn, mk_host_id, mk_role_host_type, mk_roleless_host_type);
import host_descriptor(param_kinds_cons, param_kinds_nil);
import hostrec(make_lit_default, serve_default, test_bool_default);
import imageio(read_image_stdin);
import loader(
  , Contract
  , Diag
  , Export_info
  , Export_infos
  , Host_adapter
  , Host_fn_binding
  , Host_fn_bindings
  );
import loader(Hostfn, Hostfns, Image, Loaded, Lr_diag, Lr_image, Surface);
import loader(contract_check, contract_cons, contract_nil, diag_message);
import loader(export_info_name, export_info_sig, export_term, mk_expect);
import loader(host_contract_functions, host_contract_types, image_host_requirements);
import loader(host_fn_binding_descriptor, host_fn_binding_groups, un_host_fn_bindings);
import loader(host_fn_bindings_cons, host_fn_bindings_nil);
import loader(image_exports, image_hostfns, instantiate, mk_host_adapter, mk_host_fn_binding);
import loader(un_export_infos, un_hostfns, un_load_outcome);
import loader({apply}, {hostfn_in}, {i32_in}, {i32_out}, {lookup}, {pair_in}, {str_out}, {unit_in});
import loader/scan(load_package);
