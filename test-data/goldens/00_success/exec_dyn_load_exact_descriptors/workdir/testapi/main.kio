      "Pair(., .)) -> .;\n"(String)
    ));
  print(source_result_line(
    , "partially applied newtype: "(String)
    , "module nominal_partial;\npub newtype Higher[*F] : . { constructor "
      "mk_higher; projector un_higher; };\npub newtype Pair[A][B] : A & B { pub "
