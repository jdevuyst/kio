module left;

import host/a as h;
import host/a(Value);

pub type Value_alias = h.Value;

pub newtype Box : Value_alias { pub constructor mk_box; pub projector un_box }

pub type Box_alias = Box;

pub fn literal() -> h.Value { 7(h.Value) }

pub fn call() -> h.Value { h.ping() }

pub fn staged() -> h.Value { h.staged(5(h.Value), 6(h.Value))(7(h.Value)) }

pub fn staged_alias() -> h.Value { let call = h.staged; call(5(h.Value), 6(h.Value))(7(h.Value)) }

pub fn call_polymorphic_identity(callback: [A] A -> A) -> h.Value { callback(h.Value, 7(h.Value)) }

pub fn echo_qualified(x: h.Value) -> h.Value { x }

pub fn echo_selective(x: Value) -> Value { x }

pub fn echo_alias(x: Value_alias) -> Value_alias { x }

pub fn echo_box(x: Box_alias) -> Box_alias { x }

pub fn implicit_unit() { () }
