module build_reassoc_function_slots/main;

import build_reassoc_function_slots(I32);

// A product of two functions whose parameters and results are themselves
// products: one reassociates three values to the right, and the other restores
// the left-associated form.
pub type Reassoc =
  (((I32 & I32) & I32) -> I32 & I32 & I32) & ((I32 & I32 & I32) -> (I32 & I32) & I32)
  ;

pub fn reassoc_iso() -> Reassoc {
  let to = .(((a: I32, b: I32), c: I32)) -> I32 & I32 & I32 { (a, (b, c)) };
  let from = .((a: I32, (b: I32, c: I32))) -> (I32 & I32) & I32 { ((a, b), c) };
  (to, from)
}

pub fn main() -> . { () }
