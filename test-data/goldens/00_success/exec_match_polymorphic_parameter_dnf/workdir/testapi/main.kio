module testapi/main;

import macros/match(macro match);
import macros/spine_macros(macro widen_sum);
import testapi(String);
import testapi/io as io;

type { Box[A]: A { pub mk; pub get } }

type { Other[A]: A { pub mk; pub get } }

fn extract[A](slot: Box[A] | Other[A]) -> A {
  match(slot) {
    .(boxed: Box[A]) { boxed.>Box.get };
    .(other: Other[A]) { other.>Other.get }
  }
}

fn named(input: Box[String]) -> String {
  match(input) { extract }
}

fn inline(input: Box[String] | Other[String]) -> String {
  match(input) {
    .[A](slot: Box[A] | Other[A]) -> A { extract[A](slot) }
  }
}

pub fn main() {
  io.print(named(Box.mk("named-box\n")));
  io.print(inline(widen_sum(Box.mk("inline-box\n"[String]))[Box[String] | Other[String]]));
  io.print(inline(widen_sum(Other.mk("inline-other\n"[String]))[Box[String] | Other[String]]))
}
