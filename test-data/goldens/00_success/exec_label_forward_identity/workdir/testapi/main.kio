module testapi/main;

import middle as words;
import origin(Item);
import testapi(String);
import testapi/forward as view;
import testapi/forward(Display, Local);
import testapi/io(print);

fn build_selected(value: String) -> Item { Display.mk(value) }

fn read_original(value: Item) -> String { Item.get(value) }

fn read_forwarded(value: Item) -> String { view.Display.get(value) }

pub fn main() {
  print(read_original(build_selected("selected\n")));
  print(read_forwarded(Item.mk("original\n")));
  print(read_original(view.Display.mk("qualified\n")));
  print(read_original(Local.mk("scoped\n")));
  print(words.caption())
}
