mod testapi/main;

import macros/algebraic_macros { macro align }
import macros/control { macro if }
import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }
import testapi/io { fn print }

// Source `String | String` (constructed explicitly in each branch).
// align to `String | I32`: collapses the two `String` arms into
// one and widens by adding the unused `| I32` arm. Both rules
// (sum collapse + sum widening) fire in a single align call.
fn convert(b: Bool) -> String | I32 {
  align(if(b) {
    widen_sum("widened-collapsed\n"[String])[String | String]
  } else {
    widen_sum("widened-collapsed\n"[String])[String | String]
  })
}

pub fn main() {
  let s =
    match(convert(.t)) {
      (.(s: String) { s }, .(_n: I32) { "unreachable\n" })
    };
  print(s)
}
