module main;

import __intrinsics__;

host type I32 role(i32);

pub newtype Unit_rep : . { pub constructor mk_unit_rep; pub projector un_unit_rep }

pub newtype Id[A] : A { pub constructor mk_id; pub projector un_id }

rec {
  pub type Root_tail = Id(.) & Id(Root);
  pub newtype Root : Unit_rep | Root_tail { pub constructor make_root; pub projector read_root }
}

pub fn base_payload() -> Unit_rep | Root_tail {
  __left__(Unit_rep, Root_tail, Unit_rep.mk_unit_rep(()))
}

pub fn keep(root: Root) -> Root { root }

pub fn accept_payload(payload: Unit_rep | Root_tail) -> I32 {
  __either__(
    , Unit_rep
    , Root_tail
    , I32
    , payload
    , .(_base: Unit_rep) -> I32 { 1(I32) }
    , .(_recursive: Root_tail) -> I32 { 0(I32) }
    )
}
