mod main;

import __intrinsics__;

host type I32 role(i32);

pub type { Unit_rep: . { pub mk; pub get } }

pub type { Id[A]: A { pub mk; pub get } }

rec {
  pub type Root_tail = Id[.] & Id[Root];
  pub type { Root: Unit_rep | Root_tail { pub mk; pub get } }
}

pub fn base_payload() -> Unit_rep | Root_tail { __left__[Unit_rep][Root_tail](Unit_rep.mk(())) }

pub fn keep(root: Root) -> Root { root }

pub fn accept_payload(payload: Unit_rep | Root_tail) -> I32 {
  __either__[Unit_rep][Root_tail][I32](
  , payload
  , .(_base: Unit_rep) -> I32 { 1[I32] }
  , .(_recursive: Root_tail) -> I32 { 0[I32] }
  )
}
