module geomlib/ops;

import geomlib/vec(Vec2, fst, mk, snd);

// An intra-dependency selective `use`: `ops` pulls `Vec2`/`mk`/`fst`/
// `snd` from its sibling module `vec`. After the dependency is
// re-rooted under the consumer's local name, this `from vec;` must
// become `from <local>/vec;` or it resolves to a non-existent root.
pub fn swap[A](v: Vec2(A)) -> Vec2(A) { mk(snd(v), fst(v)) }
