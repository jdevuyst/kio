module testapi/main;

import testapi(I32, String);
import testapi/fmt(i32_to_string);
import testapi/io(print);
import testapi/syntax(op ? _ : _, op _ => _, varop [! !], varop [% %], varop [+ +], varop [- -]);

pub fn main() -> . {
  let .(chosen: I32) = ? 5 : 6;
  print(i32_to_string(chosen));
  print("\n");
  print([% 1 => 2, 3 => 4 %]);
  print("\n");
  print([+ 7, 8 +]);
  print("\n");
  print([+ 9 +]);
  print("\n");
  print([% %]);
  print("\n");
  print([% 1 => 2 %]);
  print("\n");
  print([- -]);
  print("\n");
  print([- 1 => 2 -]);
  print("\n");
  print([- 1 => 2, 3 => 4, 5 => 6 -]);
  print("\n");
  print([! 1 => 2 !]);
  print("\n");
  print([! 1 => 2, 3 => 4, 5 => 6 !]);
  print("\n")
}
