mod testapi/main;

import testapi { type I32; type String }
import testapi/fmt { fn i32_to_string }
import testapi/io { fn print }
import testapi/syntax {
  op ? _ : _;
  op _ => _;
  op_var [! !];
  op_var [% %];
  op_var [+ +];
  op_var [- -]
}

pub fn main() {
  let .(chosen: I32) = ? 5 : 6;
  print(i32_to_string(chosen));
  print("\n");
  print([% 1 => 2, 3 => 4 %]);
  print("\n");
  print([+ 7, 8 +]);
  print("\n");
  print([+ 9 +]);
  print("\n");
  print([% %]);
  print("\n");
  print([% 1 => 2 %]);
  print("\n");
  print([- -]);
  print("\n");
  print([- 1 => 2 -]);
  print("\n");
  print([- 1 => 2, 3 => 4, 5 => 6 -]);
  print("\n");
  print([! 1 => 2 !]);
  print("\n");
  print([! 1 => 2, 3 => 4, 5 => 6 !]);
  print("\n")
}
