module testapi/main;

import actions(macro finish, macro identity_target);
import macros/control(macro if);
import testapi(Bool);
import testapi/io as io;

fn exercise(condition: Bool) {
  let selected =
    if(condition) {
      identity_target(.(value) { value })
    } else {
      finish(.(value: .) -> . { value }, _)
    };
  selected(())
}

pub fn main() { exercise(.t); io.print("first\n"); exercise(.f); io.print("second\n") }
