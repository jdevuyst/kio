mod testapi/main;

import testapi { type Int; type String }
import testapi/arith { fn add; fn mul }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

fn identity(n: Int) -> Int { n }

// Native dot chains compose ordinary calls.
pub fn main() {
  print(int_to_string(3.>add(4).>identity));
  // add(3, 4) = 7
  print("\n");
  print(int_to_string(3.>mul(4).>identity));
  // mul(3, 4) = 12
  print("\n")
}
