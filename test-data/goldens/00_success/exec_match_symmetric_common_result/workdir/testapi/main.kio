module testapi/main;

import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(Bool, I32, String);
import testapi/fmt(int_to_string);
import testapi/io(print);

fn identity[A](value: A) -> A { value }

fn identity_i32(value: I32) -> I32 { value }

type I32_fn = I32 -> I32;

fn concrete_string_clause(_text: String) -> I32 -> I32 { identity_i32 }

fn print_line(value: I32) -> . { print(int_to_string(value)); print("\n") }

fn check_named_clause_orders() -> . {
  let generic_first =
    match! widen_sum!(11, I32 | String) {
      (.(_number: I32) { identity(_) }, concrete_string_clause)
    };
  let _generic_first_value = generic_first(31);
  let concrete_first =
    match! widen_sum!(11, I32 | String) {
      (concrete_string_clause, .(_number: I32) { identity(_) })
    };
  let _concrete_first_value = concrete_first(32);
  ()
}

fn enclosing_common_result() -> I32_fn {
  match! widen_sum!("enclosing", I32 | String) {
    (.(_number: I32) { identity(_) }, .(_text: String) { identity(_) })
  }
}

fn check_contextual_common_results() -> . {
  let .(explicit: I32_fn) =
    match! widen_sum!(33, I32 | String) {
      (.(_number: I32) { identity(_) }, .(_text: String) { identity(_) })
    };
  let _explicit_value = explicit(33);
  let _enclosing_value = enclosing_common_result()(34);
  ()
}

fn check_three_result_positions() -> . {
  let concrete_first =
    match! widen_sum!(41, I32 | String | Bool) {
      (
        , .(_number: I32) { identity_i32 }
        , .(_text: String) { identity(_) }
        , .(_flag: Bool) { identity(_) }
        )
    };
  let _concrete_first_value = concrete_first(41);
  let concrete_middle =
    match! widen_sum!("middle", I32 | String | Bool) {
      (
        , .(_number: I32) { identity(_) }
        , .(_text: String) { identity_i32 }
        , .(_flag: Bool) { identity(_) }
        )
    };
  let _concrete_middle_value = concrete_middle(42);
  let concrete_last =
    match! widen_sum!(.t, I32 | String | Bool) {
      (
        , .(_number: I32) { identity(_) }
        , .(_text: String) { identity(_) }
        , .(_flag: Bool) { identity_i32 }
        )
    };
  let _concrete_last_value = concrete_last(43);
  ()
}

pub fn main() -> . {
  let generic_first =
    match! widen_sum!(11, I32 | String) {
      (
        , .(_number: I32) { print("match generic-first\n"); identity(_) }
        , .(_text: String) { print("match concrete-later\n"); identity_i32 }
        )
    };
  print_line(generic_first(11));
  let concrete_first =
    match! widen_sum!("later", I32 | String) {
      (
        , .(_number: I32) { print("match concrete-first\n"); identity_i32 }
        , .(_text: String) { print("match generic-later\n"); identity(_) }
        )
    };
  print_line(concrete_first(22));
  check_named_clause_orders();
  check_contextual_common_results();
  check_three_result_positions()
}
