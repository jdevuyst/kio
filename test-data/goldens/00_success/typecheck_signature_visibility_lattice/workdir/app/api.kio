mod app/api;

import app/types { type Shared }

host fn loop[S][R](step: S -> (S | R), state: S) -> R;

pub(app) type Scoped = .;

pub(app) type { Scoped_box: Scoped { pub(app) mk; pub(app) get } }

pub(app) type { Scoped_facade: Scoped { pub mk; pub get } }

pub(app) fn scoped_identity(value: Scoped_box) -> Scoped_box { value }

pub(app) fn imported_scoped_identity(value: Shared) -> Shared { value }

pub(app) rec(loop) fn recursive_identity(value: Scoped) -> Scoped { value }

type { Hidden: . { mk; get } }

type { Private_facade: Hidden { pub mk; pub get } }

pub type { Opaque: Hidden { mk; get } }

pub type Public_row = { Value: Opaque };
