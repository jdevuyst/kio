/// Checks that every visible type contract closes over exact dependencies.
mod testapi/main;

import loader {
  fn contract_check;
  fn contract_cons;
  fn contract_nil;
  fn diag_message;
  fn mk_expect;
  fn un_load_outcome
}
import loader { type Diag; type Image; type Load_outcome; type Lr_diag; type Lr_image }
import loader/scan { fn load_package }
import macros/match { macro match }
import testapi { type String }
import testapi/io { fn print }
import testapi/text { fn string_concat }

fn describe(outcome: Load_outcome) -> String {
  match(un_load_outcome(outcome)) {
    (
    , .(_loaded: Lr_image) { "(loaded)"[String] }
    , .(rejected: Lr_diag) { diag_message(Lr_diag.get(rejected)) }
    )
  }
}

fn line(label: String, source: String) -> String {
  string_concat(label, string_concat(describe(load_package(source)), "\n"[String]))
}

fn checked_image(image: Image, name: String, signature: String) -> String {
  let contract = contract_cons(mk_expect(name, signature), contract_nil());
  match(contract_check(image, contract)) {
    (.(diag: Diag) { diag_message(diag) }, .(_matched: .) { "ok"[String] })
  }
}

fn contract_line(label: String, source: String, name: String, signature: String) -> String {
  let result =
    match(un_load_outcome(load_package(source))) {
      (
      , .(loaded: Lr_image) { checked_image(Lr_image.get(loaded), name, signature) }
      , .(rejected: Lr_diag) { diag_message(Lr_diag.get(rejected)) }
      )
    };
  string_concat(label, string_concat(result, "\n"[String]))
}

pub fn main() {
  print(line(
  , "private alias in export: "[String]
  , "mod guest;\ntype Secret = .;\npub fn expose(value: Secret) -> . { () }\npkg "
    "guest;\nbridge { guest; }\n"[String]
  ));
  print(line(
  , "unbridged alias in export: "[String]
  , "mod provider;\npub type Public = .;\nmod guest;\nimport provider {type "
    "Public}\npub fn expose(value: Public) -> . { () }\npkg guest;\nbridge { "
    "guest; }\n"[String]
  ));
  print(line(
  , "phantom alias argument: "[String]
  , "mod hidden;\npub type { Hidden: . { pub mk; pub get; }; };\nmod aliases;\n"
    "pub type Drop[A] = .;\nmod guest;\nimport hidden {type Hidden}\nimport "
    "aliases {type Drop}\npub fn expose(value: Drop[Hidden]) -> . { () }\npkg "
    "guest;\nbridge { guest; aliases; }\n"[String]
  ));
  print(line(
  , "private identity-forwarding alias in export: "[String]
  , "mod guest;\npub type Base[A] = A;\ntype Secret[A] = Base[A];\npub fn "
    "expose(value: Secret[.]) -> . { () }\npkg guest;\nbridge { guest; }\n"[String]
  ));
  print(line(
  , "unbridged identity-forwarding alias in export: "[String]
  , "mod base;\npub type Base[A] = A;\nmod provider;\nimport base {type Base}\n"
    "pub type Public[A] = Base[A];\nmod guest;\nimport provider {type Public}\n"
    "pub fn expose(value: Public[.]) -> . { () }\npkg guest;\nbridge { guest; "
    "base; }\n"[String]
  ));
  print(line(
  , "chained identity-forwarding aliases: "[String]
  , "mod guest;\npub type Base[A] = A;\ntype Secret[A] = Base[A];\npub type "
    "Public[A] = Secret[A];\npub fn expose(value: Public[.]) -> . { () }\npkg "
    "guest;\nbridge { guest; }\n"[String]
  ));
  print(contract_line(
  , "public bridged identity-forwarding aliases: "[String]
  , "mod base;\nhost type Value;\nmod first;\nimport base {type Value}\npub type "
    "First = Value;\nmod second;\nimport first {type First}\npub type Second = "
    "First;\nmod guest;\nimport second {type Second}\npub fn expose(value: "
    "Second) -> Second { value }\npkg guest;\nbridge { base; first; second; "
    "guest; }\n"[String]
  , "expose"[String]
  , "(h{base.Value}) -> h{base.Value}"[String]
  ))
}
