module testapi/types;

import __intrinsics__;

import testapi(I32);

type { Hidden_payload: I32 { mk; get } }

pub type { Opaque_a: Hidden_payload { mk; get } }

pub type { Opaque_b: Hidden_payload { mk; get } }

pub type { Constructor_only: I32 { pub mk; get } }

pub type { Projector_only: I32 { mk; pub get } }

pub type { Both_public: I32 { pub mk; pub get } }

pub type { Constructor_pair: I32 & I32 { pub mk; get } }

pub type { Projector_pair: I32 & I32 { mk; pub get } }

pub type { Constructor_generic[A]: A { pub mk; get } }

pub type { Projector_generic[A]: A { mk; pub get } }

pub type { Packed_function: (I32 & I32) -> I32 { pub mk; pub get } }

pub type { Constructor_spread: [A] (I32 & A) -> I32 { pub mk; get } }

pub type { Projector_spread: [A] (I32 & A) -> I32 { mk; pub get } }

pub type { Existential_spread <U>: [A] (U & A) -> U { mk; pub get } }

pub type { Existential_unit <U>: U { mk; pub get } }

pub type Erased_unit[A] = .;

pub type { Existential_empty <U>: Erased_unit[U] { mk; pub get } }

pub rec type {
  Recursive_existential_function <U>: U -> Recursive_existential_function { mk; pub get }
}

pub rec type { Recursive_both: . | Recursive_both { pub mk; pub get } }

pub rec type { Recursive_constructor: . | Recursive_constructor { pub mk; get } }

pub rec type { Recursive_projector: . | Recursive_projector { mk; pub get } }

rec {
  pub type { Atomic_cycle_inner: . | Visible_cycle_outer { pub mk; get } };
  pub type { Visible_cycle_outer: Atomic_cycle_inner { pub mk; pub get } }
}

pub type { Comptime_bool: ! | . { pub mk; get } }

pub type { Visible_comptime_outer: Comptime_bool { pub mk; pub get } }

pub fn make_a(value: I32) -> Opaque_a { Opaque_a.mk(Hidden_payload.mk(value)) }

pub fn read_a(value: Opaque_a) -> I32 { Hidden_payload.get(Opaque_a.get(value)) }

pub fn make_b(value: I32) -> Opaque_b { Opaque_b.mk(Hidden_payload.mk(value)) }

pub fn read_b(value: Opaque_b) -> I32 { Hidden_payload.get(Opaque_b.get(value)) }

pub fn read_constructor_only_value(value: Constructor_only) -> I32 { Constructor_only.get(value) }

pub fn make_projector_only_value(value: I32) -> Projector_only { Projector_only.mk(value) }

pub fn read_constructor_pair_value(value: Constructor_pair) -> I32 & I32 {
  Constructor_pair.get(value)
}

pub fn make_projector_pair_value(value: I32 & I32) -> Projector_pair { Projector_pair.mk(value) }

pub fn read_constructor_generic_value[A](value: Constructor_generic[A]) -> A {
  Constructor_generic.get[A](value)
}

pub fn make_projector_generic_value[A](value: A) -> Projector_generic[A] {
  Projector_generic.mk[A](value)
}

pub fn invoke_constructor_spread_i32(value: Constructor_spread, seed: I32) -> I32 {
  Constructor_spread.get(value)[I32](__pair__[I32][I32](seed, 7[I32]))
}

pub fn invoke_constructor_spread_unit(value: Constructor_spread, seed: I32) -> I32 {
  Constructor_spread.get(value)[.](__pair__[I32][.](seed, ()))
}

pub fn make_projector_spread_value() -> Projector_spread {
  Projector_spread.mk(.[A](value: I32 & A) -> I32 { __fst__[I32][A](value) })
}

pub fn make_existential_spread_value() -> Existential_spread {
  Existential_spread.mk[I32](.[A](value: I32 & A) -> I32 { __fst__[I32][A](value) })
}

pub fn make_recursive_existential_function_value() -> Recursive_existential_function {
  Recursive_existential_function.mk[!](.(value: !) -> Recursive_existential_function {
    __absurd__[Recursive_existential_function](value)
  })
}

pub fn make_existential_unit_value() -> Existential_unit { Existential_unit.mk(()) }

pub fn make_existential_empty_value() -> Existential_empty { Existential_empty.mk[I32](()) }

pub fn recursive_both_base_payload() -> . | Recursive_both { __left__[.][Recursive_both](()) }

pub fn recursive_both_payload_is_base(value: . | Recursive_both) -> I32 {
  __either__[.][Recursive_both][I32](
  , value
  , .(done: .) -> I32 { 1[I32] }
  , .(rest: Recursive_both) -> I32 { 0[I32] }
  )
}

pub fn recursive_constructor_base_payload() -> . | Recursive_constructor {
  __left__[.][Recursive_constructor](())
}

pub fn read_recursive_constructor_value(value: Recursive_constructor) -> . | Recursive_constructor {
  Recursive_constructor.get(value)
}

pub fn recursive_constructor_payload_is_base(value: . | Recursive_constructor) -> I32 {
  __either__[.][Recursive_constructor][I32](
  , value
  , .(done: .) -> I32 { 1[I32] }
  , .(rest: Recursive_constructor) -> I32 { 0[I32] }
  )
}

pub fn make_recursive_projector_value(value: . | Recursive_projector) -> Recursive_projector {
  Recursive_projector.mk(value)
}

pub fn make_recursive_projector_base() -> Recursive_projector {
  Recursive_projector.mk(__left__[.][Recursive_projector](()))
}

pub fn recursive_projector_payload_is_base(value: . | Recursive_projector) -> I32 {
  __either__[.][Recursive_projector][I32](
  , value
  , .(done: .) -> I32 { 1[I32] }
  , .(rest: Recursive_projector) -> I32 { 0[I32] }
  )
}

pub fn make_visible_cycle_outer_base() -> Visible_cycle_outer {
  Visible_cycle_outer.mk(Atomic_cycle_inner.mk(__left__[.][Visible_cycle_outer](())))
}

pub fn make_visible_comptime_outer_base() -> Visible_comptime_outer {
  Visible_comptime_outer.mk(Comptime_bool.mk(__right__[!][.](())))
}
