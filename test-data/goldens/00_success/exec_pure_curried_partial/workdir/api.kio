module api;

type { Seed: . { mk; get } }

pub type { Result: . { mk; get } }

fn apply(thunk: . -> Result) -> Result { thunk(()) }

fn staged_unit(seed: .)(later: .) -> Result { Result.mk(seed) }

fn staged_value(seed: Seed)(later: .) -> Result { Result.mk(Seed.get(seed)) }

fn staged_three(seed: .)(middle: .)(later: .) -> Result { Result.mk(seed) }

pub fn unit_partial() -> Result { let part = staged_unit(()); part(()) }

pub fn value_partial() -> Result { apply(staged_value(Seed.mk(()))) }

pub fn three_partial() -> Result {
  let middle = staged_three(());
  let later = middle(());
  later(())
}

pub fn main() {
  let first = unit_partial();
  let second = value_partial();
  let third = three_partial();
  ()
}
