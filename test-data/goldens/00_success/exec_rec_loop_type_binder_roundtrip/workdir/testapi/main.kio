module testapi/main;

import elab/control(if);
import testapi(Bool, I32, String);
import testapi/arith(leq_i32, sub_i32);
import testapi/fmt(i32_to_string);
import testapi/io(print);
import testapi/iter(loop);

rec(loop) fn map_after[A][B](remaining: I32, transform: A -> B, value: A) -> B {
  if! leq_i32(remaining, 0) {
    transform(value)
  } else {
    rec map_after(sub_i32(remaining, 1), transform, value)
  }
}

pub fn main() -> . { print(map_after(3, i32_to_string, 42)); print("\n") }
