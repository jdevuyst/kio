mod testapi/main;

import macros/control { macro if }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn leq_i32; fn sub_i32 }
import testapi/fmt { fn i32_to_string }
import testapi/io { fn print }
import testapi/iter { fn loop }

rec(loop) fn map_after[A][B](remaining: I32, transform: A -> B, value: A) -> B {
  if(leq_i32(remaining, 0)) {
    transform(value)
  } else {
    recur map_after(sub_i32(remaining, 1), transform, value)
  }
}

pub fn main() { print(map_after(3, i32_to_string, 42)); print("\n") }
