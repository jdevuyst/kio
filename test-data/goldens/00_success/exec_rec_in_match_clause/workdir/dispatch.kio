module dispatch;

import __comptime__;
import elab/match as canonical;

pub pure fn dispatch_checked(
  , ct: __Comptime__
  , fills: __Fill_ctx__
  , source: __Type__
  , scrutinee: __Checked_term__
  , clauses_type: __Type__
  , clauses: __Checked_term__
  , target: __Type__
  ) -> __Checked_term__ & __Fill_ctx__ {
  canonical.match_checked(ct, fills, source, scrutinee, clauses_type, clauses, target)
}

pub elab dispatch : [Source] Source -> [Clauses] Clauses -> [Target] Target { impl(fills) dispatch_checked }
