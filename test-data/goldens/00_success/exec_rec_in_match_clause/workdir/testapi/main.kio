mod testapi/main;

import macros/control { macro if }
import macros/match { macro match as dispatch }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn add_i32; fn leq_i32; fn mod_i32; fn sub_i32 }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print; fn read_ascii_line }
import testapi/iter { fn loop }
import testapi/text { fn string_eq }

rec(loop) fn consume(remaining: I32, count: I32) -> I32 {
  if(leq_i32(remaining, 0)) {
    count
  } else if(leq_i32(mod_i32(remaining, 4), 0)) {
    dispatch[_][(String -> I32) & (. -> I32)](
    , read_ascii_line()
    , (
      , .x. {
          if(string_eq(x1, "skip")) {
            count
          } else {
            recur consume(sub_i32(remaining, 1), add_i32(count, 1))
          }
        }
      , .(_eof: .) { count }
      )
    )
  } else if(leq_i32(mod_i32(remaining, 4), 1)) {
    read_ascii_line()
      .>dispatch[_][(String -> I32) & (. -> I32)]((
      , .(line: _) {
          if(string_eq(line, "skip")) {
            count
          } else {
            recur consume(sub_i32(remaining, 1), add_i32(count, 1))
          }
        }
      , .(_eof: .) { count }
      ))
  } else if(leq_i32(mod_i32(remaining, 4), 2)) {
    // Infer the clause-product type and this recursive clause's result.
    dispatch(
    , read_ascii_line()
    , (
      , .(line: String) {
          if(string_eq(line, "skip")) {
            count
          } else {
            recur consume(sub_i32(remaining, 1), add_i32(count, 1))
          }
        }
      , .(_eof: .) { count }
      )
    )
  } else {
    read_ascii_line()
      .>dispatch[_][(String -> I32) & (. -> I32)]((
      , .(line: String) {
          if(string_eq(line, "skip")) {
            count
          } else {
            recur consume(sub_i32(remaining, 1), add_i32(count, 1))
          }
        }
      , .(_eof: .) { count }
      ))
  }
}

pub fn main() { print(int_to_string(consume(8, sub_i32(0, 1)))) }
