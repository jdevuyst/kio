package build_open_world_imported_newtype;

build {
  cache "out/.kio-cache/";

  target js {
    out "out/js/"
  };

  target ts {
    out "out/ts/"
  };

  target python {
    out "out/python/"
  };

  target java {
    out "out/java/"
  };

  target rust {
    out "out/rust/"
  };

  target go {
    out "out/go/"
  };

  target swift {
    out "out/swift/"
  };

  target haskell {
    out "out/haskell/"
  };

  target kio-prime {
    out "out/kio-prime/"
  }
}

bridge {
  build_open_world_imported_newtype;
  build_open_world_imported_newtype/**
}
