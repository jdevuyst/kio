mod macros;

import __intrinsics__;

import __comptime__;

pub pure fn id_impl(
, _ct: __Comptime__
, _source: __Type__
, value: __Checked_term__
, _target: __Type__
) -> __Checked_term__ { value }

pub pure fn id_default_impl(
, _ct: __Comptime__
, _source: __Type__
, value: __Checked_term__
, _target: .
) -> __Checked_term__ { value }

pub pure fn left_impl(
, ct: __Comptime__
, _source: __Type__
, value: __Checked_term__
, target: __Type__
) -> __Checked_term__ { __intrinsic_left__(ct, target, value) }

pub macro id_default : [Source] Source -> [Target] Target { impl id_default_impl }

pub macro id_user : [Source] Source -> [Target] Target { impl id_impl }

pub macro left_user : [Source] Source -> [Target] Target { impl left_impl }
