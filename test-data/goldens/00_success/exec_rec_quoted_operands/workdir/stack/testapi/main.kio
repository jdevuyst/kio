module stack/testapi/main;

import stack/elab/control(if);
import stack/testapi(Bool, I32);
import stack/testapi/arith as arith;
import stack/testapi/io as io;
import stack/testapi/iter(loop);

pub rec(loop) fn deep(n: I32) -> Bool {
  if! arith.leq_i32(n, 0) {
    .t
  } else if! rec(cont) deep(arith.sub_i32(n, 1)) {
    .t
  } else {
    .f
  }
}

pub fn main() -> . {
  io.print("deep quotation\n");
  if! deep(100000) {
    io.print("done\n")
  } else {
    io.print("unexpected false\n")
  }
}
