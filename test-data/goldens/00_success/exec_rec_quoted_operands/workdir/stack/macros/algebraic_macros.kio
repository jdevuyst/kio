/// Algebraic coercion macros for DNF-level product and sum reshaping in the macro POC.
module stack/macros/algebraic_macros;

import __intrinsics__;

import __comptime__;
import stack/macros/macro_util(
, Dnf_branch
, Dnf_branch_list
, Macro_result
, Slot_list
, Type_list
, Type_pair
, build_product_from_slots
, build_widen_product_from_slots
, dnf_branch_slots
, dnf_branch_spine
, dnf_branch_type
, dnf_branches
, dnf_eliminate_with_use
, err
, finish_macro_result
, macro_result_ok
, materialize_dnf_branch
, materialize_dnf_branch_with_spine
, single_dnf_branch
, type_multiset_contains_all
, type_multiset_equal
);

type Branch_build_flags = Comptime_bool & Comptime_bool;

type Function_view = __Type__ & __Type__;

type Forall_view = __Type_var__ & __Type_arity__ & __Type__;

type Type_view_tail7 = __Type_name__;

type Type_view_tail6 = __Type_var__ | Type_view_tail7;

type Type_view_tail5 = Forall_view | Type_view_tail6;

type Type_view_tail4 = Function_view | Type_view_tail5;

type Type_view_tail3 = Type_pair | Type_view_tail4;

type Type_view_tail2 = Type_pair | Type_view_tail3;

type Type_view_tail1 = . | Type_view_tail2;

type Maybe_function_view = Function_view | .;

type Used_term = Comptime_bool & __Checked_term__;

type Ease_mapper = __Checked_term__ -> Used_term;

type Ease_adapter_result = Ease_mapper | __Diagnostic_text__;

rec type { Spine_list: . | (Type_list & Spine_list) { mk; get } }

pure fn spine_nil() -> Spine_list { Spine_list.mk(__left__[.][Type_list & Spine_list](())) }

pure fn spine_cons(head: Type_list, tail: Spine_list) -> Spine_list {
  Spine_list.mk(__right__[.][Type_list & Spine_list]((head, tail)))
}

type Spine_reverse_state = Spine_list;

type Spine_reverse_next = Spine_list & Spine_reverse_state;

type Spine_reverse_step = Spine_list | Spine_reverse_next;

pure fn spine_reverse_step(fuel: Spine_list, acc: Spine_reverse_state) -> Spine_reverse_step {
  __either__[.][Type_list & Spine_list][Spine_reverse_step](
  , Spine_list.get(fuel)
  , .(_done: .) -> Spine_reverse_step { __left__[Spine_list][Spine_reverse_next](acc) }
  , .(cell: Type_list & Spine_list) -> Spine_reverse_step {
      __right__[Spine_list][Spine_reverse_next]((
      , __snd__[Type_list][Spine_list](cell)
      , spine_cons(__fst__[Type_list][Spine_list](cell), acc)
      ))
    }
  )
}

pure fn spine_prepend_reverse(ct: __Comptime__, prefix_rev: Spine_list, tail: Spine_list) -> Spine_list {
  __structural_recur__(ct)[Spine_list][Spine_reverse_state][Spine_list](
  , prefix_rev
  , tail
  , .(
    , loop_recur: (Spine_list & Spine_reverse_state) -> Spine_list
    , loop_fuel: Spine_list
    , loop_state: Spine_reverse_state
    ) -> Spine_list {
      let loop_step_fn = spine_reverse_step;
      __either__[Spine_list][Spine_list & Spine_reverse_state][Spine_list](
      , loop_step_fn(loop_fuel, loop_state)
      , .(loop_done: Spine_list) -> Spine_list { loop_done }
      , .(loop_next: Spine_list & Spine_reverse_state) -> Spine_list {
          loop_recur(
          , __fst__[Spine_list][Spine_reverse_state](loop_next)
          , __snd__[Spine_list][Spine_reverse_state](loop_next)
          )
        }
      )
    }
  )
}

type Branch_spine_state = Spine_list;

type Branch_spine_next = Dnf_branch_list & Branch_spine_state;

type Branch_spine_step = Spine_list | Branch_spine_next;

pure fn branch_spines(ct: __Comptime__, branches: Dnf_branch_list) -> Spine_list {
  __structural_recur__(ct)[Dnf_branch_list][Branch_spine_state][Spine_list](
  , branches
  , spine_nil()
  , .(
    , loop_recur: (Dnf_branch_list & Branch_spine_state) -> Spine_list
    , loop_fuel: Dnf_branch_list
    , loop_state: Branch_spine_state
    ) -> Spine_list {
      let loop_step_fn =
        .(fuel: Dnf_branch_list, state: Branch_spine_state) -> Branch_spine_step {
          __either__[.][Dnf_branch & Dnf_branch_list][Branch_spine_step](
          , Type_list.get(fuel)
          , .(_done: .) -> Branch_spine_step { __left__[Spine_list][Branch_spine_next](state) }
          , .(cell: Dnf_branch & Dnf_branch_list) -> Branch_spine_step {
              let branch_type = dnf_branch_type(ct, __fst__[Dnf_branch][Dnf_branch_list](cell));
              __right__[Spine_list][Branch_spine_next]((
              , __snd__[Dnf_branch][Dnf_branch_list](cell)
              , spine_cons(dnf_branch_spine(ct, branch_type), state)
              ))
            }
          )
        };
      __either__[Spine_list][Dnf_branch_list & Branch_spine_state][Spine_list](
      , loop_step_fn(loop_fuel, loop_state)
      , .(loop_done: Spine_list) -> Spine_list { loop_done }
      , .(loop_next: Dnf_branch_list & Branch_spine_state) -> Spine_list {
          loop_recur(
          , __fst__[Dnf_branch_list][Branch_spine_state](loop_next)
          , __snd__[Dnf_branch_list][Branch_spine_state](loop_next)
          )
        }
      )
    }
  )
}

pure fn flags_allow_drop(ct: __Comptime__, flags: Branch_build_flags) -> Comptime_bool {
  __fst__[Comptime_bool](flags)
}

pure fn flags_allow_dup(ct: __Comptime__, flags: Branch_build_flags) -> Comptime_bool {
  __snd__[Comptime_bool](flags)
}

pure fn ease_adapter_ok(ct: __Comptime__, mapper: Ease_mapper) -> Ease_adapter_result {
  __left__[Ease_mapper][__Diagnostic_text__](mapper)
}

pure fn ease_adapter_err(ct: __Comptime__, message: __Diagnostic_text__) -> Ease_adapter_result {
  __right__[Ease_mapper][__Diagnostic_text__](message)
}

pure fn some_function_view(ct: __Comptime__, view: Function_view) -> Maybe_function_view {
  __left__[Function_view][.](view)
}

pure fn no_function_view(ct: __Comptime__) -> Maybe_function_view {
  __right__[Function_view][.](())
}

pure fn function_view(ct: __Comptime__, typ: __Type__) -> Maybe_function_view {
  __either__[.][Type_view_tail1][Maybe_function_view](
  , __type_view__(ct, typ)
  , .(_unit: .) -> Maybe_function_view { no_function_view(ct) }
  , .(tail1: Type_view_tail1) -> Maybe_function_view {
      __either__[.][Type_view_tail2][Maybe_function_view](
      , tail1
      , .(_bottom: .) -> Maybe_function_view { no_function_view(ct) }
      , .(tail2: Type_view_tail2) -> Maybe_function_view {
          __either__[Type_pair][Type_view_tail3][Maybe_function_view](
          , tail2
          , .(_product: Type_pair) -> Maybe_function_view { no_function_view(ct) }
          , .(tail3: Type_view_tail3) -> Maybe_function_view {
              __either__[Type_pair][Type_view_tail4][Maybe_function_view](
              , tail3
              , .(_sum: Type_pair) -> Maybe_function_view { no_function_view(ct) }
              , .(tail4: Type_view_tail4) -> Maybe_function_view {
                  __either__[Function_view][Type_view_tail5][Maybe_function_view](
                  , tail4
                  , .(view: Function_view) -> Maybe_function_view { some_function_view(ct, view) }
                  , .(_tail5: Type_view_tail5) -> Maybe_function_view { no_function_view(ct) }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

pure fn function_param(ct: __Comptime__, view: Function_view) -> __Type__ {
  __fst__[__Type__][__Type__](view)
}

pure fn function_result(ct: __Comptime__, view: Function_view) -> __Type__ {
  __snd__[__Type__][__Type__](view)
}

pure fn identity_mapper(ct: __Comptime__, _source: __Type__) -> Ease_mapper {
  .(value: __Checked_term__) -> Used_term { (__.t__(ct), value) }
}

pure fn branch_can_land_from_factors(
, ct: __Comptime__
, source_factors: Type_list
, target_factors: Type_list
, flags: Branch_build_flags
) -> Comptime_bool {
  __comptime_if_then_else__(ct)(
  , flags_allow_dup(ct, flags)
  , .() -> Comptime_bool { type_multiset_contains_all(ct, source_factors, target_factors) }
  , .() -> Comptime_bool {
      __comptime_if_then_else__(ct)(
      , flags_allow_drop(ct, flags)
      , .() -> Comptime_bool { type_multiset_contains_all(ct, target_factors, source_factors) }
      , .() -> Comptime_bool { type_multiset_equal(ct, source_factors, target_factors) }
      )
    }
  )
}

pure fn build_branch_value_from_parts(
, ct: __Comptime__
, source_factors: Type_list
, target_factors: Type_list
, source_slots: Slot_list
, flags: Branch_build_flags
) -> Macro_result {
  __comptime_if_then_else__(ct)(
  , flags_allow_dup(ct, flags)
  , .() -> Macro_result {
      __comptime_if_then_else__(ct)(
      , type_multiset_contains_all(ct, source_factors, target_factors)
      , .() -> Macro_result {
          build_widen_product_from_slots(ct, target_factors, source_factors, source_slots)
        }
      , .() -> Macro_result { err(ct, __"source DNF branch would be dropped"__(ct)) }
      )
    }
  , .() -> Macro_result {
      __comptime_if_then_else__(ct)(
      , flags_allow_drop(ct, flags)
      , .() -> Macro_result {
          build_product_from_slots(ct, target_factors, source_factors, source_slots, __.f__(ct))
        }
      , .() -> Macro_result {
          build_product_from_slots(ct, target_factors, source_factors, source_slots, __.t__(ct))
        }
      )
    }
  )
}

type Maybe_spine_take = Spine_list | .;

pure fn spine_take_some(rest: Spine_list) -> Maybe_spine_take { __left__[Spine_list][.](rest) }

pure fn spine_take_none() -> Maybe_spine_take { __right__[Spine_list][.](()) }

type Spine_take_state = Spine_list;

type Spine_take_next = Spine_list & Spine_take_state;

type Spine_take_step = Maybe_spine_take | Spine_take_next;

pure fn take_first_target_for_source(
, ct: __Comptime__
, source_factors: Type_list
, targets: Spine_list
, flags: Branch_build_flags
) -> Maybe_spine_take {
  __structural_recur__(ct)[Spine_list][Spine_take_state][Maybe_spine_take](
  , targets
  , spine_nil()
  , .(
    , loop_recur: (Spine_list & Spine_take_state) -> Maybe_spine_take
    , loop_fuel: Spine_list
    , loop_state: Spine_take_state
    ) -> Maybe_spine_take {
      let loop_step_fn =
        .(fuel: Spine_list, prefix_rev: Spine_take_state) -> Spine_take_step {
          __either__[.][Type_list & Spine_list][Spine_take_step](
          , Spine_list.get(fuel)
          , .(_done: .) -> Spine_take_step {
              __left__[Maybe_spine_take][Spine_take_next](spine_take_none())
            }
          , .(cell: Type_list & Spine_list) -> Spine_take_step {
              __comptime_if_then_else__(ct)(
              , branch_can_land_from_factors(
                , ct
                , source_factors
                , __fst__[Type_list][Spine_list](cell)
                , flags
                )
              , .() -> Spine_take_step {
                  __left__[Maybe_spine_take][Spine_take_next](spine_take_some(spine_prepend_reverse(
                  , ct
                  , prefix_rev
                  , __snd__[Type_list][Spine_list](cell)
                  )))
                }
              , .() -> Spine_take_step {
                  __right__[Maybe_spine_take][Spine_take_next]((
                  , __snd__[Type_list][Spine_list](cell)
                  , spine_cons(__fst__[Type_list][Spine_list](cell), prefix_rev)
                  ))
                }
              )
            }
          )
        };
      __either__[Maybe_spine_take][Spine_list & Spine_take_state][Maybe_spine_take](
      , loop_step_fn(loop_fuel, loop_state)
      , .(loop_done: Maybe_spine_take) -> Maybe_spine_take { loop_done }
      , .(loop_next: Spine_list & Spine_take_state) -> Maybe_spine_take {
          loop_recur(
          , __fst__[Spine_list][Spine_take_state](loop_next)
          , __snd__[Spine_list][Spine_take_state](loop_next)
          )
        }
      )
    }
  )
}

type Consume_state = Spine_list;

type Consume_next = Spine_list & Consume_state;

type Consume_step = Comptime_bool | Consume_next;

pure fn sources_fit_targets_consuming(
, ct: __Comptime__
, sources: Spine_list
, targets: Spine_list
, flags: Branch_build_flags
) -> Comptime_bool {
  __structural_recur__(ct)[Spine_list][Consume_state][Comptime_bool](
  , sources
  , targets
  , .(
    , loop_recur: (Spine_list & Consume_state) -> Comptime_bool
    , loop_fuel: Spine_list
    , loop_state: Consume_state
    ) -> Comptime_bool {
      let loop_step_fn =
        .(fuel: Spine_list, available_targets: Consume_state) -> Consume_step {
          __either__[.][Type_list & Spine_list][Consume_step](
          , Spine_list.get(fuel)
          , .(_done: .) -> Consume_step { __left__[Comptime_bool][Consume_next](__.t__(ct)) }
          , .(cell: Type_list & Spine_list) -> Consume_step {
              __either__[Spine_list][.][Consume_step](
              , take_first_target_for_source(
                , ct
                , __fst__[Type_list][Spine_list](cell)
                , available_targets
                , flags
                )
              , .(remaining_targets: Spine_list) -> Consume_step {
                  __right__[Comptime_bool][Consume_next]((
                  , __snd__[Type_list][Spine_list](cell)
                  , remaining_targets
                  ))
                }
              , .(_missing: .) -> Consume_step { __left__[Comptime_bool][Consume_next](__.f__(ct)) }
              )
            }
          )
        };
      __either__[Comptime_bool][Spine_list & Consume_state][Comptime_bool](
      , loop_step_fn(loop_fuel, loop_state)
      , .(loop_done: Comptime_bool) -> Comptime_bool { loop_done }
      , .(loop_next: Spine_list & Consume_state) -> Comptime_bool {
          loop_recur(
          , __fst__[Spine_list][Consume_state](loop_next)
          , __snd__[Spine_list][Consume_state](loop_next)
          )
        }
      )
    }
  )
}

pure fn into_branch_shape_ok(
, ct: __Comptime__
, source: __Type__
, target: __Type__
, flags: Branch_build_flags
) -> Comptime_bool {
  sources_fit_targets_consuming(
  , ct
  , branch_spines(ct, dnf_branches(ct, source))
  , branch_spines(ct, dnf_branches(ct, target))
  , flags
  )
}

pure fn iso_branch_shape_ok(
, ct: __Comptime__
, source: __Type__
, target: __Type__
, flags: Branch_build_flags
) -> Comptime_bool {
  __comptime_if_then_else__(ct)(
  , sources_fit_targets_consuming(
    , ct
    , branch_spines(ct, dnf_branches(ct, source))
    , branch_spines(ct, dnf_branches(ct, target))
    , flags
    )
  , .() -> Comptime_bool {
      sources_fit_targets_consuming(
      , ct
      , branch_spines(ct, dnf_branches(ct, target))
      , branch_spines(ct, dnf_branches(ct, source))
      , flags
      )
    }
  , .() -> Comptime_bool { __.f__(ct) }
  )
}

type Any_target_state = Comptime_bool;

type Any_target_next = Spine_list & Any_target_state;

type Any_target_step = Comptime_bool | Any_target_next;

pure fn source_factors_have_target(
, ct: __Comptime__
, source_factors: Type_list
, targets: Spine_list
, flags: Branch_build_flags
) -> Comptime_bool {
  __structural_recur__(ct)[Spine_list][Any_target_state](
  , targets
  , __.f__(ct)
  , .(
    , loop_recur: (Spine_list & Any_target_state) -> Comptime_bool
    , loop_fuel: Spine_list
    , loop_state: Any_target_state
    ) -> Comptime_bool {
      let loop_step_fn =
        .(fuel: Spine_list, _found: Any_target_state) -> Any_target_step {
          __either__[.][Type_list & Spine_list][Any_target_step](
          , Spine_list.get(fuel)
          , .(_done: .) -> Any_target_step { __left__[Comptime_bool][Any_target_next](__.f__(ct)) }
          , .(cell: Type_list & Spine_list) -> Any_target_step {
              __comptime_if_then_else__(ct)(
              , branch_can_land_from_factors(
                , ct
                , source_factors
                , __fst__[Type_list][Spine_list](cell)
                , flags
                )
              , .() -> Any_target_step { __left__[Comptime_bool][Any_target_next](__.t__(ct)) }
              , .() -> Any_target_step {
                  __right__[Comptime_bool][Any_target_next]((
                  , __snd__[Type_list][Spine_list](cell)
                  , __.f__(ct)
                  ))
                }
              )
            }
          )
        };
      __either__[Comptime_bool][Spine_list & Any_target_state][Comptime_bool](
      , loop_step_fn(loop_fuel, loop_state)
      , .(loop_done: Comptime_bool) -> Comptime_bool { loop_done }
      , .(loop_next: Spine_list & Any_target_state) -> Comptime_bool {
          loop_recur(
          , __fst__[Spine_list][Any_target_state](loop_next)
          , __snd__[Spine_list][Any_target_state](loop_next)
          )
        }
      )
    }
  )
}

pure fn target_factors_have_source(
, ct: __Comptime__
, target_factors: Type_list
, sources: Spine_list
, flags: Branch_build_flags
) -> Comptime_bool {
  __structural_recur__(ct)[Spine_list][Any_target_state](
  , sources
  , __.f__(ct)
  , .(
    , loop_recur: (Spine_list & Any_target_state) -> Comptime_bool
    , loop_fuel: Spine_list
    , loop_state: Any_target_state
    ) -> Comptime_bool {
      let loop_step_fn =
        .(fuel: Spine_list, _found: Any_target_state) -> Any_target_step {
          __either__[.][Type_list & Spine_list][Any_target_step](
          , Spine_list.get(fuel)
          , .(_done: .) -> Any_target_step { __left__[Comptime_bool][Any_target_next](__.f__(ct)) }
          , .(cell: Type_list & Spine_list) -> Any_target_step {
              __comptime_if_then_else__(ct)(
              , branch_can_land_from_factors(
                , ct
                , __fst__[Type_list][Spine_list](cell)
                , target_factors
                , flags
                )
              , .() -> Any_target_step { __left__[Comptime_bool][Any_target_next](__.t__(ct)) }
              , .() -> Any_target_step {
                  __right__[Comptime_bool][Any_target_next]((
                  , __snd__[Type_list][Spine_list](cell)
                  , __.f__(ct)
                  ))
                }
              )
            }
          )
        };
      __either__[Comptime_bool][Spine_list & Any_target_state][Comptime_bool](
      , loop_step_fn(loop_fuel, loop_state)
      , .(loop_done: Comptime_bool) -> Comptime_bool { loop_done }
      , .(loop_next: Spine_list & Any_target_state) -> Comptime_bool {
          loop_recur(
          , __fst__[Spine_list][Any_target_state](loop_next)
          , __snd__[Spine_list][Any_target_state](loop_next)
          )
        }
      )
    }
  )
}

type All_branch_state = Comptime_bool;

type All_branch_next = Spine_list & All_branch_state;

type All_branch_step = Comptime_bool | All_branch_next;

pure fn all_sources_have_targets(
, ct: __Comptime__
, sources: Spine_list
, targets: Spine_list
, flags: Branch_build_flags
) -> Comptime_bool {
  __structural_recur__(ct)[Spine_list][All_branch_state](
  , sources
  , __.t__(ct)
  , .(
    , loop_recur: (Spine_list & All_branch_state) -> Comptime_bool
    , loop_fuel: Spine_list
    , loop_state: All_branch_state
    ) -> Comptime_bool {
      let loop_step_fn =
        .(fuel: Spine_list, _ok_so_far: All_branch_state) -> All_branch_step {
          __either__[.][Type_list & Spine_list][All_branch_step](
          , Spine_list.get(fuel)
          , .(_done: .) -> All_branch_step { __left__[Comptime_bool][All_branch_next](__.t__(ct)) }
          , .(cell: Type_list & Spine_list) -> All_branch_step {
              __comptime_if_then_else__(ct)(
              , source_factors_have_target(ct, __fst__[Type_list][Spine_list](cell), targets, flags)
              , .() -> All_branch_step {
                  __right__[Comptime_bool][All_branch_next]((
                  , __snd__[Type_list][Spine_list](cell)
                  , __.t__(ct)
                  ))
                }
              , .() -> All_branch_step { __left__[Comptime_bool][All_branch_next](__.f__(ct)) }
              )
            }
          )
        };
      __either__[Comptime_bool][Spine_list & All_branch_state][Comptime_bool](
      , loop_step_fn(loop_fuel, loop_state)
      , .(loop_done: Comptime_bool) -> Comptime_bool { loop_done }
      , .(loop_next: Spine_list & All_branch_state) -> Comptime_bool {
          loop_recur(
          , __fst__[Spine_list][All_branch_state](loop_next)
          , __snd__[Spine_list][All_branch_state](loop_next)
          )
        }
      )
    }
  )
}

pure fn all_targets_have_sources(
, ct: __Comptime__
, sources: Spine_list
, targets: Spine_list
, flags: Branch_build_flags
) -> Comptime_bool {
  __structural_recur__(ct)[Spine_list][All_branch_state](
  , targets
  , __.t__(ct)
  , .(
    , loop_recur: (Spine_list & All_branch_state) -> Comptime_bool
    , loop_fuel: Spine_list
    , loop_state: All_branch_state
    ) -> Comptime_bool {
      let loop_step_fn =
        .(fuel: Spine_list, _ok_so_far: All_branch_state) -> All_branch_step {
          __either__[.][Type_list & Spine_list][All_branch_step](
          , Spine_list.get(fuel)
          , .(_done: .) -> All_branch_step { __left__[Comptime_bool][All_branch_next](__.t__(ct)) }
          , .(cell: Type_list & Spine_list) -> All_branch_step {
              __comptime_if_then_else__(ct)(
              , target_factors_have_source(ct, __fst__[Type_list][Spine_list](cell), sources, flags)
              , .() -> All_branch_step {
                  __right__[Comptime_bool][All_branch_next]((
                  , __snd__[Type_list][Spine_list](cell)
                  , __.t__(ct)
                  ))
                }
              , .() -> All_branch_step { __left__[Comptime_bool][All_branch_next](__.f__(ct)) }
              )
            }
          )
        };
      __either__[Comptime_bool][Spine_list & All_branch_state][Comptime_bool](
      , loop_step_fn(loop_fuel, loop_state)
      , .(loop_done: Comptime_bool) -> Comptime_bool { loop_done }
      , .(loop_next: Spine_list & All_branch_state) -> Comptime_bool {
          loop_recur(
          , __fst__[Spine_list][All_branch_state](loop_next)
          , __snd__[Spine_list][All_branch_state](loop_next)
          )
        }
      )
    }
  )
}

type Route_result = Used_term | __Diagnostic_text__;

type Search_state = Route_result;

type Search_next = Dnf_branch_list & Search_state;

type Search_step = Route_result | Search_next;

pure fn choose_target_branch(
, ct: __Comptime__
, target: __Type__
, source_branch: __Type__
, source_value: __Checked_term__
, targets: Dnf_branch_list
, flags: Branch_build_flags
) -> Route_result {
  let source_factors = dnf_branch_spine(ct, source_branch);
  let source_slots = dnf_branch_slots(ct, source_branch, source_value);
  __structural_recur__(ct)[Dnf_branch_list][Search_state][Route_result](
  , targets
  , __right__[Used_term][__Diagnostic_text__](__"no target DNF branch matches source branch"__(ct))
  , .(
    , loop_recur: (Dnf_branch_list & Search_state) -> Route_result
    , loop_fuel: Dnf_branch_list
    , loop_state: Search_state
    ) -> Route_result {
      let loop_step_fn =
        .(fuel: Dnf_branch_list, state: Search_state) -> Search_step {
          __either__[.][Dnf_branch & Dnf_branch_list][Search_step](
          , Type_list.get(fuel)
          , .(_done: .) -> Search_step { __left__[Route_result][Search_next](state) }
          , .(cell: Dnf_branch & Dnf_branch_list) -> Search_step {
              let target_branch = __fst__[Dnf_branch][Dnf_branch_list](cell);
              let target_branch_type = dnf_branch_type(ct, target_branch);
              let target_factors = dnf_branch_spine(ct, target_branch_type);
              __comptime_if_then_else__(ct)(
              , branch_can_land_from_factors(ct, source_factors, target_factors, flags)
              , .() -> Search_step {
                  __either__[__Checked_term__][__Diagnostic_text__][Search_step](
                  , build_branch_value_from_parts(
                    , ct
                    , source_factors
                    , target_factors
                    , source_slots
                    , flags
                    )
                  , .(branch_value: __Checked_term__) -> Search_step {
                      __either__[__Checked_term__][__Diagnostic_text__][Search_step](
                      , materialize_dnf_branch_with_spine(
                        , ct
                        , target
                        , target_branch_type
                        , target_factors
                        , branch_value
                        )
                      , .(term: __Checked_term__) -> Search_step {
                          __left__[Route_result][Search_next](__left__[Used_term][__Diagnostic_text__]((
                          , __either__[.][__Type__ & Type_list][Comptime_bool](
                            , Type_list.get(target_factors)
                            , .(_empty: .) -> Comptime_bool { __.f__(ct) }
                            , .(_cell: __Type__ & Type_list) -> Comptime_bool { __.t__(ct) }
                            )
                          , term
                          )))
                        }
                      , .(message: __Diagnostic_text__) -> Search_step {
                          __right__[Route_result][Search_next]((
                          , __snd__[Dnf_branch][Dnf_branch_list](cell)
                          , __right__[Used_term][__Diagnostic_text__](message)
                          ))
                        }
                      )
                    }
                  , .(message: __Diagnostic_text__) -> Search_step {
                      __right__[Route_result][Search_next]((
                      , __snd__[Dnf_branch][Dnf_branch_list](cell)
                      , __right__[Used_term][__Diagnostic_text__](message)
                      ))
                    }
                  )
                }
              , .() -> Search_step {
                  __right__[Route_result][Search_next]((
                  , __snd__[Dnf_branch][Dnf_branch_list](cell)
                  , state
                  ))
                }
              )
            }
          )
        };
      __either__[Route_result][Dnf_branch_list & Search_state][Route_result](
      , loop_step_fn(loop_fuel, loop_state)
      , .(loop_done: Route_result) -> Route_result { loop_done }
      , .(loop_next: Dnf_branch_list & Search_state) -> Route_result {
          loop_recur(
          , __fst__[Dnf_branch_list][Search_state](loop_next)
          , __snd__[Dnf_branch_list][Search_state](loop_next)
          )
        }
      )
    }
  )
}

type Preflight_payload = Dnf_branch_list & Dnf_branch_list;

type Preflight_result = Preflight_payload | .;

pure fn preflight_sources(payload: Preflight_payload) -> Dnf_branch_list {
  __fst__[Dnf_branch_list][Dnf_branch_list](payload)
}

pure fn preflight_targets_payload(payload: Preflight_payload) -> Dnf_branch_list {
  __snd__[Dnf_branch_list][Dnf_branch_list](payload)
}

pure fn preflight_ok(sources: Dnf_branch_list, targets: Dnf_branch_list) -> Preflight_result {
  __left__[Preflight_payload][.]((sources, targets))
}

pure fn preflight_err() -> Preflight_result { __right__[Preflight_payload][.](()) }

pure fn preflight_dnf(
, ct: __Comptime__
, source: __Type__
, target: __Type__
, flags: Branch_build_flags
, require_all_targets: Comptime_bool
) -> Preflight_result {
  let sources = dnf_branches(ct, source);
  let targets = dnf_branches(ct, target);
  let source_spines = branch_spines(ct, sources);
  let target_spines = branch_spines(ct, targets);
  __comptime_if_then_else__(ct)(
  , all_sources_have_targets(ct, source_spines, target_spines, flags)
  , .() -> Preflight_result {
      __comptime_if_then_else__(ct)(
      , require_all_targets
      , .() -> Preflight_result {
          __comptime_if_then_else__(ct)(
          , all_targets_have_sources(ct, source_spines, target_spines, flags)
          , .() -> Preflight_result { preflight_ok(sources, targets) }
          , .() -> Preflight_result { preflight_err() }
          )
        }
      , .() -> Preflight_result { preflight_ok(sources, targets) }
      )
    }
  , .() -> Preflight_result { preflight_err() }
  )
}

pure fn preflight(
, ct: __Comptime__
, source: __Type__
, target: __Type__
, flags: Branch_build_flags
, require_all_targets: Comptime_bool
) -> Comptime_bool {
  __either__[Preflight_payload][.][Comptime_bool](
  , preflight_dnf(ct, source, target, flags, require_all_targets)
  , .(_payload: Preflight_payload) -> Comptime_bool { __.t__(ct) }
  , .() -> Comptime_bool { __.f__(ct) }
  )
}

pure fn algebraic_from_branch(
, ct: __Comptime__
, target: __Type__
, source_branch: __Type__
, source_value: __Checked_term__
, targets: Dnf_branch_list
, flags: Branch_build_flags
) -> Used_term {
  __either__[Used_term][__Diagnostic_text__][Used_term](
  , choose_target_branch(ct, target, source_branch, source_value, targets, flags)
  , .(result: Used_term) -> Used_term { result }
  , .(_message: __Diagnostic_text__) -> Used_term { (__.t__(ct), source_value) }
  )
}

pure fn algebraic_eliminate(
, ct: __Comptime__
, source: __Type__
, target: __Type__
, value: __Checked_term__
, targets: Dnf_branch_list
, flags: Branch_build_flags
) -> Used_term {
  dnf_eliminate_with_use(
  , ct
  , source
  , target
  , value
  , .(source_branch: __Type__, source_value: __Checked_term__) -> Comptime_bool & __Checked_term__ {
      algebraic_from_branch(ct, target, source_branch, source_value, targets, flags)
    }
  )
}

pure fn algebraic_from_dnf(
, ct: __Comptime__
, source: __Type__
, target: __Type__
, value: __Checked_term__
, payload: Preflight_payload
, flags: Branch_build_flags
) -> Used_term {
  let sources = preflight_sources(payload);
  let targets = preflight_targets_payload(payload);
  __either__[Dnf_branch][.][Used_term](
  , single_dnf_branch(ct, sources)
  , .(single_source: Dnf_branch) -> Used_term {
      __comptime_if_then_else__(ct)(
      , __type_equal__(ct, source, dnf_branch_type(ct, single_source))
      , .() -> Used_term { algebraic_from_branch(ct, target, single_source, value, targets, flags) }
      , .() -> Used_term { algebraic_eliminate(ct, source, target, value, targets, flags) }
      )
    }
  , .() -> Used_term { algebraic_eliminate(ct, source, target, value, targets, flags) }
  )
}

pure fn algebraic_impl(
, ct: __Comptime__
, source: __Type__
, target: __Type__
, value: __Checked_term__
, flags: Branch_build_flags
, require_all_targets: Comptime_bool
, failure: __Diagnostic_text__
) -> Route_result {
  __either__[Preflight_payload][.][Route_result](
  , preflight_dnf(ct, source, target, flags, require_all_targets)
  , .(payload: Preflight_payload) -> Route_result {
      __left__[Used_term][__Diagnostic_text__](algebraic_from_dnf(
      , ct
      , source
      , target
      , value
      , payload
      , flags
      ))
    }
  , .() -> Route_result { __right__[Used_term][__Diagnostic_text__](failure) }
  )
}

type Ease_recur = (__Type__ & Type_pair) -> Ease_adapter_result;

pure fn ease_leaf_mapper(
, ct: __Comptime__
, source: __Type__
, target: __Type__
, flags: Branch_build_flags
) -> Ease_adapter_result {
  __comptime_if_then_else__(ct)(
  , preflight(ct, source, target, flags, __.f__(ct))
  , .() -> Ease_adapter_result {
      ease_adapter_ok(
      , ct
      , .(value: __Checked_term__) -> Used_term {
          __either__[Used_term][__Diagnostic_text__][Used_term](
          , algebraic_impl(
            , ct
            , source
            , target
            , value
            , flags
            , __.f__(ct)
            , __"ease POC found no DNF easing"__(ct)
            )
          , .(result: Used_term) -> Used_term { result }
          , .(_message: __Diagnostic_text__) -> Used_term { (__.t__(ct), value) }
          )
        }
      )
    }
  , .() -> Ease_adapter_result { ease_adapter_err(ct, __"ease POC found no DNF easing"__(ct)) }
  )
}

pure fn ease_function_mapper(
, ct: __Comptime__
, recur: Ease_recur
, source: __Type__
, target: __Type__
, source_view: Function_view
, target_view: Function_view
) -> Ease_adapter_result {
  let source_param = function_param(ct, source_view);
  let source_ret = function_result(ct, source_view);
  let target_param = function_param(ct, target_view);
  let target_ret = function_result(ct, target_view);
  __either__[Ease_mapper][__Diagnostic_text__][Ease_adapter_result](
  , recur(__type_product__(ct, target_param, source_param), (target_param, source_param))
  , .(param_mapper: Ease_mapper) -> Ease_adapter_result {
      __either__[Ease_mapper][__Diagnostic_text__][Ease_adapter_result](
      , recur(__type_product__(ct, source_ret, target_ret), (source_ret, target_ret))
      , .(ret_mapper: Ease_mapper) -> Ease_adapter_result {
          ease_adapter_ok(
          , ct
          , .(value: __Checked_term__) -> Used_term {
              (
              , __.t__(ct)
              , __term_let__(
                , ct
                , source
                , value
                , .(fn_value: __Checked_term__) -> __Checked_term__ {
                    __term_fn__(
                    , ct
                    , target
                    , .(arg_packet: __Checked_term__) -> __Checked_term__ {
                        __snd__[Comptime_bool][__Checked_term__](ret_mapper(__term_call__(
                        , ct
                        , source
                        , fn_value
                        , __snd__[Comptime_bool][__Checked_term__](param_mapper(arg_packet))
                        )))
                      }
                    )
                  }
                )
              )
            }
          )
        }
      , .(message: __Diagnostic_text__) -> Ease_adapter_result { ease_adapter_err(ct, message) }
      )
    }
  , .(message: __Diagnostic_text__) -> Ease_adapter_result { ease_adapter_err(ct, message) }
  )
}

pure fn ease_recur_step(ct: __Comptime__, recur: Ease_recur, pair: Type_pair) -> Ease_adapter_result {
  let source = __fst__[__Type__][__Type__](pair);
  let target = __snd__[__Type__][__Type__](pair);
  __comptime_if_then_else__(ct)(
  , __type_equal__(ct, source, target)
  , .() -> Ease_adapter_result { ease_adapter_ok(ct, identity_mapper(ct, source)) }
  , .() -> Ease_adapter_result {
      __comptime_if_then_else__(ct)(
      , __type_equal__(ct, source, __type_bottom__(ct))
      , .() -> Ease_adapter_result {
          ease_adapter_ok(
          , ct
          , .(value: __Checked_term__) -> Used_term {
              (__.t__(ct), __intrinsic_absurd__(ct, value, target))
            }
          )
        }
      , .() -> Ease_adapter_result {
          __either__[Function_view][.][Ease_adapter_result](
          , function_view(ct, source)
          , .(source_view: Function_view) -> Ease_adapter_result {
              __either__[Function_view][.][Ease_adapter_result](
              , function_view(ct, target)
              , .(target_view: Function_view) -> Ease_adapter_result {
                  ease_function_mapper(ct, recur, source, target, source_view, target_view)
                }
              , .(_target_not_function: .) -> Ease_adapter_result {
                  ease_leaf_mapper(ct, source, target, (__.t__(ct), __.f__(ct)))
                }
              )
            }
          , .(_source_not_function: .) -> Ease_adapter_result {
              ease_leaf_mapper(ct, source, target, (__.t__(ct), __.f__(ct)))
            }
          )
        }
      )
    }
  )
}

pure fn ease_mapper_result(ct: __Comptime__, source: __Type__, target: __Type__) -> Ease_adapter_result {
  __structural_recur__(ct)[__Type__][Type_pair][Ease_adapter_result](
  , __type_product__(ct, source, target)
  , (source, target)
  , .(recur: Ease_recur, _fuel: __Type__, state: Type_pair) -> Ease_adapter_result {
      ease_recur_step(ct, recur, state)
    }
  )
}

pure fn finish_route(
, ct: __Comptime__
, source: __Type__
, value: __Checked_term__
, build: __Checked_term__ -> Route_result
) -> __Checked_term__ {
  __either__[Used_term][__Diagnostic_text__][__Checked_term__](
  , build(value)
  , .(result: Used_term) -> __Checked_term__ {
      __comptime_if_then_else__(ct)(
      , __fst__[Comptime_bool][__Checked_term__](result)
      , .() -> __Checked_term__ {
          __term_let__(
          , ct
          , source
          , value
          , .(saved: __Checked_term__) -> __Checked_term__ {
              __either__[Used_term][__Diagnostic_text__][__Checked_term__](
              , build(saved)
              , .(bound: Used_term) -> __Checked_term__ {
                  __snd__[Comptime_bool][__Checked_term__](bound)
                }
              , .(message: __Diagnostic_text__) -> __Checked_term__ {
                  finish_macro_result(ct, err(ct, message))
                }
              )
            }
          )
        }
      , .() -> __Checked_term__ { __snd__[Comptime_bool][__Checked_term__](result) }
      )
    }
  , .(message: __Diagnostic_text__) -> __Checked_term__ {
      finish_macro_result(ct, err(ct, message))
    }
  )
}

pure fn iso_impl(ct: __Comptime__, source: __Type__, value: __Checked_term__, target: __Type__) -> Route_result {
  __comptime_if_then_else__(ct)(
  , iso_branch_shape_ok(ct, source, target, (__.f__(ct), __.f__(ct)))
  , .() -> Route_result {
      algebraic_impl(
      , ct
      , source
      , target
      , value
      , (__.f__(ct), __.f__(ct))
      , __.t__(ct)
      , __"iso POC found no DNF bijection"__(ct)
      )
    }
  , .() -> Route_result {
      __right__[Used_term][__Diagnostic_text__](__"iso POC found no DNF bijection"__(ct))
    }
  )
}

/// Evaluates the corresponding macro and returns its checked core result.
pure fn iso_checked(ct: __Comptime__, source: __Type__, value: __Checked_term__, target: __Type__) -> __Checked_term__ {
  finish_route(
  , ct
  , source
  , value
  , .(saved: __Checked_term__) -> Route_result { iso_impl(ct, source, saved, target) }
  )
}

