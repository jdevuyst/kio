mod testapi/main;

import macros/match { macro match }
import testapi { type I32; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

// Each nominal type fixes its payload. The two constructed values
// compose as a `Celsius & Label` product.
type { Celsius: I32 { mk; get }; Label: String { mk; get } }

fn make_celsius(temp: I32) -> Celsius { Celsius.mk(temp) }

// Construct each nominal value in the declared product order.
fn make_record(temp: I32, name: String) -> Celsius & Label { (Celsius.mk(temp), Label.mk(name)) }

// Project the `Label` half out of the product. `r` is
// `Celsius & Label`; `match` destructures the product into
// the two conjuncts and we return the `Label` arm.
fn project_label(r: Celsius & Label) -> Label {
  match(r) {
    .(_c: Celsius, l: Label) { l }
  }
}

pub fn main() {
  let a = make_celsius(25);
  let r = make_record(20, "outside");
  print(int_to_string(Celsius.get(a)));
  print("\n");
  print(Label.get(project_label(r)));
  print("\n")
}
