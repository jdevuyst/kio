module macros;

import __comptime__;

pub type { Box[A]: . { mk; get } }

pub pure fn boxed[A]() -> Box[A] { Box.mk[A](()) }

pure fn fill_impl(ct: __Comptime__, fills: __Fill_ctx__, target: __Type__, _value: __Checked_term__) ->
  __Checked_term__ & __Fill_ctx__
   { (__term_unit__(ct), __fill__(ct, fills, target, __type_unit__(ct))) }

pub macro fill : [A] Box[A] -> A { impl(fills) fill_impl }

pure fn inspect_impl(
, ct: __Comptime__
, fills: __Fill_ctx__
, _type: __Type__
, _value: __Checked_term__
) -> __Checked_term__ & __Fill_ctx__ { (__term_unit__(ct), fills) }

pub macro inspect : [T] T -> . { impl(fills) inspect_impl }

pure fn with_sibling_impl(
, ct: __Comptime__
, fills: __Fill_ctx__
, _target: __Type__
, _value: __Checked_term__
, _sibling: __Checked_term__
) -> __Checked_term__ & __Fill_ctx__ { (__term_unit__(ct), fills) }

pub macro with_sibling : [A] Box[A] -> A -> A { impl(fills) with_sibling_impl }
