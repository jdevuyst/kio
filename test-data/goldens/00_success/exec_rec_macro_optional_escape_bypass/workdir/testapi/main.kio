mod testapi/main;

import elaborators { macro run_callbacks }
import macros/control { macro if }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn leq_i32; fn sub_i32 }
import testapi/io { fn print }
import testapi/iter { fn loop }

rec(loop) fn repeat(remaining: I32) -> String {
  run_callbacks((
  , .(_unit: .) -> String {
      if(leq_i32(remaining, 0)) {
        "optional callback bypass\n"
      } else {
        recur repeat(sub_i32(remaining, 1))
      }
    }
  , .(_unit: .) { () }
  ))
}

pub fn main() { print(repeat(2)) }
