module testapi/main;

import alib/util(keep);
import blib/greet(first);
import testapi(String);
import testapi/io(print);

// Both dependency exports survive every commit in this case (`keep` from
// the compatible `alib`, `first` from `blib` whose breaking change only
// drops the unused `second`), so the consumer stays valid through the
// re-pin. The subject under test is `kio dep update`'s *atomicity* when
// one of several dependencies' gate blocks; this build+run only confirms
// the healed (re-pinned) state still materializes and links.
pub fn greeting() -> String {
  keep(first("git dependencies work\n"(String), "x"(String)), "y"(String))
}

pub fn main() -> . { print(greeting()) }
