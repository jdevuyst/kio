/// Exercises direct arrow-result chains at the loader's public-type boundary.
mod testapi/main;

import loader as l;
import loader/scan as scan;
import macros/match { macro match }
import testapi as t;
import testapi/io as io;
import testapi/text as text;

fn show(label: t.String, source: t.String) {
  let result =
    match(l.un_load_outcome(scan.load_package(source))) {
      (
      , .(_image: l.Lr_image) { "loaded"[t.String] }
      , .(diag: l.Lr_diag) { l.diag_message(l.Lr_diag.get(diag)) }
      )
    };
  io.print(text.string_concat(label, text.string_concat(result, "\n"[t.String])))
}

pub fn main() {
  show("grouped product: "[t.String], "mod a; host fn f(cb: . -> (. & .)) -> .;"[t.String]);
  show("grouped sum: "[t.String], "mod a; host fn f(cb: . -> (. | .)) -> .;"[t.String]);
  show("bare product: "[t.String], "mod a; host fn f(cb: . -> . & .) -> .;"[t.String]);
  show("bare sum: "[t.String], "mod a; host fn f(cb: . -> . | .) -> .;"[t.String]);
  show("leading product: "[t.String], "mod a; host fn f(cb: . -> & .) -> .;"[t.String]);
  show("empty sum: "[t.String], "mod a; host fn f(cb: . -> |) -> .;"[t.String]);
  show("trailing product: "[t.String], "mod a; host fn f(cb: . -> . &) -> .;"[t.String]);
  show("nested result: "[t.String], "mod a; host fn f() -> . -> . & .;"[t.String]);
  show("grouped nested result: "[t.String], "mod a; host fn f() -> . -> (. & .);"[t.String]);
  show("own product return: "[t.String], "mod a; host fn f() -> . & .;"[t.String]);
  show("own sum return: "[t.String], "mod a; host fn f() -> . | .;"[t.String]);
  show("arrows only: "[t.String], "mod a; host fn f(cb: . -> . -> .) -> .;"[t.String]);
  show("forall result scope: "[t.String], "mod a; host fn f(cb: . -> [A] A & A) -> .;"[t.String]);
  show(
  , "export grouped result: "[t.String]
  , "mod a; pub fn f(cb: . -> (. & .)) { () } pkg p; bridge { a; }"[t.String]
  );
  show(
  , "export bare result: "[t.String]
  , "mod a; pub fn f(cb: . -> . & .) { () } pkg p; bridge { a; }"[t.String]
  )
}
