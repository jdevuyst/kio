mod testapi/main;

import testapi { type String }
import testapi/io { fn print }

type { N: . { mk; get } }

fn delayed[A]() -> N { print("invoked\n"[String]); N.mk(()) }

pub fn main() {
  let pending = delayed[N];
  print("created\n"[String]);
  let result = pending(());
  N.get(result);
  print("done\n"[String])
}
