module testapi/main;

import testapi(Int);
import testapi/fmt(int_to_string);
import testapi/io(print);

fn choose(a: Int, b: Int, c: Int) -> Int { b }

// The recursive middle slot groups as choose(1, choose(2, 3, 4), 5).
op _ ? __ : _ { impl choose }

pub fn main() { print(int_to_string(1 ? 2 ? 3 : 4 : 5)); print("\n") }
