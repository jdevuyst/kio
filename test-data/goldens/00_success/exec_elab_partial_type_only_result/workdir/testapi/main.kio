module testapi/main;

import elaborators(phantom);
import testapi/io as io;

fn residual() -> [B] . { phantom!((), .) }

fn explicit_unit() -> [B] . -> . { phantom!(.(_unit: .) { () }, . -> .) }

pub fn main() {
  let saved = residual();
  saved(.);
  io.print("type-only\n");
  let saved_unit = explicit_unit();
  saved_unit(.)(());
  io.print("explicit-unit\n")
}
