mod testapi/main;

import macros/control { macro if }
import macros/row_macros { macro select }
import testapi { type Bool; type String }
import testapi/io { fn print }

type { Flag: Bool { mk; get } }

type Condition_record = Flag;

fn make_flag(value: Bool) -> Condition_record { Flag.mk(value) }

fn make_pair(value: Bool) -> Condition_record & . { (make_flag(value), ()) }

fn produced[A](make: . -> A) -> A { make(()) }

fn identity[A](value: A) -> A { value }

fn select_direct(value: Bool) -> String {
  if(make_flag(value).>Flag.get) { "direct-true\n" } else { "direct-false\n" }
}

fn select_product(value: Bool) -> String {
  if(make_pair(value).>select { Flag.get }) { "product-true\n" } else { "product-false\n" }
}

fn select_callback(value: Bool) -> String {
  if(produced(.() -> Condition_record { make_flag(value) }).>Flag.get) {
    "callback-true\n"
  } else {
    "callback-false\n"
  }
}

fn select_nested(value: Bool) -> String {
  if(identity(produced(.() -> Condition_record { make_flag(value) }).>Flag.get)) {
    "nested-true\n"
  } else {
    "nested-false\n"
  }
}

pub fn main() {
  print(select_direct(.t));
  print(select_direct(.f));
  print(select_product(.t));
  print(select_product(.f));
  print(select_callback(.t));
  print(select_callback(.f));
  print(select_nested(.t));
  print(select_nested(.f))
}
