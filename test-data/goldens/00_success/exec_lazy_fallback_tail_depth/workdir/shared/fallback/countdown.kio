mod shared/fallback/countdown;

import shared/option/core as o;
import shared/option/core { macro unwrap_or_lazy }
import shared/option/macros/control { macro if }
import shared/testapi { type I32 }
import shared/testapi/arith { fn leq_i32; fn sub_i32 }
import shared/testapi/iter { fn loop }

fn stop_at_zero(n: I32) -> o.Option[I32] {
  if(leq_i32(n, 0)) { o.some(42[I32]) } else { o.none[I32] }
}

pub rec(loop) fn countdown(n: I32) -> I32 {
  unwrap_or_lazy(stop_at_zero(n)) { recur countdown(sub_i32(n, 1)) }
}
