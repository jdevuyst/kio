mod testapi/main;

import macros/algebraic_macros { macro ease }
import macros/match { macro match }
import testapi { type String }
import testapi/io { fn print }

type { A: String { pub mk; pub get } }

type { B: String { pub mk; pub get } }

fn provider(x: A | B) {
  print(match(x) {
    (.(a: A) { A.get(a) }, .(b: B) { B.get(b) })
  })
}

// Surrounding type pins the target; `f.>ease` elides the target
// slot just like other UFCS macro calls.
fn use_narrow(f: A -> .) { f(A.mk("elided target ok\n")) }

pub fn main() {
  // Explicit-target UFCS: brackets carry the target type, parallel
  // to `(r.>into)[T]`.
  (provider.>ease)[A -> .](A.mk("explicit target ok\n"));
  // Elided-target UFCS: omit the target stage when the surrounding
  // context pins the target.
  use_narrow(provider.>ease)
}
