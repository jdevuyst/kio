module testapi/main;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(Array, Bool, I32, String);
import testapi/arith(add_i32, leq_i32, sub_i32);
import testapi/array(array_clone, array_get, array_make_filled, array_set);
import testapi/io(print);
import testapi/iter(loop);
import testapi/text(string_concat);

// Cell-row width and number of generations printed.
fn n() -> I32 { 31 }

fn gens() -> I32 { 16 }

// Boolean ops over the `0`/`1` cell encoding. `leq_i32(x, 0)` is
// true iff `x <= 0`, which (for `0`/`1` cells) means `x == 0`.
fn not(x: I32) -> I32 {
  if! leq_i32(x, 0) {
    1
  } else {
    0
  }
}

fn or(a: I32, b: I32) -> I32 {
  if! leq_i32(a, 0) {
    b
  } else {
    1
  }
}

fn xor(a: I32, b: I32) -> I32 {
  if! leq_i32(a, 0) {
    b
  } else {
    not(b)
  }
}

// Read cell `i` from `cells`, treating off-grid indices as `0`
// (the dead boundary condition).
fn read_cell(cells: Array(I32), i: I32) -> I32 {
  if! leq_i32(0, i) {
    if! leq_i32(i, sub_i32(n(), 1)) {
      array_get(cells, i)
    } else {
      0
    }
  } else {
    0
  }
}

// Wolfram rule 30: `new[i] = left XOR (center OR right)`. The
// rule's truth table makes the row chaotic in shape — see
// Wolfram, _A New Kind of Science_ ch. 2.
fn rule30(prev: Array(I32), i: I32) -> I32 {
  let l = read_cell(prev, sub_i32(i, 1));
  let c = read_cell(prev, i);
  let r = read_cell(prev, add_i32(i, 1));
  xor(l, or(c, r))
}

// Inner update-loop step: walks `i` from `0` to `n - 1`, writing
// `rule30(prev, i)` into `cells[i]`. State is `i`; `cells` and
// `prev` are captured from the outer closure.
fn update_step(cells: Array(I32), prev: Array(I32), i: I32) -> I32 | . {
  if! leq_i32(i, sub_i32(n(), 1)) {
    array_set(cells, i, rule30(prev, i));
    widen_sum!(add_i32(i, 1))
  } else {
    widen_sum!(())
  }
}

// Render-loop step: walks `i` from `0` to `n - 1`, appending one
// character to `acc` per cell — `#` for `1`, `.` for `0`. State
// is `(acc, i)`.
fn render_step(cells: Array(I32), acc: String, i: I32) -> (String & I32) | String {
  if! leq_i32(i, sub_i32(n(), 1)) {
    let ch = if! leq_i32(array_get(cells, i), 0) {
      "."
    } else {
      "#"
    };
    widen_sum!((string_concat(acc, ch), add_i32(i, 1)))
  } else {
    widen_sum!(acc)
  }
}

// Render `cells` as a string of `#` and `.` characters.
fn render_row(cells: Array(I32)) -> String {
  loop(
    , String & I32
    , String
    , .(state: String & I32) -> (String & I32) | String {
        match! state {
          .(acc: String, i: I32) { render_step(cells, acc, i) }
        }
      }
    , ("", 0)
    )
}

// Outer generation-step: at each generation prints the current
// row, snapshots it via `array_clone`, then walks the cells
// rewriting `cells[i]` from the snapshot. State is `gen`; `cells`
// is captured.
fn gen_step(cells: Array(I32), gen: I32) -> I32 | . {
  if! leq_i32(gen, sub_i32(gens(), 1)) {
    print(string_concat(render_row(cells), "\n"));
    let prev = array_clone(cells);
    loop(.(i: I32) { update_step(cells, prev, i) }, 0);
    widen_sum!(add_i32(gen, 1))
  } else {
    widen_sum!(())
  }
}

pub fn main() -> . {
  // Seed: single `1` cell at the center, all others `0`.
  let cells = array_make_filled(n(), 0);
  array_set(cells, 15, 1);
  loop(.(gen: I32) { gen_step(cells, gen) }, 0)
}
