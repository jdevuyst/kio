module main;

import elab/spine_elaborators(reorder_sum);

newtype A : . { pub constructor mk_a; pub projector un_a }

newtype B : . { pub constructor mk_b; pub projector un_b }

newtype C : . { pub constructor mk_c; pub projector un_c }

// Cross-type swap. Source spine `[A, B]`, target spine `[B, A]` —
// identical multisets, pure permutation. R-Comm fires with the
// unique permutation σ(0) = 1, σ(1) = 0 (each slot's type is
// distinct, so source-order pinning is trivial).
fn swap_two(x: A | B) -> B | A { reorder_sum!(x) }

// Three-way rotation. Source `[A, B, C]`, target `[C, A, B]` —
// permutation that rotates the spine by one slot. Same multiset,
// no `!` insertion.
fn rotate(x: A | B | C) -> C | A | B { reorder_sum!(x) }

// Source-order pinning for like-typed groups. Source `[A, B, A]`
// has two `A` arms; target `[A, A, B]` also has two. Pinning sends
// source `A` slot 0 to target `A` slot 0 and source `A` slot 2 to
// target `A` slot 1 (the kth source slot of type `A` lands at the
// kth target slot of type `A`); `B` moves from slot 1 to slot 2.
fn pin_like_typed(x: A | B | A) -> A | A | B { reorder_sum!(x) }

// UFCS spelling — same rule, postfix form.
fn ufcs(x: A | B) -> B | A { x.>reorder_sum! }
