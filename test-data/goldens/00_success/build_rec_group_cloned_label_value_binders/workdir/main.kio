module main;

import build_rec_group_cloned_label_value_binders(Bool, I32, String, done, empty, loop);
import elab/control(if);

labels { text: String };

rec(loop) {
  pub fn spaces(n: I32) -> String { rec pad(n, empty()) };
  fn pad(n: I32, acc: String) -> String {
    if! done(n) {
      let wrapped = {text = acc};
      wrapped.?{text}
    } else {
      rec pad(n, acc)
    }
  }
}
