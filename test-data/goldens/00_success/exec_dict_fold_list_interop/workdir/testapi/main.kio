module testapi/main;

import dict/dict as d;
import dict/elab/match(match);
import elab/control(if);
import list/core as lc;
import list/list as ls;
import list/list(varop [* *]);
import testapi(Bool, I32, String);
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/text as text;

fn compare(a: I32, b: I32) -> d.Ordering {
  if! arith.lt_i32(a, b) {
    d.lt()
  } else if! arith.eq_i32(a, b) {
    d.eq()
  } else {
    d.gt()
  }
}

fn append_entry(carry: String, key: I32, value: I32) -> String {
  text.string_concat(
    , carry
    , text.string_concat(
        , fmt.int_to_string(key)
        , text.string_concat("=", text.string_concat(fmt.int_to_string(value), ";"))
        )
    )
}

fn show(label: String, value: String) -> . {
  io.print(text.string_concat(label, text.string_concat(value, "\n")))
}

fn to_entries(dictionary: d.Dict(I32, I32)) -> lc.List(I32 & I32) {
  let reversed =
    d.fold_asc(
      , dictionary
      , lc.nil()
      , .(carry: lc.List(I32 & I32), key: I32, value: I32) -> lc.List(I32 & I32) {
          lc.cons((key, value), carry)
        }
      );
  ls.reverse(reversed)
}

fn render_entries(entries: lc.List(I32 & I32)) -> String {
  ls.foldl(
    , .(carry: String, entry: I32 & I32) -> String {
        match! entry {
          .(key: I32, value: I32) { append_entry(carry, key, value) }
        }
      }
    , ""
    , entries
    )
}

pub fn main() -> . {
  let entries = [* (3, 30), (1, 10), (2, 20) *];
  let dictionary =
    ls.foldl(
      , .(carry: d.Dict(I32, I32), entry: I32 & I32) -> d.Dict(I32, I32) {
          match! entry {
            .(key: I32, value: I32) { d.insert(compare, carry, key, value) }
          }
        }
      , d.empty()
      , entries
      );
  let ordered = to_entries(dictionary);
  show("list:", render_entries(ordered));
  show("list-size:", fmt.int_to_string(ls.length(ordered)));
  show("fold:", d.fold_asc(dictionary, "seed:", append_entry));
  show("dict-size:", fmt.int_to_string(d.size(dictionary)))
}
