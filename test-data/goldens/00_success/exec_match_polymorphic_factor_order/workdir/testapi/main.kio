module testapi/main;

import macros/match(macro match);
import macros/spine_macros(macro widen_sum);
import testapi(String);
import testapi/io as io;

type { Box[A]: A { pub mk; pub get } }

type { Other: String; Tag: . }

fn choose(input: (Box[String] & Tag) | (Other & Tag)) -> String {
  match(input) {
    .[A](_box: Box[A]) -> String { "polymorphic-first\n" };
    .(_whole: (Box[String] | Other) & Tag) -> String { "whole-second\n" }
  }
}

pub fn main() {
  io.print(choose(widen_sum((Box.mk("box"[String]), Tag.mk(())))[(Box[String] & Tag) | (Other & Tag)]));
  io.print(choose(widen_sum((Other.mk("other"), Tag.mk(())))[(Box[String] & Tag) | (Other & Tag)]))
}
