module testapi/main;

import macros/row_macros(macro select);
import testapi(String);
import testapi/io(print);
import testapi/labs1 as l1;
import testapi/two as t2;

// The two modules each declare a distinct nominal `A`. A product holds
// both values, and `l1.A.get` selects the `testapi/labs1.A` field even
// though the other field has the same leaf name.
pub fn main() {
  print((t2.A.mk("from two\n"), l1.A.mk("from labs1\n")).>select { l1.A.get })
}
