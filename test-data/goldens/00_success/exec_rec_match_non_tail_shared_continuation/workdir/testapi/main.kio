mod testapi/main;

import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type I32; type String }
import testapi/arith { fn add_i32 }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }
import testapi/iter { fn loop }

type Found = { Value: I32 } | { Absent: . };

fn not_found() -> Found { (Absent.mk(()).>widen_sum)[Found] }

fn found_value(value: I32) -> Found { (Value.mk(value).>widen_sum)[Found] }

type Many =
  { Zero: . } | { First: . } | { Second: . } | { Third: . } | { Fourth: . } | { Fifth: . }
  ;

fn zero_many() -> Many { (Zero.mk(()).>widen_sum)[Many] }

rec(loop) fn score_many(outer: I32, step: Many) -> I32 {
  let selected =
    match(step) {
      (
      , .(outer: Zero) { not_found() }
      , .(_first: First) { found_value(add_i32(recur(cont) score_many(10, zero_many()), 1)) }
      , .(_second: Second) { found_value(add_i32(recur(cont) score_many(10, zero_many()), 2)) }
      , .(_third: Third) { found_value(add_i32(recur(cont) score_many(10, zero_many()), 3)) }
      , .(_fourth: Fourth) { found_value(add_i32(recur(cont) score_many(10, zero_many()), 4)) }
      , .(_fifth: Fifth) { found_value(add_i32(recur(cont) score_many(10, zero_many()), 5)) }
      )
    };
  add_i32(
  , outer
  , match(selected) {
      (.(value: Value) { add_i32(Value.get(value), 6) }, .(_absent: Absent) { 6 })
    }
  )
}

pub fn main() {
  print(int_to_string(score_many(10, zero_many())));
  print("\n");
  print(int_to_string(score_many(10, (Fifth.mk(()).>widen_sum)[Many])));
  print("\n")
}
