module testapi/lists;

import testapi(String);

pub fn nil_str() -> String { "[]" }

pub fn cons_str(head: String, tail: String) -> String { head }

// The comma-separated right-fold `[* a, b, c *]` desugars to
// `cons_str(a, cons_str(b, cons_str(c, nil_str())))`.
pub varop [* *] { foldr cons_str nil_str }
