mod testapi/main;

import macros/control { macro if }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn leq_i32 }
import testapi/fmt { fn i32_to_string }
import testapi/io { fn print }
import testapi/iter { fn loop }

type { Value: I32 { mk; get } }

rec(loop) fn row_tail_no_cont(n: I32) -> I32 {
  if(leq_i32(n, 0)) { n } else { let next = Value.get(Value.mk(0)); recur row_tail_no_cont(next) }
}

rec(loop) {
  fn row_tail_cont(n: I32) -> I32 {
    if(leq_i32(n, 0)) {
      n
    } else {
      let next = Value.get(Value.mk(recur(cont) row_seed(0)));
      recur row_tail_cont(next)
    }
  };
  fn row_seed(value: I32) -> I32 { value }
}

pub fn main() {
  print(i32_to_string(row_tail_no_cont(1)));
  print(",");
  print(i32_to_string(row_tail_cont(1)));
  print("\n")
}
