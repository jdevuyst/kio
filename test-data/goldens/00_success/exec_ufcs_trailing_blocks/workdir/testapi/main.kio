mod testapi/main;

import forms {macro arrange; macro block_pair; macro discard; macro discard_whole; macro last_blocks; macro outer; macro packet; macro pair_prefix; macro run_sequence}
import testapi {type String}
import testapi/io {fn print}
import testapi/text {fn string_concat}

fn line(value: String) { print(string_concat(value, "\n")) }

fn mark(value: String) -> String { line(value); value }

fn suffix(value: String) -> String { string_concat(value, "!") }

pure fn identity[A](value: A) -> A { value }

type { Box[A] : A { mk; get }; }

pure fn bind[A][B](value: Box[A], next: A -> Box[B]) -> Box[B] { next(Box.get(value)) }

fn make_bind() -> [A][B] (Box[A] & (A -> Box[B])) -> Box[B] { line("sequence receiver"); bind }

fn render(values: String & (String & String)) -> String {
  let .(left, rest) = values;
  let .(right, body) = rest;
  string_concat(left, string_concat("/", string_concat(right, string_concat("/", body))))
}

fn show_outer(values: String & (String & (String & (String & String)))) {
  let .(left, rest) = values;
  let .(right, blocks) = rest;
  let .(body, tail) = blocks;
  let .(inner_prefix, inner_body) = tail;
  line(string_concat(render((left, (right, body))), string_concat("/", string_concat(inner_prefix, string_concat("/", inner_body)))))
}

equiv receiver_first[A][B][C](a: A, b: B, c: C) {
  a.>arrange(b) { c };
  arrange(a, b) { c };
  (a, (b, c))
}

equiv receiver_last[A][B][C](a: A, b: B, c: C) {
  a.>>arrange(b) { c };
  arrange(b, a) { c };
  (b, (a, c))
}

equiv argument_first[A][B][C](a: A, b: B, c: C) {
  arrange(b) { c }.<<a;
  arrange(a, b) { c };
  (a, (b, c))
}

equiv argument_last[A][B][C](a: A, b: B, c: C) {
  arrange(b) { c }.<a;
  arrange(b, a) { c };
  (b, (a, c))
}

equiv product_packet[A][B][C](a: A, b: B, c: C) {
  a.>packet(b) { c };
  packet(b) { c }.<<a;
  packet(a, b) { c };
  ((a, b), c)
}

equiv direct_empty_prefix[A](a: A) {
  block_pair() { a };
  block_pair(()) { a };
  ().>block_pair { a };
  block_pair { a }.<();
  ((), a)
}

equiv explicit_extra_unit[A](a: A) {
  a.>arrange(()) {};
  arrange(()) {}.<<a;
  (a, ((), ()))
}

equiv prefix_block_ownership[A][B][C](a: A, b: B, c: C) {
  block_pair (a.>pair_prefix(b)) { c };
  block_pair (a.>block_pair { b }) { c };
  ((a, b), c)
}

equiv reverse_inside_prefix[A][B](a: A, b: B) {
  block_pair (identity.<a) { b };
  (a, b)
}

equiv sequence_projection[A](a: A) {
  bind.>run_sequence { let value <- Box.mk(a); Box.mk(value) };
  run_sequence { let value <- Box.mk(a); Box.mk(value) }.<bind;
  Box.mk(a)
}

pub fn main() {
  line(render("receiver".>arrange("argument") { "block" }));
  line(render("receiver".>>arrange("argument") { "block" }));
  line(render(arrange("argument") { "block" }.<<"receiver"));
  line(render(arrange("argument") { "block" }.<"receiver"));
  line(render("bare".>arrange ("argument") { "body" }));
  line(render(((arrange ("argument") { "body" })).<"grouped"));
  line(arrange("left") { "body" }.<suffix("right").>render);
  line(arrange("left") { "body" }.<("right".>suffix).>render);
  line(arrange("left") { "body" }.<"right".>render.>suffix);
  show_outer(outer ("left") { "body" } after { block_pair ("inner") { "tail" } }.<"outer");
  show_outer(outer("left", "outer") { "body" } after { block_pair { "tail" }.<"inner" });
  show_outer(outer ("left") { "body" } after {
    last_blocks { mark("ignored-block") } after block_pair ("inner") { "tail" }
  }.<"outer");
  line(discard(mark("discarded-staged-forward"))(mark("kept-forward")));
  line(discard(mark("discarded-staged-reverse"))(mark("kept-reverse")));
  mark("discarded-ufcs-forward").>discard_whole { mark("discarded-block-forward") };
  line("whole forward ok");
  discard_whole { mark("discarded-block-reverse") }.<mark("discarded-ufcs-reverse");
  line("whole reverse ok");
  discard_whole(mark("discarded-direct"), mark("discarded-block-direct"));
  line("whole direct ok");
  line(Box.get(make_bind().>run_sequence {
    let first <- Box.mk(mark("sequence first"));
    let second <- Box.mk(mark(string_concat(first, " second")));
    Box.mk(second)
  }));
  line(Box.get(run_sequence {
    let value <- Box.mk(mark("reverse sequence body"));
    Box.mk(value)
  }.<make_bind()))
}
