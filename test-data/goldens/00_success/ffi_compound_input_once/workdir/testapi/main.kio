module testapi/main;

import macros/spine_macros(macro widen_sum);
import testapi(I32, String, produce);

pub type { Inner: I32 & I32 { pub mk; pub get } }

pub type { Outer: String & Inner { pub mk; pub get } }

pub type { Choice: I32 | Inner | Outer { pub mk; pub get } }

pub fn direct() -> I32 & String { produce() }

pub fn callback(f: . -> (I32 & String)) -> I32 & String { f() }

pub fn echo_outer(value: Outer) -> Outer { value }

pub fn echo_choice(value: Choice) -> Choice { value }

pub fn echo_text(value: String) -> String { value }

pub fn make_outer(text: String, left: I32, right: I32) -> Outer {
  Outer.mk((text, Inner.mk((left, right))))
}

pub fn first(value: I32) -> Choice { Choice.mk(widen_sum(value)[I32 | Inner | Outer]) }

pub fn middle(left: I32, right: I32) -> Choice {
  Choice.mk(widen_sum(Inner.mk((left, right)))[I32 | Inner | Outer])
}

pub fn last(text: String, left: I32, right: I32) -> Choice {
  Choice.mk(widen_sum(make_outer(text, left, right))[I32 | Inner | Outer])
}
