mod testapi/main;

import testapi { type String }
import testapi/io { fn print }

fn nil() -> String { "[]" }

fn cat(head: String, tail: String) -> String { head }

op_var [! !] { foldr cat nil }

op_var [%? ?%] { foldr cat nil }

pub fn main() {
  print([! "a", "b", "c" !]);
  print("\n");
  print([%? "x", "y" ?%]);
  print("\n");
  print([! !])
}
