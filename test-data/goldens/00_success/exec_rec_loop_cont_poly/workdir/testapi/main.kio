mod testapi/main;

import macros/control { macro if }
import macros/spine_macros { macro one_prod }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn add_i32; fn leq_i32; fn mul_i32; fn sub_i32 }
import testapi/fmt { fn i32_to_string }
import testapi/io { fn print }
import testapi/iter { fn loop }

pub rec(loop) fn fact(n: I32) -> I32 {
  if(leq_i32(n, 1)) { 1 } else { mul_i32(n, recur(cont) fact(sub_i32(n, 1))) }
}

rec(loop) {
  pub fn even_steps(n: I32) -> I32 {
    if(leq_i32(n, 0)) { 0 } else { add_i32(1, recur(cont) odd_steps(sub_i32(n, 1))) }
  };
  fn odd_steps(n: I32) -> I32 {
    if(leq_i32(n, 0)) { 0 } else { add_i32(1, recur(cont) even_steps(sub_i32(n, 1))) }
  }
}

pub rec(loop) fn poly_steps[A](n: I32) -> I32 {
  if(leq_i32(n, 0)) { 0 } else { add_i32(1, recur(poly, cont) poly_steps[String](sub_i32(n, 1))) }
}

pub rec(loop) fn elaborator_steps(n: I32) -> I32 {
  if(leq_i32(n, 0)) {
    0
  } else {
    add_i32(1, one_prod((recur(cont) elaborator_steps(sub_i32(n, 1)), 0[I32]))[I32])
  }
}

pub rec(loop) fn elaborator_ufcs_steps(n: I32) -> I32 {
  if(leq_i32(n, 0)) {
    0
  } else {
    add_i32(1, ((recur(cont) elaborator_ufcs_steps(sub_i32(n, 1)), 0[I32]).>one_prod)[I32])
  }
}

pub fn main() {
  print(i32_to_string(fact(5)));
  print(",");
  print(i32_to_string(even_steps(3)));
  print(",");
  print(i32_to_string(poly_steps[I32](4)));
  print(",");
  print(i32_to_string(elaborator_steps(2)));
  print(",");
  print(i32_to_string(elaborator_ufcs_steps(2)));
  print("\n")
}
