module testapi/main;

import macros/sequence(macro do);
import testapi(String);
import testapi/io as io;
import testapi/text as text;

newtype Box[A] : A { constructor box; projector unbox }

fn pure[A](value: A) -> Box(A) { Box.box(value) }

fn bind[A][B](value: Box(A), next: A -> Box(B)) -> Box(B) { next(Box.unbox(value)) }

fn combine() -> String {
  let result =
    do(bind) {
      let first <- pure("left"(String));
      let append <- pure(.(prefix: String) { text.string_concat(prefix, "right!") });
      pure(append(first))
    };
  Box.unbox(result)
}

pub fn main() { io.print(combine()); io.print("\n") }
