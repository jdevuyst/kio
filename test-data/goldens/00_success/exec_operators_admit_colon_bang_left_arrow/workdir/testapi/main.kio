module testapi/main;

import testapi(I32, String);
import testapi/arith(add_i32);
import testapi/fmt(i32_to_string);
import testapi/io(print);

fn add(a: I32, b: I32) -> I32 { add_i32(a, b) }

// Context-sensitive standalone tokens admitted as op pattern op-tokens.
// Their structural roles in other contexts (`:` as type annotation in fn
// params; `!` as bottom type in type position and as bang-call suffix) are
// unaffected: op binding lives in expression position only.
op _ : _ { impl add }

op _ ! _ { impl add }

op _ <- _ { impl add }

pub fn main() -> . {
  let a = 1 : 2;
  let b = 3 ! 4;
  let c = 5 <- 6;
  print(i32_to_string(a));
  print("\n");
  print(i32_to_string(b));
  print("\n");
  print(i32_to_string(c))
}
