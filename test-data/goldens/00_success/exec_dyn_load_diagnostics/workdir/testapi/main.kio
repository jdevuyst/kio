/// This case's loading host: feed each class of malformed image to the loader and print its diagnostic.
mod testapi/main;

import host_descriptor {
  type Host_type;
  type Role;
  fn i32_role;
  fn mk_host_id;
  fn mk_role_host_type
}
import lex { type Lex_err; fn lex }
import loader { fn diag_message; fn un_load_outcome }
import loader { type Load_outcome; type Lr_diag; type Lr_image }
import loader/scan { fn load_package }
import macros/control { macro if }
import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import parse { fn parse_toks_scope_fuel; fn perr_message; fn scope_nil; fn scope_push }
import parse { type P_err; type P_ok; type Type_scope }
import testapi { type Bool; type I32; type String }
import testapi/io { fn print }
import testapi/text { fn string_concat; fn string_eq }
import token {
  type Tk_num;
  type Tk_punct;
  type Tk_str;
  type Tk_word;
  type Token;
  type Toks;
  fn un_token;
  fn un_toks
}

// Render a load outcome's diagnostic under the case's label; a load that
// unexpectedly succeeds renders as `(loaded)` so a silently-accepted
// malformed image fails the case visibly.
fn diag_of(label: String, out: Load_outcome) -> String {
  match(un_load_outcome(out)) {
    (
    , .(_im: Lr_image) { string_concat(label, "(loaded)\n"[String]) }
    , .(d: Lr_diag) {
        string_concat(label, string_concat(diag_message(Lr_diag.get(d)), "\n"[String]))
      }
    )
  }
}

fn parser_host_type(local_name: String, role: Role) -> Host_type {
  mk_role_host_type(mk_host_id("hostapi"[String], local_name), role)
}

fn resolve_parser_host_type(tokens: Toks, _types: Type_scope) -> Host_type | String {
  match(un_toks(tokens)) {
    (
    , .(token: Token, _position: I32, _tail: Toks) {
        match(un_token(token)) {
          (
          , .(word: Tk_word) {
              let local_name = Tk_word.get(word);
              if(string_eq(local_name, "I32"[String])) {
                widen_sum(parser_host_type(local_name, i32_role()))[Host_type | String]
              } else {
                widen_sum(local_name)[Host_type | String]
              }
            }
          , .(_number: Tk_num) { widen_sum("expected host type"[String])[Host_type | String] }
          , .(_string: Tk_str) { widen_sum("expected host type"[String])[Host_type | String] }
          , .(_punct: Tk_punct) { widen_sum("expected host type"[String])[Host_type | String] }
          )
        }
      }
    , .(_empty: .) { widen_sum("missing host type"[String])[Host_type | String] }
    )
  }
}

// The parser-fuel diagnostic, exercised through the public parser surface
// with a tiny explicit budget.
fn fuel_diag() -> String {
  match(lex("add_i32(1[I32], 2[I32])"[String])) {
    (
    , .(ts: Toks) {
        match(parse_toks_scope_fuel(
        , ts
        , scope_push("add_i32"[String], scope_nil())
        , resolve_parser_host_type
        , 2[I32]
        )) {
          (
          , .(_t: P_ok) { "(parsed)\n"[String] }
          , .(e: P_err) { string_concat(perr_message(P_err.get(e)), "\n"[String]) }
          )
        }
      }
    , .(_e: Lex_err) { "(lex error)\n"[String] }
    )
  }
}

/// Feeds each malformed image class to the loader and prints the
/// resulting diagnostic.
pub fn main() {
  print(diag_of(
  , "truncated body: "[String]
  , load_package("mod hostapi;\n\nhost type I32 role(i32);\n\nhost fn add_i32(p0: I32, p1: "
                 "I32) -> I32;\nmod a;\n\nimport hostapi {type I32; fn add_i32}\n\npub fn ok(x: "
                 "I32) -> I32 { x }\n\nmod b;\n\nimport hostapi {type I32; fn add_i32}\n\npub fn "
                 "broken(x: I32) -> I32 { add_i32(x"[String])
  ));
  print(diag_of(
  , "import cycle: "[String]
  , load_package("mod hostapi;\n\nhost type I32 role(i32);\n\nmod a;\n\nimport hostapi {type "
                 "I32}\nimport b {fn pong}\n\npub fn ping(x: I32) -> I32 { pong(x) }\n\nmod b;\n\n"
                 "import hostapi {type I32}\nimport a {fn ping}\n\npub fn pong(x: I32) -> I32 "
                 "{ ping(x) }\n"[String])
  ));
  print(diag_of(
  , "unresolvable import: "[String]
  , load_package("mod hostapi;\n\nhost type I32 role(i32);\n\nhost fn add_i32(p0: I32, p1: "
                 "I32) -> I32;\nmod a;\n\nimport hostapi {type I32}\n\npub fn one() -> I32 { "
                 "1[I32] }\n\nmod b;\n\nimport hostapi {type I32}\nimport a {fn nope}\n\npub fn "
                 "go() -> I32 { nope() }\n"[String])
  ));
  print(diag_of(
  , "declaration before module header: "[String]
  , load_package("pub fn stray() -> I32 { 1[I32] }\nmod a;\n"[String])
  ));
  print(diag_of(
  , "unterminated string: "[String]
  , load_package("mod hostapi;\n\nhost type I32 role(i32);\n\nhost fn add_i32(p0: I32, p1: "
                 "I32) -> I32;\nmod a;\n\nimport hostapi {type I32}\n\npub fn s() -> I32 { "
                 "\"oops }\n"[String])
  ));
  print(diag_of(
  , "empty type application: "[String]
  , load_package("mod hostapi;\n\nhost type I32 role(i32);\n\nhost fn add_i32(p0: I32, p1: "
                 "I32) -> I32;\nmod a;\n\nimport __intrinsics__;\n\nimport hostapi {type I32}\n\n"
                 "pub fn p(x: I32) -> I32 { __fst__[](x) }\n"[String])
  ));
  print(diag_of(
  , "type argument list: "[String]
  , load_package("mod a; fn id[A](x: A) -> A { x } pub fn bad[A](x: A) -> A { id[A, A](x) "
                 "}"[String])
  ));
  print(diag_of(
  , "type binder list: "[String]
  , load_package("mod a; pub fn id[A, B](x: A) -> A { x }"[String])
  ));
  print(diag_of(
  , "parenthesized literal type: "[String]
  , load_package("mod a; host type I32 role(i32); pub fn bad() -> I32 { 1(I32) }"[String])
  ));
  print(diag_of(
  , "type constructor argument list: "[String]
  , load_package("mod a; import __intrinsics__; host type Bool role(bool); type "
                 "Carrier[A][B] = A; pub fn bad(b: Bool) { __if_then_else__[Carrier[Bool, "
                 "Bool]][.](b, .() { () }, .() { () }) }"[String])
  ));
  print(diag_of(
  , "unbound name: "[String]
  , load_package("mod hostapi;\n\nhost type I32 role(i32);\n\nhost fn add_i32(p0: I32, p1: "
                 "I32) -> I32;\nmod a;\n\nimport hostapi {type I32}\n\npub fn u(x: I32) -> I32 "
                 "{ missing(x) }\n"[String])
  ));
  print(diag_of(
  , "higher-kinded host type binder: "[String]
  , load_package("mod hostapi;\n\nhost type Wrapper[*F];\n"[String])
  ));
  print(string_concat("parser fuel: "[String], fuel_diag()))
}
