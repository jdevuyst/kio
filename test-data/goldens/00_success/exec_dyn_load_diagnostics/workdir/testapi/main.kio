/// This case's loading host: feed each class of malformed image to the loader and print its diagnostic.
module testapi/main;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import host_descriptor(Host_type, Role, bool_role, i32_role, mk_host_id, mk_role_host_type);
import lex(Lex_err, lex);
import loader(Load_outcome, Lr_diag, Lr_image);
import loader(diag_message, un_load_outcome);
import loader/scan(load_package);
import parse(P_err, P_ok);
import parse(parse_toks_scope_fuel, perr_message, scope_nil, scope_push);
import testapi(Bool, I32, String);
import testapi/io(print);
import testapi/text(string_concat, string_eq);
import token(Toks);

// Render a load outcome's diagnostic under the case's label; a load that
// unexpectedly succeeds renders as `(loaded)` so a silently-accepted
// malformed image fails the case visibly.
fn diag_of(label: String, out: Load_outcome) -> String {
  match! un_load_outcome(out) {
    (
      , .(_im: Lr_image) { string_concat(label, "(loaded)\n"(String)) }
      , .(d: Lr_diag) {
          string_concat(label, string_concat(diag_message(Lr_diag.get(d)), "\n"(String)))
        }
      )
  }
}

fn parser_host_type(local_name: String, role: Role) -> Host_type {
  mk_role_host_type(mk_host_id("hostapi"(String), local_name), role)
}

fn resolve_parser_host_type(local_name: String) -> Host_type | String {
  if! string_eq(local_name, "I32"(String)) {
    widen_sum!(parser_host_type(local_name, i32_role()), Host_type | String)
  } else {
    widen_sum!(local_name, Host_type | String)
  }
}

fn parser_bool_type() -> Host_type | String {
  widen_sum!(parser_host_type("Bool"(String), bool_role()), Host_type | String)
}

// The parser-fuel diagnostic, exercised through the public parser surface
// with a tiny explicit budget.
fn fuel_diag() -> String {
  match! lex("add_i32(1(I32), 2(I32))"(String)) {
    (
      , .(ts: Toks) {
          match! parse_toks_scope_fuel(
            , ts
            , scope_push("add_i32"(String), scope_nil())
            , resolve_parser_host_type
            , parser_bool_type()
            , 2(I32)
            ) {
            (
              , .(_t: P_ok) { "(parsed)\n"(String) }
              , .(e: P_err) { string_concat(perr_message(P_err.get(e)), "\n"(String)) }
              )
          }
        }
      , .(_e: Lex_err) { "(lex error)\n"(String) }
      )
  }
}

/// Feeds each malformed image class to the loader and prints the
/// resulting diagnostic.
pub fn main() -> . {
  print(diag_of(
    , "truncated body: "(String)
    , load_package("module hostapi;\n\nhost type I32 role(i32);\n\nhost fn add_i32(p0: I32, p1: "
                   "I32) -> I32;\nmodule a;\n\nimport hostapi(I32, add_i32);\n\npub fn ok(x: I32) "
                   "-> I32 { x }\n\nmodule b;\n\nimport hostapi(I32, add_i32);\n\npub fn broken(x: "
                   "I32) -> I32 { add_i32(x"(String))
    ));
  print(diag_of(
    , "import cycle: "(String)
    , load_package("module hostapi;\n\nhost type I32 role(i32);\n\nmodule a;\n\nimport "
                   "hostapi(I32);\nimport b(pong);\n\npub fn ping(x: I32) -> I32 { pong(x) }\n\n"
                   "module b;\n\nimport hostapi(I32);\nimport a(ping);\n\npub fn pong(x: I32) -> "
                   "I32 { ping(x) }\n"(String))
    ));
  print(diag_of(
    , "unresolvable import: "(String)
    , load_package("module hostapi;\n\nhost type I32 role(i32);\n\nhost fn add_i32(p0: I32, p1: "
                   "I32) -> I32;\nmodule a;\n\nimport hostapi(I32);\n\npub fn one() -> I32 { "
                   "1(I32) }\n\nmodule b;\n\nimport hostapi(I32);\nimport a(nope);\n\npub fn go() "
                   "-> I32 { nope() }\n"(String))
    ));
  print(diag_of(
    , "declaration before module header: "(String)
    , load_package("pub fn stray() -> I32 { 1(I32) }\nmodule a;\n"(String))
    ));
  print(diag_of(
    , "unterminated string: "(String)
    , load_package("module hostapi;\n\nhost type I32 role(i32);\n\nhost fn add_i32(p0: I32, p1: "
                   "I32) -> I32;\nmodule a;\n\nimport hostapi(I32);\n\npub fn s() -> I32 { \"oops "
                   "}\n"(String))
    ));
  print(diag_of(
    , "intrinsic arity: "(String)
    , load_package("module hostapi;\n\nhost type I32 role(i32);\n\nhost fn add_i32(p0: I32, p1: "
                   "I32) -> I32;\nmodule a;\n\nimport __intrinsics__;\n\nimport hostapi(I32);\n\n"
                   "pub fn p(x: I32) -> I32 { __fst__(I32, I32, x, x) }\n"(String))
    ));
  print(diag_of(
    , "unbound name: "(String)
    , load_package("module hostapi;\n\nhost type I32 role(i32);\n\nhost fn add_i32(p0: I32, p1: "
                   "I32) -> I32;\nmodule a;\n\nimport hostapi(I32);\n\npub fn u(x: I32) -> I32 { "
                   "missing(x) }\n"(String))
    ));
  print(diag_of(
    , "higher-kinded host type binder: "(String)
    , load_package("module hostapi;\n\nhost type Wrapper[*F];\n"(String))
    ));
  print(string_concat("parser fuel: "(String), fuel_diag()))
}
