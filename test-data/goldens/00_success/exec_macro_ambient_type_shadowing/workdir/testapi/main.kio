mod testapi/main;

import syntax { macro identity }
import testapi as host;
import testapi { type String }
import testapi/io { fn print }

fn shadow[String](_value: String) -> host.String { identity("nominal\n") }

fn preserve[String](value: String) -> String { identity[String](value) }

pub fn main() { print(shadow(())); print(preserve("bound\n")) }
