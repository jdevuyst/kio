module testapi/main;

import macros/match(macro match);
import macros/spine_macros(macro widen_sum);
import testapi(String);
import testapi/io(print);

type { Left[A]: A; Right[A]: A }

type Branch[A] = Left[A] | Right[A];

fn left[A](value: A) -> (Left[A] & .) | (Right[A] & .) {
  widen_sum((Left.mk(value), ()))[(Left[A] & .) | (Right[A] & .)]
}

fn right[A](value: A) -> (Left[A] & .) | (Right[A] & .) {
  widen_sum((Right.mk(value), ()))[(Left[A] & .) | (Right[A] & .)]
}

fn classify[A](source: (Left[A] & .) | (Right[A] & .), result: String) -> String {
  match(source) {
    .(_branch: Branch[A] & .) { result }
  }
}

pub fn main() {
  print(classify(left("value"[String]), "left\n"));
  print(classify(right("value"[String]), "right\n"))
}
