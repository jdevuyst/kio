mod testapi/main;

import macros/derive { macro derive }
import testapi { type String }
import testapi/io { fn print }

// The canonical brand-eligible arity-1 newtype.
pub type { Box[A]: A { pub mk; pub get } }

// A `Monad[*F]` dictionary with a single polymorphic-function
// payload: the bind function takes a branded value and a continuation.
pub type { Monad[*F]: [A][B] (F[A] & (A -> F[B])) -> F[B] { pub mk; pub get } }

// The Box instance — a zero-precondition base rule (`. -> R`).
fn box_monad() -> Monad[Box] {
  Monad.mk(.[A][B](m, k) { k(Box.get(m)) })
}

// The simplest `derive`: a single base instance, trivial derivation.
// The synthesized call tree is just `box_monad()`.
fn use_derived() -> String {
  let monad = derive(box_monad)[Monad[Box]];
  let lifted = Box.mk("derive! base: ok\n"[String]);
  let stepped = Monad.get(monad)[String][String](lifted, .(s) { Box.mk(s) });
  Box.get(stepped)
}

pub fn main() { print(use_derived()) }
