mod main;

op _ + _ { impl helpers.add }

op_var [] { foldl helpers.step Box.base; finalize helpers.finish }

op_var [* *] { foldr helpers.step Box.base; finalize () }

op_var [% %] { foldl1 helpers.step Box.seed }

op_var [& &] { foldr1 helpers.step Box.seed }

macro inspect : . -> . { captures (source, Box); impl helpers.inspect }

macro ordinary : . -> . { impl fills }

macro scheduled : . -> . { impl(fills) fills }

rec(loop) fn keep(x: .) { x }

fn first(x: .) { x.>helpers.keep }

fn last(x: .) { x.>>Box.make(()) }
