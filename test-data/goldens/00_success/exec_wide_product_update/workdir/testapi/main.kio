mod testapi/main;

import macros/row_macros { macro select; macro with }
import testapi { type I32; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }
import testapi/text { fn string_concat }

type {
  A: I32 { mk; get };
  B: I32 { mk; get };
  C: I32 { mk; get };
  D: I32 { mk; get };
  E: I32 { mk; get };
  F: I32 { mk; get };
  G: I32 { mk; get };
  H: I32 { mk; get };
  I: I32 { mk; get };
  J: I32 { mk; get };
  K: I32 { mk; get };
  L: I32 { mk; get }
}

type Wide = A & B & C & D & E & F & G & H & I & J & K & L;

fn comma(left: String, right: String) -> String { string_concat(left, string_concat(",", right)) }

fn show(row: Wide) -> String {
  comma(
  , int_to_string(row.>select { A.get })
  , comma(
    , int_to_string(row.>select { B.get })
    , comma(
      , int_to_string(row.>select { C.get })
      , comma(
        , int_to_string(row.>select { D.get })
        , comma(
          , int_to_string(row.>select { E.get })
          , comma(
            , int_to_string(row.>select { F.get })
            , comma(
              , int_to_string(row.>select { G.get })
              , comma(
                , int_to_string(row.>select { H.get })
                , comma(
                  , int_to_string(row.>select { I.get })
                  , comma(
                    , int_to_string(row.>select { J.get })
                    , comma(
                      , int_to_string(row.>select { K.get })
                      , int_to_string(row.>select { L.get })
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

fn revise(row: Wide) -> Wide {
  row.>with { K.mk(120) }
}

pub fn main() {
  let row =
    (
    , A.mk(1)
    , B.mk(2)
    , C.mk(3)
    , D.mk(4)
    , E.mk(5)
    , F.mk(6)
    , G.mk(7)
    , H.mk(8)
    , I.mk(9)
    , J.mk(10)
    , K.mk(11)
    , L.mk(12)
    );
  print(show(revise(row)));
  print("\n")
}
