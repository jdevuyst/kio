module testapi/main;

import testapi(I32, String);
import testapi/fmt(int_to_string);
import testapi/io(print);
import testapi/text(string_concat);

labels {
  , a: I32
  , b: I32
  , c: I32
  , d: I32
  , e: I32
  , f: I32
  , g: I32
  , h: I32
  , i: I32
  , j: I32
  , k: I32
  , l: I32
  };

type Wide = A & B & C & D & E & F & G & H & I & J & K & L;

fn comma(left: String, right: String) -> String { string_concat(left, string_concat(",", right)) }

fn show(row: Wide) -> String {
  comma(
    , int_to_string(row.?{a})
    , comma(
        , int_to_string(row.?{b})
        , comma(
            , int_to_string(row.?{c})
            , comma(
                , int_to_string(row.?{d})
                , comma(
                    , int_to_string(row.?{e})
                    , comma(
                        , int_to_string(row.?{f})
                        , comma(
                            , int_to_string(row.?{g})
                            , comma(
                                , int_to_string(row.?{h})
                                , comma(
                                    , int_to_string(row.?{i})
                                    , comma(
                                        , int_to_string(row.?{j})
                                        , comma(int_to_string(row.?{k}), int_to_string(row.?{l}))
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
}

fn revise(row: Wide) -> Wide { row.!{k = 120} }

pub fn main() -> . {
  let row = {a = 1, b = 2, c = 3, d = 4, e = 5, f = 6, g = 7, h = 8, i = 9, j = 10, k = 11, l = 12};
  print(show(revise(row)));
  print("\n")
}
