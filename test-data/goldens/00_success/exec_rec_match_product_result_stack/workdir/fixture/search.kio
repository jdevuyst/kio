/// A tail-recursive call inside an elaborated branch must carry its
/// continuation unchanged. Adapting it at every step grows a host call chain
/// even though `rec(loop)` itself uses the host's iterative loop primitive.
/// The second entry keeps a real pending continuation and makes its execution
/// observable by advancing the report after each recursive result.
module fixture/search;

import fixture/model(Again, Choice, Done, First, Report, Second);
import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import macros/spine_macros(macro widen_sum);
import testapi(Bool, I32);
import testapi/arith(add_i32, leq_i32, sub_i32);
import testapi/iter(loop);

fn choice(remaining: I32) -> Choice {
  let .(done: Bool) = leq_i32(remaining, 0);
  if(done) { widen_sum(Done.mk(()))[Choice] } else { widen_sum(Again.mk(()))[Choice] }
}

fn report(value: I32) -> Report { (First.mk(value), Second.mk(add_i32(value, 1))) }

fn advance(value: Report) -> Report {
  report(add_i32(value.>select { Second.get }, 1))
}

pub rec(loop) fn descend(remaining: I32) -> Report {
  match(choice(remaining)) {
    (
    , .(_again: Again) { recur descend(sub_i32(remaining, 1)) }
    , .(_done: Done) { report(remaining) }
    )
  }
}

pub rec(loop) fn descend_pending(remaining: I32) -> Report {
  let .(done: Bool) = leq_i32(remaining, 0);
  if(done) { report(0) } else { advance(recur(cont) descend_pending(sub_i32(remaining, 1))) }
}
