mod testapi/main;

import testapi { type I32 }
import testapi/arith { fn add_i32 }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

// A five-parameter function-valued newtype payload. Construction,
// projection, and invocation must preserve the complete source grouping.
type { Five: (I32 & I32 & I32 & I32 & I32) -> I32 { pub mk; pub get } }

fn five_sum() -> Five {
  Five.mk(.(a, b, c, d, e) { add_i32(add_i32(add_i32(add_i32(a, b), c), d), e) })
}

pub fn main() {
  let f = five_sum();
  print(int_to_string(Five.get(f)(1[I32], 2[I32], 3[I32], 4[I32], 5[I32])))
}
