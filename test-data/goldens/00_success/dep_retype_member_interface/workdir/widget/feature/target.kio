module widget/feature/target;

pub(widget/feature) newtype Box[B] : B {
  pub(widget/feature) constructor pack;
  pub(widget/feature) projector unpack
  }

pub newtype Public[B] : B { pub constructor wrap; pub projector value }

pub newtype Hidden : . { constructor conceal; projector inspect }

pub newtype Opaque : . { constructor create; projector inspect }
