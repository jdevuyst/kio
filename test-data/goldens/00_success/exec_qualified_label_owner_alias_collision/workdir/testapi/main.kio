mod testapi/main;

import decoy as selected;
import macros/control { macro if }
import selected as chosen;
import testapi { type Bool; type String }
import testapi/io { fn print }

pub fn main() {
  let card = chosen.make(.t);
  if(card.>chosen.Flag.get) { print("selected\n") } else { print("decoy\n") }
}
