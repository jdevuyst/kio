module testapi/main;

import elab/control(if);
import elab/spine_elaborators(widen_sum);
import testapi(Bool, I32, String);
import testapi/arith(leq_i32, sub_i32);
import testapi/fmt(int_to_string);
import testapi/io(print);
import testapi/iter(loop);
import testapi/text(string_concat);

// Abbreviated 5-line variant: counts down from `start` to 1
// printing the canonical "N bottles of beer on the wall" line
// per step. The canonical 99-line variant uses the same step
// function — start at 99 instead of 3; bounded here so the
// golden output stays short.
//
// String building goes through `string_concat`; the host has no
// other join primitive in this case's vocabulary.
fn render(n: I32) -> String {
  string_concat(
    , int_to_string(n)
    , string_concat(
        , " bottle"
        , string_concat(
            , if! leq_i32(n, 1) {
                ""
              } else {
                "s"
              }
            , " of beer\n"
            )
        )
    )
}

fn step(n: I32) -> I32 | . {
  if! leq_i32(1, n) {
    print(render(n));
    widen_sum!(sub_i32(n, 1))
  } else {
    widen_sum!(())
  }
}

fn bottles(start: I32) -> . { loop(.(n: I32) { step(n) }, start) }

pub fn main() -> . { bottles(3) }
