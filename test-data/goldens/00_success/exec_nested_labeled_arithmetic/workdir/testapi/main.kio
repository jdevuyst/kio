module testapi/main;

import testapi(I32);
import testapi/arith(sub_i32);
import testapi/fmt(int_to_string);
import testapi/io(print);

labels Pair_fields = { first: I32, second: I32 };

type Pair = First & Second;

fn pair(first: I32, second: I32) -> Pair { {first, second} }

fn pick_second(_first: I32, second: I32) -> I32 { second }

fn decrement_second(row: Pair) -> I32 { pick_second(row.?{first}, sub_i32(row.?{second}, 1)) }

pub fn main() -> . { print(int_to_string(decrement_second(pair(10, 4)))) }
