module testapi/main;

import macros/row_macros(macro select);
import testapi(I32);
import testapi/arith(sub_i32);
import testapi/fmt(int_to_string);
import testapi/io(print);

type { First: I32 { mk; get }; Second: I32 { mk; get } }

type Pair_fields = First & Second;

type Pair = First & Second;

fn pair(first: I32, second: I32) -> Pair { (First.mk(first), Second.mk(second)) }

fn pick_second(_first: I32, second: I32) -> I32 { second }

fn decrement_second(row: Pair) -> I32 {
  pick_second(row.>select { First.get }, sub_i32(row.>select { Second.get }, 1))
}

pub fn main() { print(int_to_string(decrement_second(pair(10, 4)))) }
