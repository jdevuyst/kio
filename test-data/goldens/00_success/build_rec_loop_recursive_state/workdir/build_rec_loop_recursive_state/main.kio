module build_rec_loop_recursive_state/main;

import build_rec_loop_recursive_state(Bool, I32, leq_i32, loop, sub_i32);
import macros/control(macro if);
import macros/row_macros(macro select);

rec type { List[A]: . | (A & List[A]) { mk; get } }

type State_fields = { Items: List[I32]; Tick: I32 };

type State = Items & Tick;

fn state(items: List[I32], tick: I32) -> State { (Items.mk(items), Tick.mk(tick)) }

rec(loop) fn run_from(current: State) -> State {
  if(leq_i32(current.>select { Tick.get }, 0)) {
    current
  } else {
    recur run_from(state(current.>select { Items.get }, sub_i32(current.>select { Tick.get }, 1)))
  }
}

pub fn main() { () }
