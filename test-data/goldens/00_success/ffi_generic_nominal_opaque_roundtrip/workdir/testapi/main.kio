module testapi/main;

import testapi as t;
import testapi/arith as a;

pub type { Wrapped[A]: A { pub mk; get } }

pub fn unwrap(value: Wrapped[t.I32]) -> t.I32 { value.>Wrapped.get }

pub fn read(value: t.Box[Wrapped[t.I32]]) -> t.I32 { unwrap(a.box_get(value)) }

pub fn make(value: t.I32) -> t.Box[Wrapped[t.I32]] { a.box_make(Wrapped.mk(value)) }
