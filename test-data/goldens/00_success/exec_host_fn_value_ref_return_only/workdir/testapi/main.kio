mod testapi/main;

import testapi { type Array; type I32 }
import testapi/array { fn array_get; fn array_make_empty; fn array_push }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

fn make(make_empty: [A] . -> Array[A]) -> Array[I32] { make_empty[I32](()) }

pub fn main() {
  let items = make(array_make_empty);
  array_push(items, 7);
  print(int_to_string(array_get(items, 0)))
}
