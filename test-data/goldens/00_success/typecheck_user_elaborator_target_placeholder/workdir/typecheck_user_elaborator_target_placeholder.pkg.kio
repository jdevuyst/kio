package typecheck_user_elaborator_target_placeholder;

build {
  cache "out/.kio-cache/";

  target js {
    out "out/js/";
    baseline es2020
  };

  target ts {
    out "out/ts/";
    baseline v5_0
  }
}

bridge {
  typecheck_user_elaborator_target_placeholder;
  typecheck_user_elaborator_target_placeholder/**;
  elaborators
}
