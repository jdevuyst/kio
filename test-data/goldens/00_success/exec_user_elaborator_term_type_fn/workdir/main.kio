module main;

import elaborators(polymorphic_unit, projected_polymorphic);

fn make_polymorphic_unit() -> [A] . { polymorphic_unit!() }

fn make_projected_polymorphic[Ct](value: Ct) -> [A] Ct { projected_polymorphic!(value) }

pub fn main() -> . {
  let direct = make_polymorphic_unit();
  direct(.);
  let projected = make_projected_polymorphic(());
  projected(.)
}
