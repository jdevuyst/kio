mod main;

import __comptime__;

pure fn observer(ct: __Comptime__) -> [A] . -> Comptime_bool {
  .[A](_unit: .) -> Comptime_bool { __type_is_product_root__(ct, __reflect_type__(ct)[A]) }
}

equiv unit_instantiation(ct: __Comptime__) {
  observer(ct)[.](());
  __.f__(ct)
}

equiv product_instantiation(ct: __Comptime__) {
  observer(ct)[. & .](());
  __.t__(ct)
}

equiv unit_observation(ct: __Comptime__) {
  __type_is_product_root__(ct, __reflect_type__(ct)[.]);
  __.f__(ct)
}

equiv product_observation(ct: __Comptime__) {
  __type_is_product_root__(ct, __reflect_type__(ct)[. & .]);
  __.t__(ct)
}

pure fn indirect[A](ct: __Comptime__) -> __Type__ {
  let reflected = __reflect_type__(ct);
  reflected[A]
}

equiv unit(ct: __Comptime__) {
  indirect[.](ct);
  __reflect_type__(ct)[.]
}

equiv product(ct: __Comptime__) {
  indirect[. & .](ct);
  __reflect_type__(ct)[. & .]
}
