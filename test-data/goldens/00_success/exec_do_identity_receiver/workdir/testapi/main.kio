module testapi/main;

import elab/sequence(do);
import testapi/io as io;

type Identity[A] = A;

fn bind[A][B](value: Identity(A), next: A -> Identity(B)) -> Identity(B) { next(value) }

pub fn main() -> . {
  let result =
    do! bind {
      let value <- ();
      value
    };
  result;
  io.print("identity\n")
}
