mod testapi/main;

import testapi as t;
import testapi { type Int; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

// An explicit literal annotation names the role-inheriting alias while
// retaining the exact testapi.Int carrier.
type Reint = t.Int;

fn as_reint() -> Reint { 42[Reint] }

pub fn main() { let _ = print(int_to_string(as_reint())); print("\n"[t.String]) }
