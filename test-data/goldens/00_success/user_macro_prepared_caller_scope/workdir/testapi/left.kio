mod testapi/left;

import macros/match { macro match }
import testapi/arith { fn add_i32 }
import testapi/iter { fn loop }
import testapi/model as model;
import testapi/model { type Expr; type Leaf; type Pair; type Summary }
import testapi/normalize { fn normalize }

fn add_summary(left: Summary, right: Summary) -> Summary {
  let left_value = model.Value.get(left);
  let right_value = model.Value.get(right);
  model.summary(add_i32(left_value, right_value))
}

pub rec(loop) fn reduce(value: Expr) -> Summary {
  let normalized = normalize(value);
  match(Expr.get(normalized)) {
    (
    , .(leaf: Leaf) { model.summary(Leaf.get(leaf)) }
    , .(pair: Pair) {
        match(Pair.get(pair)) {
          .(left: Expr, right: Expr) {
            add_summary(recur(cont) reduce(left), recur(cont) reduce(right))
          }
        }
      }
    )
  }
}
