module testapi/main;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(Bool, I32, String);
import testapi/arith(leq_i32, mul_i32, sub_i32);
import testapi/fmt(int_to_string);
import testapi/io(print);
import testapi/text(string_concat);

// `Either[A][B]` as `a | B`: the canonical "one of two shapes"
// sum. `left` injects into the `a` arm, `right` into the `b` arm.
// `map_right` / `and_then` are the right-biased combinators from the
// Haskell / Rust tradition — they fix the error arm and transform
// the value arm. Use as `Either(Error, Value)`.
newtype Either[A][B] : A | B { pub constructor mk_either; pub projector un_either }

fn left[A][B](v: A) -> Either(A, B) { Either.mk_either(widen_sum!(v, A | B)) }

fn right[A][B](v: B) -> Either(A, B) { Either.mk_either(widen_sum!(v, A | B)) }

// `map_right` lifts a total `b -> c` over `Either(a, b)`. The
// `left` arm passes through unchanged; the `right` arm gets `f`
// applied to its payload.
fn map_right[A][B][C](f: B -> C, e: Either(A, B)) -> Either(A, C) {
  match! e.>Either.un_either {
    (.(l: A) { left(A, C, l) }, .(r: B) { right(A, C, f(r)) })
  }
}

// `and_then` chains a `b -> Either(a, c)` over `Either(a, b)`. The
// `left` arm passes through unchanged; the `right` arm dispatches
// to `f`. The "right is the value, left is the error" convention.
fn and_then[A][B][C](f: B -> Either(A, C), e: Either(A, B)) -> Either(A, C) {
  match! e.>Either.un_either {
    (.(l: A) { left(A, C, l) }, .(r: B) { f(r) })
  }
}

// Render an `Either(String, I32)` as `left("s")` or `right(v)`. The
// `left` payload is quoted because it is a String literal in the
// equations; the `right` payload is bare because it is a number.
fn print_either(e: Either(String, I32)) -> String {
  match! e.>Either.un_either {
    (
      , .(s: String) { string_concat("left(\"", string_concat(s, "\")")) }
      , .(v: I32) { string_concat("right(", string_concat(int_to_string(v), ")")) }
      )
  }
}

fn double(x: I32) -> I32 { mul_i32(x, 2) }

// `check_positive` is the canonical `Result`-flavored validator:
// the input becomes a `right` when positive, a `left` carrying an
// error message when not. Used as the `and_then` argument to surface
// the chain's short-circuit on failure.
fn check_positive(v: I32) -> Either(String, I32) {
  if! leq_i32(v, 0) {
    left(String, I32, "not positive")
  } else {
    right(String, I32, v)
  }
}

fn show_eq(label: String, value: String) -> . {
  print(string_concat(label, string_concat(" == ", string_concat(value, "\n"))))
}

pub fn main() -> . {
  show_eq("right(2) |> map_right(double)", print_either(map_right(double, right(String, I32, 2))));
  show_eq(
    , "left(\"err\") |> map_right(double)"
    , print_either(map_right(double, left(String, I32, "err")))
    );
  show_eq(
    , "right(2) |> and_then(check_positive)"
    , print_either(and_then(check_positive, right(String, I32, 2)))
    );
  show_eq(
    , "right(-1) |> and_then(check_positive)"
    , print_either(and_then(check_positive, right(String, I32, sub_i32(0, 1))))
    )
}
