mod testapi/main;

import __intrinsics__;

import macros/derive { macro derive }
import testapi { type String }
import testapi/io { fn print }
import testapi/text { fn string_concat }

// A value-carrying wrapper and a pair, both kind-`*` brands, each
// holding a host `String` leaf — so the `derive` resolver below reflects
// a host type while it walks the goal and its candidate rules.
pub type { Cell[A]: A { pub mk; pub get } }

pub type { Pair[A][B]: A & B { pub mk; pub get } }

// `Render[A]` — an instance dictionary turning an `A` into a `String`.
pub type { Render[A]: A -> String { pub mk; pub get } }

// Base instance for `Cell(String)` — a zero-precondition rule whose
// result mentions the host type.
fn render_cell_string() -> Render[Cell[String]] {
  Render.mk(.(c) { Cell.get(c) })
}

// Compositional rule: given instances for `a` and `b`, render a
// `Pair(a, b)`. Both preconditions are strict sub-terms of the result.
fn render_pair[A][B](ra: Render[A], rb: Render[B]) -> Render[Pair[A][B]] {
  Render.mk[Pair[A][B]](.(p) {
    let left = Render.get(ra)(__fst__[A][B](Pair.get[A][B](p)));
    let right = Render.get(rb)(__snd__[A][B](Pair.get[A][B](p)));
    string_concat(left, right)
  })
}

// Derive a one-level instance over a `Pair` of host-`String` cells.
// The synthesized call tree is `render_pair(render_cell_string(),
// render_cell_string())` — `render_pair` fires once, the base twice.
fn run() -> String {
  let inst = derive((render_pair, render_cell_string))[Render[Pair[Cell[String]][Cell[String]]]];
  let value =
    Pair.mk[Cell[String]][Cell[String]](__pair__[Cell[String]][Cell[String]](
    , Cell.mk("derive host: "[String])
    , Cell.mk("ok\n"[String])
    ));
  Render.get(inst)(value)
}

pub fn main() { print(run()) }
