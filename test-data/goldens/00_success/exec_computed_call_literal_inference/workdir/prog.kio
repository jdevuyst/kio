module prog;

import testapi(I32);
import testapi/fmt(print_i32);

fn keep_first[A](first: A) -> A -> A {
  .(_later: A) { first }
}

fn argument_context() -> I32 { let result = keep_first(1)(2[I32]); result }

fn nested_context() -> I32 { let result = keep_first(keep_first(3)(4[I32]))(5[I32]); result }

fn result_context() -> I32 { keep_first(6)(7) }

pub fn main() {
  print_i32(argument_context());
  print_i32(nested_context());
  print_i32(result_context())
}
