mod testapi/main;

import testapi { type String }
import testapi/io { fn print }

type { Box <A>: String & A { pub mk; pub get } }

fn make_box[A](s: String, w: A) -> Box { Box.mk[A]((s, w)) }

fn apply_proj(p: Box -> [R] ([A] (String & A) -> R) -> R, v: Box) -> String {
  p(v)(.[A](pair: String & A) { "ok\n"[String] })
}

pub fn main() { print(apply_proj(Box.get, make_box("seed"[String], ()))) }
