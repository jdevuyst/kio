module host/m;

import elab/control(if);
import elab/match(match);
import host(Bool);

equiv if_else_same_shape() {
  if! .t {
    ()
  } else {
    ()
  };
  if! .t {
    ()
  } else {
    ()
  }
}

equiv match_same_shape() {
  match! .t {
    .(x: Bool) { () }
  };
  match! .t {
    .(y: Bool) { () }
  }
}
