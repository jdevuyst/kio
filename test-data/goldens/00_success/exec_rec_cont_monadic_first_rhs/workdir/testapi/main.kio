mod testapi/main;

import macros/control { macro if }
import macros/sequence { macro do }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn leq_i32 }
import testapi/fmt { fn i32_to_string }
import testapi/io { fn print }
import testapi/iter { fn loop }

fn chain[A][B](value: A, next: A -> B) -> B { next(value) }

rec(loop) fn go(n: I32) -> I32 {
  if(leq_i32(n, 0)) { 41 } else do(chain) { let value <- recur(cont) go(0); value }
}

pub fn main() { print(i32_to_string(go(1))); print("\n") }
