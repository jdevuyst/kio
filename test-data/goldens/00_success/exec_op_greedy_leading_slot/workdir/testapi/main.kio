mod testapi/main;

import testapi { type Int; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

fn first(a: Int, b: Int) -> Int { a }

fn second(a: Int, b: Int) -> Int { b }

op _ + _ { impl first }

// The greedy first slot captures `1 + 2` before applying the outer operator.
op ___ < _ > { impl second }

pub fn main() { print(int_to_string(1 + 2 < 3 >)); print("\n") }
