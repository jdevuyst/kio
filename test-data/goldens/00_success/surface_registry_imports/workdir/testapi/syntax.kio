mod testapi/syntax;

import testapi { type String }

pub lit word = "ok\n";

pub type { Message: String { pub mk; pub get } }

pub fn id(value: String) -> String { value }

pub op + _ { impl id }

pub fn empty() -> String { "" }

pub fn take(value: String, rest: String) -> String { value }

pub op_var [* *] { foldr take empty }
