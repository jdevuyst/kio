mod testapi/main;

import testapi { type String }
import testapi/arith { fn round_picker }
import testapi/io { fn print }
import testapi/types { type Pick_first }

fn first_picker() -> Pick_first {
  Pick_first.mk(.[A](left: A, _right: A) { left })
}

pub fn main() {
  let picker = round_picker(first_picker());
  print(Pick_first.get(picker)[String](
  , "polymorphic function newtype roundtrip ok\n"[String]
  , "wrong\n"[String]
  ))
}
