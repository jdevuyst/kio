module testapi/main;

import testapi(String);
import testapi/arith(round_picker);
import testapi/io(print);
import testapi/types(Pick_first);

fn first_picker() -> Pick_first { Pick_first.mk_pick_first(.[A](left: A, _right: A) { left }) }

pub fn main() -> . {
  let picker = round_picker(first_picker());
  print(Pick_first.pick_first(picker)(
    , String
    , "polymorphic function newtype roundtrip ok\n"(String)
    , "wrong\n"(String)
    ))
}
