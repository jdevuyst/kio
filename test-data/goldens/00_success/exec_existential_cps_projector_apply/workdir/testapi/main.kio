module testapi/main;

import macros/spine_macros(macro one_prod);
import testapi(String);
import testapi/io(print);

type { Pack[A] <U>: A & U { mk; get } }

fn unwrap_a[A](v: Pack[A]) -> A {
  Pack.get[A](v)(.[U](pair: A & U) { (pair.>one_prod)[A] })
}

pub fn main() { let s = "ok\n"[String]; let v = Pack.mk((s, s)); print(unwrap_a(v)) }
