module store;

import macros/row_macros(macro select);

pub rec type { Foo[A]: (Foo[A] -> A) -> A { pub mk; pub get } }

pub rec type { Peer[A]: (Peer[A] -> A) -> A { pub mk; pub get } }

pub type Mixed[A] = Foo[A] & Peer[A];

pub fn mixed_peer[A](row: Mixed[A], next: Peer[A] -> A) -> A {
  let function = row.>select { Peer.get[A] };
  function(next)
}

pub fn read_foo[A](value: Foo[A], next: Foo[A] -> A) -> A { Foo.get(value)(next) }
