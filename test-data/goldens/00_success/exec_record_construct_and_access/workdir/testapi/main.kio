mod testapi/main;

import macros/match { macro match }
import macros/row_macros { macro select }
import testapi { type Int; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

// Construction and selection preserve each field's nominal boundary.
type { Hed: Int; Mid: String; Tal: Int }

fn show(r: Hed & Mid & Tal) {
  match(r) {
    .(h: Hed, m: Mid, t: Tal) {
      print(int_to_string(h.>select { Hed.get }));
      print(", ");
      print(m.>select { Mid.get });
      print(", ");
      print(int_to_string(t.>select { Tal.get }));
      print("\n")
    }
  }
}

pub fn main() { let r = (Hed.mk(7), Mid.mk("kio"), Tal.mk(11)); show(r) }
