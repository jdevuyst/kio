module testapi/main;

import elab/match(match);
import testapi(Int, String);
import testapi/fmt(int_to_string);
import testapi/io(print);

// Construction and access preserve each label's nominal boundary.
labels { hed: Int, mid: String, tal: Int };

fn show(r: Hed & Mid & Tal) {
  match! r {
    .(h: Hed, m: Mid, t: Tal) {
      print(int_to_string(h.?{hed}));
      print(", ");
      print(m.?{mid});
      print(", ");
      print(int_to_string(t.?{tal}));
      print("\n")
    }
  }
}

pub fn main() { let r = ({hed = 7}, {mid = "kio"}, {tal = 11}); show(r) }
