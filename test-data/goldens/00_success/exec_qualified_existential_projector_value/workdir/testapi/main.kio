mod testapi/main;

import testapi { type String }
import testapi/io { fn print }
import testapi/types as t;

type { Box <A>: A { mk; get } }

fn apply_proj(p: t.Box -> [R] ([A] (String & A) -> R) -> R, v: t.Box) -> String {
  p(v)(.[A](text: String, _witness: A) { text })
}

pub fn main() { print(apply_proj(t.Box.get, t.make_box("owner-ok\n"[String], ()))) }
