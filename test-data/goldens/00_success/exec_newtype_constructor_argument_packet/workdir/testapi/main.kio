module testapi/main;

import testapi(String);
import testapi/io as io;

newtype Pack <A> : (A -> String) & A { constructor make; projector open }

fn printer() -> String -> String { io.print("function;"); .(text: String) { text } }

fn value() -> String { io.print("value;"); "packed" }

pub fn main() -> . {
  let .(<Hidden> payload) = Pack.open(Pack.make(printer(), value()));
  let .(show, text) = payload;
  io.print(show(text));
  io.print("\n")
}
