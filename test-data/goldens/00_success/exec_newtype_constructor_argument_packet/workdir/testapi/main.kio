mod testapi/main;

import testapi { type String }
import testapi/io as io;

type { Pack <A>: (A -> String) & A { mk; get } }

fn printer() -> String -> String {
  io.print("function;");
  .(text: String) { text }
}

fn value() -> String { io.print("value;"); "packed" }

pub fn main() {
  let .(<Hidden> payload) = Pack.get(Pack.mk(printer(), value()));
  let .(show, text) = payload;
  io.print(show(text));
  io.print("\n")
}
