mod host/m;

import host { type Bool }
import macros/control { macro if }
import macros/match { macro match }

equiv if_else_same_shape() {
  if(.t) { () } else { () };
  if(.t) { () } else { () }
}

equiv match_same_shape() {
  match(.t[Bool]) {
    .(x: Bool) { () }
  };
  match(.t[Bool]) {
    .(y: Bool) { () }
  }
}
