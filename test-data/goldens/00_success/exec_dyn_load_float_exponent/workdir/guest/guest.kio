module guest;

import hostapi(F32, F64, add_f64);

pub fn tiny() -> F64 { add_f64(1.5e-3, 2.5e2) }

pub fn tenth() -> F32 { 0.1 }

pub fn above() -> F32 { 1.0000000596046447753906250000000000000000000000000000000000000000001 }

pub fn subnormal() -> F32 { 2.0e-45 }

pub fn negative_zero() -> F32 { -0.0 }

pub fn negative_underflow() -> F32 { -1.0e-9999 }

pub fn positive_underflow() -> F32 { 1.0e-9999 }

pub fn negative_underflow64() -> F64 { -1.0e-9999 }
