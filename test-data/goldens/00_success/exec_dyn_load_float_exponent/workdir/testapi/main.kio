/// Loads an emitted Prime image and observes its numeric literal boundary.
module testapi/main;

import eval(prime_apply, prime_eval);
import host_descriptor(Host_type, host_id_local, host_id_module, host_type_id);
import hostrec(make_lit_default, serve_default, test_bool_default);
import imageio(read_image_stdin);
import loader(Image, Lr_diag, Lr_image);
import loader(diag_message, export_term, un_load_outcome);
import loader/scan(load_package);
import macros/control(macro if);
import macros/match(macro match);
import macros/spine_macros(macro widen_sum);
import prime(Term);
import result(Ev_done, Ev_stuck);
import testapi(Bool, F64, Scalar, String);
import testapi/arith(add_f64, sub_f64);
import testapi/fmt(f64_to_string);
import testapi/io(print);
import testapi/scalar(make_scalar, scalar_as_f64);
import testapi/text(string_concat, string_eq);
import value(Value, value_to_scalar, vhost, vunit);

// The host deliberately carries guest F32 values in its existing F64 scalar.
// The compiler-selected F32 value is exactly representable in that carrier.
fn make_literal(text: String, typ: Host_type) -> Value {
  let id = host_type_id(typ);
  if(string_eq(host_id_module(id), "hostapi")) {
    if(string_eq(host_id_local(id), "F32")) {
      vhost(make_scalar(text, "F64"))
    } else {
      make_lit_default(text, typ)
    }
  } else {
    make_lit_default(text, typ)
  }
}

// Observe the serialized payload, then forward those same bytes to the host.
// This checks the loader boundary's zero sign without claiming that decimal
// formatting observes the sign of the subsequently constructed host value.
fn observe_literal(text: String, typ: Host_type) -> Value {
  print("payload = ");
  print(text);
  print("\n");
  make_literal(text, typ)
}

fn call_export(im: Image, name: String, make_lit: (String & Host_type) -> Value) -> . | Value {
  match(export_term(im, name)) {
    (
    , .(t: Term) {
        match(prime_eval(serve_default, make_lit, test_bool_default, t)) {
          (
          , .(v: Ev_done) {
              match(prime_apply(serve_default, make_lit, test_bool_default, Ev_done.get(v), vunit())) {
                (
                , .(result: Ev_done) { widen_sum(Ev_done.get(result), . | Value) }
                , .(_stuck: Ev_stuck) { widen_sum((), . | Value) }
                )
              }
            }
          , .(_stuck: Ev_stuck) { widen_sum((), . | Value) }
          )
        }
      }
    , .(_absent: .) { widen_sum((), . | Value) }
    )
  }
}

fn difference(label: String, result: . | Value, expected: F64) {
  print(label);
  match(result) {
    (
    , .(v: Value) {
        match(value_to_scalar(v)) {
          (
          , .(s: Scalar) {
              match(scalar_as_f64(s)) {
                (
                , .(actual: F64) {
                    print(f64_to_string(add_f64(sub_f64(actual, expected), 0.0(F64))))
                  }
                , .(_no: .) { print("<not an f64>") }
                )
              }
            }
          , .(_no: .) { print("<not a scalar>") }
          )
        }
      }
    , .(_error: .) { print("<error>") }
    )
  };
  print("\n")
}

pub fn main() {
  match(un_load_outcome(load_package(read_image_stdin()))) {
    (
    , .(loaded: Lr_image) {
        let im = Lr_image.get(loaded);
        difference("emitted exponent = ", call_export(im, "tiny", make_literal), 250.0015(F64));
        difference("raw exponent = ", call_export(im, "lexical", make_literal), 250.0015(F64));
        difference(
        , "f32 tenth = "
        , call_export(im, "tenth", make_literal)
        , 0.100000001490116119384765625(F64)
        );
        difference(
        , "f32 above midpoint = "
        , call_export(im, "above", make_literal)
        , 1.00000011920928955078125(F64)
        );
        difference(
        , "f32 subnormal = "
        , call_export(im, "subnormal", make_literal)
        , 1.4012984643248170709237295832899161312802619418765e-45(F64)
        );
        difference(
        , "f32 negative zero = "
        , call_export(im, "negative_zero", observe_literal)
        , 0.0(F64)
        );
        difference(
        , "f32 negative underflow = "
        , call_export(im, "negative_underflow", observe_literal)
        , 0.0(F64)
        );
        difference(
        , "f32 positive underflow = "
        , call_export(im, "positive_underflow", observe_literal)
        , 0.0(F64)
        );
        difference(
        , "f64 negative underflow = "
        , call_export(im, "negative_underflow64", observe_literal)
        , 0.0(F64)
        )
      }
    , .(d: Lr_diag) {
        print(string_concat("load failed: ", string_concat(diag_message(Lr_diag.get(d)), "\n")))
      }
    )
  }
}
