mod testapi/main;

import testapi { type String }
import testapi/io { fn print }
import testapi/types { type Unit_alias }

fn tick(message: String) -> Unit_alias { print(message); () }

pub fn main() {
  tick("checked\n");
  let inferred = .() { tick("synthesized\n"); () };
  inferred();
  print("unit alias statements preserved\n")
}
