module testapi/main;

import loader(
, Import
, Lr_diag
, Lr_image
, import_is_default
, import_source
, mk_import
, mk_import_as
, mk_import_selected
, un_import
, un_load_outcome
, {import}
);
import loader/scan(load_package);
import macros/control(macro if);
import macros/match(macro match);
import testapi(String, default Bool);
import testapi/io(print);

fn show(entry: Import) {
  match(un_import(entry)) {
    .(local: String, provider: String) {
      print(local);
      print(":"(String));
      print(import_source(entry));
      print("@"(String));
      print(provider);
      if(import_is_default(entry)) {
        print(":selected"(String))
      } else {
        print(":unselected"(String))
      };
      print("\n"(String))
    }
  }
}

fn load_result(source: String) {
  match(un_load_outcome(load_package(source))) {
    (
    , .(_loaded: Lr_image) { print("ok\n"(String)) }
    , .(_diagnostic: Lr_diag) { print("rejected\n"(String)) }
    )
  }
}

pub fn main() {
  show(mk_import("same"(String), "origin"(String)));
  show(mk_import_as("local"(String), "source"(String), "origin"(String)));
  show(mk_import_selected("Selected"(String), "Number"(String), "origin"(String), .t(Bool)));
  let raw = {import = ("raw"(String), "source"(String), "origin"(String), .t(Bool))};
  show(raw);
  match(Import.get(raw)) {
    .(local: String, original: String, provider: String, selected: Bool) {
      print(local);
      print("\n"(String));
      print(original);
      print("\n"(String));
      print(provider);
      print("\n"(String));
      if(selected) { print("selected\n"(String)) } else { print("unselected\n"(String)) }
    }
  };
  load_result("module origin; pub fn source() { () } module consumer; import "
              "origin(source as first, source as second); pub fn run() { first(); "
              "second() } package guest; bridge { consumer; }"(String));
  load_result("module origin; pub fn op() { () } pub fn source() { () } module "
              "consumer; import origin(op as local, source as op); pub fn run() { "
              "local(); op() } package guest; bridge { consumer; }"(String));
  load_result("module origin; pub fn source() { () } module consumer; import "
              "origin(source as local, source as local); pub fn run() { local() } "
              "package guest; bridge { consumer; }"(String));
  load_result("module origin; fn hidden() { () } pub fn local() { () } module consumer; "
              "import origin(hidden as local); pub fn run() { local() } package guest; "
              "bridge { consumer; }"(String));
  load_result("module origin; pub fn local() { () } module consumer; import "
              "origin(missing as local); pub fn run() { local() } package guest; bridge "
              "{ consumer; }"(String))
}
