mod testapi/main;

import loader {
  type Import;
  type Lr_diag;
  type Lr_image;
  fn import_source;
  fn mk_import;
  fn mk_import_as;
  fn un_import;
  fn un_load_outcome
}
import loader/scan { fn load_package }
import macros/match { macro match }
import testapi { type String }
import testapi/io { fn print }

fn show(entry: Import) {
  match(un_import(entry)) {
    .(local: String, provider: String) {
      print(local);
      print(":"[String]);
      print(import_source(entry));
      print("@"[String]);
      print(provider);
      print("\n"[String])
    }
  }
}

fn load_result(source: String) {
  match(un_load_outcome(load_package(source))) {
    (
    , .(_loaded: Lr_image) { print("ok\n"[String]) }
    , .(_diagnostic: Lr_diag) { print("rejected\n"[String]) }
    )
  }
}

pub fn main() {
  show(mk_import("same"[String], "origin"[String]));
  show(mk_import_as("local"[String], "source"[String], "origin"[String]));
  show(mk_import_as("Selected"[String], "Number"[String], "origin"[String]));
  let raw = Import.mk(("raw"[String], "source"[String], "origin"[String]));
  show(raw);
  match(Import.get(raw)) {
    .(local: String, original: String, provider: String) {
      print(local);
      print("\n"[String]);
      print(original);
      print("\n"[String]);
      print(provider);
      print("\n"[String])
    }
  };
  load_result("mod origin; pub fn source() { () } mod consumer; import origin {fn "
              "source as first; fn source as second} pub fn run() { first(); second() } "
              "pkg guest; bridge { consumer; }"[String]);
  load_result("mod origin; pub fn op() { () } pub fn source() { () } mod consumer; "
              "import origin {fn op as local; fn source as op} pub fn run() { local(); "
              "op() } pkg guest; bridge { consumer; }"[String]);
  load_result("mod origin; pub fn source() { () } mod consumer; import origin {fn "
              "source as local; fn source as local} pub fn run() { local() } pkg guest; "
              "bridge { consumer; }"[String]);
  load_result("mod origin; fn hidden() { () } pub fn local() { () } mod consumer; "
              "import origin {fn hidden as local} pub fn run() { local() } pkg guest; "
              "bridge { consumer; }"[String]);
  load_result("mod origin; pub fn local() { () } mod consumer; import origin {fn "
              "missing as local} pub fn run() { local() } pkg guest; bridge { consumer; "
              "}"[String]);
  load_result("mod origin; pub fn default() { () } mod consumer; import origin {fn "
              "default} pub fn run() { default() } pkg guest; bridge { consumer; }"[String]);
  load_result("mod origin; host type Number role(i32); mod consumer; import origin {fn "
              "default Number} pub fn run(value: Number) -> Number { value } pkg guest; "
              "bridge { origin; consumer; }"[String])
}
