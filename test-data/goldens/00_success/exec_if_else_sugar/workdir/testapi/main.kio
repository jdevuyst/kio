mod testapi/main;

import macros/control { macro if }
import testapi { type Bool; type String }
import testapi/io { fn print }

// Surface `if(cond) { a } else { b }`. The condition pins to the
// in-scope `role(bool)` type; both arms are blocks and constrain one
// common result. Bind and discard that result so the fn's `()` return
// type is satisfied.
pub fn main() {
  let _r = if(.t) { print("yes\n") } else { print("no\n") };
  ()
}
