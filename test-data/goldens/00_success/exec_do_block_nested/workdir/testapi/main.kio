module testapi/main;

import macros/sequence(macro do);
import testapi(String);
import testapi/io(print);

pub type { Box[A]: A { pub mk; pub get } }

fn box_pure[A](x: A) -> Box[A] { Box.mk(x) }

fn box_bind[A][B](m: Box[A], k: A -> Box[B]) -> Box[B] { k(Box.get(m)) }

// `inner` produces a `Box(String)` via its own do-block. The
// outer block binds `inner()`'s result and threads it forward.
// Each do-block elaborates independently — there's no shared
// state between them; the inner expression appears as a regular
// monadic value the outer bind step consumes.
fn inner() -> Box[String] {
  do(box_bind) { let s <- box_pure("nested ok\n"[String]); box_pure(s) }
}

fn outer() -> Box[String] {
  do(box_bind) { let s <- inner(); box_pure(s) }
}

pub fn main() { print(Box.get(outer())) }
