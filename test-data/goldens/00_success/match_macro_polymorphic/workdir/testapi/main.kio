mod testapi/main;

import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type I32; type String }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }

// `match` over arms with polymorphic input types: a polymorphic
// newtype `Box[A]` applied to two distinct payloads. Each arm pins a
// concrete instance (`Box(I32)`, `Box(String)`).
type { Box[A]: A { pub mk; pub get } }

fn show_int(b: Box[I32]) -> String { int_to_string(Box.get(b)) }

fn show_str(b: Box[String]) -> String { Box.get(b) }

fn handle(v: Box[I32] | Box[String]) -> String {
  match(v) { (show_int, show_str) }
}

pub fn main() { print(handle(widen_sum(Box.mk("match! polymorphic: ok\n"[String])))) }
