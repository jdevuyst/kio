module testapi/main;

import testapi(I32, String);
import testapi/arith(mul_i32);
import testapi/fmt(i32_to_string);
import testapi/io(print);

// The operator keeps its ordinary meaning inside a placeholder body.
pub op _ ## _ { impl mul_i32 }

fn apply[A][B](f: A -> B, x: A) -> B { f(x) }

pub fn main() -> . {
  let .(f: I32 -> I32) = .x. { x1 ## 100 };
  print(i32_to_string(apply(f, 3)));
  print("\n");
  print(i32_to_string(4 ## 25))
}
