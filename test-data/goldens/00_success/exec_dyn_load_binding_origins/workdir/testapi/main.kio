/// Loads fresh Kio' images with conflicting and repeated binding origins.
mod testapi/main;

import loader {
  type Load_outcome;
  type Lr_diag;
  type Lr_image;
  fn diag_message;
  fn un_load_outcome
}
import loader/scan { fn load_package }
import macros/match { macro match }
import testapi { type String }
import testapi/io { fn print }
import testapi/text { fn string_concat }

fn type_conflict_image() -> String {
  "mod consumer;\n\nimport provider {type T}\n\ntype T = . & .;\n\npub fn run() "
  "-> . { () }\n\npkg type_conflict;\n\nbridge { consumer; provider; }\n\nmod "
  "provider;\n\npub type { T: . { pub mk; pub get; }; };\n"[String]
}

fn type_same_origin_image() -> String {
  "mod repeated;\n\nimport provider {type T}\nimport provider {type T}\n\npub fn "
  "run() -> . { () }\n\npkg type_same_origin;\n\nbridge { repeated; provider; }\n\n"
  "mod provider;\n\npub type { T: . { pub mk; pub get; }; };\n"[String]
}

fn value_conflict_image() -> String {
  "mod value_consumer;\n\nimport p1 {fn f}\nimport p2 {fn f}\n\npub fn broken() "
  "-> . { missing() }\n\npkg value_conflict;\n\nbridge { value_consumer; p1; "
  "p2; }\n\nmod p1;\n\npub fn f() -> . { () }\n\nmod p2;\n\npub fn f() -> . { () }\n"[String]
}

fn value_same_origin_image() -> String {
  "mod value_repeated;\n\nimport provider {fn f}\nimport provider {fn f}\n\npub "
  "fn run() -> . { () }\n\npkg value_same_origin;\n\nbridge { value_repeated; "
  "provider; }\n\nmod provider;\n\npub fn f() -> . { () }\n"[String]
}

fn module_alias_conflict_image() -> String {
  "mod alias_consumer;\n\nimport p1 as q;\nimport p2 as q;\n\npub fn broken() -> "
  ". { missing() }\n\npkg module_alias_conflict;\n\nbridge { alias_consumer; "
  "p1; p2; }\n\nmod p1;\n\npub fn first() -> . { () }\n\nmod p2;\n\npub fn second() "
  "-> . { () }\n"[String]
}

fn module_alias_same_origin_image() -> String {
  "mod alias_repeated;\n\nimport provider as q;\nimport provider as q;\n\npub fn "
  "run() -> . { () }\n\npkg module_alias_same_origin;\n\nbridge { "
  "alias_repeated; provider; }\n\nmod provider;\n\npub fn value() -> . { () }\n"[String]
}

fn type_alias_collision_image() -> String {
  "mod alias_collision;\n\nimport provider {type T}\nimport provider as "
  "source;\n\ntype T = source.T;\n\npub fn run() -> . { () }\n\npkg "
  "alias_collision;\n\nbridge { alias_collision; provider; }\n\nmod provider;\n\n"
  "pub type { T: . { pub mk; pub get; }; };\n"[String]
}

fn ordinary_alias_members_image() -> String {
  "mod alias_members;\n\nimport provider as source;\n\ntype Mid[A] = "
  "source.Box[A];\ntype Alias[A] = Mid[A];\n\npub fn run() -> . { "
  "Alias.get[.](Alias.mk[.](())) }\n\npkg alias_members;\n\nbridge { "
  "alias_members; provider; }\n\nmod provider;\n\npub type { Box[A]: A { pub "
  "mk; pub get; }; };\n"[String]
}

fn repeated_compiler_block_image() -> String {
  "mod blocks;\n\nimport __intrinsics__;\nimport __intrinsics__;\n\npub fn run() "
  "-> . { () }\n\npkg blocks;\n\nbridge { blocks; }\n"[String]
}

fn outcome(label: String, loaded: Load_outcome) -> String {
  match(un_load_outcome(loaded)) {
    (
    , .(_image: Lr_image) { string_concat(label, "loaded\n"[String]) }
    , .(diagnostic: Lr_diag) {
        string_concat(label, string_concat(diag_message(Lr_diag.get(diagnostic)), "\n"[String]))
      }
    )
  }
}

pub fn main() {
  print(outcome("type conflict: "[String], load_package(type_conflict_image())));
  print(outcome("type same origin: "[String], load_package(type_same_origin_image())));
  print(outcome("value conflict: "[String], load_package(value_conflict_image())));
  print(outcome("value same origin: "[String], load_package(value_same_origin_image())));
  print(outcome("module alias conflict: "[String], load_package(module_alias_conflict_image())));
  print(outcome(
  , "module alias same origin: "[String]
  , load_package(module_alias_same_origin_image())
  ));
  print(outcome("type alias collision: "[String], load_package(type_alias_collision_image())));
  print(outcome("ordinary alias members: "[String], load_package(ordinary_alias_members_image())));
  print(outcome("compiler blocks: "[String], load_package(repeated_compiler_block_image())))
}
