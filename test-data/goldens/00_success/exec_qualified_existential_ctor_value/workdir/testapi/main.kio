module testapi/main;

import testapi(String);
import testapi/io(print);
import testapi/types as t;

fn boxer[A](mk: [B] (String & B) -> t.Box, s: String, w: A) -> t.Box { mk((s, w)) }

fn text(box: t.Box) -> String {
  t.Box.get(box)(.[A](s: String, _witness: A) { s })
}

pub fn main() { print(text(boxer(t.Box.mk, "ok\n"[String], ()))) }
