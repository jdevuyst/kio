module testapi/main;

import elab/match(match);
import testapi(String);
import testapi/io(print);

fn identity[A](value: A) -> A { value }

fn classify(value: String) -> String {
  match! identity(value) {
    .[A](_value: A) { "matched path call\n" }
  }
}

pub fn main() -> . { print(classify("ignored")) }
