mod testapi/main;

import testapi { type String }
import testapi/io { fn print }

type { F: String { mk; get }; Item[A]: A { mk; get } }

type Reused = F;

type Choice = { Branch_value: String; Left: . } | (Branch_value & { Right: . });

type Generic[A] = Item[A];

pub fn main() { let a = F.mk("agree\n"); print(F.get(a)) }
