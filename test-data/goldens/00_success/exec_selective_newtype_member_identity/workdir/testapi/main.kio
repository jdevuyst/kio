module testapi/main;

import library/core as lib;
import library/core(Box);
import testapi(String);
import testapi/io as io;

type Text = String;

fn selected(value: Box[Text]) -> Text { Box.get[Text](value) }

fn qualified(value: lib.Box[Text]) -> Text { lib.Box.get[Text](value) }

fn relay[A](value: Box[A]) -> A { Box.get[A](value) }

pub fn main() {
  io.print(selected(Box.mk[Text]("selected\n"[Text])));
  io.print(qualified(lib.Box.mk[Text]("qualified\n"[Text])));
  io.print(relay[Text](Box.mk[Text]("generic\n"[Text])))
}
