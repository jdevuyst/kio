// Package interface: the bridged modules whose host items and pub
// exports form the package boundary.
package fmt_package_file;

build {
  cache "out/.kio-cache/";

  target js {
    out "out/js/";
    baseline es2020
  };

  target ts {
    out "out/ts/";
    baseline v5_0
  }
}

bridge {
  fmt_package_file;
  fmt_package_file/main;
  fmt_package_file/boxlib
}
