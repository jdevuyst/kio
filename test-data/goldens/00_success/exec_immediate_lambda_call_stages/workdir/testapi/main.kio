module testapi/main;

import testapi(I32);
import testapi/fmt(print_i32);

fn connected(known: I32) -> I32 {
  let result = .[A](first: A)(middle)(last: A) -> A { first }(7)(())(known);
  result
}

fn empty_stage(known: I32) -> I32 {
  .[A]()(value) { value }[I32]()(known)
}

pub fn main() { print_i32(connected(1)); print_i32(empty_stage(8)) }
