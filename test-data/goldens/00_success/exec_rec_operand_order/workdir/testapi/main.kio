module testapi/main;

import elab/control(if);
import elab/control(scope);
import testapi(Bool, I32, String);
import testapi/arith(leq_i32);
import testapi/io(print);
import testapi/iter(loop);

pub labels Fields = { first: I32, second: I32 };

pub type Row = First & Second;

pub labels Fn_fields = { transform: I32 -> I32, value: I32 };

pub type Fn_row = Transform & Value;

type Identity[A] = A;

fn mark(tag: String, value: I32) -> I32 { print(tag); value }

fn effectful_identity[A](tag: String) -> A -> A { print(tag); .(value: A) -> A { value } }

fn take_second(first: I32, second: I32) -> I32 { second }

fn ignore_first[A](first: A, second: I32) -> I32 { second }

fn pair_second((first: I32, second: I32)) -> I32 { second }

fn fn_pair_second((transform: I32 -> I32, value: I32)) -> I32 { value }

fn row_second(value: Row) -> I32 { value.?{second} }

fn fn_row_value(row: Fn_row) -> I32 { row.?{value} }

fn apply_i32(f: I32 -> I32, value: I32) -> I32 { f(value) }

fn consume[A](f: A -> A, witness: A, tail: I32) -> I32 { let _ = f(witness); tail }

fn consume_rank_n(f: [T] T -> T, tail: I32) -> I32 { let _ = f(., ()); tail }

fn consume_typed[A](tail: I32) -> I32 { tail }

rec(loop) fn call_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("b", 2)
  } else {
    ignore_first(mark("a", 1), rec(cont) call_order(0))
  }
}

rec(loop) fn tuple_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("d", 4)
  } else {
    pair_second((mark("c", 3), rec(cont) tuple_order(0)))
  }
}

rec(loop) fn label_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("f", 6)
  } else {
    row_second({first = mark("e", 5), second = rec(cont) label_order(0)})
  }
}

rec(loop) fn ufcs_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("h", 8)
  } else {
    mark("g", 7).>take_second(rec(cont) ufcs_order(0))
  }
}

rec(loop) fn inferred_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("j", 10)
  } else {
    apply_i32(effectful_identity("i"), rec(cont) inferred_order(0))
  }
}

rec(loop) fn direct_order(n: I32, f: I32 -> I32) -> I32 {
  if! leq_i32(n, 0) {
    f(mark("l", 12))
  } else {
    rec direct_order(0, effectful_identity("k"))
  }
}

rec(loop) fn callee_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("n", 14)
  } else {
    scope! {
      print("m");
      take_second
    }(0, rec(cont) callee_order(0))
  }
}

rec(loop) fn receiver_last_right_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("p", 16)
  } else {
    rec(cont) receiver_last_right_order(0).>>take_second(mark("o", 15))
  }
}

rec(loop) fn receiver_last_left_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("r", 18)
  } else {
    take_second(mark("q", 17)).<(rec(cont) receiver_last_left_order(0))
  }
}

rec(loop) fn receiver_first_left_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("E", 31)
  } else {
    take_second(mark("F", 32)).<<(rec(cont) receiver_first_left_order(0))
  }
}

rec(loop) fn expected_tuple_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("t", 20)
  } else {
    fn_pair_second((effectful_identity("s"), rec(cont) expected_tuple_order(0)))
  }
}

rec(loop) fn expected_label_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("v", 22)
  } else {
    fn_row_value({transform = effectful_identity("u"), value = rec(cont) expected_label_order(0)})
  }
}

rec(loop) fn nested_carrier_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("y", 25)
  } else {
    take_second(mark("w", 23), take_second(mark("x", 24), rec(cont) nested_carrier_order(0)))
  }
}

rec(loop) fn deferred_call_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("B", 28)
  } else {
    consume(effectful_identity("A"), 0, rec(cont) deferred_call_order(0))
  }
}

rec(loop) fn rank_n_inline_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("C", 29)
  } else {
    consume_rank_n(
      , scope! {
          .[T](value) { value }
        }
      , rec(cont) rank_n_inline_order(0)
      )
  }
}

rec(loop) fn value_shaped_type_arg_order(n: I32) -> I32 {
  if! leq_i32(n, 0) {
    mark("D", 30)
  } else {
    consume_typed(Identity(I32), rec(cont) value_shaped_type_arg_order(0))
  }
}

rec(loop) {
  fn direct_member_order(n: I32, carried: I32) -> I32 {
    if! leq_i32(n, 0) {
      carried
    } else {
      take_second(0, rec(cont) direct_member_order(mark("z", 0), rec(cont) direct_member_leaf(0)))
    }
  };
  fn direct_member_leaf(n: I32) -> I32 { mark("0", 26) }
}

pub fn main() -> . {
  let _ = call_order(1);
  let _ = tuple_order(1);
  let _ = label_order(1);
  let _ = ufcs_order(1);
  let _ = inferred_order(1);
  let _ = direct_order(1, .(value: I32) -> I32 { value });
  let _ = callee_order(1);
  let _ = receiver_last_right_order(1);
  let _ = receiver_last_left_order(1);
  let _ = expected_tuple_order(1);
  let _ = expected_label_order(1);
  let _ = nested_carrier_order(1);
  let _ = deferred_call_order(1);
  let _ = rank_n_inline_order(1);
  let _ = value_shaped_type_arg_order(1);
  let _ = direct_member_order(1, 0);
  let _ = receiver_first_left_order(1);
  print("\n")
}
