mod demo/main;

import demo/a as first;
import demo/a { type Field; type Num; type Original; lit truth; macro build }
import demo/b as second;

fn literal_use() -> Num { truth[Num] }

fn shadow(truth: Num) -> Num { truth }

fn bang() { build(()) }

fn splice() { ().>build }

fn alias_use() -> Original { Field.mk(()) }

fn qualified() -> second.Original { second.Field.mk(()) }

fn value_use() { first.field() }

fn update(row: Original) -> Original { let _ = Field.get(row); Field.mk(()) }

fn access(row: Original) { Field.get(row) }

fn binding(row: Original) { let payload = Field.get(row); payload }
