module demo/main;

import demo/a as first;
import demo/a(Num, Original, build, truth, {field});
import demo/b as second;

fn literal_use() -> Num { truth }

fn shadow(truth: Num) -> Num { truth }

fn bang() -> . { build!(()) }

fn splice() -> . { ().>build! }

fn label_use() -> Original { {field=} }

fn qualified() -> second.Original { {second.field=} }

fn value_use() -> . { first.field() }

fn update(row: Original) -> Original { row.!{field=} }

fn access(row: Original) -> . { row.?{field} }

fn row_let(row: Original) -> . { let .({field as payload}) = row; payload }
