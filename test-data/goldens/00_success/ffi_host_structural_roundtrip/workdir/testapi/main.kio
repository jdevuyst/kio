mod testapi/main;

import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type I32; type String }
import testapi/arith { fn make_pair }
import testapi/fmt { fn i32_to_string; fn sum_to_string }
import testapi/io { fn print }

pub fn main() {
  let pair = make_pair(42, "host-pair"[String]);
  match(pair) {
    .(n: I32, s: String) {
      print(i32_to_string(n));
      print(" "[String]);
      print(s);
      print("\n"[String])
    }
  };
  print(sum_to_string(widen_sum(7[I32])[I32 | String]));
  print("\n"[String]);
  print(sum_to_string(widen_sum("sum-host"[String])[I32 | String]));
  print("\n"[String])
}
