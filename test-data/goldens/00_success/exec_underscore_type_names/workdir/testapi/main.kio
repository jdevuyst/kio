module testapi/main;

import testapi(_String);
import testapi/io(print);

type _Alias = _String;

type Ordinary = _Alias;

pub type { Box[B]: B { pub mk; pub get } }

pub type { _Box[_A]: _A { pub mk; pub get } }

pub fn main() {
  print(_Box.get[Ordinary](_Box.mk[_Alias](Box.get[Ordinary](Box.mk[Ordinary]("underscore type names\n"[Ordinary])))))
}
