mod main;

import provider as source;
import provider { type F64 as Decimal; type I32 as Whole }

host type I32 role(i32);

host type F64 role(f64);

equiv integer_identity() {
  source.integer();
  7[source.I32];
  7[Whole]
}

equiv float_identity() {
  source.float();
  7.0[source.F64];
  7.0[Decimal]
}
