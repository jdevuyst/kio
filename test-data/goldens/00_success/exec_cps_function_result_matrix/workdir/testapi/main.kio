mod testapi/main;

import testapi { type String }
import testapi/io { fn print }
import testapi/remote as remote;

type { Pack <U>: U { mk; get } }

fn pack() -> Pack { Pack.mk(()) }

fn module_thunk() { print("module\n") }

fn direct() {
  Pack.get(pack())[. -> .](.[U](_value: U) {
    .() { print("direct\n") }
  })()
}

fn sequenced() {
  Pack.get(pack())[. -> .](.[U](_value: U) {
    print("seq-prefix\n");
    .() { print("seq-tail\n") }
  })()
}

fn named_module_result() {
  Pack.get(pack())[. -> .](.[U](_value: U) { module_thunk })()
}

fn named_host_result() {
  Pack.get(pack())[String -> .](.[U](_value: U) { print })("host\n")
}

fn qualified() {
  remote.Pack.get(remote.pack())[. -> .](.[U](_value: U) {
    .() { print("qualified\n") }
  })()
}

pub fn main() { direct(); sequenced(); named_module_result(); named_host_result(); qualified() }
