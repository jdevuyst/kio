module testapi/main;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(Bool, I32, String);
import testapi/arith(add_i32, lt_i32, sub_i32);
import testapi/fmt(int_to_string);
import testapi/io(print);
import testapi/iter(loop);

// A cons-list and a `loop`-driven `drop` whose step nests several
// guarded match/if levels inside one expression. This is a torture test for the
// kio-prime pretty-printer: the generated Kio' term is a tower of
// nested `__pair__` / `__left__` / `__if_then_else__` calls over
// the recursive `List` type, and each `&`/`|` chain and call-argument
// list is itself nested. A pretty-printer that materializes the flat
// and broken layout of every chain / comma-list as two *separate*
// subtrees builds a `Doc` tree exponential in this nesting depth, so
// `kio build` (which prints the typed module for the enriched-IR cache
// key) consumes unbounded memory and time even though the *rendered*
// output is small. With each item placed once and the per-group
// flat-width memoized, the render is linear; this golden builds in a
// fraction of a second.
//
// The nesting here is deliberately unidiomatic — a real library would
// factor each coercion into its own .(which also reads better, see
// `test-data/poc/list/`). The point is that the compiler must stay
// bounded on the un-factored shape too: a user is free to write it, and
// the spec admits it.
rec newtype List[A] : . | (A & List(A)) { pub constructor mk_cell; pub projector un_list }

fn nil[A]() -> List(A) { List.mk_cell(widen_sum!((), . | (A & List(A)))) }

fn cons[A](head: A, tail: List(A)) -> List(A) {
  List.mk_cell(widen_sum!((head, tail), . | (A & List(A))))
}

fn uncons[A](xs: List(A)) -> . | (A & List(A)) { List.un_list(xs) }

// `drop3(n, xs)` drops the first `n` elements. The loop step nests
// three decision levels: an outer guard `n > 0`, a middle guard `n > 1`,
// and the innermost spine `uncons`.
fn drop3[A](n: I32, xs: List(A)) -> List(A) {
  loop(
    , I32 & List(A)
    , List(A)
    , .(state: I32 & List(A)) -> (I32 & List(A)) | List(A) {
        match! state {
          .(k: I32, rest: List(A)) {
            if! lt_i32(0, k) {
              if! lt_i32(1, k) {
                match! uncons(rest) {
                  (
                    , .(pair: A & List(A)) {
                        match! pair {
                          .(_h: A, tl: List(A)) {
                            widen_sum!((sub_i32(k, 1), tl), (I32 & List(A)) | List(A))
                          }
                        }
                      }
                    , .(_e: .) { widen_sum!(nil(A, ()), (I32 & List(A)) | List(A)) }
                    )
                }
              } else match! uncons(rest) {
                (
                  , .(pair: A & List(A)) {
                      match! pair {
                        .(_h: A, tl: List(A)) {
                          widen_sum!((sub_i32(k, 1), tl), (I32 & List(A)) | List(A))
                        }
                      }
                    }
                  , .(_e: .) { widen_sum!(nil(A, ()), (I32 & List(A)) | List(A)) }
                  )
              }
            } else {
              widen_sum!(rest, (I32 & List(A)) | List(A))
            }
          }
        }
      }
    , (n, xs)
    )
}

// `length(xs)` counts the spine via a `loop`. State is `count & rest`;
// each step uncons-es one cell or stops.
fn length[A](xs: List(A)) -> I32 {
  loop(
    , I32 & List(A)
    , I32
    , .(state: I32 & List(A)) -> (I32 & List(A)) | I32 {
        match! state {
          .(acc: I32, rest: List(A)) {
            match! uncons(rest) {
              (
                , .(pair: A & List(A)) {
                    match! pair {
                      .(_h: A, tl: List(A)) {
                        widen_sum!((add_i32(acc, 1), tl), (I32 & List(A)) | I32)
                      }
                    }
                  }
                , .(_e: .) { widen_sum!(acc, (I32 & List(A)) | I32) }
                )
            }
          }
        }
      }
    , (0, xs)
    )
}

fn demo() -> List(I32) { cons(1, cons(2, cons(3, cons(4, cons(5, nil(I32, ())))))) }

pub fn main() -> . {
  let xs = demo();
  print(int_to_string(length(xs)));
  print("\n");
  print(int_to_string(length(drop3(2, xs))));
  print("\n")
}
