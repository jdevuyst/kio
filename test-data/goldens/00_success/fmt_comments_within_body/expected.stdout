mod main;

import macros/match { macro match }
import macros/row_macros { macro record_ }

fn f(x: I32) -> I32 {
  // before let
  let y =
    // between = and value
    x;
  // before body (let body that isn't another let)
  match(y) {
    .() {
      // inside case body
      x
    }
  }
}

fn g(z: I32) -> I32 {
  let w =
    f(
    // before first arg
    , z
    // before second arg (a literal)
    , 0
    );
  w
}

fn id[A](x: A) -> A { x }

fn h() -> I32 {
  id[
    // before the type arg
    I32
  ](
  // before the value arg
  , 1
  )
}

type Show = { F: I32; G: I32 };

fn k() -> I32 & I32 {
  let pair =
    (
    // first tuple element
    , 1
    // second tuple element
    , 2
    );
  let _tagged =
    record_ {
      // before label f
      F.mk(1);
      // before label g
      G.mk(2)
    };
  pair
}

type { Box[A][B]: A & B { mk; get } }

fn type_arg_comments() {
  let _ =
    Box.mk[
      // type arg a
      I32
    ][
      // type arg b
      String
    ](1, "");
  ()
}

type Sigil =
  (
    // label f
    & F
    // label g
    & G
    )
  ;
