module testapi/main;

import macros/row_macros(macro select);
import macros/sequence(macro do);
import testapi(String);
import testapi/io as io;
import testapi/text as text;

type { Left: String { mk; get }; Right: String { mk; get } }

type { Box[A]: A { mk; get } }

type { Pack <U>: (U -> String) & U { mk; get } }

fn pure[A](value: A) -> Box[A] { Box.mk(value) }

fn bind[A][B](value: Box[A], next: A -> Box[B]) -> Box[B] { next(Box.get(value)) }

fn ordinary() -> String {
  let _ = "discard"[String];
  let .(typed: String) = "typed:";
  let .(whole: (first: String, second: String)) = ("a", "b");
  let .(again, last) = whole;
  text.string_concat(
  , typed
  , text.string_concat(first, text.string_concat(second, text.string_concat(again, last)))
  )
}

fn rows() -> String {
  let .(payload, right) = (Left.mk("row"), Right.mk("!")).>select { Left.get; Right.get };
  text.string_concat(payload, right)
}

fn existential() -> String {
  let .(<Hidden> payload) = Pack.get(Pack.mk(.(value: String) { value }, "packed"));
  let .(show, value) = payload;
  show(value)
}

fn monadic() -> String {
  let result =
    do(bind) {
      let .(prefix: String) <- pure("do");
      let .(whole: (middle: String, suffix: String)) = ("=", "bind");
      let .(again, last) <- pure(whole);
      pure(text.string_concat(
      , prefix
      , text.string_concat(middle, text.string_concat(suffix, text.string_concat(again, last)))
      ))
    };
  Box.get(result)
}

pub fn main() {
  io.print(ordinary());
  io.print("\n");
  io.print(rows());
  io.print("\n");
  io.print(existential());
  io.print("\n");
  io.print(monadic());
  io.print("\n")
}
