module testapi/main;

import testapi(String);
import testapi/io(print);

fn id[A](x: A) -> A { x }

fn shout(s: String) -> String { s }

// Basic UFCS dispatch over a non-compound receiver: the receiver's
// only "conjunct" is itself, the callee's first parameter unifies
// with that, and the elaborated call is `shout[receiver]`.
pub fn main() -> . { let s = "hello\n"; let s2 = s.>shout; print(s2) }
