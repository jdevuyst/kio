mod testapi/main;

import testapi { type Bool; type String }
import testapi/fmt { fn bool_to_string }
import testapi/io { fn print }

type { Boolbox: Bool { pub mk; pub get } }

fn box_bool(value: Bool) -> Boolbox { Boolbox.mk(value) }

fn make_boxer() -> Bool -> Boolbox { box_bool }

pub fn main() {
  let boxed = make_boxer()(.t);
  print(bool_to_string(Boolbox.get(boxed)));
  print("\n"[String])
}
