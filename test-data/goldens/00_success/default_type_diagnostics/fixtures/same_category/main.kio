module main;

default host type Int role(i64);

default host type Float role(f64);

pure fn same[A](left: A, right: A) -> A { left }

pure fn integers() -> Int { let value = same(42, 43); value }

pure fn floats() -> Float { let value = same(42.0, 43.0); value }

equiv ints_selected() {
  integers();
  42(Int)
}

equiv floats_selected() {
  floats();
  42.0(Float)
}
