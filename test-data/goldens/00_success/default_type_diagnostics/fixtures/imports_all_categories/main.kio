module main;

import numbers(default Bool, default Float, default Int, default String);

pure fn integer() -> Int { let value = 42; value }

pure fn float() -> Float { let value = 42.0; value }

pure fn flag() -> Bool { let value = .t; value }

pure fn text() -> String { let value = "imported"; value }

equiv int_selected() {
  integer();
  42(Int)
}

equiv float_selected() {
  float();
  42.0(Float)
}

equiv bool_selected() {
  flag();
  .t(Bool)
}

equiv string_selected() {
  text();
  "imported"(String)
}
