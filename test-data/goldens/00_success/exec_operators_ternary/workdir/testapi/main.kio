mod testapi/main;

import testapi { type I32 }
import testapi/arith { fn add_i32 }
import testapi/fmt { fn i32_to_string }
import testapi/io { fn print }

fn cond(p: I32, t: I32, e: I32) -> I32 { add_i32(p, add_i32(t, e)) }

// Right-associative ternary: `a ? b : c ? d : e` parses as
// `cond(a, b, cond(c, d, e))`.
op _ ? _ : __ { impl cond }

pub fn main() { let n = 1 ? 2 : 3 ? 4 : 5; print(i32_to_string(n)) }
