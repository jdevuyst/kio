module testapi/main;

import elab/control(if);
import shadow_elaborators(invoke);
import testapi(Bool, I32, String);
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter as iter;

rec(iter.loop_reentry) fn changed[A](value: A, remaining: I32) -> A {
  if! arith.leq_i32(remaining, 0) {
    value
  } else {
    let callback = .[A](inner: A) -> A { recur(poly, escape) changed(A, inner, 0) };
    io.print(fmt.i32_to_string(callback(I32, 7)));
    io.print("\n");
    value
  }
}

rec(iter.loop_reentry) fn captured[A](value: A, remaining: I32, observe: A -> .) -> A {
  if! arith.leq_i32(remaining, 0) {
    value
  } else {
    let callback = .[A](_inner: A) -> . { observe(recur(escape) captured(value, 0, observe)) };
    callback(I32, 9);
    value
  }
}

rec(iter.loop) fn structural[A](value: A, remaining: I32) -> I32 {
  if! arith.leq_i32(remaining, 0) {
    53
  } else {
    invoke!(.[A](inner: A) { recur(poly) structural(A, inner, arith.sub_i32(remaining, 1)) })
  }
}

pub fn main() {
  io.print(changed("outer\n", 1));
  io.print(captured("retained\n", 1, io.print));
  io.print(fmt.i32_to_string(structural("unused", 2)));
  io.print("\n")
}
