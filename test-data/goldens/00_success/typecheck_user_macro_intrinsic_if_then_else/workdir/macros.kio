module macros;

import __intrinsics__;

import __comptime__;

pub pure fn choose_impl(
, ct: __Comptime__
, _source: __Type__
, value: __Checked_term__
, target: __Type__
) -> __Checked_term__ {
  __intrinsic_if_then_else__(
  , ct
  , target
  , value
  , .() -> __Checked_term__ { value }
  , .() -> __Checked_term__ { value }
  )
}

pub macro bool_if : [Source] Source -> [Target] Target { impl choose_impl }
