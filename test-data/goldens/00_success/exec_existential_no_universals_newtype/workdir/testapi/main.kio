module testapi/main;

import testapi(String);
import testapi/io(print);

// Both hidden types are inferred at construction and rebound independently
// when the projector invokes its continuation.
type { Box <A> <B>: A & B { pub mk; pub get } }

fn make_box[A][B](x: A, y: B) -> Box { Box.mk[A][B]((x, y)) }

fn open_box(box: Box) {
  Box.get(box)(.[A][B](_pair: A & B) -> . { print("existential-no-universals-ok\n") })
}

pub fn main() { open_box(make_box[.][.]((), ())) }
