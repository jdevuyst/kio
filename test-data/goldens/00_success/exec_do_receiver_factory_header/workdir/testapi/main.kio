mod testapi/main;

import macros/sequence { macro do }
import testapi/io as io;

type { Box[A]: A { mk; get } }

fn bind[A][B](value: Box[A], next: A -> Box[B]) -> Box[B] { next(Box.get(value)) }

fn make_bind[*M](operation: [A][B] (M[A] & (A -> M[B])) -> M[B]) -> [A][B] (M[A] & (A -> M[B])) -> M[B] {
  operation
}

pub fn main() {
  let explicit = do(make_bind[Box](bind)) { let value <- Box.mk(()); Box.mk(value) };
  Box.get(explicit);
  io.print("explicit\n");
  let inferred = do(make_bind(bind)) { let value <- Box.mk(()); Box.mk(value) };
  Box.get(inferred);
  io.print("inferred\n")
}
