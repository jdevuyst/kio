module testapi/main;

import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(String);
import testapi/io(print);

fn apply[A](f: . -> A) -> A { f(()) }

fn classify(source: String | .) -> String {
  let inferred =
    apply(.(_unit: .) {
      match! source {
        (.(text: String) { text }, .(_empty: .) { "unit\n" })
      }
    });
  inferred
}

pub fn main() -> . {
  print(classify(widen_sum!("text\n", String | .)));
  print(classify(widen_sum!((), String | .)))
}
