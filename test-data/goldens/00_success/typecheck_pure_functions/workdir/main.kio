module main;

import __intrinsics__;

pub type Unit_alias = .;

pub type Unit_label = { Unit: . };

pub type { Box[A]: A { pub mk; pub get } }

pub pure fn empty() { () }

pub pure fn append(_head: ., _tail: .) { () }

pub op _ + _ { impl append }

pub varop [* *] { foldr append empty }

pub pure fn id[A](value: A) -> A { value }

pub pure fn wrap[A](value: A) -> Box[A] { Box.mk[A](value) }

fn impure_use() { id(()) }
