module testapi/main;

import macros/row_macros(macro with);
import testapi(String);
import testapi/io(print);

type { A: String { mk; get } }

type { B: String { mk; get } }

type { C: . { mk; get } }

fn updated() -> C & A & B {
  with(((A.mk("a:"), B.mk("b\n")), C.mk(()))) { C.mk(()) }
}

pub fn main() { let .(_c, a, b) = updated(); print(A.get(a)); print(B.get(b)) }
