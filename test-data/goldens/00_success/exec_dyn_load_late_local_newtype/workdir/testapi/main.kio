/// Rejects raw images whose earlier declarations refer to a later local newtype.
mod testapi/main;

import loader { fn diag_message; fn un_load_outcome }
import loader { type Load_outcome; type Lr_diag; type Lr_image }
import loader/scan { fn load_package }
import macros/match { macro match }
import testapi { type String }
import testapi/io { fn print }
import testapi/text { fn string_concat }

fn describe(outcome: Load_outcome) -> String {
  match(un_load_outcome(outcome)) {
    (
    , .(_loaded: Lr_image) { "(loaded)"[String] }
    , .(rejected: Lr_diag) { diag_message(Lr_diag.get(rejected)) }
    )
  }
}

fn line(label: String, source: String) -> String {
  string_concat(label, string_concat(describe(load_package(source)), "\n"[String]))
}

pub fn main() {
  print(line(
  , "host fn before newtype: "[String]
  , "mod guest;\nhost fn consume(value: Later) -> .;\npub type { Later: . { pub "
    "mk; pub get; }; };\npkg guest;\nbridge { guest; }\n"[String]
  ));
  print(line(
  , "alias before newtype: "[String]
  , "mod guest;\npub type Before = Later;\npub fn expose(value: Before) -> "
    "Before { value }\npub type { Later: . { pub mk; pub get; }; };\npkg guest;\n"
    "bridge { guest; }\n"[String]
  ));
  print(line(
  , "self-recursive newtype: "[String]
  , "mod guest;\npub rec type { Loop: . | Loop { pub mk; pub get; }; };\npkg "
    "guest;\nbridge { guest; }\n"[String]
  ));
  print(line(
  , "mutually recursive newtypes: "[String]
  , "mod guest;\nrec {\npub type { First: Second { pub mk; pub get; }; };\npub "
    "type { Second: . | First { pub mk; pub get; }; };\n}\npkg guest;\nbridge { "
    "guest; }\n"[String]
  ));
  print(line(
  , "later provider newtype: "[String]
  , "mod guest;\nimport provider {type Later}\nimport provider as p;\npub fn "
    "selective(value: Later) -> Later { value }\npub fn qualified(value: "
    "p.Later) -> p.Later { value }\nmod provider;\npub type { Later: . { pub "
    "mk; pub get; }; };\npkg guest;\nbridge { guest; provider; }\n"[String]
  ))
}
