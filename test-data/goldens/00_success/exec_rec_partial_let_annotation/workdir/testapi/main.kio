module testapi/main;

import elab/control(if);
import testapi(Bool, I32, String);
import testapi/arith(leq_i32);
import testapi/fmt(i32_to_string);
import testapi/io(print);
import testapi/iter(loop);

newtype Box[A] : A { constructor mk_box; projector un_box }

fn choose_box[A](tag: I32, value: Box(A)) -> Box(A) { value }

rec(loop) fn direct_partial(n: I32) -> Box(I32) {
  if! leq_i32(n, 0) {
    Box.mk_box(10)
  } else {
    let .(box: Box(_)) = rec(cont) direct_partial(0);
    box
  }
}

rec(loop) fn nested_partial(n: I32) -> Box(I32) {
  if! leq_i32(n, 0) {
    Box.mk_box(20)
  } else {
    let .(box: Box(_)) = choose_box(0, rec(cont) nested_partial(0));
    box
  }
}

pub fn main() -> . {
  print(i32_to_string(Box.un_box(direct_partial(1))));
  print(",");
  print(i32_to_string(Box.un_box(nested_partial(1))));
  print("\n")
}
