mod testapi/main;

import __intrinsics__;

import testapi { type String }
import testapi/io { fn print }

type Choice = { Ok: String } | { Err: String; Code: String };

fn make_ok() -> Choice { __left__[Ok][Err & Code](Ok.mk("ok\n")) }

fn make_err() -> Choice { __right__[Ok][Err & Code]((Err.mk("bad"), Code.mk("code\n"))) }

pub fn main() { let _ok = make_ok(); let _err = make_err(); print("ok\n"); print("code\n") }
