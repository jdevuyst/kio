import widget/macros/row_macros { macro select }

pub type String = _rehost_hegfhdhegbhagj.String;

pub type Item[A] = _rehost_gdgphcgfcphdhegphcgf.Item[A];

pub type Pack[A] = _rehost_gdgphcgfcphdhegphcgf.Pack[A];

pub type Family[A] = Item[A] & Pack[A];

pub type Later[A] = Item[A] & Pack[A];

pub fn family_item[A](row: Family[A]) -> A {
