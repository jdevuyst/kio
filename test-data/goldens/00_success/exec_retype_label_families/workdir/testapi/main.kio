mod testapi/main;

import core/store as target;
import testapi { type String }
import testapi/io { fn print }
import widget/store as source;

fn read_item[A](value: target.Item[A]) -> A { value.>target.Item.get }

fn inspect_packet(value: target.Pack[String]) {
  target.Pack.get(value)(.[U](prefix: String, payload: U, format: U -> String) {
    print(prefix);
    print(format(payload))
  })
}

pub fn main() {
  print(read_item(source.Item.mk("generic-string\n")));
  read_item(source.Item.mk(()));
  print("generic-unit\n");
  print(source.Item.get(target.Item.mk("target-constructor\n"[String])));
  let first =
    source.Pack.mk(("existential-string: "[String], "payload\n", .(text: String) { text }));
  let second = source.Pack.mk(("existential-unit: "[String], (), .(_unit: .) { "unit\n" }));
  inspect_packet(first);
  inspect_packet(second);
  print(source.family_item((source.Item.mk("named-family\n"), first)));
  print(source.later_item((source.Item.mk("later-family\n"), second)));
  source.later_item((source.Item.mk(()), source.Pack.mk(((), (), .(_unit: .) { "unused" }))));
  print("later-unit\n")
}
