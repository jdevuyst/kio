mod store;

import macros/row_macros { macro select }

host type String role(str);

pub type { Item[A]: A { pub mk; pub get }; Pack[A] <U>: A & U & (U -> String) { pub mk; pub get } }

pub type Family[A] = Item[A] & Pack[A];

pub type Later[A] = Item[A] & Pack[A];

pub fn family_item[A](row: Family[A]) -> A {
  row.>select { Item.get[A] }
}

pub fn later_item[A](row: Later[A]) -> A {
  row.>select { Item.get[A] }
}
