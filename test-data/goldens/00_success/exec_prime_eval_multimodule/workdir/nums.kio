/// A library module: a monomorphic newtype counter, its pub-fn operations.
module nums;

import testapi(I32);
import testapi/arith(add_i32, mul_i32);

/// A counter — a monomorphic newtype over a host i32.
pub newtype Counter : I32 { constructor mk; projector un }

pub fn start() -> Counter { Counter.mk(0) }

pub fn bump(c: Counter) -> Counter { Counter.mk(add_i32(Counter.un(c), 1)) }

pub fn scale(c: Counter, k: I32) -> Counter { Counter.mk(mul_i32(Counter.un(c), k)) }

pub fn value(c: Counter) -> I32 { Counter.un(c) }
