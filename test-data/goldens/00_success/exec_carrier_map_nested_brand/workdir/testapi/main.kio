module testapi/main;

import elab/match(match);
// Exercises a host `loop` whose STATE is a nested higher-kinded
// carrier: `Box(I32, I32)` is a label-newtype wrapping an ALIAS
// `Trail(k, v)` over a 2-type-parameter RECURSIVE newtype `Crumbs(k, v)`
// whose node is a SUM of two label-generated products (`left` / `right`),
// each mentioning both params. Threading that state through `loop`
// drives a carrier whose payload is an alias-wrapped recursive
// sum-of-products mentioning both binders — the combination (recursion +
// alias indirection + structured sum payload) that an erased carrier
// must round-trip transparently across the loop.
import elab/spine_elaborators(widen_sum);
import testapi(I32);
import testapi/fmt(int_to_string);
import testapi/io(print);
import testapi/iter(loop);

// `Crumbs(k, v)` is a 2-type-param recursive newtype whose node is a
// SUM of two label-generated products (`left` / `right`), each
// mentioning both params.
labels { left[K][V]: K & V, right[K][V]: K & V };

rec labels { crumbs[K][V]: . | ((Left(K, V) | Right(K, V)) & Crumbs(K, V)) };

// `Box(k, v)` wraps an ALIAS `Trail(k, v)` over the recursive newtype —
// the alias indirection means the carrier's payload must be unfolded
// before its shape is visible.
type Trail[K][V] = Crumbs(K, V);

labels { box[K][V]: Trail(K, V) };

fn nil_c[K][V]() -> Crumbs(K, V) {
  {crumbs = widen_sum!((), . | ((Left(K, V) | Right(K, V)) & Crumbs(K, V)))}
}

fn cons_l[K][V](key: K, val: V, t: Crumbs(K, V)) -> Crumbs(K, V) {
  {crumbs = widen_sum!(
    , (widen_sum!({left = (key, val)}, Left(K, V) | Right(K, V)), t)
    , . | ((Left(K, V) | Right(K, V)) & Crumbs(K, V))
    )}
}

fn boxed[K][V](t: Trail(K, V)) -> Box(K, V) { {box = t} }

// A loop whose STATE is `Box(I32, I32)` — threads the alias-wrapped
// recursive sum-of-products carrier through the loop body.
fn head_key(b: Box(I32, I32)) -> I32 {
  loop(
    , .(cur: Box(I32, I32)) -> Box(I32, I32) | I32 {
        match! Crumbs.get(I32, I32, Box.get(I32, I32, cur)) {
          (
            , .(cell: (Left(I32, I32) | Right(I32, I32)) & Crumbs(I32, I32)) {
                match! cell {
                  .(arm: Left(I32, I32) | Right(I32, I32), _rest: Crumbs(I32, I32)) {
                    match! arm {
                      (
                        , .(l: Left(I32, I32)) {
                            match! Left.get(I32, I32, l) {
                              .(k: I32, _v: I32) { widen_sum!(k, Box(I32, I32) | I32) }
                            }
                          }
                        , .(r: Right(I32, I32)) {
                            match! Right.get(I32, I32, r) {
                              .(k: I32, _v: I32) { widen_sum!(k, Box(I32, I32) | I32) }
                            }
                          }
                        )
                    }
                  }
                }
              }
            , .(_empty: .) { widen_sum!(0, Box(I32, I32) | I32) }
            )
        }
      }
    , b
    )
}

pub fn main() -> . { print(int_to_string(head_key(boxed(cons_l(7, 70, nil_c(I32, I32, ())))))) }
