package pkg;

build {
  docs {
    md "docs";
    md_out ();
    html "out/docs/"
  };

  target js {
    out "out/js/";
    baseline es2020
  };

  target ts {
    out "out/ts/";
    baseline v5_0;
    namespace "pinned"
  };

  target go {
    out "out/go/";
    baseline v1_26
  };

  target python {
    out "out/python/";
    baseline v3_10
  };

  target java {
    out "out/java/";
    baseline v21
  };

  target swift {
    out "out/swift/";
    baseline v6_0
  };

  target haskell {
    out "out/haskell/";
    baseline ghc9_10
  };

  // target name
  target (rust, "native") {
    // output

    // output end
    out "out/rust/";
    baseline v1_85;
    namespace ();
    thread_safety send_sync
  };

  target kio-prime {
    out "out/prime/"
  }
}
