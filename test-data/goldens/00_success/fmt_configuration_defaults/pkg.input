package pkg;
build {
  docs { md (("do" "cs")); md_out ((())); html "out/docs/" };
  target js { out ("out/js/") };
  target ts { out "out/ts/"; namespace "pinned" };
  target go { out "out/go/" };
  target python { out "out/python/" };
  target java { out "out/java/" };
  target swift { out "out/swift/" };
  target haskell { out "out/haskell/" };
  target (rust, // target name
    (("native"))) { out ( // output
      "out/rust/" // output end
    ); namespace ((())); thread_safety ((send_sync)) };
  target kio-prime { out "out/prime/" }
}
