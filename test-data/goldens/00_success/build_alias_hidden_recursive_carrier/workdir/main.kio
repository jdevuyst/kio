mod main;

import __intrinsics__;

host type I32 role(i32);

pub type { Leaf: . { pub mk; pub get } }

rec {
  pub type { Branch: Root & Root { pub mk; pub get } };
  pub type Root_tail = Branch;
  pub type { Root: Leaf | Root_tail { pub mk; pub get } }
}

pub fn base_payload() -> Leaf | Root_tail { __left__[Leaf][Root_tail](Leaf.mk(())) }

pub fn keep(root: Root) -> Root { root }

pub fn accept_payload(payload: Leaf | Root_tail) -> I32 {
  __either__[Leaf][Root_tail][I32](
  , payload
  , .(_base: Leaf) -> I32 { 1[I32] }
  , .(_recursive: Root_tail) -> I32 { 0[I32] }
  )
}
