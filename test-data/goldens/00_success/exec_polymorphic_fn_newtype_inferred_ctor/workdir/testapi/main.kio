mod testapi/main;

import testapi { type String }
import testapi/io { fn print }

type { Box[A]: A { mk; get } }

type { Functor[*F]: [A][B] ((A -> B) & F[A]) -> F[B] { mk; get } }

fn box_functor() -> Functor[Box] {
  Functor.mk(.[A][B](step, value) { Box.mk(step(Box.get(value))) })
}

pub fn main() {
  let functor = box_functor();
  let value = Box.mk("inferred ctor ok\n"[String]);
  let mapped = Functor.get(functor)[String][String](.(s) { s }, value);
  print(Box.get(mapped))
}
