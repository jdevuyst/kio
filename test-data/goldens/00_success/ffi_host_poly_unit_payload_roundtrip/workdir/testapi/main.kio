module testapi/main;

import testapi(String);
import testapi/arith(round_poly_thunk, round_unit_slot);
import testapi/io(print);
import testapi/types(Poly_thunk, Unit_slot);

fn make_thunk() -> Poly_thunk { Poly_thunk.make(.[A]() -> . { print("zero\n"(String)) }) }

fn make_unit_slot() -> Unit_slot(.) {
  Unit_slot.make(., .[A](value: .) -> . { print("unit slot\n"(String)); value })
}

pub fn main() -> . {
  let thunk = round_poly_thunk(make_thunk());
  let unit_slot = round_unit_slot(make_unit_slot());
  Unit_slot.run(., unit_slot)(String, ());
  Poly_thunk.run(thunk)(String, ())
}
