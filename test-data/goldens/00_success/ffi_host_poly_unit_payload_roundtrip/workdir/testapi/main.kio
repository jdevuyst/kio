mod testapi/main;

import testapi { type String }
import testapi/arith { fn round_poly_thunk; fn round_unit_slot }
import testapi/io { fn print }
import testapi/types { type Poly_thunk; type Unit_slot }

fn make_thunk() -> Poly_thunk {
  Poly_thunk.mk(.[A]() -> . { print("zero\n"[String]) })
}

fn make_unit_slot() -> Unit_slot[.] {
  Unit_slot.mk[.](.[A](value: .) -> . { print("unit slot\n"[String]); value })
}

pub fn main() {
  let thunk = round_poly_thunk(make_thunk());
  let unit_slot = round_unit_slot(make_unit_slot());
  Unit_slot.get[.](unit_slot)[String](());
  Poly_thunk.get(thunk)[String](())
}
