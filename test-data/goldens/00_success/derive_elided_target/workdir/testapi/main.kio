mod testapi/main;

import macros/derive { macro derive }
import testapi { type String }
import testapi/io { fn print }

pub type { Box[A]: A { pub mk; pub get } }

pub type { Monad[*F]: [A][B] (F[A] & (A -> F[B])) -> F[B] { pub mk; pub get } }

fn box_monad() -> Monad[Box] {
  Monad.mk(.[A][B](m, k) { k(Box.get(m)) })
}

// The target is elided as `_`; the function's declared return type
// pins the goal to `Monad(Box)` via the surrounding expected type,
// the same convention the other solver bangs use for their trailing
// target slot.
fn box_instance() -> Monad[Box] { derive(box_monad) }

fn use_derived() -> String {
  let monad = box_instance();
  let lifted = Box.mk("derive! elided target: ok\n"[String]);
  let stepped = Monad.get(monad)[String][String](lifted, .(s) { Box.mk(s) });
  Box.get(stepped)
}

pub fn main() { print(use_derived()) }
