module testapi/main;

import elab/derive(derive);
import testapi(String);
import testapi/io(print);

pub newtype Box[A] : A { pub constructor mk_box; pub projector un_box }

pub newtype Monad[*F] : [A][B] (F(A) & (A -> F(B))) -> F(B) {
  pub constructor mk_monad;
  pub projector bind
  }

fn box_monad() -> Monad(Box) { Monad.mk_monad(.[A][B](m, k) { k(Box.un_box(m)) }) }

// The target is elided as `_`; the function's declared return type
// pins the goal to `Monad(Box)` via the surrounding expected type,
// the same convention the other solver bangs use for their trailing
// target slot.
fn box_instance() -> Monad(Box) { derive!(box_monad) }

fn use_derived() -> String {
  let monad = box_instance();
  let lifted = Box.mk_box("derive! elided target: ok\n"(String));
  let stepped = Monad.bind(monad)(String, String, lifted, .(s) { Box.mk_box(s) });
  Box.un_box(stepped)
}

pub fn main() -> . { print(use_derived()) }
