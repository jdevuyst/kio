mod testapi/main;

import testapi { type I32 }

pub type { Const[A]: I32 { pub mk; pub get } }

// `Const` ignores its type argument, so the instantiated payload of `Wrap`
// is the finite host scalar `I32`. The argument must not make `Wrap`
// recursive or replace that exact finite boundary type with an erased
// recursive carrier.
pub rec type { Wrap: Const[Wrap] { pub mk; pub get } }

pub fn from_i32(value: I32) -> Wrap { Wrap.mk(Const.mk[Wrap](value)) }

pub fn to_i32(value: Wrap) -> I32 { Const.get[Wrap](Wrap.get(value)) }
