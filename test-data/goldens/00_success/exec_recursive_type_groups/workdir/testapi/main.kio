mod testapi/main;

import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type String }
import testapi/io { fn print }

pub rec type Tree = { Leaf: String } | { Branch: Tree & Tree };

rec {
  pub type Chain = . | Node;
  pub type { Node: String & Chain { pub mk; pub get } }
}

rec {
  pub type { Even: . | Odd { pub mk; pub get } };
  pub type { Odd: . | Even { pub mk; pub get } }
}

fn leaf(text: String) -> Tree { widen_sum(Leaf.mk(text)) }

fn branch(left: Tree, right: Tree) -> Tree { widen_sum(Branch.mk((left, right))) }

fn first(tree: Tree) -> Tree {
  match(tree) {
    (
    , .(value: Leaf) { widen_sum(value) }
    , .(value: Branch) {
        match(Branch.get(value)) {
          .(left: Tree, _right: Tree) { left }
        }
      }
    )
  }
}

fn leaf_text(tree: Tree) -> String {
  match(tree) {
    (.(value: Leaf) { Leaf.get(value) }, .(_value: Branch) { "branch\n" })
  }
}

fn chain_nil() -> Chain { widen_sum(()) }

fn chain_cons(text: String, tail: Chain) -> Chain { widen_sum(Node.mk((text, tail))) }

fn chain_head(chain: Chain) -> String {
  match(chain) {
    (
    , .(value: Node) {
        match(Node.get(value)) {
          .(text: String, _tail: Chain) { text }
        }
      }
    , .(_empty: .) { "empty\n" }
    )
  }
}

fn zero() -> Even { Even.mk(widen_sum(())) }

fn one() -> Odd { Odd.mk(widen_sum(zero())) }

fn two() -> Even { Even.mk(widen_sum(one())) }

fn force_mutual(value: Even) -> String {
  match(Even.get(value)) {
    (.(odd: Odd) { let _predecessor = Odd.get(odd); "mutual\n" }, .(_zero: .) { "zero\n" })
  }
}

pub fn main() {
  print(leaf_text(first(branch(leaf("labels\n"), leaf("unused\n")))));
  print(chain_head(chain_cons("alias\n", chain_nil())));
  print(force_mutual(two()))
}
