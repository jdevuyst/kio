module testapi/brackets;

import testapi(String);

fn pick(a: String, b: String) -> String { a }

// The recursive operand admits nested indexing. Spaces keep the nested
// closing runs separate under ordinary maximal lexing.
op _ <| __ |> { impl pick }

pub fn plain_outer() -> String { "outer" <| "inner" |> }

pub fn plain_nested() -> String { "one" <| "two" <| "three" |> |> }
