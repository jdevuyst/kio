module testapi/main;

import macros/control(macro if);
import macros/match(macro match);
import macros/spine_macros(macro widen_sum);
import testapi(Bool, Int, String);
import testapi/fmt(int_to_string);
import testapi/io(print);

// Heterogeneous branches construct their sum explicitly.
pub fn main() {
  let v =
    if(.t) {
      widen_sum("string arm\n"[String])[String | Int]
    } else {
      widen_sum(42[Int])[String | Int]
    };
  print(match(v) {
    (.(s: String) { s }, .(n: Int) { int_to_string(n) })
  })
}
