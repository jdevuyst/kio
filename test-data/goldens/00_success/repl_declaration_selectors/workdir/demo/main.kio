module demo/main;

import demo/ops as arithmetic;
import demo/ops(choose, field, op _ (=) _, op _ + _, op _ .. _, varop [* *], {field});
import demo/other as other;

pub fn use() -> . {
  let value = () + choose((), ());
  let dots = value .. ();
  let equal = dots = ();
  [* equal, arithmetic.empty() *]
}

pub fn label_use() -> . { {field=}.?{field} }

pub fn function_use() -> . { field() }

pub fn keyword_use() -> . { arithmetic.fn(); arithmetic.pub(); other.fn(); other.pub() }
