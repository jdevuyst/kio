mod wide;

import macros/row_macros { macro select }
import testapi { type I32 }
import testapi/arith { fn add_i32 }

pub type {
  Alpha: I32 { pub mk; pub get };
  Bravo: I32 { pub mk; pub get };
  Charlie: I32 { pub mk; pub get };
  Delta: I32 { pub mk; pub get };
  Echo: I32 { pub mk; pub get }
}

pub type Row = Alpha & Bravo & Charlie & Delta & Echo;

pub type Cells = Alpha & Bravo & Charlie & Delta & Echo;

pub type Grid = Cells & Cells & Cells & Cells & Cells & Cells & Cells & Cells & Cells & Cells;

pub fn row(n: I32) -> Cells { (Alpha.mk(n), Bravo.mk(n), Charlie.mk(n), Delta.mk(n), Echo.mk(n)) }

pub fn grid() -> Grid {
  (row(1), row(2), row(3), row(4), row(5), row(6), row(7), row(8), row(9), row(10))
}

fn row_total(r: Cells) -> I32 {
  add_i32(
  , r.>select { Alpha.get }
  , add_i32(
    , r.>select { Bravo.get }
    , add_i32(r.>select { Charlie.get }, add_i32(r.>select { Delta.get }, r.>select { Echo.get }))
    )
  )
}

pub fn grid_total(
, a: Cells
, b: Cells
, c: Cells
, d: Cells
, e: Cells
, f: Cells
, g: Cells
, h: Cells
, i: Cells
, j: Cells
) -> I32 {
  add_i32(
  , row_total(a)
  , add_i32(
    , row_total(b)
    , add_i32(
      , row_total(c)
      , add_i32(
        , row_total(d)
        , add_i32(
          , row_total(e)
          , add_i32(
            , row_total(f)
            , add_i32(row_total(g), add_i32(row_total(h), add_i32(row_total(i), row_total(j))))
            )
          )
        )
      )
    )
  )
}
