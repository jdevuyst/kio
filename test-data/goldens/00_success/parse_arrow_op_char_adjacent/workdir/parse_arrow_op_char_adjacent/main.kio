module parse_arrow_op_char_adjacent/main;

import parse_arrow_op_char_adjacent(A);

// A bottom result can immediately follow the type arrow.
type Diverge = . ->!;

// Direct chain results retain their required grouping.
type Fn_to_amp = . -> (A & A);

type Fn_to_pipe = . -> (A | A);

// A signature's own return accepts leading chains adjacent to its arrow.
host fn own_product() ->& A & A;

host fn own_sum() ->| A | A;

pub fn main() { () }
