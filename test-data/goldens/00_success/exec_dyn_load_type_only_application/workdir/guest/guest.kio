mod guest;

import hostapi { type I32; fn add_i32 }

type { Box[A]: A { pub mk; pub get } }

fn id[A](x: A) -> A { x }

fn call1(f: I32 -> I32, x: I32) -> I32 { f(x) }

fn call_box(f: I32 -> Box[I32], x: I32) -> Box[I32] { f(x) }

fn zero[A]() -> I32 { 0[I32] }

pub fn via_id(x: I32) -> I32 { call1(id[I32], x) }

pub fn via_unit_group(x: I32) -> I32 { add_i32(zero[I32](()), x) }

pub fn via_ctor(x: I32) -> I32 { Box.get(call_box(Box.mk[I32], add_i32(x, 1))) }
