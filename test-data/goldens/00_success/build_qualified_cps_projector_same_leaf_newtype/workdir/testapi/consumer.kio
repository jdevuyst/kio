module testapi/consumer;

import testapi/types as t;

// An unrelated same-leaf declaration must not redirect qualified t.Box.
newtype Box : . { constructor mk_local_box; projector un_local_box }

fn consume(projector: t.Box -> [R] ([A] A -> R) -> R) -> . { () }

pub fn main() -> . { consume(t.Box.un_box) }
