module forms;

import __comptime__;

pure fn pair_impl(
, ct: __Comptime__
, _a: __Type__
, _b: __Type__
, prefix: __Checked_term__
, body: __Checked_term__
) -> __Checked_term__ { __intrinsic_pair__(ct, prefix, body) }

pub elab block_pair : [A][B] A -> B -> (A & B) { trailing product; impl pair_impl }
