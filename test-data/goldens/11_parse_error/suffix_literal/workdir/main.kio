module parse_err_suffix_literal/main;

// The lexer-side width suffix is gone (specs/language.md § Literals):
// `42i32` lexes as the integer `42` followed by the identifier
// `i32`, which the parser cannot place — a parse error. A literal's
// type comes from its `(Type)` annotation or the surrounding
// context, never a suffix.
fn main() -> . { 42i32 }
