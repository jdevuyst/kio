mod testapi/main;

import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type I32; type String }
import testapi/io { fn print }

type { Box[A]: A { mk; get } }

fn label[A](value: Box[A]) -> String { "matched\n" }

fn handle(value: Box[I32] | Box[String]) -> String {
  match(value) {
    .[A](boxed: Box[A]) { () }
  }
}

pub fn main() { print(handle(widen_sum(Box.mk(42)))); print(handle(widen_sum(Box.mk("text")))) }
