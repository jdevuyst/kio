package typed_let_partial_annotation_no_rhs_context;

build {
  cache "out/.kio-cache/";

  target js {
    out "out/js/";
    baseline es2020
  };

  target ts {
    out "out/ts/";
    baseline v5_0
  }
}

bridge {
  typed_let_partial_annotation_no_rhs_context;
  typed_let_partial_annotation_no_rhs_context/**
}
