module main;

import macros/sequence(macro do);

pub type { Box[A]: A { mk; get } }

pub type { Other[A]: A { mk; get } }

host fn bind[A][B](value: Box[A], next: A -> Other[B]) -> Other[B];

fn run() -> Other[.] {
  do(bind) { let first <- Box.mk(()); let second <- Box.mk(()); Other.mk(second) }
}
