module consumer;

import __intrinsics__;

import first as first;
import macros/control(macro if);
import second as second;

type First_bool = first.Bool;

type Second_bool = second.Bool;

fn choose(condition: First_bool) -> First_bool {
  if(condition) { .t(First_bool) } else { .f(First_bool) }
}

fn mismatched_condition(condition: First_bool) -> Second_bool {
  __if_then_else__(
  , Second_bool
  , Second_bool
  , condition
  , .() { .t(Second_bool) }
  , .() { .f(Second_bool) }
  )
}
