module dkm/main;

import elab/derive(derive);

pub newtype Box[A] : A { pub constructor mk_box; pub projector un_box }

// `Flat` is a *kind-`*`* newtype — it takes no type parameter, so it
// is a saturated type, not a `*→*` brand.
pub newtype Flat : . { pub constructor mk_flat; pub projector un_flat }

pub newtype Monad[*F] : [A][B] (F(A) & (A -> F(B))) -> F(B) {
  pub constructor mk_monad;
  pub projector bind
  }

fn box_monad() -> Monad(Box) { Monad.mk_monad(.[A][B](m, k) { k(Box.un_box(m)) }) }

// A candidate whose result type applies the `Monad` brand to the
// kind-`*` type `Flat`. `Monad[*F]`'s slot requires a kind-`*→*`
// brand, but `Flat` is kind-`*` — a kind mismatch (the
// `derive_kind_mismatch` condition).
fn flat_monad() -> Monad(Flat) { Monad.mk_monad(.[A][B](m, k) { k(m) }) }

fn bad() -> Monad(Box) { derive!((box_monad, flat_monad), Monad(Box)) }

pub fn main() -> . { () }
