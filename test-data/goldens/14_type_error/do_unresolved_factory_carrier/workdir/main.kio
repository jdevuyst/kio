module main;

import elab/sequence(do);

newtype Box[A] : A { constructor box; projector unbox }

host fn make_bind[*M]() -> [A][B] (M(A) & (A -> M(B))) -> M(B);

pub fn run() -> . {
  let result =
    do! make_bind() {
      let value <- Box.box(());
      Box.box(value)
    };
  Box.unbox(result)
}
