module main;

import macros/sequence(macro do);

pub type { Box[A]: A { mk; get } }

fn box_pure[A](value: A) -> Box[A] { Box.mk(value) }

fn box_bind[A][B](value: Box[A], next: A -> Box[B]) -> Box[B] { next(Box.get(value)) }

host fn boxed_polymorphic(_token: .) -> Box[[Poly] Poly -> Poly];

fn partial() -> Box[.] {
  do(box_bind) { let .(function: [Do_bound] _) <- boxed_polymorphic(()); box_pure(()) }
}
