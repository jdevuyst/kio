mod main;

import macros/sequence { macro do }

host type String role(str);

pub type { Box[A]: A { pub mk; pub get } }

fn box_pure[A](x: A) -> Box[A] { Box.mk(x) }

fn box_bind[A][B](m: Box[A], k: A -> Box[B]) -> Box[B] { k(Box.get(m)) }

// Type error: the final expression `"plain string"` is not of
// type `Box[_]`. A do-block's final expression must match the
// receiver's monad shape.
fn bad() -> Box[.] {
  do(box_bind) { let _x <- box_pure(()); "plain string"[String] }
}
