module main;

import macros/sequence(macro do);

host type String role(str);

pub type { Box[A]: A { pub mk; pub get } }

fn box_pure[A](x: A) -> Box[A] { Box.mk(x) }

fn box_bind[A][B](m: Box[A], k: A -> Box[B]) -> Box[B] { k(Box.get(m)) }

// Type error: the bind statement RHS `"plain string"` is not of
// type `Box[_]`. Each bind step must produce the monadic
// shape the receiver works on.
fn bad() -> Box[.] {
  do(box_bind) { let _x <- "plain string"[String]; box_pure(()) }
}
