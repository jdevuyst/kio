module main;

import macros/sequence(macro do);

type { Box[A]: A { mk; get } }

type { Other[A]: A { mk; get } }

host fn make_bind[*M][*N]() -> [A][B] (M[A] & (A -> N[B])) -> N[B];

fn run() -> Other[.] {
  do(make_bind()) { let first <- Box.mk(()); let second <- Other.mk(()); Other.mk(second) }
}
