module main;

import elab/sequence(do);

newtype Box[A] : A { constructor box; projector unbox }

newtype Other[A] : A { constructor other; projector unother }

host fn make_bind[*M][*N]() -> [A][B] (M(A) & (A -> N(B))) -> N(B);

fn run() -> Other(.) {
  do! make_bind() {
    let first <- Box.box(());
    let second <- Other.other(());
    Other.other(second)
  }
}
