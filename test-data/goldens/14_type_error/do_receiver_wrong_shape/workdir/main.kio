mod main;

import macros/sequence { macro do }

pub type { Box[A]: A { pub mk; pub get } }

fn box_pure[A](x: A) -> Box[A] { Box.mk(x) }

// Wrong-shape receiver: a single-arg function, not the
// `[A] [B] (Box[A] & (A -> Box[B])) -> Box[B]` bind shape the
// do-block requires.
fn not_bind[A](m: Box[A]) -> Box[A] { m }

fn bad() -> Box[.] {
  do(not_bind) { let _x <- box_pure(()); box_pure(()) }
}
