/// Constructs, updates, and selects ordinary product fields by exact applied type.
mod dict/macros/row_macros;

import __intrinsics__;

import __comptime__;
import dict/macros/macro_util {
  type Matched_slot;
  type Matched_slot_tail;
  type Slot;
  type Slot_list;
  type Term_list;
  type Type_list;
  type Type_pair;
  fn build_product_from_slots;
  fn finish_macro_result;
  fn product_slots;
  fn product_spine;
  fn right_fold_term_product_from_reversed;
  fn slot_cons;
  fn slot_empty;
  fn slot_nil;
  fn slot_prepend_reverse_by_types;
  fn slot_reverse_by_types;
  fn slot_term;
  fn slot_type;
  fn take_first_matching;
  fn term_cons;
  fn term_nil;
  fn type_cons;
  fn type_nil;
  fn type_reverse
}

type Function_view = __Type__ & __Type__;

type Forall_view = __Type_var__ & __Type_arity__ & __Type__;

type Type_view_tail7 = __Type_name__;

type Type_view_tail6 = __Type_var__ | Type_view_tail7;

type Type_view_tail5 = Forall_view | Type_view_tail6;

type Type_view_tail4 = Function_view | Type_view_tail5;

type Type_view_tail3 = Type_pair | Type_view_tail4;

type Type_view_tail2 = Type_pair | Type_view_tail3;

type Type_view_tail1 = . | Type_view_tail2;

type Maybe_type_pair = Type_pair | .;

type Maybe_function_view = Function_view | .;

type Slot_list_result = Slot_list | __Diagnostic_text__;

type Slot_cell = Slot & Slot_list;

type Slots_fold_state = Type_list & Term_list;

type Select_state = Type_list & Slot_list;

type Select_next = Slot_list & Select_state;

type Select_step = Slot_list_result | Select_next;

/// Combines two row values into one product.
pub pure fn row_pair[A][B](left: A, right: B) -> A & B { (left, right) }

/// Pairs row macro packets with right-associative `*` syntax.
pub op _ * __ { impl row_pair }

pure fn some_type_pair(ct: __Comptime__, pair: Type_pair) -> Maybe_type_pair {
  __left__[Type_pair][.](pair)
}

pure fn no_type_pair(ct: __Comptime__) -> Maybe_type_pair { __right__[Type_pair][.](()) }

pure fn product_view(ct: __Comptime__, typ: __Type__) -> Maybe_type_pair {
  __either__[.][Type_view_tail1][Maybe_type_pair](
  , __type_view__(ct, typ)
  , .(_unit: .) -> Maybe_type_pair { no_type_pair(ct) }
  , .(tail1: Type_view_tail1) -> Maybe_type_pair {
      __either__[.][Type_view_tail2][Maybe_type_pair](
      , tail1
      , .(_bottom: .) -> Maybe_type_pair { no_type_pair(ct) }
      , .(tail2: Type_view_tail2) -> Maybe_type_pair {
          __either__[Type_pair][Type_view_tail3][Maybe_type_pair](
          , tail2
          , .(pair: Type_pair) -> Maybe_type_pair { some_type_pair(ct, pair) }
          , .(_tail3: Type_view_tail3) -> Maybe_type_pair { no_type_pair(ct) }
          )
        }
      )
    }
  )
}

pure fn some_function_view(ct: __Comptime__, view: Function_view) -> Maybe_function_view {
  __left__[Function_view][.](view)
}

pure fn no_function_view(ct: __Comptime__) -> Maybe_function_view {
  __right__[Function_view][.](())
}

pure fn function_view(ct: __Comptime__, typ: __Type__) -> Maybe_function_view {
  __either__[.][Type_view_tail1][Maybe_function_view](
  , __type_view__(ct, typ)
  , .(_unit: .) -> Maybe_function_view { no_function_view(ct) }
  , .(tail1: Type_view_tail1) -> Maybe_function_view {
      __either__[.][Type_view_tail2][Maybe_function_view](
      , tail1
      , .(_bottom: .) -> Maybe_function_view { no_function_view(ct) }
      , .(tail2: Type_view_tail2) -> Maybe_function_view {
          __either__[Type_pair][Type_view_tail3][Maybe_function_view](
          , tail2
          , .(_product: Type_pair) -> Maybe_function_view { no_function_view(ct) }
          , .(tail3: Type_view_tail3) -> Maybe_function_view {
              __either__[Type_pair][Type_view_tail4][Maybe_function_view](
              , tail3
              , .(_sum: Type_pair) -> Maybe_function_view { no_function_view(ct) }
              , .(tail4: Type_view_tail4) -> Maybe_function_view {
                  __either__[Function_view][Type_view_tail5][Maybe_function_view](
                  , tail4
                  , .(view: Function_view) -> Maybe_function_view { some_function_view(ct, view) }
                  , .(_tail5: Type_view_tail5) -> Maybe_function_view { no_function_view(ct) }
                  )
                }
              )
            }
          )
        }
      )
    }
  )
}

pure fn function_param(ct: __Comptime__, view: Function_view) -> __Type__ {
  __fst__[__Type__][__Type__](view)
}

pure fn function_result(ct: __Comptime__, view: Function_view) -> __Type__ {
  __snd__[__Type__][__Type__](view)
}

pure fn slot_list_ok(ct: __Comptime__, slots: Slot_list) -> Slot_list_result {
  __left__[Slot_list][__Diagnostic_text__](slots)
}

pure fn slot_list_err(ct: __Comptime__, message: __Diagnostic_text__) -> Slot_list_result {
  __right__[Slot_list][__Diagnostic_text__](message)
}

pure fn slots_fold_types_rev(state: Slots_fold_state) -> Type_list {
  __fst__[Type_list][Term_list](state)
}

pure fn slots_fold_terms_rev(state: Slots_fold_state) -> Term_list {
  __snd__[Type_list][Term_list](state)
}

type Slots_fold_next = Slot_list & Slots_fold_state;

type Slots_fold_step = Slots_fold_state | Slots_fold_next;

pure fn slots_fold(ct: __Comptime__, slots: Slot_list) -> Slots_fold_state {
  __structural_recur__(ct)[Slot_list][Slots_fold_state][Slots_fold_state](
  , slots
  , (type_nil(), term_nil())
  , .(
    , loop_recur: (Slot_list & Slots_fold_state) -> Slots_fold_state
    , loop_fuel: Slot_list
    , loop_state: Slots_fold_state
    ) -> Slots_fold_state {
      let loop_step_fn =
        .(fuel: Slot_list, state: Slots_fold_state) -> Slots_fold_step {
          __either__[.][Slot_cell][Slots_fold_step](
          , Slot_list.get(fuel)
          , .(_done: .) -> Slots_fold_step { __left__[Slots_fold_state][Slots_fold_next](state) }
          , .(cell: Slot_cell) -> Slots_fold_step {
              let current = __fst__[Slot][Slot_list](cell);
              __right__[Slots_fold_state][Slots_fold_next]((
              , __snd__[Slot][Slot_list](cell)
              , (
                , type_cons(ct, slot_type(ct, current), slots_fold_types_rev(state))
                , term_cons(ct, slot_term(ct, current), slots_fold_terms_rev(state))
                )
              ))
            }
          )
        };
      __either__[Slots_fold_state][Slots_fold_next][Slots_fold_state](
      , loop_step_fn(loop_fuel, loop_state)
      , .(loop_done: Slots_fold_state) -> Slots_fold_state { loop_done }
      , .(loop_next: Slots_fold_next) -> Slots_fold_state {
          loop_recur(
          , __fst__[Slot_list][Slots_fold_state](loop_next)
          , __snd__[Slot_list][Slots_fold_state](loop_next)
          )
        }
      )
    }
  )
}

pure fn slot_append(ct: __Comptime__, left: Slot_list, right: Slot_list) -> Slot_list {
  let folded = slots_fold(ct, left);
  slot_prepend_reverse_by_types(
  , ct
  , slots_fold_types_rev(folded)
  , slot_reverse_by_types(ct, type_reverse(ct, slots_fold_types_rev(folded)), left)
  , right
  )
}

pure fn slots_term(ct: __Comptime__, slots: Slot_list) -> __Checked_term__ {
  let folded = slots_fold(ct, slots);
  right_fold_term_product_from_reversed(
  , ct
  , slots_fold_types_rev(folded)
  , slots_fold_terms_rev(folded)
  )
}

type Row_consumer = Slot_list -> __Checked_term__;

type Row_walk_state = __Checked_term__ & Row_consumer;

pure fn with_product_slots(
, ct: __Comptime__
, source: __Type__
, value: __Checked_term__
, consume: Row_consumer
) -> __Checked_term__ {
  __structural_recur__(ct)[__Type__][Row_walk_state][__Checked_term__](
  , source
  , (value, consume)
  , .(recur: (__Type__ & Row_walk_state) -> __Checked_term__, typ: __Type__, state: Row_walk_state) -> __Checked_term__ {
      let current = __fst__[__Checked_term__][Row_consumer](state);
      let finish = __snd__[__Checked_term__][Row_consumer](state);
      __either__[Type_pair][.][__Checked_term__](
      , product_view(ct, typ)
      , .(pair: Type_pair) -> __Checked_term__ {
          let head_type = __fst__[__Type__][__Type__](pair);
          let tail_type = __snd__[__Type__][__Type__](pair);
          let head = (head_type, __intrinsic_fst__(ct, typ, current));
          __term_let__(
          , ct
          , tail_type
          , __intrinsic_snd__(ct, typ, current)
          , .(tail: __Checked_term__) -> __Checked_term__ {
              recur(
              , tail_type
              , (
                , tail
                , .(slots: Slot_list) -> __Checked_term__ { finish(slot_cons(ct, head, slots)) }
                )
              )
            }
          )
        }
      , .() -> __Checked_term__ { finish(slot_cons(ct, (typ, current), slot_nil())) }
      )
    }
  )
}

pure fn with_row_slots(
, ct: __Comptime__
, source: __Type__
, value: __Checked_term__
, consume: Row_consumer
) -> __Checked_term__ {
  __comptime_if_then_else__(ct)(
  , __type_equal__(ct, source, __type_unit__(ct))
  , .() -> __Checked_term__ { consume(slot_nil()) }
  , .() -> __Checked_term__ { with_product_slots(ct, source, value, consume) }
  )
}

pure fn row_slot_types(ct: __Comptime__, slots: Slot_list) -> Type_list {
  type_reverse(ct, slots_fold_types_rev(slots_fold(ct, slots)))
}

pure fn select_types_rev(state: Select_state) -> Type_list { __fst__[Type_list][Slot_list](state) }

pure fn select_slots_rev(state: Select_state) -> Slot_list { __snd__[Type_list][Slot_list](state) }

pure fn select_slots(
, ct: __Comptime__
, selectors: Slot_list
, source_types: Type_list
, source_slots: Slot_list
, missing_message: __Diagnostic_text__
, non_function_message: __Diagnostic_text__
) -> Slot_list_result {
  __structural_recur__(ct)[Slot_list][Select_state][Slot_list_result](
  , selectors
  , (type_nil(), slot_nil())
  , .(
    , loop_recur: (Slot_list & Select_state) -> Slot_list_result
    , loop_fuel: Slot_list
    , loop_state: Select_state
    ) -> Slot_list_result {
      let loop_step_fn =
        .(fuel: Slot_list, state: Select_state) -> Select_step {
          __either__[.][Slot_cell][Select_step](
          , Slot_list.get(fuel)
          , .(_done: .) -> Select_step {
              __left__[Slot_list_result][Select_next](slot_list_ok(
              , ct
              , slot_reverse_by_types(ct, select_types_rev(state), select_slots_rev(state))
              ))
            }
          , .(cell: Slot_cell) -> Select_step {
              let selector = __fst__[Slot][Slot_list](cell);
              __either__[Function_view][.][Select_step](
              , function_view(ct, slot_type(ct, selector))
              , .(view: Function_view) -> Select_step {
                  __either__[Matched_slot][.][Select_step](
                  , take_first_matching(ct, function_param(ct, view), source_types, source_slots)
                  , .(taken: Matched_slot) -> Select_step {
                      let wrapper = __fst__[Slot][Matched_slot_tail](taken);
                      let result_type = function_result(ct, view);
                      __right__[Slot_list_result][Select_next]((
                      , __snd__[Slot][Slot_list](cell)
                      , (
                        , type_cons(ct, result_type, select_types_rev(state))
                        , slot_cons(
                          , ct
                          , (
                            , result_type
                            , __term_call__(
                              , ct
                              , slot_type(ct, selector)
                              , slot_term(ct, selector)
                              , slot_term(ct, wrapper)
                              )
                            )
                          , select_slots_rev(state)
                          )
                        )
                      ))
                    }
                  , .(_missing: .) -> Select_step {
                      __left__[Slot_list_result][Select_next](slot_list_err(ct, missing_message))
                    }
                  )
                }
              , .(_not_function: .) -> Select_step {
                  __left__[Slot_list_result][Select_next](slot_list_err(ct, non_function_message))
                }
              )
            }
          )
        };
      __either__[Slot_list_result][Select_next][Slot_list_result](
      , loop_step_fn(loop_fuel, loop_state)
      , .(loop_done: Slot_list_result) -> Slot_list_result { loop_done }
      , .(loop_next: Select_next) -> Slot_list_result {
          loop_recur(
          , __fst__[Slot_list][Select_state](loop_next)
          , __snd__[Slot_list][Select_state](loop_next)
          )
        }
      )
    }
  )
}

pure fn remove_updated_slots(ct: __Comptime__, patches: Slot_list, source: Slot_list) -> Slot_list_result {
  __structural_recur__(ct)[Slot_list][Slot_list][Slot_list_result](
  , patches
  , source
  , .(recur: (Slot_list & Slot_list) -> Slot_list_result, pending: Slot_list, remaining: Slot_list) -> Slot_list_result {
      __either__[.][Slot_cell][Slot_list_result](
      , Slot_list.get(pending)
      , .() -> Slot_list_result { slot_list_ok(ct, remaining) }
      , .(cell: Slot_cell) -> Slot_list_result {
          let patch_type = slot_type(ct, __fst__[Slot][Slot_list](cell));
          let rest = __snd__[Slot][Slot_list](cell);
          __either__[Matched_slot][.][Slot_list_result](
          , take_first_matching(ct, patch_type, row_slot_types(ct, rest), rest)
          , .(_duplicate: Matched_slot) -> Slot_list_result {
              slot_list_err(ct, __"with repeats an exact update type"__(ct))
            }
          , .() -> Slot_list_result {
              __either__[Matched_slot][.][Slot_list_result](
              , take_first_matching(ct, patch_type, row_slot_types(ct, remaining), remaining)
              , .(taken: Matched_slot) -> Slot_list_result {
                  recur(
                  , rest
                  , __snd__[Type_list][Slot_list](__snd__[Slot][Matched_slot_tail](taken))
                  )
                }
              , .() -> Slot_list_result { recur(rest, remaining) }
              )
            }
          )
        }
      )
    }
  )
}

// Target permutation reads already-bound packets. Expanding only the final
// logical slot avoids constructing and decomposing an intermediate product.
pure fn normalize_final_bound_slot(ct: __Comptime__, slots: Slot_list) -> Slot_list {
  __structural_recur__(ct)[Slot_list][Slot_list -> Slot_list][Slot_list](
  , slots
  , .(value: Slot_list) -> Slot_list { value }
  , .(
    , recur: (Slot_list & (Slot_list -> Slot_list)) -> Slot_list
    , current: Slot_list
    , finish: Slot_list -> Slot_list
    ) -> Slot_list {
      __either__[.][Slot_cell][Slot_list](
      , Slot_list.get(current)
      , .() -> Slot_list {
          finish(slot_cons(ct, (__type_unit__(ct), __term_unit__(ct)), slot_nil()))
        }
      , .(cell: Slot_cell) -> Slot_list {
          let head = __fst__[Slot][Slot_list](cell);
          let tail = __snd__[Slot][Slot_list](cell);
          __comptime_if_then_else__(ct)(
          , slot_empty(ct, tail)
          , .() -> Slot_list { finish(product_slots(ct, slot_type(ct, head), slot_term(ct, head))) }
          , .() -> Slot_list {
              recur(tail, .(rest: Slot_list) -> Slot_list { finish(slot_cons(ct, head, rest)) })
            }
          )
        }
      )
    }
  )
}

pure fn finish_bound_slots_reordered(ct: __Comptime__, slots: Slot_list, target: __Type__) -> __Checked_term__ {
  let normalized = normalize_final_bound_slot(ct, slots);
  finish_macro_result(
  , ct
  , build_product_from_slots(
    , ct
    , product_spine(ct, target)
    , row_slot_types(ct, normalized)
    , normalized
    , __.t__(ct)
    )
  )
}

pure fn record_impl(
, ct: __Comptime__
, source: __Type__
, value: __Checked_term__
, finish: Slot_list -> __Checked_term__
) -> __Checked_term__ {
  __term_let__(
  , ct
  , source
  , value
  , .(bound: __Checked_term__) -> __Checked_term__ {
      with_row_slots(ct, source, bound, .(slots: Slot_list) -> __Checked_term__ { finish(slots) })
    }
  )
}

pure fn record_checked(
, ct: __Comptime__
, source: __Type__
, value: __Checked_term__
, target: __Type__
) -> __Checked_term__ {
  record_impl(
  , ct
  , source
  , value
  , .(slots: Slot_list) -> __Checked_term__ { finish_bound_slots_reordered(ct, slots, target) }
  )
}

pure fn record_natural_checked(
, ct: __Comptime__
, source: __Type__
, value: __Checked_term__
, _target: .
) -> __Checked_term__ {
  record_impl(ct, source, value, .(slots: Slot_list) -> __Checked_term__ { slots_term(ct, slots) })
}

/// Permutes written fields to the exact requested product type.
pub macro record : [Source] Source -> [Target] Target { trailing product; impl record_checked }

/// Builds a product in written order.
pub macro record_ : [Source] Source -> [Target] Target { trailing product; impl record_natural_checked }

pure fn with_impl(
, ct: __Comptime__
, source: __Type__
, patches_source: __Type__
, inputs: __Checked_term__
, finish: Slot_list -> __Checked_term__
) -> __Checked_term__ {
  let inputs_type = __term_type__(ct, inputs);
  __term_let__(
  , ct
  , inputs_type
  , inputs
  , .(bound: __Checked_term__) -> __Checked_term__ {
      with_row_slots(
      , ct
      , source
      , __intrinsic_fst__(ct, inputs_type, bound)
      , .(source_slots: Slot_list) -> __Checked_term__ {
          with_row_slots(
          , ct
          , patches_source
          , __intrinsic_snd__(ct, inputs_type, bound)
          , .(patch_slots: Slot_list) -> __Checked_term__ {
              __either__[Slot_list][__Diagnostic_text__][__Checked_term__](
              , remove_updated_slots(ct, patch_slots, source_slots)
              , .(remaining: Slot_list) -> __Checked_term__ {
                  finish(slot_append(ct, patch_slots, remaining))
                }
              , .(message: __Diagnostic_text__) -> __Checked_term__ { __macro_error__(ct, message) }
              )
            }
          )
        }
      )
    }
  )
}

pure fn with_checked(
, ct: __Comptime__
, source: __Type__
, patches_source: __Type__
, inputs: __Checked_term__
, target: __Type__
) -> __Checked_term__ {
  with_impl(
  , ct
  , source
  , patches_source
  , inputs
  , .(slots: Slot_list) -> __Checked_term__ { finish_bound_slots_reordered(ct, slots, target) }
  )
}

pure fn with_natural_checked(
, ct: __Comptime__
, source: __Type__
, patches_source: __Type__
, inputs: __Checked_term__
, _target: .
) -> __Checked_term__ {
  with_impl(
  , ct
  , source
  , patches_source
  , inputs
  , .(slots: Slot_list) -> __Checked_term__ { slots_term(ct, slots) }
  )
}

/// Places distinct updates first, removes their first exact receiver matches, and retains other fields.
/// Permutes the resulting product to the requested type without changing evaluation order.
pub macro with : [Source][Patches] (Source & Patches) -> [Target] Target { trailing product; impl with_checked }

/// Places distinct updates first and preserves the remaining receiver order.
pub macro with_ : [Source][Patches] (Source & Patches) -> [Target] Target { trailing product; impl with_natural_checked }

pure fn select_checked(
, ct: __Comptime__
, source: __Type__
, selectors_source: __Type__
, inputs: __Checked_term__
, _target: .
) -> __Checked_term__ {
  let inputs_type = __term_type__(ct, inputs);
  __term_let__(
  , ct
  , inputs_type
  , inputs
  , .(bound: __Checked_term__) -> __Checked_term__ {
      with_row_slots(
      , ct
      , source
      , __intrinsic_fst__(ct, inputs_type, bound)
      , .(source_slots: Slot_list) -> __Checked_term__ {
          with_row_slots(
          , ct
          , selectors_source
          , __intrinsic_snd__(ct, inputs_type, bound)
          , .(selector_slots: Slot_list) -> __Checked_term__ {
              __either__[Slot_list][__Diagnostic_text__][__Checked_term__](
              , select_slots(
                , ct
                , selector_slots
                , row_slot_types(ct, source_slots)
                , source_slots
                , __"select function input has no exact matching row field"__(ct)
                , __"select requires a function for each selector"__(ct)
                )
              , .(selected: Slot_list) -> __Checked_term__ { slots_term(ct, selected) }
              , .(message: __Diagnostic_text__) -> __Checked_term__ { __macro_error__(ct, message) }
              )
            }
          )
        }
      )
    }
  )
}

/// Applies each supplied function to the first field of its exact input type, preserving selector order.
/// The receiver and all selector factories run once before the selected functions are called.
pub macro select : [Source][Selectors] (Source & Selectors) -> [Target] Target { trailing product; impl select_checked }
