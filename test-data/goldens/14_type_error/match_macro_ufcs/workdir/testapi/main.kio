module testapi/main;

import macros/match(macro match);
import macros/spine_macros(macro widen_sum);
import testapi(I32, String);
import testapi/fmt(int_to_string);
import testapi/io(print);

fn handle(v: I32 | String) {
  v.>match((.(n: I32) { print(int_to_string(n)) }, .(s: String) { print(s) }))
}

pub fn main() { handle(widen_sum("match! ufcs: ok\n")) }
