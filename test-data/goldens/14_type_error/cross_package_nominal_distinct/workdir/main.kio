/// The consumer declares its own `String` host type and also depends on
/// `textdep`, which declares a same-named `String`. Identity-exact
/// nominal typing (`specs/language.md` § Nominal types) keeps
/// the two distinct: `String` here is `(main, String)`, the dependency's
/// is `(textdep/text, String)`. Passing the consumer's `String` to
/// `dep_string` — which wants the dependency's — must therefore be a type
/// error. The old bare-last-segment typer wrongly conflated the two and
/// accepted this.
module main;

import textdep/text as dtext;
import textdep/text(dep_string);

host type String role(str);

pub fn mix(s: String) -> dtext.String { dep_string(s) }
