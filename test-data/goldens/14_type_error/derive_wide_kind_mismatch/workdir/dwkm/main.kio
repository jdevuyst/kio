module dwkm/main;

import macros/derive(macro derive);

pub type { Box[A]: A { pub mk; pub get } }

pub type { Wrap0[A]: A { pub mk; pub get } }

pub type { Wrap1[A]: A { pub mk; pub get } }

pub type { Wrap2[A]: A { pub mk; pub get } }

pub type { Wrap3[A]: A { pub mk; pub get } }

pub type { Wrap4[A]: A { pub mk; pub get } }

pub type { Wrap5[A]: A { pub mk; pub get } }

pub type { Flat: . { pub mk; pub get } }

pub type { Monad[*F]: [A][B] (F[A] & (A -> F[B])) -> F[B] { pub mk; pub get } }

fn box_monad() -> Monad[Box] {
  Monad.mk(.[A][B](m, k) { k(Box.get(m)) })
}

fn wrap0_monad() -> Monad[Wrap0] {
  Monad.mk(.[A][B](m, k) { k(Wrap0.get(m)) })
}

fn wrap1_monad() -> Monad[Wrap1] {
  Monad.mk(.[A][B](m, k) { k(Wrap1.get(m)) })
}

fn wrap2_monad() -> Monad[Wrap2] {
  Monad.mk(.[A][B](m, k) { k(Wrap2.get(m)) })
}

fn wrap3_monad() -> Monad[Wrap3] {
  Monad.mk(.[A][B](m, k) { k(Wrap3.get(m)) })
}

fn wrap4_monad() -> Monad[Wrap4] {
  Monad.mk(.[A][B](m, k) { k(Wrap4.get(m)) })
}

fn wrap5_monad() -> Monad[Wrap5] {
  Monad.mk(.[A][B](m, k) { k(Wrap5.get(m)) })
}

fn flat_monad() -> Monad[Flat] {
  Monad.mk(.[A][B](m, k) { k(m) })
}

fn bad() -> Monad[Box] {
  derive((
  , wrap0_monad
  , wrap1_monad
  , wrap2_monad
  , flat_monad
  , wrap3_monad
  , box_monad
  , wrap4_monad
  , wrap5_monad
  ))[Monad[Box]]
}

pub fn main() { () }
