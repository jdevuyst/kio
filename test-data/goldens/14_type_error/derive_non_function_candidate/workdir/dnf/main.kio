mod dnf/main;

import dnf { type I32 }
import macros/derive { macro derive }

pub type { Box[A]: A { pub mk; pub get } }

pub type { Monad[*F]: [A][B] (F[A] & (A -> F[B])) -> F[B] { pub mk; pub get } }

fn box_monad() -> Monad[Box] {
  Monad.mk(.[A][B](m, k) { k(Box.get(m)) })
}

// A candidate tuple element that is not of function type. `42` is an
// `I32` literal, not a rule — its signature can't be read as an
// inference rule, so it is a type error pointing at the offending
// element (the `derive_non_function_candidate` condition).
fn bad() -> Monad[Box] { derive((box_monad, 42[I32]))[Monad[Box]] }

pub fn main() { () }
