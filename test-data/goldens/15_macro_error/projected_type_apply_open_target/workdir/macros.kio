mod macros;

import __comptime__;

pure fn inspect_apply_impl(
, ct: __Comptime__
, fills: __Fill_ctx__
, target: __Type__
, _clause: __Checked_term__
) -> __Checked_term__ & __Fill_ctx__ {
  let _observed = __type_apply__(ct, target, __type_unit__(ct));
  (__term_unit__(ct), __fill__(ct, fills, target, __type_unit__(ct)))
}

pub macro inspect_apply : [T] (. -> T) -> T { impl(fills) inspect_apply_impl }
