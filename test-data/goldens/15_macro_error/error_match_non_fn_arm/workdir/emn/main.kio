module emn/main;

import macros/match(macro match);
import testapi(I32, String);

// A `match` arms-tuple element that isn't a function. The first arm
// `42` is an `I32` literal, not a fn, so the imported `match` macro
// reports that the clause is not callable.
fn bad(v: I32 | String) {
  let .(_r: .) =
    match(v) {
      (42[I32], .(s: String) { () })
    };
  ()
}

pub fn main() { () }
