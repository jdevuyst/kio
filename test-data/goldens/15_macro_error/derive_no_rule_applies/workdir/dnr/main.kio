mod dnr/main;

import macros/derive { macro derive }

pub type { Box[A]: A { pub mk; pub get } }

pub type { List[A]: A { pub mk; pub get } }

pub type { Monad[*F]: [A][B] (F[A] & (A -> F[B])) -> F[B] { pub mk; pub get } }

fn box_monad() -> Monad[Box] {
  Monad.mk(.[A][B](m, k) { k(Box.get(m)) })
}

// The goal is `Monad[List]` but the only candidate produces
// `Monad[Box]` — no rule unifies with the goal, so resolution finds
// zero derivations (the `derive_no_rule_applies` condition).
fn bad() -> Monad[List] { derive(box_monad)[Monad[List]] }

pub fn main() { () }
