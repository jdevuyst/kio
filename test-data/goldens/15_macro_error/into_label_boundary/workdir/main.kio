mod main;

import macros/algebraic_macros { macro into }

// `into` (and `onto`) never crosses a nominal boundary. Even though
// the payload of `Wrap` is `A`, the macro does not unwrap `Wrap` to
// expose `A`. The projector `Wrap.get` crosses that boundary explicitly.
// Exit code 15 (macro error).
type { A: . { pub mk; pub get } }

type { Wrap: A }

fn strip(w: Wrap) -> A { into(w) }
