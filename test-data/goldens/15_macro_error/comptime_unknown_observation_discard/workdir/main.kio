mod main;

import __comptime__;

pure fn unstable_impl(
, ct: __Comptime__
, fills: __Fill_ctx__
, target: __Type__
, clause: __Checked_term__
) -> __Checked_term__ & __Fill_ctx__ {
  let _ignored = __term_specialize__(ct, clause, __type_unit__(ct), target);
  (__term_unit__(ct), __fill__(ct, fills, target, __type_unit__(ct)))
}

macro unstable : [T] (. -> T) -> T { impl(fills) unstable_impl }

fn run() {
  let value = unstable(.() { () });
  value
}
