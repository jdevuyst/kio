module macros;

import __comptime__;

pure fn inspect_args_impl(
, ct: __Comptime__
, fills: __Fill_ctx__
, target: __Type__
, _clause: __Checked_term__
) -> __Checked_term__ & __Fill_ctx__ {
  let _observed = __type_args_fold__(ct)[.](target, (), .(_result: ., _argument: __Type__) { () });
  (__term_unit__(ct), __fill__(ct, fills, target, __type_unit__(ct)))
}

pub macro inspect_args : [T] (. -> T) -> T { impl(fills) inspect_args_impl }
