module damb/main;

import macros/derive(macro derive);

pub type { Box[A]: A { pub mk; pub get } }

pub type { Monad[*F]: [A][B] (F[A] & (A -> F[B])) -> F[B] { pub mk; pub get } }

fn box_monad_a() -> Monad[Box] {
  Monad.mk(.[A][B](m, k) { k(Box.get(m)) })
}

fn box_monad_b() -> Monad[Box] {
  Monad.mk(.[A][B](m, k) { k(Box.get(m)) })
}

// Two candidates both produce `Monad[Box]` and both unify with the
// goal — resolution finds two distinct derivations, which is the
// `derive_ambiguous` coherence violation.
fn bad() -> Monad[Box] { derive((box_monad_a, box_monad_b))[Monad[Box]] }

pub fn main() { () }
