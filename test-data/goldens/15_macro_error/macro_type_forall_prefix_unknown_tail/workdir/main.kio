mod main;

import __comptime__;

pure fn inspect_impl(
, ct: __Comptime__
, fills: __Fill_ctx__
, target: __Type__
, _source: __Checked_term__
) -> __Checked_term__ & __Fill_ctx__ {
  let prefix =
    __type_forall__(ct, __type_arity_zero__(ct), .(_binder: __Type_var__) -> __Type__ { target });
  let ignored =
    __type_forall_prefix_fold__(ct)[.](prefix, (), .(_state: ., _binder: __Type_var__) -> . { () });
  (__term_unit__(ct), __fill__(ct, fills, target, __type_unit__(ct)))
}

macro inspect : [Target] (. -> Target) -> Target { impl(fills) inspect_impl }

fn run() {
  let result = inspect(.() { () });
  result
}
