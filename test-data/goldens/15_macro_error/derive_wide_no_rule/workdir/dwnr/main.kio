module dwnr/main;

import macros/derive(macro derive);

pub type { Atom0: . { pub mk; pub get } }

pub type { Atom1: . { pub mk; pub get } }

pub type { Atom2: . { pub mk; pub get } }

pub type { Atom3: . { pub mk; pub get } }

pub type { Atom4: . { pub mk; pub get } }

pub type { Atom5: . { pub mk; pub get } }

pub type { Atom6: . { pub mk; pub get } }

pub type { Atom7: . { pub mk; pub get } }

pub type { Wanted: . { pub mk; pub get } }

pub type { Render[A]: . { pub mk; pub get } }

fn render_atom0() -> Render[Atom0] { Render.mk[Atom0](()) }

fn render_atom1() -> Render[Atom1] { Render.mk[Atom1](()) }

fn render_atom2() -> Render[Atom2] { Render.mk[Atom2](()) }

fn render_atom3() -> Render[Atom3] { Render.mk[Atom3](()) }

fn render_atom4() -> Render[Atom4] { Render.mk[Atom4](()) }

fn render_atom5() -> Render[Atom5] { Render.mk[Atom5](()) }

fn render_atom6() -> Render[Atom6] { Render.mk[Atom6](()) }

fn render_atom7() -> Render[Atom7] { Render.mk[Atom7](()) }

fn bad() -> Render[Wanted] {
  derive((
  , render_atom0
  , render_atom1
  , render_atom2
  , render_atom3
  , render_atom4
  , render_atom5
  , render_atom6
  , render_atom7
  ))[Render[Wanted]]
}

pub fn main() { () }
