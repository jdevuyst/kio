package user_elaborator_structural_recur_stuck;

build {
  cache "out/.kio-cache/";

  target js {
    out "out/js/";
    baseline es2020
  };

  target ts {
    out "out/ts/";
    baseline v5_0
  }
}

bridge {
  elaborators;
  user_elaborator_structural_recur_stuck;
  user_elaborator_structural_recur_stuck/**
}
