mod macros;

import __intrinsics__;

import __comptime__;

type Elaborator_result = __Checked_term__ | __Diagnostic_text__;

rec type { Fuel: . | Fuel { pub mk; pub get } }

pure fn stop() -> Fuel { Fuel.mk(__left__[.][Fuel](())) }

pure fn tick(rest: Fuel) -> Fuel { Fuel.mk(__right__[.][Fuel](rest)) }

pure fn finish_elaborator_result(ct: __Comptime__, result: Elaborator_result) -> __Checked_term__ {
  __either__[__Checked_term__][__Diagnostic_text__][__Checked_term__](
  , result
  , .(term: __Checked_term__) -> __Checked_term__ { term }
  , .(message: __Diagnostic_text__) -> __Checked_term__ { __macro_error__(ct, message) }
  )
}

pure fn stuck_impl(ct: __Comptime__, _source: __Type__, value: __Checked_term__, _target: __Type__) -> Elaborator_result {
  __structural_recur__(ct)[Fuel][__Checked_term__][Elaborator_result](
  , tick(stop())
  , value
  , .(
    , loop_recur: (Fuel & __Checked_term__) -> Elaborator_result
    , loop_fuel: Fuel
    , loop_state: __Checked_term__
    ) -> Elaborator_result { loop_recur(loop_fuel, loop_state) }
  )
}

pub pure fn stuck_checked(
, ct: __Comptime__
, source: __Type__
, value: __Checked_term__
, target: __Type__
) -> __Checked_term__ { finish_elaborator_result(ct, stuck_impl(ct, source, value, target)) }

pub macro stuck : [Source] Source -> [Target] Target { impl stuck_checked }
