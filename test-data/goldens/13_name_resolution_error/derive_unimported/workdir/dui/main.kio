module dui/main;

// `derive` is used below without importing the macro; the
// call site is the standard unresolved-name error.
pub type { Box[A]: A { pub mk; pub get } }

pub type { Monad[*F]: [A][B] (F[A] & (A -> F[B])) -> F[B] { pub mk; pub get } }

fn box_monad() -> Monad[Box] {
  Monad.mk(.[A][B](m, k) { k(Box.get(m)) })
}

fn bad() -> Monad[Box] { derive(box_monad)[Monad[Box]] }

pub fn main() { () }
