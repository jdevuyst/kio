module host/m;

import host(T, effect);
import macros/control(macro scope);

type { Box: T { pub mk; pub get } }

equiv nested_stuck_callee(f: T -> T -> T, x: T, y: T) {
  f(x)(x);
  f(y)(x)
}

equiv newtype_payload(x: T, y: T) {
  Box.mk(x);
  Box.mk(y)
}

equiv effect_inside_newtype(x: T) {
  Box.mk(scope { effect(x); x });
  Box.mk(x)
}
