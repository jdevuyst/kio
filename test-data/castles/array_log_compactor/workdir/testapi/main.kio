mod testapi/main;

import macros/control { macro if }
import macros/row_macros { macro select }
import testapi { type Array; type Bool; type I32; type String }
import testapi/arith { fn add_i32; fn leq_i32; fn mul_i32; fn sub_i32 }
import testapi/array {
  fn array_clone;
  fn array_get;
  fn array_len;
  fn array_make_empty;
  fn array_make_filled;
  fn array_pop_back;
  fn array_push;
  fn array_set;
  fn array_swap
}
import testapi/fmt { fn bool_to_string; fn int_to_string }
import testapi/io { fn print }
import testapi/iter { fn loop }
import testapi/text { fn string_concat; fn string_eq }

type Event = { Event_key: String; Event_value: I32; Event_deleted: Bool; Event_seq: I32 };

type Compact = {
  Compacted_log: Array[Event];
  Kept_count: I32;
  Dropped_count: I32;
  Superseded_count: I32;
  Delete_count: I32;
  Original_count: I32
};

fn put(seq: I32, key: String, value: I32) -> Event {
  (Event_key.mk(key), Event_value.mk(value), Event_deleted.mk(.f), Event_seq.mk(seq))
}

fn delete_event(seq: I32, key: String) -> Event {
  (Event_key.mk(key), Event_value.mk(0), Event_deleted.mk(.t), Event_seq.mk(seq))
}

fn same_key(left: Event, right: Event) -> Bool {
  string_eq(left.>select { Event_key.get }, right.>select { Event_key.get })
}

fn is_deleted(item: Event) -> Bool {
  item.>select { Event_deleted.get }
}

fn score(item: Event) -> I32 {
  mul_i32(item.>select { Event_value.get }, item.>select { Event_seq.get })
}

fn render(index: I32, item: Event) -> String {
  let index_text = int_to_string(index);
  let key_text = item.>select { Event_key.get };
  let value_text = int_to_string(item.>select { Event_value.get });
  let seq_text = int_to_string(item.>select { Event_seq.get });
  seq_text
    .>string_concat("\n")
    .>>string_concat(" seq ")
    .>>string_concat(value_text)
    .>>string_concat("=")
    .>>string_concat(key_text)
    .>>string_concat(": ")
    .>>string_concat(index_text)
    .>>string_concat("slot ")
}

fn build_log() -> Array[Event] {
  let log = array_make_empty[Event](());
  array_push(log, put(1, "alpha", 4));
  array_push(log, put(2, "beta", 7));
  array_push(log, put(3, "gamma", 2));
  array_push(log, put(4, "alpha", 8));
  array_push(log, delete_event(5, "beta"));
  array_push(log, put(6, "delta", 3));
  array_push(log, put(7, "gamma", 6));
  array_push(log, put(8, "alpha", 9));
  array_push(log, delete_event(9, "epsilon"));
  array_push(log, put(10, "delta", 5));
  array_push(log, put(11, "zeta", 1));
  log
}

rec(loop) fn has_later_key(log: Array[Event], item: Event, index: I32, last: I32) -> Bool {
  if(leq_i32(index, last)) {
    let later = array_get(log, index);
    if(same_key(item, later)) {
      .t
    } else {
      recur has_later_key(log, item, add_i32(index, 1), last)
    }
  } else {
    .f
  }
}

fn result(log: Array[Event], kept: I32, dropped: I32, superseded: I32, deletes: I32, original: I32) -> Compact {
  (
  , Compacted_log.mk(log)
  , Kept_count.mk(kept)
  , Dropped_count.mk(dropped)
  , Superseded_count.mk(superseded)
  , Delete_count.mk(deletes)
  , Original_count.mk(original)
  )
}

rec(loop) fn compact_loop(
, log: Array[Event]
, read: I32
, write: I32
, last: I32
, kept: I32
, dropped: I32
, superseded: I32
, deletes: I32
, original: I32
) -> Compact {
  if(leq_i32(read, last)) {
    let item = array_get(log, read);
    let next_read = add_i32(read, 1);
    if(has_later_key(log, item, next_read, last)) {
      recur compact_loop(
      , log
      , next_read
      , write
      , last
      , kept
      , add_i32(dropped, 1)
      , add_i32(superseded, 1)
      , deletes
      , original
      )
    } else if(is_deleted(item)) {
      recur compact_loop(
      , log
      , next_read
      , write
      , last
      , kept
      , add_i32(dropped, 1)
      , superseded
      , add_i32(deletes, 1)
      , original
      )
    } else {
      array_set(log, write, item);
      recur compact_loop(
      , log
      , next_read
      , add_i32(write, 1)
      , last
      , add_i32(kept, 1)
      , dropped
      , superseded
      , deletes
      , original
      )
    }
  } else {
    result(log, kept, dropped, superseded, deletes, original)
  }
}

fn compact(log: Array[Event]) -> Compact {
  let work = array_clone(log);
  let original = array_len(work);
  compact_loop(work, 0, 0, sub_i32(original, 1), 0, 0, 0, 0, original)
}

fn line_count(label: String, value: I32) -> String {
  int_to_string(value).>string_concat("\n").>>string_concat(label)
}

fn print_count(label: String, value: I32) { print(line_count(label, value)) }

rec(loop) fn checksum_loop(log: Array[Event], index: I32, last: I32, total: I32) -> I32 {
  if(leq_i32(index, last)) {
    let item = array_get(log, index);
    recur checksum_loop(log, add_i32(index, 1), last, add_i32(total, score(item)))
  } else {
    total
  }
}

fn checksum(log: Array[Event], kept: I32) -> I32 { checksum_loop(log, 0, sub_i32(kept, 1), 0) }

rec(loop) fn print_rows(log: Array[Event], index: I32, last: I32) {
  if(leq_i32(index, last)) {
    print(render(index, array_get(log, index)));
    recur print_rows(log, add_i32(index, 1), last)
  } else {
    ()
  }
}

fn print_summary(summary: Compact) {
  let log = summary.>select { Compacted_log.get };
  let kept = summary.>select { Kept_count.get };
  print("array_log_compactor\n");
  print_count("original records: ", summary.>select { Original_count.get });
  print_count("kept live records: ", kept);
  print_count("removed records: ", summary.>select { Dropped_count.get });
  print_count("removed superseded records: ", summary.>select { Superseded_count.get });
  print_count("removed tombstones: ", summary.>select { Delete_count.get });
  print_count("checksum: ", checksum(log, kept));
  print("compacted live records:\n");
  print_rows(log, 0, sub_i32(kept, 1))
}

pub fn main() { let log = build_log(); let compacted = compact(log); print_summary(compacted) }
