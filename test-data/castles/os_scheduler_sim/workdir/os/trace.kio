/// The per-tick trace: what the CPU did on a tick, and what the scheduler then
/// decided to do with the process that was on it.
///
/// The two are separate questions. A tick that reads a page can end with the
/// process still on the CPU, back on the ready queue, blocked in the pager, or
/// finished, and only the second sum knows which.
module os/trace;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import os/config as config;
import os/num as num;
import os/proc as proc;
import os/text as text;
import testapi(Bool, I32, String);
import testapi/io(print);

/// What the CPU did.
///
/// `ran` carries the ticks still owed to the compute phase; `hit` the page read
/// and the frame it was found in; `fault` the page read, the frame it was
/// loaded into, and the process and page that frame gave up.
pub labels Event =
  { stalled: . }
  | { ran: I32 }
  | { hit: I32 & I32 }
  | { fault: I32 & I32 & I32 & I32 };

/// What the scheduler did next. `blocked` carries the tick the process is due
/// back.
pub labels Outcome =
  { nobody: . }
  | { holds: . }
  | { preempted: . }
  | { blocked: I32 }
  | { retired: . };

pub fn stalled_event() -> Event { {stalled=}.>widen_sum!(Event) }

pub fn ran_event(left: I32) -> Event { {ran = left}.>widen_sum!(Event) }

pub fn hit_event(vp: I32, frame: I32) -> Event { {hit = (vp, frame)}.>widen_sum!(Event) }

pub fn fault_event(vp: I32, frame: I32, victim_pid: I32, victim_vp: I32) -> Event {
  {fault = (vp, frame, victim_pid, victim_vp)}.>widen_sum!(Event)
}

pub fn nobody() -> Outcome { {nobody=}.>widen_sum!(Outcome) }

pub fn holds() -> Outcome { {holds=}.>widen_sum!(Outcome) }

pub fn preempted() -> Outcome { {preempted=}.>widen_sum!(Outcome) }

pub fn blocked(wake_at: I32) -> Outcome { {blocked = wake_at}.>widen_sum!(Outcome) }

pub fn retired() -> Outcome { {retired=}.>widen_sum!(Outcome) }

fn victim_text(victim_pid: I32, victim_vp: I32) -> String {
  if! num.lt(victim_pid, 0) {
    " (was free)"
  } else {
    text.cat4(
      , " (evicted "
      , proc.pid_tag(victim_pid)
      , text.cat(" vp", text.num_text(victim_vp))
      , ")"
      )
  }
}

fn event_text(e: Event) -> String {
  match! e {
    (
      , .(_s: Stalled) { "(nothing runnable)" }
      , .(r: Ran) { text.cat3("compute, ", text.num_text(r.?{ran}), " tick(s) left in phase") }
      , .(h: Hit) {
          let .(vp: I32, frame: I32) = h.?{hit};
          text.cat4("read vp", text.num_text(vp), " -> hit in frame ", text.num_text(frame))
        }
      , .(f: Fault) {
          let .(vp: I32, frame: I32, victim_pid: I32, victim_vp: I32) = f.?{fault};
          text.cat(
            , text.cat4(
                , "read vp"
                , text.num_text(vp)
                , " -> FAULT, loaded into frame "
                , text.num_text(frame)
                )
            , victim_text(victim_pid, victim_vp)
            )
        }
      )
  }
}

/// The state column, eight characters wide so the event text that follows it
/// starts in the same place on every line.
fn state_text(o: Outcome) -> String {
  match! o {
    (
      , .(_n: Nobody) { "idle    " }
      , .(_h: Holds) { "running " }
      , .(_p: Preempted) { "preempt " }
      , .(_b: Blocked) { "blocked " }
      , .(_r: Retired) { "retired " }
      )
  }
}

fn outcome_note(o: Outcome) -> String {
  match! o {
    (
      , .(_n: Nobody) { "" }
      , .(_h: Holds) { "" }
      , .(_p: Preempted) { "; quantum spent, requeued" }
      , .(b: Blocked) { text.cat("; blocked until t=", text.num_text(b.?{blocked})) }
      , .(_r: Retired) { "; program complete" }
      )
  }
}

pub fn header() -> . { print("tick  cpu  state   event\n") }

/// Print one line of the trace, while the window on the run is still open.
pub fn emit(tick: I32, pid: I32, e: Event, o: Outcome) -> . {
  if! num.lt(tick, config.trace_limit()) {
    print(text.cat4(
      , text.cat4(text.pad_num(tick, 4), "  ", proc.pid_tag(pid), "   ")
      , state_text(o)
      , event_text(e)
      , text.cat(outcome_note(o), "\n")
      ))
  } else {
    ()
  }
}
