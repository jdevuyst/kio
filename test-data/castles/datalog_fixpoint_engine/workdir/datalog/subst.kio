/// The substitution environment: variable code -> constant code.
///
/// It is built one binding at a time as a rule body is matched left to
/// right, and it is what makes a join a join: when a later goal meets a
/// variable an earlier one already bound, the binding is here and the
/// match has to agree with it.
mod datalog/subst;

import datalog/list as list;
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32 }
import testapi/arith { fn eq_i32 }
import testapi/iter { fn loop }

pub type Bind = { B_var: I32; B_const: I32 };

pub type Subst = list.List[Bind];

pub type Substs = list.List[Subst];

pub type Maybe_const = { Some_const: I32 } | { No_const: . };

pub fn some_const(code: I32) -> Maybe_const { (Some_const.mk(code).>widen_sum)[Maybe_const] }

pub fn no_const() -> Maybe_const { (No_const.mk(()).>widen_sum)[Maybe_const] }

pub fn empty() -> Subst { list.nil[Bind] }

/// Bindings are only ever added, never overwritten: the matcher extends
/// the environment exclusively for a variable it has just found unbound.
pub fn extend(s: Subst, v: I32, code: I32) -> Subst {
  list.cons((B_var.mk(v), B_const.mk(code)), s)
}

pub rec(loop) fn lookup(s: Subst, v: I32) -> Maybe_const {
  match(s.>list.List.get) {
    (
    , .(b: Bind, rest: Subst) {
        if(eq_i32(b.>select { B_var.get }, v)) {
          some_const(b.>select { B_const.get })
        } else {
          recur lookup(rest, v)
        }
      }
    , .(_empty: .) { no_const() }
    )
  }
}
