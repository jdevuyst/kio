/// The one collection the engine is built on: a generic cons list.
///
/// Every structure in this package is a list at some instantiation - an
/// argument vector is a `List(Term)`, a substitution is a `List(Bind)`,
/// the database and every rule body are a `List(Atom)`, and solving a
/// body hands back a `List(Subst)`. The walks below are therefore written
/// once, polymorphically, and reused at each of them.
module datalog/list;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(Bool, I32);
import testapi/arith(add_i32);
import testapi/iter(loop);

/// The `newtype` grounds the recursion an anonymous sum cannot express.
pub rec newtype List[A] : . | (A & List(A)) { pub constructor mk_list; pub projector un_list }

pub fn nil[A]() -> List(A) { List.mk_list(widen_sum!((), . | (A & List(A)))) }

pub fn cons[A](head: A, tail: List(A)) -> List(A) {
  List.mk_list(widen_sum!((head, tail), . | (A & List(A))))
}

pub fn of1[A](a: A) -> List(A) { cons(a, nil(A, ())) }

pub fn of2[A](a: A, b: A) -> List(A) { cons(a, of1(b)) }

pub fn of3[A](a: A, b: A, c: A) -> List(A) { cons(a, of2(b, c)) }

pub fn of4[A](a: A, b: A, c: A, d: A) -> List(A) { cons(a, of3(b, c, d)) }

pub fn of6[A](a: A, b: A, c: A, d: A, e: A, f: A) -> List(A) { cons(a, cons(b, of4(c, d, e, f))) }

pub fn is_empty[A](xs: List(A)) -> Bool {
  match! xs.>List.un_list {
    (.(_x: A, _rest: List(A)) { .f }, .(_empty: .) { .t })
  }
}

rec(loop) fn length_from[A](xs: List(A), acc: I32) -> I32 {
  match! xs.>List.un_list {
    (.(_x: A, rest: List(A)) { rec length_from(rest, add_i32(acc, 1)) }, .(_empty: .) { acc })
  }
}

pub fn length[A](xs: List(A)) -> I32 { length_from(xs, 0) }

/// `append` rebuilds its result on the way out rather than on the way in,
/// so its recursive call is a `cont`.
pub rec(loop) fn append[A](xs: List(A), ys: List(A)) -> List(A) {
  match! xs.>List.un_list {
    (.(x: A, rest: List(A)) { cons(x, rec(cont) append(rest, ys)) }, .(_empty: .) { ys })
  }
}

/// The database grows at the far end, so its list order is derivation
/// order - which is what makes every answer read out of it reproducible.
pub fn snoc[A](xs: List(A), x: A) -> List(A) { append(xs, of1(x)) }

pub rec(loop) fn concat_map[A][B](xs: List(A), f: A -> List(B)) -> List(B) {
  match! xs.>List.un_list {
    (
      , .(x: A, rest: List(A)) { append(f(x), rec(cont) concat_map(rest, f)) }
      , .(_empty: .) { nil(B, ()) }
      )
  }
}

pub rec(loop) fn map[A][B](xs: List(A), f: A -> B) -> List(B) {
  match! xs.>List.un_list {
    (.(x: A, rest: List(A)) { cons(f(x), rec(cont) map(rest, f)) }, .(_empty: .) { nil(B, ()) })
  }
}

pub rec(loop) fn fold[A][Acc](xs: List(A), step: (Acc & A) -> Acc, seed: Acc) -> Acc {
  match! xs.>List.un_list {
    (.(x: A, rest: List(A)) { rec fold(rest, step, step(seed, x)) }, .(_empty: .) { seed })
  }
}

pub rec(loop) fn any[A](xs: List(A), p: A -> Bool) -> Bool {
  match! xs.>List.un_list {
    (
      , .(x: A, rest: List(A)) {
          if! p(x) {
            .t
          } else {
            rec any(rest, p)
          }
        }
      , .(_empty: .) { .f }
      )
  }
}

pub rec(loop) fn all[A](xs: List(A), p: A -> Bool) -> Bool {
  match! xs.>List.un_list {
    (
      , .(x: A, rest: List(A)) {
          if! p(x) {
            rec all(rest, p)
          } else {
            .f
          }
        }
      , .(_empty: .) { .t }
      )
  }
}

rec(loop) fn count_from[A](xs: List(A), p: A -> Bool, acc: I32) -> I32 {
  match! xs.>List.un_list {
    (
      , .(x: A, rest: List(A)) {
          if! p(x) {
            rec count_from(rest, p, add_i32(acc, 1))
          } else {
            rec count_from(rest, p, acc)
          }
        }
      , .(_empty: .) { acc }
      )
  }
}

pub fn count[A](xs: List(A), p: A -> Bool) -> I32 { count_from(xs, p, 0) }
