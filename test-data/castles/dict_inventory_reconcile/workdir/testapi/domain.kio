module testapi/domain;

import macros/row_macros(macro select);
import testapi(I32, String);

pub type Item = { Item_sku: I32; Item_name: String };

pub type Count = { Count_sku: I32; Count_qty: I32 };

pub type Adjustment = { Adjust_sku: I32; Adjust_delta: I32; Adjust_tag: String };

pub type Line = {
  Line_name: String;
  Line_expected: I32;
  Line_actual: I32;
  Line_delta: I32;
  Line_status: String
};

pub type Totals = { Total_ok: I32; Total_missing: I32; Total_skewed: I32; Total_unknown: I32 };

pub type Report = {
  Report_bolt: Line;
  Report_gear: Line;
  Report_seal: Line;
  Report_panel: Line;
  Report_valve: Line;
  Report_unknown: Line;
  Report_totals: Totals
};

pub fn item(sku: I32, name: String) -> Item { (Item_sku.mk(sku), Item_name.mk(name)) }

pub fn item_key(row: Item) -> I32 {
  row.>select { Item_sku.get }
}

pub fn item_label(row: Item) -> String {
  row.>select { Item_name.get }
}

pub fn count(sku: I32, qty: I32) -> Count { (Count_sku.mk(sku), Count_qty.mk(qty)) }

pub fn count_key(row: Count) -> I32 {
  row.>select { Count_sku.get }
}

pub fn count_value(row: Count) -> I32 {
  row.>select { Count_qty.get }
}

pub fn adjustment(sku: I32, delta: I32, tag: String) -> Adjustment {
  (Adjust_sku.mk(sku), Adjust_delta.mk(delta), Adjust_tag.mk(tag))
}

pub fn adjustment_key(row: Adjustment) -> I32 {
  row.>select { Adjust_sku.get }
}

pub fn adjustment_value(row: Adjustment) -> I32 {
  row.>select { Adjust_delta.get }
}

pub fn line(name: String, expected: I32, actual: I32, delta: I32, status: String) -> Line {
  (
  , Line_name.mk(name)
  , Line_expected.mk(expected)
  , Line_actual.mk(actual)
  , Line_delta.mk(delta)
  , Line_status.mk(status)
  )
}

pub fn line_name_of(row: Line) -> String {
  row.>select { Line_name.get }
}

pub fn line_expected_of(row: Line) -> I32 {
  row.>select { Line_expected.get }
}

pub fn line_actual_of(row: Line) -> I32 {
  row.>select { Line_actual.get }
}

pub fn line_delta_of(row: Line) -> I32 {
  row.>select { Line_delta.get }
}

pub fn line_status_of(row: Line) -> String {
  row.>select { Line_status.get }
}

pub fn totals(ok: I32, missing: I32, skewed: I32, unknown: I32) -> Totals {
  (Total_ok.mk(ok), Total_missing.mk(missing), Total_skewed.mk(skewed), Total_unknown.mk(unknown))
}

pub fn totals_ok(row: Totals) -> I32 {
  row.>select { Total_ok.get }
}

pub fn totals_missing(row: Totals) -> I32 {
  row.>select { Total_missing.get }
}

pub fn totals_skewed(row: Totals) -> I32 {
  row.>select { Total_skewed.get }
}

pub fn totals_unknown(row: Totals) -> I32 {
  row.>select { Total_unknown.get }
}

pub fn report(
, bolt: Line
, gear: Line
, seal: Line
, panel: Line
, valve: Line
, unknown: Line
, totals_value: Totals
) -> Report {
  (
  , Report_bolt.mk(bolt)
  , Report_gear.mk(gear)
  , Report_seal.mk(seal)
  , Report_panel.mk(panel)
  , Report_valve.mk(valve)
  , Report_unknown.mk(unknown)
  , Report_totals.mk(totals_value)
  )
}

pub fn report_bolt_of(row: Report) -> Line {
  row.>select { Report_bolt.get }
}

pub fn report_gear_of(row: Report) -> Line {
  row.>select { Report_gear.get }
}

pub fn report_seal_of(row: Report) -> Line {
  row.>select { Report_seal.get }
}

pub fn report_panel_of(row: Report) -> Line {
  row.>select { Report_panel.get }
}

pub fn report_valve_of(row: Report) -> Line {
  row.>select { Report_valve.get }
}

pub fn report_unknown_of(row: Report) -> Line {
  row.>select { Report_unknown.get }
}

pub fn report_totals_of(row: Report) -> Totals {
  row.>select { Report_totals.get }
}
