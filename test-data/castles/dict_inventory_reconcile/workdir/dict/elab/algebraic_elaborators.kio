pure fn atom_impl(ct: __Comptime__, source: __Type__, value: __Checked_term__, target: __Type__) -> Elaborator_result {
  __either__(
    , Dnf_branch
    , .
    , Elaborator_result
    , single_dnf_branch(ct, dnf_branches(ct, target))
    , .(_target_branch: Dnf_branch) -> Elaborator_result {
        algebraic_impl(
          , ct
          , source
          , target
