/// The recalculation engine. A full pass evaluates every cell; an edit only
/// the cells that can observe it. The plan is rebuilt after each edit because
/// an edit can change the graph itself: replacing a formula can break a
/// cycle, or close one.
mod sheet/recalc;

import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import sheet/addr { type Addr; fn all_addrs; fn cell_count; fn mem }
import sheet/cells { fn formula_content; fn number_content; fn set_content; fn set_value }
import sheet/cells { type Sheet; type Values; fn blank_content; fn cycle_value; fn empty_values }
import sheet/eval { fn eval_cell }
import sheet/formula { type Expr }
import sheet/graph { type Deps; fn build_deps; fn cycle_cells; fn deps_of; fn topo_order }
import sheet/list { type List; fn append; fn cons; fn filter; fn len; fn nil; fn one }
import testapi { type Bool; type I32 }
import testapi/arith { fn sub_i32 }
import testapi/iter { fn loop }

pub type Change = { Put_number: I32 } | { Put_formula: Expr } | { Clear: . };

pub type Edit = { Edit_at: Addr; Edit_kind: Change };

pub fn number_edit(a: Addr, n: I32) -> Edit {
  (Edit_at.mk(a), Edit_kind.mk((Put_number.mk(n).>widen_sum)[Change]))
}

pub fn formula_edit(a: Addr, e: Expr) -> Edit {
  (Edit_at.mk(a), Edit_kind.mk((Put_formula.mk(e).>widen_sum)[Change]))
}

pub fn clear_edit(a: Addr) -> Edit {
  (Edit_at.mk(a), Edit_kind.mk((Clear.mk(()).>widen_sum)[Change]))
}

pub fn edit_addr(e: Edit) -> Addr {
  e.>select { Edit_at.get }
}

pub fn fold_edit[R](e: Edit, on_number: I32 -> R, on_formula: Expr -> R, on_clear: R) -> R {
  let change = e.>select { Edit_kind.get };
  match(change) {
    (
    , .(n: Put_number) {
        on_number(n.>select { Put_number.get })
      }
    , .(f: Put_formula) {
        on_formula(f.>select { Put_formula.get })
      }
    , .(_c: Clear) { on_clear }
    )
  }
}

fn apply_edit(s: Sheet, e: Edit) -> Sheet {
  set_content(
  , s
  , edit_addr(e)
  , fold_edit(
    , e
    , .(n: I32) { number_content(n) }
    , .(x: Expr) { formula_content(x) }
    , blank_content()
    )
  )
}

/// The current sheet's shape: inverted edges, cycle, evaluation order.
pub type Plan = { Plan_deps: Deps; Plan_cycle: List[Addr]; Plan_order: List[Addr] };

pub fn build_plan(s: Sheet) -> Plan {
  let edges = build_deps(s);
  let cyc = cycle_cells(s);
  (Plan_deps.mk(edges), Plan_cycle.mk(cyc), Plan_order.mk(topo_order(s, edges, cyc)))
}

pub fn plan_cycle(p: Plan) -> List[Addr] {
  p.>select { Plan_cycle.get }
}

pub fn plan_order(p: Plan) -> List[Addr] {
  p.>select { Plan_order.get }
}

/// Evaluate `todo` in order, threading each result into the store the next
/// cell reads. A cell on a cycle has no well-founded value to compute, so it
/// is settled as `#CYCLE` instead.
rec(loop) fn eval_onto(s: Sheet, cyc: List[Addr], todo: List[Addr], vals: Values) -> Values {
  match(todo.>List.get) {
    (
    , .(a: Addr, rest: List[Addr]) {
        if(mem(cyc, a)) {
          recur eval_onto(s, cyc, rest, set_value(vals, a, cycle_value()))
        } else {
          recur eval_onto(s, cyc, rest, set_value(vals, a, eval_cell(s, vals, a)))
        }
      }
    , .(_empty: .) { vals }
    )
  }
}

/// The opening pass: settle the cycling cells, then evaluate the rest once.
pub fn full_eval(s: Sheet, p: Plan) -> Values {
  eval_onto(s, plan_cycle(p), append(plan_cycle(p), plan_order(p)), empty_values())
}

rec(loop) fn close(deps: Deps, frontier: List[Addr], seen: List[Addr]) -> List[Addr] {
  match(frontier.>List.get) {
    (
    , .(a: Addr, rest: List[Addr]) {
        if(mem(seen, a)) {
          recur close(deps, rest, seen)
        } else {
          recur close(deps, append(rest, deps_of(deps, a)), cons(a, seen))
        }
      }
    , .(_empty: .) { seen }
    )
  }
}

/// The cells an edit at `a` can change: `a` itself, plus everything that
/// reads it, transitively. Nothing else can observe the edit, so nothing else
/// is recomputed. Skipping seen cells is what lets the walk close over a
/// graph that cycles.
pub fn dirty_set(deps: Deps, a: Addr) -> List[Addr] {
  let seen = close(deps, one(a), nil[Addr]);
  filter(all_addrs(), .(c: Addr) { mem(seen, c) })
}

pub type Step = {
  Step_sheet: Sheet;
  Step_values: Values;
  Step_plan: Plan;
  Step_dirty: List[Addr];
  Step_order: List[Addr];
  Step_recomputed: I32;
  Step_skipped: I32
};

pub fn step_sheet(st: Step) -> Sheet {
  st.>select { Step_sheet.get }
}

pub fn step_values(st: Step) -> Values {
  st.>select { Step_values.get }
}

pub fn step_plan(st: Step) -> Plan {
  st.>select { Step_plan.get }
}

pub fn step_dirty(st: Step) -> List[Addr] {
  st.>select { Step_dirty.get }
}

pub fn step_order(st: Step) -> List[Addr] {
  st.>select { Step_order.get }
}

pub fn step_recomputed(st: Step) -> I32 {
  st.>select { Step_recomputed.get }
}

pub fn step_skipped(st: Step) -> I32 {
  st.>select { Step_skipped.get }
}

/// Apply one edit and recompute the minimum: the dirty cells on a cycle
/// first (settled, not computed), then the dirty cells in the new topological
/// order, so each reads precedents that are already up to date. The two lists
/// partition the dirty set, so the recomputed count is exactly its size.
pub fn recalc(s: Sheet, vals: Values, e: Edit) -> Step {
  let next = apply_edit(s, e);
  let p = build_plan(next);
  let dirty = dirty_set(p.>select { Plan_deps.get }, edit_addr(e));
  let settled = filter(plan_cycle(p), .(a: Addr) { mem(dirty, a) });
  let computed = filter(plan_order(p), .(a: Addr) { mem(dirty, a) });
  let order = append(settled, computed);
  let vals2 = eval_onto(next, plan_cycle(p), order, vals);
  let count = len(order);
  (
  , Step_sheet.mk(next)
  , Step_values.mk(vals2)
  , Step_plan.mk(p)
  , Step_dirty.mk(dirty)
  , Step_order.mk(order)
  , Step_recomputed.mk(count)
  , Step_skipped.mk(sub_i32(cell_count(), count))
  )
}
