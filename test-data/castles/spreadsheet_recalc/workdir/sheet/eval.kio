/// Evaluating one cell against the values already computed for the cells it
/// reads. The evaluator never recurses into another cell — a reference
/// reads the value store — which is what the topological order buys: one
/// pass per cell. Every combinator hands the cycle error on, so a cell
/// downstream of a cycle gets `#CYCLE` by ordinary evaluation.
mod sheet/eval;

import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import sheet/addr { type Addr }
import sheet/cells {
  type Sheet;
  type Value;
  type Values;
  fn content_at;
  fn cycle_value;
  fn fold_content
}
import sheet/cells { fn fold_value; fn num_value; fn value_at; fn void_value }
import sheet/formula {
  type Add_l;
  type Add_r;
  type Expr;
  type If_c;
  type If_e;
  type If_t;
  type Lit;
  type Max_hi;
  type Max_lo
}
import sheet/formula {
  type Mul_l;
  type Mul_r;
  type Ref_at;
  type Sub_l;
  type Sub_r;
  type Sum_hi;
  type Sum_lo;
  fn range_cells
}
import sheet/list { type List }
import testapi { type Bool; type I32 }
import testapi/arith { fn add_i32; fn eq_i32; fn lt_i32; fn mul_i32; fn sub_i32 }
import testapi/iter { fn loop }

/// What an expression is worth: a number, or the cycle error.
type Ev = { Ok: I32 } | { Bad: . };

/// What one cell contributes to an aggregate.
type Slot = { Got: I32 } | { None: . } | { Err: . };

fn ok(n: I32) -> Ev { (Ok.mk(n).>widen_sum)[Ev] }

fn bad() -> Ev { (Bad.mk(()).>widen_sum)[Ev] }

fn fold_ev[R](e: Ev, on_ok: I32 -> R, on_bad: R) -> R {
  match(e) {
    (
    , .(n: Ok) {
        on_ok(n.>select { Ok.get })
      }
    , .(_b: Bad) { on_bad }
    )
  }
}

fn slot_at(vals: Values, a: Addr) -> Slot {
  fold_value(
  , value_at(vals, a)
  , .(n: I32) { (Got.mk(n).>widen_sum)[Slot] }
  , (None.mk(()).>widen_sum)[Slot]
  , (Err.mk(()).>widen_sum)[Slot]
  )
}

/// An empty cell counts as zero, the way a spreadsheet reads a blank
/// operand.
fn ev_at(vals: Values, a: Addr) -> Ev {
  fold_value(value_at(vals, a), .(n: I32) { ok(n) }, ok(0), bad())
}

fn bin(left: Ev, right: Ev, op: (I32 & I32) -> I32) -> Ev {
  fold_ev(
  , left
  , .(a: I32) {
      fold_ev(right, .(b: I32) { ok(op(a, b)) }, bad())
    }
  , bad()
  )
}

/// `SUM`: blanks contribute nothing, one error poisons the total.
rec(loop) fn sum_onto(vals: Values, cells: List[Addr], acc: I32) -> Ev {
  match(cells.>List.get) {
    (
    , .(a: Addr, rest: List[Addr]) {
        match(slot_at(vals, a)) {
          (
          , .(g: Got) {
              recur sum_onto(vals, rest, add_i32(acc, g.>select { Got.get }))
            }
          , .(_n: None) { recur sum_onto(vals, rest, acc) }
          , .(_e: Err) { bad() }
          )
        }
      }
    , .(_empty: .) { ok(acc) }
    )
  }
}

/// `MAX`: blanks are not candidates, and a range with no number is zero.
rec(loop) fn max_onto(vals: Values, cells: List[Addr], best: I32, seen: Bool) -> Ev {
  match(cells.>List.get) {
    (
    , .(a: Addr, rest: List[Addr]) {
        match(slot_at(vals, a)) {
          (
          , .(g: Got) {
              if(seen) {
                if(lt_i32(best, g.>select { Got.get })) {
                  recur max_onto(vals, rest, g.>select { Got.get }, .t)
                } else {
                  recur max_onto(vals, rest, best, .t)
                }
              } else {
                recur max_onto(vals, rest, g.>select { Got.get }, .t)
              }
            }
          , .(_n: None) { recur max_onto(vals, rest, best, seen) }
          , .(_e: Err) { bad() }
          )
        }
      }
    , .(_empty: .) {
        if(seen) { ok(best) } else { ok(0) }
      }
    )
  }
}

rec(loop) fn eval_expr(vals: Values, e: Expr) -> Ev {
  match(e.>Expr.get) {
    (
    , .(r: Ref_at) {
        ev_at(vals, r.>select { Ref_at.get })
      }
    , .(n: Lit) {
        ok(n.>select { Lit.get })
      }
    , .(left: Add_l, right: Add_r) {
        let a = recur(cont) eval_expr(vals, left.>select { Add_l.get });
        let b = recur(cont) eval_expr(vals, right.>select { Add_r.get });
        bin(a, b, add_i32)
      }
    , .(left: Sub_l, right: Sub_r) {
        let a = recur(cont) eval_expr(vals, left.>select { Sub_l.get });
        let b = recur(cont) eval_expr(vals, right.>select { Sub_r.get });
        bin(a, b, sub_i32)
      }
    , .(left: Mul_l, right: Mul_r) {
        let a = recur(cont) eval_expr(vals, left.>select { Mul_l.get });
        let b = recur(cont) eval_expr(vals, right.>select { Mul_r.get });
        bin(a, b, mul_i32)
      }
    , .(lo: Sum_lo, hi: Sum_hi) {
        sum_onto(vals, range_cells(lo.>select { Sum_lo.get }, hi.>select { Sum_hi.get }), 0)
      }
    , .(lo: Max_lo, hi: Max_hi) {
        max_onto(vals, range_cells(lo.>select { Max_lo.get }, hi.>select { Max_hi.get }), 0, .f)
      }
    , .(cond: If_c, then_arm: If_t, else_arm: If_e) {
        let test = recur(cont) eval_expr(vals, cond.>select { If_c.get });
        match(test) {
          (
          , .(n: Ok) {
              if(eq_i32(n.>select { Ok.get }, 0)) {
                recur eval_expr(vals, else_arm.>select { If_e.get })
              } else {
                recur eval_expr(vals, then_arm.>select { If_t.get })
              }
            }
          , .(_b: Bad) { bad() }
          )
        }
      }
    )
  }
}

pub fn eval_cell(s: Sheet, vals: Values, a: Addr) -> Value {
  fold_content(
  , content_at(s, a)
  , void_value()
  , .(n: I32) { num_value(n) }
  , .(e: Expr) {
      fold_ev(eval_expr(vals, e), .(n: I32) { num_value(n) }, cycle_value())
    }
  )
}
