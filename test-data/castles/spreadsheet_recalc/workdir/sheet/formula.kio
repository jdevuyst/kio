/// The formula language: the expression tree, the precedent walk that turns a
/// formula into graph edges, and its concrete syntax. Nothing here evaluates —
/// `sheet/eval` interprets the tree.
module sheet/formula;

import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import macros/spine_macros(macro widen_sum);
import sheet/addr(Addr, add_all, add_unique, addr_name, col_of, make_addr, row_of);
import sheet/list(List, cons, nil);
import testapi(Bool, I32, String);
import testapi/arith(lt_i32, sub_i32);
import testapi/fmt(int_to_string);
import testapi/iter(loop);
import testapi/text(string_concat);

rec {
  pub type Expr_node =
    | { Ref_at: Addr }
    | { Lit: I32 }
    | { Add_l: Expr; Add_r: Expr }
    | { Sub_l: Expr; Sub_r: Expr }
    | { Mul_l: Expr; Mul_r: Expr }
    | { Sum_lo: Addr; Sum_hi: Addr }
    | { Max_lo: Addr; Max_hi: Addr }
    | { If_c: Expr; If_t: Expr; If_e: Expr };
  pub type { Expr: Expr_node { pub mk; pub get } }
}

pub fn cell_ref(a: Addr) -> Expr { Expr.mk((Ref_at.mk(a).>widen_sum)[Expr_node]) }

pub fn lit_num(n: I32) -> Expr { Expr.mk((Lit.mk(n).>widen_sum)[Expr_node]) }

pub fn add(left: Expr, right: Expr) -> Expr {
  Expr.mk(((Add_l.mk(left), Add_r.mk(right)).>widen_sum)[Expr_node])
}

pub fn sub(left: Expr, right: Expr) -> Expr {
  Expr.mk(((Sub_l.mk(left), Sub_r.mk(right)).>widen_sum)[Expr_node])
}

pub fn mul(left: Expr, right: Expr) -> Expr {
  Expr.mk(((Mul_l.mk(left), Mul_r.mk(right)).>widen_sum)[Expr_node])
}

pub fn sum_range(lo: Addr, hi: Addr) -> Expr {
  Expr.mk(((Sum_lo.mk(lo), Sum_hi.mk(hi)).>widen_sum)[Expr_node])
}

pub fn max_range(lo: Addr, hi: Addr) -> Expr {
  Expr.mk(((Max_lo.mk(lo), Max_hi.mk(hi)).>widen_sum)[Expr_node])
}

pub fn if_else(cond: Expr, then_arm: Expr, else_arm: Expr) -> Expr {
  Expr.mk(((If_c.mk(cond), If_t.mk(then_arm), If_e.mk(else_arm)).>widen_sum)[Expr_node])
}

rec(loop) fn block_onto(lo: Addr, hi: Addr, row: I32, col: I32, acc: List[Addr]) -> List[Addr] {
  if(lt_i32(row, row_of(lo))) {
    acc
  } else if(lt_i32(col, col_of(lo))) {
    recur block_onto(lo, hi, sub_i32(row, 1), col_of(hi), acc)
  } else {
    recur block_onto(lo, hi, row, sub_i32(col, 1), cons(make_addr(row, col), acc))
  }
}

/// Every address in the rectangle `lo`..`hi`, row-major.
pub fn range_cells(lo: Addr, hi: Addr) -> List[Addr] {
  block_onto(lo, hi, row_of(hi), col_of(hi), nil[Addr])
}

/// The cells this formula reads, in first-mention order. Each address lands
/// once, so an aggregate overlapping an explicit reference is still one edge.
pub rec(loop) fn precedents_onto(e: Expr, acc: List[Addr]) -> List[Addr] {
  match(e.>Expr.get) {
    (
    , .(r: Ref_at) {
        add_unique(acc, r.>select { Ref_at.get })
      }
    , .(_n: Lit) { acc }
    , .(left: Add_l, right: Add_r) {
        let seen = recur(cont) precedents_onto(left.>select { Add_l.get }, acc);
        recur precedents_onto(right.>select { Add_r.get }, seen)
      }
    , .(left: Sub_l, right: Sub_r) {
        let seen = recur(cont) precedents_onto(left.>select { Sub_l.get }, acc);
        recur precedents_onto(right.>select { Sub_r.get }, seen)
      }
    , .(left: Mul_l, right: Mul_r) {
        let seen = recur(cont) precedents_onto(left.>select { Mul_l.get }, acc);
        recur precedents_onto(right.>select { Mul_r.get }, seen)
      }
    , .(lo: Sum_lo, hi: Sum_hi) {
        add_all(acc, range_cells(lo.>select { Sum_lo.get }, hi.>select { Sum_hi.get }))
      }
    , .(lo: Max_lo, hi: Max_hi) {
        add_all(acc, range_cells(lo.>select { Max_lo.get }, hi.>select { Max_hi.get }))
      }
    , .(cond: If_c, then_arm: If_t, else_arm: If_e) {
        let after_cond = recur(cont) precedents_onto(cond.>select { If_c.get }, acc);
        let after_then = recur(cont) precedents_onto(then_arm.>select { If_t.get }, after_cond);
        recur precedents_onto(else_arm.>select { If_e.get }, after_then)
      }
    )
  }
}

pub fn precedents(e: Expr) -> List[Addr] { precedents_onto(e, nil[Addr]) }

fn cat3(a: String, b: String, c: String) -> String { string_concat(string_concat(a, b), c) }

fn infix(left: String, op: String, right: String) -> String {
  cat3("(", cat3(left, op, right), ")")
}

fn aggregate(name: String, lo: Addr, hi: Addr) -> String {
  cat3(name, cat3("(", cat3(addr_name(lo), ":", addr_name(hi)), ")"), "")
}

/// The formula as a user would write it.
pub rec(loop) fn render_expr(e: Expr) -> String {
  match(e.>Expr.get) {
    (
    , .(r: Ref_at) {
        addr_name(r.>select { Ref_at.get })
      }
    , .(n: Lit) {
        int_to_string(n.>select { Lit.get })
      }
    , .(left: Add_l, right: Add_r) {
        infix(
        , recur(cont) render_expr(left.>select { Add_l.get })
        , " + "
        , recur(cont) render_expr(right.>select { Add_r.get })
        )
      }
    , .(left: Sub_l, right: Sub_r) {
        infix(
        , recur(cont) render_expr(left.>select { Sub_l.get })
        , " - "
        , recur(cont) render_expr(right.>select { Sub_r.get })
        )
      }
    , .(left: Mul_l, right: Mul_r) {
        infix(
        , recur(cont) render_expr(left.>select { Mul_l.get })
        , " * "
        , recur(cont) render_expr(right.>select { Mul_r.get })
        )
      }
    , .(lo: Sum_lo, hi: Sum_hi) {
        aggregate("SUM", lo.>select { Sum_lo.get }, hi.>select { Sum_hi.get })
      }
    , .(lo: Max_lo, hi: Max_hi) {
        aggregate("MAX", lo.>select { Max_lo.get }, hi.>select { Max_hi.get })
      }
    , .(cond: If_c, then_arm: If_t, else_arm: If_e) {
        cat3(
        , "IF("
        , cat3(
          , recur(cont) render_expr(cond.>select { If_c.get })
          , ", "
          , cat3(
            , recur(cont) render_expr(then_arm.>select { If_t.get })
            , ", "
            , recur(cont) render_expr(else_arm.>select { If_e.get })
            )
          )
        , ")"
        )
      }
    )
  }
}
