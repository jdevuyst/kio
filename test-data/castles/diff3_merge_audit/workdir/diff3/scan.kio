/// Reading the three-section document from stdin.
///
/// The fixture is a document, not a command stream: a `#base` / `#ours` /
/// `#theirs` marker line opens a section and every following line belongs
/// to it verbatim. Lines ahead of the first marker belong to no section
/// and are dropped, so a stray leading blank line cannot shift a document.
mod diff3/scan;

import diff3/list as list;
import diff3/prim as prim;
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro record; macro select }
import testapi { type Bool; type I32; type String }
import testapi/io { fn read_ascii_line }
import testapi/iter { fn loop }
import testapi/text { fn string_eq }

pub type Doc = { Base: list.List[String]; Ours: list.List[String]; Theirs: list.List[String] };

/// Sections are collected head-first and reversed once at the end, so a
/// line costs one cons rather than a walk to the end of a growing list.
type Cursor = {
  Section: I32;
  Base_rev: list.List[String];
  Ours_rev: list.List[String];
  Theirs_rev: list.List[String]
};

fn start() -> Cursor {
  record {
    Section.mk(0);
    Base_rev.mk(list.nil[String]);
    Ours_rev.mk(list.nil[String]);
    Theirs_rev.mk(list.nil[String])
  }
}

fn open_section(cursor: Cursor, next: I32) -> Cursor {
  let .(base_rev, ours_rev, theirs_rev) =
    cursor.>select { Base_rev.get; Ours_rev.get; Theirs_rev.get };
  record {
    Section.mk(next);
    Base_rev.mk(base_rev);
    Ours_rev.mk(ours_rev);
    Theirs_rev.mk(theirs_rev)
  }
}

fn keep(cursor: Cursor, line: String) -> Cursor {
  let .(section, base_rev, ours_rev, theirs_rev) =
    cursor.>select { Section.get; Base_rev.get; Ours_rev.get; Theirs_rev.get };
  if(prim.int_eq(section, 1)) {
    record {
      Section.mk(section);
      Base_rev.mk(list.cons(line, base_rev));
      Ours_rev.mk(ours_rev);
      Theirs_rev.mk(theirs_rev)
    }
  } else if(prim.int_eq(section, 2)) {
    record {
      Section.mk(section);
      Base_rev.mk(base_rev);
      Ours_rev.mk(list.cons(line, ours_rev));
      Theirs_rev.mk(theirs_rev)
    }
  } else if(prim.int_eq(section, 3)) {
    record {
      Section.mk(section);
      Base_rev.mk(base_rev);
      Ours_rev.mk(ours_rev);
      Theirs_rev.mk(list.cons(line, theirs_rev))
    }
  } else {
    cursor
  }
}

fn step(cursor: Cursor, line: String) -> Cursor {
  if(string_eq(line, "#base")) {
    open_section(cursor, 1)
  } else if(string_eq(line, "#ours")) {
    open_section(cursor, 2)
  } else if(string_eq(line, "#theirs")) {
    open_section(cursor, 3)
  } else {
    keep(cursor, line)
  }
}

rec(loop) fn drain(cursor: Cursor) -> Cursor {
  match(read_ascii_line()) {
    (.(line: String) { recur drain(step(cursor, line)) }, .(_eof: .) { cursor })
  }
}

pub fn read_document() -> Doc {
  let .(base_rev, ours_rev, theirs_rev) =
    drain(start()).>select { Base_rev.get; Ours_rev.get; Theirs_rev.get };
  record {
    Base.mk(list.reverse(base_rev));
    Ours.mk(list.reverse(ours_rev));
    Theirs.mk(list.reverse(theirs_rev))
  }
}

pub fn base_lines(doc: Doc) -> list.List[String] {
  doc.>select { Base.get }
}

pub fn our_lines(doc: Doc) -> list.List[String] {
  doc.>select { Ours.get }
}

pub fn their_lines(doc: Doc) -> list.List[String] {
  doc.>select { Theirs.get }
}
