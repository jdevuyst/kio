module http_status_window/render;

import http_status_window/strings as s;
import http_status_window/window(Entry, {bytes}, {family}, {method}, {ordinal}, {path}, {status});
import testapi(String);

pub fn entry(entry: Entry) -> String {
  let .({
    , ordinal as id
    , method as verb
    , path as resource
    , status as code
    , bytes as size
    , family as class
    }) = entry;
  s.cat7(
    , "  "
    , id
    , " "
    , verb
    , " "
    , resource
    , s.cat7(" -> ", code, " ", class, " bytes=", size, "\n")
    )
}
