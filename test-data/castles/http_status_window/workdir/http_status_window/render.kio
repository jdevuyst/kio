mod http_status_window/render;

import http_status_window/strings as s;
import http_status_window/window {
  type Bytes;
  type Entry;
  type Family;
  type Method;
  type Ordinal;
  type Path;
  type Status
}
import macros/row_macros { macro select }
import testapi { type String }

pub fn entry(entry: Entry) -> String {
  let .(id, verb, resource, code, size, class) =
    entry.>select { Ordinal.get; Method.get; Path.get; Status.get; Bytes.get; Family.get };
  s.cat7(
  , "  "
  , id
  , " "
  , verb
  , " "
  , resource
  , s.cat7(" -> ", code, " ", class, " bytes=", size, "\n")
  )
}
