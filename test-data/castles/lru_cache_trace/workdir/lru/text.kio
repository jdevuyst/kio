module lru/text;

import testapi(Bool, I32, String);
import testapi/fmt(bool_to_string, int_to_string);
import testapi/text(string_concat);

pub fn int_text(n: I32) -> String { int_to_string(n) }

pub fn bool_text(v: Bool) -> String { bool_to_string(v) }

pub fn cat2(a: String, b: String) -> String { string_concat(a, b) }

pub fn cat3(a: String, b: String, c: String) -> String { cat2(cat2(a, b), c) }

pub fn cat4(a: String, b: String, c: String, d: String) -> String { cat2(cat3(a, b, c), d) }

pub fn cat5(a: String, b: String, c: String, d: String, e: String) -> String {
  cat2(cat4(a, b, c, d), e)
}

pub fn cat6(a: String, b: String, c: String, d: String, e: String, f: String) -> String {
  cat2(cat5(a, b, c, d, e), f)
}
