package replica_vector_clock_lab;

build {
  cache ();

  target js {
    out "out/js"
  };

  target ts {
    out "out/ts"
  };

  target python {
    out "out/python"
  };

  target java {
    out "out/java"
  };

  target rust {
    out "out/rust"
  };

  target go {
    out "out/go"
  };

  target swift {
    out "out/swift"
  };

  target haskell {
    out "out/haskell"
  }
}

bridge {
  testapi;
  testapi/**;
  elab/testapi;
  list/elab/testapi;
  dict/elab/testapi;
  result/elab/testapi
}
