module testapi/main;

import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro record, macro select);
import testapi(Bool, I32, String);
import testapi/arith(add_i32, leq_i32, lt_i32, sub_i32);
import testapi/fmt(i32_to_string);
import testapi/io(print, read_ascii_line);
import testapi/iter(loop);
import testapi/text(string_concat, string_eq);

type Audit_fields = {
  Phase: I32;
  Balance: I32;
  Credit: I32;
  Debit: I32;
  Checks: I32;
  Errors: I32;
  Lines: I32
};

type { Audit_state: Phase & Balance & Credit & Debit & Checks & Errors & Lines { mk; get } }

fn int_eq(left: I32, right: I32) -> Bool {
  if(leq_i32(left, right)) { leq_i32(right, left) } else { .f }
}

fn initial() -> Audit_state {
  Audit_state.mk(record {
    Phase.mk(0);
    Balance.mk(0);
    Credit.mk(0);
    Debit.mk(0);
    Checks.mk(0);
    Errors.mk(0);
    Lines.mk(0)
  })
}

fn add_line(st: Audit_state) -> Audit_state {
  let .(phase, balance, credit, debit, checks, errors, lines) =
    Audit_state.get(st).>select {
      Phase.get;
      Balance.get;
      Credit.get;
      Debit.get;
      Checks.get;
      Errors.get;
      Lines.get
    };
  Audit_state.mk(record {
    Phase.mk(phase);
    Balance.mk(balance);
    Credit.mk(credit);
    Debit.mk(debit);
    Checks.mk(checks);
    Errors.mk(errors);
    Lines.mk(add_i32(lines, 1))
  })
}

fn add_error(st: Audit_state) -> Audit_state {
  let .(phase, balance, credit, debit, checks, errors, lines) =
    Audit_state.get(st).>select {
      Phase.get;
      Balance.get;
      Credit.get;
      Debit.get;
      Checks.get;
      Errors.get;
      Lines.get
    };
  Audit_state.mk(record {
    Phase.mk(phase);
    Balance.mk(balance);
    Credit.mk(credit);
    Debit.mk(debit);
    Checks.mk(checks);
    Errors.mk(add_i32(errors, 1));
    Lines.mk(lines)
  })
}

fn is_phase(st: Audit_state, expected: I32) -> Bool {
  int_eq(Audit_state.get(st).>select { Phase.get }, expected)
}

fn is_clean(st: Audit_state) -> Bool {
  int_eq(Audit_state.get(st).>select { Errors.get }, 0)
}

fn balance_value(st: Audit_state) -> I32 {
  Audit_state.get(st).>select { Balance.get }
}

fn credit_value(st: Audit_state) -> I32 {
  Audit_state.get(st).>select { Credit.get }
}

fn debit_value(st: Audit_state) -> I32 {
  Audit_state.get(st).>select { Debit.get }
}

fn checks_value(st: Audit_state) -> I32 {
  Audit_state.get(st).>select { Checks.get }
}

fn errors_value(st: Audit_state) -> I32 {
  Audit_state.get(st).>select { Errors.get }
}

fn lines_value(st: Audit_state) -> I32 {
  Audit_state.get(st).>select { Lines.get }
}

fn set_phase(st: Audit_state, next_phase: I32) -> Audit_state {
  let .(balance, credit, debit, checks, errors, lines) =
    Audit_state.get(st).>select {
      Balance.get;
      Credit.get;
      Debit.get;
      Checks.get;
      Errors.get;
      Lines.get
    };
  Audit_state.mk(record {
    Phase.mk(next_phase);
    Balance.mk(balance);
    Credit.mk(credit);
    Debit.mk(debit);
    Checks.mk(checks);
    Errors.mk(errors);
    Lines.mk(lines)
  })
}

fn add_check(st: Audit_state) -> Audit_state {
  let .(phase, balance, credit, debit, checks, errors, lines) =
    Audit_state.get(st).>select {
      Phase.get;
      Balance.get;
      Credit.get;
      Debit.get;
      Checks.get;
      Errors.get;
      Lines.get
    };
  Audit_state.mk(record {
    Phase.mk(phase);
    Balance.mk(balance);
    Credit.mk(credit);
    Debit.mk(debit);
    Checks.mk(add_i32(checks, 1));
    Errors.mk(errors);
    Lines.mk(lines)
  })
}

fn add_credit(st: Audit_state, amount: I32) -> Audit_state {
  let .(phase, balance, credit, debit, checks, errors, lines) =
    Audit_state.get(st).>select {
      Phase.get;
      Balance.get;
      Credit.get;
      Debit.get;
      Checks.get;
      Errors.get;
      Lines.get
    };
  Audit_state.mk(record {
    Phase.mk(phase);
    Balance.mk(add_i32(balance, amount));
    Credit.mk(add_i32(credit, amount));
    Debit.mk(debit);
    Checks.mk(checks);
    Errors.mk(errors);
    Lines.mk(lines)
  })
}

fn add_debit(st: Audit_state, amount: I32) -> Audit_state {
  let .(phase, balance, credit, debit, checks, errors, lines) =
    Audit_state.get(st).>select {
      Phase.get;
      Balance.get;
      Credit.get;
      Debit.get;
      Checks.get;
      Errors.get;
      Lines.get
    };
  let magnitude = sub_i32(0, amount);
  Audit_state.mk(record {
    Phase.mk(phase);
    Balance.mk(add_i32(balance, amount));
    Credit.mk(credit);
    Debit.mk(add_i32(debit, magnitude));
    Checks.mk(checks);
    Errors.mk(errors);
    Lines.mk(lines)
  })
}

fn finish_state(st: Audit_state) -> Audit_state {
  if(is_phase(st, 2)) { st } else { add_error(st) }
}

fn begin(st: Audit_state) -> Audit_state {
  if(is_phase(st, 0)) { set_phase(st, 1) } else { add_error(st) }
}

fn finish(st: Audit_state) -> Audit_state {
  if(is_phase(st, 1)) { set_phase(st, 2) } else { add_error(st) }
}

fn checkpoint(st: Audit_state) -> Audit_state {
  if(is_phase(st, 1)) { add_check(st) } else { add_error(st) }
}

fn amount(st: Audit_state, value: I32) -> Audit_state {
  if(is_phase(st, 1)) {
    if(lt_i32(value, 0)) { add_debit(st, value) } else { add_credit(st, value) }
  } else {
    add_error(st)
  }
}

fn apply_line(line: String, st: Audit_state) -> Audit_state {
  let next = add_line(st);
  if(string_eq(line, "BEGIN")) {
    begin(next)
  } else if(string_eq(line, "END")) {
    finish(next)
  } else if(string_eq(line, "CHECK")) {
    checkpoint(next)
  } else if(string_eq(line, "CREDIT 12")) {
    amount(next, 12)
  } else if(string_eq(line, "DEBIT 5")) {
    amount(next, -5)
  } else if(string_eq(line, "CREDIT 7")) {
    amount(next, 7)
  } else {
    add_error(next)
  }
}

rec(loop) fn replay(fields: Phase & Balance & Credit & Debit & Checks & Errors & Lines) ->
  Phase & Balance & Credit & Debit & Checks & Errors & Lines
   {
  match(read_ascii_line()) {
    (
    , .(line: String) {
        let next = apply_line(line, Audit_state.mk(fields));
        recur replay(Audit_state.get(next))
      }
    , .(_eof: .) { fields }
    )
  }
}

fn print_metric(label: String, value: String) {
  print(value.>string_concat("\n").>>string_concat(label))
}

fn print_report(st: Audit_state) {
  print("stdin replay audit\n");
  print_metric("lines: ", i32_to_string(lines_value(st)));
  print_metric("credits: ", i32_to_string(credit_value(st)));
  print_metric("debits: ", i32_to_string(debit_value(st)));
  print_metric("checks: ", i32_to_string(checks_value(st)));
  print_metric("balance: ", i32_to_string(balance_value(st)));
  print_metric("errors: ", i32_to_string(errors_value(st)));
  if(is_phase(st, 2)) {
    if(is_clean(st)) { print("status: OK\n") } else { print("status: REJECTED\n") }
  } else {
    print("status: REJECTED\n")
  }
}

pub fn main() {
  let final_state = finish_state(Audit_state.mk(replay(Audit_state.get(initial()))));
  print_report(final_state)
}
