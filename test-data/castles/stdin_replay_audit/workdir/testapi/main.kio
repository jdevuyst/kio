module testapi/main;

import elab/control(if);
import elab/match(match);
import testapi(Bool, I32, String);
import testapi/arith(add_i32, leq_i32, lt_i32, sub_i32);
import testapi/fmt(i32_to_string);
import testapi/io(print, read_ascii_line);
import testapi/iter(loop);
import testapi/text(string_concat, string_eq);

labels Audit_fields = {
  , phase: I32
  , balance: I32
  , credit: I32
  , debit: I32
  , checks: I32
  , errors: I32
  , lines: I32
  };

newtype Audit_state : Phase & Balance & Credit & Debit & Checks & Errors & Lines {
  constructor pack;
  projector unpack
  }

fn int_eq(left: I32, right: I32) -> Bool {
  if! leq_i32(left, right) {
    leq_i32(right, left)
  } else {
    .f
  }
}

fn initial() -> Audit_state {
  Audit_state.pack({
    , phase = 0
    , balance = 0
    , credit = 0
    , debit = 0
    , checks = 0
    , errors = 0
    , lines = 0
    })
}

fn add_line(st: Audit_state) -> Audit_state {
  let .({phase, balance, credit, debit, checks, errors, lines}) = Audit_state.unpack(st);
  Audit_state.pack({phase, balance, credit, debit, checks, errors, lines = add_i32(lines, 1)})
}

fn add_error(st: Audit_state) -> Audit_state {
  let .({phase, balance, credit, debit, checks, errors, lines}) = Audit_state.unpack(st);
  Audit_state.pack({phase, balance, credit, debit, checks, errors = add_i32(errors, 1), lines})
}

fn is_phase(st: Audit_state, expected: I32) -> Bool {
  int_eq(Audit_state.unpack(st).?{phase}, expected)
}

fn is_clean(st: Audit_state) -> Bool { int_eq(Audit_state.unpack(st).?{errors}, 0) }

fn balance_value(st: Audit_state) -> I32 { Audit_state.unpack(st).?{balance} }

fn credit_value(st: Audit_state) -> I32 { Audit_state.unpack(st).?{credit} }

fn debit_value(st: Audit_state) -> I32 { Audit_state.unpack(st).?{debit} }

fn checks_value(st: Audit_state) -> I32 { Audit_state.unpack(st).?{checks} }

fn errors_value(st: Audit_state) -> I32 { Audit_state.unpack(st).?{errors} }

fn lines_value(st: Audit_state) -> I32 { Audit_state.unpack(st).?{lines} }

fn set_phase(st: Audit_state, next_phase: I32) -> Audit_state {
  let .({balance, credit, debit, checks, errors, lines}) = Audit_state.unpack(st);
  Audit_state.pack({phase = next_phase, balance, credit, debit, checks, errors, lines})
}

fn add_check(st: Audit_state) -> Audit_state {
  let .({phase, balance, credit, debit, checks, errors, lines}) = Audit_state.unpack(st);
  Audit_state.pack({phase, balance, credit, debit, checks = add_i32(checks, 1), errors, lines})
}

fn add_credit(st: Audit_state, amount: I32) -> Audit_state {
  let .({phase, balance, credit, debit, checks, errors, lines}) = Audit_state.unpack(st);
  Audit_state.pack({
    , phase
    , balance = add_i32(balance, amount)
    , credit = add_i32(credit, amount)
    , debit
    , checks
    , errors
    , lines
    })
}

fn add_debit(st: Audit_state, amount: I32) -> Audit_state {
  let .({phase, balance, credit, debit, checks, errors, lines}) = Audit_state.unpack(st);
  let magnitude = sub_i32(0, amount);
  Audit_state.pack({
    , phase
    , balance = add_i32(balance, amount)
    , credit
    , debit = add_i32(debit, magnitude)
    , checks
    , errors
    , lines
    })
}

fn finish_state(st: Audit_state) -> Audit_state {
  if! is_phase(st, 2) {
    st
  } else {
    add_error(st)
  }
}

fn begin(st: Audit_state) -> Audit_state {
  if! is_phase(st, 0) {
    set_phase(st, 1)
  } else {
    add_error(st)
  }
}

fn finish(st: Audit_state) -> Audit_state {
  if! is_phase(st, 1) {
    set_phase(st, 2)
  } else {
    add_error(st)
  }
}

fn checkpoint(st: Audit_state) -> Audit_state {
  if! is_phase(st, 1) {
    add_check(st)
  } else {
    add_error(st)
  }
}

fn amount(st: Audit_state, value: I32) -> Audit_state {
  if! is_phase(st, 1) {
    if! lt_i32(value, 0) {
      add_debit(st, value)
    } else {
      add_credit(st, value)
    }
  } else {
    add_error(st)
  }
}

fn apply_line(line: String, st: Audit_state) -> Audit_state {
  let next = add_line(st);
  if! string_eq(line, "BEGIN") {
    begin(next)
  } else if! string_eq(line, "END") {
    finish(next)
  } else if! string_eq(line, "CHECK") {
    checkpoint(next)
  } else if! string_eq(line, "CREDIT 12") {
    amount(next, 12)
  } else if! string_eq(line, "DEBIT 5") {
    amount(next, -5)
  } else if! string_eq(line, "CREDIT 7") {
    amount(next, 7)
  } else {
    add_error(next)
  }
}

rec(loop) fn replay(fields: Phase & Balance & Credit & Debit & Checks & Errors & Lines) ->
  Phase & Balance & Credit & Debit & Checks & Errors & Lines
   {
  match! read_ascii_line() {
    (
      , .(line: String) {
          let next = apply_line(line, Audit_state.pack(fields));
          rec replay(Audit_state.unpack(next))
        }
      , .(_eof: .) { fields }
      )
  }
}

fn print_metric(label: String, value: String) -> . {
  print(string_concat(label, string_concat(value, "\n")))
}

fn print_report(st: Audit_state) -> . {
  print("stdin replay audit\n");
  print_metric("lines: ", i32_to_string(lines_value(st)));
  print_metric("credits: ", i32_to_string(credit_value(st)));
  print_metric("debits: ", i32_to_string(debit_value(st)));
  print_metric("checks: ", i32_to_string(checks_value(st)));
  print_metric("balance: ", i32_to_string(balance_value(st)));
  print_metric("errors: ", i32_to_string(errors_value(st)));
  if! is_phase(st, 2) {
    if! is_clean(st) {
      print("status: OK\n")
    } else {
      print("status: REJECTED\n")
    }
  } else {
    print("status: REJECTED\n")
  }
}

pub fn main() -> . {
  let final_state = finish_state(Audit_state.pack(replay(Audit_state.unpack(initial()))));
  print_report(final_state)
}
