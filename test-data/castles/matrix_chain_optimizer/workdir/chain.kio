module chain;

import macros/control(macro if);
import macros/row_macros(macro select);
import macros/spine_macros(macro widen_sum);
import testapi(Array, Bool, I32, String);
import testapi/arith as math;
import testapi/array as arrays;
import testapi/fmt as fmt;
import testapi/iter(loop);
import testapi/text as text;

pub type Matrix = { Rows: I32; Cols: I32 };

pub type Evaluation = Rows & Cols & { Cost: I32; First: I32; Last: I32; Leaves: I32 };

pub fn matrix(rows: I32, cols: I32) -> Matrix { (Rows.mk(rows), Cols.mk(cols)) }

pub fn equal(a: I32, b: I32) -> Bool {
  if(math.leq_i32(a, b)) { math.leq_i32(b, a) } else { .f }
}

fn valid_dimension(value: I32) -> Bool {
  if(math.leq_i32(1, value)) { math.leq_i32(value, 30) } else { .f }
}

rec(loop) fn validate_at(matrices: Array[Matrix], index: I32, previous_cols: I32) -> String | . {
  if(math.leq_i32(arrays.array_len(matrices), index)) {
    widen_sum(())
  } else {
    let matrix = arrays.array_get(matrices, index);
    if(valid_dimension(matrix.>select { Rows.get })) {
      if(valid_dimension(matrix.>select { Cols.get })) {
        if(equal(previous_cols, matrix.>select { Rows.get })) {
          recur validate_at(matrices, math.add_i32(index, 1), matrix.>select { Cols.get })
        } else {
          widen_sum(text.string_concat(
          , "incompatible dimensions before A"
          , fmt.int_to_string(math.add_i32(index, 1))
          ))
        }
      } else {
        widen_sum("dimensions must be in 1..30"[String])
      }
    } else {
      widen_sum("dimensions must be in 1..30"[String])
    }
  }
}

pub fn validate(matrices: Array[Matrix]) -> String | . {
  let count = arrays.array_len(matrices);
  if(math.leq_i32(count, 0)) {
    widen_sum("chain is empty"[String])
  } else if(math.leq_i32(count, 8)) {
    validate_at(matrices, 0, arrays.array_get(matrices, 0).>select { Rows.get })
  } else {
    widen_sum("chain exceeds 8 matrices"[String])
  }
}

pub rec(loop) fn describe(matrices: Array[Matrix], index: I32, result: String) -> String {
  if(math.leq_i32(arrays.array_len(matrices), index)) {
    result
  } else {
    let matrix = arrays.array_get(matrices, index);
    let prefix = if(equal(index, 0)) { result } else { text.string_concat(result, " ") };
    let name = text.string_concat("A", fmt.int_to_string(math.add_i32(index, 1)));
    let shape = text.string_concat(
    , fmt.int_to_string(matrix.>select { Rows.get })
    , text.string_concat("x", fmt.int_to_string(matrix.>select { Cols.get }))
    );
    recur describe(
    , matrices
    , math.add_i32(index, 1)
    , text.string_concat(prefix, text.string_concat(name, text.string_concat("=", shape)))
    )
  }
}
