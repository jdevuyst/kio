mod tree;

import chain as chain;
import chain {
  type Cols;
  type Cost;
  type Evaluation;
  type First;
  type Last;
  type Leaves;
  type Matrix;
  type Rows
}
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Array; type Bool; type I32; type String }
import testapi/arith as math;
import testapi/array as arrays;
import testapi/fmt as fmt;
import testapi/iter { fn loop }
import testapi/text as text;

pub rec type Tree = { Leaf: I32 } | { Join: Tree & Tree };

pub fn leaf(index: I32) -> Tree { widen_sum(Leaf.mk(index)) }

pub fn join(left: Tree, right: Tree) -> Tree { widen_sum(Join.mk((left, right))) }

pub rec(loop) fn render(tree: Tree) -> String {
  match(tree) {
    .(node: Leaf) {
      text.string_concat("A", fmt.int_to_string(math.add_i32(node.>select { Leaf.get }, 1)))
    };
    .(node: Join) {
      let .(left: Tree, right: Tree) = node.>select { Join.get };
      let left_text = recur(cont) render(left);
      let right_text = recur(cont) render(right);
      text.string_concat(
      , "("
      , text.string_concat(left_text, text.string_concat("*", text.string_concat(right_text, ")")))
      )
    }
  }
}

fn combine(left: Evaluation, right: Evaluation) -> Evaluation | String {
  if(chain.equal(left.>select { Cols.get }, right.>select { Rows.get })) {
    if(chain.equal(math.add_i32(left.>select { Last.get }, 1), right.>select { First.get })) {
      let scalar_cost = math.mul_i32(
      , math.mul_i32(left.>select { Rows.get }, left.>select { Cols.get })
      , right.>select { Cols.get }
      );
      widen_sum((
      , Rows.mk(left.>select { Rows.get })
      , Cols.mk(right.>select { Cols.get })
      , Cost.mk(math.add_i32(
        , math.add_i32(left.>select { Cost.get }, right.>select { Cost.get })
        , scalar_cost
        ))
      , First.mk(left.>select { First.get })
      , Last.mk(right.>select { Last.get })
      , Leaves.mk(math.add_i32(left.>select { Leaves.get }, right.>select { Leaves.get }))
      ))
    } else {
      widen_sum("leaf order is not consecutive"[String])
    }
  } else {
    widen_sum("tree dimensions do not compose"[String])
  }
}

pub rec(loop) fn replay(tree: Tree, matrices: Array[Matrix]) -> Evaluation | String {
  match(tree) {
    .(node: Leaf) {
      let index = node.>select { Leaf.get };
      let matrix = arrays.array_get(matrices, index);
      widen_sum((
      , Rows.mk(matrix.>select { Rows.get })
      , Cols.mk(matrix.>select { Cols.get })
      , Cost.mk(0)
      , First.mk(index)
      , Last.mk(index)
      , Leaves.mk(1)
      ))
    };
    .(node: Join) {
      let .(left: Tree, right: Tree) = node.>select { Join.get };
      match(recur(cont) replay(left, matrices)) {
        .(left_result: Evaluation) {
          match(recur(cont) replay(right, matrices)) {
            .(right_result: Evaluation) { combine(left_result, right_result) };
            .(error: String) { widen_sum(error) }
          }
        };
        .(error: String) { widen_sum(error) }
      }
    }
  }
}

pub rec(loop) fn left_fold(index: I32, count: I32, result: Tree) -> Tree {
  if(math.leq_i32(count, index)) {
    result
  } else {
    recur left_fold(math.add_i32(index, 1), count, join(result, leaf(index)))
  }
}

pub rec(loop) fn right_fold(index: I32, result: Tree) -> Tree {
  if(math.leq_i32(index, -1)) {
    result
  } else {
    recur right_fold(math.sub_i32(index, 1), join(leaf(index), result))
  }
}
