module fold/fixtures;

import testapi(Array, I32, String);
import testapi/array as array;

pub fn empty() -> Array(String) { array.array_make_empty(String, ()) }

pub fn unpairable() -> Array(String) { array.array_make_filled(4, "A") }

pub fn hairpin() -> Array(String) {
  let sequence = array.array_make_filled(7, "A");
  array.array_set(sequence, 0, "G");
  array.array_set(sequence, 1, "C");
  array.array_set(sequence, 5, "G");
  array.array_set(sequence, 6, "C");
  sequence
}

pub fn crossing_choice() -> Array(String) {
  let sequence = array.array_make_empty(String, ());
  array.array_push(sequence, "A");
  array.array_push(sequence, "C");
  array.array_push(sequence, "U");
  array.array_push(sequence, "G");
  sequence
}

pub fn nested() -> Array(String) {
  let sequence = array.array_make_empty(String, ());
  array.array_push(sequence, "A");
  array.array_push(sequence, "U");
  array.array_push(sequence, "G");
  array.array_push(sequence, "C");
  array.array_push(sequence, "A");
  array.array_push(sequence, "U");
  array.array_push(sequence, "G");
  array.array_push(sequence, "C");
  array.array_push(sequence, "A");
  array.array_push(sequence, "U");
  sequence
}

pub fn separate_stems() -> Array(String) {
  let sequence = hairpin();
  array.array_push(sequence, "A");
  array.array_push(sequence, "U");
  array.array_push(sequence, "A");
  array.array_push(sequence, "A");
  array.array_push(sequence, "A");
  array.array_push(sequence, "U");
  sequence
}

pub fn competing_blocks() -> Array(String) {
  let sequence = array.array_make_filled(12, "G");
  array.array_set(sequence, 3, "A");
  array.array_set(sequence, 4, "A");
  array.array_set(sequence, 5, "A");
  array.array_set(sequence, 6, "C");
  array.array_set(sequence, 7, "C");
  array.array_set(sequence, 8, "C");
  array.array_set(sequence, 9, "U");
  array.array_set(sequence, 10, "U");
  array.array_set(sequence, 11, "U");
  sequence
}

pub fn adjacent() -> Array(String) {
  let sequence = array.array_make_empty(String, ());
  array.array_push(sequence, "A");
  array.array_push(sequence, "U");
  sequence
}

pub fn pair(partners: Array(I32), i: I32, j: I32) -> . {
  array.array_set(partners, i, j);
  array.array_set(partners, j, i)
}

pub fn crossed_partners() -> Array(I32) {
  let partners = array.array_make_filled(4, -1);
  pair(partners, 0, 2);
  pair(partners, 1, 3);
  partners
}
