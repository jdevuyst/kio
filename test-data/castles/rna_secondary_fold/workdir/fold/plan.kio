mod fold/plan;

import macros/spine_macros { macro widen_sum }
import testapi { type Array; type I32 }

pub type Decision = { Unpaired: . } | { Paired: I32 };

pub type Interval = { Lo: I32; Hi: I32 };

pub type Program = { Length: I32; Scores: Array[I32]; Decisions: Array[Decision] };

pub fn skip() -> Decision { (Unpaired.mk(()).>widen_sum)[Decision] }

pub fn pair(k: I32) -> Decision { (Paired.mk(k).>widen_sum)[Decision] }
