module fold/numbers;

import elab/control(if);
import testapi(Bool, I32);
import testapi/arith as arith;

pub fn equal(a: I32, b: I32) -> Bool {
  if! arith.leq_i32(a, b) {
    arith.leq_i32(b, a)
  } else {
    .f
  }
}

pub fn less(a: I32, b: I32) -> Bool { arith.leq_i32(arith.add_i32(a, 1), b) }

pub fn both(a: Bool, b: Bool) -> Bool {
  if! a {
    b
  } else {
    .f
  }
}

pub fn index(n: I32, i: I32, j: I32) -> I32 { arith.add_i32(arith.mul_i32(n, i), j) }
