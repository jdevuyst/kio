mod report;

import certificate as certificate;
import distance as distance;
import forest as forest;
import macros/control { macro if }
import macros/row_macros { macro select }
import testapi { type Array; type Bool; type I32; type String }
import testapi/arith as arith;
import testapi/array as array;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter { fn loop }
import testapi/text as text;

fn line(label: String, value: String) {
  io.print(value.>text.string_concat("\n").>>text.string_concat(label))
}

fn number(label: String, value: I32) {
  io.print(text.string_concat(label, fmt.int_to_string(value)))
}

rec(loop) fn mapping_pairs(mapping: Array[I32], position: I32) {
  if(forest.less(position, array.array_len(mapping))) {
    let destination = array.array_get(mapping, position);
    if(arith.leq_i32(0, destination)) {
      number(" ", position);
      number("->", destination)
    } else {
      ()
    };
    recur mapping_pairs(mapping, arith.add_i32(position, 1))
  } else {
    ()
  }
}

pub fn compare(title: String, source: forest.Tree, target: forest.Tree) {
  line("case: ", title);
  line("source: ", forest.render(source));
  line("target: ", forest.render(target));
  let solution = distance.solve(source, target);
  line("distance: ", fmt.int_to_string(solution.>select { distance.Cost.get }));
  io.print("mapping:");
  mapping_pairs(solution.>select { distance.Mapping.get }, 0);
  io.print("\n");
  if(certificate.valid(source, target, solution.>select { distance.Mapping.get })) {
    let counts = certificate.counts(source, target, solution.>select { distance.Mapping.get });
    number("edits: delete=", counts.>select { certificate.Deleted.get });
    number(" insert=", counts.>select { certificate.Inserted.get });
    number(" rename=", counts.>select { certificate.Renamed.get });
    number(" keep=", counts.>select { certificate.Kept.get });
    io.print("\n");
    line(
    , "certificate: "
    , if(forest.equal(certificate.cost(counts), solution.>select { distance.Cost.get })) {
        "valid; cost agrees"
      } else {
        "valid; cost disagrees"
      }
    )
  } else {
    io.print("certificate: invalid mapping\n")
  }
}

pub fn control(title: String, source: forest.Tree, target: forest.Tree, mapping: Array[I32]) {
  io.print(text.string_concat("control: ", title));
  line(" -> ", if(certificate.valid(source, target, mapping)) { "accepted" } else { "rejected" })
}
