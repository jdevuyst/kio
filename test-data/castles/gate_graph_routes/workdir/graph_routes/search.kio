module graph_routes/search;

import elab/control(if);
import graph_routes/model(
  , Search_state
  , inf
  , initial
  , rebuild
  , {blocked}
  , {cursor}
  , {da}
  , {db}
  , {dc}
  , {dd}
  , {de}
  , {df}
  , {dg}
  , {relaxed}
  , {round}
  , {visited}
  );
import testapi(Bool, I32);
import testapi/arith(add_i32, eq_i32, leq_i32, lt_i32);
import testapi/iter(loop);

fn seen(s: Search_state) -> Search_state {
  let .({round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked}) = s;
  rebuild(round, cursor, da, db, dc, dd, de, df, dg, add_i32(visited, 1), relaxed, blocked)
}

fn blocked_edge(s: Search_state) -> Search_state {
  let .({round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked}) = s;
  rebuild(round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, add_i32(blocked, 1))
}

fn advance(s: Search_state) -> Search_state {
  let .({round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked}) = s;
  rebuild(round, add_i32(cursor, 1), da, db, dc, dd, de, df, dg, visited, relaxed, blocked)
}

fn next_round(s: Search_state) -> Search_state {
  let .({round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked}) = s;
  rebuild(add_i32(round, 1), 0, da, db, dc, dd, de, df, dg, visited, relaxed, blocked)
}

fn can_relax(from_cost: I32, old_cost: I32, edge_cost: I32) -> Bool {
  if! eq_i32(from_cost, inf()) {
    .f
  } else {
    lt_i32(add_i32(from_cost, edge_cost), old_cost)
  }
}

fn relax_b(s: Search_state, from_cost: I32, edge_cost: I32) -> Search_state {
  let .({round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked}) = s;
  if! can_relax(from_cost, db, edge_cost) {
    rebuild(
      , round
      , cursor
      , da
      , add_i32(from_cost, edge_cost)
      , dc
      , dd
      , de
      , df
      , dg
      , visited
      , add_i32(relaxed, 1)
      , blocked
      )
  } else {
    s
  }
}

fn relax_c(s: Search_state, from_cost: I32, edge_cost: I32) -> Search_state {
  let .({round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked}) = s;
  if! can_relax(from_cost, dc, edge_cost) {
    rebuild(
      , round
      , cursor
      , da
      , db
      , add_i32(from_cost, edge_cost)
      , dd
      , de
      , df
      , dg
      , visited
      , add_i32(relaxed, 1)
      , blocked
      )
  } else {
    s
  }
}

fn relax_d(s: Search_state, from_cost: I32, edge_cost: I32) -> Search_state {
  let .({round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked}) = s;
  if! can_relax(from_cost, dd, edge_cost) {
    rebuild(
      , round
      , cursor
      , da
      , db
      , dc
      , add_i32(from_cost, edge_cost)
      , de
      , df
      , dg
      , visited
      , add_i32(relaxed, 1)
      , blocked
      )
  } else {
    s
  }
}

fn relax_e(s: Search_state, from_cost: I32, edge_cost: I32) -> Search_state {
  let .({round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked}) = s;
  if! can_relax(from_cost, de, edge_cost) {
    rebuild(
      , round
      , cursor
      , da
      , db
      , dc
      , dd
      , add_i32(from_cost, edge_cost)
      , df
      , dg
      , visited
      , add_i32(relaxed, 1)
      , blocked
      )
  } else {
    s
  }
}

fn relax_f(s: Search_state, from_cost: I32, edge_cost: I32) -> Search_state {
  let .({round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked}) = s;
  if! can_relax(from_cost, df, edge_cost) {
    rebuild(
      , round
      , cursor
      , da
      , db
      , dc
      , dd
      , de
      , add_i32(from_cost, edge_cost)
      , dg
      , visited
      , add_i32(relaxed, 1)
      , blocked
      )
  } else {
    s
  }
}

fn relax_candidate(s: Search_state) -> Search_state {
  let current = seen(s);
  if! eq_i32(current.?{cursor}, 0) {
    relax_b(current, current.?{da}, 4)
  } else if! eq_i32(current.?{cursor}, 1) {
    relax_c(current, current.?{da}, 2)
  } else if! eq_i32(current.?{cursor}, 2) {
    relax_d(current, current.?{db}, 5)
  } else if! eq_i32(current.?{cursor}, 3) {
    relax_b(current, current.?{dc}, 1)
  } else if! eq_i32(current.?{cursor}, 4) {
    blocked_edge(current)
  } else if! eq_i32(current.?{cursor}, 5) {
    relax_e(current, current.?{dc}, 4)
  } else if! eq_i32(current.?{cursor}, 6) {
    relax_d(current, current.?{de}, 1)
  } else if! eq_i32(current.?{cursor}, 7) {
    relax_f(current, current.?{dd}, 3)
  } else if! eq_i32(current.?{cursor}, 8) {
    relax_f(current, current.?{de}, 6)
  } else {
    relax_f(current, current.?{db}, 15)
  }
}

pub rec(loop) fn walk(s: Search_state) -> Search_state {
  if! leq_i32(3, s.?{round}) {
    s
  } else if! leq_i32(10, s.?{cursor}) {
    rec walk(next_round(s))
  } else {
    rec walk(advance(relax_candidate(s)))
  }
}

pub fn run() -> Search_state { walk(initial()) }
