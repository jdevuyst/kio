module graph_routes/search;

import graph_routes/model(
, Blocked
, Cursor
, Da
, Db
, Dc
, Dd
, De
, Df
, Dg
, Relaxed
, Round
, Search_state
, Visited
, inf
, initial
, rebuild
);
import macros/control(macro if);
import macros/row_macros(macro select);
import testapi(Bool, I32);
import testapi/arith(add_i32, eq_i32, leq_i32, lt_i32);
import testapi/iter(loop);

fn seen(s: Search_state) -> Search_state {
  let .(round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked) =
    s.>select {
      Round.get;
      Cursor.get;
      Da.get;
      Db.get;
      Dc.get;
      Dd.get;
      De.get;
      Df.get;
      Dg.get;
      Visited.get;
      Relaxed.get;
      Blocked.get
    };
  rebuild(round, cursor, da, db, dc, dd, de, df, dg, add_i32(visited, 1), relaxed, blocked)
}

fn blocked_edge(s: Search_state) -> Search_state {
  let .(round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked) =
    s.>select {
      Round.get;
      Cursor.get;
      Da.get;
      Db.get;
      Dc.get;
      Dd.get;
      De.get;
      Df.get;
      Dg.get;
      Visited.get;
      Relaxed.get;
      Blocked.get
    };
  rebuild(round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, add_i32(blocked, 1))
}

fn advance(s: Search_state) -> Search_state {
  let .(round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked) =
    s.>select {
      Round.get;
      Cursor.get;
      Da.get;
      Db.get;
      Dc.get;
      Dd.get;
      De.get;
      Df.get;
      Dg.get;
      Visited.get;
      Relaxed.get;
      Blocked.get
    };
  rebuild(round, add_i32(cursor, 1), da, db, dc, dd, de, df, dg, visited, relaxed, blocked)
}

fn next_round(s: Search_state) -> Search_state {
  let .(round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked) =
    s.>select {
      Round.get;
      Cursor.get;
      Da.get;
      Db.get;
      Dc.get;
      Dd.get;
      De.get;
      Df.get;
      Dg.get;
      Visited.get;
      Relaxed.get;
      Blocked.get
    };
  rebuild(add_i32(round, 1), 0, da, db, dc, dd, de, df, dg, visited, relaxed, blocked)
}

fn can_relax(from_cost: I32, old_cost: I32, edge_cost: I32) -> Bool {
  if(eq_i32(from_cost, inf())) { .f } else { lt_i32(add_i32(from_cost, edge_cost), old_cost) }
}

fn relax_b(s: Search_state, from_cost: I32, edge_cost: I32) -> Search_state {
  let .(round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked) =
    s.>select {
      Round.get;
      Cursor.get;
      Da.get;
      Db.get;
      Dc.get;
      Dd.get;
      De.get;
      Df.get;
      Dg.get;
      Visited.get;
      Relaxed.get;
      Blocked.get
    };
  if(can_relax(from_cost, db, edge_cost)) {
    rebuild(
    , round
    , cursor
    , da
    , add_i32(from_cost, edge_cost)
    , dc
    , dd
    , de
    , df
    , dg
    , visited
    , add_i32(relaxed, 1)
    , blocked
    )
  } else {
    s
  }
}

