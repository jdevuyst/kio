fn relax_f(s: Search_state, from_cost: I32, edge_cost: I32) -> Search_state {
  let .(round, cursor, da, db, dc, dd, de, df, dg, visited, relaxed, blocked) =
    s.>select {
      Round.get;
      Cursor.get;
      Da.get;
      Db.get;
