fn relax_candidate(s: Search_state) -> Search_state {
  let current = seen(s);
  if(eq_i32(current.>select { Cursor.get }, 0)) {
    relax_b(current, current.>select { Da.get }, 4)
  } else if(eq_i32(current.>select { Cursor.get }, 1)) {
    relax_c(current, current.>select { Da.get }, 2)
  } else if(eq_i32(current.>select { Cursor.get }, 2)) {
    relax_d(current, current.>select { Db.get }, 5)
  } else if(eq_i32(current.>select { Cursor.get }, 3)) {
    relax_b(current, current.>select { Dc.get }, 1)
  } else if(eq_i32(current.>select { Cursor.get }, 4)) {
    blocked_edge(current)
  } else if(eq_i32(current.>select { Cursor.get }, 5)) {
    relax_e(current, current.>select { Dc.get }, 4)
  } else if(eq_i32(current.>select { Cursor.get }, 6)) {
    relax_d(current, current.>select { De.get }, 1)
  } else if(eq_i32(current.>select { Cursor.get }, 7)) {
    relax_f(current, current.>select { Dd.get }, 3)
  } else if(eq_i32(current.>select { Cursor.get }, 8)) {
    relax_f(current, current.>select { De.get }, 6)
  } else {
    relax_f(current, current.>select { Db.get }, 15)
  }
}

pub rec(loop) fn walk(s: Search_state) -> Search_state {
  if(leq_i32(3, s.>select { Round.get })) {
    s
  } else if(leq_i32(10, s.>select { Cursor.get })) {
    recur walk(next_round(s))
  } else {
    recur walk(advance(relax_candidate(s)))
  }
}

pub fn run() -> Search_state { walk(initial()) }
