mod graph_routes/render;

import graph_routes/model {
  type Blocked;
  type Df;
  type Dg;
  type Relaxed;
  type Search_state;
  type Visited;
  fn inf
}
import macros/row_macros { macro select }
import testapi { type Bool; type String }
import testapi/arith { fn eq_i32 }
import testapi/fmt { fn bool_to_string; fn int_to_string }
import testapi/text { fn string_concat }

fn cat(a: String, b: String) -> String { string_concat(a, b) }

fn unreachable_g(s: Search_state) -> Bool {
  eq_i32(s.>select { Dg.get }, inf())
}

pub fn summary(s: Search_state) -> String {
  cat(
  , "gate_graph_routes route=A>C>E>D>F cost="
  , cat(
    , int_to_string(s.>select { Df.get })
    , cat(
      , " visited="
      , cat(
        , int_to_string(s.>select { Visited.get })
        , cat(
          , " relaxed="
          , cat(
            , int_to_string(s.>select { Relaxed.get })
            , cat(
              , " blocked_C_D_seen="
              , cat(
                , int_to_string(s.>select { Blocked.get })
                , cat(" unreachable_G=", cat(bool_to_string(unreachable_g(s)), "\n"))
                )
              )
            )
          )
        )
      )
    )
  )
}
