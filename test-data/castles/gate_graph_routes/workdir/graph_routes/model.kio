mod graph_routes/model;

import macros/row_macros { macro record }
import testapi { type I32 }

pub type Search_state = {
  Round: I32;
  Cursor: I32;
  Da: I32;
  Db: I32;
  Dc: I32;
  Dd: I32;
  De: I32;
  Df: I32;
  Dg: I32;
  Visited: I32;
  Relaxed: I32;
  Blocked: I32
};

pub fn inf() -> I32 { 999 }

pub fn initial() -> Search_state {
  record {
    Round.mk(0);
    Cursor.mk(0);
    Da.mk(0);
    Db.mk(inf());
    Dc.mk(inf());
    Dd.mk(inf());
    De.mk(inf());
    Df.mk(inf());
    Dg.mk(inf());
    Visited.mk(0);
    Relaxed.mk(0);
    Blocked.mk(0)
  }
}

pub fn rebuild(
, round_value: I32
, cursor_value: I32
, da_value: I32
, db_value: I32
, dc_value: I32
, dd_value: I32
, de_value: I32
, df_value: I32
, dg_value: I32
, visited_value: I32
, relaxed_value: I32
, blocked_value: I32
) -> Search_state {
  record {
    Round.mk(round_value);
    Cursor.mk(cursor_value);
    Da.mk(da_value);
    Db.mk(db_value);
    Dc.mk(dc_value);
    Dd.mk(dd_value);
    De.mk(de_value);
    Df.mk(df_value);
    Dg.mk(dg_value);
    Visited.mk(visited_value);
    Relaxed.mk(relaxed_value);
    Blocked.mk(blocked_value)
  }
}
