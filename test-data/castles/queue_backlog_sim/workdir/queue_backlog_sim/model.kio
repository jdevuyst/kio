module queue_backlog_sim/model;

import queue/core(Queue);
import testapi(I32);

pub type Job = { Ticket: I32; Arrived: I32; Effort: I32 };

pub type State_fields = {
  Current_tick: I32;
  Next_ticket: I32;
  Job_queue: Queue[Job];
  Backlog_count: I32;
  Total_wait: I32;
  Max_backlog: I32;
  Served_count: I32;
  Completed_effort: I32;
  Arrived_count: I32
};

pub type State =
  & Current_tick
  & Next_ticket
  & Job_queue
  & Backlog_count
  & Total_wait
  & Max_backlog
  & Served_count
  & Completed_effort
  & Arrived_count
  ;

pub type Enqueue_fields = { Enqueued_queue: Queue[Job]; Enqueued_next: I32 };

pub type Enqueue_result = Enqueued_queue & Enqueued_next;

pub type Serve_fields = {
  Served_queue: Queue[Job];
  Served_jobs: I32;
  Served_wait: I32;
  Served_effort: I32
};

pub type Serve_result = Served_queue & Served_jobs & Served_wait & Served_effort;
