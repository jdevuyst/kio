module queue_backlog_sim/sim;

import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro record, macro record_, macro select);
import queue/core(Queue, empty);
import queue_backlog_sim/fifo as fifo;
import queue_backlog_sim/model(
, Arrived
, Arrived_count
, Backlog_count
, Completed_effort
, Current_tick
, Effort
, Enqueue_result
, Enqueued_next
, Enqueued_queue
, Job
, Job_queue
, Max_backlog
, Next_ticket
, Serve_result
, Served_count
, Served_effort
, Served_jobs
, Served_queue
, Served_wait
, State
, Ticket
, Total_wait
);
import queue_backlog_sim/schedule as schedule;
import testapi(Bool, I32);
import testapi/arith(add_i32, eq_i32, leq_i32, lt_i32, sub_i32);
import testapi/iter(loop);

fn fold_result[A][B](default: B, present_value: A -> B, result: A | .) -> B {
  match(result) {
    (.(value: A) { present_value(value) }, .(_empty: .) { default })
  }
}

fn max_i32(a: I32, b: I32) -> I32 {
  if(lt_i32(a, b)) { b } else { a }
}

fn make_job(ticket_id: I32, tick: I32) -> Job {
  record { Ticket.mk(ticket_id); Arrived.mk(tick); Effort.mk(schedule.effort_for(ticket_id, tick)) }
}

fn initial_state() -> State {
  record {
    Current_tick.mk(0);
    Next_ticket.mk(1);
    Job_queue.mk(empty[Job]);
    Backlog_count.mk(0);
    Total_wait.mk(0);
    Max_backlog.mk(0);
    Served_count.mk(0);
    Completed_effort.mk(0);
    Arrived_count.mk(0)
  }
}

rec(loop) fn enqueue_arrivals(remaining: I32, tick_value: I32, next_id: I32, q: Queue[Job]) -> Enqueue_result {
  if(leq_i32(remaining, 0)) {
    record { Enqueued_queue.mk(q); Enqueued_next.mk(next_id) }
  } else {
    recur enqueue_arrivals(
    , sub_i32(remaining, 1)
    , tick_value
    , add_i32(next_id, 1)
    , fifo.enqueue(make_job(next_id, tick_value), q)
    )
  }
}

fn serve_one(tick_value: I32, q: Queue[Job]) -> Serve_result {
  let empty_result =
    record_ { Served_queue.mk(q); Served_jobs.mk(0); Served_wait.mk(0); Served_effort.mk(0) };
  fold_result(
  , empty_result
  , .(pair: Job & Queue[Job]) {
      let .(job: Job, rest: Queue[Job]) = pair;
      record {
        Served_queue.mk(rest);
        Served_jobs.mk(1);
        Served_wait.mk(sub_i32(tick_value, job.>select { Arrived.get }));
        Served_effort.mk(job.>select { Effort.get })
      }
    }
  , fifo.dequeue(q)
  )
}

rec(loop) fn serve_capacity(
, remaining: I32
, tick_value: I32
, q: Queue[Job]
, jobs: I32
, wait: I32
, effort_units: I32
) -> Serve_result {
  if(leq_i32(remaining, 0)) {
    record {
      Served_queue.mk(q);
      Served_jobs.mk(jobs);
      Served_wait.mk(wait);
      Served_effort.mk(effort_units)
    }
  } else {
    let one = serve_one(tick_value, q);
    if(eq_i32(one.>select { Served_jobs.get }, 0)) {
      record {
        Served_queue.mk(q);
        Served_jobs.mk(jobs);
        Served_wait.mk(wait);
        Served_effort.mk(effort_units)
      }
    } else {
      recur serve_capacity(
      , sub_i32(remaining, 1)
      , tick_value
      , one.>select { Served_queue.get }
      , add_i32(jobs, one.>select { Served_jobs.get })
      , add_i32(wait, one.>select { Served_wait.get })
      , add_i32(effort_units, one.>select { Served_effort.get })
      )
    }
  }
}

fn serve_tick(capacity: I32, tick_value: I32, q: Queue[Job]) -> Serve_result {
  serve_capacity(capacity, tick_value, q, 0, 0, 0)
}

fn step_tick(state: State) -> State {
  let .(
  , current_tick
  , next_ticket
  , job_queue
  , backlog_count
  , total_wait
  , max_backlog
  , served_count
  , completed_effort
  , arrived_count
  ) =
    state.>select {
      Current_tick.get;
      Next_ticket.get;
      Job_queue.get;
      Backlog_count.get;
      Total_wait.get;
      Max_backlog.get;
      Served_count.get;
      Completed_effort.get;
      Arrived_count.get
    };
  let arrivals = schedule.arrivals_at(current_tick);
  let enqueued = enqueue_arrivals(arrivals, current_tick, next_ticket, job_queue);
  let backlog_after_arrivals = add_i32(backlog_count, arrivals);
  let served =
    serve_tick(
    , schedule.capacity_at(current_tick)
    , current_tick
    , enqueued.>select { Enqueued_queue.get }
    );
  let backlog_after_service = sub_i32(backlog_after_arrivals, served.>select { Served_jobs.get });
  record {
    Current_tick.mk(add_i32(current_tick, 1));
    Next_ticket.mk(enqueued.>select { Enqueued_next.get });
    Job_queue.mk(served.>select { Served_queue.get });
    Backlog_count.mk(backlog_after_service);
    Total_wait.mk(add_i32(total_wait, served.>select { Served_wait.get }));
    Max_backlog.mk(max_i32(max_backlog, backlog_after_arrivals));
    Served_count.mk(add_i32(served_count, served.>select { Served_jobs.get }));
    Completed_effort.mk(add_i32(completed_effort, served.>select { Served_effort.get }));
    Arrived_count.mk(add_i32(arrived_count, arrivals))
  }
}

rec(loop) fn run_from(state: State) -> State {
  if(leq_i32(schedule.total_ticks(), state.>select { Current_tick.get })) {
    state
  } else {
    recur run_from(step_tick(state))
  }
}

pub fn run() -> State { run_from(initial_state()) }
