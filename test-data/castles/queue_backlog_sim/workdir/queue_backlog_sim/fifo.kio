module queue_backlog_sim/fifo;

import elab/match(match);
import elab/spine_elaborators(widen_sum);
import queue/core(Queue, back, bool_to, front, is_empty, pop_front, singleton, snoc_into_back);
import queue/list/core(List, cons, nil, uncons);
import testapi/iter(loop);

fn present[A](value: A) -> A | . { widen_sum!(value, A | .) }

fn absent[A]() -> A | . { widen_sum!((), A | .) }

fn fold_result[A][B](default: B, present_value: A -> B, result: A | .) -> B {
  match! result {
    (.(value: A) { present_value(value) }, .(_empty: .) { default })
  }
}

pub rec(loop) fn reverse_list[A](source: List(A), carry: List(A)) -> List(A) {
  match! uncons(source) {
    (
      , .(head: A, tail: List(A)) { rec reverse_list(tail, cons(head, carry)) }
      , .(_empty: .) { carry }
      )
  }
}

pub fn canonical[A](raw: Queue(A)) -> Queue(A) {
  let rotated = Queue.mk_unchecked((reverse_list(back(raw), nil(A, ())), nil(A, ())));
  match! uncons(front(raw)) {
    (.(_pair: A & List(A)) { raw }, .(_empty: .) { rotated })
  }
}

pub fn enqueue[A](x: A, q: Queue(A)) -> Queue(A) {
  bool_to(singleton(x), snoc_into_back(x, q), is_empty(q))
}

pub fn dequeue[A](q: Queue(A)) -> (A & Queue(A)) | . {
  let .(empty_result: (A & Queue(A)) | .) = absent();
  fold_result(
    , empty_result
    , .(pair: A & Queue(A)) { let .(x: A, rest: Queue(A)) = pair; present((x, canonical(rest))) }
    , pop_front(q)
    )
}
