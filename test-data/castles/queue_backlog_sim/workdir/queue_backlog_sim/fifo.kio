mod queue_backlog_sim/fifo;

import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import queue/core {
  type Queue;
  fn back;
  fn bool_to;
  fn front;
  fn is_empty;
  fn pop_front;
  fn singleton;
  fn snoc_into_back
}
import queue/list/core { type List; fn cons; fn nil; fn uncons }
import testapi/iter { fn loop }

fn present[A](value: A) -> A | . { widen_sum(value)[A | .] }

fn absent[A] -> A | . { widen_sum(())[A | .] }

fn fold_result[A][B](default: B, present_value: A -> B, result: A | .) -> B {
  match(result) {
    (.(value: A) { present_value(value) }, .(_empty: .) { default })
  }
}

pub rec(loop) fn reverse_list[A](source: List[A], carry: List[A]) -> List[A] {
  match(uncons(source)) {
    (
    , .(head: A, tail: List[A]) { recur reverse_list(tail, cons(head, carry)) }
    , .(_empty: .) { carry }
    )
  }
}

pub fn canonical[A](raw: Queue[A]) -> Queue[A] {
  let rotated = Queue.mk((reverse_list(back(raw), nil[A]), nil[A]));
  match(uncons(front(raw))) {
    (.(_pair: A & List[A]) { raw }, .(_empty: .) { rotated })
  }
}

pub fn enqueue[A](x: A, q: Queue[A]) -> Queue[A] {
  bool_to(singleton(x), snoc_into_back(x, q), is_empty(q))
}

pub fn dequeue[A](q: Queue[A]) -> (A & Queue[A]) | . {
  let .(empty_result: (A & Queue[A]) | .) = absent[_];
  fold_result(
  , empty_result
  , .(pair: A & Queue[A]) { let .(x: A, rest: Queue[A]) = pair; present((x, canonical(rest))) }
  , pop_front(q)
  )
}
