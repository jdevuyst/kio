mod queue_backlog_sim/report;

import macros/row_macros { macro select }
import queue_backlog_sim/model {
  type Arrived_count;
  type Backlog_count;
  type Completed_effort;
  type Current_tick;
  type Max_backlog;
  type Next_ticket;
  type Served_count;
  type State;
  type Total_wait
}
import testapi { type Bool; type I32; type String }
import testapi/arith { fn eq_i32 }
import testapi/fmt { fn bool_to_string; fn int_to_string }
import testapi/io { fn print }
import testapi/text { fn string_concat }

fn cat3(a: String, b: String, c: String) -> String { string_concat(a, string_concat(b, c)) }

fn line(label: String, value: String) { print(cat3(label, value, "\n")) }

pub fn print_report(state: State) {
  print("queue_backlog_sim\n");
  print("schedule=arrivals[3,0,4,1,0,2,0];capacity[1,2,1,3,2,1,4]\n");
  line("ticks=", int_to_string(state.>select { Current_tick.get }));
  line("arrivals=", int_to_string(state.>select { Arrived_count.get }));
  line("served=", int_to_string(state.>select { Served_count.get }));
  line("final_backlog=", int_to_string(state.>select { Backlog_count.get }));
  line("max_backlog=", int_to_string(state.>select { Max_backlog.get }));
  line("wait_units=", int_to_string(state.>select { Total_wait.get }));
  line("effort_units=", int_to_string(state.>select { Completed_effort.get }));
  line("next_ticket=", int_to_string(state.>select { Next_ticket.get }));
  line("drained=", bool_to_string(eq_i32(state.>select { Backlog_count.get }, 0)))
}
