module queue_backlog_sim/schedule;

import elab/control(if);
import testapi(Bool, I32);
import testapi/arith(add_i32, eq_i32);

pub fn total_ticks() -> I32 { 7 }

pub fn arrivals_at(tick: I32) -> I32 {
  if! eq_i32(tick, 0) {
    3
  } else if! eq_i32(tick, 1) {
    0
  } else if! eq_i32(tick, 2) {
    4
  } else if! eq_i32(tick, 3) {
    1
  } else if! eq_i32(tick, 4) {
    0
  } else if! eq_i32(tick, 5) {
    2
  } else {
    0
  }
}

pub fn capacity_at(tick: I32) -> I32 {
  if! eq_i32(tick, 0) {
    1
  } else if! eq_i32(tick, 1) {
    2
  } else if! eq_i32(tick, 2) {
    1
  } else if! eq_i32(tick, 3) {
    3
  } else if! eq_i32(tick, 4) {
    2
  } else if! eq_i32(tick, 5) {
    1
  } else {
    4
  }
}

pub fn effort_for(ticket: I32, tick: I32) -> I32 { add_i32(ticket, add_i32(tick, 1)) }
