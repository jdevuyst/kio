module testapi/array;

import testapi(Array, I32);

host fn array_make_empty[T]() -> Array(T);

host fn array_make_filled[T](count: I32, fill: T) -> Array(T);

host fn array_len[T](items: Array(T)) -> I32;

host fn array_get[T](items: Array(T), index: I32) -> T;

host fn array_set[T](items: Array(T), index: I32, value: T) -> .;

host fn array_push[T](items: Array(T), value: T) -> .;

host fn array_pop_back[T](items: Array(T)) -> T | .;

host fn array_swap[T](items: Array(T), left: I32, right: I32) -> .;

host fn array_clone[T](items: Array(T)) -> Array(T);
