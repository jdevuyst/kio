mod interval_merge_planner/planner;

import macros/control { macro if }
import macros/row_macros { macro select }
import testapi { type Bool; type I32; type String }
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/text as text;

type Window = { Window_name: String; Start_minute: I32; End_minute: I32 };

type Plan = {
  Current_start: I32;
  Current_end: I32;
  Current_windows: I32;
  Closed_segments: I32;
  Covered_minutes: I32;
  Idle_gap_count: I32;
  Idle_minutes: I32;
  Merged_edges: I32;
  Touching_edges: I32;
  Conflict_count: I32;
  Conflict_minutes: I32
};

fn window(name: String, start: I32, end: I32) -> Window {
  (Window_name.mk(name), Start_minute.mk(start), End_minute.mk(end))
}

fn backup_db() -> Window { window("backup-db", 30, 100) }

fn search_reindex() -> Window { window("search-reindex", 100, 145) }

fn payroll_export() -> Window { window("payroll-export", 130, 180) }

fn api_deploy() -> Window { window("api-deploy", 240, 290) }

fn metrics_cleanup() -> Window { window("metrics-cleanup", 285, 315) }

fn audit_sync() -> Window { window("audit-sync", 360, 395) }

fn duration(start: I32, end: I32) -> I32 { arith.sub_i32(end, start) }

fn max_i32(left: I32, right: I32) -> I32 {
  if(arith.lt_i32(left, right)) { right } else { left }
}

fn add_if(flag: Bool, base: I32, amount: I32) -> I32 {
  if(flag) { arith.add_i32(base, amount) } else { base }
}

fn overlap_minutes(active_end: I32, next_start: I32) -> I32 {
  if(arith.lt_i32(next_start, active_end)) { arith.sub_i32(active_end, next_start) } else { 0 }
}

fn initial_plan(first: Window) -> Plan {
  (
  , Current_start.mk(first.>select { Start_minute.get })
  , Current_end.mk(first.>select { End_minute.get })
  , Current_windows.mk(1)
  , Closed_segments.mk(0)
  , Covered_minutes.mk(0)
  , Idle_gap_count.mk(0)
  , Idle_minutes.mk(0)
  , Merged_edges.mk(0)
  , Touching_edges.mk(0)
  , Conflict_count.mk(0)
  , Conflict_minutes.mk(0)
  )
}

fn merge_plan(plan: Plan, next: Window) -> Plan {
  let next_start = next.>select { Start_minute.get };
  let next_end = next.>select { End_minute.get };
  let overlap = overlap_minutes(plan.>select { Current_end.get }, next_start);
  let has_conflict = arith.lt_i32(next_start, plan.>select { Current_end.get });
  let has_touch = arith.eq_i32(next_start, plan.>select { Current_end.get });
  (
  , Current_start.mk(plan.>select { Current_start.get })
  , Current_end.mk(max_i32(plan.>select { Current_end.get }, next_end))
  , Current_windows.mk(arith.add_i32(plan.>select { Current_windows.get }, 1))
  , Closed_segments.mk(plan.>select { Closed_segments.get })
  , Covered_minutes.mk(plan.>select { Covered_minutes.get })
  , Idle_gap_count.mk(plan.>select { Idle_gap_count.get })
  , Idle_minutes.mk(plan.>select { Idle_minutes.get })
  , Merged_edges.mk(arith.add_i32(plan.>select { Merged_edges.get }, 1))
  , Touching_edges.mk(add_if(has_touch, plan.>select { Touching_edges.get }, 1))
  , Conflict_count.mk(add_if(has_conflict, plan.>select { Conflict_count.get }, 1))
  , Conflict_minutes.mk(arith.add_i32(plan.>select { Conflict_minutes.get }, overlap))
  )
}

fn close_and_start(plan: Plan, next: Window) -> Plan {
  let closed_duration =
    duration(plan.>select { Current_start.get }, plan.>select { Current_end.get });
  let gap = arith.sub_i32(next.>select { Start_minute.get }, plan.>select { Current_end.get });
  (
  , Current_start.mk(next.>select { Start_minute.get })
  , Current_end.mk(next.>select { End_minute.get })
  , Current_windows.mk(1)
  , Closed_segments.mk(arith.add_i32(plan.>select { Closed_segments.get }, 1))
  , Covered_minutes.mk(arith.add_i32(plan.>select { Covered_minutes.get }, closed_duration))
  , Idle_gap_count.mk(arith.add_i32(plan.>select { Idle_gap_count.get }, 1))
  , Idle_minutes.mk(arith.add_i32(plan.>select { Idle_minutes.get }, gap))
  , Merged_edges.mk(plan.>select { Merged_edges.get })
  , Touching_edges.mk(plan.>select { Touching_edges.get })
  , Conflict_count.mk(plan.>select { Conflict_count.get })
  , Conflict_minutes.mk(plan.>select { Conflict_minutes.get })
  )
}

fn consume(plan: Plan, next: Window) -> Plan {
  if(arith.leq_i32(next.>select { Start_minute.get }, plan.>select { Current_end.get })) {
    merge_plan(plan, next)
  } else {
    close_and_start(plan, next)
  }
}

fn final_segments(plan: Plan) -> I32 {
  arith.add_i32(plan.>select { Closed_segments.get }, 1)
}

fn final_covered_minutes(plan: Plan) -> I32 {
  arith.add_i32(
  , plan.>select { Covered_minutes.get }
  , duration(plan.>select { Current_start.get }, plan.>select { Current_end.get })
  )
}

fn cat2(left: String, right: String) -> String { text.string_concat(left, right) }

fn cat3(a: String, b: String, c: String) -> String { cat2(cat2(a, b), c) }

fn cat5(a: String, b: String, c: String, d: String, e: String) -> String {
  cat2(cat2(cat2(cat2(a, b), c), d), e)
}

fn show_i32(value: I32) -> String { fmt.int_to_string(value) }

fn show_bool(value: Bool) -> String { fmt.bool_to_string(value) }

fn line(label: String, value: I32) { io.print(cat3(label, show_i32(value), "\n")) }

fn print_window(window_value: Window) {
  io.print(cat5(
  , "- "
  , window_value.>select { Window_name.get }
  , " "
  , show_i32(window_value.>select { Start_minute.get })
  , "-"
  ));
  io.print(cat3(show_i32(window_value.>select { End_minute.get }), "", "\n"))
}

fn print_segment(number: I32, plan: Plan) {
  io.print(cat3("- segment ", show_i32(number), " "));
  io.print(cat3(
  , show_i32(plan.>select { Current_start.get })
  , "-"
  , show_i32(plan.>select { Current_end.get })
  ));
  io.print(cat3(
  , " duration "
  , show_i32(duration(plan.>select { Current_start.get }, plan.>select { Current_end.get }))
  , " "
  ));
  io.print(cat3("windows ", show_i32(plan.>select { Current_windows.get }), "\n"))
}

fn print_gap(number: I32, left: Plan, right: Plan) {
  let gap_start = left.>select { Current_end.get };
  let gap_end = right.>select { Current_start.get };
  io.print(cat3("- gap ", show_i32(number), " "));
  io.print(cat3(show_i32(gap_start), "-", show_i32(gap_end)));
  io.print(cat3(" duration ", show_i32(duration(gap_start, gap_end)), "\n"))
}

fn print_conflict(name: String, minutes: I32) {
  io.print(cat3("- ", name, " overlaps active segment by "));
  io.print(cat3(show_i32(minutes), " minutes", "\n"))
}

pub fn run() {
  let w1 = backup_db();
  let w2 = search_reindex();
  let w3 = payroll_export();
  let w4 = api_deploy();
  let w5 = metrics_cleanup();
  let w6 = audit_sync();
  let p1 = initial_plan(w1);
  let p2 = consume(p1, w2);
  let p3 = consume(p2, w3);
  let p4 = consume(p3, w4);
  let p5 = consume(p4, w5);
  let p6 = consume(p5, w6);
  io.print("Interval merge planner\n");
  io.print("Fixture windows: 6\n\n");
  io.print("Raw windows\n");
  print_window(w1);
  print_window(w2);
  print_window(w3);
  print_window(w4);
  print_window(w5);
  print_window(w6);
  io.print("\nMerged windows\n");
  print_segment(1, p3);
  print_segment(2, p5);
  print_segment(3, p6);
  io.print("\nIdle gaps\n");
  print_gap(1, p3, p5);
  print_gap(2, p5, p6);
  io.print("\nConflicts\n");
  print_conflict(
  , "payroll-export"
  , overlap_minutes(p2.>select { Current_end.get }, w3.>select { Start_minute.get })
  );
  print_conflict(
  , "metrics-cleanup"
  , overlap_minutes(p4.>select { Current_end.get }, w5.>select { Start_minute.get })
  );
  io.print("\nSummary\n");
  line("covered_minutes=", final_covered_minutes(p6));
  line("idle_gap_count=", p6.>select { Idle_gap_count.get });
  line("idle_minutes=", p6.>select { Idle_minutes.get });
  line("merged_segments=", final_segments(p6));
  line("merged_edges=", p6.>select { Merged_edges.get });
  line("touching_edges=", p6.>select { Touching_edges.get });
  io.print(cat3(
  , "touch_backup_to_search="
  , show_bool(arith.eq_i32(w1.>select { End_minute.get }, w2.>select { Start_minute.get }))
  , "\n"
  ));
  line("conflicts=", p6.>select { Conflict_count.get });
  line("conflict_minutes=", p6.>select { Conflict_minutes.get })
}
