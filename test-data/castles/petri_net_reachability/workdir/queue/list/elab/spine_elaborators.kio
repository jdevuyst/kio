    , .(target_type: __Type__) -> Elaborator_result {
        one_prod_impl(ct, source, value, target_type)
      }
    , .() -> Elaborator_result {
        __either__(
          , __Type__
          , .
          , Elaborator_result
          , first_product_type(ct, source, value)
          , .(target_type: __Type__) -> Elaborator_result {
              one_prod_impl(ct, source, value, target_type)
            }
          , .() -> Elaborator_result { err(ct, "elaborator could not infer a target type") }
          )
      }
    )
}

/// Evaluates the corresponding elaborator and returns its checked core result.
pub pure fn one_prod_checked(
  , ct: __Comptime__
  , source: __Type__
  , value: __Checked_term__
  , target: Optional_type
  ) -> __Checked_term__ { finish_elaborator_result(ct, one_prod_result(ct, source, value, target)) }

/// Extracts one product slot, inferring the slot type when possible.
pub elab one_prod : [Source] Source -> [Target] Target { impl one_prod_checked }

pure fn one_sum_impl(ct: __Comptime__, source: __Type__, value: __Checked_term__, target: __Type__) -> Elaborator_result {
  let source_spine = sum_spine(ct, source);
  let target_spine = sum_spine(ct, target);
  __if_then_else__(
    , __type_is_sum_root__(ct, target)
    , .() -> Elaborator_result { err(ct, "one_sum target must not be a top-level sum") }
    , .() -> Elaborator_result {
        __either__(
          , Route_list
          , __Diagnostic_text__
          , Elaborator_result
          , route_source_arms_collapse(ct, source_spine, target_slots(ct, target_spine))
          , .(routes: Route_list) -> Elaborator_result {
              build_sum_from_routes(ct, source_spine, target, target_spine, routes, value)
            }
          , .(message: __Diagnostic_text__) -> Elaborator_result { err(ct, message) }
          )
      }
    )
}

pure fn one_sum_result(
  , ct: __Comptime__
  , source: __Type__
  , value: __Checked_term__
  , target: Optional_type
  ) -> Elaborator_result {
  __either__(
    , __Type__
    , .
    , Elaborator_result
    , target
    , .(target_type: __Type__) -> Elaborator_result { one_sum_impl(ct, source, value, target_type) }
    , .() -> Elaborator_result {
        __either__(
          , __Type__
          , .
          , Elaborator_result
          , first_sum_type(ct, source, value)
          , .(target_type: __Type__) -> Elaborator_result {
              one_sum_impl(ct, source, value, target_type)
            }
          , .() -> Elaborator_result { err(ct, "elaborator could not infer a target type") }
          )
      }
    )
}

/// Evaluates the corresponding elaborator and returns its checked core result.
pub pure fn one_sum_checked(
  , ct: __Comptime__
  , source: __Type__
  , value: __Checked_term__
  , target: Optional_type
  ) -> __Checked_term__ { finish_elaborator_result(ct, one_sum_result(ct, source, value, target)) }

/// Extracts one non-sum branch from a sum, inferring the branch type when possible.
pub elab one_sum : [Source] Source -> [Target] Target { impl one_sum_checked }
