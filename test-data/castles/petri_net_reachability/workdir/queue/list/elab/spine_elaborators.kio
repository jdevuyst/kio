    , .(term: __Checked_term__) -> __Checked_term__ { term }
    , .(_message: __Diagnostic_text__) -> __Checked_term__ { value }
    )
}

pure fn spine_identity_impl(
  , ct: __Comptime__
  , source: __Type__
  , value: __Checked_term__
  , _target: __Type__
  ) -> __Checked_term__ | __Diagnostic_text__ {
  __if_then_else__(
    , __type_equal__(ct, right_fold_product(ct, product_spine(ct, source)), source)
    , .() -> __Checked_term__ | __Diagnostic_text__ { ok(ct, value) }
    , .() -> __Checked_term__ | __Diagnostic_text__ {
        __right__(__Checked_term__, __Diagnostic_text__, "product spine utility failed")
      }
    )
}

