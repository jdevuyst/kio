pure fn type_list_contains(ct: __Comptime__, needle: __Type__, haystack: Type_list) -> Comptime_bool {
  __either__(
    , Type_take
    , .
    , Comptime_bool
    , take_first_type_matching(ct, needle, haystack)
    , .(_take: Type_take) -> Comptime_bool { .t }
    , .(_missing: .) -> Comptime_bool { .f }
    )
}

type Unique_types_state = Type_list;

type Unique_types_next = Type_list & Unique_types_state;

type Unique_types_step = Type_list | Unique_types_next;

pure fn unique_types(ct: __Comptime__, xs: Type_list) -> Type_list {
  __structural_recur__(
    , ct
    , Type_list
    , Unique_types_state
    , Type_list
    , xs
    , type_nil()
    , .(
        , loop_recur: (Type_list & Unique_types_state) -> Type_list
        , loop_fuel: Type_list
        , loop_state: Unique_types_state
        ) -> Type_list {
        let loop_step_fn =
          .(fuel: Type_list, acc_rev: Unique_types_state) -> Unique_types_step {
            __either__(
              , .
              , __Type__ & Type_list
              , Unique_types_step
              , Type_list.un_type_list(fuel)
              , .(_done: .) -> Unique_types_step {
                  __left__(Type_list, Unique_types_next, type_reverse(ct, acc_rev))
                }
              , .(cell: __Type__ & Type_list) -> Unique_types_step {
                  let head = __fst__(__Type__, Type_list, cell);
                  __if_then_else__(
                    , type_list_contains(ct, head, acc_rev)
                    , .() -> Unique_types_step {
                        __right__(
                          , Type_list
                          , Unique_types_next
                          , (__snd__(__Type__, Type_list, cell), acc_rev)
                          )
                      }
                    , .() -> Unique_types_step {
                        __right__(
                          , Type_list
                          , Unique_types_next
                          , (__snd__(__Type__, Type_list, cell), type_cons(ct, head, acc_rev))
                          )
                      }
                    )
                }
              )
          };
        __either__(
          , Type_list
          , Type_list & Unique_types_state
          , Type_list
          , loop_step_fn(loop_fuel, loop_state)
          , .(loop_done: Type_list) -> Type_list { loop_done }
          , .(loop_next: Type_list & Unique_types_state) -> Type_list {
              loop_recur(
                , __fst__(Type_list, Unique_types_state, loop_next)
                , __snd__(Type_list, Unique_types_state, loop_next)
                )
            }
          )
      }
    )
}

pure fn narrow_sum_impl(
  , ct: __Comptime__
  , source: __Type__
  , value: __Checked_term__
  , target: __Type__
  ) -> Elaborator_result {
  let source_spine = sum_spine(ct, source);
  let target_spine = sum_spine(ct, target);
  __if_then_else__(
    , route_result_present(
        , ct
        , route_source_arms_unique(ct, target_spine, target_slots(ct, source_spine))
        )
    , .() -> Elaborator_result {
        __either__(
          , Route_list
          , __Diagnostic_text__
          , Elaborator_result
          , route_source_arms_collapse(ct, source_spine, target_slots(ct, target_spine))
          , .(routes: Route_list) -> Elaborator_result {
              build_sum_from_routes(ct, source_spine, target, target_spine, routes, value)
            }
          , .(message: __Diagnostic_text__) -> Elaborator_result { err(ct, message) }
          )
      }
    , .() -> Elaborator_result { err(ct, "target sum arm is not provided by source") }
    )
}

pure fn narrow_sum_result(
  , ct: __Comptime__
  , source: __Type__
  , value: __Checked_term__
  , target: Optional_type
  ) -> Elaborator_result {
  __either__(
    , __Type__
    , .
    , Elaborator_result
    , target
    , .(target_type: __Type__) -> Elaborator_result {
        narrow_sum_impl(ct, source, value, target_type)
      }
    , .() -> Elaborator_result {
        narrow_sum_impl(
          , ct
          , source
          , value
          , right_fold_sum(ct, unique_types(ct, sum_spine(ct, source)))
          )
      }
    )
}

