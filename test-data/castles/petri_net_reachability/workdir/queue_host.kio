module queue_host;

import testapi as api;
import testapi/arith as arithmetic;
import testapi/iter as iteration;
import testapi/text as text;

pub type Bool = api.Bool;

pub type I32 = api.I32;

pub type String = api.String;

pub fn add_i32(a: I32, b: I32) -> I32 { arithmetic.add_i32(a, b) }

pub fn sub_i32(a: I32, b: I32) -> I32 { arithmetic.sub_i32(a, b) }

pub fn eq_i32(a: I32, b: I32) -> Bool { arithmetic.eq_i32(a, b) }

pub fn lt_i32(a: I32, b: I32) -> Bool { arithmetic.lt_i32(a, b) }

pub fn loop[S][R](step: S -> S | R, state: S) -> R { iteration.loop(step, state) }

pub fn string_concat(a: String, b: String) -> String { text.string_concat(a, b) }
