mod petri/report;

import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import petri/fixture as fixture;
import petri/model as model;
import petri/search as search;
import petri/witness as witness;
import queue/list/core as lists;
import queue/list/list as traversal;
import testapi { type Bool; type I32; type String }
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/text as text;

fn line(label: String, value: String) {
  io.print(value.>text.string_concat("\n").>>text.string_concat(label))
}

fn number(label: String, value: I32) { line(label, fmt.int_to_string(value)) }

fn flag(label: String, value: Bool) { line(label, fmt.bool_to_string(value)) }

fn rejected(net: model.Net, transition: model.Transition) -> Bool {
  if(model.enabled(net, transition, net.>select { model.Initial.get })) { .f } else { .t }
}

fn print_witness(net: model.Net, result: search.Search) {
  match(result.>select { search.First_deadlock.get }) {
    .(node: search.Node) {
      number("shortest deadlock depth: ", node.>select { search.Depth.get });
      match(witness.reconstruct(result.>select { search.Visited.get }, node, lists.nil[_])) {
        .(path: witness.Path) {
          number("witness transitions: ", traversal.length(path));
          line("  0: initial -> ", witness.show_marking(net.>select { model.Initial.get }));
          let replayed = witness.replay(net, path, net.>select { model.Initial.get }, 1);
          flag(
          , "replay reaches unfinished deadlock: "
          , witness.agrees(net, replayed, node.>select { search.Marking.get })
          )
        };
        .() { line("witness: ", "broken predecessor chain") }
      }
    };
    .() { line("witness: ", "no deadlock") }
  }
}

pub fn run() {
  let net = fixture.locking();
  let result = search.run(net);
  io.print("Opposite-lock Petri net (capacity 1)\n");
  io.print("places: left-wait left-hold left-done right-wait right-hold right-done "
           "lock-a lock-b\n");
  number("reachable markings: ", traversal.length(result.>select { search.Visited.get }));
  number("enabled edges: ", result.>select { search.Edges.get });
  number("duplicate discoveries: ", result.>select { search.Duplicates.get });
  number("peak FIFO frontier: ", result.>select { search.Peak.get });
  number("completed terminals: ", result.>select { search.Terminals.get });
  number("unfinished deadlocks: ", result.>select { search.Deadlocks.get });
  print_witness(net, result);
  match(traversal.at(2, net.>select { model.Transitions.get })) {
    .(finish: model.Transition) {
      flag("finish before acquisition rejected: ", rejected(net, finish))
    };
    .() { line("finish check: ", "missing transition") }
  };
  flag("capacity overflow rejected: ", rejected(net, fixture.overflowing()));
  let complete = search.run(fixture.already_completed());
  number("initially completed: terminals=", complete.>select { search.Terminals.get });
  number("initially completed: deadlocks=", complete.>select { search.Deadlocks.get });
  let stuck_net = fixture.already_stuck();
  let stuck = search.run(stuck_net);
  number("initially stuck: terminals=", stuck.>select { search.Terminals.get });
  number("initially stuck: deadlocks=", stuck.>select { search.Deadlocks.get });
  print_witness(stuck_net, stuck)
}
