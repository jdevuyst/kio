mod inventory_cycle_counter/model;

import testapi { type I32; type String }

pub type Bin = { Code: String; Expected: I32; Observed: I32 };

pub fn bin_a() -> Bin { (Code.mk("A"), Expected.mk(12), Observed.mk(12)) }

pub fn bin_b() -> Bin { (Code.mk("B"), Expected.mk(8), Observed.mk(6)) }

pub fn bin_c() -> Bin { (Code.mk("C"), Expected.mk(5), Observed.mk(9)) }

pub fn bin_d() -> Bin { (Code.mk("D"), Expected.mk(14), Observed.mk(13)) }
