module testapi/arith;

import testapi(Bool, I32);

host fn add(p0: I32, p1: I32) -> I32;

host fn sub(p0: I32, p1: I32) -> I32;

host fn mul(p0: I32, p1: I32) -> I32;

host fn div(p0: I32, p1: I32) -> I32;

host fn mod(p0: I32, p1: I32) -> I32;

host fn eq_i32(p0: I32, p1: I32) -> Bool;

host fn lt_i32(p0: I32, p1: I32) -> Bool;
