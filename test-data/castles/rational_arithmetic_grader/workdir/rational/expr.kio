/// The exercise expression language and its evaluator.
mod rational/expr;

import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import rational/arith as ops;
import rational/core as core;
import rational/core { type Division_by_zero; type Eval; type Fraction; type Rational }
import testapi { type I32 }
import testapi/iter { fn loop }

pub type { Lit: Fraction }

rec {
  pub type { Expr: Lit | Add | Sub | Mul | Div };
  pub type { Add: Expr & Expr };
  pub type { Sub: Expr & Expr };
  pub type { Mul: Expr & Expr };
  pub type { Div: Expr & Expr }
}

type Node = Lit | Add | Sub | Mul | Div;

fn wrap(node: Node) -> Expr { Expr.mk(node) }

pub fn lit(numerator: I32, denominator: I32) -> Expr {
  wrap((Lit.mk(core.fraction(numerator, denominator)).>widen_sum)[Node])
}

pub fn add(left: Expr, right: Expr) -> Expr { wrap((Add.mk(left, right).>widen_sum)[Node]) }

pub fn sub(left: Expr, right: Expr) -> Expr { wrap((Sub.mk(left, right).>widen_sum)[Node]) }

pub fn mul(left: Expr, right: Expr) -> Expr { wrap((Mul.mk(left, right).>widen_sum)[Node]) }

pub fn div(left: Expr, right: Expr) -> Expr { wrap((Div.mk(left, right).>widen_sum)[Node]) }

/// Thread two evaluated children into a binary operation, stopping at the first
/// fault. This is the whole of the error propagation: a division by zero found
/// arbitrarily deep in the tree rides out through every node above it without
/// any of them having to look for it.
fn combine(left: Eval, right: Eval, op: (Rational & Rational) -> Eval) -> Eval {
  match(left) {
    (
    , .(ready: Rational) {
        match(right) {
          (
          , .(other: Rational) { op(ready, other) }
          , .(fault: Division_by_zero) { widen_sum(fault)[Eval] }
          )
        }
      }
    , .(fault: Division_by_zero) { widen_sum(fault)[Eval] }
    )
  }
}

pub rec(loop) fn eval(value: Expr) -> Eval {
  match(Expr.get(value)) {
    (
    , .(node: Lit) { core.reduce(Lit.get(node)) }
    , .(node: Add) {
        match(Add.get(node)) {
          .(left: Expr, right: Expr) {
            combine(recur(cont) eval(left), recur(cont) eval(right), ops.add)
          }
        }
      }
    , .(node: Sub) {
        match(Sub.get(node)) {
          .(left: Expr, right: Expr) {
            combine(recur(cont) eval(left), recur(cont) eval(right), ops.sub)
          }
        }
      }
    , .(node: Mul) {
        match(Mul.get(node)) {
          .(left: Expr, right: Expr) {
            combine(recur(cont) eval(left), recur(cont) eval(right), ops.mul)
          }
        }
      }
    , .(node: Div) {
        match(Div.get(node)) {
          .(left: Expr, right: Expr) {
            combine(recur(cont) eval(left), recur(cont) eval(right), ops.div)
          }
        }
      }
    )
  }
}
