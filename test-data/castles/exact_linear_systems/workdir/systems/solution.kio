mod systems/solution;

import list/core as c;
import list/list as l;
import list_host as integers;
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import systems/matrix as m;
import systems/rational as q;
import systems/reduce as reduction;
import testapi { type Bool; type I32 }

pub type Family = { Particular: m.Row; Directions: m.Matrix; Free_columns: c.List[I32] };

pub type Outcome = { Solved: Family } | { Inconsistent: q.Rational };

fn is_free(column: I32, pivots: c.List[I32]) -> Bool {
  if(l.elem(integers.eq_i32, column, pivots)) { .f } else { .t }
}

fn particular(reduced: m.Matrix, pivots: c.List[I32], variables: I32) -> m.Row {
  l.map(
  , .(column) {
      match(l.index_of(integers.eq_i32, column, pivots)) {
        .(row: I32) { m.at(m.row_at(reduced, row), variables) };
        .() { q.zero() }
      }
    }
  , m.indices(variables)
  )
}

fn direction(reduced: m.Matrix, pivots: c.List[I32], variables: I32, free: I32) -> m.Row {
  l.map(
  , .(column) {
      match(l.index_of(integers.eq_i32, column, pivots)) {
        .(row: I32) { q.negate(m.at(m.row_at(reduced, row), free)) };
        .() {
          if(integers.eq_i32(column, free)) { q.integer(1) } else { q.zero() }
        }
      }
    }
  , m.indices(variables)
  )
}

pub fn solve(result: reduction.Reduction, variables: I32) -> Outcome {
  let reduced = result.>select { reduction.Reduced.get };
  let pivots = result.>select { reduction.Pivots.get };
  match(l.find(.(row) { reduction.contradictory(row, variables) }, reduced)) {
    .(row: m.Row) { Inconsistent.mk(m.at(row, variables)).>widen_sum };
    .() {
      let free_columns = l.filter(.(column) { is_free(column, pivots) }, m.indices(variables));
      let family =
        (
        , Particular.mk(particular(reduced, pivots, variables))
        , Directions.mk(l.map(.(free) { direction(reduced, pivots, variables, free) }, free_columns))
        , Free_columns.mk(free_columns)
        );
      Solved.mk(family).>widen_sum
    }
  }
}
