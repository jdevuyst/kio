module systems/reduce;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import list/core as c;
import list/list as l;
import list_host as integers;
import systems/matrix as m;
import systems/rational as q;
import testapi(Bool, I32);
import testapi/arith as a;
import testapi/iter(loop);

pub labels Reduction = { reduced: m.Matrix, pivots: c.List(I32), swaps: I32 };

rec(loop) fn find_pivot(matrix: m.Matrix, column: I32, row: I32) -> I32 | . {
  if! a.leq_i32(l.length(matrix), row) {
    ().>widen_sum!
  } else if! q.is_zero(m.at(m.row_at(matrix, row), column)) {
    rec find_pivot(matrix, column, a.add_i32(row, 1))
  } else {
    row.>widen_sum!
  }
}

fn eliminate(matrix: m.Matrix, pivot_row: I32, column: I32) -> m.Matrix {
  let pivot = m.row_at(matrix, pivot_row);
  l.map(
    , .(row_index) {
        let row = m.row_at(matrix, row_index);
        if! integers.eq_i32(row_index, pivot_row) {
          row
        } else {
          m.subtract_multiple(row, pivot, m.at(row, column))
        }
      }
    , m.indices(l.length(matrix))
    )
}

rec(loop) fn columns(matrix: m.Matrix, variables: I32, column: I32, pivots: c.List(I32), swaps: I32) -> Reduction {
  let rank = l.length(pivots);
  if! a.leq_i32(variables, column) {
    {reduced = matrix, pivots, swaps}
  } else match! find_pivot(matrix, column, rank) {
    .(found: I32) {
      let switched = m.swap(matrix, rank, found);
      let pivot = m.row_at(switched, rank);
      let normalized = m.replace(switched, rank, m.scale(pivot, m.at(pivot, column)));
      let next_swaps =
        if! integers.eq_i32(found, rank) {
          swaps
        } else {
          a.add_i32(swaps, 1)
        };
      rec columns(
        , eliminate(normalized, rank, column)
        , variables
        , a.add_i32(column, 1)
        , l.append(pivots, c.singleton(column))
        , next_swaps
        )
    };
    .() { rec columns(matrix, variables, a.add_i32(column, 1), pivots, swaps) }
  }
}

pub fn rref(matrix: m.Matrix, variables: I32) -> Reduction {
  columns(matrix, variables, 0, c.nil(), 0)
}

pub fn contradictory(row: m.Row, variables: I32) -> Bool {
  if! m.all_zero(l.take(variables, row)) {
    if! q.is_zero(m.at(row, variables)) {
      .f
    } else {
      .t
    }
  } else {
    .f
  }
}
