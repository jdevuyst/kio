mod systems/rational;

import list_host as integers;
import macros/control { macro if }
import macros/row_macros { macro select }
import testapi { type Bool; type I32; type String }
import testapi/arith as a;
import testapi/fmt as fmt;
import testapi/iter { fn loop }
import testapi/text as text;

pub type Rational = { Numerator: I32; Denominator: I32 };

fn absolute(n: I32) -> I32 {
  if(a.lt_i32(n, 0)) { a.sub_i32(0, n) } else { n }
}

rec(loop) fn gcd(a0: I32, b: I32) -> I32 {
  if(integers.eq_i32(b, 0)) { a0 } else { recur gcd(b, a.mod_i32(a0, b)) }
}

fn normalized(n: I32, d: I32) -> Rational {
  let divisor = gcd(absolute(n), d);
  (Numerator.mk(a.div_i32(n, divisor)), Denominator.mk(a.div_i32(d, divisor)))
}

pub fn make(n: I32, d: I32) -> Rational {
  if(a.lt_i32(d, 0)) { normalized(a.sub_i32(0, n), a.sub_i32(0, d)) } else { normalized(n, d) }
}

pub fn integer(n: I32) -> Rational { make(n, 1) }

pub fn zero() -> Rational { integer(0) }

pub fn is_zero(q: Rational) -> Bool {
  integers.eq_i32(q.>select { Numerator.get }, 0)
}

pub fn negate(q: Rational) -> Rational {
  make(a.sub_i32(0, q.>select { Numerator.get }), q.>select { Denominator.get })
}

pub fn add(x: Rational, y: Rational) -> Rational {
  make(
  , a.add_i32(
    , a.mul_i32(x.>select { Numerator.get }, y.>select { Denominator.get })
    , a.mul_i32(y.>select { Numerator.get }, x.>select { Denominator.get })
    )
  , a.mul_i32(x.>select { Denominator.get }, y.>select { Denominator.get })
  )
}

pub fn subtract(x: Rational, y: Rational) -> Rational { add(x, negate(y)) }

pub fn multiply(x: Rational, y: Rational) -> Rational {
  make(
  , a.mul_i32(x.>select { Numerator.get }, y.>select { Numerator.get })
  , a.mul_i32(x.>select { Denominator.get }, y.>select { Denominator.get })
  )
}

pub fn divide(x: Rational, y: Rational) -> Rational {
  make(
  , a.mul_i32(x.>select { Numerator.get }, y.>select { Denominator.get })
  , a.mul_i32(x.>select { Denominator.get }, y.>select { Numerator.get })
  )
}

pub fn show(q: Rational) -> String {
  if(integers.eq_i32(q.>select { Denominator.get }, 1)) {
    fmt.int_to_string(q.>select { Numerator.get })
  } else {
    text.string_concat(
    , fmt.int_to_string(q.>select { Numerator.get })
    , text.string_concat("/", fmt.int_to_string(q.>select { Denominator.get }))
    )
  }
}
