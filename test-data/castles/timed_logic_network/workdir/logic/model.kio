module logic/model;

import list/core as lists;
import list/list as traversal;
import list_host as numbers;
import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import macros/spine_macros(macro widen_sum);
import testapi(Bool, I32, String);

pub type Signal = { Wire: I32; Level: Bool };

pub type Event = { At: I32; Serial: I32; Target: I32; Value: Bool; Source: Bool };

pub type Primitive = { Buffer: I32 } | { Xor: I32 & I32 };

pub type Gate = { Output: I32; Operation: Primitive; Delay: I32; Inertial: Bool };

pub type State = {
  Wires: lists.List[Signal];
  Ideals: lists.List[Signal];
  Agenda: lists.List[Event];
  Next_serial: I32;
  Edges: I32;
  Canceled: I32;
  Last_time: I32
};

pub fn same_bit(a: Bool, b: Bool) -> Bool {
  if(a) { b } else if(b) { .f } else { .t }
}

pub fn initial_wires() -> lists.List[Signal] {
  lists.cons(
  , (Wire.mk(0), Level.mk(.f))
  , lists.cons(
    , (Wire.mk(1), Level.mk(.f))
    , lists.cons(
      , (Wire.mk(2), Level.mk(.f))
      , lists.cons((Wire.mk(3), Level.mk(.f)), lists.singleton((Wire.mk(4), Level.mk(.f))))
      )
    )
  )
}

pub fn read_wire(id: I32, wires: lists.List[Signal]) -> Bool {
  match(traversal.find(
  , .(signal: Signal) {
      numbers.eq_i32(signal.>select { Wire.get }, id)
    }
  , wires
  )) {
    .(signal: Signal) {
      signal.>select { Level.get }
    };
    .() { .f }
  }
}

pub fn write_wire(id: I32, bit: Bool, wires: lists.List[Signal]) -> lists.List[Signal] {
  traversal.map(
  , .(signal: Signal) {
      if(numbers.eq_i32(signal.>select { Wire.get }, id)) {
        (Wire.mk(id), Level.mk(bit))
      } else {
        signal
      }
    }
  , wires
  )
}

pub fn name(id: I32) -> String {
  if(numbers.eq_i32(id, 0)) {
    "A"
  } else if(numbers.eq_i32(id, 1)) {
    "slow"
  } else if(numbers.eq_i32(id, 2)) {
    "H"
  } else if(numbers.eq_i32(id, 3)) {
    "T"
  } else {
    "I"
  }
}

pub fn affected(op: Primitive, id: I32) -> Bool {
  match(op) {
    .(input: Buffer) {
      numbers.eq_i32(input.>select { Buffer.get }, id)
    };
    .(inputs: Xor) {
      let .(a, b) = inputs.>select { Xor.get };
      if(numbers.eq_i32(a, id)) { .t } else { numbers.eq_i32(b, id) }
    }
  }
}

pub fn evaluate(op: Primitive, wires: lists.List[Signal]) -> Bool {
  match(op) {
    .(input: Buffer) {
      read_wire(input.>select { Buffer.get }, wires)
    };
    .(inputs: Xor) {
      let .(a, b) = inputs.>select { Xor.get };
      if(same_bit(read_wire(a, wires), read_wire(b, wires))) { .f } else { .t }
    }
  }
}

pub fn circuit() -> lists.List[Gate] {
  lists.cons(
  , (Output.mk(1), Operation.mk((Buffer.mk(0).>widen_sum)[Primitive]), Delay.mk(3), Inertial.mk(.f))
  , lists.cons(
    , (
      , Output.mk(2)
      , Operation.mk((Xor.mk((0, 1)).>widen_sum)[Primitive])
      , Delay.mk(1)
      , Inertial.mk(.f)
      )
    , lists.cons(
      , (
        , Output.mk(3)
        , Operation.mk((Buffer.mk(2).>widen_sum)[Primitive])
        , Delay.mk(2)
        , Inertial.mk(.f)
        )
      , lists.singleton((
        , Output.mk(4)
        , Operation.mk((Buffer.mk(2).>widen_sum)[Primitive])
        , Delay.mk(2)
        , Inertial.mk(.t)
        ))
      )
    )
  )
}

pub fn initial_state(events: lists.List[Event]) -> State {
  (
  , Wires.mk(initial_wires())
  , Ideals.mk(initial_wires())
  , Agenda.mk(events)
  , Next_serial.mk(traversal.length(events))
  , Edges.mk(0)
  , Canceled.mk(0)
  , Last_time.mk(0)
  )
}
