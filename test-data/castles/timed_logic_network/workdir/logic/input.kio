mod logic/input;

import list/core as lists;
import logic/model as model;
import logic/queue as queue;
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter { fn loop }
import testapi/text as text;

type Line = { Edge: model.Event } | { End: . } | { Invalid: String };

pub type Parsed = { Stimulus: lists.List[model.Event] } | { Problem: String };

fn parse_bit(at: I32, serial: I32, line: String) -> Line {
  if(text.string_eq(line, "0")) {
    Edge.mk((
    , model.At.mk(at)
    , model.Serial.mk(serial)
    , model.Target.mk(0)
    , model.Value.mk(.f)
    , model.Source.mk(.t)
    ))
      .>widen_sum
  } else if(text.string_eq(line, "1")) {
    Edge.mk((
    , model.At.mk(at)
    , model.Serial.mk(serial)
    , model.Target.mk(0)
    , model.Value.mk(.t)
    , model.Source.mk(.t)
    ))
      .>widen_sum
  } else {
    Invalid.mk("source value must be 0 or 1").>widen_sum
  }
}

fn read_edge(previous: I32, serial: I32) -> Line {
  match(io.read_ascii_line()) {
    .(line: String) {
      if(arith.leq_i32(16, serial)) {
        Invalid.mk("at most 16 source transitions").>widen_sum
      } else match(fmt.string_to_int(line)) {
        .(at: I32) {
          let valid =
            if(arith.leq_i32(1, at)) {
              if(arith.leq_i32(at, 30)) { arith.leq_i32(previous, at) } else { .f }
            } else {
              .f
            };
          if(valid) {
            match(io.read_ascii_line()) {
              .(bit: String) { parse_bit(at, serial, bit) };
              .() { Invalid.mk("missing source value").>widen_sum }
            }
          } else {
            Invalid.mk("times must be nondecreasing integers from 1 through 30").>widen_sum
          }
        };
        .() { Invalid.mk("time must be an integer").>widen_sum }
      }
    };
    .() { End.mk(()).>widen_sum }
  }
}

rec(loop) fn read_all(previous: I32, serial: I32, events: lists.List[model.Event]) -> Parsed {
  match(read_edge(previous, serial)) {
    .(next: Edge) {
      let event = next.>select { Edge.get };
      recur read_all(
      , event.>select { model.At.get }
      , arith.add_i32(serial, 1)
      , queue.insert(event, events)
      )
    };
    .(_end: End) { Stimulus.mk(events).>widen_sum };
    .(error: Invalid) {
      Problem.mk(error.>select { Invalid.get }).>widen_sum
    }
  }
}

pub fn read() -> Parsed { read_all(0, 0, lists.nil[_]) }
