module logic/simulate;

import list/core as lists;
import list/list as traversal;
import logic/model as model;
import logic/queue as queue;
import logic/report as report;
import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select, macro with);
import testapi(Bool, I32);
import testapi/arith as arith;
import testapi/iter(loop);

rec(loop) fn cancellation_report(now: I32, canceled: lists.List[model.Event]) {
  match(lists.uncons(canceled)) {
    .(event: model.Event, tail: lists.List[model.Event]) {
      report.canceled(now, event);
      recur cancellation_report(now, tail)
    };
    .() { () }
  }
}

fn cancel_pending(now: I32, output: I32, state: model.State) -> model.State {
  let canceled = queue.for_wire(output, state.>select { model.Agenda.get });
  cancellation_report(now, canceled);
  state.>with {
    model.Agenda.mk(queue.without_wire(output, state.>select { model.Agenda.get }));
    model.Canceled.mk(arith.add_i32(
    , state.>select { model.Canceled.get }
    , traversal.length(canceled)
    ))
  }
}

fn schedule(now: I32, gate: model.Gate, desired: Bool, state: model.State) -> model.State {
  let event =
    (
    , model.At.mk(arith.add_i32(now, gate.>select { model.Delay.get }))
    , model.Serial.mk(state.>select { model.Next_serial.get })
    , model.Target.mk(gate.>select { model.Output.get })
    , model.Value.mk(desired)
    , model.Source.mk(.f)
    );
  state.>with {
    model.Agenda.mk(queue.insert(event, state.>select { model.Agenda.get }));
    model.Next_serial.mk(arith.add_i32(state.>select { model.Next_serial.get }, 1))
  }
}

fn propagate(now: I32, changed: I32, state: model.State, gate: model.Gate) -> model.State {
  if(model.affected(gate.>select { model.Operation.get }, changed)) {
    let output = gate.>select { model.Output.get };
    let desired = model.evaluate(
    , gate.>select { model.Operation.get }
    , state.>select { model.Wires.get }
    );
    if(model.same_bit(desired, model.read_wire(output, state.>select { model.Ideals.get }))) {
      state
    } else {
      let .(updated: model.State) = state.>with {
        model.Ideals.mk(model.write_wire(output, desired, state.>select { model.Ideals.get }))
      };
      if(gate.>select { model.Inertial.get }) {
        let canceled = cancel_pending(now, output, updated);
        if(model.same_bit(desired, model.read_wire(output, canceled.>select { model.Wires.get }))) {
          canceled
        } else {
          schedule(now, gate, desired, canceled)
        }
      } else {
        schedule(now, gate, desired, updated)
      }
    }
  } else {
    state
  }
}

fn commit(event: model.Event, state: model.State, gates: lists.List[model.Gate]) -> model.State {
  let wire = event.>select { model.Target.get };
  let value = event.>select { model.Value.get };
  if(model.same_bit(model.read_wire(wire, state.>select { model.Wires.get }), value)) {
    state
  } else {
    report.edge(event);
    let .(updated: model.State) = state.>with {
      model.Wires.mk(model.write_wire(wire, value, state.>select { model.Wires.get }));
      model.Edges.mk(arith.add_i32(state.>select { model.Edges.get }, 1))
    };
    traversal.foldl(
    , .(current: model.State, gate: model.Gate) {
        propagate(event.>select { model.At.get }, wire, current, gate)
      }
    , updated
    , gates
    )
  }
}

pub rec(loop) fn run(state: model.State, gates: lists.List[model.Gate]) -> model.State {
  match(lists.uncons(state.>select { model.Agenda.get })) {
    .(event: model.Event, tail: lists.List[model.Event]) {
      let next =
        commit(
        , event
        , state.>with {
            model.Agenda.mk(tail);
            model.Last_time.mk(event.>select { model.At.get })
          }
        , gates
        );
      recur run(next, gates)
    };
    .() { state }
  }
}
