module logic/report;

import list/list as traversal;
import logic/model as model;
import macros/control(macro if);
import macros/row_macros(macro select);
import testapi(Bool, I32, String);
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/text as text;

fn bit(value: Bool) -> String {
  if(value) { "1" } else { "0" }
}

fn time(at: I32) -> String {
  text.string_concat("t=", text.string_concat(fmt.int_to_string(at), " "))
}

fn assignment(wire: I32, value: Bool) -> String {
  text.string_concat(model.name(wire), text.string_concat("=", bit(value)))
}

pub fn header(count: I32) {
  io.print("logic: A -> slow(3); H=xor(A,slow)(1); T=transport(H,2); I=inertial(H,2)\n");
  io.print(fmt.int_to_string(count)
    .>text.string_concat(" initial A=0 slow=0 H=0 T=0 I=0\n")
    .>>text.string_concat("sources="))
}

pub fn edge(event: model.Event) {
  io.print(assignment(event.>select { model.Target.get }, event.>select { model.Value.get })
    .>text.string_concat("\n")
    .>>text.string_concat(time(event.>select { model.At.get })))
}

pub fn canceled(now: I32, event: model.Event) {
  io.print(text.string_concat(
  , time(now)
  , text.string_concat(
    , "cancel "
    , text.string_concat(
      , assignment(event.>select { model.Target.get }, event.>select { model.Value.get })
      , text.string_concat(
        , " due="
        , text.string_concat(fmt.int_to_string(event.>select { model.At.get }), "\n")
        )
      )
    )
  ))
}

fn show_wire(message: String, signal: model.Signal) -> String {
  text.string_concat(
  , message
  , text.string_concat(
    , " "
    , assignment(signal.>select { model.Wire.get }, signal.>select { model.Level.get })
    )
  )
}

pub fn summary(state: model.State) {
  io.print(text.string_concat(
  , "settled-at="
  , text.string_concat(
    , fmt.int_to_string(state.>select { model.Last_time.get })
    , text.string_concat(
      , " edges="
      , text.string_concat(
        , fmt.int_to_string(state.>select { model.Edges.get })
        , text.string_concat(
          , " canceled="
          , text.string_concat(fmt.int_to_string(state.>select { model.Canceled.get }), "\n")
          )
        )
      )
    )
  ));
  io.print(text.string_concat(
  , traversal.foldl(show_wire, "final", state.>select { model.Wires.get })
  , "\n"
  ))
}
