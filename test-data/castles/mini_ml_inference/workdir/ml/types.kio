module ml/types;

import list/core as lists;
import list/list as walk;
import list_host as number;
import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import macros/spine_macros(macro widen_sum);
import testapi(Bool, I32, String);
import testapi/fmt as fmt;
import testapi/iter(loop);
import testapi/text as text;

pub rec type Ty =
  { Variable: I32 } | { Integer: . } | { Boolean: . } | { Arrow: Ty & Ty } | { Pair: Ty & Ty }
  ;

pub fn variable_type(id: I32) -> Ty { Variable.mk(id).>widen_sum }

pub fn integer_type() -> Ty { Integer.mk(()).>widen_sum }

pub fn boolean_type() -> Ty { Boolean.mk(()).>widen_sum }

pub fn arrow_type(a: Ty, b: Ty) -> Ty { Arrow.mk((a, b)).>widen_sum }

pub fn pair_type(a: Ty, b: Ty) -> Ty { Pair.mk((a, b)).>widen_sum }

pub type Substitution = lists.List[I32 & Ty];

pub rec(loop) fn lookup(id: I32, substitutions: Substitution) -> . | Ty {
  match(lists.uncons(substitutions)) {
    .((key: I32, value: Ty), rest: Substitution) {
      if(number.eq_i32(key, id)) { value.>widen_sum } else { recur lookup(id, rest) }
    };
    .() { ().>widen_sum }
  }
}

pub rec(loop) fn apply(substitutions: Substitution, ty: Ty) -> Ty {
  match(ty) {
    .(v: Variable) {
      match(lookup(v.>select { Variable.get }, substitutions)) {
        .(found: Ty) { recur apply(substitutions, found) };
        .() { ty }
      }
    };
    .(f: Arrow) {
      let .(a: Ty, b: Ty) = f.>select { Arrow.get };
      arrow_type(recur(cont) apply(substitutions, a), recur(cont) apply(substitutions, b))
    };
    .(p: Pair) {
      let .(a: Ty, b: Ty) = p.>select { Pair.get };
      pair_type(recur(cont) apply(substitutions, a), recur(cont) apply(substitutions, b))
    };
    .() { ty }
  }
}

pub rec(loop) fn variables(ty: Ty) -> lists.List[I32] {
  match(ty) {
    .(v: Variable) {
      lists.singleton(v.>select { Variable.get })
    };
    .(f: Arrow) {
      let .(a: Ty, b: Ty) = f.>select { Arrow.get };
      walk.append(recur(cont) variables(a), recur(cont) variables(b))
    };
    .(p: Pair) {
      let .(a: Ty, b: Ty) = p.>select { Pair.get };
      walk.append(recur(cont) variables(a), recur(cont) variables(b))
    };
    .() { lists.nil[_] }
  }
}

pub fn contains(id: I32, ids: lists.List[I32]) -> Bool { walk.elem(number.eq_i32, id, ids) }

pub fn unique(ids: lists.List[I32]) -> lists.List[I32] {
  walk.reverse(walk.foldl(
  , .(seen: lists.List[I32], id: I32) {
      if(contains(id, seen)) { seen } else { lists.cons(id, seen) }
    }
  , lists.nil[_]
  , ids
  ))
}

fn combine(a: String, separator: String, b: String) -> String {
  text.string_concat(
  , "("
  , text.string_concat(a, text.string_concat(separator, text.string_concat(b, ")")))
  )
}

rec(loop) fn render(ty: Ty, names: lists.List[I32]) -> String {
  match(ty) {
    .(v: Variable) {
      match(walk.index_of(number.eq_i32, v.>select { Variable.get }, names)) {
        .(index: I32) { text.string_concat("a", fmt.int_to_string(index)) };
        .() { "?" }
      }
    };
    .(_i: Integer) { "Int" };
    .(_b: Boolean) { "Bool" };
    .(f: Arrow) {
      let .(a: Ty, b: Ty) = f.>select { Arrow.get };
      combine(recur(cont) render(a, names), " -> ", recur(cont) render(b, names))
    };
    .(p: Pair) {
      let .(a: Ty, b: Ty) = p.>select { Pair.get };
      combine(recur(cont) render(a, names), " * ", recur(cont) render(b, names))
    }
  }
}

pub fn show(ty: Ty) -> String { render(ty, unique(variables(ty))) }
