mod ml/syntax;

import macros/spine_macros { macro widen_sum }
import testapi { type String }

pub rec type Expr =
  | { Integer: . }
  | { Boolean: . }
  | { Variable: String }
  | { Lambda: String & Expr }
  | { Apply: Expr & Expr }
  | { Binding: String & Expr & Expr }
  | { Pair: Expr & Expr }
  ;

pub fn integer_expr() -> Expr { Integer.mk(()).>widen_sum }

pub fn boolean_expr() -> Expr { Boolean.mk(()).>widen_sum }

pub fn variable_expr(name: String) -> Expr { Variable.mk(name).>widen_sum }

pub fn lambda_expr(name: String, body: Expr) -> Expr { Lambda.mk((name, body)).>widen_sum }

pub fn apply_expr(function: Expr, argument: Expr) -> Expr {
  Apply.mk((function, argument)).>widen_sum
}

pub fn binding_expr(name: String, value: Expr, body: Expr) -> Expr {
  Binding.mk((name, value, body)).>widen_sum
}

pub fn pair_expr(a: Expr, b: Expr) -> Expr { Pair.mk((a, b)).>widen_sum }
