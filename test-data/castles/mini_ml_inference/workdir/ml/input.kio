module ml/input;

import list/core as lists;
import list/list as walk;
import macros/control(macro if);
import macros/match(macro match);
import macros/spine_macros(macro widen_sum);
import testapi(Bool, I32, String);
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter(loop);

pub fn count() -> I32 | String {
  match(io.read_ascii_line()) {
    .(line: String) {
      match(fmt.string_to_int(line)) {
        .(n: I32) {
          if(arith.leq_i32(0, n)) {
            n.>widen_sum
          } else {
            "negative frame count"[String].>widen_sum
          }
        };
        .() { "invalid frame count"[String].>widen_sum }
      }
    };
    .() { "missing frame count"[String].>widen_sum }
  }
}

rec(loop) fn read_tokens(remaining: I32, reversed: lists.List[String]) ->
  lists.List[String] | String
   {
  if(arith.leq_i32(remaining, 0)) {
    walk.reverse(reversed).>widen_sum
  } else match(io.read_ascii_line()) {
    .(token: String) { recur read_tokens(arith.sub_i32(remaining, 1), lists.cons(token, reversed)) };
    .() { "incomplete token frame"[String].>widen_sum }
  }
}

pub fn frame() -> lists.List[String] | String {
  match(count()) {
    .(n: I32) { read_tokens(n, lists.nil[_]) };
    .(error: String) { error.>widen_sum }
  }
}
