mod pipeline/hkt_instances;

import hkt/testapi/main {
  type Box;
  type Extract;
  type Functor;
  type Identity;
  type Monad;
  type Pure
}

pub fn box_monad() -> Monad[Box] {
  Monad.mk(.[A][B](m, k) { k(Box.get(m)) })
}

pub fn box_functor() -> Functor[Box] {
  Functor.mk(.[A][B](step, value) { Box.mk(step(Box.get(value))) })
}

pub fn box_pure() -> Pure[Box] {
  Pure.mk(.[A](x) { Box.mk(x) })
}

pub fn box_extract() -> Extract[Box] {
  Extract.mk(.[A](m) { Box.get(m) })
}

pub fn identity_monad() -> Monad[Identity] {
  Monad.mk(.[A][B](m, k) { k(Identity.get(m)) })
}

pub fn identity_functor() -> Functor[Identity] {
  Functor.mk(.[A][B](step, value) { Identity.mk(step(Identity.get(value))) })
}

pub fn identity_pure() -> Pure[Identity] {
  Pure.mk(.[A](x) { Identity.mk(x) })
}

pub fn identity_extract() -> Extract[Identity] {
  Extract.mk(.[A](m) { Identity.get(m) })
}
