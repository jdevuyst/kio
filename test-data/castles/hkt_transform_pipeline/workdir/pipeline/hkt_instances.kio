module pipeline/hkt_instances;

import hkt/testapi/main(Box, Extract, Functor, Identity, Monad, Pure);

pub fn box_monad() -> Monad(Box) { Monad.mk_monad(.[A][B](m, k) { k(Box.un_box(m)) }) }

pub fn box_functor() -> Functor(Box) {
  Functor.mk_functor(.[A][B](step, value) { Box.mk_box(step(Box.un_box(value))) })
}

pub fn box_pure() -> Pure(Box) { Pure.mk_pure(.[A](x) { Box.mk_box(x) }) }

pub fn box_extract() -> Extract(Box) { Extract.mk_extract(.[A](m) { Box.un_box(m) }) }

pub fn identity_monad() -> Monad(Identity) {
  Monad.mk_monad(.[A][B](m, k) { k(Identity.un_id(m)) })
}

pub fn identity_functor() -> Functor(Identity) {
  Functor.mk_functor(.[A][B](step, value) { Identity.mk_id(step(Identity.un_id(value))) })
}

pub fn identity_pure() -> Pure(Identity) { Pure.mk_pure(.[A](x) { Identity.mk_id(x) }) }

pub fn identity_extract() -> Extract(Identity) { Extract.mk_extract(.[A](m) { Identity.un_id(m) }) }
