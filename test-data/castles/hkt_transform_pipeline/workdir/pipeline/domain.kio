mod pipeline/domain;

import testapi { type Bool; type I32; type String }

pub type Form_event = { Form_name: String; Field_name: String; Delta: I32; Urgent: Bool };

pub type Telemetry_sample = { Sample_name: String; Stage_score: I32; Route: String; Approved: Bool };

pub type Pipeline_summary = {
  Report_name: String;
  First_sample: String;
  Second_sample: String;
  Third_sample: String;
  Score_total: I32;
  Approvals: I32
};
