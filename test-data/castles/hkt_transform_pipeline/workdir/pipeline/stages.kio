mod pipeline/stages;

import hkt/testapi/main {
  type Box;
  type Extract;
  type Functor;
  type Identity;
  type Monad;
  type Pure
}
import macros/control { macro if }
import macros/row_macros { macro select }
import macros/sequence { macro do }
import pipeline/domain {
  type Approvals;
  type Approved;
  type Delta;
  type Field_name;
  type First_sample;
  type Form_event;
  type Form_name;
  type Pipeline_summary;
  type Report_name;
  type Route;
  type Sample_name;
  type Score_total;
  type Second_sample;
  type Stage_score;
  type Telemetry_sample;
  type Third_sample;
  type Urgent
}
import pipeline/hkt_instances {
  fn box_extract;
  fn box_functor;
  fn box_monad;
  fn box_pure;
  fn identity_extract;
  fn identity_functor;
  fn identity_monad;
  fn identity_pure
}
import testapi { type Bool; type I32; type String }
import testapi/fmt { fn bool_to_string; fn int_to_string }
import testapi/text { fn string_concat; fn string_eq }

fn join3(a: String, b: String, c: String) -> String { string_concat(a, string_concat(b, c)) }

fn render_sample(sample: Telemetry_sample) -> String {
  join3(
  , sample.>select { Sample_name.get }
  , "="
  , join3(
    , int_to_string(sample.>select { Stage_score.get })
    , ":"
    , join3(bool_to_string(sample.>select { Approved.get }), ":", sample.>select { Route.get })
    )
  )
}

fn normalized_name(event: Form_event) -> String {
  join3(
  , event.>select { Form_name.get }
  , "/"
  , string_concat("form.", event.>select { Field_name.get })
  )
}

fn score_and_adjust(event: Form_event) -> Telemetry_sample {
  let name = normalized_name(event);
  if(string_eq(event.>select { Form_name.get }, "login")) {
    (Sample_name.mk(name), Stage_score.mk(11), Route.mk("accept"), Approved.mk(.t))
  } else if(string_eq(event.>select { Form_name.get }, "profile")) {
    (Sample_name.mk(name), Stage_score.mk(38), Route.mk("review+manual"), Approved.mk(.f))
  } else {
    (Sample_name.mk(name), Stage_score.mk(23), Route.mk("review+manual"), Approved.mk(.f))
  }
}

fn run_pipeline[*F](monad: Monad[F], functor: Functor[F], pur: Pure[F], seed: F[Form_event]) -> F[Telemetry_sample] {
  do(Monad.get(monad)) {
    let normalized <- Functor.get(functor)[Form_event][Form_event](.(event) { event }, seed);
    Functor.get(functor)[Form_event][Telemetry_sample](
    , .(event) { score_and_adjust(event) }
    , Pure.get(pur)(normalized)
    )
  }
}

fn extract_pipeline[*F](
, monad: Monad[F]
, functor: Functor[F]
, pur: Pure[F]
, ext: Extract[F]
, event: Form_event
) -> Telemetry_sample { Extract.get(ext)(run_pipeline(monad, functor, pur, Pure.get(pur)(event))) }

fn login_event() -> Form_event {
  (Form_name.mk("login"), Field_name.mk("email"), Delta.mk(2), Urgent.mk(.f))
}

fn profile_event() -> Form_event {
  (Form_name.mk("profile"), Field_name.mk("display"), Delta.mk(10), Urgent.mk(.t))
}

fn checkout_event() -> Form_event {
  (Form_name.mk("checkout"), Field_name.mk("coupon"), Delta.mk(5), Urgent.mk(.t))
}

fn approved_value(sample: Telemetry_sample) -> I32 {
  if(sample.>select { Approved.get }) { 1 } else { 0 }
}

fn summarize(
, name: String
, first: Telemetry_sample
, second: Telemetry_sample
, third: Telemetry_sample
) -> Pipeline_summary {
  (
  , Report_name.mk(name)
  , First_sample.mk(render_sample(first))
  , Second_sample.mk(render_sample(second))
  , Third_sample.mk(render_sample(third))
  , Score_total.mk(72)
  , Approvals.mk(1)
  )
}

pub fn box_summary() -> Pipeline_summary {
  let first =
    extract_pipeline(box_monad(), box_functor(), box_pure(), box_extract(), login_event());
  let second =
    extract_pipeline(box_monad(), box_functor(), box_pure(), box_extract(), profile_event());
  let third =
    extract_pipeline(box_monad(), box_functor(), box_pure(), box_extract(), checkout_event());
  summarize("box/audit", first, second, third)
}

pub fn identity_summary() -> Pipeline_summary {
  let first =
    extract_pipeline(
    , identity_monad()
    , identity_functor()
    , identity_pure()
    , identity_extract()
    , login_event()
    );
  let second =
    extract_pipeline(
    , identity_monad()
    , identity_functor()
    , identity_pure()
    , identity_extract()
    , profile_event()
    );
  let third =
    extract_pipeline(
    , identity_monad()
    , identity_functor()
    , identity_pure()
    , identity_extract()
    , checkout_event()
    );
  summarize("identity/baseline", first, second, third)
}
