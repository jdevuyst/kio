module pipeline/report;

import macros/row_macros(macro select);
import pipeline/domain(
, Approvals
, First_sample
, Pipeline_summary
, Report_name
, Score_total
, Second_sample
, Third_sample
);
import testapi(String);
import testapi/fmt(int_to_string);
import testapi/text(string_concat);

fn append(left: String, right: String) -> String { string_concat(left, right) }

fn append3(a: String, b: String, c: String) -> String { append(a, append(b, c)) }

pub fn render_summary(summary: Pipeline_summary) -> String {
  append3(
  , summary.>select { Report_name.get }
  , ": "
  , append3(
    , summary.>select { First_sample.get }
    , " | "
    , append3(
      , summary.>select { Second_sample.get }
      , " | "
      , append3(
        , summary.>select { Third_sample.get }
        , " | total="
        , append3(
          , int_to_string(summary.>select { Score_total.get })
          , " | approvals="
          , int_to_string(summary.>select { Approvals.get })
          )
        )
      )
    )
  )
}
