/// Higher-kinded types worked example, NOT a drop-in library: it demonstrates
/// kinded brands, instance dictionaries, and do-block syntax together.
mod hkt/testapi/main;

import hkt/macros/derive { macro derive }
import hkt/macros/sequence { macro do }
import hkt/testapi { type String }
import hkt/testapi/io { fn print }
import hkt/testapi/text { fn string_concat }

// Higher-kinded types worked example — NOT a drop-in library.
//
// Demonstrates the kinded HKT surface against two arity-1 newtypes
// (`Box`, `Identity`) acting as brands; brand-generic operations
// (`rebrand`, `pipeline`) work against either. The full HKT
// vocabulary is exercised: kind-`*→*` binders `[*F]` applied as
// `F(A)`, concrete brand crossing through a nominal type's own `mk` /
// `get` members, abstract brand crossing threaded through instance
// dictionaries (`Pure.get`, `Extract.get`), a first-class
// polymorphic monad dictionary at a newtype field, and `do`-block
// syntax over a projected dictionary's `bind`.
//
// See `docs/guides/higher-kinded-types.md` for the
// matching guide.

// Brand-eligible newtype: identity wrapper around the type-
// parameter.
pub type { Box[A]: A { pub mk; pub get } }

// A second brand: also an identity wrapper at the value level,
// but nominally distinct from `Box` — brand identity lives at
// the type-system level, not in the carrier shape.
pub type { Identity[A]: A { pub mk; pub get } }

// A polymorphic monad dictionary. The payload is the canonical
// bind shape, parameterised over the carrier types `[A]` and
// `[B]`. Projecting the dictionary recovers a value whose
// polymorphism survives, so `Monad.get(monad)` is a valid
// `do`-block receiver against any brand `f` and any payload
// pair `(A, B)`.
pub type { Monad[*F]: [A][B] (F[A] & (A -> F[B])) -> F[B] { pub mk; pub get } }

pub type { Functor[*F]: [A][B] ((A -> B) & F[A]) -> F[B] { pub mk; pub get } }

// `Pure(F)` lifts a bare `A` into the brand `F(A)`; `Extract(F)`
// peels an `F(A)` back to `A`. A brand-generic body has no
// brand-crossing primitive over an opaque `F`, so it threads these
// instances and dispatches through their members. (The concrete
// brand sites below build the instances from `mk` / `get`.)
pub type { Pure[*F]: [A] A -> F[A] { pub mk; pub get } }

pub type { Extract[*F]: [A] F[A] -> A { pub mk; pub get } }

// Brand-generic operation: re-brand a value of `F(A)` by peeling
// then re-lifting, both through threaded instances. The body is
// `[*F]`-generic; the Rust backend picks up `Brand<H>` on the binder
// from the generic-header walk.
fn rebrand[*F][A](pur: Pure[F], ext: Extract[F], x: F[A]) -> F[A] {
  Pure.get(pur)(Extract.get(ext)(x))
}

// Per-brand instances. The `Monad` .-literals are polymorphic in
// `[A][B]` to match the dictionary's payload shape; the bodies peel
// via `get` and hand the unwrapped value to the continuation.
fn box_monad() -> Monad[Box] {
  Monad.mk(.[A][B](m, k) { k(Box.get(m)) })
}

fn box_functor() -> Functor[Box] {
  Functor.mk(.[A][B](step, value) { Box.mk(step(Box.get(value))) })
}

fn box_pure() -> Pure[Box] {
  Pure.mk(.[A](x) { Box.mk(x) })
}

fn box_extract() -> Extract[Box] {
  Extract.mk(.[A](m) { Box.get(m) })
}

fn identity_monad() -> Monad[Identity] {
  Monad.mk(.[A][B](m, k) { k(Identity.get(m)) })
}

fn identity_functor() -> Functor[Identity] {
  Functor.mk(.[A][B](step, value) { Identity.mk(step(Identity.get(value))) })
}

fn identity_pure() -> Pure[Identity] {
  Pure.mk(.[A](x) { Identity.mk(x) })
}

fn identity_extract() -> Extract[Identity] {
  Extract.mk(.[A](m) { Identity.get(m) })
}

// Brand-generic pipeline: takes a `Monad(F)` dictionary, a
// `Pure(F)` dictionary, and a branded seed; threads two `do`-block
// bind steps interleaved with a pure-let. The same source runs
// against any brand — callers pick `Box` or `Identity` at the call
// site. Abstract brand crossing lifts through `Pure.get(pur)`.
fn pipeline[*F](monad: Monad[F], pur: Pure[F], seed: F[String]) -> F[String] {
  do(Monad.get(monad)) {
    let prefix <- seed;
    let middle = " ok"[String];
    let trailed <- Pure.get(pur)(string_concat(prefix, middle));
    Pure.get(pur)(string_concat(trailed, "\n"[String]))
  }
}

fn run_box(s: String) -> String {
  let branded = Box.mk(s);
  let rebranded = rebrand(box_pure(), box_extract(), branded);
  Box.get(rebranded)
}

fn run_identity(s: String) -> String {
  let branded = Identity.mk(s);
  let rebranded = rebrand(identity_pure(), identity_extract(), branded);
  Identity.get(rebranded)
}

fn run_box_pipeline(s: String) -> String {
  let monad = box_monad();
  let seed = Box.mk(s);
  Box.get(pipeline(monad, box_pure(), seed))
}

fn run_identity_pipeline(s: String) -> String {
  let monad = identity_monad();
  let seed = Identity.mk(s);
  Identity.get(pipeline(monad, identity_pure(), seed))
}

fn derived_identity_functor() -> Functor[Identity] { derive[_]((box_functor, identity_functor)) }

fn run_derived_functor(s: String) -> String {
  let functor = derived_identity_functor();
  let branded = Identity.mk(s);
  let mapped =
    Functor.get(functor)[String][String](
    , .(value) { string_concat(value, " ok\n"[String]) }
    , branded
    );
  Identity.get(mapped)
}

pub fn main() {
  print(run_box("higher-kinded box ok\n"[String]));
  print(run_identity("higher-kinded identity ok\n"[String]));
  print(run_box_pipeline("brand-generic pipeline over box"[String]));
  print(run_identity_pipeline("brand-generic pipeline over identity"[String]));
  print(run_derived_functor("derived functor over identity"[String]))
}
