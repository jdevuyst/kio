/// The command language.
///
/// A command is a verb plus, for the four verbs that take one, an object. This
/// host surface has no string slicing, so `take lantern` cannot be split off a
/// single line: the object arrives on the *next* line, and the verb is what
/// decides whether one is read at all. Parsing therefore happens in two steps —
/// classify the verb, then pull an object only if that verb wants one — which
/// is also why a mistyped verb never swallows the command after it.
module cellar/command;

import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import macros/spine_macros(macro widen_sum);
import testapi(Bool, String);
import testapi/text(string_eq);

pub type Verb =
  | { Go_verb: . }
  | { Take_verb: . }
  | { Drop_verb: . }
  | { Unlock_verb: . }
  | { Look_verb: . }
  | { Bag_verb: . }
  | { Quit_verb: . }
  | { Bad_verb: String }
  ;

pub type Command =
  | { Go_cmd: String }
  | { Take_cmd: String }
  | { Drop_cmd: String }
  | { Unlock_cmd: String }
  | { Look_cmd: . }
  | { Bag_cmd: . }
  | { Quit_cmd: . }
  | { Unknown_cmd: String }
  ;

pub fn verb_of(word: String) -> Verb {
  if(string_eq(word, "go")) {
    (Go_verb.mk(()).>widen_sum)[Verb]
  } else if(string_eq(word, "take")) {
    (Take_verb.mk(()).>widen_sum)[Verb]
  } else if(string_eq(word, "drop")) {
    (Drop_verb.mk(()).>widen_sum)[Verb]
  } else if(string_eq(word, "unlock")) {
    (Unlock_verb.mk(()).>widen_sum)[Verb]
  } else if(string_eq(word, "look")) {
    (Look_verb.mk(()).>widen_sum)[Verb]
  } else if(string_eq(word, "inventory")) {
    (Bag_verb.mk(()).>widen_sum)[Verb]
  } else if(string_eq(word, "quit")) {
    (Quit_verb.mk(()).>widen_sum)[Verb]
  } else {
    (Bad_verb.mk(word).>widen_sum)[Verb]
  }
}

pub fn verb_takes_object(v: Verb) -> Bool {
  match(v) {
    (
    , .(_g: Go_verb) { .t }
    , .(_t: Take_verb) { .t }
    , .(_d: Drop_verb) { .t }
    , .(_u: Unlock_verb) { .t }
    , .(_l: Look_verb) { .f }
    , .(_b: Bag_verb) { .f }
    , .(_q: Quit_verb) { .f }
    , .(_x: Bad_verb) { .f }
    )
  }
}

pub fn command_of(v: Verb, object: String) -> Command {
  match(v) {
    (
    , .(_g: Go_verb) { widen_sum(Go_cmd.mk(object))[Command] }
    , .(_t: Take_verb) { widen_sum(Take_cmd.mk(object))[Command] }
    , .(_d: Drop_verb) { widen_sum(Drop_cmd.mk(object))[Command] }
    , .(_u: Unlock_verb) { widen_sum(Unlock_cmd.mk(object))[Command] }
    , .(_l: Look_verb) { widen_sum(Look_cmd.mk(()))[Command] }
    , .(_b: Bag_verb) { widen_sum(Bag_cmd.mk(()))[Command] }
    , .(_q: Quit_verb) { widen_sum(Quit_cmd.mk(()))[Command] }
    , .(x: Bad_verb) {
        widen_sum(Unknown_cmd.mk(x.>select { Bad_verb.get }))[Command]
      }
    )
  }
}
