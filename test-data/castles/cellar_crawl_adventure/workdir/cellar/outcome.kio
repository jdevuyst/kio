/// What a turn did.
///
/// Every refusal the cellar can produce is an arm of this sum, so a command the
/// world will not honour is a *value* the engine returns, not a failure it
/// raises. Nothing here renders itself: `cellar/report` is the only module that
/// turns an outcome into English, and `cellar/engine` is the only one that
/// mints it.
mod cellar/outcome;

import cellar/ids as ids;
import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type String }

pub type Outcome =
  | { Saw_room: . }
  | { Too_dark_to_see: . }
  | { Dark_ahead: . }
  | { Way_locked: ids.Item_id }
  | { No_exit: . }
  | { Not_a_direction: String }
  | { Took: ids.Item_id }
  | { Already_held: ids.Item_id }
  | { Nothing_named: String }
  | { Dropped: ids.Item_id }
  | { Not_held: String }
  | { Lock_opened: . }
  | { Nothing_to_unlock: . }
  | { Lock_needs: ids.Item_id }
  | { Held_items: . }
  | { Unknown_verb: String }
  | { Left_cellar: . }
  ;

pub fn saw_room() -> Outcome { (Saw_room.mk(()).>widen_sum)[Outcome] }

pub fn too_dark_to_see() -> Outcome { (Too_dark_to_see.mk(()).>widen_sum)[Outcome] }

pub fn dark_ahead() -> Outcome { (Dark_ahead.mk(()).>widen_sum)[Outcome] }

pub fn way_locked(key: ids.Item_id) -> Outcome { (Way_locked.mk(key).>widen_sum)[Outcome] }

pub fn no_exit() -> Outcome { (No_exit.mk(()).>widen_sum)[Outcome] }

pub fn not_a_direction(word: String) -> Outcome { (Not_a_direction.mk(word).>widen_sum)[Outcome] }

pub fn took(i: ids.Item_id) -> Outcome { (Took.mk(i).>widen_sum)[Outcome] }

pub fn already_held(i: ids.Item_id) -> Outcome { (Already_held.mk(i).>widen_sum)[Outcome] }

pub fn nothing_named(word: String) -> Outcome { (Nothing_named.mk(word).>widen_sum)[Outcome] }

pub fn dropped(i: ids.Item_id) -> Outcome { (Dropped.mk(i).>widen_sum)[Outcome] }

pub fn not_held(word: String) -> Outcome { (Not_held.mk(word).>widen_sum)[Outcome] }

pub fn lock_opened() -> Outcome { (Lock_opened.mk(()).>widen_sum)[Outcome] }

pub fn nothing_to_unlock() -> Outcome { (Nothing_to_unlock.mk(()).>widen_sum)[Outcome] }

pub fn lock_needs(key: ids.Item_id) -> Outcome { (Lock_needs.mk(key).>widen_sum)[Outcome] }

pub fn held_items() -> Outcome { (Held_items.mk(()).>widen_sum)[Outcome] }

pub fn unknown_verb(word: String) -> Outcome { (Unknown_verb.mk(word).>widen_sum)[Outcome] }

pub fn left_cellar() -> Outcome { (Left_cellar.mk(()).>widen_sum)[Outcome] }

/// A fumble is a turn that got the player nothing they asked for. The score
/// docks a point for each, so every outcome arm is classified explicitly.
pub fn is_fumble(o: Outcome) -> Bool {
  match(o) {
    (
    , .(_a: Saw_room) { .f }
    , .(_b: Too_dark_to_see) { .t }
    , .(_c: Dark_ahead) { .t }
    , .(_d: Way_locked) { .t }
    , .(_e: No_exit) { .t }
    , .(_f: Not_a_direction) { .t }
    , .(_g: Took) { .f }
    , .(_h: Already_held) { .t }
    , .(_i: Nothing_named) { .t }
    , .(_j: Dropped) { .f }
    , .(_k: Not_held) { .t }
    , .(_l: Lock_opened) { .f }
    , .(_m: Nothing_to_unlock) { .t }
    , .(_n: Lock_needs) { .t }
    , .(_o: Held_items) { .f }
    , .(_p: Unknown_verb) { .t }
    , .(_q: Left_cellar) { .f }
    )
  }
}
