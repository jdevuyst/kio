/// The game state: where the player stands, where every item sits, which doors
/// have been opened, and the running counters.
///
/// Items follow the classic world-model shape — an item is always *somewhere*,
/// either lying in a room or held by the player — so the inventory is derived
/// from item locations rather than stored a second time and kept in step.
mod cellar/state;

import cellar/ids as ids;
import cellar/world as world;
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn add; fn mul; fn sub }

pub type Loc = { In_room: ids.Room_id } | { Held: . };

fn at_room(r: ids.Room_id) -> Loc { (In_room.mk(r).>widen_sum)[Loc] }

fn carried() -> Loc { (Held.mk(()).>widen_sum)[Loc] }

pub type Game = {
  Room: ids.Room_id;
  Lantern_at: Loc;
  Key_at: Loc;
  Cork_at: Loc;
  Bottle_at: Loc;
  Hatch_open: Bool;
  Vault_open: Bool;
  Turns: I32;
  Moves: I32;
  Fumbles: I32;
  Over: Bool
};

pub fn new_game() -> Game {
  (
  , Room.mk(world.start_room())
  , Lantern_at.mk(at_room(world.item_origin(ids.lantern())))
  , Key_at.mk(at_room(world.item_origin(ids.brass_key())))
  , Cork_at.mk(at_room(world.item_origin(ids.cork())))
  , Bottle_at.mk(at_room(world.item_origin(ids.bottle())))
  , Hatch_open.mk(.f)
  , Vault_open.mk(.f)
  , Turns.mk(0)
  , Moves.mk(0)
  , Fumbles.mk(0)
  , Over.mk(.f)
  )
}

pub fn room_of(g: Game) -> ids.Room_id {
  g.>select { Room.get }
}

pub fn turns_of(g: Game) -> I32 {
  g.>select { Turns.get }
}

pub fn moves_of(g: Game) -> I32 {
  g.>select { Moves.get }
}

pub fn fumbles_of(g: Game) -> I32 {
  g.>select { Fumbles.get }
}

pub fn is_over(g: Game) -> Bool {
  g.>select { Over.get }
}

fn item_loc(g: Game, i: ids.Item_id) -> Loc {
  if(ids.item_eq(i, ids.lantern())) {
    g.>select { Lantern_at.get }
  } else if(ids.item_eq(i, ids.brass_key())) {
    g.>select { Key_at.get }
  } else if(ids.item_eq(i, ids.cork())) {
    g.>select { Cork_at.get }
  } else {
    g.>select { Bottle_at.get }
  }
}

fn put(g: Game, i: ids.Item_id, l: Loc) -> Game {
  if(ids.item_eq(i, ids.lantern())) {
    (
    , Room.mk(g.>select { Room.get })
    , Lantern_at.mk(l)
    , Key_at.mk(g.>select { Key_at.get })
    , Cork_at.mk(g.>select { Cork_at.get })
    , Bottle_at.mk(g.>select { Bottle_at.get })
    , Hatch_open.mk(g.>select { Hatch_open.get })
    , Vault_open.mk(g.>select { Vault_open.get })
    , Turns.mk(g.>select { Turns.get })
    , Moves.mk(g.>select { Moves.get })
    , Fumbles.mk(g.>select { Fumbles.get })
    , Over.mk(g.>select { Over.get })
    )
  } else if(ids.item_eq(i, ids.brass_key())) {
    (
    , Room.mk(g.>select { Room.get })
    , Lantern_at.mk(g.>select { Lantern_at.get })
    , Key_at.mk(l)
    , Cork_at.mk(g.>select { Cork_at.get })
    , Bottle_at.mk(g.>select { Bottle_at.get })
    , Hatch_open.mk(g.>select { Hatch_open.get })
    , Vault_open.mk(g.>select { Vault_open.get })
    , Turns.mk(g.>select { Turns.get })
    , Moves.mk(g.>select { Moves.get })
    , Fumbles.mk(g.>select { Fumbles.get })
    , Over.mk(g.>select { Over.get })
    )
  } else if(ids.item_eq(i, ids.cork())) {
    (
    , Room.mk(g.>select { Room.get })
    , Lantern_at.mk(g.>select { Lantern_at.get })
    , Key_at.mk(g.>select { Key_at.get })
    , Cork_at.mk(l)
    , Bottle_at.mk(g.>select { Bottle_at.get })
    , Hatch_open.mk(g.>select { Hatch_open.get })
    , Vault_open.mk(g.>select { Vault_open.get })
    , Turns.mk(g.>select { Turns.get })
    , Moves.mk(g.>select { Moves.get })
    , Fumbles.mk(g.>select { Fumbles.get })
    , Over.mk(g.>select { Over.get })
    )
  } else {
    (
    , Room.mk(g.>select { Room.get })
    , Lantern_at.mk(g.>select { Lantern_at.get })
    , Key_at.mk(g.>select { Key_at.get })
    , Cork_at.mk(g.>select { Cork_at.get })
    , Bottle_at.mk(l)
    , Hatch_open.mk(g.>select { Hatch_open.get })
    , Vault_open.mk(g.>select { Vault_open.get })
    , Turns.mk(g.>select { Turns.get })
    , Moves.mk(g.>select { Moves.get })
    , Fumbles.mk(g.>select { Fumbles.get })
    , Over.mk(g.>select { Over.get })
    )
  }
}

pub fn hold(g: Game, i: ids.Item_id) -> Game { put(g, i, carried()) }

pub fn leave_here(g: Game, i: ids.Item_id) -> Game { put(g, i, at_room(room_of(g))) }

pub fn carrying(g: Game, i: ids.Item_id) -> Bool {
  match(item_loc(g, i)) {
    (.(_r: In_room) { .f }, .(_h: Held) { .t })
  }
}

pub fn item_lies_in(g: Game, i: ids.Item_id, r: ids.Room_id) -> Bool {
  match(item_loc(g, i)) {
    (
    , .(x: In_room) {
        ids.room_eq(x.>select { In_room.get }, r)
      }
    , .(_h: Held) { .f }
    )
  }
}

pub fn door_open(g: Game, from: ids.Room_id, d: ids.Dir_id) -> Bool {
  if(world.is_hatch(from, d)) {
    g.>select { Hatch_open.get }
  } else if(world.is_vault_door(from, d)) {
    g.>select { Vault_open.get }
  } else {
    .f
  }
}

pub fn open_door(g: Game, from: ids.Room_id, d: ids.Dir_id) -> Game {
  if(world.is_hatch(from, d)) {
    (
    , Room.mk(g.>select { Room.get })
    , Lantern_at.mk(g.>select { Lantern_at.get })
    , Key_at.mk(g.>select { Key_at.get })
    , Cork_at.mk(g.>select { Cork_at.get })
    , Bottle_at.mk(g.>select { Bottle_at.get })
    , Hatch_open.mk(.t)
    , Vault_open.mk(g.>select { Vault_open.get })
    , Turns.mk(g.>select { Turns.get })
    , Moves.mk(g.>select { Moves.get })
    , Fumbles.mk(g.>select { Fumbles.get })
    , Over.mk(g.>select { Over.get })
    )
  } else if(world.is_vault_door(from, d)) {
    (
    , Room.mk(g.>select { Room.get })
    , Lantern_at.mk(g.>select { Lantern_at.get })
    , Key_at.mk(g.>select { Key_at.get })
    , Cork_at.mk(g.>select { Cork_at.get })
    , Bottle_at.mk(g.>select { Bottle_at.get })
    , Hatch_open.mk(g.>select { Hatch_open.get })
    , Vault_open.mk(.t)
    , Turns.mk(g.>select { Turns.get })
    , Moves.mk(g.>select { Moves.get })
    , Fumbles.mk(g.>select { Fumbles.get })
    , Over.mk(g.>select { Over.get })
    )
  } else {
    g
  }
}

pub fn tick(g: Game) -> Game {
  (
  , Room.mk(g.>select { Room.get })
  , Lantern_at.mk(g.>select { Lantern_at.get })
  , Key_at.mk(g.>select { Key_at.get })
  , Cork_at.mk(g.>select { Cork_at.get })
  , Bottle_at.mk(g.>select { Bottle_at.get })
  , Hatch_open.mk(g.>select { Hatch_open.get })
  , Vault_open.mk(g.>select { Vault_open.get })
  , Turns.mk(add(g.>select { Turns.get }, 1))
  , Moves.mk(g.>select { Moves.get })
  , Fumbles.mk(g.>select { Fumbles.get })
  , Over.mk(g.>select { Over.get })
  )
}

pub fn fumble(g: Game) -> Game {
  (
  , Room.mk(g.>select { Room.get })
  , Lantern_at.mk(g.>select { Lantern_at.get })
  , Key_at.mk(g.>select { Key_at.get })
  , Cork_at.mk(g.>select { Cork_at.get })
  , Bottle_at.mk(g.>select { Bottle_at.get })
  , Hatch_open.mk(g.>select { Hatch_open.get })
  , Vault_open.mk(g.>select { Vault_open.get })
  , Turns.mk(g.>select { Turns.get })
  , Moves.mk(g.>select { Moves.get })
  , Fumbles.mk(add(g.>select { Fumbles.get }, 1))
  , Over.mk(g.>select { Over.get })
  )
}

pub fn walk_to(g: Game, r: ids.Room_id) -> Game {
  (
  , Room.mk(r)
  , Lantern_at.mk(g.>select { Lantern_at.get })
  , Key_at.mk(g.>select { Key_at.get })
  , Cork_at.mk(g.>select { Cork_at.get })
  , Bottle_at.mk(g.>select { Bottle_at.get })
  , Hatch_open.mk(g.>select { Hatch_open.get })
  , Vault_open.mk(g.>select { Vault_open.get })
  , Turns.mk(g.>select { Turns.get })
  , Moves.mk(add(g.>select { Moves.get }, 1))
  , Fumbles.mk(g.>select { Fumbles.get })
  , Over.mk(g.>select { Over.get })
  )
}

pub fn finish(g: Game) -> Game {
  (
  , Room.mk(g.>select { Room.get })
  , Lantern_at.mk(g.>select { Lantern_at.get })
  , Key_at.mk(g.>select { Key_at.get })
  , Cork_at.mk(g.>select { Cork_at.get })
  , Bottle_at.mk(g.>select { Bottle_at.get })
  , Hatch_open.mk(g.>select { Hatch_open.get })
  , Vault_open.mk(g.>select { Vault_open.get })
  , Turns.mk(g.>select { Turns.get })
  , Moves.mk(g.>select { Moves.get })
  , Fumbles.mk(g.>select { Fumbles.get })
  , Over.mk(.t)
  )
}

fn one_if(b: Bool) -> I32 {
  if(b) { 1 } else { 0 }
}

pub fn doors_opened(g: Game) -> I32 {
  add(one_if(g.>select { Hatch_open.get }), one_if(g.>select { Vault_open.get }))
}

/// The lantern and the key are tools; only wine scores.
fn value_of(i: ids.Item_id) -> I32 {
  if(ids.item_eq(i, ids.cork())) { 5 } else if(ids.item_eq(i, ids.bottle())) { 50 } else { 0 }
}

fn carried_value(g: Game, i: ids.Item_id) -> I32 {
  if(carrying(g, i)) { value_of(i) } else { 0 }
}

/// What the player is walking out with.
pub fn haul(g: Game) -> I32 {
  add(
  , add(carried_value(g, ids.lantern()), carried_value(g, ids.brass_key()))
  , add(carried_value(g, ids.cork()), carried_value(g, ids.bottle()))
  )
}

pub fn door_credit(g: Game) -> I32 { mul(doors_opened(g), 10) }

/// Ten a door, plus the value of the haul, less one for every fumbled turn.
pub fn score(g: Game) -> I32 { sub(add(door_credit(g), haul(g)), fumbles_of(g)) }

pub fn won(g: Game) -> Bool { carrying(g, ids.bottle()) }
