/// The one collection this package is built on. The host tier supplies no
/// array type, so the training corpus, the chain's successor tallies, the
/// generated lines, and the draw trace are all instantiations of this cons
/// list.
module ballad/list;

import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(I32);
import testapi/arith(add_i32);
import testapi/iter(loop);

/// An anonymous sum cannot mention itself, so the newtype ties the knot.
pub rec newtype List[A] : . | (A & List(A)) { pub constructor mk_list; pub projector un_list }

pub fn nil[A]() -> List(A) { List.mk_list(widen_sum!((), . | (A & List(A)))) }

pub fn cons[A](head: A, tail: List(A)) -> List(A) {
  List.mk_list(widen_sum!((head, tail), . | (A & List(A))))
}

pub fn of1[A](a: A) -> List(A) { cons(a, nil(A, ())) }

/// Push every element of `xs` onto `acc` in order, which leaves `acc`
/// holding them reversed. Every builder below accumulates backwards and
/// reverses once at the end, so growing a list stays a constant-time cons
/// rather than a quadratic append.
pub rec(loop) fn rev_onto[A](xs: List(A), acc: List(A)) -> List(A) {
  match! xs.>List.un_list {
    (.(head: A, rest: List(A)) { rec rev_onto(rest, cons(head, acc)) }, .(_empty: .) { acc })
  }
}

pub fn reverse[A](xs: List(A)) -> List(A) { rev_onto(xs, nil(A, ())) }

rec(loop) fn len_onto[A](xs: List(A), acc: I32) -> I32 {
  match! xs.>List.un_list {
    (.(_head: A, rest: List(A)) { rec len_onto(rest, add_i32(acc, 1)) }, .(_empty: .) { acc })
  }
}

pub fn len[A](xs: List(A)) -> I32 { len_onto(xs, 0) }
