module document/tree;

import elab/match(match);
import list/core as lists;
import list/list as traversal;
import testapi(I32, String);
import testapi/arith as arith;
import testapi/io as io;
import testapi/iter(loop);
import testapi/text as text;

pub rec newtype Node : String & lists.List(Node) { constructor make; projector open }

pub fn branch(name: String, children: lists.List(Node)) -> Node { Node.make((name, children)) }

pub fn leaf(name: String) -> Node { branch(name, lists.nil()) }

pub fn name(node: Node) -> String { let .(title, _children) = Node.open(node); title }

pub fn children(node: Node) -> lists.List(Node) {
  let .(_title, descendants) = Node.open(node);
  descendants
}

pub fn rename(node: Node, title: String) -> Node { branch(title, children(node)) }

pub fn append(node: Node, child: Node) -> Node {
  branch(name(node), traversal.append(children(node), lists.singleton(child)))
}

type Visit = Node & String;

rec(loop) fn render_pending(pending: lists.List(Visit)) -> . {
  match! lists.uncons(pending) {
    .(visit: Visit, rest: lists.List(Visit)) {
      let .(node, indent) = visit;
      io.print(text.string_concat(indent, text.string_concat(name(node), "\n")));
      let next_indent = text.string_concat(indent, "  ");
      let next = traversal.map(.(child: Node) { (child, next_indent) }, children(node));
      rec render_pending(traversal.append(next, rest))
    };
    .() { () }
  }
}

pub fn render(node: Node) -> . { render_pending(lists.singleton((node, "  "))) }

rec(loop) fn count_pending(pending: lists.List(Node), count: I32) -> I32 {
  match! lists.uncons(pending) {
    .(node: Node, rest: lists.List(Node)) {
      rec count_pending(traversal.append(children(node), rest), arith.add_i32(count, 1))
    };
    .() { count }
  }
}

pub fn count(node: Node) -> I32 { count_pending(lists.singleton(node), 0) }
