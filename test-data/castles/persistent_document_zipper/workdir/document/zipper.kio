module document/zipper;

import document/tree as tree;
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import list/core as lists;
import list/list as traversal;
import testapi(String);
import testapi/iter(loop);
import testapi/text as text;

newtype Crumb : String & lists.List(tree.Node) & lists.List(tree.Node) {
  constructor make;
  projector open
  }

pub newtype Cursor : tree.Node & lists.List(Crumb) { constructor make; projector open }

pub fn start(root: tree.Node) -> Cursor { Cursor.make((root, lists.nil())) }

pub fn focus(cursor: Cursor) -> tree.Node { let .(node, _crumbs) = Cursor.open(cursor); node }

fn rebuild(node: tree.Node, crumb: Crumb) -> tree.Node {
  let .(title, left_rev, right) = Crumb.open(crumb);
  tree.branch(title, traversal.append(traversal.reverse(left_rev), lists.cons(node, right)))
}

pub fn parent(cursor: Cursor) -> Cursor | String {
  let .(node, crumbs) = Cursor.open(cursor);
  match! lists.uncons(crumbs) {
    .(crumb: Crumb, rest: lists.List(Crumb)) {
      Cursor.make((rebuild(node, crumb), rest)).>widen_sum!
    };
    .() { "root has no parent".>widen_sum! }
  }
}

pub rec(loop) fn root(cursor: Cursor) -> Cursor {
  let .(node, crumbs) = Cursor.open(cursor);
  match! lists.uncons(crumbs) {
    .(crumb: Crumb, rest: lists.List(Crumb)) { rec root(Cursor.make((rebuild(node, crumb), rest))) };
    .() { cursor }
  }
}

pub fn child(cursor: Cursor) -> Cursor | String {
  let .(node, crumbs) = Cursor.open(cursor);
  match! lists.uncons(tree.children(node)) {
    .(first: tree.Node, rest: lists.List(tree.Node)) {
      let crumb = Crumb.make((tree.name(node), lists.nil(), rest));
      Cursor.make((first, lists.cons(crumb, crumbs))).>widen_sum!
    };
    .() { "focus has no children".>widen_sum! }
  }
}

pub fn next(cursor: Cursor) -> Cursor | String {
  let .(node, crumbs) = Cursor.open(cursor);
  match! lists.uncons(crumbs) {
    .(crumb: Crumb, rest: lists.List(Crumb)) {
      let .(title, left_rev, right) = Crumb.open(crumb);
      match! lists.uncons(right) {
        .(sibling: tree.Node, tail: lists.List(tree.Node)) {
          let context = Crumb.make((title, lists.cons(node, left_rev), tail));
          Cursor.make((sibling, lists.cons(context, rest))).>widen_sum!
        };
        .() { "no next sibling".>widen_sum! }
      }
    };
    .() { "root has no siblings".>widen_sum! }
  }
}

pub fn previous(cursor: Cursor) -> Cursor | String {
  let .(node, crumbs) = Cursor.open(cursor);
  match! lists.uncons(crumbs) {
    .(crumb: Crumb, rest: lists.List(Crumb)) {
      let .(title, left_rev, right) = Crumb.open(crumb);
      match! lists.uncons(left_rev) {
        .(sibling: tree.Node, tail: lists.List(tree.Node)) {
          let context = Crumb.make((title, tail, lists.cons(node, right)));
          Cursor.make((sibling, lists.cons(context, rest))).>widen_sum!
        };
        .() { "no previous sibling".>widen_sum! }
      }
    };
    .() { "root has no siblings".>widen_sum! }
  }
}

pub fn rename(cursor: Cursor, title: String) -> Cursor {
  let .(node, crumbs) = Cursor.open(cursor);
  Cursor.make((tree.rename(node, title), crumbs))
}

pub fn append_child(cursor: Cursor, title: String) -> Cursor {
  let .(node, crumbs) = Cursor.open(cursor);
  Cursor.make((tree.append(node, tree.leaf(title)), crumbs))
}

pub fn insert_before(cursor: Cursor, title: String) -> Cursor | String {
  let .(node, crumbs) = Cursor.open(cursor);
  match! lists.uncons(crumbs) {
    .(crumb: Crumb, rest: lists.List(Crumb)) {
      let .(parent_title, left_rev, right) = Crumb.open(crumb);
      let context = Crumb.make((parent_title, lists.cons(tree.leaf(title), left_rev), right));
      Cursor.make((node, lists.cons(context, rest))).>widen_sum!
    };
    .() { "cannot insert a sibling of the root".>widen_sum! }
  }
}

pub fn insert_after(cursor: Cursor, title: String) -> Cursor | String {
  let .(node, crumbs) = Cursor.open(cursor);
  match! lists.uncons(crumbs) {
    .(crumb: Crumb, rest: lists.List(Crumb)) {
      let .(parent_title, left_rev, right) = Crumb.open(crumb);
      let context = Crumb.make((parent_title, left_rev, lists.cons(tree.leaf(title), right)));
      Cursor.make((node, lists.cons(context, rest))).>widen_sum!
    };
    .() { "cannot insert a sibling of the root".>widen_sum! }
  }
}

pub fn delete(cursor: Cursor) -> Cursor | String {
  let .(_node, crumbs) = Cursor.open(cursor);
  match! lists.uncons(crumbs) {
    .(crumb: Crumb, rest: lists.List(Crumb)) {
      let .(title, left_rev, right) = Crumb.open(crumb);
      let surviving = traversal.append(traversal.reverse(left_rev), right);
      Cursor.make((tree.branch(title, surviving), rest)).>widen_sum!
    };
    .() { "cannot delete the root".>widen_sum! }
  }
}

rec(loop) fn path_ancestors(crumbs: lists.List(Crumb), suffix: String) -> String {
  match! lists.uncons(crumbs) {
    .(crumb: Crumb, rest: lists.List(Crumb)) {
      let .(title, _left, _right) = Crumb.open(crumb);
      rec path_ancestors(rest, text.string_concat("/", text.string_concat(title, suffix)))
    };
    .() { suffix }
  }
}

pub fn path(cursor: Cursor) -> String {
  let .(node, crumbs) = Cursor.open(cursor);
  path_ancestors(crumbs, text.string_concat("/", tree.name(node)))
}
