mod document/zipper;

import document/tree as tree;
import list/core as lists;
import list/list as traversal;
import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type String }
import testapi/iter { fn loop }
import testapi/text as text;

type { Crumb: String & lists.List[tree.Node] & lists.List[tree.Node] { mk; get } }

pub type { Cursor: tree.Node & lists.List[Crumb] { mk; get } }

pub fn start(root: tree.Node) -> Cursor { Cursor.mk((root, lists.nil[_])) }

pub fn focus(cursor: Cursor) -> tree.Node { let .(node, _crumbs) = Cursor.get(cursor); node }

fn rebuild(node: tree.Node, crumb: Crumb) -> tree.Node {
  let .(title, left_rev, right) = Crumb.get(crumb);
  tree.branch(title, traversal.append(traversal.reverse(left_rev), lists.cons(node, right)))
}

pub fn parent(cursor: Cursor) -> Cursor | String {
  let .(node, crumbs) = Cursor.get(cursor);
  match(lists.uncons(crumbs)) {
    .(crumb: Crumb, rest: lists.List[Crumb]) { Cursor.mk((rebuild(node, crumb), rest)).>widen_sum };
    .() { "root has no parent"[String].>widen_sum }
  }
}

pub rec(loop) fn root(cursor: Cursor) -> Cursor {
  let .(node, crumbs) = Cursor.get(cursor);
  match(lists.uncons(crumbs)) {
    .(crumb: Crumb, rest: lists.List[Crumb]) { recur root(Cursor.mk((rebuild(node, crumb), rest))) };
    .() { cursor }
  }
}

pub fn child(cursor: Cursor) -> Cursor | String {
  let .(node, crumbs) = Cursor.get(cursor);
  match(lists.uncons(tree.children(node))) {
    .(first: tree.Node, rest: lists.List[tree.Node]) {
      let crumb = Crumb.mk((tree.name(node), lists.nil[_], rest));
      Cursor.mk((first, lists.cons(crumb, crumbs))).>widen_sum
    };
    .() { "focus has no children"[String].>widen_sum }
  }
}

pub fn next(cursor: Cursor) -> Cursor | String {
  let .(node, crumbs) = Cursor.get(cursor);
  match(lists.uncons(crumbs)) {
    .(crumb: Crumb, rest: lists.List[Crumb]) {
      let .(title, left_rev, right) = Crumb.get(crumb);
      match(lists.uncons(right)) {
        .(sibling: tree.Node, tail: lists.List[tree.Node]) {
          let context = Crumb.mk((title, lists.cons(node, left_rev), tail));
          Cursor.mk((sibling, lists.cons(context, rest))).>widen_sum
        };
        .() { "no next sibling"[String].>widen_sum }
      }
    };
    .() { "root has no siblings"[String].>widen_sum }
  }
}

pub fn previous(cursor: Cursor) -> Cursor | String {
  let .(node, crumbs) = Cursor.get(cursor);
  match(lists.uncons(crumbs)) {
    .(crumb: Crumb, rest: lists.List[Crumb]) {
      let .(title, left_rev, right) = Crumb.get(crumb);
      match(lists.uncons(left_rev)) {
        .(sibling: tree.Node, tail: lists.List[tree.Node]) {
          let context = Crumb.mk((title, tail, lists.cons(node, right)));
          Cursor.mk((sibling, lists.cons(context, rest))).>widen_sum
        };
        .() { "no previous sibling"[String].>widen_sum }
      }
    };
    .() { "root has no siblings"[String].>widen_sum }
  }
}

pub fn rename(cursor: Cursor, title: String) -> Cursor {
  let .(node, crumbs) = Cursor.get(cursor);
  Cursor.mk((tree.rename(node, title), crumbs))
}

pub fn append_child(cursor: Cursor, title: String) -> Cursor {
  let .(node, crumbs) = Cursor.get(cursor);
  Cursor.mk((tree.append(node, tree.leaf(title)), crumbs))
}

pub fn insert_before(cursor: Cursor, title: String) -> Cursor | String {
  let .(node, crumbs) = Cursor.get(cursor);
  match(lists.uncons(crumbs)) {
    .(crumb: Crumb, rest: lists.List[Crumb]) {
      let .(parent_title, left_rev, right) = Crumb.get(crumb);
      let context = Crumb.mk((parent_title, lists.cons(tree.leaf(title), left_rev), right));
      Cursor.mk((node, lists.cons(context, rest))).>widen_sum
    };
    .() { "cannot insert a sibling of the root"[String].>widen_sum }
  }
}

pub fn insert_after(cursor: Cursor, title: String) -> Cursor | String {
  let .(node, crumbs) = Cursor.get(cursor);
  match(lists.uncons(crumbs)) {
    .(crumb: Crumb, rest: lists.List[Crumb]) {
      let .(parent_title, left_rev, right) = Crumb.get(crumb);
      let context = Crumb.mk((parent_title, left_rev, lists.cons(tree.leaf(title), right)));
      Cursor.mk((node, lists.cons(context, rest))).>widen_sum
    };
    .() { "cannot insert a sibling of the root"[String].>widen_sum }
  }
}

pub fn delete(cursor: Cursor) -> Cursor | String {
  let .(_node, crumbs) = Cursor.get(cursor);
  match(lists.uncons(crumbs)) {
    .(crumb: Crumb, rest: lists.List[Crumb]) {
      let .(title, left_rev, right) = Crumb.get(crumb);
      let surviving = traversal.append(traversal.reverse(left_rev), right);
      Cursor.mk((tree.branch(title, surviving), rest)).>widen_sum
    };
    .() { "cannot delete the root"[String].>widen_sum }
  }
}

rec(loop) fn path_ancestors(crumbs: lists.List[Crumb], suffix: String) -> String {
  match(lists.uncons(crumbs)) {
    .(crumb: Crumb, rest: lists.List[Crumb]) {
      let .(title, _left, _right) = Crumb.get(crumb);
      recur path_ancestors(rest, text.string_concat("/", text.string_concat(title, suffix)))
    };
    .() { suffix }
  }
}

pub fn path(cursor: Cursor) -> String {
  let .(node, crumbs) = Cursor.get(cursor);
  path_ancestors(crumbs, text.string_concat("/", tree.name(node)))
}
