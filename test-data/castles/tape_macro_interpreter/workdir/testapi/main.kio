mod testapi/main;

import macros/control { macro if }
import macros/row_macros { macro select }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn add_i32; fn eq_i32; fn leq_i32; fn lt_i32; fn mul_i32; fn sub_i32 }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }
import testapi/iter { fn loop }
import testapi/text { fn string_concat }

type State = {
  Pc: I32;
  Pointer: I32;
  Left_cell: I32;
  Center_cell: I32;
  Right_cell: I32;
  Macro_stage: I32;
  Checkpoints: I32;
  Checksum: I32;
  Ticks: I32
};

fn cat(a: String, b: String) -> String { string_concat(a, b) }

fn cat3(a: String, b: String, c: String) -> String { cat(a, cat(b, c)) }

fn cat4(a: String, b: String, c: String, d: String) -> String { cat(a, cat3(b, c, d)) }

fn cat5(a: String, b: String, c: String, d: String, e: String) -> String {
  cat(a, cat4(b, c, d, e))
}

fn cat6(a: String, b: String, c: String, d: String, e: String, f: String) -> String {
  cat(a, cat5(b, c, d, e, f))
}

fn cat7(a: String, b: String, c: String, d: String, e: String, f: String, g: String) -> String {
  cat(a, cat6(b, c, d, e, f, g))
}

fn idle_stage() -> I32 { 9 }

fn one() -> I32 { 1 }

fn neg_one() -> I32 { sub_i32(0, one()) }

fn state(
, pc_value: I32
, pointer_value: I32
, left_value: I32
, center_value: I32
, right_value: I32
, macro_value: I32
, checkpoints_value: I32
, checksum_value: I32
, ticks_value: I32
) -> State {
  (
  , Pc.mk(pc_value)
  , Pointer.mk(pointer_value)
  , Left_cell.mk(left_value)
  , Center_cell.mk(center_value)
  , Right_cell.mk(right_value)
  , Macro_stage.mk(macro_value)
  , Checkpoints.mk(checkpoints_value)
  , Checksum.mk(checksum_value)
  , Ticks.mk(ticks_value)
  )
}

fn initial_state() -> State { state(0, 0, 0, 0, 0, idle_stage(), 0, 0, 0) }

fn advance_pc(s: State) -> State {
  state(
  , add_i32(s.>select { Pc.get }, one())
  , s.>select { Pointer.get }
  , s.>select { Left_cell.get }
  , s.>select { Center_cell.get }
  , s.>select { Right_cell.get }
  , s.>select { Macro_stage.get }
  , s.>select { Checkpoints.get }
  , s.>select { Checksum.get }
  , s.>select { Ticks.get }
  )
}

fn tick(s: State) -> State {
  state(
  , s.>select { Pc.get }
  , s.>select { Pointer.get }
  , s.>select { Left_cell.get }
  , s.>select { Center_cell.get }
  , s.>select { Right_cell.get }
  , s.>select { Macro_stage.get }
  , s.>select { Checkpoints.get }
  , s.>select { Checksum.get }
  , add_i32(s.>select { Ticks.get }, one())
  )
}

fn set_macro_stage(s: State, stage: I32) -> State {
  state(
  , s.>select { Pc.get }
  , s.>select { Pointer.get }
  , s.>select { Left_cell.get }
  , s.>select { Center_cell.get }
  , s.>select { Right_cell.get }
  , stage
  , s.>select { Checkpoints.get }
  , s.>select { Checksum.get }
  , s.>select { Ticks.get }
  )
}

fn set_pointer(s: State, pointer_value: I32) -> State {
  state(
  , s.>select { Pc.get }
  , pointer_value
  , s.>select { Left_cell.get }
  , s.>select { Center_cell.get }
  , s.>select { Right_cell.get }
  , s.>select { Macro_stage.get }
  , s.>select { Checkpoints.get }
  , s.>select { Checksum.get }
  , s.>select { Ticks.get }
  )
}

fn move_pointer(s: State, delta: I32) -> State {
  let next = add_i32(s.>select { Pointer.get }, delta);
  if(lt_i32(next, neg_one())) {
    set_pointer(s, neg_one())
  } else if(lt_i32(one(), next)) {
    set_pointer(s, one())
  } else {
    set_pointer(s, next)
  }
}

fn apply_delta(s: State, delta: I32) -> State {
  if(eq_i32(s.>select { Pointer.get }, neg_one())) {
    state(
    , s.>select { Pc.get }
    , s.>select { Pointer.get }
    , add_i32(s.>select { Left_cell.get }, delta)
    , s.>select { Center_cell.get }
    , s.>select { Right_cell.get }
    , s.>select { Macro_stage.get }
    , s.>select { Checkpoints.get }
    , s.>select { Checksum.get }
    , s.>select { Ticks.get }
    )
  } else if(eq_i32(s.>select { Pointer.get }, 0)) {
    state(
    , s.>select { Pc.get }
    , s.>select { Pointer.get }
    , s.>select { Left_cell.get }
    , add_i32(s.>select { Center_cell.get }, delta)
    , s.>select { Right_cell.get }
    , s.>select { Macro_stage.get }
    , s.>select { Checkpoints.get }
    , s.>select { Checksum.get }
    , s.>select { Ticks.get }
    )
  } else {
    state(
    , s.>select { Pc.get }
    , s.>select { Pointer.get }
    , s.>select { Left_cell.get }
    , s.>select { Center_cell.get }
    , add_i32(s.>select { Right_cell.get }, delta)
    , s.>select { Macro_stage.get }
    , s.>select { Checkpoints.get }
    , s.>select { Checksum.get }
    , s.>select { Ticks.get }
    )
  }
}

fn pointer_name(s: State) -> String {
  if(eq_i32(s.>select { Pointer.get }, neg_one())) {
    "L"
  } else if(eq_i32(s.>select { Pointer.get }, 0)) {
    "C"
  } else {
    "R"
  }
}

fn render_tape(s: State) -> String {
  cat7(
  , "tape[L="
  , int_to_string(s.>select { Left_cell.get })
  , " C="
  , int_to_string(s.>select { Center_cell.get })
  , " R="
  , int_to_string(s.>select { Right_cell.get })
  , "]"
  )
}

fn render_position(s: State) -> String { cat(" ptr=", pointer_name(s)) }

fn checkpoint_checksum(s: State, next_count: I32) -> I32 {
  let weighted =
    add_i32(
    , add_i32(s.>select { Left_cell.get }, mul_i32(s.>select { Center_cell.get }, 3))
    , mul_i32(s.>select { Right_cell.get }, 5)
    );
  add_i32(add_i32(mul_i32(s.>select { Checksum.get }, 31), weighted), next_count)
}

fn checkpoint(label: String, s: State) -> State {
  let next_count = add_i32(s.>select { Checkpoints.get }, one());
  let next_checksum = checkpoint_checksum(s, next_count);
  let marked =
    state(
    , s.>select { Pc.get }
    , s.>select { Pointer.get }
    , s.>select { Left_cell.get }
    , s.>select { Center_cell.get }
    , s.>select { Right_cell.get }
    , s.>select { Macro_stage.get }
    , next_count
    , next_checksum
    , s.>select { Ticks.get }
    );
  print(cat7(
  , "checkpoint "
  , int_to_string(next_count)
  , " "
  , label
  , " pc="
  , int_to_string(marked.>select { Pc.get })
  , render_position(marked)
  ));
  print(cat3(" ", render_tape(marked), " "));
  print(cat3("checksum=", int_to_string(next_checksum), "\n"));
  marked
}

fn run_program_instruction(s: State) -> State {
  if(eq_i32(s.>select { Pc.get }, 0)) {
    tick(advance_pc(apply_delta(s, 3)))
  } else if(eq_i32(s.>select { Pc.get }, 1)) {
    tick(advance_pc(checkpoint("after-add", s)))
  } else if(eq_i32(s.>select { Pc.get }, 2)) {
    tick(advance_pc(move_pointer(s, one())))
  } else if(eq_i32(s.>select { Pc.get }, 3)) {
    tick(advance_pc(apply_delta(s, sub_i32(0, 2))))
  } else if(eq_i32(s.>select { Pc.get }, 4)) {
    tick(set_macro_stage(s, 0))
  } else if(eq_i32(s.>select { Pc.get }, 5)) {
    tick(advance_pc(move_pointer(s, neg_one())))
  } else if(eq_i32(s.>select { Pc.get }, 6)) {
    tick(advance_pc(apply_delta(s, 5)))
  } else {
    tick(advance_pc(checkpoint("final", s)))
  }
}

fn run_macro_instruction(s: State) -> State {
  if(eq_i32(s.>select { Macro_stage.get }, 0)) {
    tick(set_macro_stage(apply_delta(s, 4), 1))
  } else if(eq_i32(s.>select { Macro_stage.get }, 1)) {
    tick(set_macro_stage(move_pointer(s, neg_one()), 2))
  } else if(eq_i32(s.>select { Macro_stage.get }, 2)) {
    tick(set_macro_stage(apply_delta(s, neg_one()), 3))
  } else if(eq_i32(s.>select { Macro_stage.get }, 3)) {
    tick(set_macro_stage(checkpoint("macro-sweep", s), 4))
  } else {
    tick(advance_pc(set_macro_stage(s, idle_stage())))
  }
}

fn macro_active(s: State) -> Bool {
  lt_i32(s.>select { Macro_stage.get }, idle_stage())
}

fn program_done(s: State) -> Bool {
  leq_i32(8, s.>select { Pc.get })
}

fn step(s: State) -> State {
  if(macro_active(s)) { run_macro_instruction(s) } else { run_program_instruction(s) }
}

rec(loop) fn run(s: State) -> State {
  if(program_done(s)) { s } else { recur run(step(s)) }
}

fn print_final(s: State) {
  print(cat7(
  , "final pc="
  , int_to_string(s.>select { Pc.get })
  , " ticks="
  , int_to_string(s.>select { Ticks.get })
  , render_position(s)
  , " "
  , render_tape(s)
  ));
  print(cat3(" checkpoints=", int_to_string(s.>select { Checkpoints.get }), " "));
  print(cat3("checksum=", int_to_string(s.>select { Checksum.get }), "\n"))
}

pub fn main() {
  print("tape macro interpreter\n");
  print("program: add3 checkpoint move-right sub2 macro sweep move-left add5 "
        "checkpoint\n");
  let final = run(initial_state());
  print_final(final)
}
