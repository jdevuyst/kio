module pid/model;

import testapi(F64);

pub type Calibration = { Offset: F64; Scale: F64 };

pub type Gains = { Kp: F64; Ki: F64; Kd: F64; Bias: F64 };

pub type Memory = { Previous_error: F64; Accumulated_error: F64 };

pub type Step = {
  Measured: F64;
  Error: F64;
  Integral: F64;
  Derivative: F64;
  Proportional: F64;
  Integral_term: F64;
  Derivative_term: F64;
  Command: F64
};

pub type Scenario = {
  Target: F64;
  Raw_one: F64;
  Raw_two: F64;
  Raw_three: F64;
  Calibration_cfg: Calibration;
  Gains_cfg: Gains;
  Initial_memory: Memory
};

pub type Timeline = { First: Step; Second: Step; Third: Step };

pub fn scenario() -> Scenario {
  (
  , Target.mk(70.0)
  , Raw_one.mk(62.5)
  , Raw_two.mk(66.0)
  , Raw_three.mk(68.4)
  , Calibration_cfg.mk((Offset.mk(0.4), Scale.mk(1.08)))
  , Gains_cfg.mk((Kp.mk(1.25), Ki.mk(0.16), Kd.mk(0.72), Bias.mk(10.0)))
  , Initial_memory.mk((Previous_error.mk(6.5), Accumulated_error.mk(3.0)))
  )
}
