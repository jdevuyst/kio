module pid/pipeline;

import macros/row_macros(macro select);
import pid/controller(memory_after, update);
import pid/model(
, Calibration_cfg
, First
, Gains_cfg
, Initial_memory
, Raw_one
, Raw_three
, Raw_two
, Scenario
, Second
, Target
, Third
, Timeline
);

pub fn run(scenario: Scenario) -> Timeline {
  let first =
    update(
    , scenario.>select { Target.get }
    , scenario.>select { Raw_one.get }
    , scenario.>select { Calibration_cfg.get }
    , scenario.>select { Gains_cfg.get }
    , scenario.>select { Initial_memory.get }
    );
  let second =
    update(
    , scenario.>select { Target.get }
    , scenario.>select { Raw_two.get }
    , scenario.>select { Calibration_cfg.get }
    , scenario.>select { Gains_cfg.get }
    , memory_after(first)
    );
  let third =
    update(
    , scenario.>select { Target.get }
    , scenario.>select { Raw_three.get }
    , scenario.>select { Calibration_cfg.get }
    , scenario.>select { Gains_cfg.get }
    , memory_after(second)
    );
  (First.mk(first), Second.mk(second), Third.mk(third))
}
