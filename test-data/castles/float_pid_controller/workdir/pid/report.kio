module pid/report;

import macros/row_macros(macro select);
import pid/model(Command, Derivative, Error, Integral, Measured, Step);
import testapi(F64, String);
import testapi/fmt(f64_to_string);
import testapi/io(print);

fn print_value(label: String, value: F64) { print(label); print(f64_to_string(value)); print("\n") }

pub fn print_step(label: String, step: Step) {
  print(label);
  print_value("  measured=", step.>select { Measured.get });
  print_value("  error=", step.>select { Error.get });
  print_value("  integral=", step.>select { Integral.get });
  print_value("  derivative=", step.>select { Derivative.get });
  print_value("  command=", step.>select { Command.get })
}
