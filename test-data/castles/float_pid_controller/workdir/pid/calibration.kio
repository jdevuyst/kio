module pid/calibration;

import pid/model(Calibration, Offset, Scale, {offset}, {scale});
import testapi(F64);
import testapi/arith as arith;

pub fn apply(raw: F64, calibration: Calibration) -> F64 {
  let shifted = arith.sub_f64(raw, calibration.?{offset});
  arith.mul_f64(shifted, calibration.?{scale})
}
