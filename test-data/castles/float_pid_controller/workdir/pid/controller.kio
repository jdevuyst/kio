module pid/controller;

import macros/row_macros(macro select);
import pid/calibration(apply);
import pid/model(
, Accumulated_error
, Bias
, Calibration
, Command
, Derivative
, Derivative_term
, Error
, Gains
, Integral
, Integral_term
, Kd
, Ki
, Kp
, Measured
, Memory
, Previous_error
, Proportional
, Step
);
import testapi(F64);
import testapi/arith as arith;

fn control_output(bias: F64, proportional: F64, integral_term: F64, derivative_term: F64) -> F64 {
  let pi = arith.add_f64(proportional, integral_term);
  arith.add_f64(bias, arith.add_f64(pi, derivative_term))
}

pub fn update(target: F64, raw: F64, calibration: Calibration, gains: Gains, memory: Memory) -> Step {
  let measured = apply(raw, calibration);
  let error = arith.sub_f64(target, measured);
  let integral = arith.add_f64(memory.>select { Accumulated_error.get }, error);
  let derivative = arith.sub_f64(error, memory.>select { Previous_error.get });
  let proportional = arith.mul_f64(gains.>select { Kp.get }, error);
  let integral_term = arith.mul_f64(gains.>select { Ki.get }, integral);
  let derivative_term = arith.mul_f64(gains.>select { Kd.get }, derivative);
  (
  , Measured.mk(measured)
  , Error.mk(error)
  , Integral.mk(integral)
  , Derivative.mk(derivative)
  , Proportional.mk(proportional)
  , Integral_term.mk(integral_term)
  , Derivative_term.mk(derivative_term)
  , Command.mk(control_output(
    , gains.>select { Bias.get }
    , proportional
    , integral_term
    , derivative_term
    ))
  )
}

pub fn memory_after(step: Step) -> Memory {
  (
  , Previous_error.mk(step.>select { Error.get })
  , Accumulated_error.mk(step.>select { Integral.get })
  )
}
