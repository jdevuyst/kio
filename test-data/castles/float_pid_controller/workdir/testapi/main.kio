mod testapi/main;

import macros/row_macros { macro select }
import pid/model { type First; type Second; type Third; type Timeline; fn scenario }
import pid/pipeline { fn run }
import pid/report { fn print_step }
import testapi { type String }
import testapi/io { fn print }

pub fn main() {
  let timeline = run(scenario());
  print("float pid controller\n");
  print_step("sample 1\n", timeline.>select { First.get });
  print_step("sample 2\n", timeline.>select { Second.get });
  print_step("sample 3\n", timeline.>select { Third.get })
}
