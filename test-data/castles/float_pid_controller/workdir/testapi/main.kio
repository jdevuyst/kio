module testapi/main;

import macros/row_macros(macro select);
import pid/model(First, Second, Third, Timeline, scenario);
import pid/pipeline(run);
import pid/report(print_step);
import testapi(String);
import testapi/io(print);

pub fn main() {
  let timeline = run(scenario());
  print("float pid controller\n");
  print_step("sample 1\n", timeline.>select { First.get });
  print_step("sample 2\n", timeline.>select { Second.get });
  print_step("sample 3\n", timeline.>select { Third.get })
}
