mod gate_symbolic_eval/program;

import macros/control { macro if }
import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn add_i32; fn eq_i32; fn mul_i32 }
import testapi/fmt { fn int_to_string }
import testapi/io { fn print }
import testapi/iter { fn loop }
import testapi/text { fn string_concat }

rec {
  type Expr_node =
    | { Lit: I32 }
    | { Var_x: . }
    | { Var_y: . }
    | { Var_z: . }
    | { Add_left: Expr; Add_right: Expr }
    | { Mul_left: Expr; Mul_right: Expr };
  type { Expr: Expr_node { mk; get } }
}

type Maybe_i32 = { Some_i32: I32 } | { No_i32: . };

fn cat3(a: String, b: String, c: String) -> String { string_concat(string_concat(a, b), c) }

fn line(label: String, value: String) -> String { cat3(label, value, "\n") }

fn lit(value: I32) -> Expr { Expr.mk((Lit.mk(value).>widen_sum)[Expr_node]) }

fn var_x() -> Expr { Expr.mk((Var_x.mk(()).>widen_sum)[Expr_node]) }

fn var_y() -> Expr { Expr.mk((Var_y.mk(()).>widen_sum)[Expr_node]) }

fn var_z() -> Expr { Expr.mk((Var_z.mk(()).>widen_sum)[Expr_node]) }

fn add(left: Expr, right: Expr) -> Expr {
  Expr.mk(((Add_left.mk(left), Add_right.mk(right)).>widen_sum)[Expr_node])
}

fn mul(left: Expr, right: Expr) -> Expr {
  Expr.mk(((Mul_left.mk(left), Mul_right.mk(right)).>widen_sum)[Expr_node])
}

fn some_i32(value: I32) -> Maybe_i32 { (Some_i32.mk(value).>widen_sum)[Maybe_i32] }

fn no_i32() -> Maybe_i32 { (No_i32.mk(()).>widen_sum)[Maybe_i32] }

fn as_const(e: Expr) -> Maybe_i32 {
  match(e.>Expr.get) {
    (
    , .(n: Lit) { some_i32(Lit.get(n)) }
    , .(_x: Var_x) { no_i32() }
    , .(_y: Var_y) { no_i32() }
    , .(_z: Var_z) { no_i32() }
    , .(_left: Add_left, _right: Add_right) { no_i32() }
    , .(_left: Mul_left, _right: Mul_right) { no_i32() }
    )
  }
}

fn is_const(e: Expr, value: I32) -> Bool {
  match(as_const(e)) {
    (.(n: Some_i32) { eq_i32(Some_i32.get(n), value) }, .(_n: No_i32) { .f })
  }
}

fn fold_add(left: Expr, right: Expr) -> Expr {
  match(as_const(left)) {
    (
    , .(ln: Some_i32) {
        match(as_const(right)) {
          (
          , .(rn: Some_i32) { lit(add_i32(Some_i32.get(ln), Some_i32.get(rn))) }
          , .(_rn: No_i32) { add(left, right) }
          )
        }
      }
    , .(_ln: No_i32) { add(left, right) }
    )
  }
}

fn fold_mul(left: Expr, right: Expr) -> Expr {
  match(as_const(left)) {
    (
    , .(ln: Some_i32) {
        match(as_const(right)) {
          (
          , .(rn: Some_i32) { lit(mul_i32(Some_i32.get(ln), Some_i32.get(rn))) }
          , .(_rn: No_i32) { mul(left, right) }
          )
        }
      }
    , .(_ln: No_i32) { mul(left, right) }
    )
  }
}

fn simplify_add(left: Expr, right: Expr) -> Expr {
  if(is_const(left, 0)) {
    right
  } else if(is_const(right, 0)) {
    left
  } else {
    fold_add(left, right)
  }
}

fn simplify_mul(left: Expr, right: Expr) -> Expr {
  if(is_const(left, 0)) {
    lit(0)
  } else if(is_const(right, 0)) {
    lit(0)
  } else if(is_const(left, 1)) {
    right
  } else if(is_const(right, 1)) {
    left
  } else {
    fold_mul(left, right)
  }
}

rec(loop) fn simplify(e: Expr) -> Expr {
  match(e.>Expr.get) {
    (
    , .(n: Lit) { lit(Lit.get(n)) }
    , .(_x: Var_x) { var_x() }
    , .(_y: Var_y) { var_y() }
    , .(_z: Var_z) { var_z() }
    , .(left: Add_left, right: Add_right) {
        simplify_add(
        , recur(cont) simplify(Add_left.get(left))
        , recur(cont) simplify(Add_right.get(right))
        )
      }
    , .(left: Mul_left, right: Mul_right) {
        simplify_mul(
        , recur(cont) simplify(Mul_left.get(left))
        , recur(cont) simplify(Mul_right.get(right))
        )
      }
    )
  }
}

rec(loop) fn eval(e: Expr) -> I32 {
  match(e.>Expr.get) {
    (
    , .(n: Lit) { Lit.get(n) }
    , .(_x: Var_x) { 7 }
    , .(_y: Var_y) { 4 }
    , .(_z: Var_z) { 9 }
    , .(left: Add_left, right: Add_right) {
        add_i32(recur(cont) eval(Add_left.get(left)), recur(cont) eval(Add_right.get(right)))
      }
    , .(left: Mul_left, right: Mul_right) {
        mul_i32(recur(cont) eval(Mul_left.get(left)), recur(cont) eval(Mul_right.get(right)))
      }
    )
  }
}

rec(loop) fn render(e: Expr) -> String {
  match(e.>Expr.get) {
    (
    , .(n: Lit) { int_to_string(Lit.get(n)) }
    , .(_x: Var_x) { "x" }
    , .(_y: Var_y) { "y" }
    , .(_z: Var_z) { "z" }
    , .(left: Add_left, right: Add_right) {
        cat3(
        , cat3("(", recur(cont) render(Add_left.get(left)), " + ")
        , recur(cont) render(Add_right.get(right))
        , ")"
        )
      }
    , .(left: Mul_left, right: Mul_right) {
        cat3(
        , cat3("(", recur(cont) render(Mul_left.get(left)), " * ")
        , recur(cont) render(Mul_right.get(right))
        , ")"
        )
      }
    )
  }
}

fn emit_case(name: String, expr_value: Expr) {
  let simplified = simplify(expr_value);
  print(line("case ", name));
  print(line("before: ", render(expr_value)));
  print(line("after: ", render(simplified)));
  print(line("value: ", int_to_string(eval(simplified))))
}

fn alpha() -> Expr { mul(add(var_x(), lit(0)), add(lit(2), lit(3))) }

fn beta() -> Expr { add(mul(var_y(), lit(1)), mul(var_z(), lit(0))) }

fn gamma() -> Expr { mul(add(lit(1), lit(2)), add(var_x(), var_y())) }

fn delta() -> Expr { add(add(var_z(), mul(lit(3), lit(0))), mul(lit(4), lit(5))) }

pub fn run() {
  print("symbolic simplifier\n\n");
  emit_case("alpha", alpha());
  print("\n");
  emit_case("beta", beta());
  print("\n");
  emit_case("gamma", gamma());
  print("\n");
  emit_case("delta", delta())
}
