/// The Huffman tree, and the greedy merge that builds it.
///
/// There is no host priority queue, so the node list is simply kept sorted and
/// a merged node is re-inserted at its place. The order is total, which is what
/// makes the tree reproducible: with ties, a Huffman tree is *not* unique, and
/// every codeword the program goes on to print depends on the tie being broken
/// the same way on every run.
///
/// The pinned order is ascending `(weight, key)`:
///
///   - a leaf's key is its symbol code;
///   - the k-th merged node's key is `alphabet_size + k`.
///
/// So equal-weight leaves order by symbol code, an equal-weight leaf precedes an
/// internal node (every leaf key sits below every internal key), and equal
/// weight internal nodes order by creation. This message exercises all three.
module huffman/tree;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import huffman/freq(Count, {count_freq}, {count_symbol});
import huffman/list(List, cons, nil, of1, reverse);
import testapi(Bool, I32);
import testapi/arith(add_i32, lt_i32);
import testapi/iter(loop);

rec {
  /// A leaf stores no key of its own: its key *is* its symbol code, so the
  /// tie-break rule is a property of the shape rather than a field that has to be
  /// kept in step with it.
  pub labels Node_shape =
    { leaf_symbol: I32, leaf_weight: I32 }
    | { fork_weight: I32, fork_key: I32, fork_left: Node, fork_right: Node };
  pub newtype Node : Node_shape { constructor mk_node; pub projector un_node }
}

pub fn leaf(symbol: I32, weight: I32) -> Node {
  Node.mk_node({leaf_symbol = symbol, leaf_weight = weight}.>widen_sum!(Node_shape))
}

pub fn fork(weight: I32, key: I32, left: Node, right: Node) -> Node {
  Node.mk_node({fork_weight = weight, fork_key = key, fork_left = left, fork_right = right}
    .>widen_sum!(Node_shape))
}

pub fn weight(node: Node) -> I32 {
  match! node.>Node.un_node {
    (
      , .(_symbol: Leaf_symbol, w: Leaf_weight) { w.?{leaf_weight} }
      , .(w: Fork_weight, _key: Fork_key, _left: Fork_left, _right: Fork_right) { w.?{fork_weight} }
      )
  }
}

pub fn key(node: Node) -> I32 {
  match! node.>Node.un_node {
    (
      , .(symbol: Leaf_symbol, _weight: Leaf_weight) { symbol.?{leaf_symbol} }
      , .(_weight: Fork_weight, k: Fork_key, _left: Fork_left, _right: Fork_right) { k.?{fork_key} }
      )
  }
}

pub fn is_leaf(node: Node) -> Bool {
  match! node.>Node.un_node {
    (
      , .(_symbol: Leaf_symbol, _weight: Leaf_weight) { .t }
      , .(_weight: Fork_weight, _key: Fork_key, _left: Fork_left, _right: Fork_right) { .f }
      )
  }
}

/// The leaf's symbol, or `fallback` at a fork. The transcript uses it to name a
/// node; the coder itself always knows which shape it is holding.
pub fn symbol_or(node: Node, fallback: I32) -> I32 {
  match! node.>Node.un_node {
    (
      , .(symbol: Leaf_symbol, _weight: Leaf_weight) { symbol.?{leaf_symbol} }
      , .(_weight: Fork_weight, _key: Fork_key, _left: Fork_left, _right: Fork_right) { fallback }
      )
  }
}

/// The pinned total order. Lighter first; equal weights fall back to the key.
fn precedes(a: Node, b: Node) -> Bool {
  let wa = weight(a);
  let wb = weight(b);
  if! lt_i32(wa, wb) {
    .t
  } else if! lt_i32(wb, wa) {
    .f
  } else {
    lt_i32(key(a), key(b))
  }
}

rec(loop) fn insert_ordered(node: Node, nodes: List(Node)) -> List(Node) {
  match! nodes.>List.un_list {
    (
      , .(head: Node, rest: List(Node)) {
          if! precedes(node, head) {
            cons(node, nodes)
          } else {
            cons(head, rec(cont) insert_ordered(node, rest))
          }
        }
      , .(_empty: .) { of1(node) }
      )
  }
}

rec(loop) fn queue_onto(counts: List(Count), acc: List(Node)) -> List(Node) {
  match! counts.>List.un_list {
    (
      , .(row: Count, rest: List(Count)) {
          let node = leaf(row.?{count_symbol}, row.?{count_freq});
          rec queue_onto(rest, insert_ordered(node, acc))
        }
      , .(_empty: .) { acc }
      )
  }
}

/// The starting queue: one leaf per present symbol, in the pinned order.
pub fn initial_queue(counts: List(Count)) -> List(Node) { queue_onto(counts, nil(Node, ())) }

pub labels Step = { step_left: Node, step_right: Node, step_merged: Node };

fn step(left: Node, right: Node, merged: Node) -> Step {
  {step_left = left, step_right = right, step_merged = merged}
}

pub labels Built = { built_root: Node, built_log: List(Step) };

fn built(root: Node, log: List(Step)) -> Built { {built_root = root, built_log = log} }

/// Take the two front nodes, merge them, put the merge back in order, repeat.
/// The first node taken becomes the left child and so is reached by bit 0.
///
/// An empty queue cannot arise from a non-empty message, but the walk is total,
/// so it yields a weightless leaf rather than failing.
pub rec(loop) fn build(nodes: List(Node), next_key: I32, log: List(Step)) -> Built {
  match! nodes.>List.un_list {
    (
      , .(first: Node, rest: List(Node)) {
          match! rest.>List.un_list {
            (
              , .(second: Node, others: List(Node)) {
                  let merged =
                    fork(add_i32(weight(first), weight(second)), next_key, first, second);
                  rec build(
                    , insert_ordered(merged, others)
                    , add_i32(next_key, 1)
                    , cons(step(first, second, merged), log)
                    )
                }
              , .(_single: .) { built(first, reverse(log)) }
              )
          }
        }
      , .(_empty: .) { built(leaf(-1, 0), reverse(log)) }
      )
  }
}
