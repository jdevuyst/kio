/// String plumbing for the transcript.
///
/// The tier has no `string_len`, so nothing here may measure a string it is
/// handed. Every width is derived arithmetically instead: `digits` counts
/// decimal places by walking powers of ten, and `pad_text` asks the caller for
/// the length it already knows (a glyph is one column; a codeword is as long as
/// its recorded bit count).
module huffman/text;

import elab/control(if);
import testapi(Bool, I32, String);
import testapi/arith(add_i32, lt_i32, mul_i32, sub_i32);
import testapi/fmt(int_to_string);
import testapi/iter(loop);
import testapi/text(string_concat);

pub fn cat(a: String, b: String) -> String { string_concat(a, b) }

pub fn cat3(a: String, b: String, c: String) -> String { cat(cat(a, b), c) }

pub fn cat4(a: String, b: String, c: String, d: String) -> String { cat(cat3(a, b, c), d) }

pub fn num(value: I32) -> String { int_to_string(value) }

rec(loop) fn digits_from(value: I32, count: I32, power: I32) -> I32 {
  if! lt_i32(value, power) {
    count
  } else {
    rec digits_from(value, add_i32(count, 1), mul_i32(power, 10))
  }
}

/// Decimal columns `value` occupies. Only non-negative values reach the
/// transcript, so the negative case is not modelled.
fn digits(value: I32) -> I32 { digits_from(value, 1, 10) }

rec(loop) fn repeat_onto(unit: String, times: I32, acc: String) -> String {
  if! lt_i32(times, 1) {
    acc
  } else {
    rec repeat_onto(unit, sub_i32(times, 1), cat(acc, unit))
  }
}

pub fn repeat(unit: String, times: I32) -> String { repeat_onto(unit, times, "") }

pub fn spaces(count: I32) -> String { repeat(" ", count) }

/// Right-align an integer in `width` columns.
pub fn pad_num(value: I32, width: I32) -> String {
  cat(spaces(sub_i32(width, digits(value))), num(value))
}

/// Right-align a string whose column count the caller already knows.
pub fn pad_text(text: String, text_width: I32, width: I32) -> String {
  cat(spaces(sub_i32(width, text_width)), text)
}

pub fn line(text: String) -> String { cat(text, "\n") }
