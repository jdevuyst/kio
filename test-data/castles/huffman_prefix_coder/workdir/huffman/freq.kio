/// The frequency table: how often each alphabet symbol occurs in the message.
///
/// The tally is a single walk over the message. Each symbol read bumps its
/// counter in place, so the table is rebuilt once per message symbol rather
/// than the alphabet being rescanned once per symbol.
module huffman/freq;

import elab/control(if);
import elab/match(match);
import huffman/list(List, cons, keep, nil, reverse);
import huffman/message(alphabet_size);
import testapi(Bool, I32);
import testapi/arith(add_i32, eq_i32, lt_i32, sub_i32);
import testapi/iter(loop);

pub labels Count = { count_symbol: I32, count_freq: I32 };

pub fn count(symbol: I32, freq: I32) -> Count { {count_symbol = symbol, count_freq = freq} }

rec(loop) fn zero_counts_onto(symbol: I32, acc: List(Count)) -> List(Count) {
  if! lt_i32(symbol, 0) {
    acc
  } else {
    rec zero_counts_onto(sub_i32(symbol, 1), cons(count(symbol, 0), acc))
  }
}

/// One zeroed row per declared symbol, in symbol order.
pub fn zero_counts() -> List(Count) {
  zero_counts_onto(sub_i32(alphabet_size(), 1), nil(Count, ()))
}

rec(loop) fn bump_onto(counts: List(Count), symbol: I32, acc: List(Count)) -> List(Count) {
  match! counts.>List.un_list {
    (
      , .(row: Count, rest: List(Count)) {
          let bumped =
            if! eq_i32(row.?{count_symbol}, symbol) {
              count(symbol, add_i32(row.?{count_freq}, 1))
            } else {
              row
            };
          rec bump_onto(rest, symbol, cons(bumped, acc))
        }
      , .(_empty: .) { reverse(acc) }
      )
  }
}

fn bump(counts: List(Count), symbol: I32) -> List(Count) {
  bump_onto(counts, symbol, nil(Count, ()))
}

pub rec(loop) fn tally(symbols: List(I32), counts: List(Count)) -> List(Count) {
  match! symbols.>List.un_list {
    (
      , .(symbol: I32, rest: List(I32)) { rec tally(rest, bump(counts, symbol)) }
      , .(_empty: .) { counts }
      )
  }
}

fn occurs(row: Count) -> Bool { lt_i32(0, row.?{count_freq}) }

/// A symbol the message never uses gets no leaf: only observed symbols
/// participate in the tree construction and the encoded-message cost.
pub fn present(counts: List(Count)) -> List(Count) { keep(counts, occurs) }
