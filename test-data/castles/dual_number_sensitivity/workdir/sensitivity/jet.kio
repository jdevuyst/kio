module sensitivity/jet;

import macros/row_macros(macro record, macro select, macro with);
import testapi(F64);
import testapi/arith as arith;

pub type Jet = { Value: F64; Dx: F64; Dy: F64; Dxx: F64; Dxy: F64; Dyy: F64 };

pub fn constant(value: F64) -> Jet {
  record { Value.mk(value); Dx.mk(0.0); Dy.mk(0.0); Dxx.mk(0.0); Dxy.mk(0.0); Dyy.mk(0.0) }
}

fn variable_x(value: F64) -> Jet {
  constant(value).>with { Dx.mk(1.0) }
}

fn variable_y(value: F64) -> Jet {
  constant(value).>with { Dy.mk(1.0) }
}

pub fn add(a: Jet, b: Jet) -> Jet {
  record {
    Value.mk(arith.add_f64(a.>select { Value.get }, b.>select { Value.get }));
    Dx.mk(arith.add_f64(a.>select { Dx.get }, b.>select { Dx.get }));
    Dy.mk(arith.add_f64(a.>select { Dy.get }, b.>select { Dy.get }));
    Dxx.mk(arith.add_f64(a.>select { Dxx.get }, b.>select { Dxx.get }));
    Dxy.mk(arith.add_f64(a.>select { Dxy.get }, b.>select { Dxy.get }));
    Dyy.mk(arith.add_f64(a.>select { Dyy.get }, b.>select { Dyy.get }))
  }
}

pub fn sub(a: Jet, b: Jet) -> Jet {
  record {
    Value.mk(arith.sub_f64(a.>select { Value.get }, b.>select { Value.get }));
    Dx.mk(arith.sub_f64(a.>select { Dx.get }, b.>select { Dx.get }));
    Dy.mk(arith.sub_f64(a.>select { Dy.get }, b.>select { Dy.get }));
    Dxx.mk(arith.sub_f64(a.>select { Dxx.get }, b.>select { Dxx.get }));
    Dxy.mk(arith.sub_f64(a.>select { Dxy.get }, b.>select { Dxy.get }));
    Dyy.mk(arith.sub_f64(a.>select { Dyy.get }, b.>select { Dyy.get }))
  }
}

pub fn scale(factor: F64, a: Jet) -> Jet {
  record {
    Value.mk(arith.mul_f64(factor, a.>select { Value.get }));
    Dx.mk(arith.mul_f64(factor, a.>select { Dx.get }));
    Dy.mk(arith.mul_f64(factor, a.>select { Dy.get }));
    Dxx.mk(arith.mul_f64(factor, a.>select { Dxx.get }));
    Dxy.mk(arith.mul_f64(factor, a.>select { Dxy.get }));
    Dyy.mk(arith.mul_f64(factor, a.>select { Dyy.get }))
  }
}

// Hessian entries store derivatives themselves, not Taylor coefficients.
pub fn mul(a: Jet, b: Jet) -> Jet {
  let .(av, ax, ay, axx, axy, ayy) =
    a.>select { Value.get; Dx.get; Dy.get; Dxx.get; Dxy.get; Dyy.get };
  let .(bv, bx, by, bxx, bxy, byy) =
    b.>select { Value.get; Dx.get; Dy.get; Dxx.get; Dxy.get; Dyy.get };
  record {
    Value.mk(arith.mul_f64(av, bv));
    Dx.mk(arith.add_f64(arith.mul_f64(ax, bv), arith.mul_f64(av, bx)));
    Dy.mk(arith.add_f64(arith.mul_f64(ay, bv), arith.mul_f64(av, by)));
    Dxx.mk(arith.add_f64(
    , arith.add_f64(arith.mul_f64(axx, bv), arith.mul_f64(2.0, arith.mul_f64(ax, bx)))
    , arith.mul_f64(av, bxx)
    ));
    Dxy.mk(arith.add_f64(
    , arith.add_f64(arith.mul_f64(axy, bv), arith.mul_f64(ax, by))
    , arith.add_f64(arith.mul_f64(ay, bx), arith.mul_f64(av, bxy))
    ));
    Dyy.mk(arith.add_f64(
    , arith.add_f64(arith.mul_f64(ayy, bv), arith.mul_f64(2.0, arith.mul_f64(ay, by)))
    , arith.mul_f64(av, byy)
    ))
  }
}

pub fn square(a: Jet) -> Jet { mul(a, a) }

pub fn evaluate(model: (Jet & Jet) -> Jet, x: F64, y: F64) -> Jet {
  model(variable_x(x), variable_y(y))
}

pub fn directional(result: Jet, vx: F64, vy: F64) -> F64 & F64 {
  let slope =
    arith.add_f64(
    , arith.mul_f64(result.>select { Dx.get }, vx)
    , arith.mul_f64(result.>select { Dy.get }, vy)
    );
  let hxx = arith.mul_f64(result.>select { Dxx.get }, arith.mul_f64(vx, vx));
  let hxy = arith.mul_f64(result.>select { Dxy.get }, arith.mul_f64(2.0, arith.mul_f64(vx, vy)));
  let hyy = arith.mul_f64(result.>select { Dyy.get }, arith.mul_f64(vy, vy));
  (slope, arith.add_f64(arith.add_f64(hxx, hxy), hyy))
}
