mod sensitivity/report;

import macros/row_macros { macro select }
import sensitivity/jet as jet;
import testapi { type F64; type String }
import testapi/fmt as fmt;
import testapi/io as io;

fn number(value: F64) { io.print(fmt.f64_to_string(value)) }

fn pair(x: F64, y: F64) { io.print("("); number(x); io.print(", "); number(y); io.print(")") }

pub fn model(name: String, run: (jet.Jet & jet.Jet) -> jet.Jet, x: F64, y: F64, vx: F64, vy: F64) {
  let result = jet.evaluate(run, x, y);
  let .(slope, curvature) = jet.directional(result, vx, vy);
  io.print(name);
  io.print(" at ");
  pair(x, y);
  io.print("\n  value=");
  number(result.>select { jet.Value.get });
  io.print(" gradient=");
  pair(result.>select { jet.Dx.get }, result.>select { jet.Dy.get });
  io.print("\n  hessian=(");
  number(result.>select { jet.Dxx.get });
  io.print(", ");
  number(result.>select { jet.Dxy.get });
  io.print("; ");
  number(result.>select { jet.Dxy.get });
  io.print(", ");
  number(result.>select { jet.Dyy.get });
  io.print(")\n  direction=");
  pair(vx, vy);
  io.print(" slope=");
  number(slope);
  io.print(" curvature=");
  number(curvature);
  io.print("\n")
}
