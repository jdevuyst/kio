mod testapi/main;

import macros/control { macro if }
import testapi { type Array; type Bool; type I32; type String }
import testapi/arith { fn add_i32; fn leq_i32 }
import testapi/array {
  fn array_clone;
  fn array_get;
  fn array_len;
  fn array_make_empty;
  fn array_push;
  fn array_set;
  fn array_swap
}
import testapi/fmt { fn bool_to_string; fn int_to_string }
import testapi/io { fn print }
import testapi/iter { fn loop }
import testapi/text { fn string_concat; fn string_eq }

fn initial_yard() -> Array[String] {
  let yard = array_make_empty[String](());
  array_push(yard, "A1");
  array_push(yard, "B7");
  array_push(yard, "empty");
  array_push(yard, "C3");
  array_push(yard, "hold");
  yard
}

fn is_empty(slot: String) -> Bool { string_eq(slot, "empty") }

rec(loop) fn occupied_count(yard: Array[String], index: I32, last: I32, count: I32) -> I32 {
  if(leq_i32(index, last)) {
    if(is_empty(array_get(yard, index))) {
      recur occupied_count(yard, add_i32(index, 1), last, count)
    } else {
      recur occupied_count(yard, add_i32(index, 1), last, add_i32(count, 1))
    }
  } else {
    count
  }
}

fn render(yard: Array[String]) -> String {
  string_concat(
  , array_get(yard, 0)
  , string_concat(
    , "|"
    , string_concat(
      , array_get(yard, 1)
      , string_concat(
        , "|"
        , string_concat(
          , array_get(yard, 2)
          , string_concat(
            , "|"
            , string_concat(array_get(yard, 3), string_concat("|", array_get(yard, 4)))
            )
          )
        )
      )
    )
  )
}

fn safe(yard: Array[String]) -> Bool { is_empty(array_get(yard, 0)) }

pub fn main() {
  let before = initial_yard();
  let after = array_clone(before);
  array_swap(after, 0, 2);
  array_set(after, 4, "D9");
  print("train yard switchboard\n");
  print(int_to_string(array_len(after)).>string_concat("\n").>>string_concat("tracks="));
  print(render(before).>string_concat("\n").>>string_concat("before="));
  print(render(after).>string_concat("\n").>>string_concat("after="));
  print(int_to_string(occupied_count(after, 0, 4, 0))
    .>string_concat("\n")
    .>>string_concat("occupied="));
  print(bool_to_string(safe(after)).>string_concat("\n").>>string_concat("safe="))
}
