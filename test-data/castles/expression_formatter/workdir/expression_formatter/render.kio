module expression_formatter/render;

import expression_formatter/parse(parse);
import expression_formatter/scan(scan);
import expression_formatter/types(
, Add_token
, Assignment_name
, Binding_count
, Binding_token
, Close_token
, Eq_token
, Factor_text
, Group_token
, Grouped_term
, Left_term
, Left_token
, Literal_token
, Max_depth
, Mul_token
, Normalized_expr
, Open_token
, Shape_name
, Source_text
, Token_count
, Token_depth
, Token_kind
, Token_start
, Token_stop
, Token_text
, Valid_shape
);
import macros/row_macros(macro select);
import testapi(String);
import testapi/fmt(bool_to_string, int_to_string);
import testapi/text(string_concat);

fn cat3(a: String, b: String, c: String) -> String { string_concat(a, string_concat(b, c)) }

fn cat4(a: String, b: String, c: String, d: String) -> String { string_concat(a, cat3(b, c, d)) }

fn cat5(a: String, b: String, c: String, d: String, e: String) -> String {
  string_concat(a, cat4(b, c, d, e))
}

fn span_text(token: Token_kind & Token_text & Token_start & Token_stop & Token_depth) -> String {
  cat5(
  , "["
  , int_to_string(token.>select { Token_start.get })
  , ","
  , int_to_string(token.>select { Token_stop.get })
  , ")"
  )
}

fn token_line(
, index: String
, token: Token_kind & Token_text & Token_start & Token_stop & Token_depth
) -> String {
  string_concat(
  , index
  , string_concat(
    , " "
    , string_concat(
      , token.>select { Token_kind.get }
      , string_concat(
        , " span="
        , string_concat(
          , span_text(token)
          , string_concat(
            , " depth="
            , string_concat(
              , int_to_string(token.>select { Token_depth.get })
              , string_concat(" text=", string_concat(token.>select { Token_text.get }, "\n"))
              )
            )
          )
        )
      )
    )
  )
}

fn header(
, stream: & Source_text
  & Binding_token
  & Eq_token
  & Left_token
  & Add_token
  & Open_token
  & Group_token
  & Mul_token
  & Literal_token
  & Close_token
, state: & Assignment_name
  & Left_term
  & Grouped_term
  & Factor_text
  & Normalized_expr
  & Shape_name
  & Valid_shape
  & Token_count
  & Max_depth
  & Binding_count
) -> String {
  string_concat(
  , "expression_formatter: v1\n"
  , string_concat(
    , cat3("source: ", stream.>select { Source_text.get }, "\n")
    , string_concat(
      , cat3("normalized: ", state.>select { Normalized_expr.get }, "\n")
      , string_concat(
        , cat3("shape: ", state.>select { Shape_name.get }, "\n")
        , string_concat(
          , cat3("valid: ", bool_to_string(state.>select { Valid_shape.get }), "\n")
          , string_concat(
            , cat3("tokens: ", int_to_string(state.>select { Token_count.get }), "\n")
            , string_concat(
              , cat3("max-depth: ", int_to_string(state.>select { Max_depth.get }), "\n")
              , cat3("bindings: ", int_to_string(state.>select { Binding_count.get }), "\n")
              )
            )
          )
        )
      )
    )
  )
}

fn token_table(stream: & Source_text
& Binding_token
& Eq_token
& Left_token
& Add_token
& Open_token
& Group_token
& Mul_token
& Literal_token
& Close_token) -> String {
  string_concat(
  , "token-table:\n"
  , string_concat(
    , token_line("  01", stream.>select { Binding_token.get })
    , string_concat(
      , token_line("  02", stream.>select { Eq_token.get })
      , string_concat(
        , token_line("  03", stream.>select { Left_token.get })
        , string_concat(
          , token_line("  04", stream.>select { Add_token.get })
          , string_concat(
            , token_line("  05", stream.>select { Open_token.get })
            , string_concat(
              , token_line("  06", stream.>select { Group_token.get })
              , string_concat(
                , token_line("  07", stream.>select { Mul_token.get })
                , string_concat(
                  , token_line("  08", stream.>select { Literal_token.get })
                  , token_line("  09", stream.>select { Close_token.get })
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

pub fn render_report() -> String {
  let stream = scan();
  let state = parse(stream);
  string_concat(header(stream, state), token_table(stream))
}
