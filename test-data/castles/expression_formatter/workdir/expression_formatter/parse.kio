module expression_formatter/parse;

import elab/control(if);
import expression_formatter/types(
  , Add_token
  , Assignment_name
  , Binding_count
  , Binding_token
  , Close_token
  , Eq_token
  , Factor_text
  , Group_token
  , Grouped_term
  , Left_term
  , Left_token
  , Literal_token
  , Max_depth
  , Mul_token
  , Normalized_expr
  , Open_token
  , Shape_name
  , Source_text
  , Token_count
  , Token_text
  , Valid_shape
  );
import expression_formatter/types(
  , {add_token}
  , {assignment_name}
  , {binding_count}
  , {binding_token}
  , {close_token}
  , {eq_token}
  , {factor_text}
  , {group_token}
  , {grouped_term}
  , {left_term}
  , {left_token}
  , {literal_token}
  , {max_depth}
  , {mul_token}
  , {normalized_expr}
  , {open_token}
  , {shape_name}
  , {source_text}
  , {token_count}
  , {token_text}
  , {valid_shape}
  );
import testapi(Bool, Int, String);
import testapi/fmt(int_to_string);
import testapi/text(string_concat, string_eq, string_len);

fn and_bool(a: Bool, b: Bool) -> Bool {
  if! a {
    b
  } else {
    .f
  }
}

fn normalize(name: String, left: String, grouped: String, factor: String) -> String {
  string_concat(
    , name
    , string_concat(
        , " = "
        , string_concat(
            , left
            , string_concat(
                , " + ("
                , string_concat(grouped, string_concat(" * ", string_concat(factor, ")")))
                )
            )
        )
    )
}

fn valid_stream(stream: & Source_text
& Binding_token
& Eq_token
& Left_token
& Add_token
& Open_token
& Group_token
& Mul_token
& Literal_token
& Close_token) -> Bool {
  let src = stream.?{source_text};
  let binding = stream.?{binding_token};
  let eq = stream.?{eq_token};
  let left = stream.?{left_token};
  let add = stream.?{add_token};
  let open = stream.?{open_token};
  let grouped = stream.?{group_token};
  let mul = stream.?{mul_token};
  let literal = stream.?{literal_token};
  let close = stream.?{close_token};
  let source_ok = string_eq(int_to_string(string_len(src)), "18");
  let binding_ok = string_eq(binding.?{token_text}, "total");
  let eq_ok = string_eq(eq.?{token_text}, "=");
  let left_ok = string_eq(left.?{token_text}, "base");
  let add_ok = string_eq(add.?{token_text}, "+");
  let open_ok = string_eq(open.?{token_text}, "(");
  let grouped_ok = string_eq(grouped.?{token_text}, "tax");
  let mul_ok = string_eq(mul.?{token_text}, "*");
  let literal_ok = string_eq(literal.?{token_text}, "3");
  let close_ok = string_eq(close.?{token_text}, ")");
  and_bool(
    , source_ok
    , and_bool(
        , binding_ok
        , and_bool(
            , eq_ok
            , and_bool(
                , left_ok
                , and_bool(
                    , add_ok
                    , and_bool(
                        , open_ok
                        , and_bool(grouped_ok, and_bool(mul_ok, and_bool(literal_ok, close_ok)))
                        )
                    )
                )
            )
        )
    )
}

pub fn parse(stream: & Source_text
& Binding_token
& Eq_token
& Left_token
& Add_token
& Open_token
& Group_token
& Mul_token
& Literal_token
& Close_token) ->
  & Assignment_name
  & Left_term
  & Grouped_term
  & Factor_text
  & Normalized_expr
  & Shape_name
  & Valid_shape
  & Token_count
  & Max_depth
  & Binding_count
   {
  let binding = stream.?{binding_token};
  let left = stream.?{left_token};
  let grouped = stream.?{group_token};
  let literal = stream.?{literal_token};
  let name = binding.?{token_text};
  let left_name = left.?{token_text};
  let grouped_name = grouped.?{token_text};
  let factor = literal.?{token_text};
  {
    , assignment_name = name
    , left_term = left_name
    , grouped_term = grouped_name
    , factor_text = factor
    , normalized_expr = normalize(name, left_name, grouped_name, factor)
    , shape_name = "assign:add(grouped-mul)"
    , valid_shape = valid_stream(stream)
    , token_count = 9
    , max_depth = 1
    , binding_count = 1
    }
}
