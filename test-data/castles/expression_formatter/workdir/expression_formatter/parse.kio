mod expression_formatter/parse;

import expression_formatter/types {
  type Add_token;
  type Assignment_name;
  type Binding_count;
  type Binding_token;
  type Close_token;
  type Eq_token;
  type Factor_text;
  type Group_token;
  type Grouped_term;
  type Left_term;
  type Left_token;
  type Literal_token;
  type Max_depth;
  type Mul_token;
  type Normalized_expr;
  type Open_token;
  type Shape_name;
  type Source_text;
  type Token_count;
  type Token_text;
  type Valid_shape
}
import macros/control { macro if }
import macros/row_macros { macro select }
import testapi { type Bool; type Int; type String }
import testapi/fmt { fn int_to_string }
import testapi/text { fn string_concat; fn string_eq; fn string_len }

fn and_bool(a: Bool, b: Bool) -> Bool {
  if(a) { b } else { .f }
}

fn normalize(name: String, left: String, grouped: String, factor: String) -> String {
  string_concat(
  , name
  , string_concat(
    , " = "
    , string_concat(
      , left
      , string_concat(
        , " + ("
        , string_concat(grouped, string_concat(" * ", string_concat(factor, ")")))
        )
      )
    )
  )
}

fn valid_stream(stream: & Source_text
& Binding_token
& Eq_token
& Left_token
& Add_token
& Open_token
& Group_token
& Mul_token
& Literal_token
& Close_token) -> Bool {
  let src = stream.>select { Source_text.get };
  let binding = stream.>select { Binding_token.get };
  let eq = stream.>select { Eq_token.get };
  let left = stream.>select { Left_token.get };
  let add = stream.>select { Add_token.get };
  let open = stream.>select { Open_token.get };
  let grouped = stream.>select { Group_token.get };
  let mul = stream.>select { Mul_token.get };
  let literal = stream.>select { Literal_token.get };
  let close = stream.>select { Close_token.get };
  let source_ok = string_eq(int_to_string(string_len(src)), "18");
  let binding_ok = string_eq(binding.>select { Token_text.get }, "total");
  let eq_ok = string_eq(eq.>select { Token_text.get }, "=");
  let left_ok = string_eq(left.>select { Token_text.get }, "base");
  let add_ok = string_eq(add.>select { Token_text.get }, "+");
  let open_ok = string_eq(open.>select { Token_text.get }, "(");
  let grouped_ok = string_eq(grouped.>select { Token_text.get }, "tax");
  let mul_ok = string_eq(mul.>select { Token_text.get }, "*");
  let literal_ok = string_eq(literal.>select { Token_text.get }, "3");
  let close_ok = string_eq(close.>select { Token_text.get }, ")");
  and_bool(
  , source_ok
  , and_bool(
    , binding_ok
    , and_bool(
      , eq_ok
      , and_bool(
        , left_ok
        , and_bool(
          , add_ok
          , and_bool(
            , open_ok
            , and_bool(grouped_ok, and_bool(mul_ok, and_bool(literal_ok, close_ok)))
            )
          )
        )
      )
    )
  )
}

pub fn parse(stream: & Source_text
& Binding_token
& Eq_token
& Left_token
& Add_token
& Open_token
& Group_token
& Mul_token
& Literal_token
& Close_token) ->
  & Assignment_name
  & Left_term
  & Grouped_term
  & Factor_text
  & Normalized_expr
  & Shape_name
  & Valid_shape
  & Token_count
  & Max_depth
  & Binding_count
   {
  let binding = stream.>select { Binding_token.get };
  let left = stream.>select { Left_token.get };
  let grouped = stream.>select { Group_token.get };
  let literal = stream.>select { Literal_token.get };
  let name = binding.>select { Token_text.get };
  let left_name = left.>select { Token_text.get };
  let grouped_name = grouped.>select { Token_text.get };
  let factor = literal.>select { Token_text.get };
  (
  , Assignment_name.mk(name)
  , Left_term.mk(left_name)
  , Grouped_term.mk(grouped_name)
  , Factor_text.mk(factor)
  , Normalized_expr.mk(normalize(name, left_name, grouped_name, factor))
  , Shape_name.mk("assign:add(grouped-mul)")
  , Valid_shape.mk(valid_stream(stream))
  , Token_count.mk(9)
  , Max_depth.mk(1)
  , Binding_count.mk(1)
  )
}
