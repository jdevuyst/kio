module expression_formatter/scan;

import expression_formatter/types(
, Add_token
, Binding_token
, Close_token
, Eq_token
, Group_token
, Left_token
, Literal_token
, Mul_token
, Open_token
, Source_text
);
import expression_formatter/types(Token_depth, Token_kind, Token_start, Token_stop, Token_text);
import testapi(Int, String);
import testapi/text(string_slice);

fn token(src: String, kind: String, start: Int, stop: Int, depth: Int) ->
  Token_kind & Token_text & Token_start & Token_stop & Token_depth
   {
  (
  , Token_kind.mk(kind)
  , Token_text.mk(string_slice(src, start, stop))
  , Token_start.mk(start)
  , Token_stop.mk(stop)
  , Token_depth.mk(depth)
  )
}

pub fn fixture() -> String { "total=base+(tax*3)" }

pub fn scan() ->
  & Source_text
  & Binding_token
  & Eq_token
  & Left_token
  & Add_token
  & Open_token
  & Group_token
  & Mul_token
  & Literal_token
  & Close_token
   {
  let src = fixture();
  (
  , Source_text.mk(src)
  , Binding_token.mk(token(src, "identifier", 0, 5, 0))
  , Eq_token.mk(token(src, "equals", 5, 6, 0))
  , Left_token.mk(token(src, "identifier", 6, 10, 0))
  , Add_token.mk(token(src, "operator", 10, 11, 0))
  , Open_token.mk(token(src, "open", 11, 12, 1))
  , Group_token.mk(token(src, "identifier", 12, 15, 1))
  , Mul_token.mk(token(src, "operator", 15, 16, 1))
  , Literal_token.mk(token(src, "number", 16, 17, 1))
  , Close_token.mk(token(src, "close", 17, 18, 0))
  )
}
