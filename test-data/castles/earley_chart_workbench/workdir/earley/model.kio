module earley/model;

import earley/arrays as numbers;
import macros/control(macro if);
import macros/row_macros(macro select);
import macros/spine_macros(macro widen_sum);
import testapi(Array, Bool, I32);
import testapi/arith as arith;
import testapi/array as arrays;

pub type Symbol = { Terminal: I32 } | { Nonterminal: I32 };

pub type Production = { Lhs: I32; Rhs: Array[Symbol] };

pub type Grammar = Array[Production];

pub type Item = { Production_index: I32; Dot: I32; Origin: I32 };

pub type Column = Array[Item];

pub type Chart = Array[Column];

pub fn token(id: I32) -> Symbol { Terminal.mk(id).>widen_sum }

pub fn category(id: I32) -> Symbol { Nonterminal.mk(id).>widen_sum }

pub fn production(left: I32, right: Array[Symbol]) -> Production { (Lhs.mk(left), Rhs.mk(right)) }

pub fn left(rule: Production) -> I32 {
  rule.>select { Lhs.get }
}

pub fn right(rule: Production) -> Array[Symbol] {
  rule.>select { Rhs.get }
}

pub fn item(rule: I32, position: I32, start: I32) -> Item {
  (Production_index.mk(rule), Dot.mk(position), Origin.mk(start))
}

pub fn rule_index(state: Item) -> I32 {
  state.>select { Production_index.get }
}

pub fn position(state: Item) -> I32 {
  state.>select { Dot.get }
}

pub fn start(state: Item) -> I32 {
  state.>select { Origin.get }
}

pub fn advance(state: Item) -> Item {
  item(
  , state.>select { Production_index.get }
  , arith.add_i32(state.>select { Dot.get }, 1)
  , state.>select { Origin.get }
  )
}

pub fn same(a: Item, b: Item) -> Bool {
  if(numbers.equal(a.>select { Production_index.get }, b.>select { Production_index.get })) {
    if(numbers.equal(a.>select { Dot.get }, b.>select { Dot.get })) {
      numbers.equal(a.>select { Origin.get }, b.>select { Origin.get })
    } else {
      .f
    }
  } else {
    .f
  }
}

pub fn finished(grammar: Grammar, state: Item) -> Bool {
  let rule = arrays.array_get(grammar, state.>select { Production_index.get });
  numbers.equal(state.>select { Dot.get }, arrays.array_len(rule.>select { Rhs.get }))
}

pub fn next(grammar: Grammar, state: Item) -> Symbol {
  let rule = arrays.array_get(grammar, state.>select { Production_index.get });
  arrays.array_get(rule.>select { Rhs.get }, state.>select { Dot.get })
}
