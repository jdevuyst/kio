module earley/closure;

import earley/arrays as numbers;
import earley/chart as chart;
import earley/model as model;
import elab/control(if);
import elab/match(match);
import testapi(Array, Bool, I32);
import testapi/arith as arith;
import testapi/array as arrays;
import testapi/iter(loop);

rec(loop) fn predict(
  , grammar: model.Grammar
  , column: model.Column
  , category: I32
  , position: I32
  , index: I32
  ) -> . {
  if! arith.leq_i32(arrays.array_len(grammar), index) {
    ()
  } else {
    let production = arrays.array_get(grammar, index);
    if! numbers.equal(model.left(production), category) {
      chart.insert(column, model.item(index, 0, position))
    } else {
      ()
    };
    rec predict(grammar, column, category, position, arith.add_i32(index, 1))
  }
}

fn scan(tokens: Array(I32), columns: model.Chart, position: I32, token: I32, state: model.Item) -> . {
  if! arith.leq_i32(arrays.array_len(tokens), position) {
    ()
  } else if! numbers.equal(arrays.array_get(tokens, position), token) {
    chart.insert(arrays.array_get(columns, arith.add_i32(position, 1)), model.advance(state))
  } else {
    ()
  }
}

rec(loop) fn complete_waiters(
  , grammar: model.Grammar
  , origin: model.Column
  , target: model.Column
  , category: I32
  , index: I32
  , limit: I32
  ) -> . {
  if! arith.leq_i32(limit, index) {
    ()
  } else {
    let waiting = arrays.array_get(origin, index);
    if! model.finished(grammar, waiting) {
      ()
    } else match! model.next(grammar, waiting) {
      .(n: model.Nonterminal) {
        if! numbers.equal(model.Nonterminal.get(n), category) {
          chart.insert(target, model.advance(waiting))
        } else {
          ()
        }
      };
      .(_t: model.Terminal) { () }
    };
    rec complete_waiters(grammar, origin, target, category, arith.add_i32(index, 1), limit)
  }
}

fn complete(grammar: model.Grammar, columns: model.Chart, position: I32, state: model.Item) -> . {
  let production = arrays.array_get(grammar, model.rule_index(state));
  let origin = arrays.array_get(columns, model.start(state));
  complete_waiters(
    , grammar
    , origin
    , arrays.array_get(columns, position)
    , model.left(production)
    , 0
    , arrays.array_len(origin)
    )
}

fn process(
  , grammar: model.Grammar
  , tokens: Array(I32)
  , columns: model.Chart
  , position: I32
  , state: model.Item
  ) -> . {
  if! model.finished(grammar, state) {
    complete(grammar, columns, position, state)
  } else match! model.next(grammar, state) {
    .(n: model.Nonterminal) {
      predict(grammar, arrays.array_get(columns, position), model.Nonterminal.get(n), position, 0)
    };
    .(t: model.Terminal) { scan(tokens, columns, position, model.Terminal.get(t), state) }
  }
}

rec(loop) fn sweep(
  , grammar: model.Grammar
  , tokens: Array(I32)
  , columns: model.Chart
  , position: I32
  , index: I32
  , limit: I32
  ) -> . {
  if! arith.leq_i32(limit, index) {
    ()
  } else {
    process(
      , grammar
      , tokens
      , columns
      , position
      , arrays.array_get(arrays.array_get(columns, position), index)
      );
    rec sweep(grammar, tokens, columns, position, arith.add_i32(index, 1), limit)
  }
}

pub rec(loop) fn close(
  , grammar: model.Grammar
  , tokens: Array(I32)
  , columns: model.Chart
  , position: I32
  ) -> . {
  let column = arrays.array_get(columns, position);
  let before = arrays.array_len(column);
  sweep(grammar, tokens, columns, position, 0, before);
  if! numbers.equal(before, arrays.array_len(column)) {
    ()
  } else {
    // A nullable completion may precede a waiter added during this sweep.
    rec close(grammar, tokens, columns, position)
  }
}
