module earley/arrays;

import elab/control(if);
import testapi(Array, Bool, I32);
import testapi/arith as arith;
import testapi/array as arrays;
import testapi/iter(loop);

pub fn equal(a: I32, b: I32) -> Bool {
  if! arith.leq_i32(a, b) {
    arith.leq_i32(b, a)
  } else {
    .f
  }
}

pub fn empty[A]() -> Array(A) { arrays.array_make_empty() }

pub fn append[A](items: Array(A), item: A) -> Array(A) { arrays.array_push(items, item); items }

pub varop [* *] { foldl append empty }

rec(loop) fn reverse_range[A](items: Array(A), left: I32, right: I32) -> Array(A) {
  if! arith.leq_i32(right, left) {
    items
  } else {
    arrays.array_swap(items, left, right);
    rec reverse_range(items, arith.add_i32(left, 1), arith.sub_i32(right, 1))
  }
}

pub fn reversed[A](items: Array(A)) -> Array(A) {
  reverse_range(arrays.array_clone(items), 0, arith.sub_i32(arrays.array_len(items), 1))
}
