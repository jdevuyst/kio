/// The 2-3 tree's data: one key and two children, or two keys and three, or a
/// leaf.
///
/// Nothing in this type says every leaf sits at the same depth. That is a
/// runtime property of a value, not a fact the shape carries — and encoding it
/// in the type would make the audit vacuous, which is the one check this
/// package exists to perform.
mod tree/node;

import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn add_i32; fn eq_i32; fn lt_i32 }
import testapi/iter { fn loop }

rec {
  pub type Node_body =
    | { Leaf: . }
    | { Two: Node & I32 & String & Node }
    | { Three: Node & I32 & String & Node & I32 & String & Node };
  pub type { Node: Node_body { mk; pub get } }
}

/// The tree handle: a root plus the size the program *claims* the tree holds.
/// Storing the size is what gives the audit something to disagree with — a
/// rebalance that drops or duplicates a key shows up here first.
pub type { Tree: Node & I32 { mk; get } }

pub fn leaf_node() -> Node { Node.mk((Leaf.mk(()).>widen_sum)[Node_body]) }

pub fn two_node(l: Node, k: I32, v: String, r: Node) -> Node {
  Node.mk((Two.mk((l, k, v, r)).>widen_sum)[Node_body])
}

pub fn three_node(l: Node, k1: I32, v1: String, m: Node, k2: I32, v2: String, r: Node) -> Node {
  Node.mk((Three.mk((l, k1, v1, m, k2, v2, r)).>widen_sum)[Node_body])
}

pub fn make_tree(root: Node, size: I32) -> Tree { Tree.mk((root, size)) }

pub fn empty_tree() -> Tree { make_tree(leaf_node(), 0) }

pub fn root_of(t: Tree) -> Node { let .(r: Node, _n: I32) = t.>Tree.get; r }

pub fn size_of(t: Tree) -> I32 { let .(_r: Node, n: I32) = t.>Tree.get; n }

pub fn is_leaf(t: Node) -> Bool {
  match(t.>Node.get) {
    (.(_e: Leaf) { .t }, .(_two: Two) { .f }, .(_three: Three) { .f })
  }
}

pub fn and(a: Bool, b: Bool) -> Bool {
  if(a) { b } else { .f }
}

fn max2(a: I32, b: I32) -> I32 {
  if(lt_i32(a, b)) { b } else { a }
}

/// The longest root-to-leaf path. Taken as a maximum over the children rather
/// than by following one of them, so a tree whose leaves have drifted to
/// different depths still reports a height the audit can contradict.
pub rec(loop) fn height(t: Node) -> I32 {
  match(t.>Node.get) {
    (
    , .(_e: Leaf) { 0 }
    , .(n: Two) {
        let .(l: Node, _k: I32, _v: String, r: Node) = n.>select { Two.get };
        let hl = recur(cont) height(l);
        let hr = recur(cont) height(r);
        add_i32(1, max2(hl, hr))
      }
    , .(n: Three) {
        let .(l: Node, _k1: I32, _v1: String, m: Node, _k2: I32, _v2: String, r: Node) =
          n.>select { Three.get };
        let hl = recur(cont) height(l);
        let hm = recur(cont) height(m);
        let hr = recur(cont) height(r);
        add_i32(1, max2(hl, max2(hm, hr)))
      }
    )
  }
}

type Found = { Payload: String } | { Absent: . };

fn found(v: String) -> Found { (Payload.mk(v).>widen_sum)[Found] }

fn not_found() -> Found { (Absent.mk(()).>widen_sum)[Found] }

/// Search. The only descent in the package that never rebuilds anything, so
/// it is the only one that is a plain tail recursion.
rec(loop) fn lookup(t: Node, k: I32) -> Found {
  match(t.>Node.get) {
    (
    , .(_e: Leaf) { not_found() }
    , .(n: Two) {
        let .(l: Node, k1: I32, v1: String, r: Node) = n.>select { Two.get };
        if(eq_i32(k, k1)) {
          found(v1)
        } else if(lt_i32(k, k1)) {
          recur lookup(l, k)
        } else {
          recur lookup(r, k)
        }
      }
    , .(n: Three) {
        let .(l: Node, k1: I32, v1: String, m: Node, k2: I32, v2: String, r: Node) =
          n.>select { Three.get };
        if(eq_i32(k, k1)) {
          found(v1)
        } else if(eq_i32(k, k2)) {
          found(v2)
        } else if(lt_i32(k, k1)) {
          recur lookup(l, k)
        } else if(lt_i32(k, k2)) {
          recur lookup(m, k)
        } else {
          recur lookup(r, k)
        }
      }
    )
  }
}

pub fn contains(t: Node, k: I32) -> Bool {
  match(lookup(t, k)) {
    (.(_p: Payload) { .t }, .(_a: Absent) { .f })
  }
}
