/// The FORGE-4 instruction set.
///
/// FORGE-4 is a four-register accumulator machine with an operand stack.
/// Every arithmetic opcode is two-address - it reads both operands and
/// writes the destination register - and the only control flow is an
/// unconditional jump and a jump-if-zero.
///
/// The set is declared twice, once per assembler phase. `Src` is what a
/// program is written in: its jumps name a label. `Ins` is what the
/// machine runs: its jumps carry an address. The eleven opcodes that
/// never mention a jump target share the same nominal types in both
/// declarations, so `Loadi` in a `Src` and `Loadi` in an `Ins` are
/// the same nominal type. Pass two of the
/// assembler therefore carries an untouched opcode straight across with
/// `widen_sum` and rebuilds only the two jumps.
module forge/isa;

import macros/match(macro match);
import macros/spine_macros(macro widen_sum);
import testapi(I32, String);

/// The four general registers, as a selector. `forge/vm` holds their
/// values in a separate labeled record; this sum only says *which* one an
/// instruction names.
pub type Reg = { Ra: . } | { Rb: . } | { Rc: . } | { Rd: . };

pub fn ra() -> Reg { (Ra.mk(()).>widen_sum)[Reg] }

pub fn rb() -> Reg { (Rb.mk(()).>widen_sum)[Reg] }

pub fn rc() -> Reg { (Rc.mk(()).>widen_sum)[Reg] }

pub fn rd() -> Reg { (Rd.mk(()).>widen_sum)[Reg] }

/// The assembly-language name of a register, as it appears in a listing.
pub fn reg_name(r: Reg) -> String {
  match(r) {
    (.(_a: Ra) { "a" }, .(_b: Rb) { "b" }, .(_c: Rc) { "c" }, .(_d: Rd) { "d" })
  }
}

/// A source instruction, as written in a program: `jmp` and `jmpz` name a
/// label that pass one has not yet placed.
pub type Src =
  | { Loadi: Reg & I32 }
  | { Mov: Reg & Reg }
  | { Add: Reg & Reg }
  | { Sub: Reg & Reg }
  | { Mul: Reg & Reg }
  | { Div: Reg & Reg }
  | { Mod: Reg & Reg }
  | { Push: Reg }
  | { Pop: Reg }
  | { Emit: Reg }
  | { Halt: . }
  | { Jmp: String }
  | { Jmpz: Reg & String }
  ;

/// A resolved instruction, as the machine runs it. The eleven shared entries
/// use the nominals `Src` declared above; only the jumps differ, and
/// they carry a program address.
pub type Ins =
  | Loadi
  | Mov
  | Add
  | Sub
  | Mul
  | Div
  | Mod
  | Push
  | Pop
  | Emit
  | Halt
  | { Jmp_addr: I32 }
  | { Jmpz_addr: Reg & I32 }
  ;

pub fn loadi(r: Reg, n: I32) -> Src { (Loadi.mk((r, n)).>widen_sum)[Src] }

pub fn mov(dst: Reg, src: Reg) -> Src { (Mov.mk((dst, src)).>widen_sum)[Src] }

pub fn add(dst: Reg, src: Reg) -> Src { (Add.mk((dst, src)).>widen_sum)[Src] }

pub fn sub(dst: Reg, src: Reg) -> Src { (Sub.mk((dst, src)).>widen_sum)[Src] }

pub fn mul(dst: Reg, src: Reg) -> Src { (Mul.mk((dst, src)).>widen_sum)[Src] }

pub fn div(dst: Reg, src: Reg) -> Src { (Div.mk((dst, src)).>widen_sum)[Src] }

pub fn mod(dst: Reg, src: Reg) -> Src { (Mod.mk((dst, src)).>widen_sum)[Src] }

pub fn push(r: Reg) -> Src { (Push.mk(r).>widen_sum)[Src] }

pub fn pop(r: Reg) -> Src { (Pop.mk(r).>widen_sum)[Src] }

pub fn emit(r: Reg) -> Src { (Emit.mk(r).>widen_sum)[Src] }

pub fn halt() -> Src { (Halt.mk(()).>widen_sum)[Src] }

pub fn jmp(target: String) -> Src { (Jmp.mk(target).>widen_sum)[Src] }

pub fn jmpz(r: Reg, target: String) -> Src { (Jmpz.mk((r, target)).>widen_sum)[Src] }

/// A resolved unconditional jump. Only pass two builds these.
pub fn jmp_at(addr: I32) -> Ins { (Jmp_addr.mk(addr).>widen_sum)[Ins] }

/// A resolved jump-if-zero. Only pass two builds these.
pub fn jmpz_at(r: Reg, addr: I32) -> Ins { (Jmpz_addr.mk((r, addr)).>widen_sum)[Ins] }
