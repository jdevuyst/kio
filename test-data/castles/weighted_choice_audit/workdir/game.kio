mod game;

import choice as choice;
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32 }
import testapi/arith as arith;

pub type Loot = { Blade: I32 } | { Bow: I32 } | { Coins: I32 };

pub type Loadout = { Attack: I32; Treasure: I32 };

fn blade_drop() -> Loot { Blade.mk(2).>widen_sum }

fn bow_drop() -> Loot { Bow.mk(3).>widen_sum }

fn coin_drop() -> Loot { Coins.mk(5).>widen_sum }

pub fn loot() -> choice.Choice[Loot] {
  choice.weighted(blade_drop(), 2)
    .>choice.alternative(choice.certain(bow_drop()))
    .>choice.alternative(choice.certain(coin_drop()))
}

pub fn charms() -> choice.Choice[I32] {
  choice.weighted(0, 2).>choice.alternative(choice.certain(1))
}

pub fn equip(item: Loot, bonus: I32) -> Loadout {
  match(item) {
    .(blade: Blade) { (Attack.mk(arith.add_i32(Blade.get(blade), bonus)), Treasure.mk(0)) };
    .(bow: Bow) { (Attack.mk(arith.add_i32(Bow.get(bow), bonus)), Treasure.mk(0)) };
    .(coins: Coins) { (Attack.mk(bonus), Treasure.mk(Coins.get(coins))) }
  }
}

pub fn loadouts() -> choice.Choice[Loadout] { choice.independent(loot(), charms(), equip) }

pub fn attack_score(loadout: Loadout) -> I32 {
  loadout.>select { Attack.get }
}

pub fn treasure_value(loadout: Loadout) -> I32 {
  loadout.>select { Treasure.get }
}

pub fn ready(loadout: Loadout) -> Bool {
  arith.leq_i32(3, loadout.>select { Attack.get })
}

pub fn guaranteed() -> choice.Choice[Loadout] {
  choice.independent(choice.certain(blade_drop()), choice.certain(1), equip)
}
