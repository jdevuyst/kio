module testapi/main;

import choice as choice;
import game as game;
import list/list(varop [* *]);
import report as report;
import testapi(I32);
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/io as io;

pub fn main() {
  let loadouts = game.loadouts();
  let attacks = loadouts.>choice.map(game.attack_score);
  let scores = [* 0, 1, 2, 3, 4 *];
  let ready = loadouts.>choice.condition(game.ready);
  io.print("weighted loot and charm audit\n");
  report.integer_distribution("attack", attacks, scores);
  report.integer_distribution("treasure", loadouts.>choice.map(game.treasure_value), [* 0, 5 *]);
  report.integer_distribution("ready attack", ready.>choice.map(game.attack_score), scores);
  report.fraction("ready multiplicity=", choice.total(ready), choice.total(loadouts));
  report.distribution(
  , "readiness"
  , loadouts.>choice.map(game.ready)
  , [* .f, .t *]
  , report.bool_equal
  , fmt.bool_to_string
  );
  report.integer_distribution(
  , "guaranteed attack"
  , game.guaranteed().>choice.map(game.attack_score)
  , [* 3 *]
  );
  report.integer_distribution("empty attack", choice.empty(_), scores);
  report.count(
  , "empty left total="
  , choice.independent(choice.empty(_), game.charms(), game.equip).>choice.total
  );
  report.count(
  , "empty right total="
  , choice.independent(game.loot(), choice.empty(_), game.equip).>choice.total
  );
  report.count(
  , "impossible condition total="
  , attacks.>choice.condition(.(attack) { arith.lt_i32(9, attack) }).>choice.total
  )
}
