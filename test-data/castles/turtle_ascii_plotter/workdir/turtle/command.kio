/// The parsed turtle program: a command tree, not a command stream.
///
/// `repeat` carries its whole body, so the tree records the nesting the source
/// spelled out and the interpreter never rediscovers a matching `end`. A body
/// is the public generic list package instantiated at `Command`, the same
/// collection representation the canvas uses for rows and cells.
mod turtle/command;

import list/core as list;
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }

pub type { Pen_cmd: Bool }

pub type { Move_cmd: I32 }

pub type { Turn_cmd: Bool }

pub type { Goto_cmd: I32 & I32 }

pub type { Mark_cmd: I32 }

pub type { Unknown_cmd: String }

rec {
  pub type { Repeat_cmd: I32 & list.List[Command] };
  pub type {
    Command: Pen_cmd | Move_cmd | Turn_cmd | Goto_cmd | Mark_cmd | Repeat_cmd | Unknown_cmd
  }
}

pub type Command_shape =
  Pen_cmd | Move_cmd | Turn_cmd | Goto_cmd | Mark_cmd | Repeat_cmd | Unknown_cmd
  ;

/// Open one command node for structural dispatch.
pub fn un_command(c: Command) -> Command_shape {
  c.>select { Command.get }
}

/// `pen down` when `down` is set, `pen up` otherwise.
pub fn pen(down: Bool) -> Command { Command.mk((Pen_cmd.mk(down).>widen_sum)[Command_shape]) }

/// Advance `n` cells along the current heading.
pub fn move(n: I32) -> Command { Command.mk((Move_cmd.mk(n).>widen_sum)[Command_shape]) }

/// `turn right` when `right` is set, `turn left` otherwise.
pub fn turn(right: Bool) -> Command { Command.mk((Turn_cmd.mk(right).>widen_sum)[Command_shape]) }

/// Teleport to `(x, y)`.
pub fn goto(x: I32, y: I32) -> Command {
  Command.mk((Goto_cmd.mk((x, y)).>widen_sum)[Command_shape])
}

/// Stamp the current cell with glyph code `code`.
pub fn mark(code: I32) -> Command { Command.mk((Mark_cmd.mk(code).>widen_sum)[Command_shape]) }

/// Run `body` `n` times.
pub fn repeat(n: I32, body: list.List[Command]) -> Command {
  Command.mk((Repeat_cmd.mk((n, body)).>widen_sum)[Command_shape])
}

/// A word the parser did not recognise, kept verbatim so the echo can show
/// exactly what the source said.
pub fn unknown(word: String) -> Command {
  Command.mk((Unknown_cmd.mk(word).>widen_sum)[Command_shape])
}
