/// The parsed turtle program: a command tree, not a command stream.
///
/// `repeat` carries its whole body, so the tree records the nesting the source
/// spelled out and the interpreter never rediscovers a matching `end`. A body
/// is the public generic list package instantiated at `Command`, the same
/// collection representation the canvas uses for rows and cells.
module turtle/command;

import elab/spine_elaborators(widen_sum);
import list/core as list;
import testapi(Bool, I32, String);

pub labels { pen_cmd: Bool };

pub labels { move_cmd: I32 };

pub labels { turn_cmd: Bool };

pub labels { goto_cmd: I32 & I32 };

pub labels { mark_cmd: I32 };

pub labels { unknown_cmd: String };

rec {
  pub labels { repeat_cmd: I32 & list.List(Command) };
  pub labels { command: | Pen_cmd
  | Move_cmd
  | Turn_cmd
  | Goto_cmd
  | Mark_cmd
  | Repeat_cmd
  | Unknown_cmd }
}

pub type Command_shape =
  Pen_cmd | Move_cmd | Turn_cmd | Goto_cmd | Mark_cmd | Repeat_cmd | Unknown_cmd
  ;

/// Open one command node for structural dispatch.
pub fn un_command(c: Command) -> Command_shape { c.?{command} }

/// `pen down` when `down` is set, `pen up` otherwise.
pub fn pen(down: Bool) -> Command { {command = {pen_cmd = down}.>widen_sum!(Command_shape)} }

/// Advance `n` cells along the current heading.
pub fn move(n: I32) -> Command { {command = {move_cmd = n}.>widen_sum!(Command_shape)} }

/// `turn right` when `right` is set, `turn left` otherwise.
pub fn turn(right: Bool) -> Command { {command = {turn_cmd = right}.>widen_sum!(Command_shape)} }

/// Teleport to `(x, y)`.
pub fn goto(x: I32, y: I32) -> Command {
  {command = {goto_cmd = (x, y)}.>widen_sum!(Command_shape)}
}

/// Stamp the current cell with glyph code `code`.
pub fn mark(code: I32) -> Command { {command = {mark_cmd = code}.>widen_sum!(Command_shape)} }

/// Run `body` `n` times.
pub fn repeat(n: I32, body: list.List(Command)) -> Command {
  {command = {repeat_cmd = (n, body)}.>widen_sum!(Command_shape)}
}

/// A word the parser did not recognise, kept verbatim so the echo can show
/// exactly what the source said.
pub fn unknown(word: String) -> Command {
  {command = {unknown_cmd = word}.>widen_sum!(Command_shape)}
}
