/// The turtle and the paper it draws on, threaded through the interpreter as
/// one value.
///
/// The turtle walks an unbounded integer plane; the canvas is only the window
/// onto it. Motion is never blocked — a stroke may run off the paper, keep
/// going, and come back to draw again — so the plotter clips *ink*, not
/// movement. That is what a rasterizer does, and it is why the state carries a
/// clip counter rather than a bounds check on the position.
mod turtle/state;

import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select; macro with }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn add_i32 }
import turtle/canvas as canvas;

/// Which way the turtle faces. Row 0 is the top of the plot, so `north` walks
/// toward smaller `y`.
pub type Facing = { North: . } | { East: . } | { South: . } | { West: . };

fn north_facing() -> Facing { (North.mk(()).>widen_sum)[Facing] }

fn east_facing() -> Facing { (East.mk(()).>widen_sum)[Facing] }

fn south_facing() -> Facing { (South.mk(()).>widen_sum)[Facing] }

fn west_facing() -> Facing { (West.mk(()).>widen_sum)[Facing] }

pub fn facing_name(f: Facing) -> String {
  match(f) {
    (.(_n: North) { "N" }, .(_e: East) { "E" }, .(_s: South) { "S" }, .(_w: West) { "W" })
  }
}

/// The horizontal component of one step along `f`.
pub fn facing_dx(f: Facing) -> I32 {
  match(f) {
    (.(_n: North) { 0 }, .(_e: East) { 1 }, .(_s: South) { 0 }, .(_w: West) { -1 })
  }
}

/// The vertical component of one step along `f`.
pub fn facing_dy(f: Facing) -> I32 {
  match(f) {
    (.(_n: North) { -1 }, .(_e: East) { 0 }, .(_s: South) { 1 }, .(_w: West) { 0 })
  }
}

pub fn turn_right(f: Facing) -> Facing {
  match(f) {
    (
    , .(_n: North) { east_facing() }
    , .(_e: East) { south_facing() }
    , .(_s: South) { west_facing() }
    , .(_w: West) { north_facing() }
    )
  }
}

pub fn turn_left(f: Facing) -> Facing {
  match(f) {
    (
    , .(_n: North) { west_facing() }
    , .(_e: East) { north_facing() }
    , .(_s: South) { east_facing() }
    , .(_w: West) { south_facing() }
    )
  }
}

/// The whole interpreter state: the paper, the turtle, and the two counters
/// the report reads back.
pub type State = {
  Paper: canvas.Canvas;
  Width: I32;
  Height: I32;
  Tx: I32;
  Ty: I32;
  Heading: Facing;
  Down: Bool;
  Executed: I32;
  Clipped: I32
};

/// The turtle before the first command: origin of a blank canvas, facing east,
/// pen up.
pub fn start_state(w: I32, h: I32) -> State {
  (
  , Paper.mk(canvas.blank(w, h))
  , Width.mk(w)
  , Height.mk(h)
  , Tx.mk(0)
  , Ty.mk(0)
  , Heading.mk(east_facing())
  , Down.mk(.f)
  , Executed.mk(0)
  , Clipped.mk(0)
  )
}

pub fn paper_of(s: State) -> canvas.Canvas {
  s.>select { Paper.get }
}

pub fn width_of(s: State) -> I32 {
  s.>select { Width.get }
}

pub fn height_of(s: State) -> I32 {
  s.>select { Height.get }
}

pub fn tx_of(s: State) -> I32 {
  s.>select { Tx.get }
}

pub fn ty_of(s: State) -> I32 {
  s.>select { Ty.get }
}

pub fn heading_of(s: State) -> Facing {
  s.>select { Heading.get }
}

pub fn down_of(s: State) -> Bool {
  s.>select { Down.get }
}

pub fn executed_of(s: State) -> I32 {
  s.>select { Executed.get }
}

pub fn clipped_of(s: State) -> I32 {
  s.>select { Clipped.get }
}

/// Each update is its own named function because a row update reorders the
/// product it rebuilds; the declared `State` return type is what puts the
/// fields back in the order every other reader expects.
pub fn with_paper(s: State, cv: canvas.Canvas) -> State {
  s.>with { Paper.mk(cv) }
}

pub fn with_pos(s: State, x: I32, y: I32) -> State {
  s.>with { Tx.mk(x); Ty.mk(y) }
}

pub fn with_heading(s: State, f: Facing) -> State {
  s.>with { Heading.mk(f) }
}

pub fn with_pen(s: State, d: Bool) -> State {
  s.>with { Down.mk(d) }
}

/// One more command executed.
pub fn tick(s: State) -> State {
  s.>with {
    Executed.mk(add_i32(s.>select { Executed.get }, 1))
  }
}

/// One more dab of ink discarded for landing off the paper.
pub fn clip(s: State) -> State {
  s.>with {
    Clipped.mk(add_i32(s.>select { Clipped.get }, 1))
  }
}

pub fn pen_name(d: Bool) -> String {
  if(d) { "down" } else { "up" }
}
