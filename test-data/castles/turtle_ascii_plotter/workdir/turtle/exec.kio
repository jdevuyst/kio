/// Phase two: run the tree.
///
/// Every command is a pure state transition. `repeat` is the only one that
/// re-enters the interpreter, and it does so on a block the parser already
/// built — so execution walks a tree and never looks at a line of source
/// again.
///
/// One rule governs the paper: an ink operation whose target cell lies outside
/// the canvas is discarded and counted as clipped. That covers a stroke running
/// past an edge, a `mark` outside the frame, and a pen put down off-canvas,
/// with no special case for any of them.
module turtle/exec;

import elab/control(if);
import elab/match(match);
import list/core as list;
import testapi(Bool, I32);
import testapi/arith(add_i32, leq_i32, sub_i32);
import testapi/iter(loop);
import turtle/canvas as canvas;
import turtle/command as cmd;
import turtle/glyph as glyph;
import turtle/state as st;

/// Lay one dab of ink at `(x, y)`, or clip it.
fn put(s: st.State, x: I32, y: I32, code: I32) -> st.State {
  if! canvas.on_canvas(st.width_of(s), st.height_of(s), x, y) {
    st.with_paper(s, canvas.ink(st.paper_of(s), x, y, code))
  } else {
    st.clip(s)
  }
}

/// Ink the cell the turtle stands on, if the pen is down. Every motion ends in
/// a `touch`, which is what makes "the turtle's cell carries ink while the pen
/// is down" true after every command instead of only after a `move`.
fn touch(s: st.State) -> st.State {
  if! st.down_of(s) {
    put(s, st.tx_of(s), st.ty_of(s), glyph.stroke_code())
  } else {
    s
  }
}

/// Lowering the pen puts it on the paper where the turtle already stands.
fn do_pen(s: st.State, down: Bool) -> st.State { touch(st.with_pen(s, down)) }

/// A `goto` is a teleport: it draws no line between the old cell and the new
/// one. The pen still marks where it lands.
fn do_goto(s: st.State, x: I32, y: I32) -> st.State { touch(st.with_pos(s, x, y)) }

/// A `mark` stamps the turtle's cell whatever the pen is doing — that is how a
/// program puts a landmark on a blank cell, and how `mark 0` rubs one out.
fn do_mark(s: st.State, code: I32) -> st.State { put(s, st.tx_of(s), st.ty_of(s), code) }

fn do_turn(s: st.State, right: Bool) -> st.State {
  if! right {
    st.with_heading(s, st.turn_right(st.heading_of(s)))
  } else {
    st.with_heading(s, st.turn_left(st.heading_of(s)))
  }
}

/// Step one cell along the heading, `n` times, inking each cell entered. The
/// turtle is never stopped by an edge — it keeps walking, its ink is clipped
/// while it is away, and the drawing picks up again where it walks back on.
rec(loop) fn do_move(s: st.State, n: I32) -> st.State {
  if! leq_i32(n, 0) {
    s
  } else {
    let f = st.heading_of(s);
    let nx = add_i32(st.tx_of(s), st.facing_dx(f));
    let ny = add_i32(st.ty_of(s), st.facing_dy(f));
    rec do_move(touch(st.with_pos(s, nx, ny)), sub_i32(n, 1))
  }
}

rec(loop) {
  /// Run every command of `b`, in order.
  pub fn run_block(b: list.List(cmd.Command), s: st.State) -> st.State {
    match! list.uncons(b) {
      (
        , .(c: cmd.Command, rest: list.List(cmd.Command)) {
            let next = rec(cont) run_command(c, s);
            rec run_block(rest, next)
          }
        , .(_empty: .) { s }
        )
    }
  };
  /// One command. Each arm `tick`s the executed-command counter except
  /// `repeat`, which is control structure rather than a stroke of the pen: the
  /// commands inside its body count themselves, once per pass.
  fn run_command(c: cmd.Command, s: st.State) -> st.State {
    match! cmd.un_command(c) {
      (
        , .(p: cmd.Pen_cmd) { do_pen(st.tick(s), p.?{cmd.pen_cmd}) }
        , .(m: cmd.Move_cmd) { do_move(st.tick(s), m.?{cmd.move_cmd}) }
        , .(t: cmd.Turn_cmd) { do_turn(st.tick(s), t.?{cmd.turn_cmd}) }
        , .(g: cmd.Goto_cmd) {
            let .(x: I32, y: I32) = g.?{cmd.goto_cmd};
            do_goto(st.tick(s), x, y)
          }
        , .(k: cmd.Mark_cmd) { do_mark(st.tick(s), k.?{cmd.mark_cmd}) }
        , .(r: cmd.Repeat_cmd) {
            let .(n: I32, body: list.List(cmd.Command)) = r.?{cmd.repeat_cmd};
            rec run_repeat(n, body, s)
          }
        , .(_u: cmd.Unknown_cmd) { st.tick(s) }
        )
    }
  };
  /// Run `body` `n` times, threading the state through each pass. A count of
  /// zero or less runs it no times at all.
  fn run_repeat(n: I32, body: list.List(cmd.Command), s: st.State) -> st.State {
    if! leq_i32(n, 0) {
      s
    } else {
      let next = rec(cont) run_block(body, s);
      rec run_repeat(sub_i32(n, 1), body, next)
    }
  }
}
