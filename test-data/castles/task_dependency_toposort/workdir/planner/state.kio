mod planner/state;

import macros/control { macro if }
import macros/row_macros { macro select }
import planner/tasks { fn task_effort; fn task_name }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn add_i32; fn eq_i32 }
import testapi/text { fn string_concat }

pub type Plan_state = {
  Fetched: Bool;
  Schema_done: Bool;
  Core_done: Bool;
  Js_done: Bool;
  Rust_done: Bool;
  Bundle_done: Bool;
  Notes_done: Bool;
  Order_text: String;
  Completed_count: I32;
  Effort_score: I32
};

fn build_state(
, fetched: Bool
, schema_done: Bool
, core_done: Bool
, js_done: Bool
, rust_done: Bool
, bundle_done: Bool
, notes_done: Bool
, order_text: String
, completed_count: I32
, effort_score: I32
) -> Plan_state {
  (
  , Fetched.mk(fetched)
  , Schema_done.mk(schema_done)
  , Core_done.mk(core_done)
  , Js_done.mk(js_done)
  , Rust_done.mk(rust_done)
  , Bundle_done.mk(bundle_done)
  , Notes_done.mk(notes_done)
  , Order_text.mk(order_text)
  , Completed_count.mk(completed_count)
  , Effort_score.mk(effort_score)
  )
}

pub fn empty() -> Plan_state { build_state(.f, .f, .f, .f, .f, .f, .f, "order:\n", 0, 0) }

pub fn completed(plan: Plan_state) -> I32 {
  plan.>select { Completed_count.get }
}

pub fn effort(plan: Plan_state) -> I32 {
  plan.>select { Effort_score.get }
}

pub fn order(plan: Plan_state) -> String {
  plan.>select { Order_text.get }
}

fn append_order(current: String, task: I32) -> String {
  string_concat(string_concat(current, "  -> "), string_concat(task_name(task), "\n"))
}

fn next_completed(plan: Plan_state) -> I32 {
  add_i32(plan.>select { Completed_count.get }, 1)
}

fn next_effort(plan: Plan_state, task: I32) -> I32 {
  add_i32(plan.>select { Effort_score.get }, task_effort(task))
}

pub fn is_done(plan: Plan_state, task: I32) -> Bool {
  if(eq_i32(task, 0)) {
    plan.>select { Fetched.get }
  } else if(eq_i32(task, 1)) {
    plan.>select { Schema_done.get }
  } else if(eq_i32(task, 2)) {
    plan.>select { Core_done.get }
  } else if(eq_i32(task, 3)) {
    plan.>select { Js_done.get }
  } else if(eq_i32(task, 4)) {
    plan.>select { Rust_done.get }
  } else if(eq_i32(task, 5)) {
    plan.>select { Bundle_done.get }
  } else if(eq_i32(task, 6)) {
    plan.>select { Notes_done.get }
  } else {
    .f
  }
}

fn marked(
, plan: Plan_state
, task: I32
, fetched: Bool
, schema_done: Bool
, core_done: Bool
, js_done: Bool
, rust_done: Bool
, bundle_done: Bool
, notes_done: Bool
) -> Plan_state {
  build_state(
  , fetched
  , schema_done
  , core_done
  , js_done
  , rust_done
  , bundle_done
  , notes_done
  , append_order(plan.>select { Order_text.get }, task)
  , next_completed(plan)
  , next_effort(plan, task)
  )
}

pub fn mark_done(plan: Plan_state, task: I32) -> Plan_state {
  if(eq_i32(task, 0)) {
    marked(
    , plan
    , task
    , .t
    , plan.>select { Schema_done.get }
    , plan.>select { Core_done.get }
    , plan.>select { Js_done.get }
    , plan.>select { Rust_done.get }
    , plan.>select { Bundle_done.get }
    , plan.>select { Notes_done.get }
    )
  } else if(eq_i32(task, 1)) {
    marked(
    , plan
    , task
    , plan.>select { Fetched.get }
    , .t
    , plan.>select { Core_done.get }
    , plan.>select { Js_done.get }
    , plan.>select { Rust_done.get }
    , plan.>select { Bundle_done.get }
    , plan.>select { Notes_done.get }
    )
  } else if(eq_i32(task, 2)) {
    marked(
    , plan
    , task
    , plan.>select { Fetched.get }
    , plan.>select { Schema_done.get }
    , .t
    , plan.>select { Js_done.get }
    , plan.>select { Rust_done.get }
    , plan.>select { Bundle_done.get }
    , plan.>select { Notes_done.get }
    )
  } else if(eq_i32(task, 3)) {
    marked(
    , plan
    , task
    , plan.>select { Fetched.get }
    , plan.>select { Schema_done.get }
    , plan.>select { Core_done.get }
    , .t
    , plan.>select { Rust_done.get }
    , plan.>select { Bundle_done.get }
    , plan.>select { Notes_done.get }
    )
  } else if(eq_i32(task, 4)) {
    marked(
    , plan
    , task
    , plan.>select { Fetched.get }
    , plan.>select { Schema_done.get }
    , plan.>select { Core_done.get }
    , plan.>select { Js_done.get }
    , .t
    , plan.>select { Bundle_done.get }
    , plan.>select { Notes_done.get }
    )
  } else if(eq_i32(task, 5)) {
    marked(
    , plan
    , task
    , plan.>select { Fetched.get }
    , plan.>select { Schema_done.get }
    , plan.>select { Core_done.get }
    , plan.>select { Js_done.get }
    , plan.>select { Rust_done.get }
    , .t
    , plan.>select { Notes_done.get }
    )
  } else if(eq_i32(task, 6)) {
    marked(
    , plan
    , task
    , plan.>select { Fetched.get }
    , plan.>select { Schema_done.get }
    , plan.>select { Core_done.get }
    , plan.>select { Js_done.get }
    , plan.>select { Rust_done.get }
    , plan.>select { Bundle_done.get }
    , .t
    )
  } else {
    plan
  }
}
