module ledger_rule_audit/state;

import testapi(I32);
import testapi/arith as arith;

pub labels Ledger = {
  , balance: I32
  , credit_count: I32
  , debit_count: I32
  , fee_count: I32
  , invalid_count: I32
  , credit_total: I32
  , debit_total: I32
  , fee_total: I32
  };

pub fn empty() -> Ledger {
  {
    , balance = 0
    , credit_count = 0
    , debit_count = 0
    , fee_count = 0
    , invalid_count = 0
    , credit_total = 0
    , debit_total = 0
    , fee_total = 0
    }
}

pub fn credit(state: Ledger, amount: I32) -> Ledger {
  let .({balance, credit_count, credit_total}) = state;
  state.!{
    , balance = arith.add_i32(balance, amount)
    , credit_count = arith.add_i32(credit_count, 1)
    , credit_total = arith.add_i32(credit_total, amount)
    }
}

pub fn debit(state: Ledger, amount: I32) -> Ledger {
  let .({balance, debit_count, debit_total}) = state;
  state.!{
    , balance = arith.sub_i32(balance, amount)
    , debit_count = arith.add_i32(debit_count, 1)
    , debit_total = arith.add_i32(debit_total, amount)
    }
}

pub fn fee(state: Ledger, amount: I32) -> Ledger {
  let .({balance, fee_count, fee_total}) = state;
  state.!{
    , balance = arith.sub_i32(balance, amount)
    , fee_count = arith.add_i32(fee_count, 1)
    , fee_total = arith.add_i32(fee_total, amount)
    }
}

pub fn invalid(state: Ledger) -> Ledger {
  let .({invalid_count}) = state;
  state.!{invalid_count = arith.add_i32(invalid_count, 1)}
}

pub fn balance_value(state: Ledger) -> I32 { state.?{balance} }

pub fn credit_count_value(state: Ledger) -> I32 { state.?{credit_count} }

pub fn debit_count_value(state: Ledger) -> I32 { state.?{debit_count} }

pub fn fee_count_value(state: Ledger) -> I32 { state.?{fee_count} }

pub fn invalid_count_value(state: Ledger) -> I32 { state.?{invalid_count} }

pub fn credit_total_value(state: Ledger) -> I32 { state.?{credit_total} }

pub fn debit_total_value(state: Ledger) -> I32 { state.?{debit_total} }

pub fn fee_total_value(state: Ledger) -> I32 { state.?{fee_total} }
