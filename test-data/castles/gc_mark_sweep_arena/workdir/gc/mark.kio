/// The mark phase. Reachability is a worklist walk, never a recursive
/// descent into the heap: the roots seed an explicit `Array(I32)`
/// stack, and each pop either marks a fresh object and pushes its
/// pointer fields or drops one already marked. A cycle therefore costs
/// one extra pop instead of unbounded stack depth, and a shared object
/// is traced once however many parents reach it.
mod gc/mark;

import gc/heap { fn field_slot; fn fold_fields; fn top }
import gc/num { fn int_lt }
import gc/slot { type Imm; type Ptr }
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import testapi { type Array; type Bool; type I32 }
import testapi/arith { fn add_i32 }
import testapi/array {
  fn array_get;
  fn array_len;
  fn array_make_empty;
  fn array_make_filled;
  fn array_pop_back;
  fn array_push;
  fn array_set
}
import testapi/iter { fn loop }

/// What the worklist did. The counters make the traversal auditable
/// from the outside: `pushes` must come out as the roots plus the
/// pointer fields of live objects, and `pops` as `marked + revisits`.
pub type Trace = { Pushes: I32; Pops: I32; Revisits: I32; Marked: I32 };

pub type Marking = { Mark_bits: Array[Bool]; Mark_trace: Trace };

/// An immediate is not an edge, so only pointer fields are pushed.
fn push_fields(cells: Array[I32], work: Array[I32], addr: I32, pushed: I32) -> I32 {
  fold_fields(
  , cells
  , addr
  , .(count, index) {
      match(field_slot(cells, addr, index)) {
        (
        , .(p: Ptr) {
            array_push(work, p.>select { Ptr.get });
            add_i32(count, 1)
          }
        , .(_immediate: Imm) { count }
        )
      }
    }
  , pushed
  )
}

rec(loop) fn seed_roots(roots: Array[I32], work: Array[I32], index: I32, pushed: I32) -> I32 {
  if(int_lt(index, array_len(roots))) {
    array_push(work, array_get(roots, index));
    recur seed_roots(roots, work, add_i32(index, 1), add_i32(pushed, 1))
  } else {
    pushed
  }
}

/// Drain the worklist. `array_pop_back` reports the empty stack as the
/// unit arm of its `I32 | .` result, which is the loop's only exit.
rec(loop) fn drain(cells: Array[I32], work: Array[I32], marks: Array[Bool], trace: Trace) -> Trace {
  match(array_pop_back(work)) {
    (
    , .(addr: I32) {
        let .(popped: Trace) =
          (
          , Pushes.mk(trace.>select { Pushes.get })
          , Pops.mk(add_i32(trace.>select { Pops.get }, 1))
          , Revisits.mk(trace.>select { Revisits.get })
          , Marked.mk(trace.>select { Marked.get })
          );
        if(array_get(marks, addr)) {
          recur drain(
          , cells
          , work
          , marks
          , (
            , Pushes.mk(popped.>select { Pushes.get })
            , Pops.mk(popped.>select { Pops.get })
            , Revisits.mk(add_i32(popped.>select { Revisits.get }, 1))
            , Marked.mk(popped.>select { Marked.get })
            )
          )
        } else {
          array_set(marks, addr, .t);
          let grown = push_fields(cells, work, addr, popped.>select { Pushes.get });
          recur drain(
          , cells
          , work
          , marks
          , (
            , Pushes.mk(grown)
            , Pops.mk(popped.>select { Pops.get })
            , Revisits.mk(popped.>select { Revisits.get })
            , Marked.mk(add_i32(popped.>select { Marked.get }, 1))
            )
          )
        }
      }
    , .(_empty: .) { trace }
    )
  }
}

pub fn mark_heap(cells: Array[I32], roots: Array[I32]) -> Marking {
  let .(marks: Array[Bool]) = array_make_filled(top(cells), .f);
  let work = array_make_empty[I32](());
  let seeded = seed_roots(roots, work, 0, 0);
  let trace =
    drain(cells, work, marks, (Pushes.mk(seeded), Pops.mk(0), Revisits.mk(0), Marked.mk(0)));
  (Mark_bits.mk(marks), Mark_trace.mk(trace))
}
