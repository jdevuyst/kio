/// The sweep phase. A sliding collector has no free list to thread --
/// the free space ends up as one run at the top of the arena -- so
/// sweeping is one walk of the object list that turns the mark bits
/// into a census: what the mark phase kept, and how many cells the
/// compaction is about to hand back.
module gc/sweep;

import elab/control(if);
import gc/heap(fold_objects, object_size);
import testapi(Array, Bool, I32);
import testapi/arith(add_i32);
import testapi/array(array_get);

pub labels Census = { live_objects: I32, dead_objects: I32, live_cells: I32, dead_cells: I32 };

pub fn sweep(cells: Array(I32), marks: Array(Bool)) -> Census {
  fold_objects(
    , cells
    , .(census, addr) {
        let size = object_size(cells, addr);
        let .(counted: Census) =
          if! array_get(marks, addr) {
            census.!{
              , live_objects = add_i32(census.?{live_objects}, 1)
              , live_cells = add_i32(census.?{live_cells}, size)
              }
          } else {
            census.!{
              , dead_objects = add_i32(census.?{dead_objects}, 1)
              , dead_cells = add_i32(census.?{dead_cells}, size)
              }
          };
        counted
      }
    , {live_objects = 0, dead_objects = 0, live_cells = 0, dead_cells = 0}
    )
}
