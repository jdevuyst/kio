/// The sweep phase. A sliding collector has no free list to thread --
/// the free space ends up as one run at the top of the arena -- so
/// sweeping is one walk of the object list that turns the mark bits
/// into a census: what the mark phase kept, and how many cells the
/// compaction is about to hand back.
mod gc/sweep;

import gc/heap { fn fold_objects; fn object_size }
import macros/control { macro if }
import macros/row_macros { macro select }
import testapi { type Array; type Bool; type I32 }
import testapi/arith { fn add_i32 }
import testapi/array { fn array_get }

pub type Census = { Live_objects: I32; Dead_objects: I32; Live_cells: I32; Dead_cells: I32 };

pub fn sweep(cells: Array[I32], marks: Array[Bool]) -> Census {
  fold_objects(
  , cells
  , .(census, addr) {
      let size = object_size(cells, addr);
      let .(counted: Census) =
        if(array_get(marks, addr)) {
          (
          , Live_objects.mk(add_i32(census.>select { Live_objects.get }, 1))
          , Dead_objects.mk(census.>select { Dead_objects.get })
          , Live_cells.mk(add_i32(census.>select { Live_cells.get }, size))
          , Dead_cells.mk(census.>select { Dead_cells.get })
          )
        } else {
          (
          , Live_objects.mk(census.>select { Live_objects.get })
          , Dead_objects.mk(add_i32(census.>select { Dead_objects.get }, 1))
          , Live_cells.mk(census.>select { Live_cells.get })
          , Dead_cells.mk(add_i32(census.>select { Dead_cells.get }, size))
          )
        };
      counted
    }
  , (Live_objects.mk(0), Dead_objects.mk(0), Live_cells.mk(0), Dead_cells.mk(0))
  )
}
