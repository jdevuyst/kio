mod symbolic_units/algebra;

import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import symbolic_units/model as model;
import symbolic_units/model {
  type Expr;
  type Kilogram;
  type Kilogram_exp;
  type Meter;
  type Meter_exp;
  type Pow;
  type Product;
  type Quotient;
  type Score;
  type Second;
  type Second_exp;
  type Summary
}
import testapi { type Bool; type I32 }
import testapi/arith as arith;
import testapi/iter { fn loop }

fn add_summary(left: Summary, right: Summary) -> Summary {
  let .(lm, ls, lk) = left.>select { Meter_exp.get; Second_exp.get; Kilogram_exp.get };
  let .(rm, rs, rk) = right.>select { Meter_exp.get; Second_exp.get; Kilogram_exp.get };
  model.summary(arith.add_i32(lm, rm), arith.add_i32(ls, rs), arith.add_i32(lk, rk))
}

fn subtract_summary(left: Summary, right: Summary) -> Summary {
  let .(lm, ls, lk) = left.>select { Meter_exp.get; Second_exp.get; Kilogram_exp.get };
  let .(rm, rs, rk) = right.>select { Meter_exp.get; Second_exp.get; Kilogram_exp.get };
  model.summary(arith.sub_i32(lm, rm), arith.sub_i32(ls, rs), arith.sub_i32(lk, rk))
}

fn scale_summary(value: Summary, factor: I32) -> Summary {
  let .(m, s, k) = value.>select { Meter_exp.get; Second_exp.get; Kilogram_exp.get };
  model.summary(arith.mul_i32(m, factor), arith.mul_i32(s, factor), arith.mul_i32(k, factor))
}

pub rec(loop) fn reduce(value: Expr) -> Summary {
  match(Expr.get(value)) {
    (
    , .(_m: Meter) { model.summary(1, 0, 0) }
    , .(_s: Second) { model.summary(0, 1, 0) }
    , .(_k: Kilogram) { model.summary(0, 0, 1) }
    , .(node: Product) {
        match(Product.get(node)) {
          .(left: Expr, right: Expr) {
            add_summary(recur(cont) reduce(left), recur(cont) reduce(right))
          }
        }
      }
    , .(node: Quotient) {
        match(Quotient.get(node)) {
          .(left: Expr, right: Expr) {
            subtract_summary(recur(cont) reduce(left), recur(cont) reduce(right))
          }
        }
      }
    , .(node: Pow) {
        match(Pow.get(node)) {
          .(base: Expr, exponent: I32) { scale_summary(recur(cont) reduce(base), exponent) }
        }
      }
    )
  }
}

fn abs_i32(value: I32) -> I32 {
  if(arith.lt_i32(value, 0)) { arith.sub_i32(0, value) } else { value }
}

rec(loop) fn weighted_count(count: I32, weight: I32, acc: I32) -> I32 {
  if(arith.leq_i32(count, 0)) {
    acc
  } else {
    recur weighted_count(arith.sub_i32(count, 1), weight, arith.add_i32(acc, weight))
  }
}

fn weighted_abs(value: I32, weight: I32) -> I32 { weighted_count(abs_i32(value), weight, 0) }

pub fn score(value: Summary) -> Score {
  let .(m, s, k) = value.>select { Meter_exp.get; Second_exp.get; Kilogram_exp.get };
  Score.mk(arith.add_i32(arith.add_i32(weighted_abs(m, 7), weighted_abs(s, 5)), weighted_abs(k, 11)))
}

pub fn balanced(value: Summary) -> Bool {
  let .(m, s, k) = value.>select { Meter_exp.get; Second_exp.get; Kilogram_exp.get };
  if(arith.eq_i32(m, 0)) {
    if(arith.eq_i32(s, 0)) { arith.eq_i32(k, 0) } else { .f }
  } else {
    .f
  }
}
