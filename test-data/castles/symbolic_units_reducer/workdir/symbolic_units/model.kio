module symbolic_units/model;

import macros/match(macro match);
import macros/row_macros(macro record);
import macros/spine_macros(macro widen_sum);
import testapi(I32);

pub type Unit = { Meter: . } | { Second: . } | { Kilogram: . };

rec {
  pub type { Expr: Meter | Second | Kilogram | Product | Quotient | Pow };
  pub type { Product: Expr & Expr };
  pub type { Quotient: Expr & Expr };
  pub type { Pow: Expr & I32 }
}

pub type Summary = { Meter_exp: I32; Second_exp: I32; Kilogram_exp: I32 };

pub type { Score: I32 { pub mk; pub get } }

pub fn unit_meter() -> Unit { (Meter.mk(()).>widen_sum)[Unit] }

pub fn unit_second() -> Unit { (Second.mk(()).>widen_sum)[Unit] }

pub fn unit_kilogram() -> Unit { (Kilogram.mk(()).>widen_sum)[Unit] }

fn wrap(node: Meter | Second | Kilogram | Product | Quotient | Pow) -> Expr { Expr.mk(node) }

pub fn unit_expr(unit_value: Unit) -> Expr {
  match(unit_value) {
    (
    , .(m: Meter) { wrap((m.>widen_sum)[Meter | Second | Kilogram | Product | Quotient | Pow]) }
    , .(s: Second) { wrap((s.>widen_sum)[Meter | Second | Kilogram | Product | Quotient | Pow]) }
    , .(k: Kilogram) { wrap((k.>widen_sum)[Meter | Second | Kilogram | Product | Quotient | Pow]) }
    )
  }
}

pub fn product(left: Expr, right: Expr) -> Expr {
  wrap((Product.mk(left, right).>widen_sum)[Meter | Second | Kilogram | Product | Quotient | Pow])
}

pub fn quotient(left: Expr, right: Expr) -> Expr {
  wrap((Quotient.mk(left, right).>widen_sum)[Meter | Second | Kilogram | Product | Quotient | Pow])
}

pub fn power(base: Expr, exp: I32) -> Expr {
  wrap((Pow.mk(base, exp).>widen_sum)[Meter | Second | Kilogram | Product | Quotient | Pow])
}

pub fn summary(meter: I32, second: I32, kilogram: I32) -> Summary {
  record { Meter_exp.mk(meter); Second_exp.mk(second); Kilogram_exp.mk(kilogram) }
}
