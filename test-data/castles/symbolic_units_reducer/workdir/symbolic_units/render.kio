mod symbolic_units/render;

import macros/match { macro match }
import macros/row_macros { macro select }
import symbolic_units/model {
  type Expr;
  type Kilogram;
  type Kilogram_exp;
  type Meter;
  type Meter_exp;
  type Pow;
  type Product;
  type Quotient;
  type Score;
  type Second;
  type Second_exp;
  type Summary
}
import symbolic_units/text as text;
import testapi { type I32; type String }
import testapi/fmt as fmt;
import testapi/iter { fn loop }

pub rec(loop) fn source(value: Expr) -> String {
  match(Expr.get(value)) {
    (
    , .(_m: Meter) { "m" }
    , .(_s: Second) { "s" }
    , .(_k: Kilogram) { "kg" }
    , .(node: Product) {
        match(Product.get(node)) {
          .(left: Expr, right: Expr) {
            text.cat5("(", recur(cont) source(left), " * ", recur(cont) source(right), ")")
          }
        }
      }
    , .(node: Quotient) {
        match(Quotient.get(node)) {
          .(left: Expr, right: Expr) {
            text.cat5("(", recur(cont) source(left), " / ", recur(cont) source(right), ")")
          }
        }
      }
    , .(node: Pow) {
        match(Pow.get(node)) {
          .(base: Expr, exponent: I32) {
            text.cat4(recur(cont) source(base), "^", fmt.int_to_string(exponent), "")
          }
        }
      }
    )
  }
}

pub fn reduced(value: Summary) -> String {
  let .(m, s, k) = value.>select { Meter_exp.get; Second_exp.get; Kilogram_exp.get };
  text.cat6("m^", fmt.int_to_string(m), " s^", fmt.int_to_string(s), " kg^", fmt.int_to_string(k))
}

pub fn score_text(score: Score) -> String { fmt.int_to_string(score.>Score.get) }
