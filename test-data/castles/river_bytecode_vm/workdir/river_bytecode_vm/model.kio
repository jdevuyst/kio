mod river_bytecode_vm/model;

import macros/row_macros { macro record }
import river_bytecode_vm/constants as c;
import testapi { type I32 }

pub type Snapshot_fields = {
  Pc: I32;
  Farmer: I32;
  Wolf: I32;
  Goat: I32;
  Cabbage: I32;
  Moves: I32;
  Waits: I32;
  Alerts: I32;
  Ticks: I32;
  Checksum: I32;
  Halt_code: I32
};

pub type Snapshot =
  Pc & Farmer & Wolf & Goat & Cabbage & Moves & Waits & Alerts & Ticks & Checksum & Halt_code
  ;

pub fn state(
, pc_value: I32
, farmer_value: I32
, wolf_value: I32
, goat_value: I32
, cabbage_value: I32
, moves_value: I32
, waits_value: I32
, alerts_value: I32
, ticks_value: I32
, checksum_value: I32
, halt_value: I32
) -> Snapshot {
  record {
    Pc.mk(pc_value);
    Farmer.mk(farmer_value);
    Wolf.mk(wolf_value);
    Goat.mk(goat_value);
    Cabbage.mk(cabbage_value);
    Moves.mk(moves_value);
    Waits.mk(waits_value);
    Alerts.mk(alerts_value);
    Ticks.mk(ticks_value);
    Checksum.mk(checksum_value);
    Halt_code.mk(halt_value)
  }
}

pub fn initial() -> Snapshot {
  state(0, c.west(), c.west(), c.west(), c.west(), 0, 0, 0, 0, 19, c.halt_running())
}
