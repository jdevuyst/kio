module river_bytecode_vm/report;

import elab/control(if);
import river_bytecode_vm/constants as c;
import river_bytecode_vm/model(
  , Alerts
  , Cabbage
  , Checksum
  , Farmer
  , Goat
  , Halt_code
  , Moves
  , Pc
  , Snapshot
  , Ticks
  , Waits
  , Wolf
  , {alerts}
  , {cabbage}
  , {checksum}
  , {farmer}
  , {goat}
  , {halt_code}
  , {moves}
  , {pc}
  , {ticks}
  , {waits}
  , {wolf}
  );
import river_bytecode_vm/util as util;
import river_bytecode_vm/vm as vm;
import testapi(Bool, I32, String);
import testapi/arith(eq_i32);
import testapi/fmt(bool_to_string, int_to_string);
import testapi/text(string_concat);

fn status(code: I32) -> String {
  if! eq_i32(code, c.halt_success()) {
    "success"
  } else if! eq_i32(code, c.halt_trap()) {
    "trap"
  } else if! eq_i32(code, c.halt_bad_pc()) {
    "bad-pc"
  } else {
    "running"
  }
}

fn actor_line(name: String, side: I32) -> String { util.line(name, util.side_name(side)) }

fn counter_pair(left_label: String, left_value: I32, right_label: String, right_value: I32) -> String {
  util.cat4(left_label, int_to_string(left_value), right_label, int_to_string(right_value))
}

fn bool_pair(left_label: String, left_value: Bool, right_label: String, right_value: Bool) -> String {
  util.cat4(left_label, bool_to_string(left_value), right_label, bool_to_string(right_value))
}

pub fn render() -> String {
  let final_state = vm.run();
  let .({
    , pc as pc_value
    , farmer as farmer_side
    , wolf as wolf_side
    , goat as goat_side
    , cabbage as cabbage_side
    , moves as move_count
    , waits as wait_count
    , alerts as alert_count
    , ticks as tick_count
    , checksum as checksum_value
    , halt_code as halt_value
    }) = final_state;
  string_concat(
    , "river_bytecode_vm: v1\n"
    , string_concat(
        , util.line("script: ", "wait goat back wolf goat cabbage back goat")
        , string_concat(
            , util.line("halt: ", status(halt_value))
            , string_concat(
                , actor_line("farmer: ", farmer_side)
                , string_concat(
                    , actor_line("wolf: ", wolf_side)
                    , string_concat(
                        , actor_line("goat: ", goat_side)
                        , string_concat(
                            , actor_line("cabbage: ", cabbage_side)
                            , string_concat(
                                , counter_pair("moves: ", move_count, " waits: ", wait_count)
                                , string_concat(
                                    , "\n"
                                    , string_concat(
                                        , counter_pair(
                                            , "alerts: "
                                            , alert_count
                                            , " ticks: "
                                            , tick_count
                                            )
                                        , string_concat(
                                            , "\n"
                                            , string_concat(
                                                , util.line("pc: ", int_to_string(pc_value))
                                                , string_concat(
                                                    , util.line(
                                                        , "checksum: "
                                                        , int_to_string(checksum_value)
                                                        )
                                                    , util.line(
                                                        , "invariants: "
                                                        , bool_pair(
                                                            , "safe="
                                                            , vm.safe(final_state)
                                                            , " done="
                                                            , vm.done(final_state)
                                                            )
                                                        )
                                                    )
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )
}
