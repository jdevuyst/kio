/// The one collection the engine is built on: a generic cons list.
///
/// Every relational structure in this package is a list at some
/// instantiation - a row is a `List(Cell)`, a table is a `List(Row)`, a
/// projection is a `List(Col)`, and a group accumulator is a
/// `List(Group)` - so the walks below are written once, polymorphically,
/// and reused at each of them.
module query/list;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(Bool, I32);
import testapi/arith(add_i32, leq_i32, sub_i32);
import testapi/iter(loop);

/// The recursive knot: a list is either empty or a head paired with a
/// tail. The `newtype` grounds the recursion that an anonymous sum
/// cannot express.
pub rec newtype List[A] : . | (A & List(A)) { pub constructor mk_list; pub projector un_list }

pub fn nil[A]() -> List(A) { List.mk_list(widen_sum!((), . | (A & List(A)))) }

pub fn cons[A](head: A, tail: List(A)) -> List(A) {
  List.mk_list(widen_sum!((head, tail), . | (A & List(A))))
}

pub fn of1[A](a: A) -> List(A) { cons(a, nil(A, ())) }

pub fn of2[A](a: A, b: A) -> List(A) { cons(a, of1(b)) }

pub fn of3[A](a: A, b: A, c: A) -> List(A) { cons(a, of2(b, c)) }

pub fn of4[A](a: A, b: A, c: A, d: A) -> List(A) { cons(a, of3(b, c, d)) }

pub fn of5[A](a: A, b: A, c: A, d: A, e: A) -> List(A) { cons(a, of4(b, c, d, e)) }

pub fn is_empty[A](xs: List(A)) -> Bool {
  match! xs.>List.un_list {
    (.(_x: A, _rest: List(A)) { .f }, .(_empty: .) { .t })
  }
}

rec(loop) fn length_from[A](xs: List(A), acc: I32) -> I32 {
  match! xs.>List.un_list {
    (.(_x: A, rest: List(A)) { rec length_from(rest, add_i32(acc, 1)) }, .(_empty: .) { acc })
  }
}

pub fn length[A](xs: List(A)) -> I32 { length_from(xs, 0) }

/// `append` is the only walk here that rebuilds its result on the way
/// out rather than on the way in, so its recursive call is a `cont`.
pub rec(loop) fn append[A](xs: List(A), ys: List(A)) -> List(A) {
  match! xs.>List.un_list {
    (.(x: A, rest: List(A)) { cons(x, rec(cont) append(rest, ys)) }, .(_empty: .) { ys })
  }
}

/// Keep the first `n` elements; a non-positive `n` keeps none. This is
/// the whole of the `Limit` operator's semantics.
pub rec(loop) fn take[A](n: I32, xs: List(A)) -> List(A) {
  if! leq_i32(n, 0) {
    nil(A, ())
  } else match! xs.>List.un_list {
    (
      , .(x: A, rest: List(A)) { cons(x, rec(cont) take(sub_i32(n, 1), rest)) }
      , .(_empty: .) { nil(A, ()) }
      )
  }
}
