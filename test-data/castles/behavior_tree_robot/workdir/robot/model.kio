mod robot/model;

import list/core as lists;
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }

pub type Status = { Running: . } | { Success: . } | { Failure: . };

pub type World = { Hazard: Bool; Blocked: Bool };

pub type Job = { Task_id: I32; Task_name: String; Duration: I32 };

pub rec type Tree =
  | { Action: Job }
  | { Sequence: I32 & lists.List[Tree] }
  | { Selector: lists.List[Tree] }
  | { Invert: Tree }
  | { Blocked_test: . }
  | { Hazard_guard: Tree }
  | { Once: I32 & Tree }
  ;

pub fn running_status() -> Status { Running.mk(()).>widen_sum }

pub fn success_status() -> Status { Success.mk(()).>widen_sum }

pub fn failure_status() -> Status { Failure.mk(()).>widen_sum }

fn task(id: I32, name: String, ticks: I32) -> Tree {
  Action.mk((Task_id.mk(id), Task_name.mk(name), Duration.mk(ticks))).>widen_sum
}

fn seq(id: I32, children: lists.List[Tree]) -> Tree { Sequence.mk((id, children)).>widen_sum }

fn select(children: lists.List[Tree]) -> Tree { Selector.mk(children).>widen_sum }

pub fn delivery_tree() -> Tree {
  let .(clear_door: Tree) = Invert.mk((Blocked_test.mk(()).>widen_sum)[Tree]).>widen_sum;
  let shortcut = seq(10, lists.cons(clear_door, lists.singleton(task(1, "short-route", 3))));
  let route = select(lists.cons(shortcut, lists.singleton(task(2, "detour", 2))));
  let delivery =
    seq(
    , 11
    , lists.cons(route, lists.cons(task(3, "collect", 2), lists.singleton(task(4, "deliver", 2))))
    );
  let .(mission: Tree) = Once.mk((12, delivery)).>widen_sum;
  let .(safety: Tree) = Hazard_guard.mk(task(5, "brake", 2)).>widen_sum;
  select(lists.cons(safety, lists.singleton(mission)))
}
