mod robot/engine;

import list/core as lists;
import list/list as traversal;
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import robot/memory as memory;
import robot/model as model;
import testapi { type Bool; type I32; type String }
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/iter { fn loop }
import testapi/text as text;

pub type Evaluation = { Result: model.Status; State: memory.State };

pub fn status_name(status: model.Status) -> String {
  match(status) {
    .(_r: model.Running) { "Running" };
    .(_s: model.Success) { "Success" };
    .(_f: model.Failure) { "Failure" }
  }
}

fn tick_action(task: model.Job, state: memory.State) -> Evaluation {
  let id = task.>select { model.Task_id.get };
  let progress = arith.add_i32(memory.get(id, state), 1);
  let done = arith.leq_i32(task.>select { model.Duration.get }, progress);
  let result = if(done) { model.success_status() } else { model.running_status() };
  let next =
    memory.store(
    , id
    , if(done) { 0 } else { progress }
    , task.>select { model.Task_name.get }
    , .f
    , memory.visit(id, state)
    );
  let message =
    text.string_concat(
    , task.>select { model.Task_name.get }
    , text.string_concat(
      , " "
      , text.string_concat(
        , fmt.int_to_string(progress)
        , text.string_concat(
          , "/"
          , text.string_concat(
            , fmt.int_to_string(task.>select { model.Duration.get })
            , text.string_concat(" ", status_name(result))
            )
          )
        )
      )
    );
  (Result.mk(result), State.mk(memory.event(message, memory.worked(done, next))))
}

fn invert_result(evaluation: Evaluation) -> Evaluation {
  let result =
    match(evaluation.>select { Result.get }) {
      .(_r: model.Running) { model.running_status() };
      .(_s: model.Success) { model.failure_status() };
      .(_f: model.Failure) { model.success_status() }
    };
  (
  , Result.mk(result)
  , State.mk(memory.event(
    , text.string_concat("invert ", status_name(result))
    , evaluation.>select { State.get }
    ))
  )
}

rec(loop) {
  pub fn tick(tree: model.Tree, world: model.World, state: memory.State) -> Evaluation {
    match(tree) {
      .(action: model.Action) {
        tick_action(action.>select { model.Action.get }, state)
      };
      .(sequence: model.Sequence) {
        let .(id, children) = sequence.>select { model.Sequence.get };
        let cursor = memory.get(id, state);
        recur sequence_children(
        , id
        , cursor
        , traversal.drop(cursor, children)
        , world
        , memory.visit(id, state)
        )
      };
      .(selector: model.Selector) {
        recur selector_children(selector.>select { model.Selector.get }, world, state)
      };
      .(invert: model.Invert) {
        invert_result(recur(cont) tick(invert.>select { model.Invert.get }, world, state))
      };
      .(_test: model.Blocked_test) {
        let result =
          if(world.>select { model.Blocked.get }) {
            model.success_status()
          } else {
            model.failure_status()
          };
        (
        , Result.mk(result)
        , State.mk(memory.event(text.string_concat("blocked? ", status_name(result)), state))
        )
      };
      .(guard: model.Hazard_guard) {
        if(world.>select { model.Hazard.get }) {
          recur tick(guard.>select { model.Hazard_guard.get }, world, state)
        } else {
          (Result.mk(model.failure_status()), State.mk(state))
        }
      };
      .(once: model.Once) {
        let .(id, child) = once.>select { model.Once.get };
        if(arith.lt_i32(0, memory.get(id, state))) {
          (
          , Result.mk(model.success_status())
          , State.mk(memory.event("delivery already complete", state))
          )
        } else {
          let evaluated = recur(cont) tick(child, world, state);
          match(evaluated.>select { Result.get }) {
            .(_done: model.Success) {
              (
              , Result.mk(model.success_status())
              , State.mk(memory.store(id, 1, "", .t, evaluated.>select { State.get }))
              )
            };
            .(_running: model.Running) { evaluated };
            .(_failed: model.Failure) { evaluated }
          }
        }
      }
    }
  };
  fn sequence_children(
  , id: I32
  , cursor: I32
  , children: lists.List[model.Tree]
  , world: model.World
  , state: memory.State
  ) -> Evaluation {
    match(lists.uncons(children)) {
      .(child: model.Tree, tail: lists.List[model.Tree]) {
        let evaluated = recur(cont) tick(child, world, state);
        match(evaluated.>select { Result.get }) {
          .(_done: model.Success) {
            recur sequence_children(
            , id
            , arith.add_i32(cursor, 1)
            , tail
            , world
            , evaluated.>select { State.get }
            )
          };
          .(_running: model.Running) {
            (
            , Result.mk(model.running_status())
            , State.mk(memory.store(id, cursor, "", .f, evaluated.>select { State.get }))
            )
          };
          .(_failed: model.Failure) {
            (
            , Result.mk(model.failure_status())
            , State.mk(memory.store(id, 0, "", .f, evaluated.>select { State.get }))
            )
          }
        }
      };
      .() { (Result.mk(model.success_status()), State.mk(memory.store(id, 0, "", .f, state))) }
    }
  };
  fn selector_children(children: lists.List[model.Tree], world: model.World, state: memory.State) -> Evaluation {
    match(lists.uncons(children)) {
      .(child: model.Tree, tail: lists.List[model.Tree]) {
        let evaluated = recur(cont) tick(child, world, state);
        match(evaluated.>select { Result.get }) {
          .(_failed: model.Failure) {
            recur selector_children(tail, world, evaluated.>select { State.get })
          };
          .(_running: model.Running) { evaluated };
          .(_done: model.Success) { evaluated }
        }
      };
      .() { (Result.mk(model.failure_status()), State.mk(state)) }
    }
  }
}
