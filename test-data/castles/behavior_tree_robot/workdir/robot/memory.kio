module robot/memory;

import elab/control(if);
import elab/match(match);
import list/core as lists;
import list/list as traversal;
import list_host as numbers;
import testapi(Bool, I32, String);
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/text as text;

pub labels Slot = { key: I32, amount: I32, name: String, sticky: Bool };

pub labels State = {
  , slots: lists.List(Slot)
  , seen: lists.List(I32)
  , events: lists.List(String)
  , completed: I32
  , canceled: I32
  , work_ticks: I32
  };

pub fn empty() -> State {
  {
    , slots = lists.nil()
    , seen = lists.nil()
    , events = lists.nil()
    , completed = 0
    , canceled = 0
    , work_ticks = 0
    }
}

pub fn begin(state: State) -> State { state.!{seen = lists.nil(), events = lists.nil()} }

pub fn visit(id: I32, state: State) -> State { state.!{seen = lists.cons(id, state.?{seen})} }

pub fn event(message: String, state: State) -> State {
  state.!{events = lists.cons(message, state.?{events})}
}

pub fn get(id: I32, state: State) -> I32 {
  match! traversal.find(.(slot: Slot) { numbers.eq_i32(slot.?{key}, id) }, state.?{slots}) {
    .(slot: Slot) { slot.?{amount} };
    .() { 0 }
  }
}

pub fn store(id: I32, value: I32, title: String, latched: Bool, state: State) -> State {
  let other =
    traversal.filter(
      , .(slot: Slot) {
          if! numbers.eq_i32(slot.?{key}, id) {
            .f
          } else {
            .t
          }
        }
      , state.?{slots}
      );
  state.!{slots = lists.cons({key = id, amount = value, name = title, sticky = latched}, other)}
}

pub fn worked(done: Bool, state: State) -> State {
  state.!{
    , work_ticks = arith.add_i32(state.?{work_ticks}, 1)
    , completed = arith.add_i32(
        , state.?{completed}
        , if! done {
            1
          } else {
            0
          }
        )
    }
}

fn sweep_slot(state: State, slot: Slot) -> State {
  let keep =
    if! slot.?{sticky} {
      .t
    } else {
      traversal.elem(numbers.eq_i32, slot.?{key}, state.?{seen})
    };
  if! keep {
    state.!{slots = lists.cons(slot, state.?{slots})}
  } else if! text.string_eq(slot.?{name}, "") {
    state
  } else if! arith.lt_i32(0, slot.?{amount}) {
    let message = text.string_concat(
      , "cancel "
      , text.string_concat(
          , slot.?{name}
          , text.string_concat(" after ", fmt.int_to_string(slot.?{amount}))
          )
      );
    event(message, state.!{canceled = arith.add_i32(state.?{canceled}, 1)})
  } else {
    state
  }
}

pub fn finish(state: State) -> State {
  traversal.foldl(sweep_slot, state.!{slots = lists.nil()}, state.?{slots})
}
