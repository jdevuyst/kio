mod robot/memory;

import list/core as lists;
import list/list as traversal;
import list_host as numbers;
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select; macro with }
import testapi { type Bool; type I32; type String }
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/text as text;

pub type Slot = { Key: I32; Amount: I32; Name: String; Sticky: Bool };

pub type State = {
  Slots: lists.List[Slot];
  Seen: lists.List[I32];
  Events: lists.List[String];
  Completed: I32;
  Canceled: I32;
  Work_ticks: I32
};

pub fn empty() -> State {
  (
  , Slots.mk(lists.nil[_])
  , Seen.mk(lists.nil[_])
  , Events.mk(lists.nil[_])
  , Completed.mk(0)
  , Canceled.mk(0)
  , Work_ticks.mk(0)
  )
}

pub fn begin(state: State) -> State {
  state.>with { Seen.mk(lists.nil[_]); Events.mk(lists.nil[_]) }
}

pub fn visit(id: I32, state: State) -> State {
  state.>with {
    Seen.mk(lists.cons(id, state.>select { Seen.get }))
  }
}

pub fn event(message: String, state: State) -> State {
  state.>with {
    Events.mk(lists.cons(message, state.>select { Events.get }))
  }
}

pub fn get(id: I32, state: State) -> I32 {
  match(traversal.find(
  , .(slot: Slot) {
      numbers.eq_i32(slot.>select { Key.get }, id)
    }
  , state.>select { Slots.get }
  )) {
    .(slot: Slot) {
      slot.>select { Amount.get }
    };
    .() { 0 }
  }
}

pub fn store(id: I32, value: I32, title: String, latched: Bool, state: State) -> State {
  let other =
    traversal.filter(
    , .(slot: Slot) {
        if(numbers.eq_i32(slot.>select { Key.get }, id)) { .f } else { .t }
      }
    , state.>select { Slots.get }
    );
  state.>with {
    Slots.mk(lists.cons((Key.mk(id), Amount.mk(value), Name.mk(title), Sticky.mk(latched)), other))
  }
}

pub fn worked(done: Bool, state: State) -> State {
  state.>with {
    Work_ticks.mk(arith.add_i32(state.>select { Work_ticks.get }, 1));
    Completed.mk(arith.add_i32(state.>select { Completed.get }, if(done) { 1 } else { 0 }))
  }
}

fn sweep_slot(state: State, slot: Slot) -> State {
  let keep =
    if(slot.>select { Sticky.get }) {
      .t
    } else {
      traversal.elem(numbers.eq_i32, slot.>select { Key.get }, state.>select { Seen.get })
    };
  if(keep) {
    (
    , Slots.mk(lists.cons(slot, state.>select { Slots.get }))
    , Seen.mk(state.>select { Seen.get })
    , Events.mk(state.>select { Events.get })
    , Completed.mk(state.>select { Completed.get })
    , Canceled.mk(state.>select { Canceled.get })
    , Work_ticks.mk(state.>select { Work_ticks.get })
    )
  } else if(text.string_eq(slot.>select { Name.get }, "")) {
    state
  } else if(arith.lt_i32(0, slot.>select { Amount.get })) {
    let message = text.string_concat(
    , "cancel "
    , text.string_concat(
      , slot.>select { Name.get }
      , text.string_concat(" after ", fmt.int_to_string(slot.>select { Amount.get }))
      )
    );
    event(
    , message
    , (
      , Slots.mk(state.>select { Slots.get })
      , Seen.mk(state.>select { Seen.get })
      , Events.mk(state.>select { Events.get })
      , Completed.mk(state.>select { Completed.get })
      , Canceled.mk(arith.add_i32(state.>select { Canceled.get }, 1))
      , Work_ticks.mk(state.>select { Work_ticks.get })
      )
    )
  } else {
    state
  }
}

pub fn finish(state: State) -> State {
  traversal.foldl(
  , sweep_slot
  , (
    , Slots.mk(lists.nil[_])
    , Seen.mk(state.>select { Seen.get })
    , Events.mk(state.>select { Events.get })
    , Completed.mk(state.>select { Completed.get })
    , Canceled.mk(state.>select { Canceled.get })
    , Work_ticks.mk(state.>select { Work_ticks.get })
    )
  , state.>select { Slots.get }
  )
}
