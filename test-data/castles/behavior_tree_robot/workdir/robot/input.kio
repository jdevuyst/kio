mod robot/input;

import macros/control { macro if }
import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import robot/model as model;
import testapi { type Bool; type String }
import testapi/io as io;
import testapi/text as text;

pub type Input = { World: model.World } | { End: . } | { Invalid: String };

fn fields(hazard_line: String, door_line: String) -> Input {
  let valid_hazard =
    if(text.string_eq(hazard_line, "hazard")) { .t } else { text.string_eq(hazard_line, "clear") };
  let valid_door =
    if(text.string_eq(door_line, "blocked")) { .t } else { text.string_eq(door_line, "open") };
  if(valid_hazard) {
    if(valid_door) {
      World.mk((
      , model.Hazard.mk(text.string_eq(hazard_line, "hazard"))
      , model.Blocked.mk(text.string_eq(door_line, "blocked"))
      ))
        .>widen_sum
    } else {
      Invalid.mk("door field must be open or blocked").>widen_sum
    }
  } else {
    Invalid.mk("hazard field must be clear or hazard").>widen_sum
  }
}

pub fn read() -> Input {
  match(io.read_ascii_line()) {
    .(hazard_line: String) {
      match(io.read_ascii_line()) {
        .(door_line: String) { fields(hazard_line, door_line) };
        .() { Invalid.mk("missing door field").>widen_sum }
      }
    };
    .() { End.mk(()).>widen_sum }
  }
}
