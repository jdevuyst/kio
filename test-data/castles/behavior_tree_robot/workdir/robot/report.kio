module robot/report;

import list/core as lists;
import list/list as traversal;
import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import robot/engine as engine;
import robot/memory as memory;
import robot/model as model;
import testapi(Bool, I32, String);
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter(loop);
import testapi/text as text;

rec(loop) fn events(messages: lists.List[String]) {
  match(lists.uncons(messages)) {
    .(message: String, tail: lists.List[String]) {
      io.print(message.>text.string_concat("\n").>>text.string_concat("  "));
      recur events(tail)
    };
    .() { () }
  }
}

pub fn tick(number: I32, world: model.World, result: model.Status, state: memory.State) {
  let .(hazard: String) = if(world.>select { model.Hazard.get }) { "hazard" } else { "clear" };
  let .(door: String) = if(world.>select { model.Blocked.get }) { "blocked" } else { "open" };
  io.print(text.string_concat(
  , "tick "
  , text.string_concat(
    , fmt.int_to_string(number)
    , text.string_concat(
      , " "
      , text.string_concat(
        , hazard
        , text.string_concat(
          , "/"
          , text.string_concat(
            , door
            , text.string_concat(" -> ", text.string_concat(engine.status_name(result), "\n"))
            )
          )
        )
      )
    )
  ));
  events(traversal.reverse(state.>select { memory.Events.get }))
}

pub fn summary(ticks: I32, state: memory.State) {
  io.print(text.string_concat(
  , "summary ticks="
  , text.string_concat(
    , fmt.int_to_string(ticks)
    , text.string_concat(
      , " completed-actions="
      , text.string_concat(
        , fmt.int_to_string(state.>select { memory.Completed.get })
        , text.string_concat(
          , " cancellations="
          , text.string_concat(
            , fmt.int_to_string(state.>select { memory.Canceled.get })
            , text.string_concat(
              , " work-ticks="
              , text.string_concat(fmt.int_to_string(state.>select { memory.Work_ticks.get }), "\n")
              )
            )
          )
        )
      )
    )
  ))
}
