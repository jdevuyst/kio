module float_weather_index/daily;

import float_weather_index/model as model;
import float_weather_index/readings as readings;
import testapi(F64);
import testapi/arith as arith;

pub fn morning_raw() -> F64 {
  model.raw_index(
    , readings.morning_temperature()
    , readings.morning_humidity()
    , readings.morning_wind()
    , readings.morning_correction()
    )
}

pub fn midday_raw() -> F64 {
  model.raw_index(
    , readings.midday_temperature()
    , readings.midday_humidity()
    , readings.midday_wind()
    , readings.midday_correction()
    )
}

pub fn evening_raw() -> F64 {
  model.raw_index(
    , readings.evening_temperature()
    , readings.evening_humidity()
    , readings.evening_wind()
    , readings.evening_correction()
    )
}

pub fn night_raw() -> F64 {
  model.raw_index(
    , readings.night_temperature()
    , readings.night_humidity()
    , readings.night_wind()
    , readings.night_correction()
    )
}

pub fn smoothed_index() -> F64 {
  let first = morning_raw();
  let second = model.smooth(first, midday_raw());
  let third = model.smooth(second, evening_raw());
  model.smooth(third, night_raw())
}

pub fn midday_to_night_spread() -> F64 { arith.sub_f64(midday_raw(), night_raw()) }

pub fn comfort_delta() -> F64 { arith.sub_f64(model.comfort_target(), smoothed_index()) }
