mod interpreter/evaluator;

import interpreter/environment as env;
import interpreter/syntax as ast;
import interpreter/values as values;
import list/core as lists;
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }
import testapi/arith as arith;
import testapi/iter { fn loop }

type Frame =
  | { Add_left: ast.Expr & values.Environment }
  | { Add_right: values.Value }
  | { Call_left: ast.Expr & values.Environment }
  | { Call_right: values.Value }
  | { Bind_value: String & ast.Expr & values.Environment }
  ;

type Mode = { Evaluate: ast.Expr & values.Environment } | { Returned: values.Value };

type Stack = lists.List[Frame];

pub type Result = String | values.Value;

fn evaluate_at(expr: ast.Expr, environment: values.Environment) -> Mode {
  (Evaluate.mk((expr, environment)).>widen_sum)[Mode]
}

fn return_value(value: values.Value) -> Mode { (Returned.mk(value).>widen_sum)[Mode] }

fn fail(message: String) -> Result { (message.>widen_sum)[Result] }

rec(loop) fn run(mode: Mode, stack: Stack, fuel: I32) -> Result {
  if(arith.leq_i32(fuel, 0)) {
    fail("evaluation fuel exhausted")
  } else {
    let next_fuel = arith.sub_i32(fuel, 1);
    match(mode) {
      .(pending: Evaluate) {
        let .(expr, environment) = pending.>select { Evaluate.get };
        match(expr) {
          .(n: ast.Integer) {
            recur run(return_value(values.integer(n.>select { ast.Integer.get })), stack, next_fuel)
          };
          .(v: ast.Variable) {
            match(env.lookup(v.>select { ast.Variable.get }, environment)) {
              .(value: values.Value) { recur run(return_value(value), stack, next_fuel) };
              .(error: String) { fail(error) }
            }
          };
          .(f: ast.Lambda) {
            let .(parameter, body) = f.>select { ast.Lambda.get };
            recur run(return_value(values.capture(parameter, body, environment)), stack, next_fuel)
          };
          .(call: ast.Application) {
            let .(callee, argument) = call.>select { ast.Application.get };
            let frame = (Call_left.mk((argument, environment)).>widen_sum)[Frame];
            recur run(evaluate_at(callee, environment), lists.cons(frame, stack), next_fuel)
          };
          .(sum: ast.Addition) {
            let .(left, right) = sum.>select { ast.Addition.get };
            let frame = (Add_left.mk((right, environment)).>widen_sum)[Frame];
            recur run(evaluate_at(left, environment), lists.cons(frame, stack), next_fuel)
          };
          .(binding: ast.Binding) {
            let .(name, initial, body) = binding.>select { ast.Binding.get };
            let frame = (Bind_value.mk((name, body, environment)).>widen_sum)[Frame];
            recur run(evaluate_at(initial, environment), lists.cons(frame, stack), next_fuel)
          }
        }
      };
      .(ready: Returned) {
        let value = ready.>select { Returned.get };
        match(lists.uncons(stack)) {
          .(frame: Frame, remaining: Stack) {
            match(frame) {
              .(left: Add_left) {
                let .(right, environment) = left.>select { Add_left.get };
                let saved = (Add_right.mk(value).>widen_sum)[Frame];
                recur run(evaluate_at(right, environment), lists.cons(saved, remaining), next_fuel)
              };
              .(right: Add_right) {
                match((right.>select { Add_right.get }, value)) {
                  .(a: values.Number, b: values.Number) {
                    let total =
                      arith.add_i32(
                      , a.>select { values.Number.get }
                      , b.>select { values.Number.get }
                      );
                    recur run(return_value(values.integer(total)), remaining, next_fuel)
                  };
                  .() { fail("addition expects two integers") }
                }
              };
              .(callee: Call_left) {
                let .(argument, caller_environment) = callee.>select { Call_left.get };
                let saved = (Call_right.mk(value).>widen_sum)[Frame];
                recur run(
                , evaluate_at(argument, caller_environment)
                , lists.cons(saved, remaining)
                , next_fuel
                )
              };
              .(argument: Call_right) {
                match(argument.>select { Call_right.get }) {
                  .(f: values.Closure) {
                    let .(parameter, body, captured) = f.>select { values.Closure.get };
                    let local = env.extend(parameter, value, captured);
                    recur run(evaluate_at(body, local), remaining, next_fuel)
                  };
                  .(_n: values.Number) { fail("application expects a closure") }
                }
              };
              .(binding: Bind_value) {
                let .(name, body, saved) = binding.>select { Bind_value.get };
                recur run(evaluate_at(body, env.extend(name, value, saved)), remaining, next_fuel)
              }
            }
          };
          .() { (value.>widen_sum)[Result] }
        }
      }
    }
  }
}

pub fn evaluate(expr: ast.Expr, fuel: I32) -> Result {
  run(evaluate_at(expr, env.empty()), lists.nil[_], fuel)
}
