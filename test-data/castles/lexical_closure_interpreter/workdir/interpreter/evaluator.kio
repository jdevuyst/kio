module interpreter/evaluator;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import interpreter/environment as env;
import interpreter/syntax as ast;
import interpreter/values as values;
import list/core as lists;
import testapi(Bool, I32, String);
import testapi/arith as arith;
import testapi/iter(loop);

labels Frame =
  { add_left: ast.Expr & values.Environment }
  | { add_right: values.Value }
  | { call_left: ast.Expr & values.Environment }
  | { call_right: values.Value }
  | { bind_value: String & ast.Expr & values.Environment };

labels Mode = { evaluate: ast.Expr & values.Environment } | { returned: values.Value };

type Stack = lists.List(Frame);

pub type Result = String | values.Value;

fn evaluate_at(expr: ast.Expr, environment: values.Environment) -> Mode {
  {evaluate = (expr, environment)}.>widen_sum!(Mode)
}

fn return_value(value: values.Value) -> Mode { {returned = value}.>widen_sum!(Mode) }

fn fail(message: String) -> Result { message.>widen_sum!(Result) }

rec(loop) fn run(mode: Mode, stack: Stack, fuel: I32) -> Result {
  if! arith.leq_i32(fuel, 0) {
    fail("evaluation fuel exhausted")
  } else {
    let next_fuel = arith.sub_i32(fuel, 1);
    match! mode {
      .(pending: Evaluate) {
        let .(expr, environment) = pending.?{evaluate};
        match! expr {
          .(n: ast.Integer) {
            rec run(return_value(values.integer(n.?{ast.integer})), stack, next_fuel)
          };
          .(v: ast.Variable) {
            match! env.lookup(v.?{ast.variable}, environment) {
              .(value: values.Value) { rec run(return_value(value), stack, next_fuel) };
              .(error: String) { fail(error) }
            }
          };
          .(f: ast.Lambda) {
            let .(parameter, body) = f.?{ast.lambda};
            rec run(return_value(values.capture(parameter, body, environment)), stack, next_fuel)
          };
          .(call: ast.Application) {
            let .(callee, argument) = call.?{ast.application};
            let frame = {call_left = (argument, environment)}.>widen_sum!(Frame);
            rec run(evaluate_at(callee, environment), lists.cons(frame, stack), next_fuel)
          };
          .(sum: ast.Addition) {
            let .(left, right) = sum.?{ast.addition};
            let frame = {add_left = (right, environment)}.>widen_sum!(Frame);
            rec run(evaluate_at(left, environment), lists.cons(frame, stack), next_fuel)
          };
          .(binding: ast.Binding) {
            let .(name, initial, body) = binding.?{ast.binding};
            let frame = {bind_value = (name, body, environment)}.>widen_sum!(Frame);
            rec run(evaluate_at(initial, environment), lists.cons(frame, stack), next_fuel)
          }
        }
      };
      .(ready: Returned) {
        let value = ready.?{returned};
        match! lists.uncons(stack) {
          .(frame: Frame, remaining: Stack) {
            match! frame {
              .(left: Add_left) {
                let .(right, environment) = left.?{add_left};
                let saved = {add_right = value}.>widen_sum!(Frame);
                rec run(evaluate_at(right, environment), lists.cons(saved, remaining), next_fuel)
              };
              .(right: Add_right) {
                match!((right.?{add_right}, value)) {
                  .(a: values.Number, b: values.Number) {
                    let total = arith.add_i32(a.?{values.number}, b.?{values.number});
                    rec run(return_value(values.integer(total)), remaining, next_fuel)
                  };
                  .() { fail("addition expects two integers") }
                }
              };
              .(callee: Call_left) {
                let .(argument, caller_environment) = callee.?{call_left};
                let saved = {call_right = value}.>widen_sum!(Frame);
                rec run(
                  , evaluate_at(argument, caller_environment)
                  , lists.cons(saved, remaining)
                  , next_fuel
                  )
              };
              .(argument: Call_right) {
                match! argument.?{call_right} {
                  .(f: values.Closure) {
                    let .(parameter, body, captured) = f.?{values.closure};
                    let local = env.extend(parameter, value, captured);
                    rec run(evaluate_at(body, local), remaining, next_fuel)
                  };
                  .(_n: values.Number) { fail("application expects a closure") }
                }
              };
              .(binding: Bind_value) {
                let .(name, body, saved) = binding.?{bind_value};
                rec run(evaluate_at(body, env.extend(name, value, saved)), remaining, next_fuel)
              }
            }
          };
          .() { value.>widen_sum!(Result) }
        }
      }
    }
  }
}

pub fn evaluate(expr: ast.Expr, fuel: I32) -> Result {
  run(evaluate_at(expr, env.empty()), lists.nil(), fuel)
}
