module interpreter/syntax;

import macros/spine_macros(macro widen_sum);
import testapi(I32, String);

pub rec type Expr =
  | { Integer: I32 }
  | { Variable: String }
  | { Lambda: String & Expr }
  | { Application: Expr & Expr }
  | { Addition: Expr & Expr }
  | { Binding: String & Expr & Expr }
  ;

pub fn number(n: I32) -> Expr { (Integer.mk(n).>widen_sum)[Expr] }

pub fn reference(name: String) -> Expr { (Variable.mk(name).>widen_sum)[Expr] }

pub fn function(name: String, body: Expr) -> Expr { (Lambda.mk((name, body)).>widen_sum)[Expr] }

pub fn apply(callee: Expr, argument: Expr) -> Expr {
  (Application.mk((callee, argument)).>widen_sum)[Expr]
}

pub fn add(left: Expr, right: Expr) -> Expr { (Addition.mk((left, right)).>widen_sum)[Expr] }

pub fn bind(name: String, value: Expr, body: Expr) -> Expr {
  (Binding.mk((name, value, body)).>widen_sum)[Expr]
}
