module interpreter/values;

import interpreter/syntax as ast;
import list/core as lists;
import macros/match(macro match);
import macros/row_macros(macro select);
import macros/spine_macros(macro widen_sum);
import testapi(I32, String);
import testapi/fmt as fmt;
import testapi/text as text;

pub rec type Value = { Number: I32 } | { Closure: String & ast.Expr & lists.List[String & Value] };

pub type Environment = lists.List[String & Value];

pub fn integer(n: I32) -> Value { (Number.mk(n).>widen_sum)[Value] }

pub fn capture(parameter: String, body: ast.Expr, environment: Environment) -> Value {
  (Closure.mk((parameter, body, environment)).>widen_sum)[Value]
}

pub fn render(value: Value) -> String {
  match(value) {
    .(n: Number) {
      fmt.int_to_string(n.>select { Number.get })
    };
    .(f: Closure) {
      let .(parameter, _body, _environment) = f.>select { Closure.get };
      text.string_concat("<closure ", text.string_concat(parameter, ">"))
    }
  }
}
