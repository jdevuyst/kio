module testapi/main;

import elab/match(match);
import interpreter/input as input;
import interpreter/report as report;
import testapi(I32, String);
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter(loop);

rec(loop) fn cases(completed: I32) -> . {
  match! io.read_ascii_line() {
    .(title: String) {
      match! io.read_ascii_line() {
        .(budget: String) {
          match! input.read_tokens() {
            .(tokens: input.Tokens) {
              report.case_result(title, budget, tokens);
              rec cases(arith.add_i32(completed, 1))
            };
            .(error: String) { io.print("input error: "); io.print(error); io.print("\n") }
          }
        };
        .() { io.print("input error: missing fuel budget\n") }
      }
    };
    .() { io.print("Programs reported: "); io.print(fmt.int_to_string(completed)); io.print("\n") }
  }
}

pub fn main() -> . { io.print("Lexical closure interpreter\n"); cases(0) }
