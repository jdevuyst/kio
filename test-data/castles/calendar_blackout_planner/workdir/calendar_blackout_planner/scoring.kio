module calendar_blackout_planner/scoring;

import calendar_blackout_planner/model(Frozen, Priority, Support_load, Window);
import macros/control(macro if);
import macros/row_macros(macro select);
import testapi(Bool, I32, String);
import testapi/arith as arith;

pub fn score(window: Window) -> I32 {
  if(window.>select { Frozen.get }) {
    0
  } else {
    arith.sub_i32(
    , arith.mul_i32(window.>select { Priority.get }, 9)
    , arith.mul_i32(window.>select { Support_load.get }, 2)
    )
  }
}

pub fn status(window: Window) -> String {
  if(window.>select { Frozen.get }) { "frozen" } else { "release" }
}

pub fn better(left: Window, right: Window) -> Window {
  if(arith.lt_i32(score(left), score(right))) { right } else { left }
}
