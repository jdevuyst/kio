mod csv_reconcile/model;

import macros/control { macro if }
import macros/row_macros { macro select }
import testapi { type Bool; type I32; type String }
import testapi/arith as arith;

pub type Ledger = {
  Balance: I32;
  Credits: I32;
  Debits: I32;
  Checks: I32;
  Errors: I32;
  Started: Bool
};

pub type State = Balance & Credits & Debits & Checks & Errors & Started;

pub fn make_state(
, new_balance: I32
, new_credits: I32
, new_debits: I32
, new_checks: I32
, new_errors: I32
, new_started: Bool
) -> State {
  (
  , Balance.mk(new_balance)
  , Credits.mk(new_credits)
  , Debits.mk(new_debits)
  , Checks.mk(new_checks)
  , Errors.mk(new_errors)
  , Started.mk(new_started)
  )
}

pub fn init() -> State { make_state(0, 0, 0, 0, 0, .f) }

pub fn get_balance(state: State) -> I32 {
  state.>select { Balance.get }
}

pub fn get_credits(state: State) -> I32 {
  state.>select { Credits.get }
}

pub fn get_debits(state: State) -> I32 {
  state.>select { Debits.get }
}

pub fn get_checks(state: State) -> I32 {
  state.>select { Checks.get }
}

pub fn get_errors(state: State) -> I32 {
  state.>select { Errors.get }
}

pub fn is_started(state: State) -> Bool {
  state.>select { Started.get }
}

pub fn begin(_state: State) -> State { make_state(0, 0, 0, 0, 0, .t) }

pub fn add_error(state: State) -> State {
  make_state(
  , get_balance(state)
  , get_credits(state)
  , get_debits(state)
  , get_checks(state)
  , arith.add_i32(get_errors(state), 1)
  , is_started(state)
  )
}

pub fn add_credit(state: State, amount: I32) -> State {
  make_state(
  , arith.add_i32(get_balance(state), amount)
  , arith.add_i32(get_credits(state), amount)
  , get_debits(state)
  , get_checks(state)
  , get_errors(state)
  , is_started(state)
  )
}

pub fn debit_allowed(state: State, amount: I32) -> Bool {
  if(arith.lt_i32(get_balance(state), amount)) { .f } else { .t }
}

pub fn apply_debit(state: State, amount: I32) -> State {
  if(debit_allowed(state, amount)) {
    make_state(
    , arith.sub_i32(get_balance(state), amount)
    , get_credits(state)
    , arith.add_i32(get_debits(state), amount)
    , get_checks(state)
    , get_errors(state)
    , is_started(state)
    )
  } else {
    add_error(state)
  }
}

pub fn record_check(state: State) -> State {
  make_state(
  , get_balance(state)
  , get_credits(state)
  , get_debits(state)
  , arith.add_i32(get_checks(state), 1)
  , get_errors(state)
  , is_started(state)
  )
}

pub fn status(state: State) -> String {
  if(arith.lt_i32(0, get_errors(state))) { "needs-review" } else { "ok" }
}
