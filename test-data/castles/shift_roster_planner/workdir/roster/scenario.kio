module roster/scenario;

import elab/control(if);
import roster/types(Shift, {day}, {demand}, {preference}, {skill}, {slot}, {worker});
import testapi(Bool, I32, String);
import testapi/arith(eq_i32);

pub fn shift_count() -> I32 { 10 }

pub fn worker_count() -> I32 { 4 }

pub fn worker_name(id: I32) -> String {
  if! eq_i32(id, 0) {
    "Ari"
  } else if! eq_i32(id, 1) {
    "Bea"
  } else if! eq_i32(id, 2) {
    "Cal"
  } else {
    "Dee"
  }
}

pub fn slot_name(id: I32) -> String {
  if! eq_i32(id, 0) {
    "morning"
  } else if! eq_i32(id, 1) {
    "evening"
  } else {
    "night"
  }
}

pub fn skill_name(id: I32) -> String {
  if! eq_i32(id, 0) {
    "front"
  } else if! eq_i32(id, 1) {
    "meds"
  } else {
    "lead"
  }
}

fn mk_shift(
  , day_value: I32
  , slot_value: I32
  , worker_value: I32
  , demand_value: I32
  , skill_value: I32
  , preference_value: I32
  ) -> Shift {
  {
    , day = day_value
    , slot = slot_value
    , worker = worker_value
    , demand = demand_value
    , skill = skill_value
    , preference = preference_value
    }
}

pub fn shift_at(index: I32) -> Shift {
  if! eq_i32(index, 0) {
    mk_shift(0, 0, 0, 2, 0, 0)
  } else if! eq_i32(index, 1) {
    mk_shift(0, 1, 1, 1, 1, 1)
  } else if! eq_i32(index, 2) {
    mk_shift(0, 2, 0, 1, 2, 2)
  } else if! eq_i32(index, 3) {
    mk_shift(1, 0, 2, 2, 1, 0)
  } else if! eq_i32(index, 4) {
    mk_shift(1, 1, 3, 1, 0, 1)
  } else if! eq_i32(index, 5) {
    mk_shift(2, 0, 1, 2, 2, 0)
  } else if! eq_i32(index, 6) {
    mk_shift(2, 1, 2, 1, 0, 2)
  } else if! eq_i32(index, 7) {
    mk_shift(2, 2, 3, 1, 2, 1)
  } else if! eq_i32(index, 8) {
    mk_shift(3, 0, 0, 2, 1, 0)
  } else {
    mk_shift(3, 1, 3, 1, 0, 0)
  }
}
