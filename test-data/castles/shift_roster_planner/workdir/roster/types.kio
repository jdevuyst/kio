module roster/types;

import testapi(I32, String);

pub type Shift = { Day: I32; Slot: I32; Worker: I32; Demand: I32; Skill: I32; Preference: I32 };

pub type Scorecard = {
  Skill_shortfalls: I32;
  Same_day_conflicts: I32;
  Rest_conflicts: I32;
  Fairness_penalty: I32;
  Preference_penalty: I32;
  Total_score: I32
};

pub type Worker_load = { Load: I32; Worker_name: String };
