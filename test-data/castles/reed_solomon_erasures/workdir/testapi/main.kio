module testapi/main;

import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import rs/input as input;
import rs/report as report;
import testapi(Bool, I32, String);
import testapi/arith as a;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter(loop);
import testapi/text as text;

rec(loop) fn frames(recovered: I32, rejected: I32) {
  match(input.next()) {
    .(item: input.Loaded) {
      if(report.run(item.>select { input.Loaded.get })) {
        recur frames(a.add_i32(recovered, 1), rejected)
      } else {
        recur frames(recovered, a.add_i32(rejected, 1))
      }
    };
    .(error: input.Error) {
      io.print(error.>select { input.Error.get }
        .>text.string_concat("\n")
        .>>text.string_concat("framing error: "))
    };
    .(done: input.Done) {
      io.print(fmt.int_to_string(rejected)
        .>text.string_concat("\n")
        .>>text.string_concat(" rejected=")
        .>>text.string_concat(fmt.int_to_string(recovered))
        .>>text.string_concat("complete: recovered="))
    }
  }
}

pub fn main() { io.print("Reed-Solomon erasures over F17\n"); frames(0, 0) }
