mod rs/symbols;

import list/core as c;
import list/list as l;
import macros/row_macros { macro select }
import rs/polynomial as p;
import testapi { type Bool; type I32; type String }
import testapi/fmt as fmt;
import testapi/text as text;

pub type Sample = { Coordinate: I32; Value: I32 };

pub type Word = c.List[Sample];

pub fn encode(message: p.Polynomial, coordinates: c.List[I32]) -> Word {
  l.map(
  , .(coordinate) { (Coordinate.mk(coordinate), Value.mk(p.horner(message, coordinate))) }
  , coordinates
  )
}

pub fn show(sample: Sample) -> String {
  text.string_concat(
  , fmt.int_to_string(sample.>select { Coordinate.get })
  , text.string_concat(":", fmt.int_to_string(sample.>select { Value.get }))
  )
}

pub fn values(word: Word) -> c.List[I32] {
  l.map(
  , .(sample) {
      sample.>select { Value.get }
    }
  , word
  )
}
