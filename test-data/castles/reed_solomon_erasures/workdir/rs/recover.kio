module rs/recover;

import list/core as c;
import list/list as l;
import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import macros/spine_macros(macro widen_sum);
import rs/field as f;
import rs/polynomial as p;
import rs/symbols as s;
import testapi(Bool, I32, String);
import testapi/arith as a;
import testapi/iter(loop);

pub type Decoded = { Coefficients: p.Polynomial; Repaired: s.Word; Erased: s.Word; Verified: I32 };

pub type Result = { Accepted: Decoded } | { Rejected: String };

rec(loop) fn valid_coordinates(rest: c.List[I32], seen: c.List[I32]) -> String | . {
  match(c.uncons(rest)) {
    .(coordinate: I32, tail: c.List[I32]) {
      if(f.valid(coordinate)) {
        if(l.elem(f.equal, coordinate, seen)) {
          "repeated codeword coordinate"[String].>widen_sum
        } else {
          recur valid_coordinates(tail, c.cons(coordinate, seen))
        }
      } else {
        "codeword coordinate outside F17"[String].>widen_sum
      }
    };
    .() { ().>widen_sum }
  }
}

rec(loop) fn valid_samples(rest: s.Word, coordinates: c.List[I32], seen: c.List[I32]) -> String | . {
  match(c.uncons(rest)) {
    .(sample: s.Sample, tail: s.Word) {
      let coordinate = sample.>select { s.Coordinate.get };
      if(f.valid(coordinate)) {
        if(f.valid(sample.>select { s.Value.get })) {
          if(l.elem(f.equal, coordinate, coordinates)) {
            if(l.elem(f.equal, coordinate, seen)) {
              "repeated surviving coordinate"[String].>widen_sum
            } else {
              recur valid_samples(tail, coordinates, c.cons(coordinate, seen))
            }
          } else {
            "surviving coordinate absent from codeword"[String].>widen_sum
          }
        } else {
          "surviving value outside F17"[String].>widen_sum
        }
      } else {
        "surviving coordinate outside F17"[String].>widen_sum
      }
    };
    .() { ().>widen_sum }
  }
}

type Basis = { Factors: p.Polynomial; Divisor: I32 };

fn term(sample: s.Sample, basis: s.Word) -> p.Polynomial | String {
  let coordinate = sample.>select { s.Coordinate.get };
  let product =
    l.foldl(
    , .(acc, other) {
        let root = other.>select { s.Coordinate.get };
        if(f.equal(coordinate, root)) {
          acc
        } else {
          (
          , Factors.mk(p.multiply_linear(acc.>select { Factors.get }, root))
          , Divisor.mk(f.multiply(acc.>select { Divisor.get }, f.subtract(coordinate, root)))
          )
        }
      }
    , (Factors.mk(c.singleton(1)), Divisor.mk(1))
    , basis
    );
  match(f.inverse(product.>select { Divisor.get })) {
    .(inverse: I32) {
      p.scale(product.>select { Factors.get }, f.multiply(sample.>select { s.Value.get }, inverse))
        .>widen_sum
    };
    .() { "singular interpolation basis"[String].>widen_sum }
  }
}

rec(loop) fn interpolate(rest: s.Word, basis: s.Word, total: p.Polynomial) -> p.Polynomial | String {
  match(c.uncons(rest)) {
    .(sample: s.Sample, tail: s.Word) {
      match(term(sample, basis)) {
        .(contribution: p.Polynomial) { recur interpolate(tail, basis, p.add(total, contribution)) };
        .(error: String) { error.>widen_sum }
      }
    };
    .() { total.>widen_sum }
  }
}

fn agrees(poly: p.Polynomial, samples: s.Word) -> Bool {
  l.foldl(
  , .(ok, sample) {
      if(ok) {
        f.equal(p.direct(poly, sample.>select { s.Coordinate.get }), sample.>select { s.Value.get })
      } else {
        .f
      }
    }
  , .t
  , samples
  )
}

fn reconstruct(poly: p.Polynomial, coordinates: c.List[I32], samples: s.Word) -> Result {
  if(agrees(poly, samples)) {
    let known = l.map(
    , .(sample) {
        sample.>select { s.Coordinate.get }
      }
    , samples
    );
    let repaired = l.map(
    , .(coordinate) { (s.Coordinate.mk(coordinate), s.Value.mk(p.direct(poly, coordinate))) }
    , coordinates
    );
    let erased = l.filter(
    , .(sample) {
        if(l.elem(f.equal, sample.>select { s.Coordinate.get }, known)) { .f } else { .t }
      }
    , repaired
    );
    Accepted.mk((
    , Coefficients.mk(poly)
    , Repaired.mk(repaired)
    , Erased.mk(erased)
    , Verified.mk(l.length(samples))
    ))
      .>widen_sum
  } else {
    Rejected.mk("surviving samples contradict degree bound").>widen_sum
  }
}

fn sufficient(dimension: I32, coordinates: c.List[I32], samples: s.Word) -> Result {
  if(a.lt_i32(l.length(samples), dimension)) {
    Rejected.mk("insufficient surviving symbols").>widen_sum
  } else {
    let basis = l.take(dimension, samples);
    match(interpolate(basis, basis, l.replicate(dimension, 0))) {
      .(poly: p.Polynomial) { reconstruct(poly, coordinates, samples) };
      .(error: String) { Rejected.mk(error).>widen_sum }
    }
  }
}

pub fn decode(dimension: I32, coordinates: c.List[I32], samples: s.Word) -> Result {
  if(a.lt_i32(l.length(coordinates), dimension)) {
    Rejected.mk("codeword shorter than message dimension").>widen_sum
  } else match(valid_coordinates(coordinates, c.nil[_])) {
    .(error: String) { Rejected.mk(error).>widen_sum };
    .() {
      match(valid_samples(samples, coordinates, c.nil[_])) {
        .(error: String) { Rejected.mk(error).>widen_sum };
        .() { sufficient(dimension, coordinates, samples) }
      }
    }
  }
}
