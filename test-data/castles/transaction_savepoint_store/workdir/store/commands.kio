mod store/commands;

import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import store/history as history;
import store/transactions as tx;
import testapi { type Bool; type I32; type String }
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/text as text;

pub type Command = { Opcode: String; Key: String; Argument: String };

pub type Read = { Parsed: Command } | { End: . } | { Malformed: String };

pub fn read() -> Read {
  match(io.read_ascii_line()) {
    .(opcode: String) {
      match(io.read_ascii_line()) {
        .(key: String) {
          match(io.read_ascii_line()) {
            .(argument: String) {
              widen_sum(Parsed.mk((Opcode.mk(opcode), Key.mk(key), Argument.mk(argument))))[Read]
            };
            .() { widen_sum(Malformed.mk("missing argument line"))[Read] }
          }
        };
        .() { widen_sum(Malformed.mk("missing key line"))[Read] }
      }
    };
    .() { widen_sum(End.mk(()))[Read] }
  }
}

pub fn apply(s: tx.State, c: Command) -> tx.Reply {
  let op = c.>select { Opcode.get };
  let key = c.>select { Key.get };
  if(text.string_eq(op, "BEGIN")) {
    tx.begin(s)
  } else if(text.string_eq(op, "PUT")) {
    match(fmt.string_to_int(c.>select { Argument.get })) {
      .(value: I32) { tx.put(s, key, value) };
      .() {
        tx.rejected(s, text.string_concat("invalid integer ", c.>select { Argument.get }))
      }
    }
  } else if(text.string_eq(op, "DELETE")) {
    tx.delete(s, key)
  } else if(text.string_eq(op, "SAVE")) {
    tx.save(s, key)
  } else if(text.string_eq(op, "ROLLBACK")) {
    tx.rollback(s, key)
  } else if(text.string_eq(op, "RELEASE")) {
    tx.release(s, key)
  } else if(text.string_eq(op, "COMMIT")) {
    tx.commit(s)
  } else if(text.string_eq(op, "ABORT")) {
    tx.abort(s)
  } else if(text.string_eq(op, "GET")) {
    tx.accepted(
    , s
    , text.string_concat(
      , "get "
      , text.string_concat(
        , key
        , text.string_concat(
          , "="
          , history.show_value(history.get(s.>select { tx.Working.get }, key))
          )
        )
      )
    )
  } else if(text.string_eq(op, "SNAPSHOT")) {
    tx.accepted(s, text.string_concat("snapshot ", key))
  } else {
    tx.rejected(s, text.string_concat("unknown operation ", op))
  }
}
