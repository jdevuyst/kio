mod store/history;

import list/core as cells;
import list/list as lists;
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }
import testapi/fmt as fmt;
import testapi/iter { fn loop }
import testapi/text as text;

pub type Entry = { Key: String; Value: I32 | .; Revision: I32 };

pub type Snapshot = { Head: I32; Journal: cells.List[Entry] };

pub fn empty() -> Snapshot { (Head.mk(0), Journal.mk(cells.nil[_])) }

pub fn write(s: Snapshot, key: String, value: I32 | ., revision: I32) -> Snapshot {
  (
  , Head.mk(revision)
  , Journal.mk(cells.cons(
    , (Key.mk(key), Value.mk(value), Revision.mk(revision))
    , s.>select { Journal.get }
    ))
  )
}

rec(loop) fn search(entries: cells.List[Entry], key: String) -> I32 | . {
  match(cells.uncons(entries)) {
    .(entry: Entry, rest: cells.List[Entry]) {
      if(text.string_eq(entry.>select { Key.get }, key)) {
        entry.>select { Value.get }
      } else {
        recur search(rest, key)
      }
    };
    .() { widen_sum(())[I32 | .] }
  }
}

pub fn get(s: Snapshot, key: String) -> I32 | . {
  search(s.>select { Journal.get }, key)
}

pub fn show_value(value: I32 | .) -> String {
  match(value) {
    .(n: I32) { fmt.int_to_string(n) };
    .() { "<missing>" }
  }
}

pub fn show_entry(entry: Entry) -> String {
  text.string_concat(
  , entry.>select { Key.get }
  , text.string_concat("=", show_value(entry.>select { Value.get }))
  )
}

rec(loop) fn visible_walk(
, entries: cells.List[Entry]
, seen: cells.List[String]
, visible: cells.List[Entry]
) -> cells.List[Entry] {
  match(cells.uncons(entries)) {
    .(entry: Entry, rest: cells.List[Entry]) {
      if(lists.elem(text.string_eq, entry.>select { Key.get }, seen)) {
        recur visible_walk(rest, seen, visible)
      } else {
        let next_seen = cells.cons(entry.>select { Key.get }, seen);
        match(entry.>select { Value.get }) {
          .(_n: I32) { recur visible_walk(rest, next_seen, cells.cons(entry, visible)) };
          .() { recur visible_walk(rest, next_seen, visible) }
        }
      }
    };
    .() { lists.reverse(visible) }
  }
}

pub fn visible(s: Snapshot) -> cells.List[Entry] {
  visible_walk(s.>select { Journal.get }, cells.nil[_], cells.nil[_])
}

pub fn view(s: Snapshot) -> String { lists.to_string(show_entry, visible(s)) }

fn show_revision(entry: Entry) -> String {
  text.string_concat(
  , show_entry(entry)
  , text.string_concat("@", fmt.int_to_string(entry.>select { Revision.get }))
  )
}

pub fn signature(s: Snapshot) -> String {
  text.string_concat(
  , fmt.int_to_string(s.>select { Head.get })
  , text.string_concat(":", lists.to_string(show_revision, s.>select { Journal.get }))
  )
}
