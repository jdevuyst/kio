module store/session;

import list/core as cells;
import list/list as lists;
import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import store/audit as audit;
import store/commands as commands;
import store/history as history;
import store/transactions as tx;
import testapi(Bool, I32, String);
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter(loop);
import testapi/text as text;

type Session = {
  Database: tx.State;
  Frozen: cells.List[audit.Frozen];
  Operations: I32;
  Rejected: I32;
  Failures: I32
};

fn print_reply(number: I32, reply: tx.Reply, ok: Bool) {
  let state = reply.>select { tx.Updated.get };
  let .(prefix: String) = if(reply.>select { tx.Successful.get }) { " OK " } else { " ERROR " };
  io.print(text.string_concat(
  , fmt.int_to_string(number)
  , text.string_concat(
    , text.string_concat(prefix, reply.>select { tx.Message.get })
    , text.string_concat(
      , text.string_concat(
        , " | revision="
        , fmt.int_to_string(state.>select { tx.Working.get }.>select { history.Head.get })
        )
      , text.string_concat(
        , text.string_concat(" values=", history.view(state.>select { tx.Working.get }))
        , text.string_concat(
          , text.string_concat(" savepoints=", tx.point_names(state))
          , text.string_concat(" audit=", text.string_concat(audit.status(ok), "\n"))
          )
        )
      )
    )
  ))
}

fn execute(session: Session, command: commands.Command) -> Session {
  let before = session.>select { Database.get };
  let reply = commands.apply(before, command);
  let after = reply.>select { tx.Updated.get };
  let number = arith.add_i32(session.>select { Operations.get }, 1);
  let frozen =
    if(text.string_eq(command.>select { commands.Opcode.get }, "SNAPSHOT")) {
      cells.cons(
      , audit.freeze(command.>select { commands.Key.get }, after.>select { tx.Working.get })
      , session.>select { Frozen.get }
      )
    } else {
      session.>select { Frozen.get }
    };
  let ok =
    if(audit.transition_ok(before, command, reply)) { audit.all_frozen_ok(frozen) } else { .f };
  let rejected =
    if(reply.>select { tx.Successful.get }) {
      session.>select { Rejected.get }
    } else {
      arith.add_i32(session.>select { Rejected.get }, 1)
    };
  let failures =
    if(ok) {
      session.>select { Failures.get }
    } else {
      arith.add_i32(session.>select { Failures.get }, 1)
    };
  print_reply(number, reply, ok);
  (
  , Database.mk(after)
  , Frozen.mk(frozen)
  , Operations.mk(number)
  , Rejected.mk(rejected)
  , Failures.mk(failures)
  )
}

rec(loop) fn print_snapshots(frozen: cells.List[audit.Frozen]) {
  match(cells.uncons(frozen)) {
    .(item: audit.Frozen, rest: cells.List[audit.Frozen]) {
      audit.print_frozen(item);
      recur print_snapshots(rest)
    };
    .() { () }
  }
}

fn finish(session: Session) {
  let state = session.>select { Database.get };
  print_snapshots(lists.reverse(session.>select { Frozen.get }));
  io.print(text.string_concat(
  , text.string_concat("summary operations=", fmt.int_to_string(session.>select { Operations.get }))
  , text.string_concat(
    , text.string_concat(" rejected=", fmt.int_to_string(session.>select { Rejected.get }))
    , text.string_concat(
      , text.string_concat(" commits=", fmt.int_to_string(state.>select { tx.Commits.get }))
      , text.string_concat(
        , text.string_concat(
          , " allocated-revisions="
          , fmt.int_to_string(state.>select { tx.Clock.get })
          )
        , text.string_concat(
          , " audit-failures="
          , text.string_concat(fmt.int_to_string(session.>select { Failures.get }), "\n")
          )
        )
      )
    )
  ));
  io.print(history.view(state.>select { tx.Committed.get })
    .>text.string_concat("\n")
    .>>text.string_concat("committed values="))
}

rec(loop) fn consume(session: Session) {
  match(commands.read()) {
    .(read: commands.Parsed) {
      recur consume(execute(session, read.>select { commands.Parsed.get }))
    };
    .(bad: commands.Malformed) {
      io.print(bad.>select { commands.Malformed.get }
        .>text.string_concat("\n")
        .>>text.string_concat("input error: "));
      finish(session)
    };
    .(_end: commands.End) { finish(session) }
  }
}

pub fn run() {
  io.print("persistent transaction store\n");
  consume((
  , Database.mk(tx.initial())
  , Frozen.mk(cells.nil[_])
  , Operations.mk(0)
  , Rejected.mk(0)
  , Failures.mk(0)
  ))
}
