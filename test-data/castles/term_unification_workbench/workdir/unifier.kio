mod unifier;

import list/core as lists;
import list/list as traversal;
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import substitutions as subst;
import terms as term;
import testapi { type Bool; type I32 }
import testapi/arith as arith;
import testapi/iter { fn loop }

type Equation = { Left: term.Term; Right: term.Term };

pub type Outcome =
  { Solved: subst.Substitution } | { Occurs: I32 } | { Clash: I32 & I32 } | { Arity: I32 & I32 }
  ;

rec(loop) fn pair_arguments(
, lefts: lists.List[term.Term]
, rights: lists.List[term.Term]
, paired: lists.List[Equation]
, pending: lists.List[Equation]
) -> lists.List[Equation] | Arity {
  match(lists.uncons(lefts)) {
    .(first: term.Term, rest: lists.List[term.Term]) {
      match(lists.uncons(rights)) {
        .(other: term.Term, others: lists.List[term.Term]) {
          recur pair_arguments(
          , rest
          , others
          , lists.cons((Left.mk(first), Right.mk(other)), paired)
          , pending
          )
        };
        .(_empty: .) { Arity.mk((traversal.length(lefts), 0)).>widen_sum }
      }
    };
    .(_empty: .) {
      if(traversal.null(rights)) {
        traversal.append(traversal.reverse(paired), pending).>widen_sum
      } else {
        Arity.mk((0, traversal.length(rights))).>widen_sum
      }
    }
  }
}

rec(loop) {
  fn bind(id: I32, value: term.Term, pending: lists.List[Equation], bindings: subst.Substitution) -> Outcome {
    if(term.equal(term.variable(id), value)) {
      recur solve_work(pending, bindings)
    } else if(term.occurs(id, value)) {
      Occurs.mk(id).>widen_sum
    } else {
      recur solve_work(pending, subst.extend(bindings, id, value))
    }
  };
  fn solve_work(pending: lists.List[Equation], bindings: subst.Substitution) -> Outcome {
    match(lists.uncons(pending)) {
      .(equation: Equation, rest: lists.List[Equation]) {
        let left = subst.apply(bindings, equation.>select { Left.get });
        let right = subst.apply(bindings, equation.>select { Right.get });
        match(left.>term.Term.get) {
          .(v: term.Variable) { recur bind(v.>term.Variable.get, right, rest, bindings) };
          .(symbol: I32, arguments: lists.List[term.Term]) {
            match(right.>term.Term.get) {
              .(v: term.Variable) { recur bind(v.>term.Variable.get, left, rest, bindings) };
              .(other: I32, other_arguments: lists.List[term.Term]) {
                if(arith.eq_i32(symbol, other)) {
                  match(pair_arguments(arguments, other_arguments, lists.nil[_], rest)) {
                    .(next: lists.List[Equation]) { recur solve_work(next, bindings) };
                    .(_mismatch: Arity) {
                      Arity.mk((traversal.length(arguments), traversal.length(other_arguments)))
                        .>widen_sum
                    }
                  }
                } else {
                  Clash.mk((symbol, other)).>widen_sum
                }
              }
            }
          }
        }
      };
      .(_empty: .) { Solved.mk(bindings).>widen_sum }
    }
  }
}

pub fn solve(left: term.Term, right: term.Term) -> Outcome {
  solve_work(lists.singleton((Left.mk(left), Right.mk(right))), subst.empty())
}
