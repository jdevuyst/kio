module unifier;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import list/core as lists;
import list/list as traversal;
import substitutions as subst;
import terms as term;
import testapi(Bool, I32);
import testapi/arith as arith;
import testapi/iter(loop);

labels Equation = { left: term.Term, right: term.Term };

pub labels Outcome =
  { solved: subst.Substitution }
  | { occurs: I32 }
  | { clash: I32 & I32 }
  | { arity: I32 & I32 };

rec(loop) fn pair_arguments(
  , lefts: lists.List(term.Term)
  , rights: lists.List(term.Term)
  , paired: lists.List(Equation)
  , pending: lists.List(Equation)
  ) -> lists.List(Equation) | Arity {
  match! lists.uncons(lefts) {
    .(first: term.Term, rest: lists.List(term.Term)) {
      match! lists.uncons(rights) {
        .(other: term.Term, others: lists.List(term.Term)) {
          rec pair_arguments(
            , rest
            , others
            , lists.cons({left = first, right = other}, paired)
            , pending
            )
        };
        .(_empty: .) { {arity = (traversal.length(lefts), 0)}.>widen_sum! }
      }
    };
    .(_empty: .) {
      if! traversal.null(rights) {
        traversal.append(traversal.reverse(paired), pending).>widen_sum!
      } else {
        {arity = (0, traversal.length(rights))}.>widen_sum!
      }
    }
  }
}

rec(loop) {
  fn bind(id: I32, value: term.Term, pending: lists.List(Equation), bindings: subst.Substitution) -> Outcome {
    if! term.equal(term.variable(id), value) {
      rec solve_work(pending, bindings)
    } else if! term.occurs(id, value) {
      {occurs = id}.>widen_sum!
    } else {
      rec solve_work(pending, subst.extend(bindings, id, value))
    }
  };
  fn solve_work(pending: lists.List(Equation), bindings: subst.Substitution) -> Outcome {
    match! lists.uncons(pending) {
      .(equation: Equation, rest: lists.List(Equation)) {
        let left = subst.apply(bindings, equation.?{left});
        let right = subst.apply(bindings, equation.?{right});
        match! left.>term.Term.unwrap {
          .(v: term.Variable) { rec bind(v.>term.Variable.get, right, rest, bindings) };
          .(symbol: I32, arguments: lists.List(term.Term)) {
            match! right.>term.Term.unwrap {
              .(v: term.Variable) { rec bind(v.>term.Variable.get, left, rest, bindings) };
              .(other: I32, other_arguments: lists.List(term.Term)) {
                if! arith.eq_i32(symbol, other) {
                  match! pair_arguments(arguments, other_arguments, lists.nil(), rest) {
                    .(next: lists.List(Equation)) { rec solve_work(next, bindings) };
                    .(_mismatch: Arity) {
                      {arity = (traversal.length(arguments), traversal.length(other_arguments))}
                        .>widen_sum!
                    }
                  }
                } else {
                  {clash = (symbol, other)}.>widen_sum!
                }
              }
            }
          }
        }
      };
      .(_empty: .) { {solved = bindings}.>widen_sum! }
    }
  }
}

pub fn solve(left: term.Term, right: term.Term) -> Outcome {
  solve_work(lists.singleton({left, right}), subst.empty())
}
