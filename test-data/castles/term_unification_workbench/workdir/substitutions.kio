mod substitutions;

import list/core as lists;
import list/list as traversal;
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import terms as term;
import testapi { type I32; type String }
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/iter { fn loop }
import testapi/text { fn string_concat }

pub type Binding = { Key: I32; Replacement: term.Term };

pub type Substitution = lists.List[Binding];

pub fn empty() -> Substitution { lists.nil[_] }

pub fn lookup(bindings: Substitution, id: I32) -> term.Term | . {
  match(traversal.find(
  , .(binding) {
      arith.eq_i32(binding.>select { Key.get }, id)
    }
  , bindings
  )) {
    .(binding: Binding) {
      binding.>select { Replacement.get }.>widen_sum
    };
    .(_missing: .) { ().>widen_sum }
  }
}

type Frame = { Symbol: I32; Completed: lists.List[term.Term]; Remaining: lists.List[term.Term] };

rec(loop) {
  fn descend(bindings: Substitution, original: term.Term, parents: lists.List[Frame]) -> term.Term {
    match(original.>term.Term.get) {
      .(v: term.Variable) {
        match(lookup(bindings, v.>term.Variable.get)) {
          .(replacement: term.Term) { recur ascend(bindings, replacement, parents) };
          .(_missing: .) { recur ascend(bindings, original, parents) }
        }
      };
      .(symbol: I32, arguments: lists.List[term.Term]) {
        match(lists.uncons(arguments)) {
          .(first: term.Term, rest: lists.List[term.Term]) {
            recur descend(
            , bindings
            , first
            , lists.cons(
              , (Symbol.mk(symbol), Completed.mk(lists.nil[_]), Remaining.mk(rest))
              , parents
              )
            )
          };
          .(_empty: .) { recur ascend(bindings, original, parents) }
        }
      }
    }
  };
  fn ascend(bindings: Substitution, value: term.Term, parents: lists.List[Frame]) -> term.Term {
    match(lists.uncons(parents)) {
      .(frame: Frame, outer: lists.List[Frame]) {
        let completed = lists.cons(value, frame.>select { Completed.get });
        match(lists.uncons(frame.>select { Remaining.get })) {
          .(first: term.Term, rest: lists.List[term.Term]) {
            recur descend(
            , bindings
            , first
            , lists.cons(
              , (
                , Symbol.mk(frame.>select { Symbol.get })
                , Completed.mk(completed)
                , Remaining.mk(rest)
                )
              , outer
              )
            )
          };
          .(_empty: .) {
            recur ascend(
            , bindings
            , term.node(frame.>select { Symbol.get }, traversal.reverse(completed))
            , outer
            )
          }
        }
      };
      .(_root: .) { value }
    }
  }
}

pub fn apply(bindings: Substitution, original: term.Term) -> term.Term {
  descend(bindings, original, lists.nil[_])
}

pub fn extend(bindings: Substitution, id: I32, value: term.Term) -> Substitution {
  let binding = (Key.mk(id), Replacement.mk(value));
  let singleton = lists.singleton(binding);
  let composed =
    traversal.map(
    , .(old) {
        (
        , Key.mk(old.>select { Key.get })
        , Replacement.mk(apply(singleton, old.>select { Replacement.get }))
        )
      }
    , bindings
    );
  lists.cons(binding, composed)
}

fn show_binding(binding: Binding) -> String {
  string_concat(
  , "v"
  , string_concat(
    , fmt.int_to_string(binding.>select { Key.get })
    , string_concat("=", term.render(binding.>select { Replacement.get }))
    )
  )
}

pub fn render(bindings: Substitution) -> String { traversal.to_string(show_binding, bindings) }
