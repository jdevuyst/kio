module testapi/main;

import list/list(varop [* *]);
import terms as term;
import testapi(I32, String);
import workbench as bench;

pub fn main() -> . {
  let x = term.variable(1);
  let y = term.variable(2);
  let z = term.variable(3);
  let a = term.atom(40);
  let b = term.atom(50);
  bench.run(
    , "nested composition"
    , term.node(10, [* x, term.node(20, [* y *]), z, y *])
    , term.node(10, [* term.node(30, [* z *]), term.node(20, [* a *]), b, a *])
    );
  bench.run("variable chain", term.node(10, [* x, y *]), term.node(10, [* y, term.atom(60) *]));
  bench.run("repeated variable conflict", term.node(10, [* x, x *]), term.node(10, [* a, b *]));
  bench.run("direct occurs failure", x, term.node(20, [* x *]));
  bench.run(
    , "indirect occurs failure"
    , term.node(10, [* x, y *])
    , term.node(10, [* y, term.node(20, [* x *]) *])
    );
  bench.run("arity conflict", term.node(10, [* x *]), term.node(10, [* a, b *]))
}
