mod terms;

import list/core as lists;
import list/list as traversal;
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/iter { fn loop }
import testapi/text { fn string_concat }

pub type { Variable: I32 }

pub rec type { Term: Variable | (I32 & lists.List[Term]) { pub mk; pub get } }

pub fn variable(id: I32) -> Term { Term.mk(Variable.mk(id).>widen_sum) }

pub fn node(symbol: I32, arguments: lists.List[Term]) -> Term {
  Term.mk((symbol, arguments).>widen_sum)
}

pub fn atom(symbol: I32) -> Term { node(symbol, lists.nil[_]) }

rec(loop) {
  pub fn render(term: Term) -> String {
    match(term.>Term.get) {
      .(v: Variable) {
        string_concat("v", fmt.int_to_string(v.>select { Variable.get }))
      };
      .(symbol: I32, arguments: lists.List[Term]) {
        string_concat(
        , "f"
        , string_concat(
          , fmt.int_to_string(symbol)
          , string_concat("(", string_concat(recur(cont) render_arguments(arguments), ")"))
          )
        )
      }
    }
  };
  fn render_arguments(arguments: lists.List[Term]) -> String {
    match(lists.uncons(arguments)) {
      .(first: Term, rest: lists.List[Term]) {
        let shown = recur(cont) render(first);
        if(traversal.null(rest)) {
          shown
        } else {
          string_concat(shown, string_concat(",", recur(cont) render_arguments(rest)))
        }
      };
      .(_empty: .) { "" }
    }
  }
}

rec(loop) fn occurs_in(id: I32, pending: lists.List[Term]) -> Bool {
  match(lists.uncons(pending)) {
    .(first: Term, rest: lists.List[Term]) {
      match(first.>Term.get) {
        .(v: Variable) {
          if(arith.eq_i32(id, v.>select { Variable.get })) { .t } else { recur occurs_in(id, rest) }
        };
        .(_symbol: I32, arguments: lists.List[Term]) {
          recur occurs_in(id, traversal.append(arguments, rest))
        }
      }
    };
    .(_empty: .) { .f }
  }
}

pub fn occurs(id: I32, term: Term) -> Bool { occurs_in(id, lists.singleton(term)) }

rec(loop) {
  pub fn equal(left: Term, right: Term) -> Bool {
    match(left.>Term.get) {
      .(v: Variable) {
        match(right.>Term.get) {
          .(w: Variable) {
            arith.eq_i32(v.>select { Variable.get }, w.>select { Variable.get })
          };
          .(_symbol: I32, _arguments: lists.List[Term]) { .f }
        }
      };
      .(symbol: I32, arguments: lists.List[Term]) {
        match(right.>Term.get) {
          .(_v: Variable) { .f };
          .(other: I32, other_arguments: lists.List[Term]) {
            if(arith.eq_i32(symbol, other)) {
              recur equal_arguments(arguments, other_arguments)
            } else {
              .f
            }
          }
        }
      }
    }
  };
  fn equal_arguments(left: lists.List[Term], right: lists.List[Term]) -> Bool {
    match(lists.uncons(left)) {
      .(first: Term, rest: lists.List[Term]) {
        match(lists.uncons(right)) {
          .(other: Term, others: lists.List[Term]) {
            if(recur(cont) equal(first, other)) { recur equal_arguments(rest, others) } else { .f }
          };
          .(_empty: .) { .f }
        }
      };
      .(_empty: .) { traversal.null(right) }
    }
  }
}
