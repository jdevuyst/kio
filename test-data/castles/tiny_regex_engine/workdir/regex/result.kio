module regex/result;

import macros/match(macro match);
import macros/row_macros(macro select);
import macros/spine_macros(macro widen_sum);
import regex/format(join4);
import testapi(String);

pub type Verdict = { Span: String } | { Miss: String };

pub fn hit(span: String) -> Verdict { (Span.mk(span).>widen_sum)[Verdict] }

pub fn fail(reason: String) -> Verdict { (Miss.mk(reason).>widen_sum)[Verdict] }

fn heading(pattern: String, candidate: String) -> String {
  join4("pattern ", pattern, " / ", candidate)
}

fn render_hit(pattern: String, candidate: String, span: String) -> String {
  join4(heading(pattern, candidate), " -> match ", span, "\n")
}

fn render_miss(pattern: String, candidate: String, reason: String) -> String {
  join4(heading(pattern, candidate), " -> miss ", reason, "\n")
}

pub fn render(pattern: String, candidate: String, verdict: Verdict) -> String {
  match(verdict) {
    (
    , .(s: Span) {
        render_hit(pattern, candidate, s.>select { Span.get })
      }
    , .(m: Miss) {
        render_miss(pattern, candidate, m.>select { Miss.get })
      }
    )
  }
}
