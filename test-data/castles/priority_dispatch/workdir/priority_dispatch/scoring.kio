module priority_dispatch/scoring;

import macros/control(macro if);
import macros/row_macros(macro select);
import priority_dispatch/model(
, Choice
, Choice_cpu
, Choice_deadline
, Choice_duration
, Choice_eligible
, Choice_id
, Choice_io
, Choice_name
, Choice_priority
, Choice_rank
, Job
, Job_cpu
, Job_deadline
, Job_duration
, Job_id
, Job_io
, Job_name
, Job_priority
, Slot
, Slot_cpu
, Slot_io
, choice
);
import testapi(Bool, I32);
import testapi/arith(add_i32, leq_i32, lt_i32, mul_i32, sub_i32);

pub fn and_bool(left: Bool, right: Bool) -> Bool {
  if(left) { right } else { .f }
}

pub fn not_bool(value: Bool) -> Bool {
  if(value) { .f } else { .t }
}

pub fn all_done(
, ingress_done: Bool
, backup_done: Bool
, alert_done: Bool
, reconcile_done: Bool
, audit_done: Bool
) -> Bool {
  and_bool(
  , ingress_done
  , and_bool(backup_done, and_bool(alert_done, and_bool(reconcile_done, audit_done)))
  )
}

fn fits(job: Job, slot: Slot) -> Bool {
  and_bool(
  , leq_i32(job.>select { Job_cpu.get }, slot.>select { Slot_cpu.get })
  , leq_i32(job.>select { Job_io.get }, slot.>select { Slot_io.get })
  )
}

pub fn rank_job(job: Job) -> I32 {
  sub_i32(
  , add_i32(
    , mul_i32(job.>select { Job_priority.get }, 100)
    , mul_i32(sub_i32(20, job.>select { Job_deadline.get }), 5)
    )
  , job.>select { Job_duration.get }
  )
}

pub fn choose_job(job: Job, slot: Slot, done: Bool) -> Choice {
  let eligible = and_bool(not_bool(done), fits(job, slot));
  let rank = if(eligible) { rank_job(job) } else { 0 };
  choice(
  , job.>select { Job_id.get }
  , job.>select { Job_name.get }
  , rank
  , job.>select { Job_priority.get }
  , job.>select { Job_deadline.get }
  , job.>select { Job_cpu.get }
  , job.>select { Job_io.get }
  , job.>select { Job_duration.get }
  , eligible
  )
}

pub fn better(left: Choice, right: Choice) -> Choice {
  let .(left_ok, left_rank) = left.>select { Choice_eligible.get; Choice_rank.get };
  let .(right_ok, right_rank) = right.>select { Choice_eligible.get; Choice_rank.get };
  if(left_ok) {
    if(right_ok) {
      if(lt_i32(right_rank, left_rank)) { left } else { right }
    } else {
      left
    }
  } else {
    right
  }
}

pub fn blocked_for(job: Job, slot: Slot, done: Bool) -> I32 {
  if(done) { 0 } else if(fits(job, slot)) { 0 } else { 1 }
}
