module priority_dispatch/model;

import macros/row_macros(macro record);
import testapi(Bool, I32, String);

pub type Job = {
  Job_id: I32;
  Job_name: String;
  Job_priority: I32;
  Job_deadline: I32;
  Job_cpu: I32;
  Job_io: I32;
  Job_duration: I32
};

pub type Slot = { Slot_tick: I32; Slot_cpu: I32; Slot_io: I32 };

pub type Choice = {
  Choice_id: I32;
  Choice_name: String;
  Choice_rank: I32;
  Choice_priority: I32;
  Choice_deadline: I32;
  Choice_cpu: I32;
  Choice_io: I32;
  Choice_duration: I32;
  Choice_eligible: Bool
};

pub type Dispatch_state = {
  State_tick: I32;
  State_ingress_done: Bool;
  State_backup_done: Bool;
  State_alert_done: Bool;
  State_reconcile_done: Bool;
  State_audit_done: Bool;
  State_dispatched: I32;
  State_blocked: I32;
  State_cpu: I32;
  State_io: I32;
  State_duration: I32;
  State_slack: I32
};

pub fn job(id: I32, name: String, priority: I32, deadline: I32, cpu: I32, io: I32, duration: I32) -> Job {
  record {
    Job_id.mk(id);
    Job_name.mk(name);
    Job_priority.mk(priority);
    Job_deadline.mk(deadline);
    Job_cpu.mk(cpu);
    Job_io.mk(io);
    Job_duration.mk(duration)
  }
}

pub fn slot(tick: I32, cpu: I32, io: I32) -> Slot {
  record { Slot_tick.mk(tick); Slot_cpu.mk(cpu); Slot_io.mk(io) }
}

pub fn choice(
, id: I32
, name: String
, rank: I32
, priority: I32
, deadline: I32
, cpu: I32
, io: I32
, duration: I32
, eligible: Bool
) -> Choice {
  record {
    Choice_id.mk(id);
    Choice_name.mk(name);
    Choice_rank.mk(rank);
    Choice_priority.mk(priority);
    Choice_deadline.mk(deadline);
    Choice_cpu.mk(cpu);
    Choice_io.mk(io);
    Choice_duration.mk(duration);
    Choice_eligible.mk(eligible)
  }
}

pub fn dispatch_state(
, tick: I32
, ingress_done: Bool
, backup_done: Bool
, alert_done: Bool
, reconcile_done: Bool
, audit_done: Bool
, dispatched: I32
, blocked: I32
, cpu: I32
, io: I32
, duration: I32
, slack: I32
) -> Dispatch_state {
  record {
    State_tick.mk(tick);
    State_ingress_done.mk(ingress_done);
    State_backup_done.mk(backup_done);
    State_alert_done.mk(alert_done);
    State_reconcile_done.mk(reconcile_done);
    State_audit_done.mk(audit_done);
    State_dispatched.mk(dispatched);
    State_blocked.mk(blocked);
    State_cpu.mk(cpu);
    State_io.mk(io);
    State_duration.mk(duration);
    State_slack.mk(slack)
  }
}

pub fn ingress_job() -> Job { job(1, "ingress", 4, 3, 2, 1, 2) }

pub fn backup_job() -> Job { job(2, "backup", 2, 5, 1, 2, 1) }

pub fn alert_job() -> Job { job(3, "alert", 5, 2, 1, 1, 1) }

pub fn reconcile_job() -> Job { job(4, "reconcile", 3, 4, 2, 0, 2) }

pub fn audit_job() -> Job { job(5, "audit", 4, 6, 1, 2, 1) }

pub fn initial_state() -> Dispatch_state { dispatch_state(0, .f, .f, .f, .f, .f, 0, 0, 0, 0, 0, 0) }
