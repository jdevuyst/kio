module priority_dispatch/planner;

import macros/control(macro if);
import macros/row_macros(macro select);
import priority_dispatch/model(
, Choice
, Choice_cpu
, Choice_deadline
, Choice_duration
, Choice_eligible
, Choice_id
, Choice_io
, Choice_name
, Choice_rank
, Dispatch_state
, Slot
, Slot_cpu
, Slot_io
, Slot_tick
, State_alert_done
, State_audit_done
, State_backup_done
, State_blocked
, State_cpu
, State_dispatched
, State_duration
, State_ingress_done
, State_io
, State_reconcile_done
, State_slack
, State_tick
, alert_job
, audit_job
, backup_job
, dispatch_state
, ingress_job
, initial_state
, reconcile_job
, slot
);
import priority_dispatch/scoring(all_done, better, blocked_for, choose_job);
import priority_dispatch/text as text;
import testapi(Bool, I32, String);
import testapi/arith(add_i32, eq_i32, lt_i32, sub_i32);
import testapi/io(print);
import testapi/iter(loop);

fn slot_for(tick: I32) -> Slot {
  if(eq_i32(tick, 0)) {
    slot(tick, 2, 1)
  } else if(eq_i32(tick, 1)) {
    slot(tick, 2, 2)
  } else if(eq_i32(tick, 2)) {
    slot(tick, 1, 2)
  } else if(eq_i32(tick, 3)) {
    slot(tick, 2, 1)
  } else {
    slot(tick, 1, 2)
  }
}

fn choose(state: Dispatch_state, slot_value: Slot) -> Choice {
  let .(ingress_done, backup_done, alert_done, reconcile_done, audit_done) =
    state.>select {
      State_ingress_done.get;
      State_backup_done.get;
      State_alert_done.get;
      State_reconcile_done.get;
      State_audit_done.get
    };
  let ingress = choose_job(ingress_job(), slot_value, ingress_done);
  let backup = choose_job(backup_job(), slot_value, backup_done);
  let alert = choose_job(alert_job(), slot_value, alert_done);
  let reconcile = choose_job(reconcile_job(), slot_value, reconcile_done);
  let audit = choose_job(audit_job(), slot_value, audit_done);
  better(better(better(better(ingress, backup), alert), reconcile), audit)
}

fn blocked_count(state: Dispatch_state, slot_value: Slot) -> I32 {
  let .(ingress_done, backup_done, alert_done, reconcile_done, audit_done) =
    state.>select {
      State_ingress_done.get;
      State_backup_done.get;
      State_alert_done.get;
      State_reconcile_done.get;
      State_audit_done.get
    };
  add_i32(
  , add_i32(
    , blocked_for(ingress_job(), slot_value, ingress_done)
    , blocked_for(backup_job(), slot_value, backup_done)
    )
  , add_i32(
    , add_i32(
      , blocked_for(alert_job(), slot_value, alert_done)
      , blocked_for(reconcile_job(), slot_value, reconcile_done)
      )
    , blocked_for(audit_job(), slot_value, audit_done)
    )
  )
}

fn trace_line(slot_value: Slot, choice_value: Choice, blocked: I32) -> String {
  text.cat5(
  , text.cat5(
    , "tick "
    , text.show_i32(slot_value.>select { Slot_tick.get })
    , " cap cpu="
    , text.show_i32(slot_value.>select { Slot_cpu.get })
    , " io="
    )
  , text.cat5(
    , text.show_i32(slot_value.>select { Slot_io.get })
    , " -> "
    , choice_value.>select { Choice_name.get }
    , " rank="
    , text.show_i32(choice_value.>select { Choice_rank.get })
    )
  , text.cat5(
    , " deadline="
    , text.show_i32(choice_value.>select { Choice_deadline.get })
    , " duration="
    , text.show_i32(choice_value.>select { Choice_duration.get })
    , " blocked="
    )
  , text.show_i32(blocked)
  , "\n"
  )
}

fn advance(state: Dispatch_state, choice_value: Choice, blocked: I32) -> Dispatch_state {
  let .(
  , tick
  , ingress_done
  , backup_done
  , alert_done
  , reconcile_done
  , audit_done
  , dispatched
  , blocked_total
  , cpu_total
  , io_total
  , duration_total
  , slack_total
  ) =
    state.>select {
      State_tick.get;
      State_ingress_done.get;
      State_backup_done.get;
      State_alert_done.get;
      State_reconcile_done.get;
      State_audit_done.get;
      State_dispatched.get;
      State_blocked.get;
      State_cpu.get;
      State_io.get;
      State_duration.get;
      State_slack.get
    };
  let .(id, cpu, io, duration, deadline, eligible) =
    choice_value.>select {
      Choice_id.get;
      Choice_cpu.get;
      Choice_io.get;
      Choice_duration.get;
      Choice_deadline.get;
      Choice_eligible.get
    };
  let next_tick = add_i32(tick, 1);
  if(eligible) {
    dispatch_state(
    , next_tick
    , if(eq_i32(id, 1)) { .t } else { ingress_done }
    , if(eq_i32(id, 2)) { .t } else { backup_done }
    , if(eq_i32(id, 3)) { .t } else { alert_done }
    , if(eq_i32(id, 4)) { .t } else { reconcile_done }
    , if(eq_i32(id, 5)) { .t } else { audit_done }
    , add_i32(dispatched, 1)
    , add_i32(blocked_total, blocked)
    , add_i32(cpu_total, cpu)
    , add_i32(io_total, io)
    , add_i32(duration_total, duration)
    , add_i32(slack_total, sub_i32(deadline, tick))
    )
  } else {
    dispatch_state(
    , next_tick
    , ingress_done
    , backup_done
    , alert_done
    , reconcile_done
    , audit_done
    , dispatched
    , add_i32(blocked_total, blocked)
    , cpu_total
    , io_total
    , duration_total
    , slack_total
    )
  }
}

rec(loop) fn run_loop(state: Dispatch_state) -> Dispatch_state {
  if(lt_i32(state.>select { State_tick.get }, 5)) {
    let slot_value = slot_for(state.>select { State_tick.get });
    let chosen = choose(state, slot_value);
    let blocked = blocked_count(state, slot_value);
    print(trace_line(slot_value, chosen, blocked));
    recur run_loop(advance(state, chosen, blocked))
  } else {
    state
  }
}

fn summary(state: Dispatch_state) -> String {
  let .(
  , ingress_done
  , backup_done
  , alert_done
  , reconcile_done
  , audit_done
  , dispatched
  , blocked
  , cpu
  , io
  , duration
  , slack
  ) =
    state.>select {
      State_ingress_done.get;
      State_backup_done.get;
      State_alert_done.get;
      State_reconcile_done.get;
      State_audit_done.get;
      State_dispatched.get;
      State_blocked.get;
      State_cpu.get;
      State_io.get;
      State_duration.get;
      State_slack.get
    };
  let complete = all_done(ingress_done, backup_done, alert_done, reconcile_done, audit_done);
  text.cat5(
  , text.cat5(
    , "summary dispatched="
    , text.show_i32(dispatched)
    , " blocked-slots="
    , text.show_i32(blocked)
    , " cpu="
    )
  , text.cat5(text.show_i32(cpu), " io=", text.show_i32(io), " duration=", text.show_i32(duration))
  , text.cat4(" slack=", text.show_i32(slack), " complete=", text.show_bool(complete))
  , "\n"
  , ""
  )
}

pub fn run() {
  print("priority dispatch trace\n");
  let final_state = run_loop(initial_state());
  print(summary(final_state))
}
