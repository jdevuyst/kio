module report/events;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import report/model as model;
import testapi(Bool, I32, String);
import testapi/arith as arith;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/text as text;

pub labels Event =
  { open_suite: String }
  | { close_suite: String & I32 }
  | { passed_case: model.Case }
  | { failed_case: model.Case }
  | { skipped_case: model.Case }
  | { invalid: String };

fn invalid(reason: String) -> Event { {invalid = reason}.>widen_sum! }

fn decode(tag: String, name: String, message: String, count: I32) -> Event {
  if! arith.lt_i32(count, 0) {
    invalid("negative count")
  } else if! text.string_eq(tag, "suite") {
    if! arith.leq_i32(count, 0) {
      {open_suite = name}.>widen_sum!
    } else {
      invalid("suite count must be zero")
    }
  } else if! text.string_eq(tag, "end") {
    {close_suite = (name, count)}.>widen_sum!
  } else {
    let test = {model.name, model.message, model.count};
    if! text.string_eq(tag, "pass") {
      {passed_case = test}.>widen_sum!
    } else if! text.string_eq(tag, "fail") {
      {failed_case = test}.>widen_sum!
    } else if! text.string_eq(tag, "skip") {
      {skipped_case = test}.>widen_sum!
    } else {
      invalid(text.string_concat("unknown event: ", tag))
    }
  }
}

fn read_count(tag: String, name: String, message: String) -> Event {
  match! io.read_ascii_line() {
    .(raw: String) {
      match! fmt.string_to_int(raw) {
        .(count: I32) { decode(tag, name, message, count) };
        .(_eof: .) { invalid(text.string_concat("invalid count: ", raw)) }
      }
    };
    .(_eof: .) { invalid("truncated event: missing count") }
  }
}

fn read_message(tag: String, name: String) -> Event {
  match! io.read_ascii_line() {
    .(message: String) { read_count(tag, name, message) };
    .(_eof: .) { invalid("truncated event: missing message") }
  }
}

pub fn read(tag: String) -> Event {
  match! io.read_ascii_line() {
    .(name: String) { read_message(tag, name) };
    .(_eof: .) { invalid("truncated event: missing name") }
  }
}
