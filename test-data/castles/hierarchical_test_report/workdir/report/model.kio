module report/model;

import list/core as cells;
import macros/row_macros(macro select, macro with);
import testapi(I32, String);
import testapi/arith as arith;

pub type Counts = { Passed: I32; Failed: I32; Skipped: I32 };

pub type Case = { Name: String; Message: String; Count: I32 };

pub rec type { Suite: String & Counts & cells.List[Suite] & cells.List[Case] { pub mk; pub get } }

pub type State = { Stack: cells.List[Suite]; Roots: cells.List[Suite]; Errors: cells.List[String] };

pub fn zero() -> Counts { (Passed.mk(0), Failed.mk(0), Skipped.mk(0)) }

pub fn combine(a: Counts, b: Counts) -> Counts {
  (
  , Passed.mk(arith.add_i32(a.>select { Passed.get }, b.>select { Passed.get }))
  , Failed.mk(arith.add_i32(a.>select { Failed.get }, b.>select { Failed.get }))
  , Skipped.mk(arith.add_i32(a.>select { Skipped.get }, b.>select { Skipped.get }))
  )
}

pub fn total(c: Counts) -> I32 {
  arith.add_i32(
  , c.>select { Passed.get }
  , arith.add_i32(c.>select { Failed.get }, c.>select { Skipped.get })
  )
}

pub fn empty_state() -> State {
  (Stack.mk(cells.nil[_]), Roots.mk(cells.nil[_]), Errors.mk(cells.nil[_]))
}

pub fn empty_suite(name: String) -> Suite { Suite.mk((name, zero(), cells.nil[_], cells.nil[_])) }

pub fn suite_name(s: Suite) -> String {
  let .(name, _counts, _children, _failures) = s.>Suite.get;
  name
}

pub fn suite_counts(s: Suite) -> Counts {
  let .(_name, counts, _children, _failures) = s.>Suite.get;
  counts
}

pub fn attach(parent: Suite, child: Suite) -> Suite {
  let .(name, counts, children, failures) = parent.>Suite.get;
  Suite.mk((name, combine(counts, suite_counts(child)), cells.cons(child, children), failures))
}

pub fn add_case(s: Suite, counts: Counts, failures: cells.List[Case]) -> Suite {
  let .(name, previous, children, _old_failures) = s.>Suite.get;
  Suite.mk((name, combine(previous, counts), children, failures))
}

pub fn failures(s: Suite) -> cells.List[Case] {
  let .(_name, _counts, _children, failures) = s.>Suite.get;
  failures
}

pub fn error(state: State, message: String) -> State {
  state.>with {
    Errors.mk(cells.cons(message, state.>select { Errors.get }))
  }
}
