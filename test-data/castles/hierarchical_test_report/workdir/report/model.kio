module report/model;

import list/core as cells;
import testapi(I32, String);
import testapi/arith as arith;

pub labels Counts = { passed: I32, failed: I32, skipped: I32 };

pub labels Case = { name: String, message: String, count: I32 };

pub rec newtype Suite : String & Counts & cells.List(Suite) & cells.List(Case) {
  pub constructor make;
  pub projector unpack
  }

pub labels State = {
  , stack: cells.List(Suite)
  , roots: cells.List(Suite)
  , errors: cells.List(String)
  };

pub fn zero() -> Counts { {passed = 0, failed = 0, skipped = 0} }

pub fn combine(a: Counts, b: Counts) -> Counts {
  {
    , passed = arith.add_i32(a.?{passed}, b.?{passed})
    , failed = arith.add_i32(a.?{failed}, b.?{failed})
    , skipped = arith.add_i32(a.?{skipped}, b.?{skipped})
    }
}

pub fn total(c: Counts) -> I32 {
  arith.add_i32(c.?{passed}, arith.add_i32(c.?{failed}, c.?{skipped}))
}

pub fn empty_state() -> State { {stack = cells.nil(), roots = cells.nil(), errors = cells.nil()} }

pub fn empty_suite(name: String) -> Suite { Suite.make(name, zero(), cells.nil(), cells.nil()) }

pub fn suite_name(s: Suite) -> String {
  let .(name, _counts, _children, _failures) = s.>Suite.unpack;
  name
}

pub fn suite_counts(s: Suite) -> Counts {
  let .(_name, counts, _children, _failures) = s.>Suite.unpack;
  counts
}

pub fn attach(parent: Suite, child: Suite) -> Suite {
  let .(name, counts, children, failures) = parent.>Suite.unpack;
  Suite.make(name, combine(counts, suite_counts(child)), cells.cons(child, children), failures)
}

pub fn add_case(s: Suite, counts: Counts, failures: cells.List(Case)) -> Suite {
  let .(name, previous, children, _old_failures) = s.>Suite.unpack;
  Suite.make(name, combine(previous, counts), children, failures)
}

pub fn failures(s: Suite) -> cells.List(Case) {
  let .(_name, _counts, _children, failures) = s.>Suite.unpack;
  failures
}

pub fn error(state: State, message: String) -> State {
  state.!{errors = cells.cons(message, state.?{errors})}
}
