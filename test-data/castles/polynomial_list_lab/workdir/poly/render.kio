/// Rendering: `[5, -2, 3]` becomes `3x^2 - 2x + 5`.
module poly/render;

import elab/control(if);
import list/core as lc;
import list/list as ll;
import poly/core as core;
import poly/integers as integers;
import testapi(Bool, I32, String);
import testapi/arith(eq_i32, lt_i32, sub_i32);
import testapi/fmt(int_to_string);
import testapi/iter(loop);
import testapi/text(string_concat);

/// Concatenates a list of fragments. Report lines are built as lists of pieces and
/// joined here instead of nesting concatenation at every call site.
pub fn join(parts: lc.List(String)) -> String {
  ll.foldl(.(acc: String, part: String) -> String { string_concat(acc, part) }, "", parts)
}

// The shipped fixtures keep every coefficient magnitude in range. Their sign belongs
// to the separator: only the leading term wears a bare `-`, and every later term
// wears an infix ` + ` or ` - ` around its positive magnitude.
fn sign_text(c: I32, leading: Bool) -> String {
  if! leading {
    if! lt_i32(c, 0) {
      "-"
    } else {
      ""
    }
  } else if! lt_i32(c, 0) {
    " - "
  } else {
    " + "
  }
}

fn power_text(i: I32) -> String {
  if! eq_i32(i, 1) {
    "x"
  } else {
    string_concat("x^", int_to_string(i))
  }
}

// A unit coefficient loses its `1` above degree 0 (`x^2`, not `1x^2`) but keeps
// it at degree 0, where there is no `x` left to carry the term.
fn term_text(c: I32, i: I32, leading: Bool) -> String {
  let magnitude = integers.abs(c);
  let body =
    if! eq_i32(i, 0) {
      int_to_string(magnitude)
    } else if! eq_i32(magnitude, 1) {
      power_text(i)
    } else {
      string_concat(int_to_string(magnitude), power_text(i))
    };
  string_concat(sign_text(c, leading), body)
}

// Walking degrees downward gives the conventional high-to-low reading order.
// `leading` stays true until the first non-zero coefficient is emitted, which is
// how a leading `-` is told apart from an infix ` - ` without ever measuring the
// text already written — the host tier supplies no string length or equality.
rec(loop) fn terms_from(acc: String, leading: Bool, i: I32, p: core.Poly) -> String {
  if! lt_i32(i, 0) {
    acc
  } else {
    let c = core.coeff_at(p, i);
    if! eq_i32(c, 0) {
      rec terms_from(acc, leading, sub_i32(i, 1), p)
    } else {
      rec terms_from(string_concat(acc, term_text(c, i, leading)), .f, sub_i32(i, 1), p)
    }
  }
}

/// Ordinary polynomial notation. Zero coefficients are omitted entirely, so
/// `[-4, 0, 1]` prints as `x^2 - 4`, and the zero polynomial — whose vector is
/// empty, so there is no term to lead with — prints as `0`.
pub fn show(p: core.Poly) -> String {
  if! core.is_zero(p) {
    "0"
  } else {
    terms_from("", .t, core.deg(p), p)
  }
}

/// The underlying coefficient vector, low degree first, rendered by the list
/// library's own `to_string`.
pub fn show_coeffs(p: core.Poly) -> String {
  ll.to_string(.(c: I32) -> String { int_to_string(c) }, core.coeffs(p))
}
