module testapi/main;

import scanner(checksum, class_for, command_tag, gate_target, script_len_tag, set_mark, token);
import testapi(I32, String);
import testapi/io(print);
import testapi/text(string_concat);

fn cat3(a: String, b: String, c: String) -> String { string_concat(a, string_concat(b, c)) }

fn cat5(a: String, b: String, c: String, d: String, e: String) -> String {
  string_concat(a, string_concat(b, string_concat(c, string_concat(d, e))))
}

fn open_line() -> String {
  let mark = "O";
  cat5(
    , "01 OPEN gate => cmd:"
    , command_tag(0, 4)
    , " target:"
    , gate_target(5, 9)
    , cat3(" class:", class_for(mark), cat3(" mark:", mark, "\n"))
    )
}

fn set_a_line() -> String {
  let mark = set_mark(14, 20);
  cat5(
    , "02 SET mode=A => cmd:"
    , command_tag(10, 13)
    , " target:"
    , token(14, 18)
    , cat3(" flag:A class:", class_for(mark), cat3(" mark:", mark, "\n"))
    )
}

fn ping_line() -> String {
  let mark = "P";
  cat5(
    , "03 PING 007 => cmd:"
    , command_tag(21, 25)
    , " target:"
    , token(26, 29)
    , cat3(" class:", class_for(mark), cat3(" mark:", mark, "\n"))
    )
}

fn bad_line() -> String {
  let mark = "X";
  cat5(
    , "04 BAD ?? => cmd:"
    , command_tag(30, 33)
    , " target:"
    , token(34, 36)
    , cat3(" class:", class_for(mark), cat3(" mark:", mark, "\n"))
    )
}

fn lock_line() -> String {
  let mark = "L";
  cat5(
    , "05 LOCK gate => cmd:"
    , command_tag(37, 41)
    , " target:"
    , gate_target(42, 46)
    , cat3(" class:", class_for(mark), cat3(" mark:", mark, "\n"))
    )
}

fn set_b_line() -> String {
  let mark = set_mark(51, 57);
  cat5(
    , "06 SET mode=B => cmd:"
    , command_tag(47, 50)
    , " target:"
    , token(51, 55)
    , cat3(" flag:B class:", class_for(mark), cat3(" mark:", mark, "\n"))
    )
}

fn summary_line() -> String {
  cat3("summary: ok=5 reject=1 checksum=", checksum("O", "A", "P", "X", "L", "B"), "\n")
}

pub fn main() -> . {
  print("gate_text_scanner\n");
  print(cat3("len: ", script_len_tag(), "\n"));
  print(open_line());
  print(set_a_line());
  print(ping_line());
  print(bad_line());
  print(lock_line());
  print(set_b_line());
  print(summary_line())
}
