mod circuit_netlist_eval/gates;

import circuit_netlist_eval/bool_logic as logic;
import circuit_netlist_eval/domain {
  type Checksum;
  type Enable;
  type Fanout_ok;
  type Fanout_probe;
  type Gate_ab_and;
  type Gate_bc_or;
  type Gate_enable_a;
  type Gate_mask;
  type Gate_xor;
  type Pin_a;
  type Pin_b;
  type Pin_c;
  type Probe_alarm;
  type Probe_carry;
  type Stage;
  type State;
  type Truth_ok;
  type Warning_count
}
import macros/row_macros { macro select; macro with }
import testapi { type Bool; type I32 }
import testapi/arith as arith;

pub fn and_gate(a: Bool, b: Bool) -> Bool { logic.b_and(a, b) }

pub fn or_gate(a: Bool, b: Bool) -> Bool { logic.b_or(a, b) }

pub fn xor_gate(a: Bool, b: Bool) -> Bool { logic.b_xor(a, b) }

fn carry_probe(s: State) -> Bool {
  logic.b_or(
  , s.>select { Gate_ab_and.get }
  , logic.b_and(s.>select { Pin_a.get }, s.>select { Pin_c.get })
  )
}

fn alarm_probe(s: State) -> Bool {
  logic.b_and(
  , s.>select { Enable.get }
  , logic.b_or(s.>select { Gate_xor.get }, logic.b_not(s.>select { Gate_mask.get }))
  )
}

fn checksum_part(left: I32, right: I32) -> I32 { arith.add_i32(left, right) }

fn signal_checksum(s: State, carry: Bool, alarm: Bool) -> I32 {
  checksum_part(
  , logic.bit_weight(s.>select { Pin_a.get }, 1)
  , checksum_part(
    , logic.bit_weight(s.>select { Pin_b.get }, 2)
    , checksum_part(
      , logic.bit_weight(s.>select { Pin_c.get }, 4)
      , checksum_part(
        , logic.bit_weight(s.>select { Enable.get }, 8)
        , checksum_part(
          , logic.bit_weight(s.>select { Gate_ab_and.get }, 16)
          , checksum_part(
            , logic.bit_weight(s.>select { Gate_bc_or.get }, 32)
            , checksum_part(
              , logic.bit_weight(s.>select { Gate_enable_a.get }, 64)
              , checksum_part(
                , logic.bit_weight(s.>select { Gate_xor.get }, 128)
                , checksum_part(
                  , logic.bit_weight(s.>select { Gate_mask.get }, 256)
                  , checksum_part(logic.bit_weight(carry, 512), logic.bit_weight(alarm, 1024))
                  )
                )
              )
            )
          )
        )
      )
    )
  )
}

pub fn eval_gate_layer(s: State) -> State {
  s.>with {
    Stage.mk(1);
    Gate_ab_and.mk(and_gate(s.>select { Pin_a.get }, s.>select { Pin_b.get }));
    Gate_bc_or.mk(or_gate(s.>select { Pin_b.get }, s.>select { Pin_c.get }));
    Gate_enable_a.mk(and_gate(s.>select { Enable.get }, s.>select { Pin_a.get }))
  }
}

pub fn eval_fanout_layer(s: State) -> State {
  s.>with {
    Stage.mk(2);
    Gate_xor.mk(xor_gate(s.>select { Gate_bc_or.get }, s.>select { Gate_enable_a.get }));
    Gate_mask.mk(or_gate(s.>select { Gate_ab_and.get }, s.>select { Pin_c.get }));
    Fanout_probe.mk(s.>select { Gate_bc_or.get })
  }
}

pub fn eval_probe_layer(s: State) -> State {
  let carry = carry_probe(s);
  let alarm = alarm_probe(s);
  let fanout_consistent = logic.b_eq(s.>select { Fanout_probe.get }, s.>select { Gate_bc_or.get });
  let xor_consistent =
    logic.b_eq(
    , s.>select { Gate_xor.get }
    , xor_gate(s.>select { Gate_bc_or.get }, s.>select { Gate_enable_a.get })
    );
  let mask_consistent =
    logic.b_eq(
    , s.>select { Gate_mask.get }
    , or_gate(s.>select { Gate_ab_and.get }, s.>select { Pin_c.get })
    );
  let truth_consistent = logic.b_and(xor_consistent, mask_consistent);
  s.>with {
    Stage.mk(3);
    Probe_carry.mk(carry);
    Probe_alarm.mk(alarm);
    Checksum.mk(signal_checksum(s, carry, alarm));
    Fanout_ok.mk(fanout_consistent);
    Truth_ok.mk(truth_consistent);
    Warning_count.mk(arith.add_i32(
    , logic.warning_bit(fanout_consistent)
    , logic.warning_bit(truth_consistent)
    ))
  }
}
