mod circuit_netlist_eval/domain;

import testapi { type Bool; type I32 }

pub type State = {
  Stage: I32;
  Pin_a: Bool;
  Pin_b: Bool;
  Pin_c: Bool;
  Enable: Bool;
  Gate_ab_and: Bool;
  Gate_bc_or: Bool;
  Gate_enable_a: Bool;
  Gate_xor: Bool;
  Gate_mask: Bool;
  Fanout_probe: Bool;
  Probe_carry: Bool;
  Probe_alarm: Bool;
  Checksum: I32;
  Fanout_ok: Bool;
  Truth_ok: Bool;
  Warning_count: I32
};
