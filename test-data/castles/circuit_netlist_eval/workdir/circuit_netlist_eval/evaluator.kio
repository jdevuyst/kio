mod circuit_netlist_eval/evaluator;

import circuit_netlist_eval/domain { type Stage; type State }
import circuit_netlist_eval/gates as gates;
import macros/control { macro if }
import macros/row_macros { macro select }
import testapi { type Bool; type I32 }
import testapi/arith as arith;
import testapi/iter { fn loop }

fn eval_next(s: State) -> State {
  if(arith.eq_i32(s.>select { Stage.get }, 0)) {
    gates.eval_gate_layer(s)
  } else if(arith.eq_i32(s.>select { Stage.get }, 1)) {
    gates.eval_fanout_layer(s)
  } else {
    gates.eval_probe_layer(s)
  }
}

pub rec(loop) fn settle(s: State) -> State {
  if(arith.lt_i32(s.>select { Stage.get }, 3)) { recur settle(eval_next(s)) } else { s }
}
