module flow/search;

import elab/control(if);
import elab/spine_elaborators(widen_sum);
import flow/math as math;
import flow/network as net;
import testapi(Array, Bool, I32);
import testapi/arith as a;
import testapi/array as ar;
import testapi/iter(loop);

rec(loop) fn reconstruct(
  , network: net.Network
  , parent: Array(I32)
  , source: I32
  , node: I32
  , path: Array(I32)
  ) -> Array(I32) {
  if! math.equal(node, source) {
    path
  } else {
    let edge_index = ar.array_get(parent, node);
    ar.array_push(path, edge_index);
    rec reconstruct(
      , network
      , parent
      , source
      , ar.array_get(network.?{net.edges}, edge_index).?{net.from}
      , path
      )
  }
}

rec(loop) fn walk(
  , network: net.Network
  , residual: Array(I32)
  , source: I32
  , sink: I32
  , parent: Array(I32)
  , seen: Array(Bool)
  , node: I32
  , index: I32
  ) -> Array(I32) | . {
  if! math.equal(node, sink) {
    reconstruct(network, parent, source, sink, ar.array_make_empty(I32, ())).>widen_sum!
  } else {
    let edges = network.?{net.edges};
    if! math.less(index, ar.array_len(edges)) {
      let edge = ar.array_get(edges, index);
      let usable = math.both(
        , math.equal(edge.?{net.from}, node)
        , math.both(
            , math.less(0, ar.array_get(residual, index))
            , math.invert(ar.array_get(seen, edge.?{net.to}))
            )
        );
      if! usable {
        ar.array_set(parent, edge.?{net.to}, index);
        ar.array_set(seen, edge.?{net.to}, .t);
        rec walk(network, residual, source, sink, parent, seen, edge.?{net.to}, 0)
      } else {
        rec walk(network, residual, source, sink, parent, seen, node, a.add_i32(index, 1))
      }
    } else if! math.equal(node, source) {
      ().>widen_sum!
    } else {
      let previous = ar.array_get(parent, node);
      rec walk(
        , network
        , residual
        , source
        , sink
        , parent
        , seen
        , ar.array_get(edges, previous).?{net.from}
        , a.add_i32(previous, 1)
        )
    }
  }
}

pub fn augmenting_path(network: net.Network, residual: Array(I32), source: I32, sink: I32) ->
  Array(I32) | .
   {
  let parent = ar.array_make_filled(network.?{net.vertices}, -1);
  let seen = ar.array_make_filled(network.?{net.vertices}, .f);
  ar.array_set(seen, source, .t);
  walk(network, residual, source, sink, parent, seen, source, 0)
}

rec(loop) fn scan_reachable(
  , network: net.Network
  , residual: Array(I32)
  , reached: Array(Bool)
  , queue: Array(I32)
  , node: I32
  , index: I32
  ) -> . {
  if! math.less(index, ar.array_len(network.?{net.edges})) {
    let edge = ar.array_get(network.?{net.edges}, index);
    if! math.both(
      , math.equal(edge.?{net.from}, node)
      , math.both(
          , math.less(0, ar.array_get(residual, index))
          , math.invert(ar.array_get(reached, edge.?{net.to}))
          )
      ) {
      ar.array_set(reached, edge.?{net.to}, .t);
      ar.array_push(queue, edge.?{net.to})
    } else {
      ()
    };
    rec scan_reachable(network, residual, reached, queue, node, a.add_i32(index, 1))
  } else {
    ()
  }
}

rec(loop) fn breadth_first(
  , network: net.Network
  , residual: Array(I32)
  , reached: Array(Bool)
  , queue: Array(I32)
  , head: I32
  ) -> Array(Bool) {
  if! math.less(head, ar.array_len(queue)) {
    scan_reachable(network, residual, reached, queue, ar.array_get(queue, head), 0);
    rec breadth_first(network, residual, reached, queue, a.add_i32(head, 1))
  } else {
    reached
  }
}

pub fn reachable(network: net.Network, residual: Array(I32), source: I32) -> Array(Bool) {
  let reached = ar.array_make_filled(network.?{net.vertices}, .f);
  let queue = ar.array_make_empty(I32, ());
  ar.array_set(reached, source, .t);
  ar.array_push(queue, source);
  breadth_first(network, residual, reached, queue, 0)
}
