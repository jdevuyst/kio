mod flow/search;

import flow/math as math;
import flow/network as net;
import macros/control { macro if }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Array; type Bool; type I32 }
import testapi/arith as a;
import testapi/array as ar;
import testapi/iter { fn loop }

rec(loop) fn reconstruct(
, network: net.Network
, parent: Array[I32]
, source: I32
, node: I32
, path: Array[I32]
) -> Array[I32] {
  if(math.equal(node, source)) {
    path
  } else {
    let edge_index = ar.array_get(parent, node);
    ar.array_push(path, edge_index);
    recur reconstruct(
    , network
    , parent
    , source
    , ar.array_get(network.>select { net.Edges.get }, edge_index).>select { net.From.get }
    , path
    )
  }
}

rec(loop) fn walk(
, network: net.Network
, residual: Array[I32]
, source: I32
, sink: I32
, parent: Array[I32]
, seen: Array[Bool]
, node: I32
, index: I32
) -> Array[I32] | . {
  if(math.equal(node, sink)) {
    reconstruct(network, parent, source, sink, ar.array_make_empty[I32](())).>widen_sum
  } else {
    let edges = network.>select { net.Edges.get };
    if(math.less(index, ar.array_len(edges))) {
      let edge = ar.array_get(edges, index);
      let usable = math.both(
      , math.equal(edge.>select { net.From.get }, node)
      , math.both(
        , math.less(0, ar.array_get(residual, index))
        , math.invert(ar.array_get(seen, edge.>select { net.To.get }))
        )
      );
      if(usable) {
        ar.array_set(parent, edge.>select { net.To.get }, index);
        ar.array_set(seen, edge.>select { net.To.get }, .t);
        recur walk(network, residual, source, sink, parent, seen, edge.>select { net.To.get }, 0)
      } else {
        recur walk(network, residual, source, sink, parent, seen, node, a.add_i32(index, 1))
      }
    } else if(math.equal(node, source)) {
      ().>widen_sum
    } else {
      let previous = ar.array_get(parent, node);
      recur walk(
      , network
      , residual
      , source
      , sink
      , parent
      , seen
      , ar.array_get(edges, previous).>select { net.From.get }
      , a.add_i32(previous, 1)
      )
    }
  }
}

pub fn augmenting_path(network: net.Network, residual: Array[I32], source: I32, sink: I32) ->
  Array[I32] | .
   {
  let .(parent: Array[I32]) = ar.array_make_filled(network.>select { net.Vertices.get }, -1);
  let .(seen: Array[Bool]) = ar.array_make_filled(network.>select { net.Vertices.get }, .f);
  ar.array_set(seen, source, .t);
  walk(network, residual, source, sink, parent, seen, source, 0)
}

rec(loop) fn scan_reachable(
, network: net.Network
, residual: Array[I32]
, reached: Array[Bool]
, queue: Array[I32]
, node: I32
, index: I32
) {
  if(math.less(index, ar.array_len(network.>select { net.Edges.get }))) {
    let edge = ar.array_get(network.>select { net.Edges.get }, index);
    if(math.both(
    , math.equal(edge.>select { net.From.get }, node)
    , math.both(
      , math.less(0, ar.array_get(residual, index))
      , math.invert(ar.array_get(reached, edge.>select { net.To.get }))
      )
    )) {
      ar.array_set(reached, edge.>select { net.To.get }, .t);
      ar.array_push(queue, edge.>select { net.To.get })
    } else {
      ()
    };
    recur scan_reachable(network, residual, reached, queue, node, a.add_i32(index, 1))
  } else {
    ()
  }
}

rec(loop) fn breadth_first(
, network: net.Network
, residual: Array[I32]
, reached: Array[Bool]
, queue: Array[I32]
, head: I32
) -> Array[Bool] {
  if(math.less(head, ar.array_len(queue))) {
    scan_reachable(network, residual, reached, queue, ar.array_get(queue, head), 0);
    recur breadth_first(network, residual, reached, queue, a.add_i32(head, 1))
  } else {
    reached
  }
}

pub fn reachable(network: net.Network, residual: Array[I32], source: I32) -> Array[Bool] {
  let .(reached: Array[Bool]) = ar.array_make_filled(network.>select { net.Vertices.get }, .f);
  let queue = ar.array_make_empty[I32](());
  ar.array_set(reached, source, .t);
  ar.array_push(queue, source);
  breadth_first(network, residual, reached, queue, 0)
}
