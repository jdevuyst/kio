mod flow/report;

import flow/certificate as cert;
import flow/fixtures as fixtures;
import flow/math as math;
import flow/network as net;
import flow/solver as solver;
import macros/control { macro if }
import macros/row_macros { macro select }
import testapi { type Array; type Bool; type I32; type String }
import testapi/arith as a;
import testapi/array as ar;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter { fn loop }
import testapi/text as text;

fn number(value: I32) { io.print(fmt.int_to_string(value)) }

fn flag(label: String, value: Bool) {
  io.print(label);
  io.print(fmt.bool_to_string(value));
  io.print("\n")
}

rec(loop) fn print_history(history: Array[solver.Augmentation], index: I32) {
  if(math.less(index, ar.array_len(history))) {
    let step = ar.array_get(history, index);
    io.print("  augment ");
    number(a.add_i32(index, 1));
    io.print(": ");
    io.print(step.>select { solver.Route.get });
    io.print(" amount=");
    number(step.>select { solver.Amount.get });
    io.print(" cancelled=");
    number(step.>select { solver.Cancelled.get });
    io.print("\n");
    recur print_history(history, a.add_i32(index, 1))
  } else {
    ()
  }
}

rec(loop) fn print_edges(network: net.Network, residual: Array[I32], index: I32) {
  if(math.less(index, ar.array_len(network.>select { net.Edges.get }))) {
    let edge = ar.array_get(network.>select { net.Edges.get }, index);
    if(edge.>select { net.Backward.get }) {
      ()
    } else {
      io.print("  link ");
      number(edge.>select { net.From.get });
      io.print("->");
      number(edge.>select { net.To.get });
      io.print(" flow=");
      number(a.sub_i32(edge.>select { net.Capacity.get }, ar.array_get(residual, index)));
      io.print("/");
      number(edge.>select { net.Capacity.get });
      io.print("\n")
    };
    recur print_edges(network, residual, a.add_i32(index, 1))
  } else {
    ()
  }
}

rec(loop) fn print_side(side: Array[Bool], node: I32, separator: String) {
  if(math.less(node, ar.array_len(side))) {
    if(ar.array_get(side, node)) {
      io.print(separator);
      number(node);
      recur print_side(side, a.add_i32(node, 1), ",")
    } else {
      recur print_side(side, a.add_i32(node, 1), separator)
    }
  } else {
    ()
  }
}

pub fn run(fixture: fixtures.Fixture) -> solver.Solution {
  let network = fixture.>select { fixtures.Network.get };
  let solution =
    solver.solve(
    , network
    , fixture.>select { fixtures.Source.get }
    , fixture.>select { fixtures.Sink.get }
    );
  let certificate =
    cert.inspect(
    , network
    , solution.>select { solver.Residual.get }
    , fixture.>select { fixtures.Source.get }
    , fixture.>select { fixtures.Sink.get }
    , solution.>select { solver.Value.get }
    );
  io.print(text.string_concat("network: ", fixture.>select { fixtures.Title.get }));
  io.print("\n");
  print_history(solution.>select { solver.History.get }, 0);
  print_edges(network, solution.>select { solver.Residual.get }, 0);
  io.print("  source side={");
  print_side(certificate.>select { cert.Source_side.get }, 0, "");
  io.print("} flow=");
  number(solution.>select { solver.Value.get });
  io.print(" cut=");
  number(certificate.>select { cert.Cut_capacity.get });
  io.print("\n");
  flag("  capacity bounds: ", certificate.>select { cert.Capacity_ok.get });
  flag("  reverse pairs: ", certificate.>select { cert.Pairing_ok.get });
  flag("  conservation: ", certificate.>select { cert.Conservation_ok.get });
  flag("  minimum-cut certificate: ", certificate.>select { cert.Boundary_ok.get });
  flag(
  , "  independent expected value: "
  , math.equal(solution.>select { solver.Value.get }, fixture.>select { fixtures.Expected.get })
  );
  solution
}

pub fn cancellation_witness(fixture: fixtures.Fixture, solution: solver.Solution) {
  let network = fixture.>select { fixtures.Network.get };
  let history = solution.>select { solver.History.get };
  let first = ar.array_get(history, 0);
  let second = ar.array_get(history, 1);
  let middle_edge = ar.array_get(network.>select { net.Edges.get }, 2);
  let remaining_flow =
    a.sub_i32(
    , middle_edge.>select { net.Capacity.get }
    , ar.array_get(solution.>select { solver.Residual.get }, 2)
    );
  let trace_ok =
    math.both(
    , text.string_eq(first.>select { solver.Route.get }, "0->1->2->3")
    , text.string_eq(second.>select { solver.Route.get }, "0->2-cancel->1->3")
    );
  let cancellation_ok =
    math.both(
    , math.equal(first.>select { solver.Cancelled.get }, 0)
    , math.both(
      , math.equal(second.>select { solver.Cancelled.get }, 1)
      , math.equal(remaining_flow, 0)
      )
    );
  flag("cancellation witness: ", math.both(trace_ok, cancellation_ok))
}

pub fn reject_damaged_witnesses(fixture: fixtures.Fixture, solution: solver.Solution) {
  let network = fixture.>select { fixtures.Network.get };
  let residual = solution.>select { solver.Residual.get };
  let source = fixture.>select { fixtures.Source.get };
  let sink = fixture.>select { fixtures.Sink.get };
  let value = solution.>select { solver.Value.get };
  let bad_bounds = ar.array_clone(residual);
  ar.array_set(bad_bounds, 0, -1);
  let bounds = cert.inspect(network, bad_bounds, source, sink, value);
  flag("reject negative residual: ", math.invert(bounds.>select { cert.Capacity_ok.get }));
  let bad_pair = ar.array_clone(residual);
  ar.array_set(bad_pair, 1, 0);
  let pairs = cert.inspect(network, bad_pair, source, sink, value);
  flag("reject broken reverse pair: ", math.invert(pairs.>select { cert.Pairing_ok.get }));
  let bad_balance = ar.array_clone(residual);
  ar.array_set(bad_balance, 0, 1);
  ar.array_set(bad_balance, 1, 0);
  let balance = cert.inspect(network, bad_balance, source, sink, value);
  flag(
  , "reject unconserved feasible edge flows: "
  , math.both(
    , balance.>select { cert.Capacity_ok.get }
    , math.both(
      , balance.>select { cert.Pairing_ok.get }
      , math.invert(balance.>select { cert.Conservation_ok.get })
      )
    )
  );
  let exaggerated = cert.inspect(network, residual, source, sink, a.add_i32(value, 1));
  flag("reject exaggerated value: ", math.invert(cert.valid(exaggerated)));
  flag(
  , "original witness remains valid: "
  , cert.valid(cert.inspect(network, residual, source, sink, value))
  )
}
