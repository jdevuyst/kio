module flow/network;

import elab/control(if);
import flow/math as math;
import testapi(Array, Bool, I32);
import testapi/arith as a;
import testapi/array as ar;
import testapi/iter(loop);

pub labels Edge = { from: I32, to: I32, capacity: I32, reverse: I32, backward: Bool };

pub labels Network = { vertices: I32, edges: Array(Edge) };

pub fn empty(vertices: I32) -> Network { {vertices, edges = ar.array_make_empty(Edge, ())} }

pub fn connect(network: Network, from: I32, to: I32, capacity: I32) -> . {
  let edges = network.?{edges};
  let index = ar.array_len(edges);
  ar.array_push(edges, {from, to, capacity, reverse = a.add_i32(index, 1), backward = .f});
  ar.array_push(edges, {from = to, to = from, capacity = 0, reverse = index, backward = .t})
}

rec(loop) fn fill(network: Network, index: I32, residual: Array(I32)) -> Array(I32) {
  if! math.less(index, ar.array_len(network.?{edges})) {
    ar.array_push(residual, ar.array_get(network.?{edges}, index).?{capacity});
    rec fill(network, a.add_i32(index, 1), residual)
  } else {
    residual
  }
}

pub fn initial_residual(network: Network) -> Array(I32) {
  fill(network, 0, ar.array_make_empty(I32, ()))
}
