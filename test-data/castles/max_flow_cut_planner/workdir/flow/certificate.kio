module flow/certificate;

import elab/control(if);
import flow/math as math;
import flow/network as net;
import flow/search as search;
import testapi(Array, Bool, I32);
import testapi/arith as a;
import testapi/array as ar;
import testapi/iter(loop);

pub labels Certificate = {
  , capacity_ok: Bool
  , pairing_ok: Bool
  , conservation_ok: Bool
  , boundary_ok: Bool
  , cut_capacity: I32
  , source_side: Array(Bool)
  };

rec(loop) fn capacity_bounds(network: net.Network, residual: Array(I32), index: I32) -> Bool {
  if! math.less(index, ar.array_len(network.?{net.edges})) {
    let edge = ar.array_get(network.?{net.edges}, index);
    let remaining = ar.array_get(residual, index);
    let bounds = if! edge.?{net.backward} {
      a.leq_i32(0, remaining)
    } else {
      math.both(a.leq_i32(0, remaining), a.leq_i32(remaining, edge.?{net.capacity}))
    };
    if! bounds {
      rec capacity_bounds(network, residual, a.add_i32(index, 1))
    } else {
      .f
    }
  } else {
    .t
  }
}

rec(loop) fn pairing(network: net.Network, residual: Array(I32), index: I32) -> Bool {
  if! math.less(index, ar.array_len(network.?{net.edges})) {
    let edge = ar.array_get(network.?{net.edges}, index);
    let back = ar.array_get(network.?{net.edges}, edge.?{net.reverse});
    let endpoints = math.both(
      , math.equal(edge.?{net.from}, back.?{net.to})
      , math.equal(edge.?{net.to}, back.?{net.from})
      );
    let identity = math.equal(back.?{net.reverse}, index);
    let total = math.equal(
      , a.add_i32(ar.array_get(residual, index), ar.array_get(residual, edge.?{net.reverse}))
      , a.add_i32(edge.?{net.capacity}, back.?{net.capacity})
      );
    if! math.both(endpoints, math.both(identity, total)) {
      rec pairing(network, residual, a.add_i32(index, 1))
    } else {
      .f
    }
  } else {
    .t
  }
}

rec(loop) fn accumulate(
  , network: net.Network
  , residual: Array(I32)
  , balances: Array(I32)
  , index: I32
  ) -> . {
  if! math.less(index, ar.array_len(network.?{net.edges})) {
    let edge = ar.array_get(network.?{net.edges}, index);
    if! edge.?{net.backward} {
      ()
    } else {
      let sent = a.sub_i32(edge.?{net.capacity}, ar.array_get(residual, index));
      let from = edge.?{net.from};
      let to = edge.?{net.to};
      ar.array_set(balances, from, a.sub_i32(ar.array_get(balances, from), sent));
      ar.array_set(balances, to, a.add_i32(ar.array_get(balances, to), sent))
    };
    rec accumulate(network, residual, balances, a.add_i32(index, 1))
  } else {
    ()
  }
}

rec(loop) fn balance_check(balances: Array(I32), source: I32, sink: I32, value: I32, node: I32) -> Bool {
  if! math.less(node, ar.array_len(balances)) {
    let expected = if! math.equal(node, source) {
      a.sub_i32(0, value)
    } else if! math.equal(node, sink) {
      value
    } else {
      0
    };
    if! math.equal(ar.array_get(balances, node), expected) {
      rec balance_check(balances, source, sink, value, a.add_i32(node, 1))
    } else {
      .f
    }
  } else {
    .t
  }
}

rec(loop) fn cut_sum(network: net.Network, side: Array(Bool), index: I32, total: I32) -> I32 {
  if! math.less(index, ar.array_len(network.?{net.edges})) {
    let edge = ar.array_get(network.?{net.edges}, index);
    let crosses = math.both(
      , ar.array_get(side, edge.?{net.from})
      , math.invert(ar.array_get(side, edge.?{net.to}))
      );
    let contribution = if! crosses {
      edge.?{net.capacity}
    } else {
      0
    };
    rec cut_sum(network, side, a.add_i32(index, 1), a.add_i32(total, contribution))
  } else {
    total
  }
}

rec(loop) fn closed_cut(network: net.Network, residual: Array(I32), side: Array(Bool), index: I32) -> Bool {
  if! math.less(index, ar.array_len(network.?{net.edges})) {
    let edge = ar.array_get(network.?{net.edges}, index);
    let crosses = math.both(
      , ar.array_get(side, edge.?{net.from})
      , math.invert(ar.array_get(side, edge.?{net.to}))
      );
    if! math.both(crosses, math.less(0, ar.array_get(residual, index))) {
      .f
    } else {
      rec closed_cut(network, residual, side, a.add_i32(index, 1))
    }
  } else {
    .t
  }
}

pub fn inspect(network: net.Network, residual: Array(I32), source: I32, sink: I32, value: I32) -> Certificate {
  let balances = ar.array_make_filled(network.?{net.vertices}, 0);
  accumulate(network, residual, balances, 0);
  let source_side = search.reachable(network, residual, source);
  let cut_capacity = cut_sum(network, source_side, 0, 0);
  let boundary_ok =
    math.both(
      , math.invert(ar.array_get(source_side, sink))
      , math.both(math.equal(cut_capacity, value), closed_cut(network, residual, source_side, 0))
      );
  {
    , capacity_ok = capacity_bounds(network, residual, 0)
    , pairing_ok = pairing(network, residual, 0)
    , conservation_ok = balance_check(balances, source, sink, value, 0)
    , boundary_ok
    , cut_capacity
    , source_side
    }
}

pub fn valid(certificate: Certificate) -> Bool {
  math.both(
    , certificate.?{capacity_ok}
    , math.both(
        , certificate.?{pairing_ok}
        , math.both(certificate.?{conservation_ok}, certificate.?{boundary_ok})
        )
    )
}
