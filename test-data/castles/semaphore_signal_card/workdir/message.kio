module message;

import alphabet as letters;
import alphabet(Card);
import alphabet(Crossed, High, Vowel);
import logic as bit;
import macros/row_macros(macro select);
import testapi(Bool);

// The host offers no loop, so the message is a fixed product of cards and the
// aggregate facts are folds written out over its nine slots.
pub type Message = Card & Card & Card & Card & Card & Card & Card & Card & Card;

pub type Facts = { Has_vowel: Bool; Crossings_even: Bool; Shapes_distinct: Bool };

pub fn spelled() -> Message {
  (
  , letters.s()
  , letters.e()
  , letters.m()
  , letters.a()
  , letters.p()
  , letters.h()
  , letters.o()
  , letters.r()
  , letters.e()
  )
}

// Two letters share a shape class when both Bool facts agree.
fn same_shape(x: Card, y: Card) -> Bool {
  bit.and(
  , bit.same(x.>select { Crossed.get }, y.>select { Crossed.get })
  , bit.same(x.>select { High.get }, y.>select { High.get })
  )
}

fn distinct(x: Card, y: Card) -> Bool { bit.not(same_shape(x, y)) }

pub fn facts(msg: Message) -> Facts {
  let .(c1: Card, c2: Card, c3: Card, c4: Card, c5: Card, c6: Card, c7: Card, c8: Card, c9: Card) =
    msg;
  let vowel_seen =
    c1.>select { Vowel.get }
      .>bit.or(c2.>select { Vowel.get })
      .>bit.or(c3.>select { Vowel.get })
      .>bit.or(c4.>select { Vowel.get })
      .>bit.or(c5.>select { Vowel.get })
      .>bit.or(c6.>select { Vowel.get })
      .>bit.or(c7.>select { Vowel.get })
      .>bit.or(c8.>select { Vowel.get })
      .>bit.or(c9.>select { Vowel.get });
  let parity =
    c1.>select { Crossed.get }
      .>bit.xor(c2.>select { Crossed.get })
      .>bit.xor(c3.>select { Crossed.get })
      .>bit.xor(c4.>select { Crossed.get })
      .>bit.xor(c5.>select { Crossed.get })
      .>bit.xor(c6.>select { Crossed.get })
      .>bit.xor(c7.>select { Crossed.get })
      .>bit.xor(c8.>select { Crossed.get })
      .>bit.xor(c9.>select { Crossed.get });
  let neighbours =
    distinct(c1, c2)
      .>bit.and(distinct(c2, c3))
      .>bit.and(distinct(c3, c4))
      .>bit.and(distinct(c4, c5))
      .>bit.and(distinct(c5, c6))
      .>bit.and(distinct(c6, c7))
      .>bit.and(distinct(c7, c8))
      .>bit.and(distinct(c8, c9));
  (Has_vowel.mk(vowel_seen), Crossings_even.mk(bit.not(parity)), Shapes_distinct.mk(neighbours))
}
