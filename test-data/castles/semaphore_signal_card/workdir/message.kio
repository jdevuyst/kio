module message;

import alphabet as letters;
import alphabet(Card);
import alphabet({crossed}, {high}, {vowel});
import logic as bit;
import testapi(Bool);

// The host offers no loop, so the message is a fixed product of cards and the
// aggregate facts are folds written out over its nine slots.
pub type Message = Card & Card & Card & Card & Card & Card & Card & Card & Card;

pub labels Facts = { has_vowel: Bool, crossings_even: Bool, shapes_distinct: Bool };

pub fn spelled() -> Message {
  (
    , letters.s()
    , letters.e()
    , letters.m()
    , letters.a()
    , letters.p()
    , letters.h()
    , letters.o()
    , letters.r()
    , letters.e()
    )
}

// Two letters share a shape class when both Bool facts agree.
fn same_shape(x: Card, y: Card) -> Bool {
  bit.and(bit.same(x.?{crossed}, y.?{crossed}), bit.same(x.?{high}, y.?{high}))
}

fn distinct(x: Card, y: Card) -> Bool { bit.not(same_shape(x, y)) }

pub fn facts(msg: Message) -> Facts {
  let .(c1: Card, c2: Card, c3: Card, c4: Card, c5: Card, c6: Card, c7: Card, c8: Card, c9: Card) =
    msg;
  let vowel_seen =
    c1.?{vowel}
      .>bit.or(c2.?{vowel})
      .>bit.or(c3.?{vowel})
      .>bit.or(c4.?{vowel})
      .>bit.or(c5.?{vowel})
      .>bit.or(c6.?{vowel})
      .>bit.or(c7.?{vowel})
      .>bit.or(c8.?{vowel})
      .>bit.or(c9.?{vowel});
  let parity =
    c1.?{crossed}
      .>bit.xor(c2.?{crossed})
      .>bit.xor(c3.?{crossed})
      .>bit.xor(c4.?{crossed})
      .>bit.xor(c5.?{crossed})
      .>bit.xor(c6.?{crossed})
      .>bit.xor(c7.?{crossed})
      .>bit.xor(c8.?{crossed})
      .>bit.xor(c9.?{crossed});
  let neighbours =
    distinct(c1, c2)
      .>bit.and(distinct(c2, c3))
      .>bit.and(distinct(c3, c4))
      .>bit.and(distinct(c4, c5))
      .>bit.and(distinct(c5, c6))
      .>bit.and(distinct(c6, c7))
      .>bit.and(distinct(c7, c8))
      .>bit.and(distinct(c8, c9));
  {has_vowel = vowel_seen, crossings_even = bit.not(parity), shapes_distinct = neighbours}
}
