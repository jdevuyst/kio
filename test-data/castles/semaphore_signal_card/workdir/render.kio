module render;

import alphabet(Card);
import alphabet(Crossed, Glyph, High, Left, Mnemonic, Right);
import macros/control(macro if);
import macros/row_macros(macro select);
import message(Crossings_even, Has_vowel, Shapes_distinct);
import message(Facts, Message);
import testapi(Bool, String);
import testapi/io(print);

fn word(flag: Bool) -> String {
  if(flag) { "yes" } else { "no" }
}

fn mark(flag: Bool) -> String {
  if(flag) { "[X]" } else { "[ ]" }
}

fn shape_code(card: Card) -> String {
  if(card.>select { Crossed.get }) {
    if(card.>select { High.get }) { "XH" } else { "X-" }
  } else if(card.>select { High.get }) {
    "-H"
  } else {
    "--"
  }
}

fn rule() { print("----------------------------------------------\n") }

// print adds no newline, so every row is a run of calls ending in one "\n".
fn shape_gap(card: Card) { print(" "); print(shape_code(card)) }

fn fact(label: String, flag: Bool) { print(label); print(word(flag)); print("\n") }

pub fn header() {
  print("SEMAPHORE SIGNAL CARD\n");
  print("message: SEMAPHORE\n");
  print("row: letter | left / right | crossed | mnemonic\n");
  rule()
}

pub fn row(card: Card) {
  print(card.>select { Glyph.get });
  print(" | ");
  print(card.>select { Left.get });
  print(" / ");
  print(card.>select { Right.get });
  print(" | ");
  print(mark(card.>select { Crossed.get }));
  print(" | ");
  print(card.>select { Mnemonic.get });
  print("\n")
}

pub fn footer(msg: Message, facts: Facts) {
  let .(c1: Card, c2: Card, c3: Card, c4: Card, c5: Card, c6: Card, c7: Card, c8: Card, c9: Card) =
    msg;
  rule();
  print("shape classes        ");
  print(shape_code(c1));
  shape_gap(c2);
  shape_gap(c3);
  shape_gap(c4);
  shape_gap(c5);
  shape_gap(c6);
  shape_gap(c7);
  shape_gap(c8);
  shape_gap(c9);
  print("\n");
  fact("contains a vowel     ", facts.>select { Has_vowel.get });
  fact("even arm crossings   ", facts.>select { Crossings_even.get });
  fact("neighbours distinct  ", facts.>select { Shapes_distinct.get })
}
