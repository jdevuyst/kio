module testapi/main;

import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import join/engine as engine;
import join/input as input;
import join/model as m;
import join/report as report;
import testapi(Bool, String);
import testapi/io as io;
import testapi/iter(loop);
import testapi/text as text;

rec(loop) fn replay(state: m.State, previous: String | .) -> . {
  match! input.next() {
    .(command: input.Begin) {
      io.print(text.string_concat("session ", text.string_concat(command.?{input.begin}, "\n")));
      rec replay(engine.empty(), previous)
    };
    .(command: input.Left_event) {
      let event = command.?{input.left_event};
      let next = engine.event(state, event, .t);
      report.admission("left", event, state, next);
      rec replay(next, previous)
    };
    .(command: input.Right_event) {
      let event = command.?{input.right_event};
      let next = engine.event(state, event, .f);
      report.admission("right", event, state, next);
      rec replay(next, previous)
    };
    .(command: input.Left_watermark) {
      let value = command.?{input.left_watermark};
      let next = engine.watermark(state, value, .t);
      report.watermark("left", value, state, next);
      rec replay(next, previous)
    };
    .(command: input.Right_watermark) {
      let value = command.?{input.right_watermark};
      let next = engine.watermark(state, value, .f);
      report.watermark("right", value, state, next);
      rec replay(next, previous)
    };
    .(command: input.Checkpoint) {
      report.checkpoint(command.?{input.checkpoint}, state);
      rec replay(state, previous)
    };
    .(_command: input.End) {
      report.finish(state);
      let signature = report.signature(state);
      match! previous {
        .(old: String) {
          io.print(if! text.string_eq(old, signature) {
            "arrival-order agreement: yes\n"
          } else {
            "arrival-order agreement: NO\n"
          })
        };
        .() { () }
      };
      rec replay(state, signature.>widen_sum!(String | .))
    };
    .() { () }
  }
}

pub fn main() -> . {
  io.print("Temporal join: equal keys, right time in [left-2,left+3]\n");
  replay(engine.empty(), ().>widen_sum!(String | .))
}
