mod join/model;

import list/core { type List }
import testapi { type I32; type String }

pub type Event = { Id: I32; Key: String; Time: I32 };

pub type Pair = { Left_id: I32; Right_id: I32 };

pub type State = {
  Left: List[Event];
  Right: List[Event];
  Pairs: List[Pair];
  Left_watermark: I32;
  Right_watermark: I32;
  Accepted_left: I32;
  Accepted_right: I32;
  Evicted_left: I32;
  Evicted_right: I32;
  Late: I32;
  Regressed: I32
};
