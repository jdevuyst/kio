module join/engine;

import join/model as m;
import list/core as core;
import list/list as lists;
import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import testapi(Bool, I32);
import testapi/arith as a;
import testapi/iter(loop);
import testapi/text as text;

pub fn empty() -> m.State {
  (
  , m.Left.mk(core.nil[_])
  , m.Right.mk(core.nil[_])
  , m.Pairs.mk(core.nil[_])
  , m.Left_watermark.mk(0)
  , m.Right_watermark.mk(0)
  , m.Accepted_left.mk(0)
  , m.Accepted_right.mk(0)
  , m.Evicted_left.mk(0)
  , m.Evicted_right.mk(0)
  , m.Late.mk(0)
  , m.Regressed.mk(0)
  )
}

fn matches(left: m.Event, right: m.Event) -> Bool {
  if(text.string_eq(left.>select { m.Key.get }, right.>select { m.Key.get })) {
    if(a.leq_i32(a.sub_i32(left.>select { m.Time.get }, 2), right.>select { m.Time.get })) {
      a.leq_i32(right.>select { m.Time.get }, a.add_i32(left.>select { m.Time.get }, 3))
    } else {
      .f
    }
  } else {
    .f
  }
}

rec(loop) fn probe(
, event: m.Event
, others: core.List[m.Event]
, from_left: Bool
, pairs: core.List[m.Pair]
) -> core.List[m.Pair] {
  match(core.uncons(others)) {
    .(other: m.Event, tail: core.List[m.Event]) {
      let .(left, right) = if(from_left) { (event, other) } else { (other, event) };
      let next =
        if(matches(left, right)) {
          core.cons(
          , (m.Left_id.mk(left.>select { m.Id.get }), m.Right_id.mk(right.>select { m.Id.get }))
          , pairs
          )
        } else {
          pairs
        };
      recur probe(event, tail, from_left, next)
    };
    .() { pairs }
  }
}

fn evict(state: m.State) -> m.State {
  let left =
    lists.filter(
    , .(event: m.Event) {
        a.leq_i32(
        , state.>select { m.Right_watermark.get }
        , a.add_i32(event.>select { m.Time.get }, 3)
        )
      }
    , state.>select { m.Left.get }
    );
  let right =
    lists.filter(
    , .(event: m.Event) {
        a.leq_i32(
        , state.>select { m.Left_watermark.get }
        , a.add_i32(event.>select { m.Time.get }, 2)
        )
      }
    , state.>select { m.Right.get }
    );
  (
  , m.Left.mk(left)
  , m.Right.mk(right)
  , m.Pairs.mk(state.>select { m.Pairs.get })
  , m.Left_watermark.mk(state.>select { m.Left_watermark.get })
  , m.Right_watermark.mk(state.>select { m.Right_watermark.get })
  , m.Accepted_left.mk(state.>select { m.Accepted_left.get })
  , m.Accepted_right.mk(state.>select { m.Accepted_right.get })
  , m.Evicted_left.mk(a.add_i32(
    , state.>select { m.Evicted_left.get }
    , a.sub_i32(lists.length(state.>select { m.Left.get }), lists.length(left))
    ))
  , m.Evicted_right.mk(a.add_i32(
    , state.>select { m.Evicted_right.get }
    , a.sub_i32(lists.length(state.>select { m.Right.get }), lists.length(right))
    ))
  , m.Late.mk(state.>select { m.Late.get })
  , m.Regressed.mk(state.>select { m.Regressed.get })
  )
}

pub fn event(state: m.State, value: m.Event, from_left: Bool) -> m.State {
  let watermark =
    if(from_left) {
      state.>select { m.Left_watermark.get }
    } else {
      state.>select { m.Right_watermark.get }
    };
  if(a.lt_i32(value.>select { m.Time.get }, watermark)) {
    (
    , m.Left.mk(state.>select { m.Left.get })
    , m.Right.mk(state.>select { m.Right.get })
    , m.Pairs.mk(state.>select { m.Pairs.get })
    , m.Left_watermark.mk(state.>select { m.Left_watermark.get })
    , m.Right_watermark.mk(state.>select { m.Right_watermark.get })
    , m.Accepted_left.mk(state.>select { m.Accepted_left.get })
    , m.Accepted_right.mk(state.>select { m.Accepted_right.get })
    , m.Evicted_left.mk(state.>select { m.Evicted_left.get })
    , m.Evicted_right.mk(state.>select { m.Evicted_right.get })
    , m.Late.mk(a.add_i32(state.>select { m.Late.get }, 1))
    , m.Regressed.mk(state.>select { m.Regressed.get })
    )
  } else {
    let others = if(from_left) {
      state.>select { m.Right.get }
    } else {
      state.>select { m.Left.get }
    };
    let pairs = probe(value, others, from_left, state.>select { m.Pairs.get });
    if(from_left) {
      evict((
      , m.Left.mk(core.cons(value, state.>select { m.Left.get }))
      , m.Right.mk(state.>select { m.Right.get })
      , m.Pairs.mk(pairs)
      , m.Left_watermark.mk(state.>select { m.Left_watermark.get })
      , m.Right_watermark.mk(state.>select { m.Right_watermark.get })
      , m.Accepted_left.mk(a.add_i32(state.>select { m.Accepted_left.get }, 1))
      , m.Accepted_right.mk(state.>select { m.Accepted_right.get })
      , m.Evicted_left.mk(state.>select { m.Evicted_left.get })
      , m.Evicted_right.mk(state.>select { m.Evicted_right.get })
      , m.Late.mk(state.>select { m.Late.get })
      , m.Regressed.mk(state.>select { m.Regressed.get })
      ))
    } else {
      evict((
      , m.Left.mk(state.>select { m.Left.get })
      , m.Right.mk(core.cons(value, state.>select { m.Right.get }))
      , m.Pairs.mk(pairs)
      , m.Left_watermark.mk(state.>select { m.Left_watermark.get })
      , m.Right_watermark.mk(state.>select { m.Right_watermark.get })
      , m.Accepted_left.mk(state.>select { m.Accepted_left.get })
      , m.Accepted_right.mk(a.add_i32(state.>select { m.Accepted_right.get }, 1))
      , m.Evicted_left.mk(state.>select { m.Evicted_left.get })
      , m.Evicted_right.mk(state.>select { m.Evicted_right.get })
      , m.Late.mk(state.>select { m.Late.get })
      , m.Regressed.mk(state.>select { m.Regressed.get })
      ))
    }
  }
}

pub fn watermark(state: m.State, value: I32, from_left: Bool) -> m.State {
  let current =
    if(from_left) {
      state.>select { m.Left_watermark.get }
    } else {
      state.>select { m.Right_watermark.get }
    };
  if(a.lt_i32(value, current)) {
    (
    , m.Left.mk(state.>select { m.Left.get })
    , m.Right.mk(state.>select { m.Right.get })
    , m.Pairs.mk(state.>select { m.Pairs.get })
    , m.Left_watermark.mk(state.>select { m.Left_watermark.get })
    , m.Right_watermark.mk(state.>select { m.Right_watermark.get })
    , m.Accepted_left.mk(state.>select { m.Accepted_left.get })
    , m.Accepted_right.mk(state.>select { m.Accepted_right.get })
    , m.Evicted_left.mk(state.>select { m.Evicted_left.get })
    , m.Evicted_right.mk(state.>select { m.Evicted_right.get })
    , m.Late.mk(state.>select { m.Late.get })
    , m.Regressed.mk(a.add_i32(state.>select { m.Regressed.get }, 1))
    )
  } else if(from_left) {
    evict((
    , m.Left.mk(state.>select { m.Left.get })
    , m.Right.mk(state.>select { m.Right.get })
    , m.Pairs.mk(state.>select { m.Pairs.get })
    , m.Left_watermark.mk(value)
    , m.Right_watermark.mk(state.>select { m.Right_watermark.get })
    , m.Accepted_left.mk(state.>select { m.Accepted_left.get })
    , m.Accepted_right.mk(state.>select { m.Accepted_right.get })
    , m.Evicted_left.mk(state.>select { m.Evicted_left.get })
    , m.Evicted_right.mk(state.>select { m.Evicted_right.get })
    , m.Late.mk(state.>select { m.Late.get })
    , m.Regressed.mk(state.>select { m.Regressed.get })
    ))
  } else {
    evict((
    , m.Left.mk(state.>select { m.Left.get })
    , m.Right.mk(state.>select { m.Right.get })
    , m.Pairs.mk(state.>select { m.Pairs.get })
    , m.Left_watermark.mk(state.>select { m.Left_watermark.get })
    , m.Right_watermark.mk(value)
    , m.Accepted_left.mk(state.>select { m.Accepted_left.get })
    , m.Accepted_right.mk(state.>select { m.Accepted_right.get })
    , m.Evicted_left.mk(state.>select { m.Evicted_left.get })
    , m.Evicted_right.mk(state.>select { m.Evicted_right.get })
    , m.Late.mk(state.>select { m.Late.get })
    , m.Regressed.mk(state.>select { m.Regressed.get })
    ))
  }
}
