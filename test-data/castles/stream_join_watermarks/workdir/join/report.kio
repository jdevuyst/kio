module join/report;

import join/model as m;
import list/core as core;
import list/list as lists;
import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import testapi(Bool, I32, String);
import testapi/arith as a;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter(loop);
import testapi/text as text;

fn same_pair(left: m.Pair, right: m.Pair) -> Bool {
  if(a.leq_i32(left.>select { m.Left_id.get }, right.>select { m.Left_id.get })) {
    if(a.leq_i32(right.>select { m.Left_id.get }, left.>select { m.Left_id.get })) {
      if(a.leq_i32(left.>select { m.Right_id.get }, right.>select { m.Right_id.get })) {
        a.leq_i32(right.>select { m.Right_id.get }, left.>select { m.Right_id.get })
      } else {
        .f
      }
    } else {
      .f
    }
  } else {
    .f
  }
}

fn before(left: m.Pair, right: m.Pair) -> Bool {
  if(a.lt_i32(left.>select { m.Left_id.get }, right.>select { m.Left_id.get })) {
    .t
  } else if(a.lt_i32(right.>select { m.Left_id.get }, left.>select { m.Left_id.get })) {
    .f
  } else {
    a.leq_i32(left.>select { m.Right_id.get }, right.>select { m.Right_id.get })
  }
}

rec(loop) fn insert(pair: m.Pair, sorted: core.List[m.Pair]) -> core.List[m.Pair] {
  match(core.uncons(sorted)) {
    .(head: m.Pair, tail: core.List[m.Pair]) {
      if(before(pair, head)) {
        core.cons(pair, sorted)
      } else {
        core.cons(head, recur(cont) insert(pair, tail))
      }
    };
    .() { core.singleton(pair) }
  }
}

fn pair_text(pair: m.Pair) -> String {
  text.string_concat(
  , fmt.int_to_string(pair.>select { m.Left_id.get })
  , text.string_concat("/", fmt.int_to_string(pair.>select { m.Right_id.get }))
  )
}

pub fn signature(state: m.State) -> String {
  let sorted =
    lists.foldl(
    , .(acc: core.List[m.Pair], pair: m.Pair) { insert(pair, acc) }
    , core.nil[_]
    , state.>select { m.Pairs.get }
    );
  lists.to_string(pair_text, sorted)
}

fn number(label: String, value: I32) { io.print(label); io.print(fmt.int_to_string(value)) }

pub fn checkpoint(label: String, state: m.State) {
  io.print(text.string_concat("checkpoint ", label));
  number(" wm=", state.>select { m.Left_watermark.get });
  number("/", state.>select { m.Right_watermark.get });
  number(" retained=", lists.length(state.>select { m.Left.get }));
  number("/", lists.length(state.>select { m.Right.get }));
  number(" evicted=", state.>select { m.Evicted_left.get });
  number("/", state.>select { m.Evicted_right.get });
  number(" pairs=", lists.length(state.>select { m.Pairs.get }));
  io.print("\n")
}

pub fn finish(state: m.State) {
  let unique =
    lists.foldl(
    , .(acc: core.List[m.Pair], pair: m.Pair) {
        if(lists.elem(same_pair, pair, acc)) { acc } else { core.cons(pair, acc) }
      }
    , core.nil[_]
    , state.>select { m.Pairs.get }
    );
  number("accepted=", state.>select { m.Accepted_left.get });
  number("/", state.>select { m.Accepted_right.get });
  number(" late=", state.>select { m.Late.get });
  number(" regressed-watermarks=", state.>select { m.Regressed.get });
  number(" emitted=", lists.length(state.>select { m.Pairs.get }));
  number(" distinct=", lists.length(unique));
  io.print("\n");
  io.print(signature(state).>text.string_concat("\n").>>text.string_concat("pairs "))
}

pub fn admission(side: String, event: m.Event, old: m.State, next: m.State) {
  if(a.lt_i32(old.>select { m.Late.get }, next.>select { m.Late.get })) {
    io.print(text.string_concat("late rejected ", side));
    number(" id=", event.>select { m.Id.get });
    number(" time=", event.>select { m.Time.get });
    io.print("\n")
  } else {
    ()
  }
}

pub fn watermark(side: String, value: I32, old: m.State, next: m.State) {
  if(a.lt_i32(old.>select { m.Regressed.get }, next.>select { m.Regressed.get })) {
    io.print(text.string_concat("watermark rejected ", side));
    number(" value=", value);
    io.print("\n")
  } else {
    ()
  }
}
