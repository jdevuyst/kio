/// The pattern language, as abstract syntax. Nothing here is parsed from
/// text: a pattern arrives already shaped as a tree, because this castle is
/// about what happens *after* parsing. The six node kinds are exactly the
/// input alphabet of Thompson's construction.
mod automata/pattern;

import automata/symbol { fn letter }
import macros/control { macro if }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }
import testapi/arith { fn lt_i32 }
import testapi/iter { fn loop }
import testapi/text { fn string_concat }

rec {
  pub type Node =
    | { Chr: I32 }
    | { Cat: Pattern & Pattern }
    | { Alt: Pattern & Pattern }
    | { Star: Pattern }
    | { Plus: Pattern }
    | { Opt: Pattern };
  pub type { Pattern: Node { mk; pub get } }
}

pub fn chr(code: I32) -> Pattern { Pattern.mk((Chr.mk(code).>widen_sum)[Node]) }

pub fn cat(left: Pattern, right: Pattern) -> Pattern {
  Pattern.mk((Cat.mk((left, right)).>widen_sum)[Node])
}

pub fn alt(left: Pattern, right: Pattern) -> Pattern {
  Pattern.mk((Alt.mk((left, right)).>widen_sum)[Node])
}

pub fn star(body: Pattern) -> Pattern { Pattern.mk((Star.mk(body).>widen_sum)[Node]) }

pub fn plus(body: Pattern) -> Pattern { Pattern.mk((Plus.mk(body).>widen_sum)[Node]) }

pub fn opt(body: Pattern) -> Pattern { Pattern.mk((Opt.mk(body).>widen_sum)[Node]) }

/// How tightly a node binds: alternation loosest, then concatenation, then
/// the postfix repetitions, with a bare letter tightest.
fn tightness(p: Pattern) -> I32 {
  match(p.>Pattern.get) {
    (
    , .(_x: Chr) { 3 }
    , .(_x: Cat) { 1 }
    , .(_x: Alt) { 0 }
    , .(_x: Star) { 2 }
    , .(_x: Plus) { 2 }
    , .(_x: Opt) { 2 }
    )
  }
}

/// `floor` is the tightness the parent needs from this child. Rendering a
/// child that binds looser than its floor requires parentheses — which is
/// the whole of why `(a|b)*abb` does not come back out as `((a|b))*(a)(b)(b)`.
rec(loop) fn show_at(p: Pattern, floor: I32) -> String {
  let text =
    match(p.>Pattern.get) {
      (
      , .(x: Chr) {
          letter(x.>select { Chr.get })
        }
      , .(x: Cat) {
          let .(left: Pattern, right: Pattern) = x.>select { Cat.get };
          string_concat(recur(cont) show_at(left, 1), recur(cont) show_at(right, 1))
        }
      , .(x: Alt) {
          let .(left: Pattern, right: Pattern) = x.>select { Alt.get };
          string_concat(
          , recur(cont) show_at(left, 0)
          , string_concat("|", recur(cont) show_at(right, 0))
          )
        }
      , .(x: Star) {
          string_concat(recur(cont) show_at(x.>select { Star.get }, 3), "*")
        }
      , .(x: Plus) {
          string_concat(recur(cont) show_at(x.>select { Plus.get }, 3), "+")
        }
      , .(x: Opt) {
          string_concat(recur(cont) show_at(x.>select { Opt.get }, 3), "?")
        }
      )
    };
  if(lt_i32(tightness(p), floor)) { string_concat("(", string_concat(text, ")")) } else { text }
}

pub fn show(p: Pattern) -> String { show_at(p, 0) }
