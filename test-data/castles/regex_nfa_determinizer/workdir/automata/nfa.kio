/// Thompson's construction: a pattern tree becomes a nondeterministic
/// automaton with epsilon transitions.
///
/// Every fragment the recursion builds has exactly one entry and one exit.
/// That invariant is why the operator cases never inspect what they wrap —
/// and why the three postfix operators differ only in which of the same
/// four epsilons they add.
module automata/nfa;

import automata/pattern(Alt, Cat, Chr, Opt, Pattern, Plus, Star);
import automata/seq(List, append, cons, one);
import automata/symbol(epsilon);
import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import testapi(Bool, I32);
import testapi/arith(add_i32);
import testapi/iter(loop);

/// One transition. `sym` is a letter code, or `epsilon()`.
pub type Edge = { Src: I32; Sym: I32; Dst: I32 };

pub type Edges = List[Edge];

fn edge(src: I32, sym: I32, dst: I32) -> Edge { (Src.mk(src), Sym.mk(sym), Dst.mk(dst)) }

pub fn edge_src(e: Edge) -> I32 {
  e.>select { Src.get }
}

pub fn edge_sym(e: Edge) -> I32 {
  e.>select { Sym.get }
}

pub fn edge_dst(e: Edge) -> I32 {
  e.>select { Dst.get }
}

pub type Nfa = { Nfa_count: I32; Nfa_start: I32; Nfa_accept: I32; Nfa_edges: Edges };

pub fn state_count(n: Nfa) -> I32 {
  n.>select { Nfa_count.get }
}

pub fn start_state(n: Nfa) -> I32 {
  n.>select { Nfa_start.get }
}

pub fn accept_state(n: Nfa) -> I32 {
  n.>select { Nfa_accept.get }
}

pub fn edges_of(n: Nfa) -> Edges {
  n.>select { Nfa_edges.get }
}

/// A fragment in progress: entry, exit, edges so far, and the lowest state
/// number still unused.
type Frag = { F_start: I32; F_accept: I32; F_next: I32; F_edges: Edges };

fn frag(f_start: I32, f_accept: I32, f_next: I32, f_edges: Edges) -> Frag {
  (F_start.mk(f_start), F_accept.mk(f_accept), F_next.mk(f_next), F_edges.mk(f_edges))
}

fn eps(src: I32, dst: I32) -> Edge { edge(src, epsilon(), dst) }

/// The shape `*`, `+`, and `?` share: a fresh entry `s` and exit `t` around
/// `inner`, always with the two epsilons that enter and leave it. `skip`
/// adds the bypass `s -> t`, so the body may be taken zero times; `again`
/// adds the back edge, so it may be taken more than once.
fn postfix(inner: Frag, skip: Bool, again: Bool) -> Frag {
  let s = inner.>select { F_next.get };
  let t = add_i32(s, 1);
  let body =
    cons(eps(s, inner.>select { F_start.get }), one(eps(inner.>select { F_accept.get }, t)));
  let bypassed = if(skip) { cons(eps(s, t), body) } else { body };
  let looped =
    if(again) {
      cons(eps(inner.>select { F_accept.get }, inner.>select { F_start.get }), bypassed)
    } else {
      bypassed
    };
  frag(s, t, add_i32(s, 2), append(inner.>select { F_edges.get }, looped))
}

/// In series: the left's exit epsilon-jumps to the right's entry, and no
/// new state is minted.
fn series(left: Frag, right: Frag) -> Frag {
  frag(
  , left.>select { F_start.get }
  , right.>select { F_accept.get }
  , right.>select { F_next.get }
  , append(
    , append(left.>select { F_edges.get }, right.>select { F_edges.get })
    , one(eps(left.>select { F_accept.get }, right.>select { F_start.get }))
    )
  )
}

/// In parallel: a fresh entry epsilon-forks into both, and both exits
/// epsilon-join into a fresh exit.
fn parallel(left: Frag, right: Frag) -> Frag {
  let s = right.>select { F_next.get };
  let t = add_i32(s, 1);
  let wiring =
    cons(
    , eps(s, left.>select { F_start.get })
    , cons(
      , eps(s, right.>select { F_start.get })
      , cons(eps(left.>select { F_accept.get }, t), one(eps(right.>select { F_accept.get }, t)))
      )
    );
  frag(
  , s
  , t
  , add_i32(s, 2)
  , append(append(left.>select { F_edges.get }, right.>select { F_edges.get }), wiring)
  )
}

/// State numbers are handed out in source order: `next` is the first free
/// number going in, and the fragment reports the first free number coming
/// out.
rec(loop) fn build(p: Pattern, next: I32) -> Frag {
  match(p.>Pattern.get) {
    (
    , .(x: Chr) {
        let t = add_i32(next, 1);
        frag(next, t, add_i32(next, 2), one(edge(next, x.>select { Chr.get }, t)))
      }
    , .(x: Cat) {
        let .(left: Pattern, right: Pattern) = x.>select { Cat.get };
        let built = recur(cont) build(left, next);
        series(built, recur(cont) build(right, built.>select { F_next.get }))
      }
    , .(x: Alt) {
        let .(left: Pattern, right: Pattern) = x.>select { Alt.get };
        let built = recur(cont) build(left, next);
        parallel(built, recur(cont) build(right, built.>select { F_next.get }))
      }
    , .(x: Star) {
        postfix(recur(cont) build(x.>select { Star.get }, next), .t, .t)
      }
    , .(x: Plus) {
        postfix(recur(cont) build(x.>select { Plus.get }, next), .f, .t)
      }
    , .(x: Opt) {
        postfix(recur(cont) build(x.>select { Opt.get }, next), .t, .f)
      }
    )
  }
}

pub fn compile(p: Pattern) -> Nfa {
  let built = build(p, 0);
  (
  , Nfa_count.mk(built.>select { F_next.get })
  , Nfa_start.mk(built.>select { F_start.get })
  , Nfa_accept.mk(built.>select { F_accept.get })
  , Nfa_edges.mk(built.>select { F_edges.get })
  )
}
