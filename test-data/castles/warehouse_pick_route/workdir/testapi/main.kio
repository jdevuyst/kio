module testapi/main;

import elab/control(if);
import testapi(Array, Bool, I32, String);
import testapi/arith as arith;
import testapi/array as array;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter(loop);
import testapi/text as text;

labels Choice = { chosen_index: I32, chosen_dist: I32 };

labels Plan = {
  , score: I32
  , route: Array(I32)
  , blocked: Array(Bool)
  , picks: Array(I32)
  , qty: Array(I32)
  };

fn node_count() -> I32 { 6 }

fn dock_node() -> I32 { 0 }

fn packing_node() -> I32 { 5 }

fn blocked_distance() -> I32 { 999 }

fn pick_count() -> I32 { 3 }

fn last_node_index() -> I32 { arith.sub_i32(node_count(), 1) }

fn graph_size() -> I32 { arith.mul_i32(node_count(), node_count()) }

fn edge_index(from_node: I32, to_node: I32) -> I32 {
  arith.add_i32(arith.mul_i32(from_node, node_count()), to_node)
}

fn eq_i32(left: I32, right: I32) -> Bool {
  if! arith.leq_i32(left, right) {
    arith.leq_i32(right, left)
  } else {
    .f
  }
}

fn lt_i32(left: I32, right: I32) -> Bool {
  if! arith.leq_i32(left, right) {
    if! eq_i32(left, right) {
      .f
    } else {
      .t
    }
  } else {
    .f
  }
}

fn not(value: Bool) -> Bool {
  if! value {
    .f
  } else {
    .t
  }
}

fn set_edge(graph: Array(I32), from_node: I32, to_node: I32, score: I32) -> . {
  array.array_set(graph, edge_index(from_node, to_node), score);
  array.array_set(graph, edge_index(to_node, from_node), score)
}

rec(loop) fn set_diagonal(node: I32, graph: Array(I32)) -> Array(I32) {
  if! arith.leq_i32(node, last_node_index()) {
    array.array_set(graph, edge_index(node, node), 0);
    rec set_diagonal(arith.add_i32(node, 1), graph)
  } else {
    graph
  }
}

fn apply_blocked_crosslink(graph: Array(I32), blocked: Array(Bool)) -> . {
  set_edge(graph, 2, 3, blocked_distance());
  array.array_set(blocked, edge_index(2, 3), .t);
  array.array_set(blocked, edge_index(3, 2), .t)
}

fn build_graph(blocked: Array(Bool)) -> Array(I32) {
  let graph = array.array_make_filled(graph_size(), blocked_distance());
  let ready = set_diagonal(0, graph);
  set_edge(ready, 0, 1, 2);
  set_edge(ready, 1, 2, 2);
  set_edge(ready, 2, 3, 2);
  set_edge(ready, 3, 4, 2);
  set_edge(ready, 4, 5, 3);
  set_edge(ready, 5, 0, 3);
  set_edge(ready, 1, 4, 6);
  apply_blocked_crosslink(ready, blocked);
  ready
}

fn build_pick_nodes() -> Array(I32) {
  let picks = array.array_make_empty(I32, ());
  array.array_push(picks, 2);
  array.array_push(picks, 3);
  array.array_push(picks, 4);
  picks
}

fn build_pick_qty() -> Array(I32) {
  let qty = array.array_make_empty(I32, ());
  array.array_push(qty, 3);
  array.array_push(qty, 1);
  array.array_push(qty, 2);
  qty
}

fn open_weight(weight: I32) -> Bool { lt_i32(weight, blocked_distance()) }

rec(loop) fn nearest_unsettled(
  , node: I32
  , distances: Array(I32)
  , settled: Array(Bool)
  , best_node: I32
  , best_dist: I32
  ) -> I32 {
  if! arith.leq_i32(node, last_node_index()) {
    let seen = array.array_get(settled, node);
    let dist = array.array_get(distances, node);
    if! not(seen) {
      if! lt_i32(dist, best_dist) {
        rec nearest_unsettled(arith.add_i32(node, 1), distances, settled, node, dist)
      } else {
        rec nearest_unsettled(arith.add_i32(node, 1), distances, settled, best_node, best_dist)
      }
    } else {
      rec nearest_unsettled(arith.add_i32(node, 1), distances, settled, best_node, best_dist)
    }
  } else {
    best_node
  }
}

rec(loop) fn relax_neighbors(neighbor: I32, current: I32, graph: Array(I32), distances: Array(I32)) -> Array(I32) {
  if! arith.leq_i32(neighbor, last_node_index()) {
    let weight = array.array_get(graph, edge_index(current, neighbor));
    if! open_weight(weight) {
      let here = array.array_get(distances, current);
      let candidate = arith.add_i32(here, weight);
      let previous = array.array_get(distances, neighbor);
      if! lt_i32(candidate, previous) {
        array.array_set(distances, neighbor, candidate);
        rec relax_neighbors(arith.add_i32(neighbor, 1), current, graph, distances)
      } else {
        rec relax_neighbors(arith.add_i32(neighbor, 1), current, graph, distances)
      }
    } else {
      rec relax_neighbors(arith.add_i32(neighbor, 1), current, graph, distances)
    }
  } else {
    distances
  }
}

rec(loop) fn relax_rounds(
  , round: I32
  , graph: Array(I32)
  , distances: Array(I32)
  , settled: Array(Bool)
  ) -> Array(I32) {
  if! arith.leq_i32(round, last_node_index()) {
    let current = nearest_unsettled(0, distances, settled, node_count(), blocked_distance());
    if! eq_i32(current, node_count()) {
      distances
    } else {
      array.array_set(settled, current, .t);
      let relaxed = relax_neighbors(0, current, graph, distances);
      rec relax_rounds(arith.add_i32(round, 1), graph, relaxed, settled)
    }
  } else {
    distances
  }
}

fn shortest_from(start: I32, graph: Array(I32)) -> Array(I32) {
  let distances = array.array_make_filled(node_count(), blocked_distance());
  let settled = array.array_make_filled(node_count(), .f);
  array.array_set(distances, start, 0);
  relax_rounds(0, graph, distances, settled)
}

rec(loop) fn choose_pick(
  , index: I32
  , pick_nodes: Array(I32)
  , picked: Array(Bool)
  , distances: Array(I32)
  , best_index: I32
  , best_dist: I32
  ) -> Choice {
  if! arith.leq_i32(index, arith.sub_i32(array.array_len(pick_nodes), 1)) {
    let already_picked = array.array_get(picked, index);
    if! not(already_picked) {
      let node = array.array_get(pick_nodes, index);
      let distance = array.array_get(distances, node);
      if! lt_i32(distance, best_dist) {
        rec choose_pick(arith.add_i32(index, 1), pick_nodes, picked, distances, index, distance)
      } else {
        rec choose_pick(
          , arith.add_i32(index, 1)
          , pick_nodes
          , picked
          , distances
          , best_index
          , best_dist
          )
      }
    } else {
      rec choose_pick(arith.add_i32(index, 1), pick_nodes, picked, distances, best_index, best_dist)
    }
  } else {
    {chosen_index = best_index, chosen_dist = best_dist}
  }
}

rec(loop) fn plan_picks(
  , remaining: I32
  , current: I32
  , score: I32
  , graph: Array(I32)
  , pick_nodes: Array(I32)
  , picked: Array(Bool)
  , route: Array(I32)
  ) -> I32 {
  if! arith.leq_i32(remaining, 0) {
    let back = shortest_from(current, graph);
    let home_dist = array.array_get(back, packing_node());
    array.array_push(route, packing_node());
    arith.add_i32(score, home_dist)
  } else {
    let distances = shortest_from(current, graph);
    let choice = choose_pick(0, pick_nodes, picked, distances, node_count(), blocked_distance());
    let chosen_index = choice.?{chosen_index};
    let chosen_dist = choice.?{chosen_dist};
    let chosen_node = array.array_get(pick_nodes, chosen_index);
    array.array_set(picked, chosen_index, .t);
    array.array_push(route, chosen_node);
    rec plan_picks(
      , arith.sub_i32(remaining, 1)
      , chosen_node
      , arith.add_i32(score, chosen_dist)
      , graph
      , pick_nodes
      , picked
      , route
      )
  }
}

fn node_name(node: I32) -> String {
  if! eq_i32(node, 0) {
    "Dock"
  } else if! eq_i32(node, 1) {
    "A1-front"
  } else if! eq_i32(node, 2) {
    "A1-rear"
  } else if! eq_i32(node, 3) {
    "B1-rear"
  } else if! eq_i32(node, 4) {
    "B2-front"
  } else {
    "Pack"
  }
}

fn sku_name(node: I32) -> String {
  if! eq_i32(node, 2) {
    "SKU-17"
  } else if! eq_i32(node, 3) {
    "SKU-42"
  } else {
    "SKU-88"
  }
}

rec(loop) fn route_text(index: I32, route: Array(I32), acc: String) -> String {
  if! arith.leq_i32(index, arith.sub_i32(array.array_len(route), 1)) {
    let node = array.array_get(route, index);
    let name = node_name(node);
    let next = if! eq_i32(index, 0) {
      text.string_concat(acc, name)
    } else {
      text.string_concat(acc, text.string_concat(" -> ", name))
    };
    rec route_text(arith.add_i32(index, 1), route, next)
  } else {
    acc
  }
}

rec(loop) fn pick_index_for_node(index: I32, node: I32, pick_nodes: Array(I32)) -> I32 {
  if! arith.leq_i32(index, arith.sub_i32(array.array_len(pick_nodes), 1)) {
    if! eq_i32(array.array_get(pick_nodes, index), node) {
      index
    } else {
      rec pick_index_for_node(arith.add_i32(index, 1), node, pick_nodes)
    }
  } else {
    node_count()
  }
}

fn pick_line(node: I32, qty: I32) -> String {
  text.string_concat(
    , sku_name(node)
    , text.string_concat(
        , " x"
        , text.string_concat(fmt.int_to_string(qty), text.string_concat(" @ ", node_name(node)))
        )
    )
}

rec(loop) fn pick_summary(
  , index: I32
  , route: Array(I32)
  , pick_nodes: Array(I32)
  , qty: Array(I32)
  , acc: String
  ) -> String {
  if! arith.leq_i32(index, pick_count()) {
    let route_node = array.array_get(route, index);
    let qty_index = pick_index_for_node(0, route_node, pick_nodes);
    let next_line = pick_line(route_node, array.array_get(qty, qty_index));
    let next = if! eq_i32(index, 1) {
      text.string_concat(acc, next_line)
    } else {
      text.string_concat(acc, text.string_concat("; ", next_line))
    };
    rec pick_summary(arith.add_i32(index, 1), route, pick_nodes, qty, next)
  } else {
    acc
  }
}

fn print_line(value: String) -> . { io.print(text.string_concat(value, "\n")) }

fn run_plan() -> Plan {
  let blocked = array.array_make_filled(graph_size(), .f);
  let graph = build_graph(blocked);
  let picks = build_pick_nodes();
  let qty = build_pick_qty();
  let picked = array.array_make_filled(array.array_len(picks), .f);
  let route = array.array_make_empty(I32, ());
  array.array_push(route, dock_node());
  let score = plan_picks(pick_count(), dock_node(), 0, graph, picks, picked, route);
  {score, route, blocked, picks, qty}
}

pub fn main() -> . {
  let plan = run_plan();
  let route = array.array_clone(plan.?{route});
  print_line("warehouse pick route");
  print_line(text.string_concat("nodes: ", fmt.int_to_string(node_count())));
  print_line(text.string_concat(
    , "blocked crosslink A1-rear <-> B1-rear: "
    , fmt.bool_to_string(array.array_get(plan.?{blocked}, edge_index(2, 3)))
    ));
  print_line(text.string_concat("route: ", route_text(0, route, "")));
  print_line(text.string_concat("picks: ", pick_summary(1, route, plan.?{picks}, plan.?{qty}, "")));
  print_line(text.string_concat("travel score: ", fmt.int_to_string(plan.?{score})))
}
