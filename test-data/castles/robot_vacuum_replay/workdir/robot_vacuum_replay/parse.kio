mod robot_vacuum_replay/parse;

import macros/control { macro if }
import macros/match { macro match }
import robot_vacuum_replay/command {
  type Command;
  fn charge_command;
  fn clean_command;
  fn dock_command;
  fn left_command;
  fn pause_command;
  fn right_command;
  fn start_command;
  fn step_command;
  fn unknown_command
}
import testapi { type Bool; type I32; type String }
import testapi/fmt { fn string_to_int }
import testapi/text { fn string_eq }

pub fn parse_command(line: String) -> Command {
  if(string_eq(line, "START")) {
    start_command()
  } else if(string_eq(line, "PAUSE")) {
    pause_command()
  } else if(string_eq(line, "LEFT")) {
    left_command()
  } else if(string_eq(line, "RIGHT")) {
    right_command()
  } else if(string_eq(line, "STEP")) {
    step_command()
  } else if(string_eq(line, "CLEAN")) {
    clean_command()
  } else if(string_eq(line, "DOCK")) {
    dock_command()
  } else match(string_to_int(line)) {
    (.(amount: I32) { charge_command(amount) }, .(_empty: .) { unknown_command(line) })
  }
}
