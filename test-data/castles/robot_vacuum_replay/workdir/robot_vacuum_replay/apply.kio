mod robot_vacuum_replay/apply;

import macros/match { macro match }
import macros/row_macros { macro select }
import robot_vacuum_replay/command {
  type Charge_cmd;
  type Clean_cmd;
  type Command;
  type Dock_cmd;
  type Left_cmd;
  type Pause_cmd;
  type Right_cmd;
  type Start_cmd;
  type Step_cmd;
  type Unknown_cmd
}
import robot_vacuum_replay/model {
  type Vacuum;
  fn apply_charge;
  fn apply_clean;
  fn apply_dock;
  fn apply_left;
  fn apply_pause;
  fn apply_right;
  fn apply_start;
  fn apply_step;
  fn apply_unknown
}

pub fn apply_command(state: Vacuum, cmd: Command) -> Vacuum {
  match(cmd) {
    (
    , .(_cmd: Start_cmd) { apply_start(state) }
    , .(_cmd: Pause_cmd) { apply_pause(state) }
    , .(_cmd: Left_cmd) { apply_left(state) }
    , .(_cmd: Right_cmd) { apply_right(state) }
    , .(_cmd: Step_cmd) { apply_step(state) }
    , .(_cmd: Clean_cmd) { apply_clean(state) }
    , .(_cmd: Dock_cmd) { apply_dock(state) }
    , .(charge: Charge_cmd) {
        apply_charge(state, charge.>select { Charge_cmd.get })
      }
    , .(_unknown: Unknown_cmd) { apply_unknown(state) }
    )
  }
}
