mod robot_vacuum_replay/render;

import macros/match { macro match }
import macros/row_macros { macro select }
import robot_vacuum_replay/command {
  type Charge_cmd;
  type Clean_cmd;
  type Command;
  type Dock_cmd;
  type Left_cmd;
  type Pause_cmd;
  type Right_cmd;
  type Start_cmd;
  type Step_cmd;
  type Unknown_cmd
}
import robot_vacuum_replay/model {
  type Battery;
  type Cleaning;
  type Commands;
  type Direction;
  type Dirt;
  type Docked;
  type East;
  type Facing;
  type Faults;
  type Idle;
  type Mode;
  type North;
  type Paused;
  type Run_mode;
  type South;
  type Vacuum;
  type West;
  type X;
  type Y
}
import robot_vacuum_replay/text { fn cat2; fn cat3; fn cat4; fn cat5; fn cat6; fn cat7 }
import testapi { type String }
import testapi/fmt { fn i32_to_string }

fn direction_name(d: Direction) -> String {
  match(d) {
    (.(_n: North) { "N" }, .(_e: East) { "E" }, .(_s: South) { "S" }, .(_w: West) { "W" })
  }
}

fn mode_name(m: Run_mode) -> String {
  match(m) {
    (
    , .(_docked: Docked) { "docked" }
    , .(_idle: Idle) { "idle" }
    , .(_cleaning: Cleaning) { "cleaning" }
    , .(_paused: Paused) { "paused" }
    )
  }
}

fn command_name(cmd: Command) -> String {
  match(cmd) {
    (
    , .(_cmd: Start_cmd) { "START" }
    , .(_cmd: Pause_cmd) { "PAUSE" }
    , .(_cmd: Left_cmd) { "LEFT" }
    , .(_cmd: Right_cmd) { "RIGHT" }
    , .(_cmd: Step_cmd) { "STEP" }
    , .(_cmd: Clean_cmd) { "CLEAN" }
    , .(_cmd: Dock_cmd) { "DOCK" }
    , .(charge: Charge_cmd) {
        cat3("CHARGE(", i32_to_string(charge.>select { Charge_cmd.get }), ")")
      }
    , .(unknown: Unknown_cmd) {
        cat3("UNKNOWN(", unknown.>select { Unknown_cmd.get }, ")")
      }
    )
  }
}

fn position_text(s: Vacuum) -> String {
  cat5("pos=(", i32_to_string(s.>select { X.get }), ",", i32_to_string(s.>select { Y.get }), ")")
}

fn compact_state(s: Vacuum) -> String {
  let prefix =
    cat7(
    , "mode="
    , mode_name(s.>select { Mode.get })
    , " "
    , position_text(s)
    , " dir="
    , direction_name(s.>select { Facing.get })
    , " battery="
    );
  let with_battery = cat2(prefix, i32_to_string(s.>select { Battery.get }));
  let with_dirt = cat3(with_battery, " dirt=", i32_to_string(s.>select { Dirt.get }));
  cat3(with_dirt, " faults=", i32_to_string(s.>select { Faults.get }))
}

pub fn transcript_line(cmd: Command, state: Vacuum) -> String {
  cat7(
  , "#"
  , i32_to_string(state.>select { Commands.get })
  , " "
  , command_name(cmd)
  , " "
  , compact_state(state)
  , "\n"
  )
}

pub fn summary_line(state: Vacuum) -> String {
  let prefix = cat3("summary commands=", i32_to_string(state.>select { Commands.get }), " ");
  cat2(prefix, cat2(compact_state(state), "\n"))
}
