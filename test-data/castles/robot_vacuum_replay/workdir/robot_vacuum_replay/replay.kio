mod robot_vacuum_replay/replay;

import macros/match { macro match }
import robot_vacuum_replay/apply { fn apply_command }
import robot_vacuum_replay/model { type Vacuum; fn initial_vacuum }
import robot_vacuum_replay/parse { fn parse_command }
import robot_vacuum_replay/render { fn summary_line; fn transcript_line }
import testapi { type String }
import testapi/io { fn print; fn read_ascii_line }
import testapi/iter { fn loop }

rec(loop) fn replay_lines(state: Vacuum) -> Vacuum {
  match(read_ascii_line()) {
    (
    , .(line: String) {
        let cmd = parse_command(line);
        let next = apply_command(state, cmd);
        print(transcript_line(cmd, next));
        recur replay_lines(next)
      }
    , .(_done: .) { state }
    )
  }
}

pub fn run() {
  print("robot_vacuum_replay\n");
  let final_state = replay_lines(initial_vacuum());
  print(summary_line(final_state))
}
