module robot_vacuum_replay/command;

import macros/spine_macros(macro widen_sum);
import testapi(I32, String);

pub type Command =
  | { Start_cmd: . }
  | { Pause_cmd: . }
  | { Left_cmd: . }
  | { Right_cmd: . }
  | { Step_cmd: . }
  | { Clean_cmd: . }
  | { Dock_cmd: . }
  | { Charge_cmd: I32 }
  | { Unknown_cmd: String }
  ;

pub fn start_command() -> Command { (Start_cmd.mk(()).>widen_sum)[Command] }

pub fn pause_command() -> Command { (Pause_cmd.mk(()).>widen_sum)[Command] }

pub fn left_command() -> Command { (Left_cmd.mk(()).>widen_sum)[Command] }

pub fn right_command() -> Command { (Right_cmd.mk(()).>widen_sum)[Command] }

pub fn step_command() -> Command { (Step_cmd.mk(()).>widen_sum)[Command] }

pub fn clean_command() -> Command { (Clean_cmd.mk(()).>widen_sum)[Command] }

pub fn dock_command() -> Command { (Dock_cmd.mk(()).>widen_sum)[Command] }

pub fn charge_command(amount: I32) -> Command { (Charge_cmd.mk(amount).>widen_sum)[Command] }

pub fn unknown_command(line: String) -> Command { (Unknown_cmd.mk(line).>widen_sum)[Command] }
