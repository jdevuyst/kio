module robot_vacuum_replay/model;

import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select, macro with);
import macros/spine_macros(macro widen_sum);
import testapi(Bool, I32);
import testapi/arith(add_i32, lt_i32, sub_i32);

pub type Direction = { North: . } | { East: . } | { South: . } | { West: . };

pub type Run_mode = { Docked: . } | { Idle: . } | { Cleaning: . } | { Paused: . };

pub type Vacuum = {
  X: I32;
  Y: I32;
  Facing: Direction;
  Mode: Run_mode;
  Dirt: I32;
  Battery: I32;
  Commands: I32;
  Faults: I32
};

pub fn north_direction() -> Direction { (North.mk(()).>widen_sum)[Direction] }

pub fn east_direction() -> Direction { (East.mk(()).>widen_sum)[Direction] }

pub fn south_direction() -> Direction { (South.mk(()).>widen_sum)[Direction] }

pub fn west_direction() -> Direction { (West.mk(()).>widen_sum)[Direction] }

pub fn docked_mode() -> Run_mode { (Docked.mk(()).>widen_sum)[Run_mode] }

pub fn idle_mode() -> Run_mode { (Idle.mk(()).>widen_sum)[Run_mode] }

pub fn cleaning_mode() -> Run_mode { (Cleaning.mk(()).>widen_sum)[Run_mode] }

pub fn paused_mode() -> Run_mode { (Paused.mk(()).>widen_sum)[Run_mode] }

pub fn initial_vacuum() -> Vacuum {
  (
  , X.mk(0)
  , Y.mk(0)
  , Facing.mk(north_direction())
  , Mode.mk(docked_mode())
  , Dirt.mk(0)
  , Battery.mk(10)
  , Commands.mk(0)
  , Faults.mk(0)
  )
}

fn tick(s: Vacuum) -> Vacuum {
  s.>with {
    Commands.mk(add_i32(s.>select { Commands.get }, 1))
  }
}

fn mark_fault(s: Vacuum) -> Vacuum {
  s.>with {
    Faults.mk(add_i32(s.>select { Faults.get }, 1))
  }
}

fn burn(s: Vacuum) -> Vacuum {
  s.>with {
    Battery.mk(sub_i32(s.>select { Battery.get }, 1))
  }
}

fn burn_cleaning_pass(s: Vacuum) -> Vacuum {
  s.>with {
    Battery.mk(sub_i32(s.>select { Battery.get }, 2))
  }
}

fn turn_left_from(d: Direction) -> Direction {
  match(d) {
    (
    , .(_n: North) { west_direction() }
    , .(_w: West) { south_direction() }
    , .(_s: South) { east_direction() }
    , .(_e: East) { north_direction() }
    )
  }
}

fn turn_right_from(d: Direction) -> Direction {
  match(d) {
    (
    , .(_n: North) { east_direction() }
    , .(_e: East) { south_direction() }
    , .(_s: South) { west_direction() }
    , .(_w: West) { north_direction() }
    )
  }
}

fn move_north(s: Vacuum) -> Vacuum {
  s.>with {
    Y.mk(add_i32(s.>select { Y.get }, 1));
    Dirt.mk(add_i32(s.>select { Dirt.get }, 1))
  }
}

fn move_east(s: Vacuum) -> Vacuum {
  s.>with {
    X.mk(add_i32(s.>select { X.get }, 1));
    Dirt.mk(add_i32(s.>select { Dirt.get }, 1))
  }
}

fn move_south(s: Vacuum) -> Vacuum {
  s.>with {
    Y.mk(sub_i32(s.>select { Y.get }, 1));
    Dirt.mk(add_i32(s.>select { Dirt.get }, 1))
  }
}

fn move_west(s: Vacuum) -> Vacuum {
  s.>with {
    X.mk(sub_i32(s.>select { X.get }, 1));
    Dirt.mk(add_i32(s.>select { Dirt.get }, 1))
  }
}

fn move_forward(s: Vacuum) -> Vacuum {
  let facing = s.>select { Facing.get };
  match(facing) {
    (
    , .(_n: North) { move_north(s) }
    , .(_e: East) { move_east(s) }
    , .(_s: South) { move_south(s) }
    , .(_w: West) { move_west(s) }
    )
  }
}

fn faulted_command(s: Vacuum) -> Vacuum { mark_fault(tick(s)) }

pub fn apply_start(s: Vacuum) -> Vacuum {
  let next = burn(tick(s));
  next.>with { Mode.mk(cleaning_mode()) }
}

pub fn apply_pause(s: Vacuum) -> Vacuum {
  let next = tick(s);
  next.>with { Mode.mk(paused_mode()) }
}

pub fn apply_left(s: Vacuum) -> Vacuum {
  let next = burn(tick(s));
  next.>with {
    Facing.mk(turn_left_from(s.>select { Facing.get }))
  }
}

pub fn apply_right(s: Vacuum) -> Vacuum {
  let next = burn(tick(s));
  next.>with {
    Facing.mk(turn_right_from(s.>select { Facing.get }))
  }
}

pub fn apply_step(s: Vacuum) -> Vacuum {
  let mode = s.>select { Mode.get };
  match(mode) {
    (
    , .(_cleaning: Cleaning) { burn(tick(move_forward(s))) }
    , .(_docked: Docked) { faulted_command(s) }
    , .(_idle: Idle) { faulted_command(s) }
    , .(_paused: Paused) { faulted_command(s) }
    )
  }
}

fn clean_if_needed(s: Vacuum) -> Vacuum {
  if(lt_i32(0, s.>select { Dirt.get })) {
    (
    , X.mk(s.>select { X.get })
    , Y.mk(s.>select { Y.get })
    , Facing.mk(s.>select { Facing.get })
    , Mode.mk(s.>select { Mode.get })
    , Dirt.mk(sub_i32(s.>select { Dirt.get }, 1))
    , Battery.mk(s.>select { Battery.get })
    , Commands.mk(s.>select { Commands.get })
    , Faults.mk(s.>select { Faults.get })
    )
  } else {
    s
  }
}

pub fn apply_clean(s: Vacuum) -> Vacuum {
  let mode = s.>select { Mode.get };
  match(mode) {
    (
    , .(_cleaning: Cleaning) { clean_if_needed(burn_cleaning_pass(tick(s))) }
    , .(_docked: Docked) { faulted_command(s) }
    , .(_idle: Idle) { faulted_command(s) }
    , .(_paused: Paused) { faulted_command(s) }
    )
  }
}

pub fn apply_dock(s: Vacuum) -> Vacuum {
  let next = tick(s);
  next.>with {
    X.mk(0);
    Y.mk(0);
    Facing.mk(north_direction());
    Mode.mk(docked_mode());
    Battery.mk(add_i32(next.>select { Battery.get }, 5))
  }
}

pub fn apply_charge(s: Vacuum, amount: I32) -> Vacuum {
  let next = tick(s);
  next.>with {
    Battery.mk(add_i32(next.>select { Battery.get }, amount))
  }
}

pub fn apply_unknown(s: Vacuum) -> Vacuum { faulted_command(s) }
