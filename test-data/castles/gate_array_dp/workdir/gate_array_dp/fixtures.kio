module gate_array_dp/fixtures;

import gate_array_dp/constants(days);
import testapi(Array, I32);
import testapi/array(array_make_filled, array_set);

pub fn traffic_risk() -> Array(I32) {
  let values = array_make_filled(days(), 0);
  array_set(values, 0, 5);
  array_set(values, 1, 2);
  array_set(values, 2, 8);
  array_set(values, 3, 4);
  array_set(values, 4, 7);
  array_set(values, 5, 3);
  array_set(values, 6, 6);
  array_set(values, 7, 5);
  values
}

pub fn service_cost() -> Array(I32) {
  let values = array_make_filled(days(), 0);
  array_set(values, 0, 11);
  array_set(values, 1, 9);
  array_set(values, 2, 12);
  array_set(values, 3, 8);
  array_set(values, 4, 13);
  array_set(values, 5, 7);
  array_set(values, 6, 10);
  array_set(values, 7, 9);
  values
}
