module polygon/fixtures;

import polygon/geometry as geo;
import testapi(Array, I32);
import testapi/array as arr;

pub fn rectangle() -> Array(geo.Point) {
  let .(points: Array(geo.Point)) = arr.array_make_empty();
  arr.array_push(points, (0, 0));
  arr.array_push(points, (6, 0));
  arr.array_push(points, (6, 4));
  arr.array_push(points, (0, 4));
  points
}

pub fn arrow() -> Array(geo.Point) {
  let .(points: Array(geo.Point)) = arr.array_make_empty();
  arr.array_push(points, (0, 0));
  arr.array_push(points, (6, 0));
  arr.array_push(points, (6, 4));
  arr.array_push(points, (3, 2));
  arr.array_push(points, (0, 4));
  points
}

pub fn notch() -> Array(geo.Point) {
  let .(points: Array(geo.Point)) = arr.array_make_empty();
  arr.array_push(points, (0, 0));
  arr.array_push(points, (6, 0));
  arr.array_push(points, (6, 6));
  arr.array_push(points, (4, 6));
  arr.array_push(points, (4, 2));
  arr.array_push(points, (2, 2));
  arr.array_push(points, (2, 6));
  arr.array_push(points, (0, 6));
  points
}

pub fn clockwise_arrow() -> Array(geo.Point) {
  let points = arrow();
  arr.array_swap(points, 0, 4);
  arr.array_swap(points, 1, 3);
  points
}

pub fn repeated_point() -> Array(geo.Point) {
  let points = rectangle();
  arr.array_push(points, (0, 0));
  points
}

pub fn straight_corner() -> Array(geo.Point) {
  let .(points: Array(geo.Point)) = arr.array_make_empty();
  arr.array_push(points, (0, 0));
  arr.array_push(points, (3, 0));
  arr.array_push(points, (6, 0));
  arr.array_push(points, (0, 4));
  points
}

pub fn crossed_boundary() -> Array(geo.Point) {
  let .(points: Array(geo.Point)) = arr.array_make_empty();
  arr.array_push(points, (0, 0));
  arr.array_push(points, (5, 4));
  arr.array_push(points, (0, 4));
  arr.array_push(points, (4, 0));
  points
}

pub fn too_short() -> Array(geo.Point) {
  let .(points: Array(geo.Point)) = arr.array_make_empty();
  arr.array_push(points, (0, 0));
  arr.array_push(points, (6, 0));
  points
}

pub fn out_of_range() -> Array(geo.Point) {
  let points = rectangle();
  arr.array_set(points, 1, (21, 0));
  points
}
