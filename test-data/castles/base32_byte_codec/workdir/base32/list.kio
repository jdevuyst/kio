/// A generic cons list. The codec threads three different element types
/// through the same walk — payload bytes (`I32`), transmitted glyphs
/// (`String`), and the alphabet's `(I32 & String)` entries — so the spine
/// is polymorphic rather than specialised to bytes.
mod base32/list;

import macros/match { macro match }
import macros/spine_macros { macro widen_sum }
import testapi { type I32 }
import testapi/arith { fn add_i32 }
import testapi/iter { fn loop }

/// A list is empty, or a head paired with the rest. The nominal
/// type ties the recursive knot: an anonymous sum cannot mention
/// itself.
pub rec type { List[A]: . | (A & List[A]) { mk; pub get } }

pub fn nil[A] -> List[A] { List.mk(widen_sum(())[. | (A & List[A])]) }

pub fn cons[A](head: A, rest: List[A]) -> List[A] {
  List.mk(widen_sum((head, rest))[. | (A & List[A])])
}

rec(loop) {
  pub fn length[A](xs: List[A]) -> I32 { recur count(xs, 0) };
  fn count[A](xs: List[A], seen: I32) -> I32 {
    match(xs.>List.get) {
      (.(_head: A, rest: List[A]) { recur count(rest, add_i32(seen, 1)) }, .(_empty: .) { seen })
    }
  }
}

rec(loop) {
  pub fn reverse[A](xs: List[A]) -> List[A] { recur flip(xs, nil[A]) };
  fn flip[A](xs: List[A], done: List[A]) -> List[A] {
    match(xs.>List.get) {
      (.(head: A, rest: List[A]) { recur flip(rest, cons(head, done)) }, .(_empty: .) { done })
    }
  }
}
