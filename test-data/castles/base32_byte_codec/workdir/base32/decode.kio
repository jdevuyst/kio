/// Decoding — the encoder run backwards. Each glyph pushes five bits into
/// the accumulator, and every time eight or more bits are pending the top
/// eight are drawn off as one recovered byte.
///
/// A glyph the alphabet does not contain cannot be turned into bits at
/// all, so decoding refuses the whole transmission and names the position
/// where it gave up. This is the encoder's companion decoder: for canonical
/// encoder output, bits left over at the end are zero fill and are dropped.
/// It does not separately validate padding placement, padding count, or
/// unused low bits.
module base32/decode;

import base32/alphabet as alphabet;
import base32/bits as bits;
import base32/list as list;
import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(widen_sum);
import testapi(Bool, I32, String);
import testapi/arith(add_i32, lt_i32, sub_i32);
import testapi/iter(loop);

/// What a transmission decoded to: the recovered payload, or the
/// one-based position of the first glyph outside the alphabet.
pub labels Decoded = { ok: alphabet.Bytes } | { reject: I32 };

rec(loop) {
  pub fn decode(glyphs: alphabet.Glyphs) -> Decoded { rec walk(glyphs, 1, 0, 0, list.nil(I32, ())) };
  /// Read one glyph. `position` is the one-based index of the glyph under
  /// the cursor, so a refusal can say where it happened. Padding carries
  /// no bits and is stepped over.
  fn walk(glyphs: alphabet.Glyphs, position: I32, acc: I32, held: I32, done: alphabet.Bytes) -> Decoded {
    match! glyphs.>list.List.un_list {
      (
        , .(glyph: String, rest: alphabet.Glyphs) {
            if! alphabet.is_pad(glyph) {
              rec walk(rest, add_i32(position, 1), acc, held, done)
            } else match! alphabet.value_of(glyph) {
              (
                , .(value: I32) {
                    rec emit(
                      , rest
                      , add_i32(position, 1)
                      , add_i32(bits.shift_up(acc, alphabet.group_bits()), value)
                      , add_i32(held, alphabet.group_bits())
                      , done
                      )
                  }
                , .(_unknown: .) { widen_sum!({reject = position}) }
                )
            }
          }
        , .(_empty: .) { widen_sum!({ok = list.reverse(done)}) }
        )
    }
  };
  /// Draw off every whole byte the accumulator now holds, high bits
  /// first, and keep only the leftover bits behind.
  fn emit(glyphs: alphabet.Glyphs, position: I32, acc: I32, held: I32, done: alphabet.Bytes) -> Decoded {
    if! lt_i32(held, alphabet.byte_bits()) {
      rec walk(glyphs, position, acc, held, done)
    } else {
      let left = sub_i32(held, alphabet.byte_bits());
      let byte = bits.low_bits(bits.shift_down(acc, left), alphabet.byte_bits());
      rec emit(glyphs, position, bits.low_bits(acc, left), left, list.cons(byte, done))
    }
  }
}

pub rec(loop) fn bytes_eq(left: alphabet.Bytes, right: alphabet.Bytes) -> Bool {
  match! left.>list.List.un_list {
    (
      , .(head: I32, rest: alphabet.Bytes) {
          match! right.>list.List.un_list {
            (
              , .(other: I32, others: alphabet.Bytes) {
                  if! bits.int_eq(head, other) {
                    rec bytes_eq(rest, others)
                  } else {
                    .f
                  }
                }
              , .(_empty: .) { .f }
              )
          }
        }
      , .(_empty: .) {
          match! right.>list.List.un_list {
            (.(_head: I32, _rest: alphabet.Bytes) { .f }, .(_empty: .) { .t })
          }
        }
      )
  }
}
