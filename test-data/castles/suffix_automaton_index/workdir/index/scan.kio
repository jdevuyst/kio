module index/scan;

import elab/control(if);
import index/analysis as analysis;
import index/automaton as sam;
import index/numbers as num;
import testapi(Array, Bool, I32);
import testapi/arith as n;
import testapi/array as a;
import testapi/iter(loop);

rec(loop) fn copy_span(source: Array(I32), position: I32, stop: I32, result: Array(I32)) -> Array(I32) {
  if! num.less(position, stop) {
    a.array_push(result, a.array_get(source, position));
    rec copy_span(source, n.add_i32(position, 1), stop, result)
  } else {
    result
  }
}

pub fn slice(source: Array(I32), start: I32, stop: I32) -> Array(I32) {
  copy_span(source, start, stop, a.array_make_empty(I32, ()))
}

rec(loop) fn matches(source: Array(I32), query: Array(I32), start: I32, offset: I32) -> Bool {
  if! num.less(offset, a.array_len(query)) {
    if! num.equal(a.array_get(source, n.add_i32(start, offset)), a.array_get(query, offset)) {
      rec matches(source, query, start, n.add_i32(offset, 1))
    } else {
      .f
    }
  } else {
    .t
  }
}

rec(loop) fn count_from(source: Array(I32), query: Array(I32), start: I32, stop: I32, total: I32) -> I32 {
  if! num.less(start, stop) {
    let extra = if! matches(source, query, start, 0) {
      1
    } else {
      0
    };
    rec count_from(source, query, n.add_i32(start, 1), stop, n.add_i32(total, extra))
  } else {
    total
  }
}

pub fn occurrences(source: Array(I32), query: Array(I32)) -> I32 {
  count_from(source, query, 0, n.add_i32(n.sub_i32(a.array_len(source), a.array_len(query)), 1), 0)
}

pub labels Audit = { intervals: I32, mismatches: I32, unique: I32, repeated: I32 };

rec(loop) fn enumerate(source: Array(I32), index: sam.Index, start: I32, stop: I32, audit: Audit) -> Audit {
  if! num.less(start, a.array_len(source)) {
    if! n.leq_i32(stop, a.array_len(source)) {
      let query = slice(source, start, stop);
      let count = occurrences(source, query);
      let mismatch = if! num.equal(count, analysis.occurrences(index, query)) {
        0
      } else {
        1
      };
      let first = if! num.equal(count_from(source, query, 0, start, 0), 0) {
        1
      } else {
        0
      };
      let longest = if! n.leq_i32(2, count) {
        num.max(audit.?{repeated}, a.array_len(query))
      } else {
        audit.?{repeated}
      };
      rec enumerate(
        , source
        , index
        , start
        , n.add_i32(stop, 1)
        , {
            , intervals = n.add_i32(audit.?{intervals}, 1)
            , mismatches = n.add_i32(audit.?{mismatches}, mismatch)
            , unique = n.add_i32(audit.?{unique}, first)
            , repeated = longest
            }
        )
    } else {
      rec enumerate(source, index, n.add_i32(start, 1), n.add_i32(start, 2), audit)
    }
  } else {
    audit
  }
}

pub fn verify(source: Array(I32), index: sam.Index) -> Audit {
  enumerate(source, index, 0, 1, {intervals = 0, mismatches = 0, unique = 0, repeated = 0})
}
