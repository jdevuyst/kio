module index/automaton;

import index/numbers as num;
import macros/control(macro if);
import macros/row_macros(macro record, macro select, macro with);
import testapi(Array, Bool, I32);
import testapi/arith as n;
import testapi/array as a;
import testapi/iter(loop);

pub type State = { Longest: I32; Suffix: I32; Ends: I32; Transitions: Array[I32]; Copied_from: I32 };

pub type Index = { States: Array[State]; Last: I32; Clones: I32 };

pub fn empty() -> Index {
  let states = a.array_make_empty[State](());
  a.array_push(
  , states
  , record {
      Longest.mk(0);
      Suffix.mk(-1);
      Ends.mk(0);
      Transitions.mk(a.array_make_filled(3, -1));
      Copied_from.mk(-1)
    }
  );
  record { States.mk(states); Last.mk(0); Clones.mk(0) }
}

pub fn transition(states: Array[State], state: I32, symbol: I32) -> I32 {
  a.array_get(a.array_get(states, state).>select { Transitions.get }, symbol)
}

fn set_link(states: Array[State], state: I32, link: I32) {
  let old = a.array_get(states, state);
  a.array_set(states, state, old.>with { Suffix.mk(link) })
}

rec(loop) fn add_missing(states: Array[State], p: I32, symbol: I32, target: I32) -> I32 {
  if(num.less(p, 0)) {
    p
  } else {
    let state = a.array_get(states, p);
    if(num.less(a.array_get(state.>select { Transitions.get }, symbol), 0)) {
      a.array_set(state.>select { Transitions.get }, symbol, target);
      recur add_missing(states, state.>select { Suffix.get }, symbol, target)
    } else {
      p
    }
  }
}

rec(loop) fn redirect(states: Array[State], p: I32, symbol: I32, old: I32, clone: I32) {
  if(num.less(p, 0)) {
    ()
  } else {
    let state = a.array_get(states, p);
    if(num.equal(a.array_get(state.>select { Transitions.get }, symbol), old)) {
      a.array_set(state.>select { Transitions.get }, symbol, clone);
      recur redirect(states, state.>select { Suffix.get }, symbol, old, clone)
    } else {
      ()
    }
  }
}

pub fn append(index: Index, symbol: I32) -> Index {
  let .(states, last, clones) = index.>select { States.get; Last.get; Clones.get };
  let current = a.array_len(states);
  let length = n.add_i32(a.array_get(states, last).>select { Longest.get }, 1);
  a.array_push(
  , states
  , record {
      Longest.mk(length);
      Suffix.mk(0);
      Ends.mk(1);
      Transitions.mk(a.array_make_filled(3, -1));
      Copied_from.mk(-1)
    }
  );
  let p = add_missing(states, last, symbol, current);
  if(num.less(p, 0)) {
    record { States.mk(states); Last.mk(current); Clones.mk(clones) }
  } else {
    let q = transition(states, p, symbol);
    let reached = a.array_get(states, q);
    let split_length = n.add_i32(a.array_get(states, p).>select { Longest.get }, 1);
    if(num.equal(split_length, reached.>select { Longest.get })) {
      set_link(states, current, q);
      record { States.mk(states); Last.mk(current); Clones.mk(clones) }
    } else {
      let clone = a.array_len(states);
      // Clones start with zero endpoint weight and own their mutable transitions.
      a.array_push(
      , states
      , record {
          Longest.mk(split_length);
          Suffix.mk(reached.>select { Suffix.get });
          Ends.mk(0);
          Transitions.mk(a.array_clone(reached.>select { Transitions.get }));
          Copied_from.mk(q)
        }
      );
      redirect(states, p, symbol, q, clone);
      set_link(states, q, clone);
      set_link(states, current, clone);
      record { States.mk(states); Last.mk(current); Clones.mk(n.add_i32(clones, 1)) }
    }
  }
}

rec(loop) fn consume(index: Index, symbols: Array[I32], position: I32) -> Index {
  if(num.less(position, a.array_len(symbols))) {
    recur consume(append(index, a.array_get(symbols, position)), symbols, n.add_i32(position, 1))
  } else {
    index
  }
}

pub fn build(symbols: Array[I32]) -> Index { consume(empty(), symbols, 0) }
