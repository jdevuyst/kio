module deferred;

import macros/control(macro if);
import macros/row_macros(macro select, macro with);
import market as market;
import testapi(Array, Bool, I32);
import testapi/arith as arith;
import testapi/array as array;
import testapi/iter(loop);

pub type Outcome = {
  Partner: Array[I32];
  Holder: Array[I32];
  Proposals: I32;
  Switches: I32;
  Rejections: I32
};

type Work = {
  Preferences: market.Preferences;
  Ranks: Array[I32];
  Queue: Array[I32];
  Next_choice: Array[I32];
  Size: I32
};

fn index(size: I32, recipient: I32, proposer: I32) -> I32 {
  arith.add_i32(arith.mul_i32(recipient, size), proposer)
}

rec(loop) fn rank_row(row: Array[I32], ranks: Array[I32], size: I32, recipient: I32, position: I32) {
  if(market.less(position, size)) {
    array.array_set(ranks, index(size, recipient, array.array_get(row, position)), position);
    recur rank_row(row, ranks, size, recipient, arith.add_i32(position, 1))
  } else {
    ()
  }
}

rec(loop) fn rank_all(preferences: market.Preferences, ranks: Array[I32], size: I32, recipient: I32) -> Array[I32] {
  if(market.less(recipient, size)) {
    rank_row(array.array_get(preferences, recipient), ranks, size, recipient, 0);
    recur rank_all(preferences, ranks, size, arith.add_i32(recipient, 1))
  } else {
    ranks
  }
}

fn engage(outcome: Outcome, proposer: I32, recipient: I32) {
  array.array_set(outcome.>select { Partner.get }, proposer, recipient);
  array.array_set(outcome.>select { Holder.get }, recipient, proposer)
}

fn offer(work: Work, outcome: Outcome, proposer: I32, recipient: I32) -> Outcome {
  let incumbent = array.array_get(outcome.>select { Holder.get }, recipient);
  if(market.less(incumbent, 0)) {
    engage(outcome, proposer, recipient);
    outcome
  } else {
    let incoming_rank = array.array_get(
    , work.>select { Ranks.get }
    , index(work.>select { Size.get }, recipient, proposer)
    );
    let held_rank = array.array_get(
    , work.>select { Ranks.get }
    , index(work.>select { Size.get }, recipient, incumbent)
    );
    if(market.less(incoming_rank, held_rank)) {
      array.array_set(outcome.>select { Partner.get }, incumbent, -1);
      engage(outcome, proposer, recipient);
      array.array_push(work.>select { Queue.get }, incumbent);
      outcome.>with {
        Switches.mk(arith.add_i32(outcome.>select { Switches.get }, 1))
      }
    } else {
      array.array_push(work.>select { Queue.get }, proposer);
      outcome.>with {
        Rejections.mk(arith.add_i32(outcome.>select { Rejections.get }, 1))
      }
    }
  }
}

// The queue contains precisely the proposers whose next proposal is pending.
// Every rejection and displacement appends one newly free proposer.
rec(loop) fn process(work: Work, head: I32, outcome: Outcome) -> Outcome {
  if(market.less(head, array.array_len(work.>select { Queue.get }))) {
    let proposer = array.array_get(work.>select { Queue.get }, head);
    let position = array.array_get(work.>select { Next_choice.get }, proposer);
    let recipient = array.array_get(
    , array.array_get(work.>select { Preferences.get }, proposer)
    , position
    );
    array.array_set(work.>select { Next_choice.get }, proposer, arith.add_i32(position, 1));
    let updated = offer(work, outcome, proposer, recipient);
    recur process(
    , work
    , arith.add_i32(head, 1)
    , updated.>with {
        Proposals.mk(arith.add_i32(updated.>select { Proposals.get }, 1))
      }
    )
  } else {
    outcome
  }
}

pub fn solve(proposing: market.Preferences, receiving: market.Preferences, order: Array[I32]) -> Outcome {
  let size = array.array_len(proposing);
  let ranks = rank_all(receiving, array.array_make_filled(arith.mul_i32(size, size), 0), size, 0);
  let work =
    (
    , Preferences.mk(proposing)
    , Ranks.mk(ranks)
    , Queue.mk(array.array_clone(order))
    , Next_choice.mk(array.array_make_filled(size, 0))
    , Size.mk(size)
    );
  let outcome =
    (
    , Partner.mk(array.array_make_filled(size, -1))
    , Holder.mk(array.array_make_filled(size, -1))
    , Proposals.mk(0)
    , Switches.mk(0)
    , Rejections.mk(0)
    );
  process(work, 0, outcome)
}
