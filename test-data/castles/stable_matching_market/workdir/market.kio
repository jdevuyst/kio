module market;

import elab/control(if);
import testapi(Array, Bool, I32);
import testapi/arith as arith;
import testapi/array as array;

pub type Preferences = Array(Array(I32));

pub fn equal(a: I32, b: I32) -> Bool {
  if! arith.leq_i32(a, b) {
    arith.leq_i32(b, a)
  } else {
    .f
  }
}

pub fn less(a: I32, b: I32) -> Bool { arith.leq_i32(a, arith.sub_i32(b, 1)) }

pub fn row(a: I32, b: I32, c: I32, d: I32) -> Array(I32) {
  let values = array.array_make_empty(I32, ());
  array.array_push(values, a);
  array.array_push(values, b);
  array.array_push(values, c);
  array.array_push(values, d);
  values
}

pub fn left() -> Preferences {
  let rows = array.array_make_empty(Array(I32), ());
  array.array_push(rows, row(3, 1, 0, 2));
  array.array_push(rows, row(1, 3, 0, 2));
  array.array_push(rows, row(3, 0, 1, 2));
  array.array_push(rows, row(2, 1, 0, 3));
  rows
}

pub fn right() -> Preferences {
  let rows = array.array_make_empty(Array(I32), ());
  array.array_push(rows, row(2, 3, 1, 0));
  array.array_push(rows, row(2, 0, 3, 1));
  array.array_push(rows, row(1, 0, 3, 2));
  array.array_push(rows, row(3, 2, 1, 0));
  rows
}
