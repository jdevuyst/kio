module report;

import certificate as certificate;
import deferred as deferred;
import elab/control(if);
import market as market;
import testapi(Array, Bool, I32, String);
import testapi/arith as arith;
import testapi/array as array;
import testapi/fmt as fmt;
import testapi/io as io;
import testapi/iter(loop);
import testapi/text as text;

fn number(label: String, value: I32) -> . {
  io.print(text.string_concat(label, text.string_concat(fmt.int_to_string(value), "\n")))
}

rec(loop) fn pairs(partners: Array(I32), person: I32) -> . {
  if! market.less(person, array.array_len(partners)) {
    io.print(text.string_concat("  L", fmt.int_to_string(person)));
    number("-R", array.array_get(partners, person));
    rec pairs(partners, arith.add_i32(person, 1))
  } else {
    ()
  }
}

pub fn certificate_report(
  , left: market.Preferences
  , right: market.Preferences
  , partner: Array(I32)
  , holder: Array(I32)
  ) -> . {
  let valid = certificate.valid(partner, holder);
  io.print(if! valid {
    "valid matching: yes\n"
  } else {
    "valid matching: no\n"
  });
  if! valid {
    number("blocking pairs: ", certificate.blocking_pairs(left, right, partner, holder));
    number("left rank total: ", certificate.rank_total(left, partner));
    number("right rank total: ", certificate.rank_total(right, holder))
  } else {
    ()
  }
}

pub fn outcome(
  , label: String
  , left: market.Preferences
  , right: market.Preferences
  , result: deferred.Outcome
  , right_proposes: Bool
  ) -> . {
  io.print(text.string_concat(label, "\n"));
  number("proposals: ", result.?{deferred.proposals});
  number("recipient switches: ", result.?{deferred.switches});
  number("rejected proposals: ", result.?{deferred.rejections});
  let partner =
    if! right_proposes {
      result.?{deferred.holder}
    } else {
      result.?{deferred.partner}
    };
  let holder =
    if! right_proposes {
      result.?{deferred.partner}
    } else {
      result.?{deferred.holder}
    };
  pairs(partner, 0);
  certificate_report(left, right, partner, holder)
}
