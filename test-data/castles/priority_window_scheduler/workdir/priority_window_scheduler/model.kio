mod priority_window_scheduler/model;

import testapi { type I32; type String }

pub type Window = { Name: String; Span: String; Impact: I32; Risk: I32; Handoff: I32 };

pub fn early() -> Window {
  (Name.mk("early"), Span.mk("1-3"), Impact.mk(25), Risk.mk(6), Handoff.mk(2))
}

pub fn middle() -> Window {
  (Name.mk("middle"), Span.mk("2-4"), Impact.mk(31), Risk.mk(7), Handoff.mk(2))
}

pub fn late() -> Window {
  (Name.mk("late"), Span.mk("3-5"), Impact.mk(27), Risk.mk(8), Handoff.mk(4))
}
