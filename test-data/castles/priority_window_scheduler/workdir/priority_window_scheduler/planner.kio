module priority_window_scheduler/planner;

import macros/control(macro if);
import macros/row_macros(macro select);
import priority_window_scheduler/model(Handoff, Impact, Risk, Window);
import testapi(Bool, I32);
import testapi/arith as arith;

pub fn score(window: Window) -> I32 {
  arith.sub_i32(
  , window.>select { Impact.get }
  , arith.add_i32(window.>select { Risk.get }, window.>select { Handoff.get })
  )
}

pub fn choose(left: Window, right: Window) -> Window {
  if(arith.lt_i32(score(left), score(right))) { right } else { left }
}
