module elevator/bank;

import elevator/schedule as schedule;
import macros/control(macro if);
import macros/row_macros(macro select);
import testapi(Bool, I32, String);
import testapi/arith(add_i32, eq_i32, leq_i32, lt_i32, mul_i32, sub_i32);
import testapi/fmt(bool_to_string, int_to_string);
import testapi/io(print);
import testapi/iter(loop);
import testapi/text(string_concat);

type Bank = {
  Tick: I32;
  Car_a_floor: I32;
  Car_a_target: I32;
  Car_a_up: Bool;
  Car_b_floor: I32;
  Car_b_target: I32;
  Car_b_up: Bool;
  Lobby_waiting: I32;
  Middle_waiting: I32;
  High_waiting: I32;
  Served_total: I32;
  Wait_total: I32
};

type Step = {
  Next_bank: Bank;
  Arrival_lobby_count: I32;
  Arrival_middle_count: I32;
  Arrival_high_count: I32;
  Served_now: I32;
  Waiting_after: I32
};

fn pending_total(lobby: I32, middle: I32, high: I32) -> I32 {
  add_i32(add_i32(lobby, middle), high)
}

fn positive(value: I32) -> Bool { lt_i32(0, value) }

fn choose_car_a_target(floor: I32, lobby: I32, middle: I32, high: I32) -> I32 {
  if(positive(high)) {
    5
  } else if(positive(middle)) {
    2
  } else if(positive(lobby)) {
    0
  } else {
    floor
  }
}

fn choose_car_b_target(floor: I32, lobby: I32, middle: I32, high: I32) -> I32 {
  if(positive(lobby)) {
    0
  } else if(positive(middle)) {
    2
  } else if(positive(high)) {
    5
  } else {
    floor
  }
}

fn move_toward(floor: I32, target: I32) -> I32 {
  if(lt_i32(floor, target)) {
    add_i32(floor, 1)
  } else if(lt_i32(target, floor)) {
    sub_i32(floor, 1)
  } else {
    floor
  }
}

fn moving_up(floor: I32, target: I32) -> Bool { lt_i32(floor, target) }

fn served_at_floor(floor: I32, lobby: I32, middle: I32, high: I32) -> I32 {
  if(eq_i32(floor, 0)) {
    if(positive(lobby)) { 1 } else { 0 }
  } else if(eq_i32(floor, 2)) {
    if(positive(middle)) { 1 } else { 0 }
  } else if(eq_i32(floor, 5)) {
    if(positive(high)) { 1 } else { 0 }
  } else {
    0
  }
}

fn reduce_lobby(floor: I32, lobby: I32) -> I32 {
  if(eq_i32(floor, 0)) {
    if(positive(lobby)) { sub_i32(lobby, 1) } else { lobby }
  } else {
    lobby
  }
}

fn reduce_middle(floor: I32, middle: I32) -> I32 {
  if(eq_i32(floor, 2)) {
    if(positive(middle)) { sub_i32(middle, 1) } else { middle }
  } else {
    middle
  }
}

fn reduce_high(floor: I32, high: I32) -> I32 {
  if(eq_i32(floor, 5)) {
    if(positive(high)) { sub_i32(high, 1) } else { high }
  } else {
    high
  }
}

fn initial_bank() -> Bank {
  (
  , Tick.mk(0)
  , Car_a_floor.mk(0)
  , Car_a_target.mk(0)
  , Car_a_up.mk(.f)
  , Car_b_floor.mk(5)
  , Car_b_target.mk(5)
  , Car_b_up.mk(.f)
  , Lobby_waiting.mk(0)
  , Middle_waiting.mk(0)
  , High_waiting.mk(0)
  , Served_total.mk(0)
  , Wait_total.mk(0)
  )
}

fn step(bank: Bank) -> Step {
  let tick = bank.>select { Tick.get };
  let arrival_lobby = schedule.lobby(tick);
  let arrival_middle = schedule.middle(tick);
  let arrival_high = schedule.high(tick);
  let lobby0 = add_i32(bank.>select { Lobby_waiting.get }, arrival_lobby);
  let middle0 = add_i32(bank.>select { Middle_waiting.get }, arrival_middle);
  let high0 = add_i32(bank.>select { High_waiting.get }, arrival_high);
  let waiting_before_service = pending_total(lobby0, middle0, high0);
  let target_a = choose_car_a_target(bank.>select { Car_a_floor.get }, lobby0, middle0, high0);
  let floor_a = move_toward(bank.>select { Car_a_floor.get }, target_a);
  let up_a = moving_up(bank.>select { Car_a_floor.get }, target_a);
  let served_a = served_at_floor(floor_a, lobby0, middle0, high0);
  let lobby1 = reduce_lobby(floor_a, lobby0);
  let middle1 = reduce_middle(floor_a, middle0);
  let high1 = reduce_high(floor_a, high0);
  let target_b = choose_car_b_target(bank.>select { Car_b_floor.get }, lobby1, middle1, high1);
  let floor_b = move_toward(bank.>select { Car_b_floor.get }, target_b);
  let up_b = moving_up(bank.>select { Car_b_floor.get }, target_b);
  let served_b = served_at_floor(floor_b, lobby1, middle1, high1);
  let lobby2 = reduce_lobby(floor_b, lobby1);
  let middle2 = reduce_middle(floor_b, middle1);
  let high2 = reduce_high(floor_b, high1);
  let served_now = add_i32(served_a, served_b);
  let next_bank =
    (
    , Tick.mk(add_i32(tick, 1))
    , Car_a_floor.mk(floor_a)
    , Car_a_target.mk(target_a)
    , Car_a_up.mk(up_a)
    , Car_b_floor.mk(floor_b)
    , Car_b_target.mk(target_b)
    , Car_b_up.mk(up_b)
    , Lobby_waiting.mk(lobby2)
    , Middle_waiting.mk(middle2)
    , High_waiting.mk(high2)
    , Served_total.mk(add_i32(bank.>select { Served_total.get }, served_now))
    , Wait_total.mk(add_i32(bank.>select { Wait_total.get }, waiting_before_service))
    );
  (
  , Next_bank.mk(next_bank)
  , Arrival_lobby_count.mk(arrival_lobby)
  , Arrival_middle_count.mk(arrival_middle)
  , Arrival_high_count.mk(arrival_high)
  , Served_now.mk(served_now)
  , Waiting_after.mk(pending_total(lobby2, middle2, high2))
  )
}

fn emit_i32(label: String, value: I32) { print(string_concat(label, int_to_string(value))) }

fn emit_bool(label: String, value: Bool) { print(string_concat(label, bool_to_string(value))) }

fn emit_frame(bank: Bank, frame: Step) {
  let next_bank = frame.>select { Next_bank.get };
  emit_i32("tick ", bank.>select { Tick.get });
  emit_i32(" arrivals L", frame.>select { Arrival_lobby_count.get });
  emit_i32(" M", frame.>select { Arrival_middle_count.get });
  emit_i32(" H", frame.>select { Arrival_high_count.get });
  emit_i32(" | A f", next_bank.>select { Car_a_floor.get });
  emit_i32("->", next_bank.>select { Car_a_target.get });
  emit_bool(" up=", next_bank.>select { Car_a_up.get });
  emit_i32(" | B f", next_bank.>select { Car_b_floor.get });
  emit_i32("->", next_bank.>select { Car_b_target.get });
  emit_bool(" up=", next_bank.>select { Car_b_up.get });
  emit_i32(" | served ", frame.>select { Served_now.get });
  emit_i32(" waiting ", frame.>select { Waiting_after.get });
  emit_i32(" wait_total ", next_bank.>select { Wait_total.get });
  print("\n")
}

rec(loop) fn run_ticks(bank: Bank) -> Bank {
  if(leq_i32(bank.>select { Tick.get }, 11)) {
    let frame = step(bank);
    emit_frame(bank, frame);
    recur run_ticks(frame.>select { Next_bank.get })
  } else {
    bank
  }
}

fn score(bank: Bank) -> I32 {
  let served_points = mul_i32(bank.>select { Served_total.get }, 100);
  let wait_penalty = mul_i32(bank.>select { Wait_total.get }, 3);
  let pending_penalty =
    mul_i32(
    , pending_total(
      , bank.>select { Lobby_waiting.get }
      , bank.>select { Middle_waiting.get }
      , bank.>select { High_waiting.get }
      )
    , 25
    );
  sub_i32(sub_i32(served_points, wait_penalty), pending_penalty)
}

fn emit_summary(bank: Bank) {
  print("summary");
  emit_i32(" served=", bank.>select { Served_total.get });
  emit_i32(" wait=", bank.>select { Wait_total.get });
  emit_i32(
  , " pending="
  , pending_total(
    , bank.>select { Lobby_waiting.get }
    , bank.>select { Middle_waiting.get }
    , bank.>select { High_waiting.get }
    )
  );
  emit_i32(" score=", score(bank));
  print("\n")
}

pub fn run() {
  print("elevator_bank_sim\n");
  let final_bank = run_ticks(initial_bank());
  emit_summary(final_bank)
}
