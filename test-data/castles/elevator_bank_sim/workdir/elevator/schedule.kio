module elevator/schedule;

import elab/control(if);
import testapi(Bool, I32);
import testapi/arith(eq_i32);

pub fn lobby(tick: I32) -> I32 {
  if! eq_i32(tick, 0) {
    2
  } else if! eq_i32(tick, 3) {
    1
  } else if! eq_i32(tick, 8) {
    1
  } else {
    0
  }
}

pub fn middle(tick: I32) -> I32 {
  if! eq_i32(tick, 2) {
    1
  } else if! eq_i32(tick, 6) {
    1
  } else {
    0
  }
}

pub fn high(tick: I32) -> I32 {
  if! eq_i32(tick, 1) {
    1
  } else if! eq_i32(tick, 4) {
    2
  } else if! eq_i32(tick, 9) {
    1
  } else {
    0
  }
}
