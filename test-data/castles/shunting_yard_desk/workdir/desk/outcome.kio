/// Every way this calculator can fail, as a value.
///
/// Nothing here throws, exits, or traps: a fault is an ordinary sum arm
/// carrying the 1-based position of the token it failed at, and the driver
/// dispatches it with `match` exactly the way it dispatches a success. The
/// seven arms are the complete failure surface of an integer desk calculator
/// over this grammar, and the fixture exercises every one of them.
mod desk/outcome;

import desk/list { type List; fn cons; fn count; fn nil }
import desk/num { fn int_eq }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type Bool; type I32; type String }

pub type Fault_kind =
  | { Bad_token: . }
  | { Unmatched_close: . }
  | { Unclosed_open: . }
  | { Missing_operand: . }
  | { Extra_operand: . }
  | { Divide_by_zero: . }
  | { Negative_exponent: . }
  ;

/// A fault kind together with the token position it was raised at.
pub type Failure = { Fault: Fault_kind; Pos: I32 };

/// What one expression came to: a value, or a failure.
pub type Answer = { Value: I32 } | { Failed: Failure };

pub fn bad_token_fault() -> Fault_kind { (Bad_token.mk(()).>widen_sum)[Fault_kind] }

pub fn unmatched_close_fault() -> Fault_kind { (Unmatched_close.mk(()).>widen_sum)[Fault_kind] }

pub fn unclosed_open_fault() -> Fault_kind { (Unclosed_open.mk(()).>widen_sum)[Fault_kind] }

pub fn missing_operand_fault() -> Fault_kind { (Missing_operand.mk(()).>widen_sum)[Fault_kind] }

pub fn extra_operand_fault() -> Fault_kind { (Extra_operand.mk(()).>widen_sum)[Fault_kind] }

pub fn divide_by_zero_fault() -> Fault_kind { (Divide_by_zero.mk(()).>widen_sum)[Fault_kind] }

pub fn negative_exponent_fault() -> Fault_kind { (Negative_exponent.mk(()).>widen_sum)[Fault_kind] }

pub fn fault_at(kind: Fault_kind, pos: I32) -> Failure { (Fault.mk(kind), Pos.mk(pos)) }

pub fn fault_of(f: Failure) -> Fault_kind {
  f.>select { Fault.get }
}

pub fn pos_of(f: Failure) -> I32 {
  f.>select { Pos.get }
}

pub fn value_answer(n: I32) -> Answer { (Value.mk(n).>widen_sum)[Answer] }

pub fn failed_answer(f: Failure) -> Answer { (Failed.mk(f).>widen_sum)[Answer] }

/// One row per fault kind: how it prints, and an ordinal. Two sum values
/// cannot be compared without walking both, so the summary counts a kind by
/// projecting it to its ordinal and comparing integers — and reading the name
/// and the ordinal off one row keeps the report and the tally in step.
type Facts = { Code: I32; Text: String };

fn facts(kind: Fault_kind) -> Facts {
  match(kind) {
    (
    , .(_b: Bad_token) { (Code.mk(0), Text.mk("bad-token")) }
    , .(_c: Unmatched_close) { (Code.mk(1), Text.mk("unmatched-close")) }
    , .(_o: Unclosed_open) { (Code.mk(2), Text.mk("unclosed-open")) }
    , .(_m: Missing_operand) { (Code.mk(3), Text.mk("missing-operand")) }
    , .(_e: Extra_operand) { (Code.mk(4), Text.mk("extra-operand")) }
    , .(_d: Divide_by_zero) { (Code.mk(5), Text.mk("divide-by-zero")) }
    , .(_n: Negative_exponent) { (Code.mk(6), Text.mk("negative-exponent")) }
    )
  }
}

pub fn kind_name(kind: Fault_kind) -> String {
  facts(kind).>select { Text.get }
}

/// Every fault kind, in report order. The summary walks this rather than
/// carrying seven counters, so no arm can quietly lose its counter.
pub fn all_kinds() -> List[Fault_kind] {
  let ks = cons(negative_exponent_fault(), nil[Fault_kind]);
  let ks = cons(divide_by_zero_fault(), ks);
  let ks = cons(extra_operand_fault(), ks);
  let ks = cons(missing_operand_fault(), ks);
  let ks = cons(unclosed_open_fault(), ks);
  let ks = cons(unmatched_close_fault(), ks);
  cons(bad_token_fault(), ks)
}

pub fn count_kind(log: List[Fault_kind], kind: Fault_kind) -> I32 {
  let wanted = facts(kind).>select { Code.get };
  count(
  , log
  , .(seen: Fault_kind) {
      int_eq(facts(seen).>select { Code.get }, wanted)
    }
  )
}
