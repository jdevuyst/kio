/// The RPN queue's element type — the yard's output and the evaluator's input.
///
/// A parenthesis never reaches postfix form and neither does an unreadable
/// token, so a `Step` is deliberately narrower than a `Token`: it is exactly
/// what an RPN machine can execute, push a literal or apply an operator. The
/// evaluator therefore has no impossible arm to answer for.
mod desk/step;

import desk/op { type Op; fn symbol }
import macros/match { macro match }
import macros/row_macros { macro select }
import macros/spine_macros { macro widen_sum }
import testapi { type I32; type String }
import testapi/fmt { fn int_to_string }

pub type Action = { Lit: I32 } | { App: Op };

/// The action plus the position of the source token that produced it. Faults
/// raised during evaluation quote that position, so `8 / 0` blames the `/`
/// rather than the RPN slot the `/` happened to land in.
pub type Step = { Act: Action; Spot: I32 };

fn lit_action(n: I32) -> Action { (Lit.mk(n).>widen_sum)[Action] }

fn app_action(op: Op) -> Action { (App.mk(op).>widen_sum)[Action] }

pub fn lit_step(n: I32, spot: I32) -> Step { (Act.mk(lit_action(n)), Spot.mk(spot)) }

pub fn app_step(op: Op, spot: I32) -> Step { (Act.mk(app_action(op)), Spot.mk(spot)) }

pub fn act_of(s: Step) -> Action {
  s.>select { Act.get }
}

pub fn spot_of(s: Step) -> I32 {
  s.>select { Spot.get }
}

pub fn step_text(s: Step) -> String {
  match(act_of(s)) {
    (
    , .(l: Lit) {
        int_to_string(l.>select { Lit.get })
      }
    , .(a: App) {
        symbol(a.>select { App.get })
      }
    )
  }
}
