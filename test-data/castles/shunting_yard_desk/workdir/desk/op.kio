/// The operator table — the static half of the calculator, and the only
/// thing the shunting yard consults to decide what to pop.
///
/// Arity is carried by the type rather than by a side condition: an `Op` is
/// either a `Binop` or a `Unop`, so no code has to handle "the unary case of
/// a binary application". The yard turns on exactly that distinction — a
/// prefix operator has no left operand, so pushing one pops nothing.
///
/// Precedence, tightest first:
///
/// ```text
///   ^        4   right-associative
///   ~        3   prefix, unary
///   * / %    2   left-associative
///   + -      1   left-associative
/// ```
module desk/op;

import macros/match(macro match);
import macros/row_macros(macro select);
import macros/spine_macros(macro widen_sum);
import testapi(Bool, I32, String);

pub type Binop =
  { Plus: . } | { Minus: . } | { Times: . } | { Divide: . } | { Modulo: . } | { Power: . }
  ;

pub type Unop = { Negate: . };

pub type Op = { Binary: Binop } | { Unary: Unop };

pub fn plus_op() -> Binop { (Plus.mk(()).>widen_sum)[Binop] }

pub fn minus_op() -> Binop { (Minus.mk(()).>widen_sum)[Binop] }

pub fn times_op() -> Binop { (Times.mk(()).>widen_sum)[Binop] }

pub fn divide_op() -> Binop { (Divide.mk(()).>widen_sum)[Binop] }

pub fn modulo_op() -> Binop { (Modulo.mk(()).>widen_sum)[Binop] }

pub fn power_op() -> Binop { (Power.mk(()).>widen_sum)[Binop] }

pub fn negate_op() -> Unop { (Negate.mk(()).>widen_sum)[Unop] }

pub fn as_binary(b: Binop) -> Op { (Binary.mk(b).>widen_sum)[Op] }

pub fn as_unary(u: Unop) -> Op { (Unary.mk(u).>widen_sum)[Op] }

/// One row of the operator table: how tightly the operator binds, and how it
/// is written. Both are read off the same row, so an operator's precedence and
/// its spelling cannot drift apart.
type Facts = { Rank: I32; Sym: String };

fn binop_facts(b: Binop) -> Facts {
  match(b) {
    (
    , .(_p: Plus) { (Rank.mk(1), Sym.mk("+")) }
    , .(_m: Minus) { (Rank.mk(1), Sym.mk("-")) }
    , .(_t: Times) { (Rank.mk(2), Sym.mk("*")) }
    , .(_d: Divide) { (Rank.mk(2), Sym.mk("/")) }
    , .(_o: Modulo) { (Rank.mk(2), Sym.mk("%")) }
    , .(_w: Power) { (Rank.mk(4), Sym.mk("^")) }
    )
  }
}

fn unop_facts(u: Unop) -> Facts {
  match(u) {
    .(_n: Negate) { (Rank.mk(3), Sym.mk("~")) }
  }
}

fn facts(op: Op) -> Facts {
  match(op) {
    (
    , .(b: Binary) {
        binop_facts(b.>select { Binary.get })
      }
    , .(u: Unary) {
        unop_facts(u.>select { Unary.get })
      }
    )
  }
}

pub fn binop_prec(b: Binop) -> I32 {
  binop_facts(b).>select { Rank.get }
}

pub fn prec(op: Op) -> I32 {
  facts(op).>select { Rank.get }
}

pub fn symbol(op: Op) -> String {
  facts(op).>select { Sym.get }
}

/// Only `^` associates to the right, which is what makes `2 ^ 3 ^ 2` mean
/// `2 ^ (3 ^ 2)`. Associativity is a property of the operator the yard is
/// about to *push*, and the yard only ever pushes a binary one through the pop
/// loop — so there is no unary case to answer for, and it does not belong in
/// the shared row above.
pub fn binop_right_assoc(b: Binop) -> Bool {
  match(b) {
    (
    , .(_p: Plus) { .f }
    , .(_m: Minus) { .f }
    , .(_t: Times) { .f }
    , .(_d: Divide) { .f }
    , .(_o: Modulo) { .f }
    , .(_w: Power) { .t }
    )
  }
}
