module bdd/store;

import bdd/logic as logic;
import list/core as lists;
import list/list as walk;
import macros/control(macro if);
import macros/match(macro match);
import macros/row_macros(macro select);
import macros/spine_macros(macro widen_sum);
import testapi(Bool, I32);
import testapi/arith as arith;

pub type { Node_id: I32 { pub mk; pub get } }

pub type Node = { Level: I32; Low: Node_id; High: Node_id };

pub type Store = { Nodes: lists.List[Node_id & Node]; Next: I32; Reused: I32; Reduced: I32 };

pub fn false_id() -> Node_id { Node_id.mk(0) }

pub fn true_id() -> Node_id { Node_id.mk(1) }

pub fn same_id(a: Node_id, b: Node_id) -> Bool { arith.eq_i32(a.>Node_id.get, b.>Node_id.get) }

pub fn terminal(id: Node_id) -> Bool { arith.lt_i32(id.>Node_id.get, 2) }

pub fn truth(id: Node_id) -> Bool { same_id(id, true_id()) }

pub fn from_bool(b: Bool) -> Node_id {
  if(b) { true_id() } else { false_id() }
}

pub fn empty() -> Store { (Nodes.mk(lists.nil[_]), Next.mk(2), Reused.mk(0), Reduced.mk(0)) }

pub fn size(s: Store) -> I32 {
  walk.length(s.>select { Nodes.get })
}

pub fn lookup(s: Store, id: Node_id) -> Node | . {
  match(walk.find(.(key: Node_id, _node: Node) { same_id(key, id) }, s.>select { Nodes.get })) {
    .(_key: Node_id, node: Node) { node.>widen_sum };
    .() { ().>widen_sum }
  }
}

pub fn top(s: Store, id: Node_id) -> I32 {
  match(lookup(s, id)) {
    .(n: Node) {
      n.>select { Level.get }
    };
    .() { 3 }
  }
}

pub fn branch(s: Store, id: Node_id, at: I32, high_branch: Bool) -> Node_id {
  match(lookup(s, id)) {
    .(n: Node) {
      if(arith.eq_i32(n.>select { Level.get }, at)) {
        if(high_branch) {
          n.>select { High.get }
        } else {
          n.>select { Low.get }
        }
      } else {
        id
      }
    };
    .() { id }
  }
}

fn same_node(a: Node, b: Node) -> Bool {
  logic.and(
  , arith.eq_i32(a.>select { Level.get }, b.>select { Level.get })
  , logic.and(
    , same_id(a.>select { Low.get }, b.>select { Low.get })
    , same_id(a.>select { High.get }, b.>select { High.get })
    )
  )
}

pub fn intern(s: Store, level: I32, low: Node_id, high: Node_id) -> Store & Node_id {
  if(same_id(low, high)) {
    (
    , (
      , Nodes.mk(s.>select { Nodes.get })
      , Next.mk(s.>select { Next.get })
      , Reused.mk(s.>select { Reused.get })
      , Reduced.mk(arith.add_i32(s.>select { Reduced.get }, 1))
      )
    , low
    )
  } else {
    let node = (Level.mk(level), Low.mk(low), High.mk(high));
    match(walk.find(
    , .(_key: Node_id, existing: Node) { same_node(node, existing) }
    , s.>select { Nodes.get }
    )) {
      .(id: Node_id, _existing: Node) {
        (
        , (
          , Nodes.mk(s.>select { Nodes.get })
          , Next.mk(s.>select { Next.get })
          , Reused.mk(arith.add_i32(s.>select { Reused.get }, 1))
          , Reduced.mk(s.>select { Reduced.get })
          )
        , id
        )
      };
      .() {
        let id = Node_id.mk(s.>select { Next.get });
        (
        , (
          , Nodes.mk(lists.cons((id, node), s.>select { Nodes.get }))
          , Next.mk(arith.add_i32(s.>select { Next.get }, 1))
          , Reused.mk(s.>select { Reused.get })
          , Reduced.mk(s.>select { Reduced.get })
          )
        , id
        )
      }
    }
  }
}
