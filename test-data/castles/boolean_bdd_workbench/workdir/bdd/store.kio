module bdd/store;

import bdd/logic as logic;
import elab/control(if);
import elab/match(match);
import elab/spine_elaborators(reorder_prod, widen_sum);
import list/core as lists;
import list/list as walk;
import testapi(Bool, I32);
import testapi/arith as arith;

pub newtype Node_id : I32 { pub constructor from_int; pub projector to_int }

pub labels Node = { level: I32, low: Node_id, high: Node_id };

pub labels Store = { nodes: lists.List(Node_id & Node), next: I32, reused: I32, reduced: I32 };

pub fn false_id() -> Node_id { Node_id.from_int(0) }

pub fn true_id() -> Node_id { Node_id.from_int(1) }

pub fn same_id(a: Node_id, b: Node_id) -> Bool {
  arith.eq_i32(a.>Node_id.to_int, b.>Node_id.to_int)
}

pub fn terminal(id: Node_id) -> Bool { arith.lt_i32(id.>Node_id.to_int, 2) }

pub fn truth(id: Node_id) -> Bool { same_id(id, true_id()) }

pub fn from_bool(b: Bool) -> Node_id {
  if! b {
    true_id()
  } else {
    false_id()
  }
}

pub fn empty() -> Store { {nodes = lists.nil(), next = 2, reused = 0, reduced = 0} }

pub fn size(s: Store) -> I32 { walk.length(s.?{nodes}) }

pub fn lookup(s: Store, id: Node_id) -> Node | . {
  match! walk.find(.(key: Node_id, _node: Node) { same_id(key, id) }, s.?{nodes}) {
    .(_key: Node_id, node: Node) { node.>widen_sum! };
    .() { ().>widen_sum! }
  }
}

pub fn top(s: Store, id: Node_id) -> I32 {
  match! lookup(s, id) {
    .(n: Node) { n.?{level} };
    .() { 3 }
  }
}

pub fn branch(s: Store, id: Node_id, at: I32, high_branch: Bool) -> Node_id {
  match! lookup(s, id) {
    .(n: Node) {
      if! arith.eq_i32(n.?{level}, at) {
        if! high_branch {
          n.?{high}
        } else {
          n.?{low}
        }
      } else {
        id
      }
    };
    .() { id }
  }
}

fn same_node(a: Node, b: Node) -> Bool {
  logic.and(
    , arith.eq_i32(a.?{level}, b.?{level})
    , logic.and(same_id(a.?{low}, b.?{low}), same_id(a.?{high}, b.?{high}))
    )
}

pub fn intern(s: Store, level: I32, low: Node_id, high: Node_id) -> Store & Node_id {
  if! same_id(low, high) {
    (s.!{reduced = arith.add_i32(s.?{reduced}, 1)}.>reorder_prod!(Store), low)
  } else {
    let node = {level, low, high};
    match! walk.find(.(_key: Node_id, existing: Node) { same_node(node, existing) }, s.?{nodes}) {
      .(id: Node_id, _existing: Node) {
        (s.!{reused = arith.add_i32(s.?{reused}, 1)}.>reorder_prod!(Store), id)
      };
      .() {
        let id = Node_id.from_int(s.?{next});
        (s.!{nodes = lists.cons((id, node), s.?{nodes}), next = arith.add_i32(s.?{next}, 1)}, id)
      }
    }
  }
}
