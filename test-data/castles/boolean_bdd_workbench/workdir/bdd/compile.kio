mod bdd/compile;

import bdd/apply as engine;
import bdd/expression as expr;
import bdd/logic as logic;
import bdd/store as table;
import macros/match { macro match }
import macros/row_macros { macro select }
import testapi/iter { fn loop }

pub rec(loop) fn compile(m: engine.Manager, expression: expr.Expression) ->
  engine.Manager & table.Node_id
   {
  match(expression) {
    .(c: expr.Constant) {
      (m, table.from_bool(c.>select { expr.Constant.get }))
    };
    .(v: expr.Variable) {
      engine.intern(m, v.>select { expr.Variable.get }, table.false_id(), table.true_id())
    };
    .(n: expr.Negation) {
      let .(next: engine.Manager, child: table.Node_id) =
        recur(cont) compile(m, n.>select { expr.Negation.get });
      engine.apply(next, logic.exclusive_op(), child, table.true_id())
    };
    .(b: expr.Binary) {
      let .(op: logic.Operation, left: expr.Expression, right: expr.Expression) =
        b.>select { expr.Binary.get };
      let .(after_left: engine.Manager, a: table.Node_id) = recur(cont) compile(m, left);
      let .(after_right: engine.Manager, b: table.Node_id) = recur(cont) compile(after_left, right);
      engine.apply(after_right, op, a, b)
    }
  }
}
