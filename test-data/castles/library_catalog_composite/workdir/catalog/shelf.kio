module catalog/shelf;

import catalog/domain as dom;
import catalog/domain(Book, Book_index, Failure, Hold_list, Hold_rec);
import catalog/domain({copies_out}, {copies_total}, {held_call});
import dict/dict as dict;
import elab/match(match);
import list/list as list;
import result/result as result;
import testapi(Bool, I32);
import testapi/arith(add_i32, eq_i32, lt_i32, sub_i32);

pub type Book_result = result.Result(Book, Failure);

/// The catalog index is a `dict` keyed by call-number; a miss is a
/// domain failure, not an absent value the caller has to think about.
pub fn find(books: Book_index, call: I32) -> Book_result {
  let .(missing: Book_result) = result.err(dom.fail_unknown_call(call));
  match! dict.get(dom.cmp_i32, books, call) {
    (.(entry: Book) { result.ok(entry) }, .(_absent: .) { missing })
  }
}

pub fn is_available(entry: Book) -> Bool { lt_i32(entry.?{copies_out}, entry.?{copies_total}) }

pub fn take_copy(entry: Book) -> Book {
  let .(out: I32) = add_i32(entry.?{copies_out}, 1);
  entry.!{copies_out = out}
}

pub fn put_copy(entry: Book) -> Book {
  let .(out: I32) = sub_i32(entry.?{copies_out}, 1);
  entry.!{copies_out = out}
}

pub fn save(books: Book_index, call: I32, entry: Book) -> Book_index {
  dict.insert(dom.cmp_i32, books, call, entry)
}

pub fn hold_count(holds: Hold_list, call: I32) -> I32 {
  list.length(list.filter(.(booked: Hold_rec) { eq_i32(booked.?{held_call}, call) }, holds))
}

pub fn title_count(books: Book_index) -> I32 { dict.size(books) }

pub fn copies_out(books: Book_index) -> I32 {
  dict.fold_asc(
    , books
    , 0
    , .(step: I32 & I32 & Book) {
        let .(running: I32, _call: I32, entry: Book) = step;
        add_i32(running, entry.?{copies_out})
      }
    )
}
