module catalog/audit;

import catalog/domain(
, Audit_list
, Copies_available
, Failure
, Line_list
, No_copies
, Not_held
, Unknown_call
, Unknown_member
);
import catalog/domain(cat, istr);
import list/core as lcore;
import list/list as list;
import macros/match(macro match);
import macros/row_macros(macro select, macro with);
import testapi(I32, String);
import testapi/arith(add_i32);

type Tally = { E_call: I32; E_member: I32; E_copies: I32; E_held: I32; E_hold: I32 };

pub fn failure_text(reason: Failure) -> String {
  match(reason) {
    (
    , .(bad: Unknown_call) {
        "unknown call-number ".>cat(istr(bad.>select { Unknown_call.get }))
      }
    , .(bad: Unknown_member) {
        "unknown member ".>cat(istr(bad.>select { Unknown_member.get }))
      }
    , .(bad: No_copies) {
        "no copies left of ".>cat(istr(bad.>select { No_copies.get }))
      }
    , .(bad: Not_held) {
        let .(id: I32, call: I32) = bad.>select { Not_held.get };
        "member ".>cat(istr(id)).>cat(" does not hold ").>cat(istr(call))
      }
    , .(bad: Copies_available) {
        "copies still on the shelf for ".>cat(istr(bad.>select { Copies_available.get }))
      }
    )
  }
}

fn one_more_call(counts: Tally) -> Tally {
  counts.>with {
    E_call.mk(add_i32(counts.>select { E_call.get }, 1))
  }
}

fn one_more_member(counts: Tally) -> Tally {
  counts.>with {
    E_member.mk(add_i32(counts.>select { E_member.get }, 1))
  }
}

fn one_more_copies(counts: Tally) -> Tally {
  counts.>with {
    E_copies.mk(add_i32(counts.>select { E_copies.get }, 1))
  }
}

fn one_more_held(counts: Tally) -> Tally {
  counts.>with {
    E_held.mk(add_i32(counts.>select { E_held.get }, 1))
  }
}

fn one_more_hold(counts: Tally) -> Tally {
  counts.>with {
    E_hold.mk(add_i32(counts.>select { E_hold.get }, 1))
  }
}

fn bump(counts: Tally, reason: Failure) -> Tally {
  match(reason) {
    (
    , .(_bad: Unknown_call) { one_more_call(counts) }
    , .(_bad: Unknown_member) { one_more_member(counts) }
    , .(_bad: No_copies) { one_more_copies(counts) }
    , .(_bad: Not_held) { one_more_held(counts) }
    , .(_bad: Copies_available) { one_more_hold(counts) }
    )
  }
}

fn tally(reasons: Audit_list) -> Tally {
  list.foldl(
  , .(step: Tally & Failure) { let .(counts: Tally, reason: Failure) = step; bump(counts, reason) }
  , (E_call.mk(0), E_member.mk(0), E_copies.mk(0), E_held.mk(0), E_hold.mk(0))
  , reasons
  )
}

fn row(label: String, count: I32) -> String { label.>cat(istr(count)) }

/// Fixed-width labels keep the count column aligned without a
/// string-length capability in the host tier.
pub fn tally_lines(reasons: Audit_list) -> Line_list {
  let .(counts: Tally) = tally(reasons);
  let rows = lcore.nil[String];
  let rows = lcore.cons(row("copies still available  ", counts.>select { E_hold.get }), rows);
  let rows = lcore.cons(row("member does not hold    ", counts.>select { E_held.get }), rows);
  let rows = lcore.cons(row("no copies left          ", counts.>select { E_copies.get }), rows);
  let rows = lcore.cons(row("unknown member          ", counts.>select { E_member.get }), rows);
  let rows = lcore.cons(row("unknown call-number     ", counts.>select { E_call.get }), rows);
  rows
}
