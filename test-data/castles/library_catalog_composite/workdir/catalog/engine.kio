mod catalog/engine;

import catalog/audit as audit;
import catalog/circulation as circulation;
import catalog/domain {
  type Applied;
  type Audit_list;
  type Book_index;
  type Failure;
  type Hold_list;
  type Hold_rec;
  type Line_list;
  type Member_index;
  type Op;
  type Op_list
}
import catalog/domain { fn cat; fn istr }
import catalog/fixtures as fixtures;
import catalog/ledger as ledger;
import catalog/report as report;
import catalog/shelf as shelf;
import list/core as lcore;
import list/list as list;
import macros/match { macro match }
import macros/row_macros { macro select }
import result/result as result;
import testapi { type I32; type String }
import testapi/arith { fn add_i32 }
import testapi/io { fn print }
import testapi/iter { fn loop }

type State = {
  Books: Book_index;
  Members: Member_index;
  Holds: Hold_list;
  Log: Line_list;
  Failures: Audit_list;
  Step: I32
};

fn initial() -> State {
  (
  , Books.mk(fixtures.books())
  , Members.mk(fixtures.members())
  , Holds.mk(lcore.nil[Hold_rec])
  , Log.mk(lcore.nil[String])
  , Failures.mk(lcore.nil[Failure])
  , Step.mk(0)
  )
}

/// One desk operation: the outcome is folded back into the same state
/// whether it succeeded or failed, so a failure never stops the day.
fn step_op(state: State, op: Op) -> State {
  let .(books, members, holds, log, failures, step) =
    state.>select { Books.get; Members.get; Holds.get; Log.get; Failures.get; Step.get };
  let .(index: I32) = add_i32(step, 1);
  result.fold(
  , .(applied: Applied) {
      let .(shelved: Book_index, roster: Member_index, booked: Hold_list, note: String) = applied;
      (
      , Books.mk(shelved)
      , Members.mk(roster)
      , Holds.mk(booked)
      , Log.mk(lcore.cons(report.transcript_line(index, op, "ok:  ".>cat(note)), log))
      , Failures.mk(failures)
      , Step.mk(index)
      )
    }
  , .(reason: Failure) {
      (
      , Books.mk(books)
      , Members.mk(members)
      , Holds.mk(holds)
      , Log.mk(lcore.cons(
        , report.transcript_line(index, op, "err: ".>cat(audit.failure_text(reason)))
        , log
        ))
      , Failures.mk(lcore.cons(reason, failures))
      , Step.mk(index)
      )
    }
  , circulation.apply(op, books, members, holds)
  )
}

rec(loop) fn drive(state: State, pending: Op_list) -> State {
  match(lcore.uncons(pending)) {
    (.(op: Op, rest: Op_list) { recur drive(step_op(state, op), rest) }, .(_done: .) { state })
  }
}

rec(loop) fn print_lines(lines: Line_list) {
  match(lcore.uncons(lines)) {
    (
    , .(line: String, rest: Line_list) { print(line.>cat("\n")); recur print_lines(rest) }
    , .(_done: .) { () }
    )
  }
}

pub fn run() {
  let .(final: State) = drive(initial(), fixtures.ops());
  let .(books, members, holds, log, failures, step) =
    final.>select { Books.get; Members.get; Holds.get; Log.get; Failures.get; Step.get };
  print("branch library circulation: "
    .>cat(istr(shelf.title_count(books)))
    .>cat(" titles, ")
    .>cat(istr(ledger.member_count(members)))
    .>cat(" members, ")
    .>cat(istr(step))
    .>cat(" operations\n"));
  print("\n== transcript ==\n");
  print_lines(list.reverse(log));
  print("\n== shelf ==\n");
  print_lines(report.shelf_lines(books, holds));
  print("\n== fines ==\n");
  print_lines(report.fines_lines(members));
  print("total fines ".>cat(istr(ledger.total_fines(members))).>cat("\n"));
  print("\n== audit ==\n");
  print_lines(audit.tally_lines(failures));
  print("failed operations "
    .>cat(istr(list.length(failures)))
    .>cat(" of ")
    .>cat(istr(step))
    .>cat("\n"))
}
