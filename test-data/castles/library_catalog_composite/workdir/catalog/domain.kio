module catalog/domain;

import dict/dict as dict;
import elab/control(if);
import elab/spine_elaborators(widen_sum);
import list/core as lcore;
import result/result as result;
import testapi(Bool, I32, String);
import testapi/arith(eq_i32, lt_i32);
import testapi/fmt(int_to_string);
import testapi/text(string_concat);

pub literal fine_rate = 25;

pub type Call_list = lcore.List(I32);

pub type Line_list = lcore.List(String);

pub labels Book = { title: String, copies_total: I32, copies_out: I32 };

pub labels Member = { member_id: I32, fines: I32, held: Call_list };

pub labels Hold_rec = { holder: I32, held_call: I32 };

pub labels Op =
  { checkout: I32 & I32 }
  | { return: I32 & I32 & I32 }
  | { hold: I32 & I32 }
  | { report: . };

pub labels Failure =
  { unknown_call: I32 }
  | { unknown_member: I32 }
  | { no_copies: I32 }
  | { not_held: I32 & I32 }
  | { copies_available: I32 };

pub type Book_index = dict.Dict(I32, Book);

pub type Member_index = dict.Dict(I32, Member);

pub type Hold_list = lcore.List(Hold_rec);

pub type Op_list = lcore.List(Op);

pub type Audit_list = lcore.List(Failure);

/// The state a fallible circulation step hands back: the three updated
/// stores plus the transcript note describing what changed.
pub type Applied = Book_index & Member_index & Hold_list & String;

pub type Outcome = result.Result(Applied, Failure);

pub fn op_checkout(member: I32, call: I32) -> Op { {checkout = (member, call)}.>widen_sum!(Op) }

pub fn op_return(member: I32, call: I32, days_late: I32) -> Op {
  {return = (member, call, days_late)}.>widen_sum!(Op)
}

pub fn op_hold(member: I32, call: I32) -> Op { {hold = (member, call)}.>widen_sum!(Op) }

pub fn op_report() -> Op { {report=}.>widen_sum!(Op) }

pub fn fail_unknown_call(call: I32) -> Failure { {unknown_call = call}.>widen_sum!(Failure) }

pub fn fail_unknown_member(member: I32) -> Failure {
  {unknown_member = member}.>widen_sum!(Failure)
}

pub fn fail_no_copies(call: I32) -> Failure { {no_copies = call}.>widen_sum!(Failure) }

pub fn fail_not_held(member: I32, call: I32) -> Failure {
  {not_held = (member, call)}.>widen_sum!(Failure)
}

pub fn fail_copies_available(call: I32) -> Failure {
  {copies_available = call}.>widen_sum!(Failure)
}

pub fn cat(left: String, right: String) -> String { string_concat(left, right) }

pub fn istr(value: I32) -> String { int_to_string(value) }

pub fn pad2(value: I32) -> String {
  if! lt_i32(value, 10) {
    "0".>cat(istr(value))
  } else {
    istr(value)
  }
}

pub fn pad3(value: I32) -> String {
  if! lt_i32(value, 10) {
    "  ".>cat(istr(value))
  } else if! lt_i32(value, 100) {
    " ".>cat(istr(value))
  } else {
    istr(value)
  }
}

/// Search and insertion share this explicit key order.
pub fn cmp_i32(pair: I32 & I32) -> dict.Ordering {
  let .(left: I32, right: I32) = pair;
  if! lt_i32(left, right) {
    dict.lt()
  } else if! eq_i32(left, right) {
    dict.eq()
  } else {
    dict.gt()
  }
}

pub fn eq_pair(pair: I32 & I32) -> Bool { let .(left: I32, right: I32) = pair; eq_i32(left, right) }
