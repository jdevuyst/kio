sig app v(2);

v(1) {
  with {
    mod context/if {
      pub type Item = .;
    }
  };
  breaking {
    add {
      added/with.Item;
      mod added/body {
        pub fn item() -> .;
      }
    };
    modify {
      modified/with.Item;
      mod modified/body {
        pub fn item() -> .;
      }
    };
    remove {
      removed/with.item;

        removed/body.item;
        removed/body.removed;

    }
  }
}

v(2) {
  nonbreaking {
    remove {
      second/with.item;
    }
  }
}

// removed/body is a comment, not a module path
