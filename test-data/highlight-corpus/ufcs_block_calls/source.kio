mod splices;

import library/custom {macro outer; macro inner}

fn run(receiver: .) {
  receiver.>outer (extra) { first } next { second };
  receiver.>>outer (extra) { first } next { second };
  outer (extra) { first } next { second }.<<receiver;
  outer (extra) { first } next { second }.<receiver;
  outer (extra) { first } next { inner (other) { second } }.<receiver;
  outer (extra) { first } next { inner (other) { second }.<receiver };
  ((outer (extra) { first })).<receiver(arg).>after
}
