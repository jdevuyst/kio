module m;

import macros/row_macros(macro select, macro with_);

host type String role(str);
type { Red: . { mk; get }; Blue: . { mk; get }; Tone: String { mk; get }; }

fn pick() -> Red { Red.mk(()) }

fn row(r: Red & Blue & Tone) -> String {
  let payload = r.>select { Tone.get };
  let updated = r.>with_ { Blue.mk(()) };
  let _ = updated.>select { Red.get };
  payload
}
