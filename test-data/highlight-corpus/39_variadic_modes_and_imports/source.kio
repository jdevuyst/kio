mod grammar/context;

import syntax {
  op _ ? _ : ___;
  op __ + _;
  op_var [% %];
  op_var [];
  fn op;
  fn variadic
  }

op_var [+ +] { foldl targets.foldl targets.variadic; };
op_var
[-
-]
{
  foldr
  targets.foldr
  targets.finalize;
  finalize targets.Box.foldl1;
};
op_var [* *] { foldl1 targets.foldl1 targets.variadic; };
op_var [/ /] { foldr1 targets.foldr1 targets.import; };

fn import(value: .) -> . { value }
fn op(value: .) -> . { value }
fn variadic(value: .) -> . { value }
fn foldl(value: .) -> . { value }
fn foldr(value: .) -> . { value }
fn foldl1(value: .) -> . { value }
fn foldr1(value: .) -> . { value }
fn finalize(value: .) -> . { value }
