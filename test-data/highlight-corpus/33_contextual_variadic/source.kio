mod variadic/context;

fn fold(value: .) -> . { value }
fn variadic(value: .) -> . { value }
fn foldr(value: .) -> . { value }

fn uses() -> . {
  let bare = variadic;
  let qualified = helper.variadic;
  variadic(());
  helper.variadic(())
}

op_var [* *] { foldr helper.fold variadic; };
// op_var [! !] { foldr fold variadic; };
op_var [! !] { foldr helper.fold variadic; };
