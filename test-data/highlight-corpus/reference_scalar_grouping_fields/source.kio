mod m;
op _ + _ { impl ((ops.add)) }
op_var [* *] { foldl ((ops.join)) (ops.empty); finalize ((())) }
macro form: . -> . { captures ((helper), ((Type))); impl ((helpers.run)) }
macro later: . -> . { impl (fills) }
macro scheduled: . -> . { impl (fills) ((helpers.run)) }
rec ((host.drive)) fn again(value: .) -> . { value.>((helpers.keep)) }
