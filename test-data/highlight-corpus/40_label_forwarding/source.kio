mod forwarding;
import origin as provider;

type { Original: .; };
type Local = Original;
type Type = Original;
type Next = Type;
pub type Renamed = provider.Original;
pub(forwarding) type Scoped = provider.Original;

/// A documented identity alias.
type Documented =
  // Keep the target leaf separate from its prefix.
  provider.Original;

fn type() -> . { () }
fn local() -> . { () }
type Ordinary = .;
