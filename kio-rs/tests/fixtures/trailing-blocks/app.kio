mod app;

import provider {
  type Box;
  fn box_bind;
  fn box_pure;
  macro enter;
  macro packet;
  macro sequence;
  macro two
}

pub fn run() {
  enter {
    let local = packet { () };
    local
  }
}

pub fn branch() {
  two { () } fallback { () }
}

pub fn action() -> Box[.] {
  sequence(box_bind) { let .(value: .) <- box_pure(()); box_pure(value) }
}
