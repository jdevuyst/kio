mod provider;

import __comptime__;

pub type { Box[A]: A { pub mk; pub get } }

pub pure fn box_pure[A](value: A) -> Box[A] { Box.mk(value) }

pub pure fn box_bind[A][B](value: Box[A], continuation: A -> Box[B]) -> Box[B] {
  continuation(Box.get(value))
}

pub type Bind[*F] = [A][B] (F[A] & (A -> F[B])) -> F[B];

pub type Sequence[*F][R] = Bind[F] -> F[R];

pure fn identity_checked(_ct: __Comptime__, _ty: __Type__, value: __Checked_term__) -> __Checked_term__ {
  value
}

pure fn first_checked(ct: __Comptime__, _values: __Checked_term__) -> __Checked_term__ {
  __term_unit__(ct)
}

pure fn enter_checked(
, ct: __Comptime__
, fills: __Fill_ctx__
, _result: __Type__
, body: __Checked_term__
) -> __Checked_term__ & __Fill_ctx__ {
  (__term_call__(ct, __term_type__(ct, body), body, __term_unit__(ct)), fills)
}

pure fn sequence_checked(
, ct: __Comptime__
, _constructor: __Type__
, _result: __Type__
, inputs: __Checked_term__
) -> __Checked_term__ {
  let inputs_type = __term_type__(ct, inputs);
  __term_let__(
  , ct
  , inputs_type
  , inputs
  , .(bound: __Checked_term__) -> __Checked_term__ {
      let receiver = __intrinsic_fst__(ct, inputs_type, bound);
      let body = __intrinsic_snd__(ct, inputs_type, bound);
      __term_call__(ct, __term_type__(ct, body), body, receiver)
    }
  )
}

pub macro packet : [A] A -> A { trailing product; impl identity_checked }

pure fn unit_checked(ct: __Comptime__, _inputs: __Checked_term__) -> __Checked_term__ {
  __term_unit__(ct)
}

pub macro two : (. & .) -> . { trailing product; trailing product fallback; impl unit_checked }

pub macro enter : [R] (. -> R) -> R { trailing thunk; impl(fills) enter_checked }

pub macro sequence : [*F][R] (Bind[F] & Sequence[F][R]) -> F[R] { trailing sequence; impl sequence_checked }
