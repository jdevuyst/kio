// A representative slice of Kio surface forms — keywords,
// literals, operators, macro calls, slots and
// placeholders. Used by the E2E test as a non-trivial document
// to exercise the semantic-tokens provider on.
module fixture;
import highlight/source(Item, item, Field);
import highlight/macros(macro outer, macro transform, macro _transform, macro if);

host type I32 role(i32);
host type String role(str);
host fn print(s: String);

type { Greet: String; }
type Greeting = Greet;

type { Box[A]: A { mk; get; }; }
type { _Box[_A]: _A { mk; get; }; }

op _ <+> _ { impl pick; };

fn pick(a: I32, b: I32) -> I32 { a }

fn raw_type_args[A][_A](x: A, y: _A) -> _A {
  let _ = Box.get[A](Box.mk[A](x));
  _Box.get[_A](_Box.mk[_A](y))
}

fn ufcs(receiver: I32) -> I32 {
  receiver.>outer (extra) { first } next { second };
  receiver.>>outer (extra) { first } next { second };
  outer (extra) { first } next { second }.<<receiver;
  outer (extra) { first } next { second }.<receiver;
  receiver.>pick(receiver);
  receiver.>>Thing.member;
  pick(receiver).<receiver;
  Thing.member.<<receiver;
  receiver.>transform;
  transform.<receiver;
  _transform.<receiver;
  receiver.>_Box.get;
  _Box.get.<receiver
}

pub fn main() -> . {
  let g = "hello\n";
  let n = 1[I32] <+> 2[I32];
  let f = .x. { x1 };
  let boxed = Box.mk[I32](n);
  let unboxed = Box.get[I32](boxed);
  let marked = _Box.mk[I32](unboxed);
  let _unmarked = _Box.get[I32](marked);
  if (.t) {
    print("y")
  } else {
    print("n")
  }
}
