# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment / local overrides
.env
.env.local

# Local planning scratchpad
/scratchpad/

# Build artifacts emitted by `kio build` test cases
test-data/goldens/**/out/
test-data/emissions/**/out/
test-data/poc/**/out/
test-data/castles/**/out/
test-data/contrib/**/out/
docs/out/

# rlib cache root, populated by the test runner via --cache.
# See ci/run-tests.sh's --cache-base and ci/checks/orchestrators/golden-tests.sh.
/.kio-cache/

# Node.js dependencies — pulled in by the highlight-agreement
# driver (`tools/highlight-agreement/`). The driver's
# `package.json` + `package-lock.json` pin the versions; CI
# (and local runs) re-install via `npm ci` on demand.
node_modules/
website/node_modules/

# Website build outputs. Source docs stay under docs/; these are
# generated by website/scripts/prepare-docs.mjs and VitePress.
website/docs/
website/blog/
website/.vitepress/cache/
website/.vitepress/dist/
website/.vitepress/generated/
website/.vitepress/public/wasm/
website/.vitepress/public/blog/
kio-repl-wasm/target/

# Reporting-harness scratch. reports/*.sh write run directories and
# coverage/mutation artifacts under a repo-root target/ (e.g.
# target/reports/kio-gen-coverage-delta/). There is no root Cargo
# crate, so nothing else writes here; per-crate target/ dirs are
# ignored by each crate's own .gitignore.
/target/
